/# Windows Win32 & NT Native Syscall Constants and Prototypes (`core.sys.windows`)
/#
/# Declares `@repr(C)` Win32 and NT structures (`OVERLAPPED`, `BY_HANDLE_FILE_INFORMATION`,
/# `FILE_*_INFO`, `WIN32_FIND_DATAW`, `STARTUPINFOEXW`, `PROCESS_INFORMATION`, `OBJECT_ATTRIBUTES`,
/# `UNICODE_STRING`) alongside `kernel32`, `ntdll`, and `advapi32` `extern "C"` prototypes.
/#
/# Standard directory resolution queries environment variables and `advapi32` `User Shell Folders`
/# directly with zero GUI/COM subsystem dependencies, avoiding `user32`/`gdi32` cold-start overhead.

// ---------------------------------------- TYPES ----------------------------------------
/| Win32 64-bit 100-nanosecond timestamp (`FILETIME`, `8` bytes).
@repr(C)
pub struct Win32FileTime {
    /| Low-order 32 bits of the 100-ns interval count since `1601-01-01T00:00:00Z`.
    pub low_date_time: u32,
    /| High-order 32 bits of the 100-ns interval count since `1601-01-01T00:00:00Z`.
    pub high_date_time: u32,
}

/| Win32 asynchronous/positional I/O request header (`OVERLAPPED`, `32` bytes on Win64).
@repr(C)
pub struct Win32Overlapped {
    /| Kernel I/O status (`Internal`).
    pub internal_status: usize,
    /| Transferred byte count (`InternalHigh`).
    pub internal_high: usize,
    /| Low 32 bits of the target file offset or lock range start.
    pub offset_low: u32,
    /| High 32 bits of the target file offset or lock range start.
    pub offset_high: u32,
    /| Optional manual-reset event handle (`hEvent`).
    pub event_handle: *mut opaque,
}

/| Win32 handle-inheritance and security descriptor header (`SECURITY_ATTRIBUTES`).
@repr(C)
pub struct Win32SecurityAttributes {
    /| Structure size in bytes (`sizeof(Win32SecurityAttributes)`).
    pub byte_length: u32,
    /| Optional `SECURITY_DESCRIPTOR` pointer (`null` for default ACL).
    pub security_descriptor: *mut opaque,
    /| Non-zero (`1`) when child processes may inherit the returned handle.
    pub inherit_handle: i32,
}

/| Win32 `GetFileInformationByHandle` metadata record (`BY_HANDLE_FILE_INFORMATION`, `52` bytes).
@repr(C)
pub struct Win32ByHandleFileInfo {
    /| `FILE_ATTRIBUTE_*` bitmask.
    pub file_attributes: u32,
    /| File creation timestamp.
    pub creation_time: Win32FileTime,
    /| Last access timestamp.
    pub last_access_time: Win32FileTime,
    /| Last modification timestamp.
    pub last_write_time: Win32FileTime,
    /| Volume serial number.
    pub volume_serial_number: u32,
    /| High 32 bits of file size.
    pub file_size_high: u32,
    /| Low 32 bits of file size.
    pub file_size_low: u32,
    /| Hardlink count.
    pub number_of_links: u32,
    /| High 32 bits of the 64-bit file index.
    pub file_index_high: u32,
    /| Low 32 bits of the 64-bit file index.
    pub file_index_low: u32,
}

/| Win32 `GetFileAttributesExW` metadata record (`WIN32_FILE_ATTRIBUTE_DATA`, `36` bytes).
@repr(C)
pub struct Win32FileAttributeData {
    /| `FILE_ATTRIBUTE_*` bitmask.
    pub file_attributes: u32,
    /| File creation timestamp.
    pub creation_time: Win32FileTime,
    /| Last access timestamp.
    pub last_access_time: Win32FileTime,
    /| Last modification timestamp.
    pub last_write_time: Win32FileTime,
    /| High 32 bits of file size.
    pub file_size_high: u32,
    /| Low 32 bits of file size.
    pub file_size_low: u32,
}

/| Win32 `FileBasicInfo` (`0`) structure (`FILE_BASIC_INFO`, `40` bytes).
@repr(C, align: 8)
pub struct Win32FileBasicInfo {
    /| Creation time in 100-ns ticks (`0` leaves unchanged in `SetFileInformationByHandle`).
    pub creation_time: i64,
    /| Last access time in 100-ns ticks.
    pub last_access_time: i64,
    /| Last write time in 100-ns ticks.
    pub last_write_time: i64,
    /| Last metadata change time in 100-ns ticks.
    pub change_time: i64,
    /| `FILE_ATTRIBUTE_*` bitmask.
    pub file_attributes: u32,
    /| Explicit trailing alignment word (`0`).
    pub reserved_pad: u32,
}

/| Win32 `FileStandardInfo` (`1`) structure (`FILE_STANDARD_INFO`, `24` bytes).
@repr(C, align: 8)
pub struct Win32FileStandardInfo {
    /| Allocated disk bytes.
    pub allocation_size: i64,
    /| Logical end-of-file byte size.
    pub end_of_file: i64,
    /| Hardlink count.
    pub number_of_links: u32,
    /| Non-zero when deletion is pending.
    pub delete_pending: u8,
    /| Non-zero when handle refers to a directory.
    pub is_directory: u8,
    /| Explicit alignment halfword (`0`).
    pub reserved_pad: u16,
}

/| Win32 `FileAttributeTagInfo` (`9`) structure (`FILE_ATTRIBUTE_TAG_INFO`, `8` bytes).
@repr(C)
pub struct Win32FileAttributeTagInfo {
    /| `FILE_ATTRIBUTE_*` bitmask.
    pub file_attributes: u32,
    /| Reparse point tag (`IO_REPARSE_TAG_SYMLINK`, `IO_REPARSE_TAG_MOUNT_POINT`).
    pub reparse_tag: u32,
}

/| Win32 `FileIdInfo` (`18`) 128-bit ReFS/NTFS identifier (`FILE_ID_INFO`, `24` bytes).
@repr(C, align: 8)
pub struct Win32FileIdInfo {
    /| 64-bit volume serial number.
    pub volume_serial_number: u64,
    /| 128-bit unique file identifier on the volume.
    pub file_id_bytes: [u8; 16],
}

/| Win32 `FileDispositionInfo` (`4`) legacy delete flag (`FILE_DISPOSITION_INFO`, `1` byte).
@repr(C)
pub struct Win32FileDispositionInfo {
    /| Set to `1` (`TRUE`) to mark handle for deletion on close.
    pub delete_file: u8,
}

/| Win32 `FileDispositionInfoEx` (`21`) POSIX unlink record (`FILE_DISPOSITION_INFO_EX`, `4` bytes).
@repr(C)
pub struct Win32FileDispositionInfoEx {
    /| `FILE_DISPOSITION_FLAG_*` combination (`DELETE | POSIX_SEMANTICS`).
    pub flags: u32,
}

/| Win32 `FileRenameInfo` / `FileRenameInfoEx` (`3` / `22`) header (`FileName` at byte offset `20`).
@repr(C)
pub struct Win32FileRenameInfoHdr {
    /| `FILE_RENAME_FLAG_*` bitmask (or `BOOLEAN ReplaceIfExists` in low byte for class `3`).
    pub flags_or_replace: u32,
    /| Explicit pointer-alignment word on 64-bit Windows (`0`).
    pub reserved_pad: u32,
    /| Optional root directory handle (`null` for full path).
    pub root_directory: *mut opaque,
    /| Byte length of the UTF-16 target path (excluding NUL).
    pub file_name_byte_len: u32,
    /| First two UTF-16 code units of variable-length `FileName` starting at offset `20`.
    pub file_name_first: [u16; 2],
}

/| Win32 `FSCTL_DUPLICATE_EXTENTS_TO_FILE` ReFS block-clone payload (`32` bytes).
@repr(C, align: 8)
pub struct Win32DuplicateExtentsData {
    /| Source file handle opened with read access.
    pub source_handle: *mut opaque,
    /| Cluster-aligned starting byte offset in `source_handle`.
    pub source_file_offset: i64,
    /| Cluster-aligned destination byte offset.
    pub target_file_offset: i64,
    /| Cluster-aligned byte count to clone.
    pub byte_count: i64,
}

/| Win32 `FindFirstFileExW` / `FindNextFileW` directory entry (`WIN32_FIND_DATAW`, `592` bytes).
@repr(C)
pub struct Win32FindDataW {
    /| `FILE_ATTRIBUTE_*` bitmask.
    pub file_attributes: u32,
    /| Creation timestamp.
    pub creation_time: Win32FileTime,
    /| Last access timestamp.
    pub last_access_time: Win32FileTime,
    /| Last write timestamp.
    pub last_write_time: Win32FileTime,
    /| High 32 bits of file size.
    pub file_size_high: u32,
    /| Low 32 bits of file size.
    pub file_size_low: u32,
    /| Reparse point tag when `FILE_ATTRIBUTE_REPARSE_POINT` is set (`dwReserved0`).
    pub reserved0: u32,
    /| Reserved system field (`dwReserved1`).
    pub reserved1: u32,
    /| NUL-terminated UTF-16 entry filename (`MAX_PATH = 260` code units).
    pub file_name: [u16; 260],
    /| Legacy 8.3 short name (`14` UTF-16 code units; empty under `FIND_INFO_BASIC`).
    pub alternate_file_name: [u16; 14],
}

/| Win32 `ReadDirectoryChangesW` notification header (`FILE_NOTIFY_INFORMATION`, `16` bytes).
@repr(C)
pub struct Win32FileNotifyInformationHdr {
    /| Byte offset to the next notification record (`0` for final entry).
    pub next_entry_offset: u32,
    /| Change kind (`FILE_ACTION_ADDED`, `REMOVED`, `MODIFIED`, `RENAMED_*`).
    pub action: u32,
    /| Byte length of the trailing UTF-16 relative path (`FileNameLength`).
    pub file_name_byte_len: u32,
    /| First two UTF-16 code units of `FileName` starting at byte offset `12`.
    pub file_name_first: [u16; 2],
}

/| Win32 child-process standard-handle and window configuration (`STARTUPINFOW`, `104`B on Win64).
@repr(C)
pub struct Win32StartupInfoW {
    /| Structure size in bytes (`sizeof(Win32StartupInfoW)` or `sizeof(Win32StartupInfoExW)`).
    pub struct_bytes: u32,
    /| Reserved string pointer (`null`).
    pub reserved_str: *mut u16,
    /| Desktop name (`null`).
    pub desktop_str: *mut u16,
    /| Console window title (`null`).
    pub title_str: *mut u16,
    /| Window X offset (`0`).
    pub win_x: u32,
    /| Window Y offset (`0`).
    pub win_y: u32,
    /| Window width in pixels (`0`).
    pub win_x_size: u32,
    /| Window height in pixels (`0`).
    pub win_y_size: u32,
    /| Console screen-buffer width in character columns (`0`).
    pub count_chars_x: u32,
    /| Console screen-buffer height in character rows (`0`).
    pub count_chars_y: u32,
    /| Console color fill attribute (`0`).
    pub fill_attribute: u32,
    /| `STARTF_*` flags (`STARTF_USESTDHANDLES`).
    pub flags: u32,
    /| `SW_*` window visibility (`0`).
    pub show_window: u16,
    /| Reserved C runtime halfword (`0`).
    pub reserved_cb2: u16,
    /| Reserved C runtime pointer (`null`).
    pub reserved_lp2: *mut u8,
    /| Child standard input handle when `STARTF_USESTDHANDLES` is set.
    pub std_input: *mut opaque,
    /| Child standard output handle when `STARTF_USESTDHANDLES` is set.
    pub std_output: *mut opaque,
    /| Child standard error handle when `STARTF_USESTDHANDLES` is set.
    pub std_error: *mut opaque,
}

/| Extended `STARTUPINFOEXW` carrying `PROC_THREAD_ATTRIBUTE_HANDLE_LIST` (`112`B on Win64).
@repr(C)
pub struct Win32StartupInfoExW {
    /| Base `STARTUPINFOW` header (`struct_bytes = sizeof(Win32StartupInfoExW)`).
    pub startup_info: Win32StartupInfoW,
    /| Initialized `LPPROC_THREAD_ATTRIBUTE_LIST` buffer.
    pub attribute_list: *mut opaque,
}

/| Newly spawned child process and primary thread handles (`PROCESS_INFORMATION`, `24`B on Win64).
@repr(C)
pub struct Win32ProcessInformation {
    /| Handle to the spawned child process.
    pub process_handle: *mut opaque,
    /| Handle to the child primary thread (closed immediately after `CreateProcessW`).
    pub thread_handle: *mut opaque,
    /| Child process identifier (`dwProcessId`).
    pub process_id: u32,
    /| Child primary thread identifier (`dwThreadId`).
    pub thread_id: u32,
}

/| NT counted UTF-16 string descriptor (`UNICODE_STRING`, `16` bytes on Win64).
@repr(C)
pub struct NtUnicodeString {
    /| Active byte length of `buf_ptr` (excluding any trailing NUL).
    pub byte_len: u16,
    /| Allocated capacity of `buf_ptr` in bytes.
    pub max_byte_len: u16,
    /| Pointer to UTF-16 code units (need not be NUL-terminated for `NtCreateFile`!).
    pub buf_ptr: *mut u16,
}

/| NT handle-relative path resolution descriptor (`OBJECT_ATTRIBUTES`, `48` bytes on Win64).
@repr(C)
pub struct NtObjectAttributes {
    /| Structure size in bytes (`sizeof(NtObjectAttributes)`).
    pub struct_bytes: u32,
    /| Optional parent directory `HANDLE` for relative `object_name` resolution (`Dir` capability).
    pub root_directory: *mut opaque,
    /| Relative or NT-namespace `UNICODE_STRING` path.
    pub object_name: *NtUnicodeString,
    /| `OBJ_*` flags (`OBJ_CASE_INSENSITIVE = 0x40`).
    pub attributes: u32,
    /| Optional security descriptor (`null`).
    pub security_descriptor: *mut opaque,
    /| Optional security quality-of-service (`null`).
    pub security_qos: *mut opaque,
}

/| NT kernel completion status block (`IO_STATUS_BLOCK`, `16` bytes on Win64).
@repr(C)
pub struct NtIoStatusBlock {
    /| Final `NTSTATUS` code or pointer union slot.
    pub status_or_ptr: usize,
    /| Dispositional or byte-transfer count (`ULONG_PTR Information`).
    pub information: usize,
}

// --------------------------------------- CONSTS ----------------------------------------
/| Win32 `STD_INPUT_HANDLE` (`0xFFFF_FFF6`).
pub const STD_INPUT_HANDLE: u32 = 0xFFFF_FFF6;

/| Win32 `STD_OUTPUT_HANDLE` (`0xFFFF_FFF5`).
pub const STD_OUTPUT_HANDLE: u32 = 0xFFFF_FFF5;

/| Win32 `STD_ERROR_HANDLE` (`0xFFFF_FFF4`).
pub const STD_ERROR_HANDLE: u32 = 0xFFFF_FFF4;

/| Canonical CoreX standard output stream descriptor (`1`).
pub const STDOUT_FD: i32 = 1;

/| Canonical CoreX standard error stream descriptor (`2`).
pub const STDERR_FD: i32 = 2;

/| Signed sentinel bits for `INVALID_HANDLE_VALUE` (`-1` casts cleanly on 32-bit and 64-bit).
pub const INVALID_HANDLE_BITS: isize = -1;

/| Sentinel returned by `GetFileAttributesW` on failure (`0xFFFF_FFFF`).
pub const INVALID_FILE_ATTRIBUTES: u32 = 0xFFFF_FFFF;

/| Difference between `1601-01-01` Windows epoch and `1970-01-01` Unix epoch in 100-ns ticks.
pub const WINDOWS_TO_UNIX_EPOCH_TICKS: i64 = 116_444_736_000_000_000;

/| `CreateFileW` generic read access (`0x8000_0000`).
pub const GENERIC_READ: u32 = 0x8000_0000;

/| `CreateFileW` generic write access (`0x4000_0000`).
pub const GENERIC_WRITE: u32 = 0x4000_0000;

/| `CreateFileW` generic execute access (`0x2000_0000`).
pub const GENERIC_EXECUTE: u32 = 0x2000_0000;

/| `DELETE` access right required for `SetFileInformationByHandle` rename/unlink (`0x0001_0000`).
pub const DELETE_ACCESS: u32 = 0x0001_0000;

/| `SYNCHRONIZE` access right required for synchronous `NtCreateFile` handles (`0x0010_0000`).
pub const SYNCHRONIZE_ACCESS: u32 = 0x0010_0000;

/| Directory listing / change-notification access right (`0x0000_0001`).
pub const FILE_LIST_DIRECTORY: u32 = 0x0000_0001;

/| Atomic end-of-file append right (`0x0000_0004`).
pub const FILE_APPEND_DATA: u32 = 0x0000_0004;

/| Metadata read right (`0x0000_0080`).
pub const FILE_READ_ATTRIBUTES: u32 = 0x0000_0080;

/| Metadata write right (`0x0000_0100`).
pub const FILE_WRITE_ATTRIBUTES: u32 = 0x0000_0100;

/| Allow concurrent readers (`0x0000_0001`).
pub const FILE_SHARE_READ: u32 = 0x0000_0001;

/| Allow concurrent writers (`0x0000_0002`).
pub const FILE_SHARE_WRITE: u32 = 0x0000_0002;

/| Allow concurrent rename and POSIX unlink while open (`0x0000_0004`).
pub const FILE_SHARE_DELETE: u32 = 0x0000_0004;

/| Mandatory POSIX-equivalent share mask (`FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE`).
pub const FILE_SHARE_ALL: u32 = 0x0000_0007;

/| Fail if target exists (`1`).
pub const CREATE_NEW: u32 = 1;

/| Always create and truncate existing file (`2`).
pub const CREATE_ALWAYS: u32 = 2;

/| Open only if target exists (`3`).
pub const OPEN_EXISTING: u32 = 3;

/| Open existing or create if absent (`4`).
pub const OPEN_ALWAYS: u32 = 4;

/| Open existing and truncate to zero bytes (`5`).
pub const TRUNCATE_EXISTING: u32 = 5;

/| Read-only file attribute (`0x0000_0001`).
pub const FILE_ATTRIBUTE_READONLY: u32 = 0x0000_0001;

/| Hidden file attribute (`0x0000_0002`).
pub const FILE_ATTRIBUTE_HIDDEN: u32 = 0x0000_0002;

/| Directory attribute (`0x0000_0010`).
pub const FILE_ATTRIBUTE_DIRECTORY: u32 = 0x0000_0010;

/| Default normal file attribute (`0x0000_0080`).
pub const FILE_ATTRIBUTE_NORMAL: u32 = 0x0000_0080;

/| Symbolic link or junction reparse-point attribute (`0x0000_0400`).
pub const FILE_ATTRIBUTE_REPARSE_POINT: u32 = 0x0000_0400;

/| Open reparse point itself without dereferencing (`0x0020_0000`).
pub const FILE_FLAG_OPEN_REPARSE_POINT: u32 = 0x0020_0000;

/| Required to open a directory handle via `CreateFileW` (`0x0200_0000`).
pub const FILE_FLAG_BACKUP_SEMANTICS: u32 = 0x0200_0000;

/| Enable asynchronous `OVERLAPPED` I/O (`0x4000_0000`).
pub const FILE_FLAG_OVERLAPPED: u32 = 0x4000_0000;

/| Bypass lazy write cache (`0x8000_0000`).
pub const FILE_FLAG_WRITE_THROUGH: u32 = 0x8000_0000;

/| NTFS directory junction reparse tag (`0xA000_0003`).
pub const IO_REPARSE_TAG_MOUNT_POINT: u32 = 0xA000_0003;

/| NTFS symbolic link reparse tag (`0xA000_000C`).
pub const IO_REPARSE_TAG_SYMLINK: u32 = 0xA000_000C;

/| `SetFilePointerEx` seek from start of file (`0`).
pub const FILE_BEGIN: u32 = 0;

/| `SetFilePointerEx` seek from current file position (`1`).
pub const FILE_CURRENT: u32 = 1;

/| `SetFilePointerEx` seek from end of file (`2`).
pub const FILE_END: u32 = 2;

/| `FILE_INFO_BY_HANDLE_CLASS` `FileBasicInfo` (`0`).
pub const FILE_BASIC_INFO_CLASS: i32 = 0;

/| `FILE_INFO_BY_HANDLE_CLASS` `FileStandardInfo` (`1`).
pub const FILE_STANDARD_INFO_CLASS: i32 = 1;

/| `FILE_INFO_BY_HANDLE_CLASS` `FileRenameInfo` (`3`).
pub const FILE_RENAME_INFO_CLASS: i32 = 3;

/| `FILE_INFO_BY_HANDLE_CLASS` `FileDispositionInfo` (`4`).
pub const FILE_DISPOSITION_INFO_CLASS: i32 = 4;

/| `FILE_INFO_BY_HANDLE_CLASS` `FileAttributeTagInfo` (`9`).
pub const FILE_ATTRIBUTE_TAG_INFO_CLASS: i32 = 9;

/| `FILE_INFO_BY_HANDLE_CLASS` `FileIdInfo` (`18`).
pub const FILE_ID_INFO_CLASS: i32 = 18;

/| `FILE_INFO_BY_HANDLE_CLASS` `FileDispositionInfoEx` (`21` – Win10 RS1+ POSIX delete).
pub const FILE_DISPOSITION_INFO_EX_CLASS: i32 = 21;

/| `FILE_INFO_BY_HANDLE_CLASS` `FileRenameInfoEx` (`22` – Win10 RS1+ POSIX atomic rename).
pub const FILE_RENAME_INFO_EX_CLASS: i32 = 22;

/| `FileDispositionInfoEx` mark file for deletion (`0x0000_0001`).
pub const FILE_DISPOSITION_FLAG_DELETE: u32 = 0x0000_0001;

/| `FileDispositionInfoEx` unlink immediately even while mapped/open (`0x0000_0002`).
pub const FILE_DISPOSITION_FLAG_POSIX_SEMANTICS: u32 = 0x0000_0002;

/| `FileDispositionInfoEx` unlink read-only files without extra `SetFileAttributesW` (`0x0000_0010`).
pub const FILE_DISPOSITION_FLAG_IGNORE_READONLY_ATTRIBUTE: u32 = 0x0000_0010;

/| `FileRenameInfoEx` overwrite existing target (`0x0000_0001`).
pub const FILE_RENAME_FLAG_REPLACE_IF_EXISTS: u32 = 0x0000_0001;

/| `FileRenameInfoEx` replace open target atomically (`0x0000_0002`).
pub const FILE_RENAME_FLAG_POSIX_SEMANTICS: u32 = 0x0000_0002;

/| `MoveFileExW` overwrite existing destination (`0x0000_0001`).
pub const MOVEFILE_REPLACE_EXISTING: u32 = 0x0000_0001;

/| `MoveFileExW` flush rename metadata before returning (`0x0000_0008`).
pub const MOVEFILE_WRITE_THROUGH: u32 = 0x0000_0008;

/| `DeviceIoControl` mark file sparse (`0x0009_00C4`).
pub const FSCTL_SET_SPARSE: u32 = 0x0009_00C4;

/| `DeviceIoControl` ReFS `O(1)` copy-on-write extent clone (`0x0009_8344`).
pub const FSCTL_DUPLICATE_EXTENTS_TO_FILE: u32 = 0x0009_8344;

/| `FindFirstFileExW` `FindExInfoBasic` omitting legacy 8.3 name synthesis (`1`).
pub const FIND_INFO_BASIC: i32 = 1;

/| `FindFirstFileExW` `FIND_FIRST_EX_LARGE_FETCH` batched kernel directory buffer (`2`).
pub const FIND_FIRST_EX_LARGE_FETCH: u32 = 0x0000_0002;

/| `CreateFileMappingW` read-only page protection (`0x02`).
