pub const SYS_WRITE_X86_64: i64 = 1;

/| Linux `x86_64` `SYS_exit_group` syscall number (`231`).
pub const SYS_EXIT_GROUP_X86_64: i64 = 231;

/| Linux `aarch64` `SYS_write` syscall number (`64`).
pub const SYS_WRITE_AARCH64: i64 = 64;

/| Linux `aarch64` `SYS_exit_group` syscall number (`94`).
pub const SYS_EXIT_GROUP_AARCH64: i64 = 94;

/| Linux 5.6+ `SYS_openat2` syscall number (`437` on both `x86_64` and `aarch64`).
pub const SYS_OPENAT2: i64 = 437;

/| Linux `x86_64` `SYS_getdents64` syscall number (`217`).
@cfg(not (target.arch == "aarch64"))
pub const SYS_GETDENTS64: i64 = 217;

/| Linux `aarch64` `SYS_getdents64` syscall number (`61`).
@cfg(target.arch == "aarch64")
pub const SYS_GETDENTS64: i64 = 61;

/| Linux `x86_64` `SYS_newfstatat` syscall number (`262`).
@cfg(not (target.arch == "aarch64"))
pub const SYS_NEWFSTATAT: i64 = 262;

/| Linux `aarch64` `SYS_newfstatat` syscall number (`79`).
@cfg(target.arch == "aarch64")
pub const SYS_NEWFSTATAT: i64 = 79;

/| Linux `x86_64` `SYS_renameat2` syscall number (`316`).
@cfg(not (target.arch == "aarch64"))
pub const SYS_RENAMEAT2: i64 = 316;

/| Linux `aarch64` `SYS_renameat2` syscall number (`276`).
@cfg(target.arch == "aarch64")
pub const SYS_RENAMEAT2: i64 = 276;

/| Linux `x86_64` `SYS_statx` syscall number (`332`).
@cfg(not (target.arch == "aarch64"))
pub const SYS_STATX: i64 = 332;

/| Linux `aarch64` `SYS_statx` syscall number (`291`).
@cfg(target.arch == "aarch64")
pub const SYS_STATX: i64 = 291;

/| Special `dirfd` sentinel resolving relative paths against the current working directory (`-100`).
pub const AT_FDCWD: i32 = -100;

/| Do not dereference terminal symbolic links (`0x100`).
pub const AT_SYMLINK_NOFOLLOW: i32 = 0x0100;

/| Remove directory instead of unlinking file in `unlinkat` (`0x200`).
pub const AT_REMOVEDIR: i32 = 0x0200;

/| Follow symbolic links in `linkat` (`0x400`).
pub const AT_SYMLINK_FOLLOW: i32 = 0x0400;

/| Operate directly on `dirfd` when `pathname` is `""` (`0x1000`).
pub const AT_EMPTY_PATH: i32 = 0x1000;

/| Default `statx` synchronization policy matching `stat` (`0x0000`).
pub const AT_STATX_SYNC_AS_STAT: i32 = 0x0000;

/| `statx` mask requesting all standard POSIX metadata fields (`0x0000_07FF`).
pub const STATX_BASIC_STATS: u32 = 0x0000_07FF;

/| `statx` mask requesting creation / birth time (`0x0000_0800`).
pub const STATX_BTIME: u32 = 0x0000_0800;

/| Open for reading only (`0`).
pub const O_RDONLY: i32 = 0;

/| Open for writing only (`1`).
pub const O_WRONLY: i32 = 1;

/| Open for reading and writing (`2`).
pub const O_RDWR: i32 = 2;

/| Create file if it does not exist (`0o100`).
pub const O_CREAT: i32 = 0o100;

/| Fail if file exists when combined with `O_CREAT` (`0o200`).
pub const O_EXCL: i32 = 0o200;

/| Truncate existing regular file to zero length (`0o1000`).
pub const O_TRUNC: i32 = 0o1000;

/| Append all writes to end of file (`0o2000`).
pub const O_APPEND: i32 = 0o2000;

/| Non-blocking descriptor mode (`0o4000`).
pub const O_NONBLOCK: i32 = 0o4000;

/| Synchronized data-integrity writes (`0o10_000`).
pub const O_DSYNC: i32 = 0o10_000;

/| Linux `x86_64` require target to be a directory (`0o200_000`).
@cfg(not (target.arch == "aarch64"))
pub const O_DIRECTORY: i32 = 0o200_000;

/| Linux `aarch64` require target to be a directory (`0o40_000`).
@cfg(target.arch == "aarch64")
pub const O_DIRECTORY: i32 = 0o40_000;

/| Linux `x86_64` reject symbolic links on terminal component (`0o400_000`).
@cfg(not (target.arch == "aarch64"))
pub const O_NOFOLLOW: i32 = 0o400_000;

/| Linux `aarch64` reject symbolic links on terminal component (`0o100_000`).
@cfg(target.arch == "aarch64")
pub const O_NOFOLLOW: i32 = 0o100_000;

/| Set close-on-exec atomically at descriptor creation (`0o2_000_000`).
pub const O_CLOEXEC: i32 = 0o2_000_000;

/| Obtain an `O_PATH` handle without opening file data (`0o10_000_000`).
pub const O_PATH: i32 = 0o10_000_000;

/| Base bit for unnamed `O_TMPFILE` creation (`0o20_000_000 | O_DIRECTORY`).
pub const O_TMPFILE_BASE: i32 = 0o20_000_000;

/| `openat2` disallow crossing mount points (`0x01`).
pub const RESOLVE_NO_XDEV: u64 = 0x01;

/| `openat2` disallow `/proc` magic-link traversal (`0x02`).
pub const RESOLVE_NO_MAGICLINKS: u64 = 0x02;

/| `openat2` disallow any symlink traversal across all path components (`0x04`).
pub const RESOLVE_NO_SYMLINKS: u64 = 0x04;

/| `openat2` confine resolution strictly beneath `dirfd` (`0x08`).
pub const RESOLVE_BENEATH: u64 = 0x08;

/| `openat2` treat `dirfd` as the chroot root during resolution (`0x10`).
pub const RESOLVE_IN_ROOT: u64 = 0x10;

/| `renameat2` fail with `EEXIST` if target already exists (`1`).
pub const RENAME_NOREPLACE: u32 = 1;

/| `renameat2` atomically exchange source and destination (`2`).
pub const RENAME_EXCHANGE: u32 = 2;

/| Seek relative to start of file (`0`).
pub const SEEK_SET: i32 = 0;

/| Seek relative to current file offset (`1`).
pub const SEEK_CUR: i32 = 1;

/| Seek relative to end of file (`2`).
pub const SEEK_END: i32 = 2;

/| Pages cannot be accessed (`0`).
pub const PROT_NONE: i32 = 0;

/| Pages may be read (`1`).
pub const PROT_READ: i32 = 1;

/| Pages may be written (`2`).
pub const PROT_WRITE: i32 = 2;

/| Share mapping updates across processes (`1`).
pub const MAP_SHARED: i32 = 1;

/| Private copy-on-write mapping (`2`).
pub const MAP_PRIVATE: i32 = 2;

/| Shared `flock` lock (`1`).
pub const LOCK_SH: i32 = 1;

/| Exclusive `flock` lock (`2`).
pub const LOCK_EX: i32 = 2;

/| Non-blocking `flock` modifier (`4`).
pub const LOCK_NB: i32 = 4;

/| Release `flock` lock (`8`).
pub const LOCK_UN: i32 = 8;

/| Linux `FICLONE` `ioctl` request code for `O(1)` copy-on-write reflink (`0x4004_9409`).
pub const FICLONE: u64 = 0x4004_9409;

/| `inotify` file content modified (`0x0000_0002`).
pub const IN_MODIFY: u32 = 0x0000_0002;

/| `inotify` metadata changed (`0x0000_0004`).
pub const IN_ATTRIB: u32 = 0x0000_0004;

/| `inotify` file renamed out of watched directory (`0x0000_0040`).
pub const IN_MOVED_FROM: u32 = 0x0000_0040;

/| `inotify` file renamed into watched directory (`0x0000_0080`).
pub const IN_MOVED_TO: u32 = 0x0000_0080;

/| `inotify` child created inside watched directory (`0x0000_0100`).
pub const IN_CREATE: u32 = 0x0000_0100;

/| `inotify` child deleted from watched directory (`0x0000_0200`).
pub const IN_DELETE: u32 = 0x0000_0200;

/| `inotify` watched inode itself deleted (`0x0000_0400`).
pub const IN_DELETE_SELF: u32 = 0x0000_0400;

/| `inotify` watched inode itself moved (`0x0000_0800`).
pub const IN_MOVE_SELF: u32 = 0x0000_0800;

/| `inotify` kernel event queue overflowed (`0x0000_4000`).
pub const IN_Q_OVERFLOW: u32 = 0x0000_4000;

/| `inotify_init1` non-blocking flag (`0o4000`).
pub const IN_NONBLOCK: i32 = 0o4000;

/| `inotify_init1` close-on-exec flag (`0o2_000_000`).
pub const IN_CLOEXEC: i32 = 0o2_000_000;

/| `poll` readable readiness bit (`0x0001`).
pub const POLLIN: i16 = 0x0001;

/| `poll` writable readiness bit (`0x0004`).
pub const POLLOUT: i16 = 0x0004;

/| `poll` error condition bit (`0x0008`).
pub const POLLERR: i16 = 0x0008;

/| `poll` hangup bit (`0x0010`).
pub const POLLHUP: i16 = 0x0010;

/| System wall-clock (`CLOCK_REALTIME = 0`).
pub const CLOCK_REALTIME: i32 = 0;

/| Monotonic clock excluding wall jumps (`CLOCK_MONOTONIC = 1`).
pub const CLOCK_MONOTONIC: i32 = 1;

/| Suspend-aware monotonic clock (`CLOCK_BOOTTIME = 7`).
