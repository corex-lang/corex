//! Hardware Traps, Unrecoverable Panics, and Invariant Assertions (`core::panic`)
//!
//! Exposes cold, non-returning (`never`) failure entrypoints (`trap` and `panic`) together with
//! `assert_true` for runtime and compile-time invariant enforcement (`DR-07`).
//!
//! Under `COREX_ORACLE_TRACE_FILE` and `MirVm` oracle execution, both `trap` and `panic` record
//! deterministic trap markers (`exit_code = 101`) with identical `stderr` output across all tiers.
@cold
@noinline
@no_alloc
pub fn trap() -> never {
    @trap();
}

/// Writes `panic: <message>\n` to standard error and aborts execution (`@panic(message)`).
@cold
@noinline
@no_alloc
pub fn panic(message: str) -> never {
    @panic(message);
}

/// Verifies that `is_valid` holds, aborting via `panic(message)` when `is_valid` is `false`.
@inline
@no_alloc
pub fn assert_true(is_valid: bool, message: str) -> unit {
    if !is_valid {
        @panic(message);
    }
}
