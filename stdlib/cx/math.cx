// ---------------- Minimax & Scaling Constants -----------------
/| Veltkamp `2^27 + 1` split multiplier for 53-bit `f64` error-free `two_prod_f64`.
const VELTKAMP_SPLIT: f64 = 134_217_729.0;

/| Exact `2^52` integral threshold for `round_ties_even_f64`.
const TWO_POW_52: f64 = 4_503_599_627_370_496.0;

/| Exact `2^23` integral threshold for `round_ties_even_f32`.
const TWO_POW_23: f32 = 8_388_608.0_f32;

/| Exact `2^1023` step multiplier for `ldexp_f64`.
const SCALE_UP_1023: f64 = 8.98846567431157953865e+307;

/| Exact `2^-1022` step multiplier for `ldexp_f64`.
const SCALE_DN_1022: f64 = 2.22507385850720138309e-308;

/| High 64-bit fixed-point word of `pi / 2` (`2^-63` weight) for `payne_hanek_reduce_f64`.
const PIO2_W0: u64 = 0xC90F_DAA2_2168_C234_u64;

/| Low 64-bit fixed-point word of `pi / 2` (`2^-127` weight) for `payne_hanek_reduce_f64`.
const PIO2_W1: u64 = 0xC4C6_628B_80DC_1CD1_u64;

/| Exact `2^-63` binary scaling factor converting Payne–Hanek top word to `f64`.
const SCALE_M63: f64 = 1.08420217248550443401e-19;

/| Exact `2^-127` binary scaling factor converting Payne–Hanek middle word to `f64`.
const SCALE_M127: f64 = 5.87747175411143753984e-39;

/| Reciprocal `2 / pi` (`0.6366197723675814`) for Cody–Waite quadrant selection.
const INV_PIO2: f64 = 6.36619772367581382433e-01;

/| High double-double word of `pi / 180` for `degrees_to_radians`.
const DEG_TO_RAD_HI: f64 = 1.74532925199432954744e-02;

/| Low double-double word of `pi / 180` for `degrees_to_radians`.
const DEG_TO_RAD_LO: f64 = 2.94865227087016870932e-19;

/| High double-double word of `180 / pi` for `radians_to_degrees`.
const RAD_TO_DEG_HI: f64 = 5.72957795130823228646e+01;

/| Low double-double word of `180 / pi` for `radians_to_degrees`.
const RAD_TO_DEG_LO: f64 = -1.98784956705762829140e-15;

/| Exact `2^-28` pre-scaling factor preventing Veltkamp `two_prod_f64` overflow above `1.0e299`.
const RAD_DEG_PRESCALE_DOWN: f64 = 3.7252902984619140625e-09;

/| Cody–Waite upper 33-bit `ln(2)` split constant shared across `exp`, `expm1`, `ln`, and `ln_1p`.
const LN2_CW_HI: f64 = 0.6931471803691238;

/| Cody–Waite lower 53-bit `ln(2)` tail constant (`0x3DEA_39EF_3579_3C76`) shared across `exp`/`ln`.
const LN2_CW_LO: f64 = 1.9082149292705877e-10;

/| Remez rational `exp` kernel coefficient `P1` (`0x3FC5_5555_5555_553E`).
const EXP_POLY_P1: f64 = 0.16666666666666602;

/| Remez rational `exp` kernel coefficient `P2` (`0xBF66_C16C_16BE_BD93`).
const EXP_POLY_P2: f64 = -0.0027777777777015593;

/| Remez rational `exp` kernel coefficient `P3` (`0x3F11_566A_AF25_DE2C`).
const EXP_POLY_P3: f64 = 6.613756321437934e-05;

/| Remez rational `exp` kernel coefficient `P4` (`0xBEBB_BD41_C5D2_6BF1`).
