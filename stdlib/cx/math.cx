/| Remez rational `exp` kernel coefficient `P5` (`0x3E66_3769_72BE_A4D0`).
const EXP_POLY_P5: f64 = 4.1381367970572385e-08;

/| Minimax `ln((1 + s) / (1 - s))` odd-power coefficient `LG1` (`0x3FE5_5555_5555_5593`).
const LN_POLY_LG1: f64 = 0.6666666666666735;

/| Minimax `ln((1 + s) / (1 - s))` odd-power coefficient `LG2` (`0x3FD9_9999_9997_FA04`).
