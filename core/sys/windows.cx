/| `FILE_NOTIFY_INFORMATION` rename destination name (`5`).
pub const FILE_ACTION_RENAMED_NEW_NAME: u32 = 5;

/| `WaitForSingleObject` object signaled (`0x0000_0000`).
pub const WAIT_OBJECT_0: u32 = 0x0000_0000;

/| `WaitForSingleObject` timeout expired (`0x0000_0102`).
pub const WAIT_TIMEOUT: u32 = 0x0000_0102;

/| `WaitForSingleObject` wait failed (`0xFFFF_FFFF`).
pub const WAIT_FAILED: u32 = 0xFFFF_FFFF;

/| `WaitForSingleObject` infinite timeout (`0xFFFF_FFFF`).
pub const INFINITE_TIMEOUT: u32 = 0xFFFF_FFFF;

/| `GetFileType` disk file (`0x0001`).
pub const FILE_TYPE_DISK: u32 = 0x0001;

/| `GetFileType` character/console device (`0x0002`).
pub const FILE_TYPE_CHAR: u32 = 0x0002;

/| `GetFileType` anonymous or named pipe (`0x0003`).
pub const FILE_TYPE_PIPE: u32 = 0x0003;

/| `SetHandleInformation` `HANDLE_FLAG_INHERIT` (`0x0000_0001`).
pub const HANDLE_FLAG_INHERIT: u32 = 0x0000_0001;

/| `STARTUPINFOW` use explicit `std_input`/`std_output`/`std_error` (`0x0000_0100`).
pub const STARTF_USESTDHANDLES: u32 = 0x0000_0100;

/| `CreateProcessW` pass UTF-16 environment block (`0x0000_0400`).
pub const CREATE_UNICODE_ENVIRONMENT: u32 = 0x0000_0400;

/| `CreateProcessW` `lpStartupInfo` points to `Win32StartupInfoExW` (`0x0008_0000`).
pub const EXTENDED_STARTUPINFO_PRESENT: u32 = 0x0008_0000;

/| `CreateProcessW` suppress new console window creation (`0x0800_0000`).
pub const CREATE_NO_WINDOW: u32 = 0x0800_0000;

/| `UpdateProcThreadAttribute` explicit handle-inheritance allowlist (`0x0002_0002`).
pub const PROC_THREAD_ATTRIBUTE_HANDLE_LIST: usize = 0x0002_0002;

/| `GetExitCodeProcess` sentinel indicating child is still running (`259`).
pub const STILL_ACTIVE_EXIT_CODE: u32 = 259;

/| `NT` case-insensitive object-name lookup flag (`0x0000_0040`).
pub const OBJ_CASE_INSENSITIVE: u32 = 0x0000_0040;

/| `NtCreateFile` `FILE_SUPERSEDE` disposition (`0`).
pub const FILE_SUPERSEDE: u32 = 0;

/| `NtCreateFile` `FILE_OPEN` existing disposition (`1`).
pub const FILE_OPEN: u32 = 1;

/| `NtCreateFile` `FILE_CREATE` fail-if-exists disposition (`2`).
pub const FILE_CREATE: u32 = 2;

/| `NtCreateFile` `FILE_OPEN_IF` open-or-create disposition (`3`).
pub const FILE_OPEN_IF: u32 = 3;

/| `NtCreateFile` `FILE_OVERWRITE` truncate-existing disposition (`4`).
pub const FILE_OVERWRITE: u32 = 4;

/| `NtCreateFile` `FILE_OVERWRITE_IF` create-or-truncate disposition (`5`).
pub const FILE_OVERWRITE_IF: u32 = 5;

/| `NtCreateFile` require directory target (`0x0000_0001`).
pub const FILE_DIRECTORY_FILE: u32 = 0x0000_0001;

/| `NtCreateFile` synchronous non-alertable handle (`0x0000_0020`).
pub const FILE_SYNCHRONOUS_IO_NONALERT: u32 = 0x0000_0020;

/| `NtCreateFile` reject directory targets (`0x0000_0040`).
pub const FILE_NON_DIRECTORY_FILE: u32 = 0x0000_0040;

/| `NtCreateFile` do not dereference reparse point (`0x0020_0000`).
pub const FILE_OPEN_REPARSE_POINT: u32 = 0x0020_0000;

/| Registry pseudo-handle bits for `HKEY_CURRENT_USER` (`0x8000_0001`).
pub const HKEY_CURRENT_USER_BITS: usize = 0x8000_0001;

/| Registry value-read access right (`0x0001`).
pub const KEY_QUERY_VALUE: u32 = 0x0001;

/| Registry NUL-terminated UTF-16 string type (`1`).
pub const REG_SZ: u32 = 1;

/| Registry expandable `%VAR%` UTF-16 string type (`2`).
pub const REG_EXPAND_SZ: u32 = 2;

/| Win32 `ERROR_SUCCESS` (`0`).
pub const ERROR_SUCCESS: u32 = 0;

/| Win32 `ERROR_FILE_NOT_FOUND` (`2`).
pub const ERROR_FILE_NOT_FOUND: u32 = 2;

/| Win32 `ERROR_PATH_NOT_FOUND` (`3`).
