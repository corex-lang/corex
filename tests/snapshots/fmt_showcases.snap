/# Dashboard formatting showcase.

use cx.io.{self, BufReader as Br, Read, Write};
use cx.mem;

const MIN_PORT: u16 = 80;
const MAX_PORT: u16 = 65535;
const SQL_FILTER: str = "meta != '{}'";

/| Aligned metric wrapper.
@repr(C, align: 8, zero_pad: true) @derive(Copy, Debug)
pub struct Metric[T] {
    pub val: T,
}

pub fn render_dashboard[T](opt_val: T?, raw_score: i32) -> View {
    let .Some(item) = opt_val else {
        return Empty;
    };
    let table = [
          1,  20, 300,   4,  50, 600,   7,  80,
        900,  10,
    ];
    let score = raw_score
        |> compute_step()
        |> clamp_score(0, 100);
    let total = table
        .iter()
        .sum_all();
    let broken_pt = Point {
        x: score,
        y: total,
    };
    let query = "
        SELECT id FROM metrics WHERE meta != '{}'
        ";
    let tier = if score == 0 => "idle"
        else if score < 50 => "warm"
        else "hot";
    let summary = f"{score=} tier={tier} sql={query}";
    let label = match score {
        0 => "idle",
        _ => "active",
    };
    Card(padding: if score > 0 => 16 else 8) {
        Text(value: label, detail: summary);
    }
}
