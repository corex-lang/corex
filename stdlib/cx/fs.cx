// ------------- Recursive Create & Remove Helpers --------------
/| Ensures `dir_view` and all missing ancestor directories exist (iterative/bounded, `MAX_DIR_WALK_DEPTH`).
fn create_dir_all_inner(dir_view: Path, perms: FilePermissions, depth: usize, /) -> unit!FsError {
    if dir_view.is_empty() or is_single_dot(dir_view.as_bytes()) {
        return .Ok(());
    }
    if depth > MAX_DIR_WALK_DEPTH {
        return .Err(
            attach_failed_path(FsError.from_kind(.InvalidInput, op: .Mkdir), dir_view.as_bytes()),
        );
    }
    if os_path_metadata(dir_view.as_bytes(), true) is .Ok(existing_meta) {
        if existing_meta.is_dir() {
            return .Ok(());
        }
        return .Err(
            attach_failed_path(FsError.from_kind(.AlreadyExists, op: .Mkdir), dir_view.as_bytes()),
        );
    }
    if os_mkdir_single(dir_view.as_bytes(), perms) is .Ok(_) {
        return .Ok(());
    }
    if dir_view.parent() is .Some(parent_view)
        and not parent_view.is_empty()
        and parent_view != dir_view {
        create_dir_all_inner(parent_view, perms, depth +% 1_usize)?;
    }
    if os_mkdir_single(dir_view.as_bytes(), perms) is .Err(mkdir_err) {
        if os_path_metadata(dir_view.as_bytes(), true) is .Ok(race_meta) and race_meta.is_dir() {
            return .Ok(());
        }
        return .Err(mkdir_err);
    }
    .Ok(())
}

/| Recursively deletes a directory tree without following symlinks/junctions (`MAX_DIR_WALK_DEPTH`).
fn remove_dir_all_inner(target_view: Path, depth: usize, /) -> unit!FsError {
    if depth > MAX_DIR_WALK_DEPTH {
        return .Err(
            attach_failed_path(FsError.from_kind(.InvalidInput, op: .Unlink), target_view.as_bytes()),
        );
    }
    let lmeta: Metadata = os_path_metadata(target_view.as_bytes(), false)?;
    if lmeta.is_symlink() {
        return os_remove_file(target_view.as_bytes());
    }
    if not lmeta.is_dir() {
        return .Err(
            attach_failed_path(
                FsError.from_kind(.NotADirectory, op: .Unlink),
                target_view.as_bytes(),
            ),
        );
    }
    let dir_bits: isize = os_dir_open(target_view.as_bytes())?;
    let iter_raw: *mut opaque = os_dir_entries(dir_bits) catch |ie| {
        os_close_fd(dir_bits) catch {};
        return .Err(ie);
    };
    while true {
        let next_entry: DirEntry? = os_dir_iter_next(iter_raw) catch |ne| {
            os_dir_iter_close(iter_raw);
            os_close_fd(dir_bits) catch {};
            return .Err(ne);
        };
        let entry: DirEntry = next_entry orelse break;
        let child_pb: PathBuf = target_view.join(entry.name.as_path());
        if entry.file_type == .Directory {
            if remove_dir_all_inner(child_pb.as_path(), depth +% 1_usize) is .Err(sub_err) {
                os_dir_iter_close(iter_raw);
                os_close_fd(dir_bits) catch {};
                return .Err(sub_err);
            }
        } else if os_remove_file(child_pb.as_bytes()) is .Err(rm_err) {
            os_dir_iter_close(iter_raw);
            os_close_fd(dir_bits) catch {};
            return .Err(rm_err);
        }
    }
    os_dir_iter_close(iter_raw);
    os_close_fd(dir_bits) catch {};
    os_remove_empty_dir(target_view.as_bytes())
}

/| Streams all remaining bytes of `file` (after optional `prefix`) into `arena` (`64 B` SIMD-aligned).
@std_cap_boundary(clears: [unsafe_op])
fn stream_file_into_arena(
    arena: &mut Arena,
    file: &mut File,
    prefix: &[u8],
    initial_hint: usize,
    nul_sentinel: bool,
    path_bytes: &[u8],
    /,
) -> LoadedFile!FsError {
    let extra_nul: usize = if nul_sentinel => 1_usize else 0_usize;
    let base_hint: usize = if initial_hint > prefix.len() => initial_hint else prefix.len();
    if base_hint > (usize.MAX -% 2_usize) {
        return .Err(attach_failed_path(FsError.from_kind(.OutOfMemory, op: .Read), path_bytes));
    }
    var alloc_sz: usize = align_up(base_hint +% 1_usize +% extra_nul, 64_usize) orelse {
        return .Err(attach_failed_path(FsError.from_kind(.OutOfMemory, op: .Read), path_bytes));
    };
    var buf_ptr: *mut u8 = arena
        .as_handle()
        .alloc(Layout { size: alloc_sz, alignment: 64_usize })
        catch {
            return .Err(attach_failed_path(FsError.from_kind(.OutOfMemory, op: .Read), path_bytes));
        };
    var total_read: usize = prefix.len();
    if total_read > 0_usize {
        unsafe {
            @memcpy(buf_ptr as *mut opaque, prefix.as_ptr() as *opaque, total_read);
        }
    }
    while true {
        let usable_cap: usize = alloc_sz -% extra_nul;
        if total_read >= usable_cap {
            if alloc_sz > (usize.MAX >> 1_usize) {
                return .Err(
                    attach_failed_path(FsError.from_kind(.OutOfMemory, op: .Read), path_bytes),
                );
            }
            let next_sz: usize = align_up(alloc_sz * 2_usize, 64_usize) orelse {
                return .Err(
                    attach_failed_path(FsError.from_kind(.OutOfMemory, op: .Read), path_bytes),
                );
            };
            let next_ptr: *mut u8 = arena
                .as_handle()
                .alloc(Layout { size: next_sz, alignment: 64_usize })
                catch {
                    return .Err(
                        attach_failed_path(FsError.from_kind(.OutOfMemory, op: .Read), path_bytes),
                    );
                };
            if total_read > 0_usize {
                unsafe {
                    @memcpy(next_ptr as *mut opaque, buf_ptr as *opaque, total_read);
                }
            }
            buf_ptr = next_ptr;
            alloc_sz = next_sz;
        }
        var out_chunk = unsafe {
            OutBuf.from_raw_parts(buf_ptr.add(total_read), (alloc_sz -% extra_nul) -% total_read)
        };
        let got_n: usize = file.read_out(&mut out_chunk) catch |read_err| {
            if read_err.is_interrupted() {
                continue;
            }
            return .Err(attach_failed_path(FsError.from_io(read_err, op: .Read), path_bytes));
        };
        if got_n == 0_usize {
            break;
        }
        total_read = total_read +% got_n;
    }
    if nul_sentinel {
        unsafe {
            buf_ptr.add(total_read).write(0_u8);
        }
    }
    .Ok(
        .ArenaBuf(
            unsafe {
                @slice_from_raw_parts(buf_ptr as *u8, total_read)
            },
        ),
    )
}

// ------------------------------------- PUBLIC API --------------------------------------
// -------------------- FsError & Upcasting ---------------------
impl FsError {
    /| Wraps an `IoError` as an `FsError` (`0` allocations; overrides `op` when `op != .None`).
    @no_alloc @no_panic
    pub fn from_io(err: IoError, /, *, op: IoOp = .None) -> FsError {
        var bits = @bit_cast[IoErrorBits](err.packed_repr as u64);
        if op != .None {
            let op_donor = @bit_cast[IoErrorBits](
                IoError.from_kind(.Other, op: op).packed_repr as u64,
            );
            bits.op = op_donor.op;
        }
        pack_fs_error_bits(bits)
    }

    /| Constructs a synthetic `FsError` from `kind` and optional `op` (`ErrDomain.Generic`).
    @no_alloc @no_panic
    pub fn from_kind(kind: IoErrorKind, /, *, op: IoOp = .None) -> FsError {
        FsError.from_io(IoError.from_kind(kind, op: op))
    }

    /| Classifies a raw OS/WASI/NT/Sim status code into an 8-byte `FsError`.
    @no_alloc @no_panic
    pub fn from_raw_os(raw_code: i32, /, *, domain: ErrDomain, op: IoOp = .None) -> FsError {
        FsError.from_io(IoError.from_raw_os(raw_code, domain: domain, op: op))
    }

    /| Converts `self` losslessly into the isomorphic 8-byte `IoError`.
    @no_alloc @no_panic
    pub fn into_io_error(self) -> IoError {
        IoError {
            packed_repr: self.packed_repr,
        }
    }

    /| Returns the normalized `IoErrorKind` classification of `self`.
    @no_alloc @no_panic
    pub fn kind(self) -> IoErrorKind = self.into_io_error().kind();

    /| Returns the `IoOp` tag recorded when `self` was created.
    @no_alloc @no_panic
    pub fn op(self) -> IoOp = self.into_io_error().op();

    /| Returns the originating `ErrDomain` of `self`.
    @no_alloc @no_panic
    pub fn domain(self) -> ErrDomain = self.into_io_error().domain();

    /| Returns the raw OS status code when `domain() != .Generic`, or `.None`.
    @no_alloc @no_panic
    pub fn os_error(self) -> i32? = self.into_io_error().os_error();

    /| Returns `true` when `self.kind() == .Interrupted` (`EINTR`).
    @no_alloc @no_panic
    pub fn is_interrupted(self) -> bool = self.kind() == .Interrupted;

    /| Returns the captured failed `Path` from `context.diagnostics` (`FsDiagPathRing`) when attached, or `.None`.
    @std_cap_boundary(clears: [unsafe_op, may_panic]) @no_alloc @no_panic
    pub fn failed_path(self) -> Path? {
        let bits = @bit_cast[IoErrorBits](self.packed_repr as u64);
        if bits.diag_slot == 0_u8 or bits.diag_slot > 8_u8 {
            return .None;
        }
        let diag_slot: DiagSink = context.diagnostics;
        let ring_ptr: *FsDiagPathRing = unsafe {
            ((&raw diag_slot) as **FsDiagPathRing).read()
        };
        if ring_ptr.is_null() {
            return .None;
        }
        if ((ring_ptr as usize) & 7_usize) != 0_usize {
            return .None;
        }
        // Check `magic_tag` (`8 B` at offset `0`) before forming any reference or reading past `8 B`:
        if unsafe {
            (ring_ptr as *u64).read()
        }
            != FS_DIAG_RING_MAGIC {
            return .None;
        }
        let slot_idx = (bits.diag_slot -% 1_u8) as usize;
        let slot_ptr: *FsDiagPathSlot = unsafe {
            (&raw ring_ptr.*.slots[0]).add(slot_idx)
        };
        if slot_ptr.is_null() {
            return .None;
        }
        let byte_len = unsafe {
            (&raw slot_ptr.*.byte_len).read()
        } as usize;
        if byte_len == 0_usize or byte_len > 256_usize {
            return .None;
        }
        let slice: &[u8] = unsafe {
            @slice_from_raw_parts(&raw slot_ptr.*.path_bytes[0], byte_len)
        };
        .Some(Path.from_bytes(slice))
    }

    /| Returns a static human-readable description of `self.kind()`.
    @no_alloc @no_panic
    pub fn message(self) -> str = self.into_io_error().message();
}

impl TrivialDrop for FsError {}

impl FromError[IoError] for FsError {
    /| Upcasts `IoError` into `FsError` in `O(1)` (`0` allocations) for `?` propagation.
    @from @no_alloc @no_panic
    pub fn from_error(src: IoError, /) -> FsError = FsError.from_io(src);
}

impl FromError[FsError] for IoError {
    /| Upcasts `FsError` into `IoError` in `O(1)` (`0` allocations) for `?` propagation.
    @from @no_alloc @no_panic
    pub fn from_error(src: FsError, /) -> IoError = src.into_io_error();
}

impl Display for FsError {
    /| Formats `self` with optional `failed_path()` and `(os error <code>)` into `out`.
    @no_alloc
    pub fn fmt(&self, out: &mut FmtWriter, spec: FmtSpec, /) -> unit!FmtError {
        _ = spec;
        let err_val: FsError = self.*;
        let msg: str = err_val.message();
        if err_val.failed_path() is .Some(fp) {
            if fp.to_str() is .Some(fp_str) {
                if err_val.os_error() is .Some(code) {
                    return @fmt_write(out, f"{msg}: '{fp_str}' (os error {code})");
                }
                return @fmt_write(out, f"{msg}: '{fp_str}'");
            }
        }
        if err_val.os_error() is .Some(code) {
            return @fmt_write(out, f"{msg} (os error {code})");
        }
        out.write_str(msg)
    }
}

impl Debug for FsError {
    /| Formats structural `FsError` fields (`kind`, `op`, `domain`, `os_error`) into `out`.
    @no_alloc
    pub fn fmt_debug(&self, out: &mut FmtWriter, spec: FmtSpec, /) -> unit!FmtError {
        _ = spec;
        let err_val: FsError = self.*;
        @fmt_write(
            out,
            f"FsError {{ kind: {err_val.kind():?}, op: {err_val.op():?}, domain: {err_val.domain():?}, os_error: {err_val.os_error():?} }}",
        )
    }
}

// -------------- Metadata, Permissions & Options ---------------
impl FileType {
    /| Returns `true` when `self == .RegularFile`.
    @no_alloc @no_panic
    pub fn is_file(self) -> bool = self == .RegularFile;

    /| Returns `true` when `self == .Directory`.
    @no_alloc @no_panic
    pub fn is_dir(self) -> bool = self == .Directory;

    /| Returns `true` when `self == .Symlink`.
    @no_alloc @no_panic
    pub fn is_symlink(self) -> bool = self == .Symlink;
}

impl TrivialDrop for FileType {}

impl FilePermissions {
    /| Default regular-file creation mode (`0o644`, read-write).
    pub const DEFAULT_FILE: FilePermissions = FilePermissions {
        posix_mode: 0o644_u16,
        readonly: false,
        executable: false,
        reserved: 0_u16,
    };

    /| Default executable-file creation mode (`0o755`, read-write-execute).
    pub const DEFAULT_EXE: FilePermissions = FilePermissions {
        posix_mode: 0o755_u16,
        readonly: false,
        executable: true,
        reserved: 0_u16,
    };

    /| Default directory creation mode (`0o755`, read-write-traverse).
    pub const DEFAULT_DIR: FilePermissions = FilePermissions {
        posix_mode: 0o755_u16,
        readonly: false,
        executable: true,
        reserved: 0_u16,
    };

    /| Constructs `FilePermissions` from a 12-bit POSIX mode (`0o644`, `0o755`, etc.).
    @no_alloc @no_panic
    pub fn from_posix_mode(mode: u16, /) -> FilePermissions {
        let masked: u16 = mode & 0o7777_u16;
        FilePermissions {
            posix_mode: masked,
            readonly: (masked & 0o222_u16) == 0_u16,
            executable: (masked & 0o111_u16) != 0_u16,
            reserved: 0_u16,
        }
    }

    /| Returns `true` when write permissions are disabled on `self`.
    @no_alloc @no_panic
    pub fn is_readonly(self) -> bool = self.readonly;

    /| Returns `true` when execute/search permissions are enabled on `self`.
    @no_alloc @no_panic
    pub fn is_executable(self) -> bool = self.executable;

    /| Returns a copy of `self` with `readonly` updated and `posix_mode` write bits synchronized.
    @no_alloc @no_panic
    pub fn with_readonly(self, is_ro: bool, /) -> FilePermissions {
        let next_mode: u16 = if is_ro => self.posix_mode & ~0o222_u16
            else (self.posix_mode | 0o200_u16);
        FilePermissions {
            posix_mode: next_mode,
            readonly: is_ro,
            executable: self.executable,
            reserved: 0_u16,
        }
    }
}

impl TrivialDrop for FilePermissions {}

impl Metadata {
    /| Returns `true` when `self.file_type == .RegularFile`.
    @no_alloc @no_panic
    pub fn is_file(&self) -> bool = self.file_type == .RegularFile;

    /| Returns `true` when `self.file_type == .Directory`.
    @no_alloc @no_panic
    pub fn is_dir(&self) -> bool = self.file_type == .Directory;

    /| Returns `true` when `self.file_type == .Symlink`.
    @no_alloc @no_panic
    pub fn is_symlink(&self) -> bool = self.file_type == .Symlink;

    /| Returns the logical byte length (`self.size`).
    @no_alloc @no_panic
    pub fn len(&self) -> u64 = self.size;

    /| Returns `true` when `self.size == 0`.
    @no_alloc @no_panic
    pub fn is_empty(&self) -> bool = self.size == 0_u64;
}

impl TrivialDrop for Metadata {}

impl TrivialDrop for OpenFlags {}

impl OpenOptions {
    /| Returns read-only `OpenOptions` (`read: true`, `0o644`).
    @no_alloc @no_panic
    pub fn read_only() -> OpenOptions = OpenOptions { .. };

    /| Returns truncating write-create `OpenOptions` (`write: true, create: true, truncate: true`).
    @no_alloc @no_panic
    pub fn write_create() -> OpenOptions {
        OpenOptions {
            flags: OpenFlags {
                read: false,
                write: true,
                append: false,
                create: true,
                create_new: false,
                truncate: true,
                no_follow: false,
                sync_data: false,
                lock_shared: false,
                lock_exclusive: false,
                nonblocking_lock: false,
                reserved: 0_u8,
            },
            permissions: FilePermissions.DEFAULT_FILE,
        }
    }

    /| Returns atomic append-create `OpenOptions` (`write: true, append: true, create: true`).
    @no_alloc @no_panic
    pub fn append_create() -> OpenOptions {
        OpenOptions {
            flags: OpenFlags {
                read: false,
                write: true,
                append: true,
                create: true,
                create_new: false,
                truncate: false,
                no_follow: false,
                sync_data: false,
                lock_shared: false,
                lock_exclusive: false,
                nonblocking_lock: false,
                reserved: 0_u8,
            },
            permissions: FilePermissions.DEFAULT_FILE,
        }
    }
}

impl TrivialDrop for OpenOptions {}

impl TrivialDrop for DurabilityMode {}

impl TrivialDrop for CreateTargetKind {}

impl TrivialDrop for MaterializePolicy {}

impl TrivialDrop for MaterializeMethod {}

