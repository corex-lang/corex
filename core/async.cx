/# Structured Cooperative Async Concurrency, Nurseries, and Reactor Primitives (`core.async`)
/#
/# Defines stackless coroutine polling (`Poll[T]`, `Waker`), cooperative cancellation tokens
/# (`CancelToken`, `CancelSource`), the 32-byte inline `TaskHeader`, `@linear` structured concurrency
/# handles (`TaskGroup[E]`, `TaskHandle[T]`), and reactor-routed `yield_now` / `block_on` / `task_group`
/# entry points (`DR-08`, `DR-17` §3.2, `DR-18` §2.1, `SE-08`, `SE-20`).
/#
/# Every `async` frame is statically bounded at `16 KiB` (`ASYNC_INLINE_CAP_BYTES`) with zero hidden
/# per-await heap allocations and deterministic `defer` cancellation cleanup across all 4 execution tiers.

// ---------------------------------------- TYPES ----------------------------------------
/| Cooperative step outcome returned when polling an asynchronous state machine (`DR-08` §3.1).
pub enum Poll[T] {
    /| State machine completed and produced its final output value.
    Ready(T),
    /| State machine suspended awaiting reactor readiness or cooperative reschedule.
    Pending,
}

/| C-ABI wakeup handle notified by a reactor or completion source when a suspended task becomes runnable.
@repr(C)
pub struct Waker {
    /| Opaque wakeup target state pointer passed to `wake_fn`.
    pub data: *mut opaque,
    /| Optional C-ABI wakeup callback invoked on readiness notification.
    pub wake_fn: (extern "C" fn(data: *mut opaque))?,
}

/| Lightweight `Copy` cooperative cancellation capability propagated via `context.cancel_token` (`SE-08`).
@repr(C)
pub struct CancelToken {
    /| Shared pointer to the atomic cancellation flag word (`0` = active, non-zero = canceled).
    flag_ptr: *u64,
}

/| Owned cancellation flag source paired with `CancelToken` readers inside structured nurseries.
@repr(C, align: 8)
pub struct CancelSource {
    /| Backing 64-bit atomic cancellation flag (`0` = active, `1` = canceled).
    flag: u64,
}

/| Canonical 32-byte (on 64-bit targets) intrusive coroutine task control header (`DR-08` §4.1).
@repr(C)
pub struct TaskHeader {
    /| Type-erased coroutine poll function address (`0` when uninitialized).
    pub poll_fn: usize,
    /| Type-erased coroutine cancellation/drop function address (`0` when trivial).
    pub drop_fn: usize,
    /| Enclosing nursery or waiter link word.
    pub parent_or_waker: usize,
    /| Packed state discriminant and cancellation/completion status flags.
    pub state_and_flags: u64,
}

/| C-ABI proactor and `--sim` `SimReactor` submission descriptor passed to `ReactorVTable.submit_io` (`STD-02`).
@repr(C) @derive(Copy)
pub struct IoSubmission {
    /| Canonical `SIM_OP_*` operation opcode (`IoOpKind`).
    pub kind: u8,
    /| Operation-specific flags (`DurabilityMode`, `LockMode`, `OpenFlags` sub-selector, etc.).
    pub flags: u8,
    /| Owning executor worker index (`0` for synchronous/single-threaded submission).
    pub worker_id: u16,
    /| Target virtual or host file descriptor / handle slot (`-1` when unused).
    pub fd_or_handle: i32,
    /| Byte offset, nanosecond duration, or packed auxiliary 64-bit operand.
    pub offset_or_ns: u64,
    /| Payload or structured request/response buffer pointer (`null` when unused).
    pub buf_ptr: *mut u8,
    /| Byte length of `buf_ptr` (`0` when unused).
    pub buf_len: u32,
    /| Proactor `CompletionReaper` slot index or secondary 32-bit operand.
    pub slot_index: u32,
}

/| Dispatch vtable routed through `context.reactor` (`slot 8`, `DR-08` §5.3, `DR-18` §2.1).
@repr(C)
pub struct ReactorVTable {
    /| Monotonic nanosecond clock query hook.
    pub monotonic_ns: usize,
    /| Wall-clock Unix epoch nanosecond query hook.
    pub wall_epoch_ns: usize,
    /| Cryptographic or deterministic simulation PRNG byte-fill hook.
    pub fill_rng: usize,
    /| Non-blocking I/O or timer submission hook.
    pub submit_io: usize,
    /| In-flight asynchronous I/O cancellation hook.
    pub cancel_io: usize,
    /| Single-turn readiness polling or thread-parking hook.
    pub poll_or_park: usize,
    /| Cooperative task reschedule hook.
    pub yield_task: usize,
    /| Deterministic simulation fault-injection (`BUGGIFY`) gate hook.
    pub buggify_gate: usize,
}

/| `Copy` reactor dispatch capability stored in `context.reactor` (`slot 8`, `SE-08`).
@repr(C)
pub struct Reactor {
    /| Pointer to the active reactor dispatch table (`null` selects the default local executor).
    pub vtable: *ReactorVTable,
}

/| `Copy` reactor state capability stored in `context.reactor_ctx` (`slot 9`, `SE-08`).
@repr(C) @not_send
pub struct ReactorCtx {
    /| Opaque mutable pointer to the active reactor or deterministic simulation state.
    pub state: *mut opaque,
}

/| Single-suspension awaitable returned by `yield_now()` for cooperative scheduler fairness.
@repr(C) @must_use
pub struct YieldNow {
    /| `true` once this awaitable has yielded control once to the active executor.
    pub has_yielded: bool,
}

/| Must-consume `@linear` handle to a child task spawned inside an enclosing `TaskGroup` (`SE-20`).
@linear
pub struct TaskHandle[T] {
    /| Deterministic task slot identifier within the owning `TaskGroup` nursery.
    pub task_id: u64,
}

/| Must-consume `@linear` structured concurrency nursery bounding all spawned child tasks (`DR-08`, `SE-20`).
@linear
pub struct TaskGroup[E = never] {
    /| Deterministic nursery scope identifier in the active executor.
    pub group_id: u64,
    /| `true` once cooperative cancellation has been requested across sibling tasks.
    pub is_canceling: bool,
}

// --------------------------------------- CONSTS ----------------------------------------
/| Byte size of `TaskHeader` on 64-bit targets (`4 * 8 = 32` bytes, `DR-08` §4.1).
pub const TASK_HEADER_BYTES_64: usize = 32;

/| Compile-time inline `async` coroutine state-machine frame cap (`16 KiB`, `DR-17` §3.2, `E0317`).
pub const ASYNC_INLINE_CAP_BYTES: usize = 16_384;

/| Sentinel returned by `DEFAULT_NOOP_REACTOR_VTABLE.submit_io` (`i64.MIN`) when no `SimReactor` intercepts the op.
pub const SIM_UNHANDLED_SENTINEL: i64 = i64.MIN;

// ------------------- `IoOpKind` Sim Opcodes -------------------
/| No-op proactor submission (`IoOpKind.nop = 0`).
pub const SIM_OP_NOP: u8 = 0;

/| Asynchronous stream/socket read (`IoOpKind.read = 1`).
pub const SIM_OP_READ: u8 = 1;

/| Asynchronous stream/socket write (`IoOpKind.write = 2`).
pub const SIM_OP_WRITE: u8 = 2;

/| Asynchronous listener accept (`IoOpKind.accept = 3`).
pub const SIM_OP_ACCEPT: u8 = 3;

/| Asynchronous socket connect (`IoOpKind.connect = 4`).
pub const SIM_OP_CONNECT: u8 = 4;

/| Asynchronous deadline timer (`IoOpKind.timer = 5`).
pub const SIM_OP_TIMER: u8 = 5;

/| Asynchronous descriptor close (`IoOpKind.close = 6`).
pub const SIM_OP_CLOSE: u8 = 6;

/| Simulated standard stream (`stdin`/`stdout`/`stderr`) read/write (`IoOpKind.stdio_rw = 7`).
pub const SIM_OP_STDIO_RW: u8 = 7;

/| Simulated file or directory open (`IoOpKind.fs_open = 8`).
pub const SIM_OP_FS_OPEN: u8 = 8;

/| Simulated capability-jailed relative `*_beneath` operation (`IoOpKind.fs_op_beneath = 9`).
pub const SIM_OP_FS_OP_BENEATH: u8 = 9;

/| Simulated file read/write/pread/pwrite/vectored/set_len (`IoOpKind.fs_rw = 10`).
pub const SIM_OP_FS_RW: u8 = 10;

/| Simulated file cursor seek (`IoOpKind.fs_seek = 11`).
pub const SIM_OP_FS_SEEK: u8 = 11;

/| Simulated file/symlink/handle metadata query (`IoOpKind.fs_stat = 12`).
pub const SIM_OP_FS_STAT: u8 = 12;

/| Simulated `DurabilityMode` barrier sync or permissions update (`IoOpKind.fs_sync = 13`).
pub const SIM_OP_FS_SYNC: u8 = 13;

/| Simulated `File` or `Dir` close (`IoOpKind.fs_close = 14`).
pub const SIM_OP_FS_CLOSE: u8 = 14;

/| Simulated read-only `Mmap` map/unmap (`IoOpKind.fs_mmap = 15`).
pub const SIM_OP_FS_MMAP: u8 = 15;

/| Simulated physical `resolve_path` / `resolve_or_create_path` (`IoOpKind.fs_resolve = 16`).
pub const SIM_OP_FS_RESOLVE: u8 = 16;

/| Simulated `UnlinkAndReplace` atomic publish (`IoOpKind.fs_rename_atomic = 17`).
pub const SIM_OP_FS_RENAME_ATOMIC: u8 = 17;

/| Simulated 3-tier CoW `materialize_file` (`IoOpKind.fs_materialize = 18`).
pub const SIM_OP_FS_MATERIALIZE: u8 = 18;

/| Simulated directory creation, removal, or `DirIter` read (`IoOpKind.fs_dir_op = 19`).
pub const SIM_OP_FS_DIR_OP: u8 = 19;

/| Simulated advisory `FileLock` acquire/unlock (`IoOpKind.fs_lock = 20`).
pub const SIM_OP_FS_LOCK: u8 = 20;

/| Simulated `FsWatcher` registration or event poll (`IoOpKind.fs_watch_poll = 21`).
pub const SIM_OP_FS_WATCH_POLL: u8 = 21;

/| Simulated zero-latency virtual clock sleep (`IoOpKind.sleep_ns = 22`).
pub const SIM_OP_SLEEP_NS: u8 = 22;

/| Simulated hermetic `cx.env` variable, `argv`, or standard directory op (`IoOpKind.env_op = 23`).
pub const SIM_OP_ENV_OP: u8 = 23;

/| Simulated `cx.process` child spawn, wait, kill, or exit (`IoOpKind.proc_op = 24`).
pub const SIM_OP_PROC_OP: u8 = 24;

// ------------------------------------- PUBLIC API --------------------------------------
impl[T] Poll[T] {
    /| Returns `true` if `self` is `.Ready(_)`.
    @no_alloc @no_panic
    pub fn is_ready(&self) -> bool {
        match self {
            .Ready(_) => true,
            .Pending => false,
        }
    }

    /| Returns `true` if `self` is `.Pending`.
    @no_alloc @no_panic
    pub fn is_pending(&self) -> bool {
        match self {
            .Ready(_) => false,
            .Pending => true,
        }
    }
}

impl Waker {
    /| Returns a no-op `Waker` suitable for single-threaded synchronous `block_on` polling.
    @inline @no_alloc @no_panic
    pub fn noop() -> Waker {
        Waker {
            data: @default_init[*mut opaque](),
            wake_fn: .None,
        }
    }

    /| Returns `true` when `self` carries no wakeup callback.
    @inline @no_alloc @no_panic
    pub fn is_noop(&self) -> bool {
        match self.wake_fn {
            .Some(_) => false,
            .None => true,
        }
    }

    /| Invokes the underlying wakeup callback if present.
    @std_cap_boundary(clears: [ffi, unsafe_op]) @inline
    pub fn wake(&self) {
        if self.wake_fn is .Some(wake_cb) {
            unsafe {
                wake_cb(self.data);
            }
        }
    }
}

impl CancelToken {
    /| Returns an inert `CancelToken` that never signals cancellation.
    @inline @no_alloc @no_panic
    pub fn none() -> CancelToken {
        CancelToken { flag_ptr: @default_init[*u64]() }
    }

    /| Returns `true` if cooperative cancellation has been requested on the associated `CancelSource`.
    @std_cap_boundary(clears: [unsafe_op]) @inline @no_alloc @no_panic
    pub fn is_canceled(&self) -> bool {
        if self.flag_ptr == @default_init[*u64]() {
            return false;
        }
        unsafe {
            @atomic_load(self.flag_ptr, 2_u8) != 0_u64
        }
    }
}

impl CancelSource {
    /| Constructs a fresh uncanceled `CancelSource`.
    @inline @no_alloc @no_panic
    pub fn new() -> CancelSource {
        CancelSource { flag: 0_u64 }
    }

    /| Borrows a `Copy` `CancelToken` observing `self` (`with context.cancel_token = src.as_token()`).
    @inline @no_alloc @no_panic
    pub fn as_token(&self) -> CancelToken {
        CancelToken { flag_ptr: &raw self.flag }
    }

    /| Signals cooperative cancellation to all holders of tokens derived from `self`.
    @std_cap_boundary(clears: [unsafe_op]) @inline @no_alloc @no_panic
    pub fn cancel(&self) {
        unsafe {
            @atomic_store((&raw self.flag) as *mut u64, 1_u64, 3_u8);
        }
    }

    /| Returns `true` if `cancel()` has been invoked on `self`.
    @std_cap_boundary(clears: [unsafe_op]) @inline @no_alloc @no_panic
    pub fn is_canceled(&self) -> bool {
        unsafe {
            @atomic_load(&raw self.flag, 2_u8) != 0_u64
        }
    }
}

impl TaskHeader {
    /| Constructs a zero-initialized `TaskHeader`.
    @inline @no_alloc @no_panic
    pub fn empty() -> TaskHeader {
        TaskHeader {
            poll_fn: 0,
            drop_fn: 0,
            parent_or_waker: 0,
            state_and_flags: 0_u64,
        }
    }
}

/| Cooperatively yields execution once to the active reactor / task queue before resuming.
@inline @no_alloc @no_panic
pub async fn yield_now() {
    (YieldNow { has_yielded: false }).await;
}

/| Drives `fut` to completion on the current OS thread using `context.reactor` (blocking the caller thread).
pub fn block_on[T](fut: own Future[T]) -> T {
    block_on(own fut)
}

/| Enters a structured concurrency nursery that joins or cancels all spawned child tasks before returning.
pub async fn task_group[R](scope_fn: |&mut TaskGroup[never]| -> R) -> R {
    task_group(scope_fn).await
}
