//! Foundational Scalar Limits and Numeric Helpers (`core::primitives`)
//!
//! Defines canonical minimum and maximum constants for fixed-width signed and unsigned integers
//! alongside branch-clean comparison, clamping, and absolute-difference helpers.
//!
//! Every helper in this module is pure, heap-free (`@no_alloc`), and safe for both runtime and
//! `comptime` evaluation across 32-bit (`wasm32`) and 64-bit native targets.
pub const I8_MIN: i8 = -128;

/// Maximum representable signed 8-bit integer (`127`).
pub const I8_MAX: i8 = 127;

/// Minimum representable signed 16-bit integer (`-32_768`).
pub const I16_MIN: i16 = -32_768;

/// Maximum representable signed 16-bit integer (`32_767`).
pub const I16_MAX: i16 = 32_767;

/// Minimum representable signed 32-bit integer (`-2_147_483_648`).
pub const I32_MIN: i32 = -2_147_483_648;

/// Maximum representable signed 32-bit integer (`2_147_483_647`).
pub const I32_MAX: i32 = 2_147_483_647;

/// Maximum representable unsigned 8-bit integer (`255`).
pub const U8_MAX: u8 = 255;

/// Maximum representable unsigned 16-bit integer (`65_535`).
pub const U16_MAX: u16 = 65_535;

/// Maximum representable unsigned 32-bit integer (`4_294_967_295`).
pub const U32_MAX: u32 = 4_294_967_295;

/// Maximum representable unsigned 64-bit integer (`18_446_744_073_709_551_615`).
pub const U64_MAX: u64 = 18_446_744_073_709_551_615;

// ------------------------------------- PUBLIC API --------------------------------------
/// Returns the smaller of `left_val` and `right_val` (`i32`).
@inline
@no_alloc
@no_panic
pub fn min_i32(left_val: i32, right_val: i32) -> i32 {
    if left_val < right_val {
        return left_val;
    }
    return right_val;
}

/// Returns the larger of `left_val` and `right_val` (`i32`).
@inline
@no_alloc
@no_panic
pub fn max_i32(left_val: i32, right_val: i32) -> i32 {
    if left_val > right_val {
        return left_val;
    }
    return right_val;
}

/// Clamps `input_val` into the inclusive range `[lower_bound, upper_bound]` (`i32`).
@inline
@no_alloc
@no_panic
pub fn clamp_i32(input_val: i32, lower_bound: i32, upper_bound: i32) -> i32 {
    if input_val < lower_bound {
        return lower_bound;
    } else if input_val > upper_bound {
        return upper_bound;
    }
    return input_val;
}

/// Returns the smaller of `left_val` and `right_val` (`i64`).
@inline
@no_alloc
@no_panic
pub fn min_i64(left_val: i64, right_val: i64) -> i64 {
    if left_val < right_val {
        return left_val;
    }
    return right_val;
}

/// Returns the larger of `left_val` and `right_val` (`i64`).
@inline
@no_alloc
@no_panic
pub fn max_i64(left_val: i64, right_val: i64) -> i64 {
    if left_val > right_val {
        return left_val;
    }
    return right_val;
}

/// Clamps `input_val` into the inclusive range `[lower_bound, upper_bound]` (`i64`).
@inline
@no_alloc
@no_panic
pub fn clamp_i64(input_val: i64, lower_bound: i64, upper_bound: i64) -> i64 {
    if input_val < lower_bound {
        return lower_bound;
    } else if input_val > upper_bound {
        return upper_bound;
    }
    return input_val;
}

/// Returns the smaller of `left_val` and `right_val` (`usize`).
@inline
@no_alloc
@no_panic
pub fn min_usize(left_val: usize, right_val: usize) -> usize {
    if left_val < right_val {
        return left_val;
    }
    return right_val;
}

/// Returns the larger of `left_val` and `right_val` (`usize`).
@inline
@no_alloc
@no_panic
pub fn max_usize(left_val: usize, right_val: usize) -> usize {
    if left_val > right_val {
        return left_val;
    }
    return right_val;
}

/// Clamps `input_val` into the inclusive range `[lower_bound, upper_bound]` (`usize`).
@inline
@no_alloc
@no_panic
pub fn clamp_usize(input_val: usize, lower_bound: usize, upper_bound: usize) -> usize {
    if input_val < lower_bound {
        return lower_bound;
    } else if input_val > upper_bound {
        return upper_bound;
    }
    return input_val;
}

/// Computes the exact unsigned distance `|left_val - right_val|` (`u32`) without overflow.
@inline
@no_alloc
@no_panic
pub fn abs_diff_u32(left_val: u32, right_val: u32) -> u32 {
    if left_val >= right_val {
        return left_val -% right_val;
    }
    return right_val -% left_val;
}

/// Computes the exact unsigned distance `|left_val - right_val|` (`u64`) without overflow.
@inline
@no_alloc
@no_panic
pub fn abs_diff_u64(left_val: u64, right_val: u64) -> u64 {
    if left_val >= right_val {
        return left_val -% right_val;
    }
    return right_val -% left_val;
}
