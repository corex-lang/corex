/| Linux `EOPNOTSUPP` / `ENOTSUP` operation not supported (`95`).
pub const EOPNOTSUPP: i32 = 95;

/| Linux `ETIMEDOUT` connection or wait timed out (`110`).
pub const ETIMEDOUT: i32 = 110;

/| Linux `ESTALE` stale file handle (`116`).
pub const ESTALE: i32 = 116;

/| Default `dlsym` lookup handle searching the global dynamic symbol scope (`0`).
pub const RTLD_DEFAULT: *mut opaque = @default_init[*mut opaque]();

