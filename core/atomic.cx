/// Emits a hardware and compiler atomic memory fence (`default: .SeqCst`).
@std_cap_boundary(clears: [unsafe_op])
@inline @no_alloc @no_panic
pub fn fence(*, order: Ordering = .SeqCst) {
    unsafe {
        @atomic_fence(order as u8);
    }
}

test "atomic u32 interior mutability and default ordering" {
    let counter = AtomicU32.new(10);
    if counter.fetch_add(5) != 10 {
        @panic("AtomicU32.fetch_add must return previous value 10");
    }
    if counter.compare_exchange(15, 42) is not .Ok(15) {
        @panic("AtomicU32.compare_exchange must succeed on 15 to 42");
    }
    if counter.load() != 42 {
        @panic("AtomicU32.load must observe updated value 42");
    }
}
