/# Process Arguments, Environment Variables, and Standard Directories (cx.env)
/#
/# Provides cross-platform command-line argument parsing (`args_in`, `args_os`), environment variable
/# queries and `unsafe` mutations (`get_var`, `get_var_in`, `get_var_os`, `vars`, `set_var`, `remove_var`),
/# working directory and executable path lookups, `process_id()`, and zero-`shell32` standard directories.
/#
/# Every OS boundary emits exact `DR-17` capabilities via `@std_cap_boundary` and routes through
/# `context.reactor` (`SIM_OP_ENV_OP`) for hermetic, deterministic `corex test --sim` replay (`STD-02` §2.5, §4).

use core.async.{
    IoSubmission,
    Reactor,
    ReactorCtx,
    SIM_OP_ENV_OP,
    SIM_UNHANDLED_SENTINEL,
};
use core.sys;
use cx.col.Vec;
use cx.fs.FsError;
use cx.mem.Arena;
use cx.path.{
    Path,
    PathBuf,
    STACK_WCHAR_CAP,
    decode_wtf16_in_arena,
    decode_wtf16_to_path_buf,
    decode_wtf16_to_wtf8,
    encode_wtf8_to_wtf16,
    wtf8_len_for_wtf16,
};
use cx.str.{String, is_valid_utf8};

// ---------------------------------------- TYPES ----------------------------------------
/| Owned vector of `(String, String)` environment variable pairs returned by `vars()`.
type EnvPairVec = Vec[(String, String)];

/| Optional owned filesystem path alias unifying `PathBuf?` across `@cfg`-gated OS helpers.
type OptPathBuf = PathBuf?;

/| Raw `(ptr_addr, count)` result of `parse_win32_cmdline_raw` inside an `Arena`.
@derive(Copy)
struct ParsedCmdLineRaw {
    /| Raw address of the allocated `Path` slice (`0` when empty).
    ptr_addr: usize,
    /| Number of parsed `Path` arguments.
    count: usize,
}

/| Failure reason returned by `cx.env` variable lookups and mutations (`STD-02` §2.5).
@derive(Copy, Equatable, Hash, Clone, Debug)
pub enum VarError {
    /| Requested environment variable is not defined in the active environment.
    NotPresent,
    /| Environment variable value contains non-UTF-8 bytes or unpaired UTF-16 surrogates.
    NotUnicode,
    /| Key is empty, contains `'='`, or key/value contains an interior `'\0'` byte.
    InvalidName,
}

// ------------------ SimReactor Env Protocol -------------------
/| Sub-operation selector carried in `IoSubmission.flags` for `SIM_OP_ENV_OP` (`cx` package internal).
@expect(unused-pkg-visibility, reason: "shared with cx.test SimReactor in Phase 11.3")
@derive(Copy, Equatable, Clone, Debug)
pub(pkg) enum SimEnvSubOp: u8 {
    /| Query simulated command-line argument slices (`0`).
    Args = 0,
    /| Query a single simulated environment variable by key (`1`).
    GetVar = 1,
    /| Enumerate all simulated `(key, value)` environment pairs (`2`).
    ListVars = 2,
    /| Set or overwrite a simulated environment variable (`3`).
    SetVar = 3,
    /| Unset a simulated environment variable (`4`).
    RemoveVar = 4,
    /| Query simulated process working directory (`5`).
    CurrentDir = 5,
    /| Change simulated process working directory (`6`).
    SetCurrentDir = 6,
    /| Query simulated executable path (`7`).
    CurrentExe = 7,
    /| Query simulated home directory (`8`).
    HomeDir = 8,
    /| Query simulated cache directory (`9`).
    CacheDir = 9,
    /| Query simulated config directory (`10`).
    ConfigDir = 10,
    /| Query simulated user-local data directory (`11`).
    DataLocalDir = 11,
    /| Query simulated temporary directory (`12`).
    TempDir = 12,
    /| Query simulated virtual process ID (`13`).
    ProcessId = 13,
}

/| Raw C-ABI byte slice view exchanged across `SIM_OP_ENV_OP` submissions (`16 B` on 64-bit, `8 B` on `wasm32`).
@repr(C) @derive(Copy)
pub(pkg) struct SimEnvSlice {
    /| Pointer to raw OS / WTF-8 / UTF-8 bytes (`null` when `len == 0`).
    pub ptr: *u8,
    /| Byte length of `ptr`.
    pub len: usize,
}

/| Raw C-ABI `(key, val)` pair yielded by `SIM_OP_ENV_OP` `ListVars` (`cx` package internal).
@expect(unused-pkg-visibility, reason: "shared with cx.test SimReactor in Phase 11.3")
@repr(C)
@derive(Copy)
pub(pkg) struct SimEnvKvPair {
    /| Environment variable key bytes.
    pub key: SimEnvSlice,
    /| Environment variable value bytes.
    pub val: SimEnvSlice,
}

/| Structured request/response payload pointed to by `IoSubmission.buf_ptr` for `SIM_OP_ENV_OP`.
@expect(unused-pkg-visibility, reason: "shared with cx.test SimReactor in Phase 11.3") @repr(C)
pub(pkg) struct SimEnvPayload {
    /| Input key or target directory path slice (`GetVar`, `SetVar`, `RemoveVar`, `SetCurrentDir`).
    pub in_primary: SimEnvSlice,
    /| Input variable value slice (`SetVar`).
    pub in_secondary: SimEnvSlice,
    /| Output value or directory path slice populated by `SimReactor`.
    pub out_slice: SimEnvSlice,
    /| Output borrowed array of `SimEnvSlice` arguments (`Args`) populated by `SimReactor`.
    pub out_items_ptr: *SimEnvSlice,
    /| Output borrowed array of `SimEnvKvPair` entries (`ListVars`) populated by `SimReactor`.
    pub out_pairs_ptr: *SimEnvKvPair,
    /| Populated element count for `out_items_ptr` or `out_pairs_ptr`.
    pub out_count: usize,
}

/| Typed C-ABI callback overlay matching the first four words of `ReactorVTable`.
@repr(C)
struct EnvReactorSlots {
    /| Unused `monotonic_ns` slot (`word 0`).
    monotonic_ns: usize,
    /| Unused `wall_epoch_ns` slot (`word 1`).
    wall_epoch_ns: usize,
    /| Unused `fill_rng` slot (`word 2`).
    fill_rng: usize,
    /| Optional synchronous/simulated `IoSubmission` dispatch callback (`word 3`).
    submit_io: (extern "C" fn(*mut opaque, *IoSubmission) -> i64)?,
}

/| Dynamic Win11/Server 2022 `GetTempPath2W(BufferLength, Buffer)` function-pointer prototype.
type Win32GetTempPathFn = extern "C" fn(u32, *mut u16) -> u32;

// --------------------------------------- CONSTS ----------------------------------------
/| Inline stack buffer capacity for NUL-terminated C environment keys (`512` bytes).
const STACK_CSTR_CAP: usize = 512;

/| Inline stack buffer capacity for POSIX path syscalls (`getcwd`, `readlinkat`, `1024` bytes).
const STACK_PATH_BYTES_CAP: usize = 1_024;

/| Defensive upper bound when scanning NUL-terminated `argv` or `environ` C strings (`1 MiB`).
const MAX_CSTR_SCAN_BYTES: usize = 1_048_576;

/| Defensive upper bound when scanning Win32 UTF-16 command lines or environment blocks (`1M` `WCHAR`s).
const MAX_WCHAR_SCAN_UNITS: usize = 1_048_576;

/| Maximum dynamic retry capacity for `getcwd`, `readlinkat`, `GetCurrentDirectoryW`, and `GetModuleFileNameW`.
const MAX_PATH_GROW_UNITS: usize = 65_536;

/| Defensive upper bound on total environment entries enumerated by `vars()` (`65,536`).
const MAX_ENV_ENTRIES: usize = 65_536;

/| Stack fast-path pointer capacity for WASI `args_get` / `environ_get` (`32` entries).
const WASI_STACK_PTR_CAP: usize = 32;

/| Stack fast-path byte capacity for WASI `args_get` / `environ_get` (`2 KiB`).
const WASI_STACK_BUF_CAP: usize = 2_048;

/| Linux `/proc/self/exe` symlink path literal (`NUL`-terminated).
const LINUX_PROC_SELF_EXE_Z: &[u8] = b"/proc/self/exe\0";

/| Win32 `ERROR_ENVVAR_NOT_FOUND` (`203`) returned when `GetEnvironmentVariableW` misses.
const WIN32_ERROR_ENVVAR_NOT_FOUND: u32 = 203;

/| Address threshold distinguishing real Win32 DLL exports from `MirVm`'s `0x0003_0001` `GetProcAddress` token.
const WIN32_REAL_PROC_MIN_ADDR: usize = 0x0010_0000;

/| Registry `HKCU` subkey for zero-`shell32` `User Shell Folders` lookup (`NUL`-terminated UTF-16).
const WIN32_USER_SHELL_FOLDERS_SUBKEY_W: [u16; 70] = [
    0x0053, 0x006F, 0x0066, 0x0074, 0x0077, 0x0061, 0x0072, 0x0065,
    0x005C, 0x004D, 0x0069, 0x0063, 0x0072, 0x006F, 0x0073, 0x006F,
    0x0066, 0x0074, 0x005C, 0x0057, 0x0069, 0x006E, 0x0064, 0x006F,
    0x0077, 0x0073, 0x005C, 0x0043, 0x0075, 0x0072, 0x0072, 0x0065,
    0x006E, 0x0074, 0x0056, 0x0065, 0x0072, 0x0073, 0x0069, 0x006F,
    0x006E, 0x005C, 0x0045, 0x0078, 0x0070, 0x006C, 0x006F, 0x0072,
    0x0065, 0x0072, 0x005C, 0x0055, 0x0073, 0x0065, 0x0072, 0x0020,
    0x0053, 0x0068, 0x0065, 0x006C, 0x006C, 0x0020, 0x0046, 0x006F,
    0x006C, 0x0064, 0x0065, 0x0072, 0x0073, 0x0000,
];

/| Registry value name `"Local AppData"` under `User Shell Folders` (`NUL`-terminated UTF-16).
const WIN32_REG_VAL_LOCAL_APPDATA_W: [u16; 14] = [
    0x004C, 0x006F, 0x0063, 0x0061, 0x006C, 0x0020, 0x0041, 0x0070,
    0x0070, 0x0044, 0x0061, 0x0074, 0x0061, 0x0000,
];

/| Registry value name `"AppData"` under `User Shell Folders` (`NUL`-terminated UTF-16).
const WIN32_REG_VAL_APPDATA_W: [u16; 8] = [
    0x0041,
    0x0070,
    0x0070,
    0x0044,
    0x0061,
    0x0074,
    0x0061,
    0x0000,
];

/| Module name `"kernel32.dll"` passed to `GetModuleHandleW` (`NUL`-terminated UTF-16).
const WIN32_KERNEL32_DLL_W: [u16; 13] = [
    0x006B, 0x0065, 0x0072, 0x006E, 0x0065, 0x006C, 0x0033, 0x0032,
    0x002E, 0x0064, 0x006C, 0x006C, 0x0000,
];

/| Export symbol name `"GetTempPath2W"` passed to `GetProcAddress` (`NUL`-terminated ASCII).
const WIN32_GET_TEMP_PATH2_Z: &[u8] = b"GetTempPath2W\0";

// -------------------------------------- INTERNALS --------------------------------------
// -------------------- OS FFI Declarations ---------------------
/| Process global `char **environ` vector exported by Linux `glibc` and `musl` (referenced only on Linux).
@link(name: "environ")
extern "C" static mut linux_environ: *mut *mut u8;

// ------------------ Reactor & Slice Helpers -------------------
/| Bounds-checked byte read returning `slice[idx]` when `idx < slice.len()`, or `0` otherwise.
@std_cap_boundary(clears: [unsafe_op])
fn byte_at(slice: &[u8], idx: usize, /) -> u8 {
    if idx < slice.len() {
        return unsafe {
            slice.as_ptr().add(idx).read()
        };
    }
    0_u8
}

/| Bounds-checked `u16` read returning `slice[idx]` when `idx < slice.len()`, or `0` otherwise.
@std_cap_boundary(clears: [unsafe_op])
fn u16_at(slice: &[u16], idx: usize, /) -> u16 {
    if idx < slice.len() {
        return unsafe {
            slice.as_ptr().add(idx).read()
        };
    }
    0_u16
}

/| Bounds-checked `u16` write into `slice[idx]` when `idx < slice.len()`.
@std_cap_boundary(clears: [unsafe_op])
fn write_u16_at(slice: &mut [u16], idx: usize, unit_val: u16, /) {
    if idx < slice.len() {
        unsafe {
            slice.as_mut_ptr().add(idx).write(unit_val);
        }
    }
}

/| Bounds-checked sub-slice projection returning `slice[start..end_idx]` when valid, or `&[]`.
@std_cap_boundary(clears: [unsafe_op])
fn subslice_u8(slice: &[u8], start: usize, end_idx: usize, /) -> &[u8] {
    let total: usize = slice.len();
    if start <= end_idx and end_idx <= total {
        return unsafe {
            @slice_from_raw_parts(slice.as_ptr().add(start), end_idx -% start)
        };
    }
    empty_u8_slice()
}

/| Bounds-checked `u16` sub-slice projection returning `slice[start..end_idx]` when valid, or `&[]`.
@std_cap_boundary(clears: [unsafe_op])
fn subslice_u16(slice: &[u16], start: usize, end_idx: usize, /) -> &[u16] {
    let total: usize = slice.len();
    if start <= end_idx and end_idx <= total {
        return unsafe {
            @slice_from_raw_parts(slice.as_ptr().add(start), end_idx -% start)
        };
    }
    unsafe {
        @slice_from_raw_parts(@align_of[u16]() as *u16, 0_usize)
    }
}

/| Returns an empty `&[u8]` slice with static non-null aligned provenance.
@std_cap_boundary(clears: [unsafe_op])
fn empty_u8_slice() -> &[u8] {
    unsafe {
        @slice_from_raw_parts(1_usize as *u8, 0_usize)
    }
}

/| Returns an empty `&[str]` slice with static non-null aligned provenance.
@std_cap_boundary(clears: [unsafe_op])
fn empty_str_slice() -> &[str] {
    unsafe {
        @slice_from_raw_parts(@align_of[str]() as *str, 0_usize)
    }
}

/| Returns an empty `&[Path]` slice with static non-null aligned provenance.
@std_cap_boundary(clears: [unsafe_op])
fn empty_path_slice() -> &[Path] {
    unsafe {
        @slice_from_raw_parts(@align_of[Path]() as *Path, 0_usize)
    }
}

/| Wraps `bytes` in a C-ABI `SimEnvSlice`.
fn make_sim_slice(bytes: &[u8], /) -> SimEnvSlice {
    if bytes.is_empty() {
        return SimEnvSlice {
            ptr: @default_init[*u8](),
            len: 0_usize,
        };
    }
    SimEnvSlice {
        ptr: bytes.as_ptr(),
        len: bytes.len(),
    }
}

/| Constructs a zero-initialized `SimEnvPayload` carrying `primary` and `secondary` inputs.
fn make_sim_payload(primary: &[u8], secondary: &[u8], /) -> SimEnvPayload {
    let empty_raw = SimEnvSlice {
        ptr: @default_init[*u8](),
        len: 0_usize,
    };
    SimEnvPayload {
        in_primary: make_sim_slice(primary),
        in_secondary: make_sim_slice(secondary),
        out_slice: empty_raw,
        out_items_ptr: @default_init[*SimEnvSlice](),
        out_pairs_ptr: @default_init[*SimEnvKvPair](),
        out_count: 0_usize,
    }
}

/| Materializes a borrowed `&[u8]` view from `sim_slice`.
@std_cap_boundary(clears: [unsafe_op])
fn sim_slice_as_bytes(sim_slice: SimEnvSlice, /) -> &[u8] {
    if sim_slice.len == 0_usize or sim_slice.ptr.is_null() {
        return empty_u8_slice();
    }
    unsafe {
        @slice_from_raw_parts(sim_slice.ptr, sim_slice.len)
    }
}

/| Reconstructs a `str` slice from a validated UTF-8 `SimEnvSlice` (`""` when empty).
@std_cap_boundary(clears: [unsafe_op])
fn str_from_sim_slice(raw_slice: SimEnvSlice, /) -> str {
    if raw_slice.len == 0_usize or raw_slice.ptr.is_null() {
        return "";
    }
    unsafe {
        @str_from_utf8_unchecked(@slice_from_raw_parts(raw_slice.ptr, raw_slice.len))
    }
}

/| Copies or lossily decodes `raw_bytes` into `arena`, returning raw `(ptr, len)` without holding an `arena` borrow.
@std_cap_boundary(clears: [unsafe_op])
fn copy_lossy_utf8_in_arena_raw(arena: &mut Arena, raw_bytes: &[u8], /) -> SimEnvSlice {
    if raw_bytes.is_empty() {
        return SimEnvSlice {
            ptr: @default_init[*u8](),
            len: 0_usize,
        };
    }
    let copied_str: str = if is_valid_utf8(raw_bytes) {
        arena.dupe_str(
            unsafe {
                @str_from_utf8_unchecked(raw_bytes)
            },
        )
    } else {
        Path.from_bytes(raw_bytes).to_str_lossy_in(arena)
    };
    make_sim_slice(copied_str.as_bytes())
}

/| Projects valid UTF-8 `stable_bytes` in-place or lossily decodes into `arena`, returning raw `(ptr, len)`.
fn project_lossy_utf8_in_arena_raw(arena: &mut Arena, stable_bytes: &[u8], /) -> SimEnvSlice {
    if stable_bytes.is_empty() or is_valid_utf8(stable_bytes) {
        return make_sim_slice(stable_bytes);
    }
    let lossy_str: str = Path.from_bytes(stable_bytes).to_str_lossy_in(arena);
    make_sim_slice(lossy_str.as_bytes())
}

/| Submits `SIM_OP_ENV_OP` (`sub_op`) to `context.reactor` when attached (`SIM_UNHANDLED_SENTINEL` if unhandled).
@std_cap_boundary(clears: [ffi, unsafe_op, indirect_opaque, alloc, may_panic, blocking_sync])
fn submit_reactor_env_op(sub_op: SimEnvSubOp, payload: &mut SimEnvPayload, /) -> i64 {
    let reactor_handle: Reactor = context.reactor;
    let slots_ptr = reactor_handle.vtable as *EnvReactorSlots;
    if slots_ptr == (0 as *EnvReactorSlots) {
        return SIM_UNHANDLED_SENTINEL;
    }
    let submit_opt = unsafe {
        slots_ptr.*.submit_io
    };
    let submit_cb = submit_opt orelse return SIM_UNHANDLED_SENTINEL;
    let sub = IoSubmission {
        kind: SIM_OP_ENV_OP,
        flags: sub_op as u8,
        worker_id: 0_u16,
        fd_or_handle: -1,
        offset_or_ns: 0_u64,
        buf_ptr: (&raw mut payload.*) as *mut u8,
        buf_len: @size_of[SimEnvPayload]() as u32,
        slot_index: 0_u32,
    };
    let reactor_ctx: ReactorCtx = context.reactor_ctx;
    unsafe {
        submit_cb(reactor_ctx.state, &raw sub)
    }
}

/| Scans NUL-terminated C string `cstr_ptr` up to `MAX_CSTR_SCAN_BYTES` and returns its byte slice.
@std_cap_boundary(clears: [unsafe_op])
fn cstr_ptr_to_bytes(cstr_ptr: *u8, /) -> &[u8] {
    if cstr_ptr.is_null() {
        return empty_u8_slice();
    }
    var n: usize = 0;
    while n < MAX_CSTR_SCAN_BYTES {
        let cur_b: u8 = unsafe {
            cstr_ptr.add(n).read()
        };
        if cur_b == 0_u8 {
            break;
        }
        n = n +% 1_usize;
    }
    if n == 0_usize {
        return empty_u8_slice();
    }
    unsafe {
        @slice_from_raw_parts(cstr_ptr, n)
    }
}

/| Scans NUL-terminated UTF-16 `wptr` up to `MAX_WCHAR_SCAN_UNITS` and returns its `&[u16]` slice.
@std_cap_boundary(clears: [unsafe_op])
fn wstr_ptr_to_u16_slice(wptr: *u16, /) -> &[u16] {
    if wptr.is_null() {
        return unsafe {
            @slice_from_raw_parts(@align_of[u16]() as *u16, 0_usize)
        };
    }
    var n: usize = 0;
    while n < MAX_WCHAR_SCAN_UNITS {
        let unit_val: u16 = unsafe {
            wptr.add(n).read()
        };
        if unit_val == 0_u16 {
            break;
        }
        n = n +% 1_usize;
    }
    unsafe {
        @slice_from_raw_parts(wptr, n)
    }
}

/| Converts raw OS / WTF-8 `bytes` into an owned UTF-8 `String` (replacing non-UTF-8 sequences with `U+FFFD`).
@std_cap_boundary(clears: [unsafe_op])
fn os_bytes_to_string_lossy(bytes: &[u8], /) -> String {
    if bytes.is_empty() {
        return String.new();
    }
    if is_valid_utf8(bytes) {
        return String.from_str(
            unsafe {
                @str_from_utf8_unchecked(bytes)
            },
        );
    }
    String.fmt(f"{Path.from_bytes(bytes)}")
}

/| Decodes UTF-16/WTF-16 `units` into an owned UTF-8 `String` (replacing unpaired surrogates with `U+FFFD`).
fn wtf16_to_string_lossy(units: &[u16], /) -> String {
    if units.is_empty() {
        return String.new();
    }
    var stack_wtf8: [u8; STACK_PATH_BYTES_CAP] = [0_u8; STACK_PATH_BYTES_CAP];
    let needed: usize = wtf8_len_for_wtf16(units);
    if needed <= STACK_PATH_BYTES_CAP {
        let written: usize = decode_wtf16_to_wtf8(units, &mut stack_wtf8);
        return os_bytes_to_string_lossy(subslice_u8(&stack_wtf8, 0_usize, written));
    }
    let path_buf: PathBuf = decode_wtf16_to_path_buf(units);
    os_bytes_to_string_lossy(path_buf.as_os_bytes())
}

/| Validates `key` for environment lookups and mutations (`not key.is_empty()`, no `'='`, and no `'\0'`).
fn is_valid_env_key(key: str, /) -> bool {
    let raw: &[u8] = key.as_bytes();
    if raw.is_empty() {
        return false;
    }
    for byte_val in raw {
        if byte_val == 0_u8 or byte_val == b'=' {
            return false;
        }
    }
    true
}

/| Returns `true` if `bytes` contains any interior `0x00` NUL byte.
fn has_nul_byte(bytes: &[u8], /) -> bool {
    for byte_val in bytes {
        if byte_val == 0_u8 {
            return true;
        }
    }
    false
}

/| Finds the first index of `needle` inside `bytes`, or returns `.None`.
fn find_first_byte(bytes: &[u8], needle: u8, /) -> usize? {
    for byte_val, i in bytes {
        if byte_val == needle {
            return .Some(i);
        }
    }
    .None
}

// ----------------- Win32 Command-Line Parser ------------------
/| Returns `true` if UTF-16 `unit_val` is an MSVCRT command-line whitespace delimiter (`' '` or `'\t'`).
fn is_win32_cmd_space(unit_val: u16, /) -> bool {
    unit_val == 0x0020_u16 or unit_val == 0x0009_u16
}

/| Computes the NUL-clamped length of `cmd_wtf16` (stopping at the first `0x0000` code unit if present).
fn effective_wtf16_cmd_len(cmd_wtf16: &[u16], /) -> usize {
    let total: usize = cmd_wtf16.len();
    var i: usize = 0;
    while i < total {
        if u16_at(cmd_wtf16, i) == 0_u16 {
            return i;
        }
        i = i +% 1_usize;
    }
    total
}

/| Advances `io_pos` across one MSVCRT/UCRT command-line token, writing into `out_u16` when `should_emit` is `true`.
fn step_win32_cmdline_token(
    cmd_wtf16: &[u16],
    eff_len: usize,
    io_pos: &mut usize,
    is_first_arg: bool,
    out_u16: &mut [u16],
    should_emit: bool,
    /,
) -> usize? {
    var pos: usize = io_pos.*;
    while pos < eff_len and is_win32_cmd_space(u16_at(cmd_wtf16, pos)) {
        pos = pos +% 1_usize;
    }
    if pos >= eff_len {
        io_pos.* = pos;
        return .None;
    }

    // [1] `argv[0]` rule: `"` toggles quote mode and backslashes are always literal:
    var out_len: usize = 0;
    if is_first_arg {
        var is_in_quotes = false;
        while pos < eff_len {
            let cur_u16: u16 = u16_at(cmd_wtf16, pos);
            if not is_in_quotes and is_win32_cmd_space(cur_u16) {
                break;
            }
            if cur_u16 == 0x0022_u16 {
                is_in_quotes = not is_in_quotes;
            } else {
                if should_emit {
                    write_u16_at(out_u16, out_len, cur_u16);
                }
                out_len = out_len +% 1_usize;
            }
            pos = pos +% 1_usize;
        }
        io_pos.* = pos;
        return .Some(out_len);
    }

    // [2] `argv[1..]` MSVCRT rule: `2n` vs `2n + 1` backslashes before `"` + doubled `""` in quotes:
    var is_in_quotes = false;
    while true {
        var should_copy_char = true;
        var slash_count: usize = 0;
        while pos < eff_len and u16_at(cmd_wtf16, pos) == 0x005C_u16 {
            pos = pos +% 1_usize;
            slash_count = slash_count +% 1_usize;
        }

        if pos < eff_len and u16_at(cmd_wtf16, pos) == 0x0022_u16 {
            if (slash_count & 1_usize) == 0_usize {
                if is_in_quotes
                    and pos +% 1_usize < eff_len
                    and u16_at(
                        cmd_wtf16,
                        pos +% 1_usize,
                    )
                        == 0x0022_u16 {
                    pos = pos +% 1_usize;
                } else {
                    should_copy_char = false;
                    is_in_quotes = not is_in_quotes;
                }
            }
            slash_count >>= 1_usize;
        }

        var k: usize = 0;
        while k < slash_count {
            if should_emit {
                write_u16_at(out_u16, out_len, 0x005C_u16);
            }
            out_len = out_len +% 1_usize;
            k = k +% 1_usize;
        }

        if pos >= eff_len or (not is_in_quotes and is_win32_cmd_space(u16_at(cmd_wtf16, pos))) {
            break;
        }

        if should_copy_char {
            if should_emit {
                write_u16_at(out_u16, out_len, u16_at(cmd_wtf16, pos));
            }
            out_len = out_len +% 1_usize;
        }
        pos = pos +% 1_usize;
    }

    io_pos.* = pos;
    .Some(out_len)
}

/| Tokenizes Win32 UTF-16 `cmd_wtf16` into `arena`, returning `(ptr_addr, count)` without holding an `arena` borrow.
@std_cap_boundary(clears: [unsafe_op])
fn parse_win32_cmdline_raw(arena: &mut Arena, cmd_wtf16: &[u16], /) -> ParsedCmdLineRaw {
    let eff_len: usize = effective_wtf16_cmd_len(cmd_wtf16);
    if eff_len == 0_usize {
        return ParsedCmdLineRaw { ptr_addr: 0_usize, count: 0_usize };
    }

    // [1] First pass: count arguments and maximum UTF-16 token length in zero allocations:
    var empty_scratch: [u16; 0] = [];
    var scan_pos: usize = 0;
    var arg_count: usize = 0;
    var max_tok_u16: usize = 0;
    while step_win32_cmdline_token(
        cmd_wtf16,
        eff_len,
        &mut scan_pos,
        arg_count == 0_usize,
        &mut empty_scratch,
        false,
    ) is .Some(tok_len) {
        if tok_len > max_tok_u16 {
            max_tok_u16 = tok_len;
        }
        arg_count = arg_count +% 1_usize;
    }
    if arg_count == 0_usize {
        return ParsedCmdLineRaw { ptr_addr: 0_usize, count: 0_usize };
    }

    // [2] Second pass: decode each argument into `arena` (`[u16; 512]` stack scratch fast path):
    let out_ptr: *mut Path = arena.alloc_slice[Path](arg_count, zeroed: false).as_mut_ptr();
    if max_tok_u16 <= STACK_WCHAR_CAP {
        var stack_tok: [u16; STACK_WCHAR_CAP] = [0_u16; STACK_WCHAR_CAP];
        var emit_pos: usize = 0;
        var idx: usize = 0;
        while idx < arg_count {
            let decoded_path: Path = if step_win32_cmdline_token(
                cmd_wtf16,
                eff_len,
                &mut emit_pos,
                idx == 0_usize,
                &mut stack_tok,
                true,
            ) is .Some(written_len) {
                decode_wtf16_in_arena(&mut arena.*, subslice_u16(&stack_tok, 0_usize, written_len))
            } else {
                Path.from_bytes(empty_u8_slice())
            };
            unsafe {
                out_ptr.add(idx).write(decoded_path);
            }
            idx = idx +% 1_usize;
        }
        return ParsedCmdLineRaw { ptr_addr: out_ptr as usize, count: arg_count };
    }

    let tok_raw: *mut u16 = arena.alloc_slice[u16](max_tok_u16, zeroed: false).as_mut_ptr();
    var emit_pos: usize = 0;
    var idx: usize = 0;
    while idx < arg_count {
        let tok_mut: &mut [u16] = unsafe {
            @slice_from_raw_parts_mut(tok_raw, max_tok_u16)
        };
        let decoded_path: Path = if step_win32_cmdline_token(
            cmd_wtf16,
            eff_len,
            &mut emit_pos,
            idx == 0_usize,
            tok_mut,
            true,
        ) is .Some(written_len) {
            let tok_view: &[u16] = unsafe {
                @slice_from_raw_parts(tok_raw as *u16, written_len)
            };
            decode_wtf16_in_arena(&mut arena.*, tok_view)
        } else {
            Path.from_bytes(empty_u8_slice())
        };
        unsafe {
            out_ptr.add(idx).write(decoded_path);
        }
        idx = idx +% 1_usize;
    }
    ParsedCmdLineRaw { ptr_addr: out_ptr as usize, count: arg_count }
}

// ------------------- Host Process Arguments -------------------
/| Reads `_cx_rt_get_argc()` / `_cx_rt_get_argv()` on Linux and macOS into `arena` without touching global heap.
@cfg(target.os == "linux" or target.os == "macos")
@std_cap_boundary(clears: [ffi, unsafe_op, alloc, blocking_sync])
fn host_args_in(arena: &mut Arena, /) -> &[str] {
    let raw_argc: i32 = unsafe {
        sys.rt_get_argc()
    };
    let raw_argv: *mut *mut u8 = unsafe {
        sys.rt_get_argv()
    };
    if raw_argc <= 0 or raw_argv.is_null() {
        return empty_str_slice();
    }
    let count = raw_argc as usize;
    let out_ptr: *mut str = arena.alloc_slice[str](count, zeroed: false).as_mut_ptr();
    var i: usize = 0;
    while i < count {
        let arg_ptr: *mut u8 = unsafe {
            raw_argv.add(i).read()
        };
        let raw_slice: SimEnvSlice = project_lossy_utf8_in_arena_raw(
            &mut arena.*,
            cstr_ptr_to_bytes(arg_ptr as *u8),
        );
        unsafe {
            out_ptr.add(i).write(str_from_sim_slice(raw_slice));
        }
        i = i +% 1_usize;
    }
    unsafe {
        @slice_from_raw_parts(out_ptr as *str, count)
    }
}

/| Parses `GetCommandLineW()` on Windows via pure-`.cx` MSVCRT rules into `arena` (`0` `shell32.dll` imports).
@cfg(target.os == "windows") @std_cap_boundary(clears: [ffi, unsafe_op, alloc, blocking_sync])
fn host_args_in(arena: &mut Arena, /) -> &[str] {
    let cmd_ptr: *u16 = unsafe {
        sys.windows.win32_get_command_line_w()
    };
    let cmd_slice: &[u16] = wstr_ptr_to_u16_slice(cmd_ptr);
    let raw_parsed: ParsedCmdLineRaw = parse_win32_cmdline_raw(&mut arena.*, cmd_slice);
    let count: usize = raw_parsed.count;
    if count == 0_usize or raw_parsed.ptr_addr == 0_usize {
        return empty_str_slice();
    }
    let paths_ptr = raw_parsed.ptr_addr as *Path;
    let out_ptr: *mut str = arena.alloc_slice[str](count, zeroed: false).as_mut_ptr();
    var i: usize = 0;
    while i < count {
        let arg_path: Path = unsafe {
            paths_ptr.add(i).read()
        };
        let raw_slice: SimEnvSlice = project_lossy_utf8_in_arena_raw(
            &mut arena.*,
            arg_path.as_os_bytes(),
        );
        unsafe {
            out_ptr.add(i).write(str_from_sim_slice(raw_slice));
        }
        i = i +% 1_usize;
    }
    unsafe {
        @slice_from_raw_parts(out_ptr as *str, count)
    }
}

/| Queries WASI `args_sizes_get` + `args_get` directly into `arena` without touching global heap.
@cfg(target.os == "wasi") @std_cap_boundary(clears: [ffi, unsafe_op, alloc, blocking_sync])
fn host_args_in(arena: &mut Arena, /) -> &[str] {
    var argc: usize = 0;
    var buf_size: usize = 0;
    let sz_rc: u16 = unsafe {
        sys.wasi.wasi_args_sizes_get(&raw mut argc, &raw mut buf_size)
    };
    if sz_rc != sys.wasi.WASI_ERRNO_SUCCESS or argc == 0_usize {
        return empty_str_slice();
    }
    let ptrs_raw: *mut *mut u8 = arena.alloc_slice[*mut u8](argc, zeroed: true).as_mut_ptr();
    let safe_buf_len: usize = if buf_size > 0_usize => buf_size else 1_usize;
    let text_raw: *mut u8 = arena.alloc_slice[u8](safe_buf_len, zeroed: true).as_mut_ptr();
    let get_rc: u16 = unsafe {
        sys.wasi.wasi_args_get(ptrs_raw, text_raw)
    };
    if get_rc != sys.wasi.WASI_ERRNO_SUCCESS {
        return empty_str_slice();
    }
    let out_ptr: *mut str = arena.alloc_slice[str](argc, zeroed: false).as_mut_ptr();
    var i: usize = 0;
    while i < argc {
        let arg_ptr: *mut u8 = unsafe {
            ptrs_raw.add(i).read()
        };
        let raw_slice: SimEnvSlice = project_lossy_utf8_in_arena_raw(
            &mut arena.*,
            cstr_ptr_to_bytes(arg_ptr as *u8),
        );
        unsafe {
            out_ptr.add(i).write(str_from_sim_slice(raw_slice));
        }
        i = i +% 1_usize;
    }
    unsafe {
        @slice_from_raw_parts(out_ptr as *str, argc)
    }
}

/| Returns `&[]` on freestanding targets lacking host command-line arguments.
@cfg(target.os == "freestanding")
fn host_args_in(arena: &mut Arena, /) -> &[str] {
    _ = arena;
    empty_str_slice()
}

/| Reads `_cx_rt_get_argc()` / `_cx_rt_get_argv()` on Linux and macOS into lossless `Vec[PathBuf]`.
@cfg(target.os == "linux" or target.os == "macos")
@std_cap_boundary(clears: [ffi, unsafe_op, blocking_sync])
fn host_args_os() -> Vec[PathBuf] {
    let raw_argc: i32 = unsafe {
        sys.rt_get_argc()
    };
    let raw_argv: *mut *mut u8 = unsafe {
        sys.rt_get_argv()
    };
    if raw_argc <= 0 or raw_argv.is_null() {
        return Vec[PathBuf].new();
    }
    let count = raw_argc as usize;
    var out = Vec[PathBuf].with_capacity(count);
    var i: usize = 0;
    while i < count {
        let arg_ptr: *mut u8 = unsafe {
            raw_argv.add(i).read()
        };
        out.push(PathBuf.from(cstr_ptr_to_bytes(arg_ptr as *u8)));
        i = i +% 1_usize;
    }
    out
}

/| Tokenizes `GetCommandLineW()` on Windows directly into lossless WTF-8 `Vec[PathBuf]`.
@cfg(target.os == "windows") @std_cap_boundary(clears: [ffi, unsafe_op, blocking_sync])
fn host_args_os() -> Vec[PathBuf] {
    let cmd_ptr: *u16 = unsafe {
        sys.windows.win32_get_command_line_w()
    };
    let cmd_wtf16: &[u16] = wstr_ptr_to_u16_slice(cmd_ptr);
    let eff_len: usize = effective_wtf16_cmd_len(cmd_wtf16);
    if eff_len == 0_usize {
        return Vec[PathBuf].new();
    }

    // [1] Count arguments and maximum UTF-16 token length in zero allocations:
    var empty_scratch: [u16; 0] = [];
    var scan_pos: usize = 0;
    var arg_count: usize = 0;
    var max_tok_u16: usize = 0;
    while step_win32_cmdline_token(
        cmd_wtf16,
        eff_len,
        &mut scan_pos,
        arg_count == 0_usize,
        &mut empty_scratch,
        false,
    ) is .Some(tok_len) {
        if tok_len > max_tok_u16 {
            max_tok_u16 = tok_len;
        }
        arg_count = arg_count +% 1_usize;
    }
    if arg_count == 0_usize {
        return Vec[PathBuf].new();
    }

    // [2] Decode each argument into `Vec[PathBuf]` using stack `[u16; 512]` fast path:
    var out = Vec[PathBuf].with_capacity(arg_count);
    if max_tok_u16 <= STACK_WCHAR_CAP {
        var stack_tok: [u16; STACK_WCHAR_CAP] = [0_u16; STACK_WCHAR_CAP];
        var emit_pos: usize = 0;
        var idx: usize = 0;
        while idx < arg_count {
            if step_win32_cmdline_token(
                cmd_wtf16,
                eff_len,
                &mut emit_pos,
                idx == 0_usize,
                &mut stack_tok,
                true,
            ) is .Some(written_len) {
                out.push(decode_wtf16_to_path_buf(subslice_u16(&stack_tok, 0_usize, written_len)));
            }
            idx = idx +% 1_usize;
        }
        return out;
    }

    var heap_tok = Vec[u16].with_capacity(max_tok_u16);
    var fill_i: usize = 0;
    while fill_i < max_tok_u16 {
        heap_tok.push(0_u16);
        fill_i = fill_i +% 1_usize;
    }
    var emit_pos: usize = 0;
    var idx: usize = 0;
    while idx < arg_count {
        if step_win32_cmdline_token(
            cmd_wtf16,
            eff_len,
            &mut emit_pos,
            idx == 0_usize,
            heap_tok.as_mut_slice(),
            true,
        ) is .Some(written_len) {
            out.push(
                decode_wtf16_to_path_buf(subslice_u16(heap_tok.as_slice(), 0_usize, written_len)),
            );
        }
        idx = idx +% 1_usize;
    }
    out
}

/| Queries WASI `args_sizes_get` + `args_get` into `Vec[PathBuf]` with stack fast-path.
@cfg(target.os == "wasi") @std_cap_boundary(clears: [ffi, unsafe_op, blocking_sync])
fn host_args_os() -> Vec[PathBuf] {
    var argc: usize = 0;
    var buf_size: usize = 0;
    let sz_rc: u16 = unsafe {
        sys.wasi.wasi_args_sizes_get(&raw mut argc, &raw mut buf_size)
    };
    if sz_rc != sys.wasi.WASI_ERRNO_SUCCESS or argc == 0_usize {
        return Vec[PathBuf].new();
    }
    var out = Vec[PathBuf].with_capacity(argc);
    if argc <= WASI_STACK_PTR_CAP and buf_size <= WASI_STACK_BUF_CAP {
        var stack_ptrs: [*mut u8; WASI_STACK_PTR_CAP] = [@default_init[*mut u8](); WASI_STACK_PTR_CAP];
        var stack_buf: [u8; WASI_STACK_BUF_CAP] = [0_u8; WASI_STACK_BUF_CAP];
        let get_rc: u16 = unsafe {
            sys.wasi.wasi_args_get(&raw mut stack_ptrs[0], &raw mut stack_buf[0])
        };
        if get_rc != sys.wasi.WASI_ERRNO_SUCCESS {
            return out;
        }
        var i: usize = 0;
        while i < argc {
            let arg_ptr: *mut u8 = if i < WASI_STACK_PTR_CAP => stack_ptrs[i]
                else @default_init[*mut u8]();
            out.push(PathBuf.from(cstr_ptr_to_bytes(arg_ptr as *u8)));
            i = i +% 1_usize;
        }
        return out;
    }

    var heap_ptrs = Vec[*mut u8].with_capacity(argc);
    var p_i: usize = 0;
    while p_i < argc {
        heap_ptrs.push(@default_init[*mut u8]());
        p_i = p_i +% 1_usize;
    }
    let safe_buf_len: usize = if buf_size > 0_usize => buf_size else 1_usize;
    var heap_buf = Vec[u8].with_capacity(safe_buf_len);
    var b_i: usize = 0;
    while b_i < safe_buf_len {
        heap_buf.push(0_u8);
        b_i = b_i +% 1_usize;
    }
    let get_rc: u16 = unsafe {
        sys.wasi.wasi_args_get(
            heap_ptrs.as_mut_slice().as_mut_ptr(),
            heap_buf.as_mut_slice().as_mut_ptr(),
        )
    };
    if get_rc != sys.wasi.WASI_ERRNO_SUCCESS {
        return out;
    }
    let ptrs_view: &[*mut u8] = heap_ptrs.as_slice();
    var i: usize = 0;
    while i < argc {
        let arg_ptr: *mut u8 = if i < ptrs_view.len() => ptrs_view[i] else @default_init[*mut u8]();
        out.push(PathBuf.from(cstr_ptr_to_bytes(arg_ptr as *u8)));
        i = i +% 1_usize;
    }
    out
}

/| Returns empty `Vec[PathBuf]` on freestanding targets.
@cfg(target.os == "freestanding")
fn host_args_os() -> Vec[PathBuf] = Vec[PathBuf].new();

// ------------------ Host Environment Access -------------------
/| Invokes `linux_getenv` or `darwin_getenv` on `key_cstr` (`0` address if absent).
@std_cap_boundary(clears: [ffi, unsafe_op, alloc, blocking_sync])
fn invoke_posix_getenv(key_cstr: *u8, is_darwin: bool, /) -> usize {
    let val_ptr: *mut u8 = if is_darwin {
        unsafe {
            sys.macos.darwin_getenv(key_cstr)
        }
    } else {
        unsafe {
            sys.linux.linux_getenv(key_cstr)
        }
    };
    val_ptr as usize
}

/| Looks up validated POSIX `key_bytes` via `getenv` using `[u8; 512]` stack or scratch `arena` (`0` if absent).
@std_cap_boundary(clears: [unsafe_op])
fn posix_getenv_addr_in(arena: &mut Arena, key_bytes: &[u8], is_darwin: bool, /) -> usize {
    if key_bytes.len() < STACK_CSTR_CAP {
        var stack_key: [u8; STACK_CSTR_CAP] = [0_u8; STACK_CSTR_CAP];
        unsafe {
            @memcpy(
                &raw mut stack_key[0] as *mut opaque,
                key_bytes.as_ptr() as *opaque,
                key_bytes.len(),
            );
        }
        return invoke_posix_getenv(&raw stack_key[0], is_darwin);
    }
    let cp = arena.checkpoint();
    let key_raw: *mut u8 = arena
        .alloc_slice[u8](key_bytes.len() +% 1_usize, zeroed: true)
        .as_mut_ptr();
    unsafe {
        @memcpy(key_raw as *mut opaque, key_bytes.as_ptr() as *opaque, key_bytes.len());
    }
    let val_addr: usize = invoke_posix_getenv(key_raw as *u8, is_darwin);
    arena.restore(cp);
    val_addr
}

/| Looks up validated POSIX `key_bytes` via `getenv` using `[u8; 512]` stack or `Vec[u8]` (`0` if absent).
@std_cap_boundary(clears: [unsafe_op])
fn posix_getenv_addr_heap(key_bytes: &[u8], is_darwin: bool, /) -> usize {
    if key_bytes.len() < STACK_CSTR_CAP {
        var stack_key: [u8; STACK_CSTR_CAP] = [0_u8; STACK_CSTR_CAP];
        unsafe {
            @memcpy(
                &raw mut stack_key[0] as *mut opaque,
                key_bytes.as_ptr() as *opaque,
                key_bytes.len(),
            );
        }
        return invoke_posix_getenv(&raw stack_key[0], is_darwin);
    }
    var heap_key = Vec[u8].with_capacity(key_bytes.len() +% 1_usize);
    heap_key.extend_from_slice(key_bytes);
    heap_key.push(0_u8);
    invoke_posix_getenv(heap_key.as_slice().as_ptr(), is_darwin)
}

/| Queries validated `key` on Linux into `arena` without touching global heap.
@cfg(target.os == "linux") @std_cap_boundary(clears: [ffi, unsafe_op, alloc, blocking_sync])
fn host_var_in(arena: &mut Arena, key: str, /) -> str!VarError {
    let val_addr: usize = posix_getenv_addr_in(&mut arena.*, key.as_bytes(), false);
    if val_addr == 0_usize {
        return .Err(.NotPresent);
    }
    let val_bytes: &[u8] = cstr_ptr_to_bytes(val_addr as *u8);
    if not is_valid_utf8(val_bytes) {
        return .Err(.NotUnicode);
    }
    .Ok(
        arena.dupe_str(
            unsafe {
                @str_from_utf8_unchecked(val_bytes)
            },
        ),
    )
}

/| Queries validated `key` on macOS into `arena` without touching global heap.
@cfg(target.os == "macos") @std_cap_boundary(clears: [ffi, unsafe_op, alloc, blocking_sync])
fn host_var_in(arena: &mut Arena, key: str, /) -> str!VarError {
    let val_addr: usize = posix_getenv_addr_in(&mut arena.*, key.as_bytes(), true);
    if val_addr == 0_usize {
        return .Err(.NotPresent);
    }
    let val_bytes: &[u8] = cstr_ptr_to_bytes(val_addr as *u8);
    if not is_valid_utf8(val_bytes) {
        return .Err(.NotUnicode);
    }
    .Ok(
        arena.dupe_str(
            unsafe {
                @str_from_utf8_unchecked(val_bytes)
            },
        ),
    )
}

/| Queries validated `key` on Windows via `GetEnvironmentVariableW` strictly inside `arena`.
@cfg(target.os == "windows") @std_cap_boundary(clears: [ffi, unsafe_op, alloc, blocking_sync])
fn host_var_in(arena: &mut Arena, key: str, /) -> str!VarError {
    let cp = arena.checkpoint();
    var stack_key_w: [u16; STACK_WCHAR_CAP] = [0_u16; STACK_WCHAR_CAP];
    let key_w_ptr: *u16 = if key.len() < STACK_WCHAR_CAP {
        let written_k: usize = encode_wtf8_to_wtf16(key.as_bytes(), &mut stack_key_w) catch {
            return .Err(.InvalidName);
        };
        write_u16_at(&mut stack_key_w, written_k, 0_u16);
        &raw stack_key_w[0]
    } else {
        let key_cap: usize = key.len() +% 1_usize;
        let key_raw: *mut u16 = arena.alloc_slice[u16](key_cap, zeroed: true).as_mut_ptr();
        let key_mut: &mut [u16] = unsafe {
            @slice_from_raw_parts_mut(key_raw, key_cap)
        };
        let written_k: usize = encode_wtf8_to_wtf16(key.as_bytes(), key_mut) catch {
            arena.restore(cp);
            return .Err(.InvalidName);
        };
        write_u16_at(key_mut, written_k, 0_u16);
        key_raw as *u16
    };

    var stack_val_w: [u16; STACK_WCHAR_CAP] = [0_u16; STACK_WCHAR_CAP];
    unsafe {
        sys.windows.win32_set_last_error(sys.windows.ERROR_SUCCESS);
    }
    let first_len: u32 = unsafe {
        sys.windows.win32_get_environment_variable_w(
            key_w_ptr,
            &raw mut stack_val_w[0],
            STACK_WCHAR_CAP as u32,
        )
    };
    if first_len == 0_u32 {
        let last_err: u32 = unsafe {
            sys.windows.win32_get_last_error()
        };
        arena.restore(cp);
        if last_err != sys.windows.ERROR_SUCCESS {
            return .Err(.NotPresent);
        }
        return .Ok("");
    }
    if (first_len as usize) < STACK_WCHAR_CAP {
        arena.restore(cp);
        let val_path: Path = decode_wtf16_in_arena(
            &mut arena.*,
            subslice_u16(&stack_val_w, 0_usize, first_len as usize),
        );
        if val_path.to_str() is .Some(valid_str) {
            return .Ok(valid_str);
        }
        return .Err(.NotUnicode);
    }

    var dyn_cap = first_len as usize;
    while dyn_cap <= MAX_PATH_GROW_UNITS {
        let scratch_raw: *mut u16 = arena.alloc_slice[u16](dyn_cap, zeroed: false).as_mut_ptr();
        unsafe {
            sys.windows.win32_set_last_error(sys.windows.ERROR_SUCCESS);
        }
        let got_len: u32 = unsafe {
            sys.windows.win32_get_environment_variable_w(
                key_w_ptr,
                scratch_raw,
                dyn_cap as u32,
            )
        };
        if got_len == 0_u32 {
            let last_err: u32 = unsafe {
                sys.windows.win32_get_last_error()
            };
            arena.restore(cp);
            if last_err != sys.windows.ERROR_SUCCESS {
                return .Err(.NotPresent);
            }
            return .Ok("");
        }
        if (got_len as usize) < dyn_cap {
            let valid_slice: &[u16] = unsafe {
                @slice_from_raw_parts(scratch_raw as *u16, got_len as usize)
            };
            let utf8_needed: usize = wtf8_len_for_wtf16(valid_slice);
            let temp_raw: *mut u8 = arena.alloc_slice[u8](utf8_needed, zeroed: false).as_mut_ptr();
            let temp_mut: &mut [u8] = unsafe {
                @slice_from_raw_parts_mut(temp_raw, utf8_needed)
            };
            let written_b: usize = decode_wtf16_to_wtf8(valid_slice, temp_mut);
            let wtf8_view: &[u8] = unsafe {
                @slice_from_raw_parts(temp_raw as *u8, written_b)
            };
            if not is_valid_utf8(wtf8_view) {
                arena.restore(cp);
                return .Err(.NotUnicode);
            }
            return .Ok(
                unsafe {
                    @str_from_utf8_unchecked(wtf8_view)
                },
            );
        }
        dyn_cap = got_len as usize;
    }
    arena.restore(cp);
    .Err(.NotPresent)
}

/| Queries validated `key` on WASI via `environ_sizes_get` + `environ_get` inside `arena`.
@cfg(target.os == "wasi") @std_cap_boundary(clears: [ffi, unsafe_op, alloc, blocking_sync])
fn host_var_in(arena: &mut Arena, key: str, /) -> str!VarError {
    var env_count: usize = 0;
    var buf_size: usize = 0;
    let sz_rc: u16 = unsafe {
        sys.wasi.wasi_environ_sizes_get(&raw mut env_count, &raw mut buf_size)
    };
    if sz_rc != sys.wasi.WASI_ERRNO_SUCCESS or env_count == 0_usize {
        return .Err(.NotPresent);
    }
    let cp = arena.checkpoint();
    let ptrs_raw: *mut *mut u8 = arena.alloc_slice[*mut u8](env_count, zeroed: true).as_mut_ptr();
    let safe_buf_len: usize = if buf_size > 0_usize => buf_size else 1_usize;
    let text_raw: *mut u8 = arena.alloc_slice[u8](safe_buf_len, zeroed: true).as_mut_ptr();
    let get_rc: u16 = unsafe {
        sys.wasi.wasi_environ_get(ptrs_raw, text_raw)
    };
    if get_rc != sys.wasi.WASI_ERRNO_SUCCESS {
        arena.restore(cp);
        return .Err(.NotPresent);
    }
    let target_key: &[u8] = key.as_bytes();
    var i: usize = 0;
    while i < env_count {
        let entry_ptr: *mut u8 = unsafe {
            ptrs_raw.add(i).read()
        };
        let entry_bytes: &[u8] = cstr_ptr_to_bytes(entry_ptr as *u8);
        let eq_idx: usize = find_first_byte(entry_bytes, b'=') orelse {
            i = i +% 1_usize;
            continue;
        };
        if subslice_u8(entry_bytes, 0_usize, eq_idx) == target_key {
            let val_bytes: &[u8] = subslice_u8(entry_bytes, eq_idx +% 1_usize, entry_bytes.len());
            if not is_valid_utf8(val_bytes) {
                arena.restore(cp);
                return .Err(.NotUnicode);
            }
            if val_bytes.is_empty() {
                arena.restore(cp);
                return .Ok("");
            }
            if val_bytes.len() <= STACK_CSTR_CAP {
                var stack_copy: [u8; STACK_CSTR_CAP] = [0_u8; STACK_CSTR_CAP];
                unsafe {
                    @memcpy(
                        &raw mut stack_copy[0] as *mut opaque,
                        val_bytes.as_ptr() as *opaque,
                        val_bytes.len(),
                    );
                }
                arena.restore(cp);
                let saved: &[u8] = subslice_u8(&stack_copy, 0_usize, val_bytes.len());
                return .Ok(
                    arena.dupe_str(
                        unsafe {
                            @str_from_utf8_unchecked(saved)
                        },
                    ),
                );
            }
            return .Ok(
                unsafe {
                    @str_from_utf8_unchecked(val_bytes)
                },
            );
        }
        i = i +% 1_usize;
    }
    arena.restore(cp);
    .Err(.NotPresent)
}

/| Returns `.Err(.NotPresent)` on freestanding targets.
@cfg(target.os == "freestanding")
fn host_var_in(arena: &mut Arena, key: str, /) -> str!VarError {
    _ = arena;
    _ = key;
    .Err(.NotPresent)
}

/| Looks up validated `key` as a lossless `OptPathBuf` on Linux.
@cfg(target.os == "linux") @std_cap_boundary(clears: [ffi, unsafe_op, blocking_sync])
fn host_var_os(key: str, /) -> OptPathBuf {
    let val_addr: usize = posix_getenv_addr_heap(key.as_bytes(), false);
    if val_addr == 0_usize {
        return .None;
    }
    .Some(PathBuf.from(cstr_ptr_to_bytes(val_addr as *u8)))
}

/| Looks up validated `key` as a lossless `OptPathBuf` on macOS.
@cfg(target.os == "macos") @std_cap_boundary(clears: [ffi, unsafe_op, blocking_sync])
fn host_var_os(key: str, /) -> OptPathBuf {
    let val_addr: usize = posix_getenv_addr_heap(key.as_bytes(), true);
    if val_addr == 0_usize {
        return .None;
    }
    .Some(PathBuf.from(cstr_ptr_to_bytes(val_addr as *u8)))
}

/| Looks up validated `key` as a lossless WTF-8 `OptPathBuf` on Windows (`GetEnvironmentVariableW`).
@cfg(target.os == "windows") @std_cap_boundary(clears: [ffi, unsafe_op, blocking_sync])
fn host_var_os(key: str, /) -> OptPathBuf {
    var stack_key_w: [u16; STACK_WCHAR_CAP] = [0_u16; STACK_WCHAR_CAP];
    var heap_key_w = Vec[u16].new();
    let key_w_ptr: *u16 = if key.len() < STACK_WCHAR_CAP {
        let written_k: usize = encode_wtf8_to_wtf16(key.as_bytes(), &mut stack_key_w) catch {
            return .None;
        };
        write_u16_at(&mut stack_key_w, written_k, 0_u16);
        &raw stack_key_w[0]
    } else {
        let needed_k: usize = key.len() +% 1_usize;
        heap_key_w.reserve(needed_k);
        var k_i: usize = 0;
        while k_i < needed_k {
            heap_key_w.push(0_u16);
            k_i = k_i +% 1_usize;
        }
        let written_k: usize = encode_wtf8_to_wtf16(key.as_bytes(), heap_key_w.as_mut_slice()) catch {
            return .None;
        };
        write_u16_at(heap_key_w.as_mut_slice(), written_k, 0_u16);
        heap_key_w.as_slice().as_ptr()
    };

    var stack_val_w: [u16; STACK_WCHAR_CAP] = [0_u16; STACK_WCHAR_CAP];
    unsafe {
        sys.windows.win32_set_last_error(sys.windows.ERROR_SUCCESS);
    }
    let first_len: u32 = unsafe {
        sys.windows.win32_get_environment_variable_w(
            key_w_ptr,
            &raw mut stack_val_w[0],
            STACK_WCHAR_CAP as u32,
        )
    };
    if first_len == 0_u32 {
        let last_err: u32 = unsafe {
            sys.windows.win32_get_last_error()
        };
        if last_err != sys.windows.ERROR_SUCCESS or last_err == WIN32_ERROR_ENVVAR_NOT_FOUND {
            return .None;
        }
        return .Some(PathBuf.new());
    }
    if (first_len as usize) < STACK_WCHAR_CAP {
        return .Some(
            decode_wtf16_to_path_buf(subslice_u16(&stack_val_w, 0_usize, first_len as usize)),
        );
    }

    var dyn_cap = first_len as usize;
    while dyn_cap <= MAX_PATH_GROW_UNITS {
        var heap_val_w = Vec[u16].with_capacity(dyn_cap);
        var v_i: usize = 0;
        while v_i < dyn_cap {
            heap_val_w.push(0_u16);
            v_i = v_i +% 1_usize;
        }
        unsafe {
            sys.windows.win32_set_last_error(sys.windows.ERROR_SUCCESS);
        }
        let got_len: u32 = unsafe {
            sys.windows.win32_get_environment_variable_w(
                key_w_ptr,
                heap_val_w.as_mut_slice().as_mut_ptr(),
                dyn_cap as u32,
            )
        };
        if got_len == 0_u32 {
            let last_err: u32 = unsafe {
                sys.windows.win32_get_last_error()
            };
            if last_err != sys.windows.ERROR_SUCCESS {
                return .None;
            }
            return .Some(PathBuf.new());
        }
        if (got_len as usize) < dyn_cap {
            return .Some(
                decode_wtf16_to_path_buf(
                    subslice_u16(heap_val_w.as_slice(), 0_usize, got_len as usize),
                ),
            );
        }
        dyn_cap = got_len as usize;
    }
    .None
}

/| Looks up validated `key` as `OptPathBuf` on WASI via `environ_sizes_get` + `environ_get`.
@cfg(target.os == "wasi") @std_cap_boundary(clears: [ffi, unsafe_op, blocking_sync])
fn host_var_os(key: str, /) -> OptPathBuf {
    var env_count: usize = 0;
    var buf_size: usize = 0;
    let sz_rc: u16 = unsafe {
        sys.wasi.wasi_environ_sizes_get(&raw mut env_count, &raw mut buf_size)
    };
    if sz_rc != sys.wasi.WASI_ERRNO_SUCCESS or env_count == 0_usize {
        return .None;
    }
    let target_key: &[u8] = key.as_bytes();
    if env_count <= WASI_STACK_PTR_CAP and buf_size <= WASI_STACK_BUF_CAP {
        var stack_ptrs: [*mut u8; WASI_STACK_PTR_CAP] = [@default_init[*mut u8](); WASI_STACK_PTR_CAP];
        var stack_buf: [u8; WASI_STACK_BUF_CAP] = [0_u8; WASI_STACK_BUF_CAP];
        let get_rc: u16 = unsafe {
            sys.wasi.wasi_environ_get(&raw mut stack_ptrs[0], &raw mut stack_buf[0])
        };
        if get_rc != sys.wasi.WASI_ERRNO_SUCCESS {
            return .None;
        }
        var i: usize = 0;
        while i < env_count {
            let entry_ptr: *mut u8 = if i < WASI_STACK_PTR_CAP => stack_ptrs[i]
                else @default_init[*mut u8]();
            let entry_bytes: &[u8] = cstr_ptr_to_bytes(entry_ptr as *u8);
            if find_first_byte(entry_bytes, b'=') is .Some(eq_idx) {
                let key_part: &[u8] = subslice_u8(entry_bytes, 0_usize, eq_idx);
                if key_part == target_key {
                    return .Some(
                        PathBuf.from(subslice_u8(entry_bytes, eq_idx +% 1_usize, entry_bytes.len())),
                    );
                }
            }
            i = i +% 1_usize;
        }
        return .None;
    }

    var heap_ptrs = Vec[*mut u8].with_capacity(env_count);
    var p_i: usize = 0;
    while p_i < env_count {
        heap_ptrs.push(@default_init[*mut u8]());
        p_i = p_i +% 1_usize;
    }
    let safe_buf_len: usize = if buf_size > 0_usize => buf_size else 1_usize;
    var heap_buf = Vec[u8].with_capacity(safe_buf_len);
    var b_i: usize = 0;
    while b_i < safe_buf_len {
        heap_buf.push(0_u8);
        b_i = b_i +% 1_usize;
    }
    let get_rc: u16 = unsafe {
        sys.wasi.wasi_environ_get(
            heap_ptrs.as_mut_slice().as_mut_ptr(),
            heap_buf.as_mut_slice().as_mut_ptr(),
        )
    };
    if get_rc != sys.wasi.WASI_ERRNO_SUCCESS {
        return .None;
    }
    let ptrs_view: &[*mut u8] = heap_ptrs.as_slice();
    var i: usize = 0;
    while i < env_count {
        let entry_ptr: *mut u8 = if i < ptrs_view.len() => ptrs_view[i]
            else @default_init[*mut u8]();
        let entry_bytes: &[u8] = cstr_ptr_to_bytes(entry_ptr as *u8);
        let eq_idx: usize = find_first_byte(entry_bytes, b'=') orelse {
            i = i +% 1_usize;
            continue;
        };
        if subslice_u8(entry_bytes, 0_usize, eq_idx) == target_key {
            return .Some(
                PathBuf.from(subslice_u8(entry_bytes, eq_idx +% 1_usize, entry_bytes.len())),
            );
        }
        i = i +% 1_usize;
    }
    .None
}

/| Returns `.None` on freestanding targets.
@cfg(target.os == "freestanding")
fn host_var_os(key: str, /) -> OptPathBuf {
    _ = key;
    .None
}

/| Collects `(String, String)` pairs from a POSIX `NUL`-terminated `KEY=VAL` pointer array.
@std_cap_boundary(clears: [unsafe_op])
fn collect_posix_environ_vec(env_vec_ptr: *mut *mut u8, /) -> EnvPairVec {
    if env_vec_ptr.is_null() {
        return EnvPairVec.new();
    }
    var out = EnvPairVec.new();
    var idx: usize = 0;
    while idx < MAX_ENV_ENTRIES {
        let entry_ptr: *mut u8 = unsafe {
            env_vec_ptr.add(idx).read()
        };
        if entry_ptr.is_null() {
            break;
        }
        let entry_bytes: &[u8] = cstr_ptr_to_bytes(entry_ptr as *u8);
        if find_first_byte(entry_bytes, b'=') is .Some(eq_idx) and eq_idx > 0_usize {
            let key_str: String = os_bytes_to_string_lossy(subslice_u8(entry_bytes, 0_usize, eq_idx));
            let val_str: String = os_bytes_to_string_lossy(
                subslice_u8(entry_bytes, eq_idx +% 1_usize, entry_bytes.len()),
            );
            out.push((own key_str, own val_str));
        }
        idx = idx +% 1_usize;
    }
    out
}

/| Enumerates `environ` on Linux into `EnvPairVec`.
@cfg(target.os == "linux") @std_cap_boundary(clears: [ffi, unsafe_op, blocking_sync])
fn host_vars() -> EnvPairVec {
    let env_vec_ptr: *mut *mut u8 = unsafe {
        linux_environ
    };
    collect_posix_environ_vec(env_vec_ptr)
}

/| Enumerates `_NSGetEnviron().*` on macOS into `EnvPairVec`.
@cfg(target.os == "macos") @std_cap_boundary(clears: [ffi, unsafe_op, blocking_sync])
fn host_vars() -> EnvPairVec {
    let env_slot_ptr: *mut *mut *mut u8 = unsafe {
        sys.macos.darwin_ns_get_environ()
    };
    if env_slot_ptr == (0 as *mut *mut *mut u8) {
        return EnvPairVec.new();
    }
    let env_vec_ptr: *mut *mut u8 = unsafe {
        env_slot_ptr.*
    };
    collect_posix_environ_vec(env_vec_ptr)
}

/| Enumerates `GetEnvironmentStringsW()` on Windows (skipping hidden `=C:=…` pseudo-entries) and frees snapshot.
@cfg(target.os == "windows") @std_cap_boundary(clears: [ffi, unsafe_op, blocking_sync])
fn host_vars() -> EnvPairVec {
    let block_ptr: *mut u16 = unsafe {
        sys.windows.win32_get_environment_strings_w()
    };
    if block_ptr.is_null() {
        return EnvPairVec.new();
    }
    defer {
        unsafe {
            _ = sys.windows.win32_free_environment_strings_w(block_ptr);
        }
    }

    var out = EnvPairVec.new();
    var cursor: usize = 0;
    var entry_count: usize = 0;
    while cursor < MAX_WCHAR_SCAN_UNITS and entry_count < MAX_ENV_ENTRIES {
        let first_unit: u16 = unsafe {
            block_ptr.add(cursor).read()
        };
        if first_unit == 0_u16 {
            break;
        }
        var end_cursor: usize = cursor +% 1_usize;
        while end_cursor < MAX_WCHAR_SCAN_UNITS {
            let cur_u16: u16 = unsafe {
                block_ptr.add(end_cursor).read()
            };
            if cur_u16 == 0_u16 {
                break;
            }
            end_cursor = end_cursor +% 1_usize;
        }
        let entry_len: usize = end_cursor -% cursor;
        // Skip hidden `cmd.exe` drive working-directory entries starting with `'='` (`=C:=C:\…`):
        if first_unit != 0x003D_u16 and entry_len > 1_usize {
            let entry_u16: &[u16] = unsafe {
                @slice_from_raw_parts(block_ptr.add(cursor) as *u16, entry_len)
            };
            var eq_pos: usize? = .None;
            var scan_i: usize = 1;
            while scan_i < entry_len {
                if u16_at(entry_u16, scan_i) == 0x003D_u16 {
                    eq_pos = .Some(scan_i);
                    break;
                }
                scan_i = scan_i +% 1_usize;
            }
            if eq_pos is .Some(split_idx) {
                let key_str: String = wtf16_to_string_lossy(
                    subslice_u16(entry_u16, 0_usize, split_idx),
                );
                let val_str: String = wtf16_to_string_lossy(
                    subslice_u16(entry_u16, split_idx +% 1_usize, entry_len),
                );
                out.push((own key_str, own val_str));
            }
        }
        cursor = end_cursor +% 1_usize;
        entry_count = entry_count +% 1_usize;
    }
    out
}

/| Enumerates `environ_sizes_get` + `environ_get` on WASI into `EnvPairVec`.
@cfg(target.os == "wasi") @std_cap_boundary(clears: [ffi, unsafe_op, blocking_sync])
fn host_vars() -> EnvPairVec {
    var env_count: usize = 0;
    var buf_size: usize = 0;
    let sz_rc: u16 = unsafe {
        sys.wasi.wasi_environ_sizes_get(&raw mut env_count, &raw mut buf_size)
    };
    if sz_rc != sys.wasi.WASI_ERRNO_SUCCESS or env_count == 0_usize {
        return EnvPairVec.new();
    }
    var out = EnvPairVec.with_capacity(env_count);
    if env_count <= WASI_STACK_PTR_CAP and buf_size <= WASI_STACK_BUF_CAP {
        var stack_ptrs: [*mut u8; WASI_STACK_PTR_CAP] = [@default_init[*mut u8](); WASI_STACK_PTR_CAP];
        var stack_buf: [u8; WASI_STACK_BUF_CAP] = [0_u8; WASI_STACK_BUF_CAP];
        let get_rc: u16 = unsafe {
            sys.wasi.wasi_environ_get(&raw mut stack_ptrs[0], &raw mut stack_buf[0])
        };
        if get_rc != sys.wasi.WASI_ERRNO_SUCCESS {
            return out;
        }
        var i: usize = 0;
        while i < env_count {
            let entry_ptr: *mut u8 = if i < WASI_STACK_PTR_CAP => stack_ptrs[i]
                else @default_init[*mut u8]();
            let entry_bytes: &[u8] = cstr_ptr_to_bytes(entry_ptr as *u8);
            if find_first_byte(entry_bytes, b'=') is .Some(eq_idx) and eq_idx > 0_usize {
                let key_str: String = os_bytes_to_string_lossy(
                    subslice_u8(entry_bytes, 0_usize, eq_idx),
                );
                let val_str: String = os_bytes_to_string_lossy(
                    subslice_u8(entry_bytes, eq_idx +% 1_usize, entry_bytes.len()),
                );
                out.push((own key_str, own val_str));
            }
            i = i +% 1_usize;
        }
        return out;
    }

    var heap_ptrs = Vec[*mut u8].with_capacity(env_count);
    var p_i: usize = 0;
    while p_i < env_count {
        heap_ptrs.push(@default_init[*mut u8]());
        p_i = p_i +% 1_usize;
    }
    let safe_buf_len: usize = if buf_size > 0_usize => buf_size else 1_usize;
    var heap_buf = Vec[u8].with_capacity(safe_buf_len);
    var b_i: usize = 0;
    while b_i < safe_buf_len {
        heap_buf.push(0_u8);
        b_i = b_i +% 1_usize;
    }
    let get_rc: u16 = unsafe {
        sys.wasi.wasi_environ_get(
            heap_ptrs.as_mut_slice().as_mut_ptr(),
            heap_buf.as_mut_slice().as_mut_ptr(),
        )
    };
    if get_rc != sys.wasi.WASI_ERRNO_SUCCESS {
        return out;
    }
    let ptrs_view: &[*mut u8] = heap_ptrs.as_slice();
    var i: usize = 0;
    while i < env_count {
        let entry_ptr: *mut u8 = if i < ptrs_view.len() => ptrs_view[i]
            else @default_init[*mut u8]();
        let entry_bytes: &[u8] = cstr_ptr_to_bytes(entry_ptr as *u8);
        if find_first_byte(entry_bytes, b'=') is .Some(eq_idx) and eq_idx > 0_usize {
            let key_str: String = os_bytes_to_string_lossy(
                subslice_u8(entry_bytes, 0_usize, eq_idx),
            );
            let val_str: String = os_bytes_to_string_lossy(
                subslice_u8(entry_bytes, eq_idx +% 1_usize, entry_bytes.len()),
            );
            out.push((own key_str, own val_str));
        }
        i = i +% 1_usize;
    }
    out
}

/| Returns empty `EnvPairVec` on freestanding targets.
@cfg(target.os == "freestanding")
fn host_vars() -> EnvPairVec = EnvPairVec.new();

/| Shared POSIX `setenv` / `unsetenv` implementation using stack fast path + RAII `Vec[u8]`.
@std_cap_boundary(clears: [ffi, alloc])
unsafe fn posix_mutate_var(key: str, val_opt: str?, is_darwin: bool, /) -> unit!VarError {
    let key_bytes: &[u8] = key.as_bytes();
    var stack_key: [u8; STACK_CSTR_CAP] = [0_u8; STACK_CSTR_CAP];
    var heap_key = Vec[u8].new();
    let key_ptr: *u8 = if key_bytes.len() < STACK_CSTR_CAP {
        @memcpy(
            &raw mut stack_key[0] as *mut opaque,
            key_bytes.as_ptr() as *opaque,
            key_bytes.len(),
        );
        &raw stack_key[0]
    } else {
        heap_key.reserve(key_bytes.len() +% 1_usize);
        heap_key.extend_from_slice(key_bytes);
        heap_key.push(0_u8);
        heap_key.as_slice().as_ptr()
    };

    if val_opt is .Some(val_str) {
        let val_bytes: &[u8] = val_str.as_bytes();
        var stack_val: [u8; STACK_PATH_BYTES_CAP] = [0_u8; STACK_PATH_BYTES_CAP];
        var heap_val = Vec[u8].new();
        let val_ptr: *u8 = if val_bytes.len() < STACK_PATH_BYTES_CAP {
            @memcpy(
                &raw mut stack_val[0] as *mut opaque,
                val_bytes.as_ptr() as *opaque,
                val_bytes.len(),
            );
            &raw stack_val[0]
        } else {
            heap_val.reserve(val_bytes.len() +% 1_usize);
            heap_val.extend_from_slice(val_bytes);
            heap_val.push(0_u8);
            heap_val.as_slice().as_ptr()
        };
        let rc: i32 = if is_darwin => sys.macos.darwin_setenv(key_ptr, val_ptr, 1)
            else sys.linux.linux_setenv(key_ptr, val_ptr, 1);
        return if rc == 0 => .Ok(()) else .Err(.InvalidName);
    }

    let rc: i32 = if is_darwin => sys.macos.darwin_unsetenv(key_ptr)
        else sys.linux.linux_unsetenv(key_ptr);
    if rc == 0 => .Ok(()) else .Err(.InvalidName)
}

/| Mutates or unsets `key` on Linux via `setenv` / `unsetenv`.
@cfg(target.os == "linux")
unsafe fn host_mutate_var(key: str, val_opt: str?, /) -> unit!VarError {
    posix_mutate_var(key, val_opt, false)
}

/| Mutates or unsets `key` on macOS via `setenv` / `unsetenv`.
@cfg(target.os == "macos")
unsafe fn host_mutate_var(key: str, val_opt: str?, /) -> unit!VarError {
    posix_mutate_var(key, val_opt, true)
}

/| Mutates or unsets `key` on Windows via `SetEnvironmentVariableW(key_w, val_w_or_null)`.
@cfg(target.os == "windows") @std_cap_boundary(clears: [ffi, alloc])
unsafe fn host_mutate_var(key: str, val_opt: str?, /) -> unit!VarError {
    var stack_key_w: [u16; STACK_WCHAR_CAP] = [0_u16; STACK_WCHAR_CAP];
    var heap_key_w = Vec[u16].new();
    let key_u16_cap: usize = key.len() +% 1_usize;
    let key_w_ptr: *u16 = if key_u16_cap <= STACK_WCHAR_CAP {
        let written_k: usize = encode_wtf8_to_wtf16(key.as_bytes(), &mut stack_key_w) catch {
            return .Err(.InvalidName);
        };
        write_u16_at(&mut stack_key_w, written_k, 0_u16);
        &raw stack_key_w[0]
    } else {
        heap_key_w.reserve(key_u16_cap);
        var k_i: usize = 0;
        while k_i < key_u16_cap {
            heap_key_w.push(0_u16);
            k_i = k_i +% 1_usize;
        }
        let written_k: usize = encode_wtf8_to_wtf16(key.as_bytes(), heap_key_w.as_mut_slice()) catch {
            return .Err(.InvalidName);
        };
        write_u16_at(heap_key_w.as_mut_slice(), written_k, 0_u16);
        heap_key_w.as_slice().as_ptr()
    };

    if val_opt is .Some(val_str) {
        var stack_val_w: [u16; STACK_WCHAR_CAP] = [0_u16; STACK_WCHAR_CAP];
        var heap_val_w = Vec[u16].new();
        let val_u16_cap: usize = val_str.len() +% 1_usize;
        let val_w_ptr: *u16 = if val_u16_cap <= STACK_WCHAR_CAP {
            let written_v: usize = encode_wtf8_to_wtf16(val_str.as_bytes(), &mut stack_val_w) catch {
                return .Err(.InvalidName);
            };
            write_u16_at(&mut stack_val_w, written_v, 0_u16);
            &raw stack_val_w[0]
        } else {
            heap_val_w.reserve(val_u16_cap);
            var v_i: usize = 0;
            while v_i < val_u16_cap {
                heap_val_w.push(0_u16);
                v_i = v_i +% 1_usize;
            }
            let written_v: usize = encode_wtf8_to_wtf16(
                val_str.as_bytes(),
                heap_val_w.as_mut_slice(),
            ) catch {
                return .Err(.InvalidName);
            };
            write_u16_at(heap_val_w.as_mut_slice(), written_v, 0_u16);
            heap_val_w.as_slice().as_ptr()
        };
        let ok: i32 = sys.windows.win32_set_environment_variable_w(key_w_ptr, val_w_ptr);
        return if ok != 0 => .Ok(()) else .Err(.InvalidName);
    }

    let ok: i32 = sys.windows.win32_set_environment_variable_w(key_w_ptr, @default_init[*u16]());
    if ok != 0 => .Ok(()) else .Err(.InvalidName)
}

/| Validates no-op environment mutation on WASI / freestanding when `SimReactor` is inactive.
@cfg(target.os == "wasi" or target.os == "freestanding")
unsafe fn host_mutate_var(key: str, val_opt: str?, /) -> unit!VarError {
    _ = key;
    _ = val_opt;
    .Ok(())
}

// ------------------- Host Working Dir & Exe -------------------
/| Reads thread-local POSIX `errno` on Linux (`EIO` fallback if null).
@std_cap_boundary(clears: [ffi, unsafe_op, alloc, blocking_sync])
fn read_linux_errno() -> i32 {
    let errno_ptr: *mut i32 = unsafe {
        sys.linux.linux_errno_location()
    };
    if errno_ptr == (0 as *mut i32) {
        return sys.linux.EIO;
    }
    unsafe {
        errno_ptr.*
    }
}

/| Reads thread-local Darwin `errno` on macOS (`EIO` fallback if null).
@std_cap_boundary(clears: [ffi, unsafe_op, alloc, blocking_sync])
fn read_darwin_errno() -> i32 {
    let errno_ptr: *mut i32 = unsafe {
        sys.macos.darwin_errno_location()
    };
    if errno_ptr == (0 as *mut i32) {
        return sys.macos.EIO;
    }
    unsafe {
        errno_ptr.*
    }
}

/| Queries `getcwd` on Linux with `1 KiB` stack fast path and `ERANGE` dynamic growth.
@cfg(target.os == "linux") @std_cap_boundary(clears: [ffi, unsafe_op])
fn host_current_dir() -> PathBuf!FsError {
    var stack_buf: [u8; STACK_PATH_BYTES_CAP] = [0_u8; STACK_PATH_BYTES_CAP];
    let first_ptr: *mut u8 = unsafe {
        sys.linux.linux_getcwd(&raw mut stack_buf[0], STACK_PATH_BYTES_CAP)
    };
    if not first_ptr.is_null() {
        return .Ok(PathBuf.from(cstr_ptr_to_bytes(&raw stack_buf[0])));
    }
    let first_err: i32 = read_linux_errno();
    if first_err != sys.linux.ERANGE {
        return .Err(FsError.from_raw_os(first_err, domain: .PosixErrno, op: .Env));
    }

    var dyn_cap: usize = STACK_PATH_BYTES_CAP * 2_usize;
    while dyn_cap <= MAX_PATH_GROW_UNITS {
        var heap_buf = Vec[u8].with_capacity(dyn_cap);
        var i: usize = 0;
        while i < dyn_cap {
            heap_buf.push(0_u8);
            i = i +% 1_usize;
        }
        let got_ptr: *mut u8 = unsafe {
            sys.linux.linux_getcwd(heap_buf.as_mut_slice().as_mut_ptr(), dyn_cap)
        };
        if not got_ptr.is_null() {
            return .Ok(PathBuf.from(cstr_ptr_to_bytes(heap_buf.as_slice().as_ptr())));
        }
        let cur_err: i32 = read_linux_errno();
        if cur_err != sys.linux.ERANGE {
            return .Err(FsError.from_raw_os(cur_err, domain: .PosixErrno, op: .Env));
        }
        dyn_cap *= 2_usize;
    }
    .Err(FsError.from_raw_os(sys.linux.ERANGE, domain: .PosixErrno, op: .Env))
}

/| Queries `getcwd` on macOS with `1 KiB` stack fast path and `ERANGE` dynamic growth.
@cfg(target.os == "macos") @std_cap_boundary(clears: [ffi, unsafe_op])
fn host_current_dir() -> PathBuf!FsError {
    var stack_buf: [u8; STACK_PATH_BYTES_CAP] = [0_u8; STACK_PATH_BYTES_CAP];
    let first_ptr: *mut u8 = unsafe {
        sys.macos.darwin_getcwd(&raw mut stack_buf[0], STACK_PATH_BYTES_CAP)
    };
    if not first_ptr.is_null() {
        return .Ok(PathBuf.from(cstr_ptr_to_bytes(&raw stack_buf[0])));
    }
    let first_err: i32 = read_darwin_errno();
    if first_err != sys.macos.ERANGE {
        return .Err(FsError.from_raw_os(first_err, domain: .PosixErrno, op: .Env));
    }

    var dyn_cap: usize = STACK_PATH_BYTES_CAP * 2_usize;
    while dyn_cap <= MAX_PATH_GROW_UNITS {
        var heap_buf = Vec[u8].with_capacity(dyn_cap);
        var i: usize = 0;
        while i < dyn_cap {
            heap_buf.push(0_u8);
            i = i +% 1_usize;
        }
        let got_ptr: *mut u8 = unsafe {
            sys.macos.darwin_getcwd(heap_buf.as_mut_slice().as_mut_ptr(), dyn_cap)
        };
        if not got_ptr.is_null() {
            return .Ok(PathBuf.from(cstr_ptr_to_bytes(heap_buf.as_slice().as_ptr())));
        }
        let cur_err: i32 = read_darwin_errno();
        if cur_err != sys.macos.ERANGE {
            return .Err(FsError.from_raw_os(cur_err, domain: .PosixErrno, op: .Env));
        }
        dyn_cap *= 2_usize;
    }
    .Err(FsError.from_raw_os(sys.macos.ERANGE, domain: .PosixErrno, op: .Env))
}

/| Queries `GetCurrentDirectoryW` on Windows with `[u16; 512]` stack fast path and dynamic growth.
@cfg(target.os == "windows") @std_cap_boundary(clears: [ffi, unsafe_op])
fn host_current_dir() -> PathBuf!FsError {
    var stack_w: [u16; STACK_WCHAR_CAP] = [0_u16; STACK_WCHAR_CAP];
    let first_len: u32 = unsafe {
        sys.windows.win32_get_current_directory_w(STACK_WCHAR_CAP as u32, &raw mut stack_w[0])
    };
    if first_len == 0_u32 {
        let err_code: u32 = unsafe {
            sys.windows.win32_get_last_error()
        };
        return .Err(FsError.from_raw_os(err_code as i32, domain: .Win32Error, op: .Env));
    }
    if (first_len as usize) < STACK_WCHAR_CAP {
        return .Ok(decode_wtf16_to_path_buf(subslice_u16(&stack_w, 0_usize, first_len as usize)));
    }

    var dyn_cap = first_len as usize;
    while dyn_cap <= MAX_PATH_GROW_UNITS {
        var heap_w = Vec[u16].with_capacity(dyn_cap);
        var i: usize = 0;
        while i < dyn_cap {
            heap_w.push(0_u16);
            i = i +% 1_usize;
        }
        let got_len: u32 = unsafe {
            sys.windows.win32_get_current_directory_w(
                dyn_cap as u32,
                heap_w.as_mut_slice().as_mut_ptr(),
            )
        };
        if got_len == 0_u32 {
            let err_code: u32 = unsafe {
                sys.windows.win32_get_last_error()
            };
            return .Err(FsError.from_raw_os(err_code as i32, domain: .Win32Error, op: .Env));
        }
        if (got_len as usize) < dyn_cap {
            return .Ok(
                decode_wtf16_to_path_buf(
                    subslice_u16(heap_w.as_slice(), 0_usize, got_len as usize),
                ),
            );
        }
        dyn_cap = got_len as usize;
    }
    .Err(FsError.from_kind(.InvalidFilename, op: .Env))
}

/| Resolves working directory on WASI via `$PWD` or preopen descriptor `3` (`"/"` fallback).
@cfg(target.os == "wasi") @std_cap_boundary(clears: [ffi, unsafe_op])
fn host_current_dir() -> PathBuf!FsError {
    if host_var_os("PWD") is .Some(pwd_pb) {
        if not pwd_pb.is_empty() and pwd_pb.as_path().is_absolute() {
            return .Ok(pwd_pb);
        }
    }
    var prestat = sys.wasi.WasiPrestat {
        tag: 0_u8,
        pad0: [0_u8; 3],
        pr_name_len: 0_usize,
    };
    let st_rc: u16 = unsafe {
        sys.wasi.wasi_fd_prestat_get(3, &raw mut prestat)
    };
    if st_rc == sys.wasi.WASI_ERRNO_SUCCESS and prestat.tag == sys.wasi.WASI_PREOPENTYPE_DIR {
        if prestat.pr_name_len > 0_usize and prestat.pr_name_len <= STACK_PATH_BYTES_CAP {
            var dir_buf: [u8; STACK_PATH_BYTES_CAP] = [0_u8; STACK_PATH_BYTES_CAP];
            let nm_rc: u16 = unsafe {
                sys.wasi.wasi_fd_prestat_dir_name(3, &raw mut dir_buf[0], prestat.pr_name_len)
            };
            if nm_rc == sys.wasi.WASI_ERRNO_SUCCESS {
                let name_slice: &[u8] = subslice_u8(&dir_buf, 0_usize, prestat.pr_name_len);
                if byte_at(name_slice, 0_usize) == b'/' {
                    return .Ok(PathBuf.from(name_slice));
                }
            }
        }
        return .Ok(PathBuf.from("/"));
    }
    .Err(FsError.from_raw_os(sys.wasi.WASI_ERRNO_NOSYS as i32, domain: .WasiErrno, op: .Env))
}

/| Returns `.Unsupported` on freestanding targets.
@cfg(target.os == "freestanding")
fn host_current_dir() -> PathBuf!FsError = .Err(FsError.from_kind(.Unsupported, op: .Env));

/| Shared POSIX `chdir` helper (`0` on success, `-1` on invalid filename, or positive POSIX `errno`).
@std_cap_boundary(clears: [ffi, unsafe_op, alloc])
fn posix_set_current_dir_errno(dir_bytes: &[u8], is_darwin: bool, /) -> i32 {
    if dir_bytes.is_empty() or has_nul_byte(dir_bytes) {
        return -1;
    }
    if dir_bytes.len() < STACK_PATH_BYTES_CAP {
        var stack_path: [u8; STACK_PATH_BYTES_CAP] = [0_u8; STACK_PATH_BYTES_CAP];
        unsafe {
            @memcpy(
                &raw mut stack_path[0] as *mut opaque,
                dir_bytes.as_ptr() as *opaque,
                dir_bytes.len(),
            );
        }
        let rc: i32 = if is_darwin {
            unsafe {
                sys.macos.darwin_chdir(&raw stack_path[0])
            }
        } else {
            unsafe {
                sys.linux.linux_chdir(&raw stack_path[0])
            }
        };
        if rc == 0 {
            return 0;
        }
        let err_no: i32 = if is_darwin => read_darwin_errno() else read_linux_errno();
        return if err_no > 0 => err_no else sys.linux.EIO;
    }

    var heap_path = Vec[u8].with_capacity(dir_bytes.len() +% 1_usize);
    heap_path.extend_from_slice(dir_bytes);
    heap_path.push(0_u8);
    let rc: i32 = if is_darwin {
        unsafe {
            sys.macos.darwin_chdir(heap_path.as_slice().as_ptr())
        }
    } else {
        unsafe {
            sys.linux.linux_chdir(heap_path.as_slice().as_ptr())
        }
    };
    if rc == 0 {
        return 0;
    }
    let err_no: i32 = if is_darwin => read_darwin_errno() else read_linux_errno();
    if err_no > 0 => err_no else sys.linux.EIO
}

/| Changes the process working directory via `chdir` on Linux.
@cfg(target.os == "linux")
fn host_set_current_dir(dir_bytes: &[u8], /) -> unit!FsError {
    let status: i32 = posix_set_current_dir_errno(dir_bytes, false);
    if status == 0 {
        return .Ok(());
    }
    if status < 0 {
        return .Err(FsError.from_kind(.InvalidFilename, op: .Env));
    }
    .Err(FsError.from_raw_os(status, domain: .PosixErrno, op: .Env))
}

/| Changes the process working directory via `chdir` on macOS.
@cfg(target.os == "macos")
fn host_set_current_dir(dir_bytes: &[u8], /) -> unit!FsError {
    let status: i32 = posix_set_current_dir_errno(dir_bytes, true);
    if status == 0 {
        return .Ok(());
    }
    if status < 0 {
        return .Err(FsError.from_kind(.InvalidFilename, op: .Env));
    }
    .Err(FsError.from_raw_os(status, domain: .PosixErrno, op: .Env))
}

/| Changes the process working directory via `SetCurrentDirectoryW` on Windows.
@cfg(target.os == "windows") @std_cap_boundary(clears: [ffi, unsafe_op, alloc])
fn host_set_current_dir(dir_bytes: &[u8], /) -> unit!FsError {
    if dir_bytes.is_empty() {
        return .Err(FsError.from_kind(.InvalidFilename, op: .Env));
    }
    let u16_cap: usize = dir_bytes.len() +% 1_usize;
    if u16_cap <= STACK_WCHAR_CAP {
        var stack_w: [u16; STACK_WCHAR_CAP] = [0_u16; STACK_WCHAR_CAP];
        let written_w: usize = encode_wtf8_to_wtf16(dir_bytes, &mut stack_w) catch {
            return .Err(FsError.from_kind(.InvalidFilename, op: .Env));
        };
        write_u16_at(&mut stack_w, written_w, 0_u16);
        let ok: i32 = unsafe {
            sys.windows.win32_set_current_directory_w(&raw stack_w[0])
        };
        if ok != 0 {
            return .Ok(());
        }
        let err_code: u32 = unsafe {
            sys.windows.win32_get_last_error()
        };
        return .Err(FsError.from_raw_os(err_code as i32, domain: .Win32Error, op: .Env));
    }

    var heap_w = Vec[u16].with_capacity(u16_cap);
    var w_i: usize = 0;
    while w_i < u16_cap {
        heap_w.push(0_u16);
        w_i = w_i +% 1_usize;
    }
    let written_w: usize = encode_wtf8_to_wtf16(dir_bytes, heap_w.as_mut_slice()) catch {
        return .Err(FsError.from_kind(.InvalidFilename, op: .Env));
    };
    write_u16_at(heap_w.as_mut_slice(), written_w, 0_u16);
    let ok: i32 = unsafe {
        sys.windows.win32_set_current_directory_w(heap_w.as_slice().as_ptr())
    };
    if ok != 0 {
        return .Ok(());
    }
    let err_code: u32 = unsafe {
        sys.windows.win32_get_last_error()
    };
    .Err(FsError.from_raw_os(err_code as i32, domain: .Win32Error, op: .Env))
}

/| Rejects `set_current_dir` on WASI Preview 1 (`WASI_ERRNO_NOSYS`, validating NULs first).
@cfg(target.os == "wasi")
fn host_set_current_dir(dir_bytes: &[u8], /) -> unit!FsError {
    if dir_bytes.is_empty() or has_nul_byte(dir_bytes) {
        return .Err(FsError.from_kind(.InvalidFilename, op: .Env));
    }
    .Err(FsError.from_raw_os(sys.wasi.WASI_ERRNO_NOSYS as i32, domain: .WasiErrno, op: .Env))
}

/| Rejects `set_current_dir` on freestanding targets.
@cfg(target.os == "freestanding")
fn host_set_current_dir(dir_bytes: &[u8], /) -> unit!FsError {
    _ = dir_bytes;
    .Err(FsError.from_kind(.Unsupported, op: .Env))
}

/| Resolves `/proc/self/exe` via `readlinkat` on Linux, growing buffer on truncation.
@cfg(target.os == "linux") @std_cap_boundary(clears: [ffi, unsafe_op])
fn host_current_exe() -> PathBuf!FsError {
    var stack_buf: [u8; STACK_PATH_BYTES_CAP] = [0_u8; STACK_PATH_BYTES_CAP];
    let first_rc: isize = unsafe {
        sys.linux.linux_readlinkat(
            sys.linux.AT_FDCWD,
            LINUX_PROC_SELF_EXE_Z.as_ptr(),
            &raw mut stack_buf[0],
            STACK_PATH_BYTES_CAP,
        )
    };
    if first_rc < 0_isize {
        return .Err(FsError.from_raw_os(read_linux_errno(), domain: .PosixErrno, op: .Env));
    }
    if first_rc == 0_isize {
        return .Err(FsError.from_kind(.NotFound, op: .Env));
    }
    if (first_rc as usize) < STACK_PATH_BYTES_CAP {
        return .Ok(PathBuf.from(subslice_u8(&stack_buf, 0_usize, first_rc as usize)));
    }

    var dyn_cap: usize = STACK_PATH_BYTES_CAP * 2_usize;
    while dyn_cap <= MAX_PATH_GROW_UNITS {
        var heap_buf = Vec[u8].with_capacity(dyn_cap);
        var i: usize = 0;
        while i < dyn_cap {
            heap_buf.push(0_u8);
            i = i +% 1_usize;
        }
        let got_rc: isize = unsafe {
            sys.linux.linux_readlinkat(
                sys.linux.AT_FDCWD,
                LINUX_PROC_SELF_EXE_Z.as_ptr(),
                heap_buf.as_mut_slice().as_mut_ptr(),
                dyn_cap,
            )
        };
        if got_rc < 0_isize {
            return .Err(FsError.from_raw_os(read_linux_errno(), domain: .PosixErrno, op: .Env));
        }
        if (got_rc as usize) < dyn_cap {
            return .Ok(
                PathBuf.from(subslice_u8(heap_buf.as_slice(), 0_usize, got_rc as usize)),
            );
        }
        dyn_cap *= 2_usize;
    }
    .Err(FsError.from_raw_os(sys.linux.ENAMETOOLONG, domain: .PosixErrno, op: .Env))
}

/| Resolves `_NSGetExecutablePath` (+ `realpath` canonicalization) on macOS, growing buffer on `-1`.
@cfg(target.os == "macos") @std_cap_boundary(clears: [ffi, unsafe_op])
fn host_current_exe() -> PathBuf!FsError {
    var stack_buf: [u8; STACK_PATH_BYTES_CAP] = [0_u8; STACK_PATH_BYTES_CAP];
    var req_size = STACK_PATH_BYTES_CAP as u32;
    let first_rc: i32 = unsafe {
        sys.macos.darwin_ns_get_executable_path(&raw mut stack_buf[0], &raw mut req_size)
    };
    if first_rc == 0 {
        var canon_buf: [u8; sys.macos.DARWIN_MAXPATHLEN] = [0_u8; sys.macos.DARWIN_MAXPATHLEN];
        let canon_ptr: *mut u8 = unsafe {
            sys.macos.darwin_realpath(&raw stack_buf[0], &raw mut canon_buf[0])
        };
        if not canon_ptr.is_null() {
            return .Ok(PathBuf.from(cstr_ptr_to_bytes(&raw canon_buf[0])));
        }
        return .Ok(PathBuf.from(cstr_ptr_to_bytes(&raw stack_buf[0])));
    }

    let dyn_cap = req_size as usize;
    if dyn_cap == 0_usize or dyn_cap > MAX_PATH_GROW_UNITS {
        return .Err(FsError.from_raw_os(sys.macos.ENAMETOOLONG, domain: .PosixErrno, op: .Env));
    }
    var heap_buf = Vec[u8].with_capacity(dyn_cap);
    var i: usize = 0;
    while i < dyn_cap {
        heap_buf.push(0_u8);
        i = i +% 1_usize;
    }
    var retry_size = req_size;
    let second_rc: i32 = unsafe {
        sys.macos.darwin_ns_get_executable_path(
            heap_buf.as_mut_slice().as_mut_ptr(),
            &raw mut retry_size,
        )
    };
    if second_rc != 0 {
        return .Err(FsError.from_raw_os(sys.macos.ENOENT, domain: .PosixErrno, op: .Env));
    }
    var canon_buf: [u8; sys.macos.DARWIN_MAXPATHLEN] = [0_u8; sys.macos.DARWIN_MAXPATHLEN];
    let canon_ptr: *mut u8 = unsafe {
        sys.macos.darwin_realpath(heap_buf.as_slice().as_ptr(), &raw mut canon_buf[0])
    };
    if not canon_ptr.is_null() {
        return .Ok(PathBuf.from(cstr_ptr_to_bytes(&raw canon_buf[0])));
    }
    .Ok(PathBuf.from(cstr_ptr_to_bytes(heap_buf.as_slice().as_ptr())))
}

/| Resolves `GetModuleFileNameW(null, …)` on Windows, doubling buffer capacity whenever truncated.
@cfg(target.os == "windows") @std_cap_boundary(clears: [ffi, unsafe_op])
fn host_current_exe() -> PathBuf!FsError {
    var stack_w: [u16; STACK_WCHAR_CAP] = [0_u16; STACK_WCHAR_CAP];
    let first_len: u32 = unsafe {
        sys.windows.win32_get_module_file_name_w(
            @default_init[*mut opaque](),
            &raw mut stack_w[0],
            STACK_WCHAR_CAP as u32,
        )
    };
    if first_len == 0_u32 {
        let err_code: u32 = unsafe {
            sys.windows.win32_get_last_error()
        };
        return .Err(FsError.from_raw_os(err_code as i32, domain: .Win32Error, op: .Env));
    }
    if (first_len as usize) < STACK_WCHAR_CAP {
        return .Ok(decode_wtf16_to_path_buf(subslice_u16(&stack_w, 0_usize, first_len as usize)));
    }

    var dyn_cap: usize = STACK_WCHAR_CAP * 2_usize;
    while dyn_cap <= MAX_PATH_GROW_UNITS {
        var heap_w = Vec[u16].with_capacity(dyn_cap);
        var i: usize = 0;
        while i < dyn_cap {
            heap_w.push(0_u16);
            i = i +% 1_usize;
        }
        let got_len: u32 = unsafe {
            sys.windows.win32_get_module_file_name_w(
                @default_init[*mut opaque](),
                heap_w.as_mut_slice().as_mut_ptr(),
                dyn_cap as u32,
            )
        };
        if got_len == 0_u32 {
            let err_code: u32 = unsafe {
                sys.windows.win32_get_last_error()
            };
            return .Err(FsError.from_raw_os(err_code as i32, domain: .Win32Error, op: .Env));
        }
        if (got_len as usize) < dyn_cap {
            return .Ok(
                decode_wtf16_to_path_buf(
                    subslice_u16(heap_w.as_slice(), 0_usize, got_len as usize),
                ),
            );
        }
        dyn_cap *= 2_usize;
    }
    .Err(FsError.from_kind(.InvalidFilename, op: .Env))
}

/| Returns `WASI_ERRNO_NOSYS` for `current_exe` on WASI Preview 1.
@cfg(target.os == "wasi")
fn host_current_exe() -> PathBuf!FsError =
    .Err(
        FsError.from_raw_os(sys.wasi.WASI_ERRNO_NOSYS as i32, domain: .WasiErrno, op: .Env),
    );

/| Returns `.Unsupported` for `current_exe` on freestanding targets.
@cfg(target.os == "freestanding")
fn host_current_exe() -> PathBuf!FsError = .Err(FsError.from_kind(.Unsupported, op: .Env));

// ----------------- Host Standard Directories ------------------
/| Filters `candidate` so only non-empty absolute host paths (`Path.is_absolute()`) are accepted.
fn filter_absolute_dir(candidate: own OptPathBuf, /) -> OptPathBuf {
    if candidate is .Some(dir_pb) and not dir_pb.is_empty() and dir_pb.as_path().is_absolute() {
        return .Some(dir_pb);
    }
    .None
}

/| Joins Windows `%HOMEDRIVE%` and `%HOMEPATH%`, requiring leading `'\\'` or `'/'` on `home_path` and an absolute result.
fn join_win32_home_drive_path(var drive_pb: own PathBuf, home_path: Path, /) -> OptPathBuf {
    if drive_pb.is_empty() {
        return .None;
    }
    let path_bytes: &[u8] = home_path.as_os_bytes();
    let first_sep: u8 = byte_at(path_bytes, 0_usize);
    if not path_bytes.is_empty() and (first_sep == b'\\' or first_sep == b'/') {
        drive_pb.push(home_path);
        if drive_pb.as_path().is_absolute() {
            return .Some(drive_pb);
        }
    }
    .None
}

/| Resolves `$HOME` (when non-empty and absolute) on Linux, macOS, and WASI.
@cfg(target.os == "linux" or target.os == "macos" or target.os == "wasi")
fn host_home_dir() -> OptPathBuf = filter_absolute_dir(host_var_os("HOME"));

/| Resolves `%USERPROFILE%` (when absolute) with `%HOMEDRIVE%` + `%HOMEPATH%` fallback on Windows.
@cfg(target.os == "windows")
fn host_home_dir() -> OptPathBuf {
    if filter_absolute_dir(host_var_os("USERPROFILE")) is .Some(profile_pb) {
        return .Some(profile_pb);
    }
    if host_var_os("HOMEDRIVE") is .Some(drive_pb) {
        if host_var_os("HOMEPATH") is .Some(path_pb) {
            return join_win32_home_drive_path(own drive_pb, path_pb.as_path());
        }
    }
    .None
}

/| Returns `.None` for `home_dir` on freestanding targets.
@cfg(target.os == "freestanding")
fn host_home_dir() -> OptPathBuf = .None;

/| Queries `HKCU\…\Explorer\User Shell Folders\<value_name_w>` + `ExpandEnvironmentStringsW` (`0` `shell32.dll`).
@std_cap_boundary(clears: [ffi, unsafe_op, blocking_sync])
fn query_win32_user_shell_folder(value_name_w: *u16, /) -> OptPathBuf {
    var reg_key: *mut opaque = @default_init[*mut opaque]();
    let open_rc: i32 = unsafe {
        sys.windows.win32_reg_open_key_ex_w(
            sys.windows.HKEY_CURRENT_USER_BITS as *mut opaque,
            (&WIN32_USER_SHELL_FOLDERS_SUBKEY_W).as_ptr(),
            0_u32,
            sys.windows.KEY_QUERY_VALUE,
            &raw mut reg_key,
        )
    };
    if open_rc != 0 or reg_key.is_null() {
        return .None;
    }
    defer {
        unsafe {
            _ = sys.windows.win32_reg_close_key(reg_key);
        }
    }

    var raw_w: [u16; STACK_WCHAR_CAP] = [0_u16; STACK_WCHAR_CAP];
    var reg_type: u32 = 0;
    var data_bytes = ((STACK_WCHAR_CAP - 1_usize) * @size_of[u16]()) as u32;
    let query_rc: i32 = unsafe {
        sys.windows.win32_reg_query_value_ex_w(
            reg_key,
            value_name_w,
            @default_init[*mut u32](),
            &raw mut reg_type,
            (&raw mut raw_w[0]) as *mut u8,
            &raw mut data_bytes,
        )
    };
    if query_rc != 0
        or (reg_type != sys.windows.REG_SZ and reg_type != sys.windows.REG_EXPAND_SZ)
        or data_bytes < 2_u32 {
        return .None;
    }

    var unit_len: usize = (data_bytes as usize) / @size_of[u16]();
    if unit_len >= STACK_WCHAR_CAP {
        unit_len = STACK_WCHAR_CAP - 1_usize;
    }
    while unit_len > 0_usize and u16_at(&raw_w, unit_len -% 1_usize) == 0_u16 {
        unit_len = unit_len -% 1_usize;
    }
    if unit_len == 0_usize {
        return .None;
    }
    write_u16_at(&mut raw_w, unit_len, 0_u16);

    if reg_type == sys.windows.REG_SZ {
        return .Some(decode_wtf16_to_path_buf(subslice_u16(&raw_w, 0_usize, unit_len)));
    }

    var exp_w: [u16; STACK_WCHAR_CAP] = [0_u16; STACK_WCHAR_CAP];
    let exp_len: u32 = unsafe {
        sys.windows.win32_expand_environment_strings_w(
            &raw raw_w[0],
            &raw mut exp_w[0],
            STACK_WCHAR_CAP as u32,
        )
    };
    if exp_len <= 1_u32 {
        return .None;
    }
    if (exp_len as usize) <= STACK_WCHAR_CAP {
        return .Some(
            decode_wtf16_to_path_buf(subslice_u16(&exp_w, 0_usize, (exp_len as usize) -% 1_usize)),
        );
    }

    let dyn_cap = exp_len as usize;
    if dyn_cap > MAX_PATH_GROW_UNITS {
        return .None;
    }
    var heap_exp = Vec[u16].with_capacity(dyn_cap);
    var i: usize = 0;
    while i < dyn_cap {
        heap_exp.push(0_u16);
        i = i +% 1_usize;
    }
    let retry_len: u32 = unsafe {
        sys.windows.win32_expand_environment_strings_w(
            &raw raw_w[0],
            heap_exp.as_mut_slice().as_mut_ptr(),
            dyn_cap as u32,
        )
    };
    if retry_len <= 1_u32 or (retry_len as usize) > dyn_cap {
        return .None;
    }
    .Some(
        decode_wtf16_to_path_buf(
            subslice_u16(heap_exp.as_slice(), 0_usize, (retry_len as usize) -% 1_usize),
        ),
    )
}

/| Resolves an XDG environment variable (when non-empty and absolute) or `$HOME/<fallback_rel>`.
fn resolve_xdg_or_home(xdg_key: str, fallback_rel: str, /) -> OptPathBuf {
    if filter_absolute_dir(host_var_os(xdg_key)) is .Some(xdg_pb) {
        return .Some(xdg_pb);
    }
    if host_home_dir() is .Some(var home_pb) {
        home_pb.push(fallback_rel);
        return .Some(home_pb);
    }
    .None
}

/| Resolves `cache_dir` on Linux and WASI (`$XDG_CACHE_HOME` if absolute, else `$HOME/.cache`).
@cfg(target.os == "linux" or target.os == "wasi")
fn host_cache_dir() -> OptPathBuf = resolve_xdg_or_home("XDG_CACHE_HOME", ".cache");

/| Resolves `cache_dir` on macOS (`$HOME/Library/Caches`).
@cfg(target.os == "macos")
fn host_cache_dir() -> OptPathBuf {
    if host_home_dir() is .Some(var home_pb) {
        home_pb.push("Library/Caches");
        return .Some(home_pb);
    }
    .None
}

/| Resolves `cache_dir` on Windows (`%LOCALAPPDATA%` fallback `User Shell Folders\Local AppData`).
@cfg(target.os == "windows")
fn host_cache_dir() -> OptPathBuf {
    if filter_absolute_dir(host_var_os("LOCALAPPDATA")) is .Some(local_pb) {
        return .Some(local_pb);
    }
    filter_absolute_dir(query_win32_user_shell_folder((&WIN32_REG_VAL_LOCAL_APPDATA_W).as_ptr()))
}

/| Returns `.None` for `cache_dir` on freestanding targets.
@cfg(target.os == "freestanding")
fn host_cache_dir() -> OptPathBuf = .None;

