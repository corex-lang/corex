/# Zero-Copy Streaming I/O, Scatter-Gather Slices, and Standard Streams (cx.io)
/#
/# Provides register-sized 8-byte `IoError`, zero-memset `OutBuf`, ABI-exact `IoSlice` and `IoSliceMut`,
/# vtable-erased `Reader` / `Writer` / `Seek` handles, non-generic `BufReader` (`48 B`) and `@linear BufWriter`
/# (`32 B`), stream adapters, and reactor-routed locked buffered `stdin` / `stdout` / `stderr` (`STD-02`).
/#
/# Every `IoError` packs into a single non-zero `u64` (`bit[0] == 0`, `swifterror`-ready with zero heap
/# allocations), and standard streams initialize lazily from zeroed `.tbss`/`.bss` memory with zero pre-`main` code.

use core.async.{
    IoSubmission,
    SIM_OP_STDIO_RW,
    SIM_UNHANDLED_SENTINEL,
};
use core.sys;
use cx.col.Vec;
use cx.fs.{
    file_sentinel_flush,
    file_sentinel_read_out,
    file_sentinel_read_vectored,
    file_sentinel_seek,
    file_sentinel_write,
    file_sentinel_write_vectored,
};
use cx.mem.{Arena, Layout, System};
use cx.str.{String, is_valid_utf8};

// ---------------------------------------- TYPES ----------------------------------------
// ------------------ IoError & Error Domains -------------------
/| Origin subsystem of an `IoError` raw status code (`STD-02` §1.2, §2.1).
@derive(Copy, Equatable, Hash, Clone, Debug)
pub enum ErrDomain {
    /| Synthetic library error without an underlying OS status code (`0`).
    Generic,
    /| POSIX `errno` (`libc` / kernel `1..`, `1`).
    PosixErrno,
    /| Windows Win32 `GetLastError` `DWORD` (`2`).
    Win32Error,
    /| Windows Native `NTSTATUS` code (`3`).
    NtStatus,
    /| WebAssembly WASI Preview 1 `__wasi_errno_t` (`4`).
    WasiErrno,
    /| Deterministic `--sim` `SimReactor` injected fault code (`5`).
    SimFault,
}

/| Normalized cross-platform I/O and filesystem failure classification (`sizeof(IoErrorKind?) == 1 B`).
@derive(Copy, Equatable, Hash, Clone, Debug)
pub enum IoErrorKind {
    /| Target file, directory, or executable does not exist.
    NotFound,
    /| Caller lacks permission or sandbox capability for the requested operation.
    PermissionDenied,
    /| Exclusive target already exists (`EEXIST` / `ERROR_ALREADY_EXISTS`).
    AlreadyExists,
    /| Non-blocking descriptor cannot complete immediately (`EAGAIN` / `WSAEWOULDBLOCK`).
    WouldBlock,
    /| System call was interrupted by signal delivery (`EINTR`).
    Interrupted,
    /| Operation exceeded its configured deadline (`ETIMEDOUT` / `WAIT_TIMEOUT`).
    TimedOut,
    /| Stream ended before satisfying the requested exact byte count.
    UnexpectedEof,
    /| Underlying sink accepted `0` bytes from a non-empty write buffer.
    WriteZero,
    /| Peer closed the read end of a pipe or stream (`EPIPE` / `ERROR_BROKEN_PIPE`).
    BrokenPipe,
    /| Caller supplied an invalid argument, offset, or configuration (`EINVAL`).
    InvalidInput,
    /| Stream bytes violated expected encoding or structural invariants (e.g., invalid UTF-8).
    InvalidData,
    /| Non-recursive directory removal targeted a non-empty directory (`ENOTEMPTY`).
    DirectoryNotEmpty,
    /| File operation targeted a directory inode (`EISDIR`).
    IsADirectory,
    /| Directory traversal or open targeted a non-directory inode (`ENOTDIR`).
    NotADirectory,
    /| Atomic rename or hardlink spanned distinct filesystem mounts (`EXDEV`).
    CrossesDevices,
    /| Symlink chain looped or violated `RESOLVE_BENEATH` / `O_NOFOLLOW_ANY` (`ELOOP`).
    FilesystemLoop,
    /| Advisory lock acquisition conflicted with an active holder (`EWOULDBLOCK` / `ERROR_LOCK_VIOLATION`).
    FileLockConflict,
    /| Target resource is busy or locked by a concurrent share-mode violation (`EBUSY` / `ERROR_SHARING_VIOLATION`).
    ResourceBusy,
    /| Backing storage volume or quota has no remaining space (`ENOSPC` / `ERROR_DISK_FULL`).
    StorageFull,
    /| Stream or delimiter scan exceeded the caller's `max_bytes` / buffer cap.
    StreamTooLong,
    /| Implicit `.bat` or `.cmd` batch execution was rejected (`CVE-2024-24576` defense).
    InvalidScriptExtension,
    /| Operation is unsupported by the target OS, filesystem, or WASI sandbox (`ENOSYS` / `ENOTSUP`).
    Unsupported,
    /| Operation was canceled via `CancelToken` or asynchronous abort (`ECANCELED`).
    Canceled,
    /| Kernel or allocator ran out of memory (`ENOMEM` / `ERROR_NOT_ENOUGH_MEMORY`).
    OutOfMemory,
    /| Path or filename contains illegal characters, interior NULs, or exceeds component length limits.
    InvalidFilename,
    /| Mutating operation targeted a read-only mount (`EROFS` / `ERROR_WRITE_PROTECT`).
    ReadOnlyFilesystem,
    /| Process `argv` or environment block exceeded OS limits (`E2BIG`).
    ArgumentListTooLong,
    /| Unclassified host error preserved lossless inside `IoError.os_error()`.
    Other,
}

/| Operation tag recorded inside `IoError` for zero-allocation contextual diagnostics (`STD-02` §2.1).
@derive(Copy, Equatable, Hash, Clone, Debug)
pub enum IoOp {
    /| Unspecified I/O operation (`0`).
    None,
    /| Sequential or positional stream/file read (`1`).
    Read,
    /| Sequential, positional, or vectored stream/file write (`2`).
    Write,
    /| Buffered or device flush (`3`).
    Flush,
    /| Stream cursor seek (`4`).
    Seek,
    /| File or directory open/create (`5`).
    Open,
    /| Metadata stat or attribute query (`6`).
    Stat,
    /| Canonical physical path resolution (`7`).
    Resolve,
    /| Atomic or standard path rename (`8`).
    Rename,
    /| File or directory unlink/removal (`9`).
    Unlink,
    /| Directory creation (`10`).
    Mkdir,
    /| Directory entry enumeration (`11`).
    Readdir,
    /| Reflink, hardlink, or file copy materialization (`12`).
    Clone,
    /| Read-only memory map setup or teardown (`13`).
    Mmap,
    /| Advisory file lock acquisition or release (`14`).
    Lock,
    /| Filesystem change watcher registration or poll (`15`).
    Watch,
    /| Child process spawn (`16`).
    Spawn,
    /| Child process wait or signal (`17`).
    Wait,
    /| Process environment or working-directory lookup/mutation (`18`).
    Env,
}

/| Exact 64-bit bitfield layout of inline `IoError` words (`2 + 6 + 8 + 8 + 8 + 32 == 64` bits).
@derive(Copy, Equatable)
pub bit_field IoErrorBits: u64 {
    /| Low 2-bit discriminant (`0b10` = inline OS/kind error with `bit[0] == 0`).
    pub tag: u8 | 2,
    /| Encoded `ErrDomain` code (`0..=5`).
    pub domain: u8 | 6,
    /| Encoded `IoErrorKind` code (`0..=255`).
    pub kind: u8 | 8,
    /| Encoded `IoOp` code (`0..=18`).
    pub op: u8 | 8,
    /| Optional thread-local `Context.diagnostics` path-ring slot index (`0` when unused).
    pub diag_slot: u8 | 8,
    /| Unmodified 32-bit OS error code (`errno`, Win32 `DWORD`, `NTSTATUS`, or `__wasi_errno_t`).
    pub raw_code: u32 | 32,
}

/| Register-sized 8-byte I/O error (`swifterror`-compatible, `packed_repr >= 2`, `bit[0] == 0`, `0` heap allocs).
@repr(C) @derive(Copy, Equatable, Hash)
pub struct IoError {
    /| Non-zero even 64-bit payload (`tag == 0b10` for inline errors; `0` and `1` reserved as niches).
    pub(pkg) packed_repr: u64 is 2..=u64.MAX,
}

// ------------------ OutBuf & Vectored Slices ------------------
/| Write-only cursor over uninitialized or mutable bytes preventing uninitialized reads in safe code (`STD-02` §1.1).
@repr(C)
pub struct OutBuf {
    /| Base pointer to the backing byte region (`0..filled_bytes` initialized, `filled_bytes..cap` uninitialized).
    ptr: *mut u8,
    /| Total byte capacity of `ptr`.
    cap: usize,
    /| Monotonic count of initialized bytes in `0..=cap`.
    filled_bytes: usize,
}

/| Win64 `WSABUF`-exact immutable slice representation (`16 B`: `u32` length + pad + pointer).
@repr(C) @derive(Copy)
struct WinIoSliceRaw {
    /| Byte length clamped to `u32.MAX` matching `WSABUF.len`.
    len_u32: u32,
    /| Explicit 4-byte Win64 alignment padding before `WSABUF.buf` (`0`).
    _pad: u32 = 0,
    /| Read-only byte buffer pointer (`WSABUF.buf`).
    ptr: *u8,
}

/| POSIX `struct iovec` (`16 B`) and WASI `ciovec` (`8 B`) immutable slice representation.
@repr(C) @derive(Copy)
struct PosixIoSliceRaw {
    /| Read-only byte buffer pointer (`iov_base` / `buf`).
    ptr: *u8,
    /| Byte length of `ptr` (`iov_len` / `buf_len`).
    len_usize: usize,
}

/| Active target ABI layout for `IoSlice` (`WinIoSliceRaw` on Windows).
@cfg(target.os == "windows")
type ActiveIoSliceRaw = WinIoSliceRaw;

/| Active target ABI layout for `IoSlice` (`PosixIoSliceRaw` on POSIX and WASI).
@cfg(not (target.os == "windows"))
type ActiveIoSliceRaw = PosixIoSliceRaw;

/| Scatter-gather immutable byte slice ABI-identical to Win64 `WSABUF`, POSIX `iovec`, and WASI `ciovec`.
@repr(C) @derive(Copy)
pub struct IoSlice {
    /| Target-exact `WSABUF` or `iovec` / `ciovec` fields.
    raw: ActiveIoSliceRaw,
}

/| Win64 `WSABUF`-exact mutable slice representation (`16 B`: `u32` length + pad + pointer).
@repr(C)
struct WinIoSliceMutRaw {
    /| Byte length clamped to `u32.MAX` matching `WSABUF.len`.
    len_u32: u32,
    /| Explicit 4-byte Win64 alignment padding before `WSABUF.buf` (`0`).
    _pad: u32 = 0,
    /| Mutable byte buffer pointer (`WSABUF.buf`).
    ptr: *mut u8,
}

/| POSIX and WASI `iovec` mutable slice representation (`16 B` on 64-bit, `8 B` on `wasm32`).
@repr(C)
struct PosixIoSliceMutRaw {
    /| Mutable byte buffer pointer (`iov_base` / `buf`).
    ptr: *mut u8,
    /| Byte length of `ptr` (`iov_len` / `buf_len`).
    len_usize: usize,
}

/| Active target ABI layout for `IoSliceMut` (`WinIoSliceMutRaw` on Windows).
@cfg(target.os == "windows")
type ActiveIoSliceMutRaw = WinIoSliceMutRaw;

/| Active target ABI layout for `IoSliceMut` (`PosixIoSliceMutRaw` on POSIX and WASI).
@cfg(not (target.os == "windows"))
type ActiveIoSliceMutRaw = PosixIoSliceMutRaw;

/| Scatter-gather mutable byte slice ABI-identical to Win64 `WSABUF` and POSIX/WASI `iovec` (non-`Copy`).
@repr(C)
pub struct IoSliceMut {
    /| Target-exact `WSABUF` or `iovec` fields.
    raw: ActiveIoSliceMutRaw,
}

/| Cursor origin and signed/unsigned offset for `Seek.seek` (`STD-02` §2.1).
@derive(Copy, Equatable, Hash, Clone, Debug)
pub enum SeekFrom {
    /| Absolute byte offset relative to stream byte `0`.
    Start(u64),
    /| Signed byte offset relative to the end of the stream.
    End(i64),
    /| Signed byte offset relative to the current stream position.
    Current(i64),
}

// ------------------ Stream Handles & VTables ------------------
/| Function-pointer dispatch table for `Seek` (`STD-02` §2.1).
@repr(C)
pub struct SeekVTable {
    /| Repositions `ctx` according to `pos` and returns the resulting absolute byte offset.
    pub seek: fn(*mut opaque, SeekFrom) -> u64!IoError,
}

/| Type-erased `Copy` stream seeker (`16 B` on 64-bit, `8 B` on `wasm32`; `sizeof(Seek?) == sizeof(Seek)`).
@repr(C) @derive(Copy)
pub struct Seek {
    /| Borrowed mutable stream state pointer.
    pub(pkg) ctx: *mut opaque,
    /| Non-null static dispatch table (`0x0` niche reserved for `Seek?`).
    @non_null
    pub(pkg) vtable: *SeekVTable,
}

/| Function-pointer dispatch table for `Reader` (`STD-02` §2.1).
@repr(C)
pub struct ReaderVTable {
    /| Reads available bytes into uninitialized `out`, advancing `out` and returning bytes read (`0` on EOF).
    pub read_out: fn(*mut opaque, &mut OutBuf) -> usize!IoError,
    /| Optional scatter read implementation (`read_vectored` falls back to first non-empty buffer when `.None`).
    pub read_vectored: (fn(*mut opaque, &mut [IoSliceMut]) -> usize!IoError)? = .None,
    /| Optional fast skip/seek implementation (`discard` falls back to stack `OutBuf` draining when `.None`).
    pub discard: (fn(*mut opaque, u64) -> u64!IoError)? = .None,
}

/| Type-erased `Copy` input stream (`16 B` on 64-bit, `8 B` on `wasm32`; `sizeof(Reader?) == sizeof(Reader)`).
@repr(C) @derive(Copy)
pub struct Reader {
    /| Borrowed mutable reader state pointer (or immediate byte value for `Reader.repeat`).
    pub(pkg) ctx: *mut opaque,
    /| Non-null static dispatch table (`0x0` niche reserved for `Reader?`).
    @non_null
    pub(pkg) vtable: *ReaderVTable,
}

/| Function-pointer dispatch table for `Writer` (`STD-02` §2.1).
@repr(C)
pub struct WriterVTable {
    /| Writes a non-empty prefix of `buf` into `ctx` and returns the byte count accepted.
    pub write: fn(*mut opaque, &[u8]) -> usize!IoError,
    /| Optional gather write implementation (`write_vectored` writes first non-empty slice when `.None`).
    pub write_vectored: (fn(*mut opaque, &[IoSlice]) -> usize!IoError)? = .None,
    /| Optional buffered or device flush callback (`.Ok(())` no-op when `.None`).
    pub flush: (fn(*mut opaque) -> unit!IoError)? = .None,
}

/| Type-erased `Copy` output stream (`16 B` on 64-bit, `8 B` on `wasm32`; `sizeof(Writer?) == sizeof(Writer)`).
@repr(C) @derive(Copy)
pub struct Writer {
    /| Borrowed mutable writer state pointer.
    pub(pkg) ctx: *mut opaque,
    /| Non-null static dispatch table (`0x0` niche reserved for `Writer?`).
    @non_null
    pub(pkg) vtable: *WriterVTable,
}

/| Stack-resident `512 B` coalescing bridge adapting `Writer` to `FmtWriter` with zero heap allocations.
@repr(C)
struct WriterFmtBridge {
    /| Target `Writer` receiving coalesced chunks.
    target: *mut Writer,
    /| Stack scratch buffer batching small format pieces and scalar digits.
    scratch: [u8; 512],
    /| Active byte count in `scratch` (`0..=512`).
    filled: usize,
    /| Exact `IoError` preserved across `FmtError.IoFailure` return edges.
    sticky_err: IoError?,
}

// ---------------- Buffered Streams & Adapters -----------------
/| Non-generic `48 B` (64-bit) buffered reader hoisting the active window above `Reader` (`AutoDrop` frees `System` buf).
@repr(C)
pub struct BufReader {
    /| Upstream unbuffered `Reader` handle.
    upstream: Reader,
    /| Backing buffer pointer (`16 B`-aligned when owned from `cx.mem.System`).
    buf_ptr: *mut u8,
    /| Capacity in `bits 0..BITS-1`; MSB (`BUF_READER_OWNS_SYS_MASK`) marks `System`-owned buffer.
    cap_and_flag: usize,
    /| Start index of unconsumed bytes within `0..=filled`.
    pos: usize,
    /| Exclusive end index of valid bytes read from `upstream` within `0..=capacity()`.
    filled: usize,
}

/| Non-generic `32 B` (64-bit) `@linear` buffered writer requiring explicit `close` or `discard` (`E0304`).
@repr(C) @linear
pub struct BufWriter {
    /| Downstream unbuffered `Writer` handle.
    downstream: Writer,
    /| Backing buffer pointer (`16 B`-aligned when owned from `cx.mem.System`).
    buf_ptr: *mut u8,
    /| Count of unflushed bytes currently buffered in `0..=capacity()`.
    filled: u32,
    /| `bits 0..29` = capacity; `bit 30` = `OWNS_SYSTEM_BUF`; `bit 31` = `LINE_BUFFERED`.
    cap_and_flags: u32,
}

/| Zero-allocation `FmtWriter` adapter streaming `FmtArgs` directly into `BufWriter.buf_ptr`.
@repr(C)
struct BufWriterFmtBridge {
    /| Target `BufWriter` receiving formatted pieces.
    target: *mut BufWriter,
    /| Exact `IoError` captured if a flush fails mid-format.
    sticky_err: IoError?,
}

/| Adapter capping total bytes read from an upstream `Reader` at `remaining_bytes` (`STD-02` §2.1).
@repr(C)
pub struct LimitReader {
    /| Wrapped upstream `Reader`.
    upstream: Reader,
    /| Maximum unread byte budget remaining before synthetic EOF (`0`).
    remaining_bytes: u64,
}

/| In-memory `Reader` and `Seek` cursor over an immutable byte slice `&[u8]` (`STD-02` §2.1).
@repr(C)
pub struct ByteReader {
    /| Backing read-only byte slice.
    data: &[u8],
    /| Current read cursor offset (`may exceed data.len()` after `Seek`, yielding `0` on `read_out`).
    pos: usize = 0,
}

/| Fixed-capacity in-memory `Writer` and `Seek` cursor over a mutable byte slice `&mut [u8]` (`STD-02` §2.1).
@repr(C)
pub struct SliceWriter {
    /| Backing mutable byte buffer pointer.
    ptr: *mut u8,
    /| Total byte capacity of `ptr`.
    cap: usize,
    /| Current write cursor offset in `0..=cap`.
    pos: usize = 0,
}

// ------------------ Locked Standard Streams -------------------
/| C-ABI callback signature for `ReactorVTable.submit_io` (`slot 3` of `ReactorVTable`).
type ReactorSubmitFn = extern "C" fn(ctx: *mut opaque, sub: *IoSubmission) -> i64;

/| Lazily mapped `24 KiB` standard-stream buffer slab (`0` pre-`main` constructors, `0` cost when unused).
@repr(C, align: 16)
struct StdioSlab {
    /| `8 KiB` buffered `stdin` window preserved across `StdinLock` acquisitions.
    stdin_buf: [u8; 8_192],
    /| Saved `stdin` read offset in `0..=stdin_filled`.
    stdin_pos: usize,
    /| Saved `stdin` valid byte count in `0..=8192`.
    stdin_filled: usize,
    /| `8 KiB` buffered `stdout` window.
    stdout_buf: [u8; 8_192],
    /| Saved `stdout` buffered byte count in `0..=8192`.
    stdout_filled: u32,
    /| `8 KiB` buffered `stderr` coalescing window.
    stderr_buf: [u8; 8_192],
    /| Saved `stderr` buffered byte count in `0..=8192`.
    stderr_filled: u32,
}

/| `24 B` zero-initialized control block residing in `@tls_alloc_state()` bytes `224..248` (`0` pre-`main` init).
@repr(C, align: 8)
struct StdioTlsHeader {
    /| Lazily mapped `StdioSlab` (`null` until first `stdin_locked` / `stdout_locked` / `stderr_locked`).
    slab_ptr: *mut StdioSlab,
    /| Atomic reentrancy/spin lock byte for `stdin` (`0` = unlocked, `1` = locked).
    stdin_lock: u8,
    /| Atomic reentrancy/spin lock byte for `stdout` (`0` = unlocked, `1` = locked).
    stdout_lock: u8,
    /| Atomic reentrancy/spin lock byte for `stderr` (`0` = unlocked, `1` = locked).
    stderr_lock: u8,
    /| Cached TTY probe state (`0` = unprobed, `1` = pipe/file block-buffered, `3` = TTY line-buffered).
    tty_state: u8,
    /| Emergency `8 B` inline buffer used if `System.alloc_pages` fails under simulated OOM.
    emergency_buf: [u8; 8],
}

/| `@linear` exclusive guard over buffered standard input (`fd = 0`; must call `.release()`, `E0304`).
@linear
pub struct StdinLock {
    /| Buffered `stdin` reader (`8 KiB` window).
    inner_reader: BufReader,
    /| Encoded pointer to the owning `StdioTlsHeader` control block (`0` when detached).
    lock_token: usize,
}

/| `@linear` exclusive guard over buffered standard output or standard error (`must` release/flush, `E0304`).
@linear
pub struct StdoutLock {
    /| Buffered `stdout`/`stderr` writer (`8 KiB` window; auto-line-buffered on TTY for `stdout`).
    inner_writer: BufWriter,
    /| Encoded `(header_addr | stream_tag)` (`bit 0`: `0` = `stdout`, `1` = `stderr`).
    lock_token: usize,
}

/| Canonical `@linear` guard alias for locked buffered standard error (`fd = 2`).
pub type StderrLock = StdoutLock;

// --------------------------------------- CONSTS ----------------------------------------
/| Default `8 KiB` (`8,192 B`) buffer size for `BufReader`, `BufWriter`, `copy_stream`, and `stdio`.
pub const DEFAULT_IO_BUF_SIZE: usize = 8_192;

/| Default `1 MiB` (`1,048,576 B`) safety cap for `BufReader.read_until_into`.
const DEFAULT_READ_UNTIL_MAX: usize = 1_048_576;

/| Inline tag `0b10` (`2`) keeping `IoError.packed_repr >= 2` and `bit[0] == 0`.
const IO_ERR_INLINE_TAG: u8 = 2_u8;

/| `BufReader.cap_and_flag` MSB bit indicating `buf_ptr` was allocated from `cx.mem.System`.
const BUF_READER_OWNS_SYS_MASK: usize = ~(usize.MAX >> 1_usize);

/| `BufReader.cap_and_flag` low-bits capacity mask.
const BUF_READER_CAP_MASK: usize = usize.MAX >> 1_usize;

/| `BufWriter.cap_and_flags` `30`-bit capacity mask (`bits 0..29`, up to `1 GiB - 1`).
const BUF_WRITER_CAP_MASK: u32 = 0x3FFF_FFFF_u32;

/| `BufWriter.cap_and_flags` bit `30` indicating `buf_ptr` was allocated from `cx.mem.System`.
const BUF_WRITER_OWNS_SYS_FLAG: u32 = 0x4000_0000_u32;

/| `BufWriter.cap_and_flags` bit `31` enabling automatic flush on `b'\n'`.
const BUF_WRITER_LINE_BUF_FLAG: u32 = 0x8000_0000_u32;

/| Alignment (`16 B`) used for `System`-owned `BufReader` / `BufWriter` buffers.
const OWNED_IO_BUF_ALIGN: usize = 16;

/| Byte offset (`224`) inside the `256 B` `@tls_alloc_state()` block reserved for `StdioTlsHeader`.
const STDIO_TLS_OFFSET: usize = 224;

/| Low-bit tag on `StdoutLock.lock_token` distinguishing `stderr` (`1`) from `stdout` (`0`).
const STDIO_TOKEN_STDERR_BIT: usize = 1;

/| SWAR `0x01` broadcast multiplier for 8-byte parallel byte search on `wasm32` and tails.
const SWAR_ONES_U64: u64 = 0x0101_0101_0101_0101_u64;

/| SWAR `0x80` high-bit lane mask for 8-byte parallel zero-byte detection.
const SWAR_HIGHS_U64: u64 = 0x8080_8080_8080_8080_u64;

/| Static `.rodata` empty byte slice avoiding stack array materialization on `E0306` return edges.
const EMPTY_BYTES: &[u8] = b"";

/| Non-null odd `Reader.vtable` sentinel (`0x1`) identifying `Reader.empty()` (`@align_of[ReaderVTable]() >= 4`).
const READER_SENTINEL_EMPTY: usize = 1_usize;

/| Non-null odd `Reader.vtable` sentinel (`0x3`) identifying `Reader.repeat(byte_val)`.
const READER_SENTINEL_REPEAT: usize = 3_usize;

/| Non-null odd `Reader.vtable` sentinel (`0x5`) identifying `BufReader.as_reader()`.
const READER_SENTINEL_BUF: usize = 5_usize;

/| Non-null odd `Reader.vtable` sentinel (`0x7`) identifying `LimitReader.as_reader()`.
const READER_SENTINEL_LIMIT: usize = 7_usize;

/| Non-null odd `Reader.vtable` sentinel (`0x9`) identifying `ByteReader.as_reader()`.
const READER_SENTINEL_BYTES: usize = 9_usize;

/| Non-null odd `Reader.vtable` sentinel (`0xB`) identifying `stdin` (`fd = 0`).
const READER_SENTINEL_STDIN: usize = 11_usize;

/| Non-null odd `Reader.vtable` sentinel (`0xD`) identifying `cx.fs.File.as_reader()`.
pub(super) const READER_SENTINEL_FILE: usize = 13_usize;

/| Non-null odd `Writer.vtable` sentinel (`0x1`) identifying `Writer.sink()` (`@align_of[WriterVTable]() >= 4`).
const WRITER_SENTINEL_SINK: usize = 1_usize;

/| Non-null odd `Writer.vtable` sentinel (`0x3`) identifying `BufWriter.as_writer()`.
const WRITER_SENTINEL_BUF: usize = 3_usize;

/| Non-null odd `Writer.vtable` sentinel (`0x5`) identifying `SliceWriter.as_writer()`.
const WRITER_SENTINEL_SLICE: usize = 5_usize;

/| Non-null odd `Writer.vtable` sentinel (`0x7`) identifying `stdout` / `stderr` (`fd = 1, 2`).
const WRITER_SENTINEL_STDIO: usize = 7_usize;

/| Non-null odd `Writer.vtable` sentinel (`0x9`) identifying `cx.fs.File.as_writer()`.
pub(super) const WRITER_SENTINEL_FILE: usize = 9_usize;

/| Non-null odd `Seek.vtable` sentinel (`0x1`) identifying `ByteReader.as_seeker()` (`@align_of[SeekVTable]() >= 4`).
const SEEK_SENTINEL_BYTES: usize = 1_usize;

/| Non-null odd `Seek.vtable` sentinel (`0x3`) identifying `SliceWriter.as_seeker()`.
const SEEK_SENTINEL_SLICE: usize = 3_usize;

/| Non-null odd `Seek.vtable` sentinel (`0x5`) identifying `cx.fs.File.as_seeker()`.
pub(super) const SEEK_SENTINEL_FILE: usize = 5_usize;

// -------------------------------------- INTERNALS --------------------------------------
// ------------- Target IoSlice Layout Projections --------------
impl WinIoSliceRaw {
    /| Constructs a Win64 `WSABUF`-compatible descriptor clamping `slice.len()` to `u32.MAX`.
    fn from_slice(slice: &[u8], /) -> WinIoSliceRaw {
        let clamped_len: u32 = if slice.len() > (u32.MAX as usize) => u32.MAX
            else slice.len() as u32;
        WinIoSliceRaw {
            len_u32: clamped_len,
            _pad: 0_u32,
            ptr: slice.as_ptr(),
        }
    }

    /| Returns the underlying read-only byte pointer.
    fn raw_ptr(self) -> *u8 = self.ptr;

    /| Returns the clamped byte length as `usize`.
    fn raw_len(self) -> usize = self.len_u32 as usize;
}

impl PosixIoSliceRaw {
    /| Constructs a POSIX `iovec` / WASI `ciovec`-compatible descriptor.
    fn from_slice(slice: &[u8], /) -> PosixIoSliceRaw {
        PosixIoSliceRaw {
            ptr: slice.as_ptr(),
            len_usize: slice.len(),
        }
    }

    /| Returns the underlying read-only byte pointer.
    fn raw_ptr(self) -> *u8 = self.ptr;

    /| Returns the byte length as `usize`.
    fn raw_len(self) -> usize = self.len_usize;
}

impl WinIoSliceMutRaw {
    /| Constructs a Win64 `WSABUF`-compatible mutable descriptor clamping `slice.len()` to `u32.MAX`.
    fn from_slice(slice: &mut [u8], /) -> WinIoSliceMutRaw {
        let clamped_len: u32 = if slice.len() > (u32.MAX as usize) => u32.MAX
            else slice.len() as u32;
        WinIoSliceMutRaw {
            len_u32: clamped_len,
            _pad: 0_u32,
            ptr: slice.as_mut_ptr(),
        }
    }

    /| Returns the underlying mutable byte pointer.
    fn raw_ptr(&self) -> *mut u8 = self.ptr;

    /| Returns the clamped byte length as `usize`.
    fn raw_len(&self) -> usize = self.len_u32 as usize;
}

impl PosixIoSliceMutRaw {
    /| Constructs a POSIX / WASI `iovec`-compatible mutable descriptor.
    fn from_slice(slice: &mut [u8], /) -> PosixIoSliceMutRaw {
        PosixIoSliceMutRaw {
            ptr: slice.as_mut_ptr(),
            len_usize: slice.len(),
        }
    }

    /| Returns the underlying mutable byte pointer.
    fn raw_ptr(&self) -> *mut u8 = self.ptr;

    /| Returns the byte length as `usize`.
    fn raw_len(&self) -> usize = self.len_usize;
}

// ------------------ SIMD & SWAR Byte Search -------------------
/| Scans `haystack` for the first `needle` byte using `16 B` SIMD (`x86_64` / `aarch64`) + `8 B` SWAR tail.
@cfg(target.arch == "x86_64" or target.arch == "aarch64")
@std_cap_boundary(clears: [unsafe_op, may_panic])
fn find_byte_fast(haystack: &[u8], needle: u8, /) -> usize? {
    let total: usize = haystack.len();
    if total == 0_usize {
        return .None;
    }
    let base_ptr: *u8 = haystack.as_ptr();
    var idx = 0_usize;
    if total >= 16_usize {
        let needle_vec: [u8; 16] = @simd_splat[[u8; 16]](needle);
        while idx <= total -% 16_usize {
            let chunk_vec: [u8; 16] = unsafe {
                @simd_load_unaligned[[u8; 16]](base_ptr.add(idx))
            };
            let mask_bits: u16 = @simd_bitmask(@simd_eq(chunk_vec, needle_vec));
            if mask_bits != 0_u16 {
                return .Some(idx +% (mask_bits.trailing_zeros() as usize));
            }
            idx = idx +% 16_usize;
        }
    }
    find_byte_swar_tail(haystack, needle, idx)
}

/| Scans `haystack` for the first `needle` byte on `wasm32` and portable targets using `8 B` SWAR.
@cfg(not (target.arch == "x86_64" or target.arch == "aarch64"))
@std_cap_boundary(clears: [unsafe_op, may_panic])
fn find_byte_fast(haystack: &[u8], needle: u8, /) -> usize? {
    find_byte_swar_tail(haystack, needle, 0_usize)
}

/| Shared 8-byte SWAR + scalar tail scanner locating `needle` in `haystack[idx..]`.
@std_cap_boundary(clears: [unsafe_op, may_panic])
fn find_byte_swar_tail(haystack: &[u8], needle: u8, var idx: usize, /) -> usize? {
    let total: usize = haystack.len();
    let base_ptr: *u8 = haystack.as_ptr();
    if idx +% 8_usize <= total {
        let broadcast: u64 = (needle as u64) *% SWAR_ONES_U64;
        while idx <= total -% 8_usize {
            var word = 0_u64;
            unsafe {
                @memcpy((&raw mut word) as *mut opaque, base_ptr.add(idx) as *opaque, 8_usize);
            }
            let xored: u64 = word ^ broadcast;
            let zero_mask: u64 = (xored -% SWAR_ONES_U64) & (~xored) & SWAR_HIGHS_U64;
            if zero_mask != 0_u64 {
                return .Some(idx +% ((zero_mask.trailing_zeros() >> 3_u32) as usize));
            }
            idx = idx +% 8_usize;
        }
    }
    while idx < total {
        if haystack[idx] == needle {
            return .Some(idx);
        }
        idx += 1_usize;
    }
    .None
}

/| Scans `haystack` from the end and returns the index of the last occurrence of `needle`.
@std_cap_boundary(clears: [may_panic])
fn rfind_byte(haystack: &[u8], needle: u8, /) -> usize? {
    let total: usize = haystack.len();
    var idx: usize = total;
    while idx > 0_usize {
        idx -= 1_usize;
        if idx < total and haystack[idx] == needle {
            return .Some(idx);
        }
    }
    .None
}

/| Packs `IoErrorBits` into a range-refined `IoError` (`tag == 0b10` -> `packed_repr >= 2`, `@no_panic`).
fn pack_io_error_bits(bits: IoErrorBits, /) -> IoError {
    let raw_word: u64 = (@bit_cast[u64](bits) & ~3_u64) | 2_u64;
    IoError {
        packed_repr: raw_word.narrow[u64 is 2..=u64.MAX](),
    }
}

/| Maps canonical Linux/POSIX fault numbers to `IoErrorKind` identically across all host and target OSes.
fn map_sim_fault_code(code: i32, /) -> IoErrorKind {
    match code {
        1 => .PermissionDenied,
        2 => .NotFound,
        4 => .Interrupted,
        7 => .ArgumentListTooLong,
        9 => .InvalidInput,
        11 => .WouldBlock,
        12 => .OutOfMemory,
        13 => .PermissionDenied,
        16 => .ResourceBusy,
        17 => .AlreadyExists,
        18 => .CrossesDevices,
        19 => .Unsupported,
        20 => .NotADirectory,
        21 => .IsADirectory,
        22 => .InvalidInput,
        27 => .StorageFull,
        28 => .StorageFull,
        29 => .InvalidInput,
        30 => .ReadOnlyFilesystem,
        32 => .BrokenPipe,
        35 => .FileLockConflict,
        36 => .InvalidFilename,
        38 => .Unsupported,
        39 => .DirectoryNotEmpty,
        40 => .FilesystemLoop,
        84 => .InvalidData,
        95 => .Unsupported,
        110 => .TimedOut,
        125 => .Canceled,
        _ => .Other,
    }
}

/| Computes the new stream cursor offset for `SeekFrom` against `(cur_pos, end_len)` with overflow checks.
fn compute_seek_offset(cur_pos: u64, end_len: u64, origin: SeekFrom, /) -> u64!IoError {
    match origin {
        .Start(abs_off) => .Ok(abs_off),
        .Current(rel_delta) => apply_signed_seek_delta(cur_pos, rel_delta),
        .End(end_delta) => apply_signed_seek_delta(end_len, end_delta),
    }
}

/| Adds signed `delta` to `base`, failing with `IoErrorKind.InvalidInput` on negative or `u64` overflow.
fn apply_signed_seek_delta(base: u64, delta: i64, /) -> u64!IoError {
    if delta >= 0_i64 {
        let add_u64 = delta as u64;
        if add_u64 > u64.MAX -% base {
            return .Err(IoError.from_kind(.InvalidInput, op: .Seek));
        }
        return .Ok(base +% add_u64);
    }
    let mag_u64: u64 = (0_u64 -% @bit_cast[u64](delta));
    if mag_u64 > base {
        return .Err(IoError.from_kind(.InvalidInput, op: .Seek));
    }
    .Ok(base -% mag_u64)
}

/| Clamps a `u64` byte budget down to `usize` without truncating on `32`-bit `wasm32`.
fn clamp_u64_to_usize(val: u64, /) -> usize {
    if val > (usize.MAX as u64) => usize.MAX else val as usize
}

// ----------------- VTable Callbacks & Bridges -----------------
/| `Reader.empty()` `read_out` callback always returning `0` (EOF).
fn empty_read_out_cb(ctx: *mut opaque, out: &mut OutBuf) -> usize!IoError {
    _ = ctx;
    _ = out;
    .Ok(0_usize)
}

/| `Reader.empty()` `read_vectored` callback always returning `0` (EOF).
fn empty_read_vectored_cb(ctx: *mut opaque, bufs: &mut [IoSliceMut]) -> usize!IoError {
    _ = ctx;
    _ = bufs;
    .Ok(0_usize)
}

/| `Reader.empty()` `discard` callback always returning `0`.
fn empty_discard_cb(ctx: *mut opaque, bytes: u64) -> u64!IoError {
    _ = ctx;
    _ = bytes;
    .Ok(0_u64)
}

/| `Reader.repeat(byte_val)` `read_out` callback filling `out` with `(ctx as usize) as u8`.
@std_cap_boundary(clears: [unsafe_op])
fn repeat_read_out_cb(ctx: *mut opaque, out: &mut OutBuf) -> usize!IoError {
    let (dst_ptr, rem_len) = out.unfilled_raw();
    if rem_len > 0_usize {
        let fill_byte = ((ctx as usize) & 0xFF_usize) as u8;
        unsafe {
            @memset(dst_ptr as *mut opaque, fill_byte, rem_len);
            out.advance_init(rem_len);
        }
    }
    .Ok(rem_len)
}

/| `Reader.repeat(byte_val)` `discard` callback advancing `bytes` in `O(1)`.
fn repeat_discard_cb(ctx: *mut opaque, bytes: u64) -> u64!IoError {
    _ = ctx;
    .Ok(bytes)
}

/| `Writer.sink()` `write` callback accepting all `buf.len()` bytes.
fn sink_write_cb(ctx: *mut opaque, buf: &[u8]) -> usize!IoError {
    _ = ctx;
    .Ok(buf.len())
}

/| `Writer.sink()` `write_vectored` callback accepting the saturating sum of all `IoSlice` lengths.
fn sink_write_vectored_cb(ctx: *mut opaque, bufs: &[IoSlice]) -> usize!IoError {
    _ = ctx;
    var total = 0_usize;
    for slice in bufs {
        total = total +| slice.len();
    }
    .Ok(total)
}

/| `Writer.sink()` `flush` no-op callback.
fn sink_flush_cb(ctx: *mut opaque) -> unit!IoError {
    _ = ctx;
    .Ok(())
}

/| `FmtWriter` callback batching formatted chunks into `WriterFmtBridge.scratch` (`512 B` stack buffer).
@std_cap_boundary(clears: [unsafe_op])
fn writer_fmt_bridge_cb(ctx: *mut opaque, chunk: &[u8]) -> unit!FmtError {
    let bridge_ptr = ctx as *mut WriterFmtBridge;
    if bridge_ptr.is_null() {
        return .Ok(());
    }
    if chunk.is_empty() {
        return .Ok(());
    }
    let bridge: &mut WriterFmtBridge = unsafe {
        &mut bridge_ptr.*
    };
    let target_ptr: *mut Writer = bridge.target;
    if target_ptr.is_null() {
        return .Ok(());
    }
    let writer_ref: &mut Writer = unsafe {
        &mut target_ptr.*
    };
    let chunk_len: usize = chunk.len();
    let spare: usize = 512_usize -| bridge.filled;
    if chunk_len <= spare {
        unsafe {
            @memcpy(
                (&raw mut bridge.scratch[0]).add(bridge.filled) as *mut opaque,
                chunk.as_ptr() as *opaque,
                chunk_len,
            );
        }
        bridge.filled = bridge.filled +% chunk_len;
        return .Ok(());
    }
    if bridge.filled > 0_usize {
        let buffered_slice: &[u8] = unsafe {
            @slice_from_raw_parts(&raw bridge.scratch[0], bridge.filled)
        };
        bridge.filled = 0_usize;
        writer_ref.write_all(buffered_slice) catch |err| {
            bridge.sticky_err = .Some(err);
            return .Err(.IoFailure);
        };
    }
    if chunk_len >= 512_usize {
        writer_ref.write_all(chunk) catch |err| {
            bridge.sticky_err = .Some(err);
            return .Err(.IoFailure);
        };
        return .Ok(());
    }
    unsafe {
        @memcpy(&raw mut bridge.scratch[0] as *mut opaque, chunk.as_ptr() as *opaque, chunk_len);
    }
    bridge.filled = chunk_len;
    .Ok(())
}

/| `FmtWriter` callback streaming formatted chunks directly into `BufWriter`.
@std_cap_boundary(clears: [unsafe_op])
fn buf_writer_fmt_bridge_cb(ctx: *mut opaque, chunk: &[u8]) -> unit!FmtError {
    let bridge_ptr = ctx as *mut BufWriterFmtBridge;
    if bridge_ptr.is_null() {
        return .Ok(());
    }
    if chunk.is_empty() {
        return .Ok(());
    }
    let bridge: &mut BufWriterFmtBridge = unsafe {
        &mut bridge_ptr.*
    };
    let target_ptr: *mut BufWriter = bridge.target;
    if target_ptr.is_null() {
        return .Ok(());
    }
    let buf_writer: &mut BufWriter = unsafe {
        &mut target_ptr.*
    };
    buf_writer.write_all(chunk) catch |err| {
        bridge.sticky_err = .Some(err);
        return .Err(.IoFailure);
    };
    .Ok(())
}

/| `BufReader.as_reader()` `read_out` callback draining buffered bytes first and bypassing buffer on large reads.
@std_cap_boundary(clears: [unsafe_op])
fn buf_reader_read_out_cb(ctx: *mut opaque, out: &mut OutBuf) -> usize!IoError {
    let br_ptr = ctx as *mut BufReader;
    if br_ptr.is_null() {
        return .Ok(0_usize);
    }
    if out.is_full() {
        return .Ok(0_usize);
    }
    let reader_ref: &mut BufReader = unsafe {
        &mut br_ptr.*
    };
    if reader_ref.available() > 0_usize {
        let copied: usize = out.append(reader_ref.buffered());
        reader_ref.consume(copied);
        return .Ok(copied);
    }
    let cap: usize = reader_ref.capacity();
    if cap == 0_usize or out.remaining() >= cap {
        return reader_ref.upstream.read_out(&mut out.*);
    }
    reader_ref.pos = 0_usize;
    reader_ref.filled = 0_usize;
    var refill_out = unsafe {
        OutBuf.from_raw_parts(reader_ref.buf_ptr, cap)
    };
    let n: usize = reader_ref.upstream.read_out(&mut refill_out)?;
    reader_ref.filled = n;
    if n == 0_usize {
        return .Ok(0_usize);
    }
    let copied: usize = out.append(reader_ref.buffered());
    reader_ref.consume(copied);
    .Ok(copied)
}

/| `BufReader.as_reader()` `discard` callback consuming buffered window before delegating to `upstream`.
@std_cap_boundary(clears: [unsafe_op])
fn buf_reader_discard_cb(ctx: *mut opaque, bytes: u64) -> u64!IoError {
    let br_ptr = ctx as *mut BufReader;
    if br_ptr.is_null() {
        return .Ok(0_u64);
    }
    if bytes == 0_u64 {
        return .Ok(0_u64);
    }
    let reader_ref: &mut BufReader = unsafe {
        &mut br_ptr.*
    };
    let avail = reader_ref.available() as u64;
    if bytes <= avail {
        reader_ref.consume(bytes as usize);
        return .Ok(bytes);
    }
    reader_ref.consume(reader_ref.available());
    let rem_skip: u64 = bytes -% avail;
    let skipped_upstream: u64 = reader_ref.upstream.discard(rem_skip)?;
    .Ok(avail +% skipped_upstream)
}

/| `BufWriter.as_writer()` `write` callback forwarding to `BufWriter.write`.
@std_cap_boundary(clears: [unsafe_op])
fn buf_writer_write_cb(ctx: *mut opaque, data: &[u8]) -> usize!IoError {
    let bw_ptr = ctx as *mut BufWriter;
    if bw_ptr.is_null() {
        return .Ok(0_usize);
    }
    let writer_ref: &mut BufWriter = unsafe {
        &mut bw_ptr.*
    };
    writer_ref.write(data)
}

/| `BufWriter.as_writer()` `write_vectored` callback forwarding to `BufWriter.write_vectored`.
@std_cap_boundary(clears: [unsafe_op])
fn buf_writer_write_vectored_cb(ctx: *mut opaque, bufs: &[IoSlice]) -> usize!IoError {
    let bw_ptr = ctx as *mut BufWriter;
    if bw_ptr.is_null() {
        return .Ok(0_usize);
    }
    let writer_ref: &mut BufWriter = unsafe {
        &mut bw_ptr.*
    };
    writer_ref.write_vectored(bufs)
}

/| `BufWriter.as_writer()` `flush` callback forwarding to `BufWriter.flush`.
@std_cap_boundary(clears: [unsafe_op])
fn buf_writer_flush_cb(ctx: *mut opaque) -> unit!IoError {
    let bw_ptr = ctx as *mut BufWriter;
    if bw_ptr.is_null() {
        return .Ok(());
    }
    let writer_ref: &mut BufWriter = unsafe {
        &mut bw_ptr.*
    };
    writer_ref.flush()
}

/| Flushes `buf_ptr[0..filled]` into `downstream` and calls `downstream.flush()` during `BufWriter.close`.
@std_cap_boundary(clears: [unsafe_op])
fn flush_raw_buf_writer_parts(
    downstream: &mut Writer,
    buf_ptr: *mut u8,
    filled: u32,
    /,
) -> unit!IoError {
    if filled > 0_u32 and not buf_ptr.is_null() {
        let slice: &[u8] = unsafe {
            @slice_from_raw_parts(buf_ptr as *u8, filled as usize)
        };
        downstream.write_all(slice)?;
    }
    downstream.flush()
}

/| `LimitReader.as_reader()` `read_out` callback forwarding to `LimitReader.read_out`.
@std_cap_boundary(clears: [unsafe_op])
fn limit_reader_read_out_cb(ctx: *mut opaque, out: &mut OutBuf) -> usize!IoError {
    let lr_ptr = ctx as *mut LimitReader;
    if lr_ptr.is_null() {
        return .Ok(0_usize);
    }
    let limit_ref: &mut LimitReader = unsafe {
        &mut lr_ptr.*
    };
    limit_ref.read_out(out)
}

/| `LimitReader.as_reader()` `discard` callback capping skip count at `remaining_bytes`.
@std_cap_boundary(clears: [unsafe_op])
fn limit_reader_discard_cb(ctx: *mut opaque, bytes: u64) -> u64!IoError {
    let lr_ptr = ctx as *mut LimitReader;
    if lr_ptr.is_null() {
        return .Ok(0_u64);
    }
    if bytes == 0_u64 {
        return .Ok(0_u64);
    }
    let limit_ref: &mut LimitReader = unsafe {
        &mut lr_ptr.*
    };
    let capped: u64 = if bytes < limit_ref.remaining_bytes => bytes else limit_ref.remaining_bytes;
    if capped == 0_u64 {
        return .Ok(0_u64);
    }
    let skipped: u64 = limit_ref.upstream.discard(capped)?;
    limit_ref.remaining_bytes = limit_ref.remaining_bytes -| skipped;
    .Ok(skipped)
}

/| `ByteReader.as_reader()` `read_out` callback forwarding to `ByteReader.read_out`.
@std_cap_boundary(clears: [unsafe_op])
fn byte_reader_read_out_cb(ctx: *mut opaque, out: &mut OutBuf) -> usize!IoError {
    let br_ptr = ctx as *mut ByteReader;
    if br_ptr.is_null() {
        return .Ok(0_usize);
    }
    let cursor: &mut ByteReader = unsafe {
        &mut br_ptr.*
    };
    cursor.read_out(out)
}

/| `ByteReader.as_reader()` `read_vectored` callback copying across multiple `IoSliceMut` buffers in one call.
@std_cap_boundary(clears: [unsafe_op, may_panic])
fn byte_reader_read_vectored_cb(ctx: *mut opaque, bufs: &mut [IoSliceMut]) -> usize!IoError {
    let br_ptr = ctx as *mut ByteReader;
    if br_ptr.is_null() {
        return .Ok(0_usize);
    }
    let cursor: &mut ByteReader = unsafe {
        &mut br_ptr.*
    };
    var total_copied = 0_usize;
    var idx = 0_usize;
    let slice_count: usize = bufs.len();
    while idx < slice_count {
        if cursor.is_empty() {
            break;
        }
        let dst_slice: &mut [u8] = bufs[idx].as_mut_slice();
        let dst_len: usize = dst_slice.len();
        if dst_len > 0_usize {
            var out = OutBuf.over_slice(dst_slice);
            let n: usize = cursor.read_out(&mut out)?;
            total_copied = total_copied +% n;
            if n < dst_len {
                break;
            }
        }
        idx += 1_usize;
    }
    .Ok(total_copied)
}

/| `ByteReader.as_reader()` `discard` callback advancing `pos` in `O(1)`.
@std_cap_boundary(clears: [unsafe_op])
fn byte_reader_discard_cb(ctx: *mut opaque, bytes: u64) -> u64!IoError {
    let br_ptr = ctx as *mut ByteReader;
    if br_ptr.is_null() {
        return .Ok(0_u64);
    }
    if bytes == 0_u64 {
        return .Ok(0_u64);
    }
    let cursor: &mut ByteReader = unsafe {
        &mut br_ptr.*
    };
    let avail = cursor.remaining() as u64;
    let skip_u64: u64 = if bytes < avail => bytes else avail;
    cursor.pos = cursor.pos +% (skip_u64 as usize);
    .Ok(skip_u64)
}

/| `ByteReader.as_seeker()` `seek` callback forwarding to `ByteReader.seek`.
@std_cap_boundary(clears: [unsafe_op])
fn byte_reader_seek_cb(ctx: *mut opaque, pos: SeekFrom) -> u64!IoError {
    let br_ptr = ctx as *mut ByteReader;
    if br_ptr.is_null() {
        return .Ok(0_u64);
    }
    let cursor: &mut ByteReader = unsafe {
        &mut br_ptr.*
    };
    cursor.seek(pos)
}

/| `SliceWriter.as_writer()` `write` callback forwarding to `SliceWriter.write`.
@std_cap_boundary(clears: [unsafe_op])
fn slice_writer_write_cb(ctx: *mut opaque, data: &[u8]) -> usize!IoError {
    let sw_ptr = ctx as *mut SliceWriter;
    if sw_ptr.is_null() {
        return .Ok(0_usize);
    }
    let cursor: &mut SliceWriter = unsafe {
        &mut sw_ptr.*
    };
    cursor.write(data)
}

/| `SliceWriter.as_writer()` `write_vectored` callback copying scatter slices sequentially into `SliceWriter`.
@std_cap_boundary(clears: [unsafe_op])
fn slice_writer_write_vectored_cb(ctx: *mut opaque, bufs: &[IoSlice]) -> usize!IoError {
    let sw_ptr = ctx as *mut SliceWriter;
    if sw_ptr.is_null() {
        return .Ok(0_usize);
    }
    let cursor: &mut SliceWriter = unsafe {
        &mut sw_ptr.*
    };
    var total_written = 0_usize;
    for slice in bufs {
        let bytes: &[u8] = slice.as_slice();
        if not bytes.is_empty() {
            let n: usize = cursor.write(bytes)?;
            total_written = total_written +% n;
            if n < bytes.len() {
                break;
            }
        }
    }
    .Ok(total_written)
}

/| `SliceWriter.as_seeker()` `seek` callback forwarding to `SliceWriter.seek`.
@std_cap_boundary(clears: [unsafe_op])
fn slice_writer_seek_cb(ctx: *mut opaque, pos: SeekFrom) -> u64!IoError {
    let sw_ptr = ctx as *mut SliceWriter;
    if sw_ptr.is_null() {
        return .Ok(0_u64);
    }
    let cursor: &mut SliceWriter = unsafe {
        &mut sw_ptr.*
    };
    cursor.seek(pos)
}

/| Copies all non-empty `bufs` sequentially into `buf_ptr[filled..]` and returns the updated `filled` count.
@std_cap_boundary(clears: [unsafe_op])
fn copy_io_slices_to_buf(buf_ptr: *mut u8, var filled: u32, bufs: &[IoSlice], /) -> u32 {
    for slice in bufs {
        let bytes: &[u8] = slice.as_slice();
        if not bytes.is_empty() {
            unsafe {
                @memcpy(
                    buf_ptr.add(filled as usize) as *mut opaque,
                    bytes.as_ptr() as *opaque,
                    bytes.len(),
                );
            }
            filled = filled +% (bytes.len() as u32);
        }
    }
    filled
}

/| Writes one `16`-slice stack batch starting with `tail_part` followed by `bufs[next_idx..]` (`0` heap allocs).
@std_cap_boundary(clears: [may_panic])
fn write_vectored_tail_batch(
    writer: &mut Writer,
    tail_part: &[u8],
    bufs: &[IoSlice],
    next_idx: usize,
    /,
) -> usize!IoError {
    var batch: [IoSlice; 16] = [IoSlice.new(EMPTY_BYTES); 16];
    batch[0] = IoSlice.new(tail_part);
    let total_bufs: usize = bufs.len();
    let avail: usize = total_bufs -| next_idx;
    let extra_n: usize = if avail < 15_usize => avail else 15_usize;
    var idx = 0_usize;
    while idx < extra_n {
        let src_idx: usize = next_idx +% idx;
        let dst_idx: usize = idx + 1_usize;
        if src_idx < total_bufs and dst_idx < 16_usize {
            batch[dst_idx] = bufs[src_idx];
        }
        idx += 1_usize;
    }
    let batch_len: usize = extra_n + 1_usize;
    if batch_len <= 16_usize {
        return writer.write_vectored(batch[0..batch_len]);
    }
    writer.write_vectored(&batch)
}

// --------------- Host & Reactor Stdio Dispatch ----------------
/| Returns pointer to the `24 B` zero-initialized `StdioTlsHeader` at `@tls_alloc_state() + 224` (`224..248`).
@std_cap_boundary(clears: [unsafe_op])
fn stdio_tls_header() -> *mut StdioTlsHeader {
    let raw_tls = @tls_alloc_state() as *mut u8;
    if raw_tls.is_null() {
        return @default_init[*mut StdioTlsHeader]();
    }
    unsafe {
        raw_tls.add(STDIO_TLS_OFFSET) as *mut StdioTlsHeader
    }
}

/| Acquires an atomic `u8` spin lock (`0 -> 1`, Acquire), aborting on same-thread reentrant deadlock.
@std_cap_boundary(clears: [unsafe_op])
fn acquire_stdio_lock(lock_ptr: *mut u8, /) {
    if lock_ptr.is_null() {
        return;
    }
    var spins = 0_u32;
    while true {
        let (_, is_acquired) = unsafe {
            @atomic_cmpxchg(lock_ptr, 0_u8, 1_u8, 2_u8, 0_u8, 0_u8)
        };
        if is_acquired {
            return;
        }
        spins = spins +% 1_u32;
        if spins > 1_000_000_u32 {
            panic("cx.io: reentrant deadlock on locked standard stream");
        }
    }
}

/| Releases an atomic `u8` lock (`1 -> 0`, Release).
@std_cap_boundary(clears: [unsafe_op])
fn release_stdio_lock(lock_ptr: *mut u8, /) {
    if not lock_ptr.is_null() {
        unsafe {
            @atomic_store(lock_ptr, 0_u8, 3_u8);
        }
    }
}

/| Lazily maps the `StdioSlab` (`24 KiB` inside one `64 KiB` OS page) on first `stdio` lock acquisition.
@std_cap_boundary(clears: [unsafe_op, alloc])
fn ensure_stdio_slab(hdr: &mut StdioTlsHeader, /) -> *mut StdioSlab {
    if not hdr.slab_ptr.is_null() {
        return hdr.slab_ptr;
    }
    if System.alloc_pages(@size_of[StdioSlab]()) is .Ok(raw_pages) {
        let mapped_slab = raw_pages as *mut StdioSlab;
        hdr.slab_ptr = mapped_slab;
        return mapped_slab;
    }
    @default_init[*mut StdioSlab]()
}

/| Returns `true` when `stdout` (`fd = 1`) is attached to an interactive terminal (cached after first probe).
@std_cap_boundary(clears: [ffi, unsafe_op, indirect_opaque])
fn is_stdout_tty_cached(hdr: &mut StdioTlsHeader, /) -> bool {
    let reactor_slot = context.reactor;
    let vt_raw: *opaque = unsafe {
        (&raw reactor_slot as **opaque).*
    };
    if not vt_raw.is_null() {
        return false;
    }
    let cur_state: u8 = unsafe {
        @atomic_load(&raw hdr.tty_state, 2_u8)
    };
    if cur_state != 0_u8 {
        return (cur_state & 2_u8) != 0_u8;
    }
    let is_tty: bool = is_host_stdout_tty();
    let next_state: u8 = if is_tty => 3_u8 else 1_u8;
    unsafe {
        @atomic_store(&raw mut hdr.tty_state, next_state, 3_u8);
    }
    is_tty
}

/| Submits `SIM_OP_STDIO_RW` to `context.reactor.vtable.submit_io` when attached (`flags`: `0` = read, `1` = write).
@std_cap_boundary(clears: [ffi, unsafe_op, indirect_opaque])
fn try_reactor_stdio_rw(
    fd_num: i32,
    is_write: bool,
    buf_ptr: *mut u8,
    buf_len: usize,
    /,
) -> (usize!IoError)? {
    let reactor_slot = context.reactor;
    let vt_ptr: *u8 = unsafe {
        (&raw reactor_slot as **u8).*
    };
    if vt_ptr.is_null() {
        return .None;
    }
    let slot_ptr: *(ReactorSubmitFn?) = unsafe {
        vt_ptr.add(3_usize * @size_of[usize]()) as *(ReactorSubmitFn?)
    };
    if slot_ptr.is_null() {
        return .None;
    }
    let opt_submit: ReactorSubmitFn? = unsafe {
        slot_ptr.*
    };
    let submit_cb: ReactorSubmitFn = opt_submit orelse return .None;
    let clamped_u32: u32 = if buf_len > (u32.MAX as usize) => u32.MAX else buf_len as u32;
    let sub = IoSubmission {
        kind: SIM_OP_STDIO_RW,
        flags: if is_write => 1_u8 else 0_u8,
        worker_id: 0_u16,
        fd_or_handle: fd_num,
        offset_or_ns: 0_u64,
        buf_ptr,
        buf_len: clamped_u32,
        slot_index: 0_u32,
    };
    let reactor_ctx_slot = context.reactor_ctx;
    let state_ptr: *mut opaque = unsafe {
        (&raw reactor_ctx_slot as **mut opaque).*
    };
    let sim_rc: i64 = unsafe {
        submit_cb(state_ptr, &raw sub)
    };
    if sim_rc == SIM_UNHANDLED_SENTINEL {
        return .None;
    }
    if sim_rc >= 0_i64 {
        let transferred: usize = if (sim_rc as u64) > (buf_len as u64) => buf_len
            else sim_rc as usize;
        return .Some(.Ok(transferred));
    }
    let fault_code = (0_i64 -% sim_rc) as i32;
    let io_op: IoOp = if is_write => .Write else .Read;
    .Some(.Err(IoError.from_raw_os(fault_code, domain: .SimFault, op: io_op)))
}

/| Raw `stdin` (`fd = 0`) `ReaderVTable.read_out` callback routing `context.reactor` -> host OS.
@std_cap_boundary(clears: [ffi, unsafe_op, indirect_opaque])
fn raw_stdin_read_out_cb(ctx: *mut opaque, out: &mut OutBuf) -> usize!IoError {
    _ = ctx;
    let (dst_ptr, rem_len) = out.unfilled_raw();
    if rem_len == 0_usize {
        return .Ok(0_usize);
    }
    if try_reactor_stdio_rw(0, false, dst_ptr, rem_len) is .Some(sim_res) {
        let sim_n: usize = sim_res?;
        unsafe {
            out.advance_init(sim_n);
        }
        return .Ok(sim_n);
    }
    let host_n: usize = host_stdin_read(dst_ptr, rem_len)?;
    unsafe {
        out.advance_init(host_n);
    }
    .Ok(host_n)
}

/| Raw `stdout`/`stderr` (`ctx` encodes `1` or `2`) `WriterVTable.write` callback routing `context.reactor` -> host OS.
@std_cap_boundary(clears: [ffi, unsafe_op, indirect_opaque])
fn raw_stdio_write_cb(ctx: *mut opaque, data: &[u8]) -> usize!IoError {
    if data.is_empty() {
        return .Ok(0_usize);
    }
    let fd_num = (ctx as usize) as i32;
    if try_reactor_stdio_rw(fd_num, true, data.as_ptr() as *mut u8, data.len()) is .Some(sim_res) {
        return sim_res;
    }
    host_stdio_write(fd_num, data)
}

/| Linux host `isatty(STDOUT_FILENO)` predicate.
@cfg(target.os == "linux") @std_cap_boundary(clears: [ffi, unsafe_op])
fn is_host_stdout_tty() -> bool {
    unsafe {
        sys.linux.linux_isatty(sys.linux.STDOUT_FILENO) != 0
    }
}

/| Linux host `read(STDIN_FILENO, dst_ptr, cap)` wrapper.
@cfg(target.os == "linux") @std_cap_boundary(clears: [ffi, unsafe_op])
fn host_stdin_read(dst_ptr: *mut u8, cap: usize, /) -> usize!IoError {
    let rc: isize = unsafe {
        sys.linux.linux_posix_read(sys.linux.STDIN_FILENO, dst_ptr, cap)
    };
    if rc < 0_isize {
        let errno_ptr: *mut i32 = unsafe {
            sys.linux.linux_errno_location()
        };
        let code: i32 = if errno_ptr.is_null() {
            sys.linux.EIO
        } else {
            unsafe {
                errno_ptr.*
            }
        };
        return .Err(IoError.from_raw_os(code, domain: .PosixErrno, op: .Read));
    }
    .Ok(rc as usize)
}

/| Linux host `write(fd_num, data)` wrapper.
@cfg(target.os == "linux") @std_cap_boundary(clears: [ffi, unsafe_op])
fn host_stdio_write(fd_num: i32, data: &[u8], /) -> usize!IoError {
    let rc: isize = unsafe {
        sys.linux.linux_posix_write(fd_num, data.as_ptr(), data.len())
    };
    if rc < 0_isize {
        let errno_ptr: *mut i32 = unsafe {
            sys.linux.linux_errno_location()
        };
        let code: i32 = if errno_ptr.is_null() {
            sys.linux.EIO
        } else {
            unsafe {
                errno_ptr.*
            }
        };
        return .Err(IoError.from_raw_os(code, domain: .PosixErrno, op: .Write));
    }
    .Ok(rc as usize)
}

