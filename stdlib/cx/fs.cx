// ---------------- Linear File, Dir & Iteration ----------------
impl File {
    /| Wraps a raw OS descriptor into a `@linear` `File` (`cx` package internal).
    pub(pkg) fn from_raw_fd(raw_fd: RawOsFd, /) -> File = File { raw_fd };

    /| Transfers ownership out of `self` and returns the underlying `RawOsFd` without closing it (`cx` package internal).
    @expect(unused-pkg-visibility, reason: "shared bridge contract with cx.env and cx.process in Phase 11.2a")
    pub(pkg) fn into_raw_fd(own self) -> RawOsFd {
        let File { raw_fd } = self;
        raw_fd
    }

    /| Borrows the underlying `RawOsFd` without consuming `self`.
    @no_alloc @no_panic
    pub fn as_raw_fd(&self) -> RawOsFd = self.raw_fd;

    /| Opens `path` in read-only mode (`OpenOptions.read_only()`).
    @std_cap_boundary(emits: [fs, blocking_sync], clears: [ffi, unsafe_op, indirect_opaque])
    pub fn open[P: str | Path](path: P, /) -> File!FsError {
        File.open_with(path, OpenOptions.read_only())
    }

    /| Creates or truncates `path` for writing (`OpenOptions.write_create()`).
    @std_cap_boundary(emits: [fs, blocking_sync], clears: [ffi, unsafe_op, indirect_opaque])
    pub fn create[P: str | Path](path: P, /) -> File!FsError {
        File.open_with(path, OpenOptions.write_create())
    }

    /| Opens `path` with explicit `OpenOptions` (`FILE_SHARE_ALL` on Windows; `O_CLOEXEC` on POSIX).
    @std_cap_boundary(emits: [fs, blocking_sync], clears: [ffi, unsafe_op, indirect_opaque])
    pub fn open_with[P: str | Path](path: P, opts: OpenOptions, /) -> File!FsError {
        let path_bytes: &[u8] = path.as_bytes();
        // [1] Consult `context.reactor` (`SIM_OP_FS_OPEN`) for deterministic `--sim` execution:
        var req = SimPathOpReq {
            path_ptr: path_bytes.as_ptr(),
            path_len: path_bytes.len(),
            dst_ptr: @default_init[*u8](),
            dst_len: 0_usize,
            aux_flags: @bit_cast[u16](opts.flags) as u32,
            mode_bits: opts.permissions.posix_mode as u32,
        };
        if try_reactor_fs_submit(
            SIM_OP_FS_OPEN,
            0_u8,
            -1,
            0_u64,
            (&raw mut req) as *mut u8,
            @size_of[SimPathOpReq](),
            0_u32,
        ) is .Some(sim_rc) {
            if sim_rc < 0_i64 {
                return .Err(sim_rc_to_fs_error(sim_rc, .Open, path_bytes));
            }
            return .Ok(File { raw_fd: sim_i32_to_raw_fd(sim_rc as i32) });
        }

        // [2] Dispatch to host OS filesystem open:
        let fd_bits: isize = os_file_open(path_bytes, opts)?;
        .Ok(File { raw_fd: bits_to_raw_fd(fd_bits) })
    }

    /| Closes `self` and releases the underlying OS descriptor (`@linear` consumer).
    @std_cap_boundary(emits: [fs, blocking_sync], clears: [ffi, unsafe_op, indirect_opaque])
    pub fn close(own self) {
        let File { raw_fd } = self;
        if try_reactor_fs_submit(
            SIM_OP_FS_CLOSE,
            0_u8,
            raw_fd_to_sim_i32(raw_fd),
            0_u64,
            @default_init[*mut u8](),
            0_usize,
            0_u32,
        ) is .Some(_) {
            return;
        }
        os_close_fd(raw_fd_to_bits(raw_fd)) catch {};
    }

    /| Flushes pending writes (`CrashSafe`) and closes `self`, surfacing any deferred writeback or close error.
    @std_cap_boundary(emits: [fs, blocking_sync], clears: [ffi, unsafe_op, indirect_opaque])
    pub fn sync_close(own self) -> unit!FsError {
        let File { raw_fd } = self;
        if try_reactor_fs_submit(
            SIM_OP_FS_SYNC,
            DurabilityMode.CrashSafe as u8,
            raw_fd_to_sim_i32(raw_fd),
            0_u64,
            @default_init[*mut u8](),
            0_usize,
            0_u32,
        ) is .Some(sim_sync_rc) {
            _ = try_reactor_fs_submit(
                SIM_OP_FS_CLOSE,
                0_u8,
                raw_fd_to_sim_i32(raw_fd),
                0_u64,
                @default_init[*mut u8](),
                0_usize,
                0_u32,
            );
            if sim_sync_rc < 0_i64 {
                return .Err(sim_rc_to_fs_error(sim_sync_rc, .Flush, EMPTY_BYTES));
            }
            return .Ok(());
        }
        let sync_res: unit!FsError = os_file_sync(raw_fd_to_bits(raw_fd), .CrashSafe);
        let close_res: unit!FsError = os_close_fd(raw_fd_to_bits(raw_fd));
        sync_res?;
        close_res
    }

    /| Reads available bytes into uninitialized `out` without `memset` (`0` = EOF).
    @std_cap_boundary(emits: [fs, blocking_sync], clears: [ffi, unsafe_op, indirect_opaque])
    pub fn read_out(&mut self, out: &mut OutBuf, /) -> usize!IoError {
        let (dst_ptr, rem_cap) = out.unfilled_raw();
        if rem_cap == 0_usize or dst_ptr.is_null() {
            return .Ok(0_usize);
        }
        if try_reactor_fs_submit(
            SIM_OP_FS_RW,
            0_u8,
            raw_fd_to_sim_i32(self.raw_fd),
            u64.MAX,
            dst_ptr,
            rem_cap,
            0_u32,
        ) is .Some(sim_rc) {
            if sim_rc < 0_i64 {
                return .Err(sim_rc_to_io_error(sim_rc, .Read));
            }
            let got: usize = if (sim_rc as usize) > rem_cap => rem_cap else sim_rc as usize;
            unsafe {
                out.advance_init(got);
            }
            return .Ok(got);
        }
        let read_n: usize = os_file_read(raw_fd_to_bits(self.raw_fd), dst_ptr, rem_cap)?;
        unsafe {
            out.advance_init(read_n);
        }
        .Ok(read_n)
    }

    /| Reads available bytes into initialized slice `buf` (`0` = EOF).
    @std_cap_boundary(emits: [fs, blocking_sync], clears: [ffi, unsafe_op, indirect_opaque])
    pub fn read(&mut self, buf: &mut [u8], /) -> usize!IoError {
        var out = OutBuf.over_slice(buf);
        self.read_out(&mut out)
    }

    /| Reads positionally at `offset` into `out` without mutating the sequential file cursor.
    @std_cap_boundary(emits: [fs, blocking_sync], clears: [ffi, unsafe_op, indirect_opaque])
    pub fn pread_out(&self, out: &mut OutBuf, offset: u64, /) -> usize!IoError {
        let (dst_ptr, rem_cap) = out.unfilled_raw();
        if rem_cap == 0_usize or dst_ptr.is_null() {
            return .Ok(0_usize);
        }
        if try_reactor_fs_submit(
            SIM_OP_FS_RW,
            2_u8,
            raw_fd_to_sim_i32(self.raw_fd),
            offset,
            dst_ptr,
            rem_cap,
            0_u32,
        ) is .Some(sim_rc) {
            if sim_rc < 0_i64 {
                return .Err(sim_rc_to_io_error(sim_rc, .Read));
            }
            let got: usize = if (sim_rc as usize) > rem_cap => rem_cap else sim_rc as usize;
            unsafe {
                out.advance_init(got);
            }
            return .Ok(got);
        }
        let read_n: usize = os_file_pread(raw_fd_to_bits(self.raw_fd), dst_ptr, rem_cap, offset)?;
        unsafe {
            out.advance_init(read_n);
        }
        .Ok(read_n)
    }

    /| Writes a prefix of `buf` sequentially and returns the number of bytes accepted.
    @std_cap_boundary(emits: [fs, blocking_sync], clears: [ffi, unsafe_op, indirect_opaque])
    pub fn write(&mut self, buf: &[u8], /) -> usize!IoError {
        if buf.is_empty() {
            return .Ok(0_usize);
        }
        if try_reactor_fs_submit(
            SIM_OP_FS_RW,
            1_u8,
            raw_fd_to_sim_i32(self.raw_fd),
            u64.MAX,
            buf.as_ptr() as *mut u8,
            buf.len(),
            0_u32,
        ) is .Some(sim_rc) {
            if sim_rc < 0_i64 {
                return .Err(sim_rc_to_io_error(sim_rc, .Write));
            }
            return .Ok(sim_rc as usize);
        }
        os_file_write(raw_fd_to_bits(self.raw_fd), buf)
    }

    /| Writes every byte of `buf` sequentially, retrying `Interrupted` and failing with `.WriteZero` on stall.
    @std_cap_boundary(emits: [fs, blocking_sync], clears: [ffi, unsafe_op, indirect_opaque])
    pub fn write_all(&mut self, buf: &[u8], /) -> unit!IoError {
        var written = 0_usize;
        let total: usize = buf.len();
        while written < total {
            let tail: &[u8] = subslice_u8(buf, written, total);
            let n: usize = self.write(tail) catch |err| {
                if err.is_interrupted() {
                    continue;
                }
                return .Err(err);
            };
            if n == 0_usize {
                return .Err(IoError.from_kind(.WriteZero, op: .Write));
            }
            written = written +% n;
        }
        .Ok(())
    }

    /| Writes every byte of `buf` positionally starting at `offset` without mutating the sequential cursor.
    @std_cap_boundary(emits: [fs, blocking_sync], clears: [ffi, unsafe_op, indirect_opaque])
    pub fn pwrite_all(&self, buf: &[u8], offset: u64, /) -> unit!IoError {
        var written = 0_usize;
        let total: usize = buf.len();
        while written < total {
            let tail: &[u8] = subslice_u8(buf, written, total);
            let cur_off: u64 = offset +% (written as u64);
            if try_reactor_fs_submit(
                SIM_OP_FS_RW,
                3_u8,
                raw_fd_to_sim_i32(self.raw_fd),
                cur_off,
                tail.as_ptr() as *mut u8,
                tail.len(),
                0_u32,
            ) is .Some(sim_rc) {
                if sim_rc < 0_i64 {
                    let sim_err: IoError = sim_rc_to_io_error(sim_rc, .Write);
                    if sim_err.is_interrupted() {
                        continue;
                    }
                    return .Err(sim_err);
                }
                if sim_rc == 0_i64 {
                    return .Err(IoError.from_kind(.WriteZero, op: .Write));
                }
                written = written +% (sim_rc as usize);
                continue;
            }
            let n: usize = os_file_pwrite(raw_fd_to_bits(self.raw_fd), tail, cur_off) catch |err| {
                if err.is_interrupted() {
                    continue;
                }
                return .Err(err);
            };
            if n == 0_usize {
                return .Err(IoError.from_kind(.WriteZero, op: .Write));
            }
            written = written +% n;
        }
        .Ok(())
    }

    /| Writes scatter-gather `IoSlice`s (`IOV_MAX = 1024` POSIX, `128` WASI, skipping empty slices on Windows).
    @std_cap_boundary(emits: [fs, blocking_sync], clears: [ffi, unsafe_op, indirect_opaque])
    pub fn write_vectored(&mut self, bufs: &[IoSlice], /) -> usize!IoError {
        if try_reactor_fs_submit(
            SIM_OP_FS_RW,
            4_u8,
            raw_fd_to_sim_i32(self.raw_fd),
            u64.MAX,
            bufs.as_ptr() as *mut u8,
            bufs.len(),
            0_u32,
        ) is .Some(sim_rc) {
            if sim_rc < 0_i64 {
                return .Err(sim_rc_to_io_error(sim_rc, .Write));
            }
            return .Ok(sim_rc as usize);
        }
        os_file_write_vectored(raw_fd_to_bits(self.raw_fd), bufs)
    }

    /| Repositions `self`'s sequential cursor and returns the new absolute byte offset.
    @std_cap_boundary(emits: [fs, blocking_sync], clears: [ffi, unsafe_op, indirect_opaque])
    pub fn seek(&mut self, pos: SeekFrom, /) -> u64!IoError {
        let (whence_flag, raw_delta) = match pos {
            .Start(abs_off) => (0_u8, abs_off),
            .Current(rel_off) => (1_u8, @bit_cast[u64](rel_off)),
            .End(end_off) => (2_u8, @bit_cast[u64](end_off)),
        };
        if try_reactor_fs_submit(
            SIM_OP_FS_SEEK,
            whence_flag,
            raw_fd_to_sim_i32(self.raw_fd),
            raw_delta,
            @default_init[*mut u8](),
            0_usize,
            0_u32,
        ) is .Some(sim_rc) {
            if sim_rc < 0_i64 {
                return .Err(sim_rc_to_io_error(sim_rc, .Seek));
            }
            return .Ok(sim_rc as u64);
        }
        os_file_seek(raw_fd_to_bits(self.raw_fd), pos)
    }

    /| Truncates or zero-extends `self` to `size` bytes without disturbing the sequential cursor.
    @std_cap_boundary(emits: [fs, blocking_sync], clears: [ffi, unsafe_op, indirect_opaque])
    pub fn set_len(&mut self, size: u64, /) -> unit!FsError {
        if try_reactor_fs_submit(
            SIM_OP_FS_RW,
            5_u8,
            raw_fd_to_sim_i32(self.raw_fd),
            size,
            @default_init[*mut u8](),
            0_usize,
            0_u32,
        ) is .Some(sim_rc) {
            if sim_rc < 0_i64 {
                return .Err(sim_rc_to_fs_error(sim_rc, .Write, EMPTY_BYTES));
            }
            return .Ok(());
        }
        os_file_set_len(raw_fd_to_bits(self.raw_fd), size)
    }

    /| Updates file permissions on `self`.
    @std_cap_boundary(emits: [fs, blocking_sync], clears: [ffi, unsafe_op, indirect_opaque])
    pub fn set_permissions(&mut self, perms: FilePermissions, /) -> unit!FsError {
        if try_reactor_fs_submit(
            SIM_OP_FS_STAT,
            2_u8,
            raw_fd_to_sim_i32(self.raw_fd),
            @bit_cast[u32](perms) as u64,
            @default_init[*mut u8](),
            0_usize,
            0_u32,
        ) is .Some(sim_rc) {
            if sim_rc < 0_i64 {
                return .Err(sim_rc_to_fs_error(sim_rc, .Stat, EMPTY_BYTES));
            }
            return .Ok(());
        }
        os_file_set_permissions(raw_fd_to_bits(self.raw_fd), perms)
    }

    /| Flushes `self` to storage according to `mode` (`CrashSafe` by default).
    @std_cap_boundary(emits: [fs, blocking_sync], clears: [ffi, unsafe_op, indirect_opaque])
    pub fn sync(&mut self, mode: DurabilityMode = .CrashSafe, /) -> unit!FsError {
        if try_reactor_fs_submit(
            SIM_OP_FS_SYNC,
            mode as u8,
            raw_fd_to_sim_i32(self.raw_fd),
            0_u64,
            @default_init[*mut u8](),
            0_usize,
            0_u32,
        ) is .Some(sim_rc) {
            if sim_rc < 0_i64 {
                return .Err(sim_rc_to_fs_error(sim_rc, .Flush, EMPTY_BYTES));
            }
            return .Ok(());
        }
        os_file_sync(raw_fd_to_bits(self.raw_fd), mode)
    }

    /| Queries normalized `Metadata` for `self`.
    @std_cap_boundary(emits: [fs, blocking_sync], clears: [ffi, unsafe_op, indirect_opaque])
    pub fn metadata(&self) -> Metadata!FsError {
        var sim_meta = Metadata {
            file_type: .RegularFile,
            size: 0_u64,
            permissions: FilePermissions.DEFAULT_FILE,
            modified: .None,
            accessed: .None,
            created: .None,
            dev_id: 0_u64,
            inode_or_file_id: 0_u64,
            hardlink_count: 1_u32,
        };
        if try_reactor_fs_submit(
            SIM_OP_FS_STAT,
            0_u8,
            raw_fd_to_sim_i32(self.raw_fd),
            0_u64,
            (&raw mut sim_meta) as *mut u8,
            @size_of[Metadata](),
            0_u32,
        ) is .Some(sim_rc) {
            if sim_rc < 0_i64 {
                return .Err(sim_rc_to_fs_error(sim_rc, .Stat, EMPTY_BYTES));
            }
            return .Ok(sim_meta);
        }
        os_file_metadata(raw_fd_to_bits(self.raw_fd))
    }

    /| Borrows `self` as a zero-allocation `cx.io.Reader` stream handle (`READER_SENTINEL_FILE`).
    @std_cap_boundary(clears: [unsafe_op]) @inline @no_alloc @no_panic
    pub fn as_reader(&mut self) -> Reader {
        unsafe {
            Reader.from_raw((&raw mut self.*) as *mut opaque, READER_SENTINEL_FILE as *ReaderVTable)
        }
    }

    /| Borrows `self` as a zero-allocation `cx.io.Writer` stream handle (`WRITER_SENTINEL_FILE`).
    @std_cap_boundary(clears: [unsafe_op]) @inline @no_alloc @no_panic
    pub fn as_writer(&mut self) -> Writer {
        unsafe {
            Writer.from_raw((&raw mut self.*) as *mut opaque, WRITER_SENTINEL_FILE as *WriterVTable)
        }
    }

    /| Borrows `self` as a zero-allocation `cx.io.Seek` stream handle (`SEEK_SENTINEL_FILE`).
    @std_cap_boundary(clears: [unsafe_op]) @inline @no_alloc @no_panic
    pub fn as_seeker(&mut self) -> Seek {
        unsafe {
            Seek.from_raw((&raw mut self.*) as *mut opaque, SEEK_SENTINEL_FILE as *SeekVTable)
        }
    }
}

impl Dir {
    /| Opens a `@linear` capability `Dir` handle for `path`.
    @std_cap_boundary(emits: [fs, blocking_sync], clears: [ffi, unsafe_op, indirect_opaque])
    pub fn open[P: str | Path](path: P, /) -> Dir!FsError {
        let path_bytes: &[u8] = path.as_bytes();
        var req = SimPathOpReq {
            path_ptr: path_bytes.as_ptr(),
            path_len: path_bytes.len(),
            dst_ptr: @default_init[*u8](),
            dst_len: 0_usize,
            aux_flags: 1_u32,
            mode_bits: 0_u32,
        };
        if try_reactor_fs_submit(
            SIM_OP_FS_DIR_OP,
            0_u8,
            -1,
            0_u64,
            (&raw mut req) as *mut u8,
            @size_of[SimPathOpReq](),
            0_u32,
        ) is .Some(sim_rc) {
            if sim_rc < 0_i64 {
                return .Err(sim_rc_to_fs_error(sim_rc, .Open, path_bytes));
            }
            return .Ok(Dir { raw_fd: sim_i32_to_raw_fd(sim_rc as i32) });
        }
        let fd_bits: isize = os_dir_open(path_bytes)?;
        .Ok(Dir { raw_fd: bits_to_raw_fd(fd_bits) })
    }

    /| Opens the process current working directory (`.` capability handle).
    @std_cap_boundary(emits: [fs, blocking_sync], clears: [ffi, unsafe_op, indirect_opaque])
    pub fn cwd() -> Dir!FsError = Dir.open(".");

    /| Borrows the underlying `RawOsFd` directory descriptor.
    @no_alloc @no_panic
    pub fn as_raw_fd(&self) -> RawOsFd = self.raw_fd;

    /| Closes `self` and releases the underlying directory descriptor (`@linear` consumer).
    @std_cap_boundary(emits: [fs, blocking_sync], clears: [ffi, unsafe_op, indirect_opaque])
    pub fn close(own self) {
        let Dir { raw_fd } = self;
        if try_reactor_fs_submit(
            SIM_OP_FS_CLOSE,
            1_u8,
            raw_fd_to_sim_i32(raw_fd),
            0_u64,
            @default_init[*mut u8](),
            0_usize,
            0_u32,
        ) is .Some(_) {
            return;
        }
        os_close_fd(raw_fd_to_bits(raw_fd)) catch {};
    }

    /| Opens a `File` strictly confined beneath `self`, rejecting `..` escape, absolute paths, and symlinks (`STD-02` §3.4B).
    @std_cap_boundary(emits: [fs, blocking_sync], clears: [ffi, unsafe_op, indirect_opaque])
    pub fn open_file_beneath[P: str | Path](
        &self,
        rel_path: P,
        opts: OpenOptions = OpenOptions { .. },
        /,
    ) -> File!FsError {
        let rel_bytes: &[u8] = rel_path.as_bytes();
        validate_beneath_lexical(rel_bytes, .Open)?;
        var req = SimPathOpReq {
            path_ptr: rel_bytes.as_ptr(),
            path_len: rel_bytes.len(),
            dst_ptr: @default_init[*u8](),
            dst_len: 0_usize,
            aux_flags: @bit_cast[u16](opts.flags) as u32,
            mode_bits: opts.permissions.posix_mode as u32,
        };
        if try_reactor_fs_submit(
            SIM_OP_FS_OP_BENEATH,
            0_u8,
            raw_fd_to_sim_i32(self.raw_fd),
            0_u64,
            (&raw mut req) as *mut u8,
            @size_of[SimPathOpReq](),
            0_u32,
        ) is .Some(sim_rc) {
            if sim_rc < 0_i64 {
                return .Err(sim_rc_to_fs_error(sim_rc, .Open, rel_bytes));
            }
            return .Ok(File { raw_fd: sim_i32_to_raw_fd(sim_rc as i32) });
        }
        let fd_bits: isize = os_open_file_beneath(raw_fd_to_bits(self.raw_fd), rel_bytes, opts)?;
        .Ok(File { raw_fd: bits_to_raw_fd(fd_bits) })
    }

    /| Opens a child `Dir` strictly confined beneath `self`, rejecting symlinks/reparse points.
    @std_cap_boundary(emits: [fs, blocking_sync], clears: [ffi, unsafe_op, indirect_opaque])
    pub fn open_dir_beneath[P: str | Path](&self, rel_path: P, /) -> Dir!FsError {
        let rel_bytes: &[u8] = rel_path.as_bytes();
        validate_beneath_lexical(rel_bytes, .Open)?;
        var req = SimPathOpReq {
            path_ptr: rel_bytes.as_ptr(),
            path_len: rel_bytes.len(),
            dst_ptr: @default_init[*u8](),
            dst_len: 0_usize,
            aux_flags: 1_u32,
            mode_bits: 0_u32,
        };
        if try_reactor_fs_submit(
            SIM_OP_FS_OP_BENEATH,
            1_u8,
            raw_fd_to_sim_i32(self.raw_fd),
            0_u64,
            (&raw mut req) as *mut u8,
            @size_of[SimPathOpReq](),
            0_u32,
        ) is .Some(sim_rc) {
            if sim_rc < 0_i64 {
                return .Err(sim_rc_to_fs_error(sim_rc, .Open, rel_bytes));
            }
            return .Ok(Dir { raw_fd: sim_i32_to_raw_fd(sim_rc as i32) });
        }
        let fd_bits: isize = os_open_dir_beneath(raw_fd_to_bits(self.raw_fd), rel_bytes)?;
        .Ok(Dir { raw_fd: bits_to_raw_fd(fd_bits) })
    }

    /| Creates a subdirectory strictly confined beneath `self`.
    @std_cap_boundary(emits: [fs, blocking_sync], clears: [ffi, unsafe_op, indirect_opaque])
    pub fn create_dir_beneath[P: str | Path](
        &self,
        rel_path: P,
        /,
        *,
        perms: FilePermissions = FilePermissions.DEFAULT_DIR,
    ) -> unit!FsError {
        let rel_bytes: &[u8] = rel_path.as_bytes();
        validate_beneath_lexical(rel_bytes, .Mkdir)?;
        var req = SimPathOpReq {
            path_ptr: rel_bytes.as_ptr(),
            path_len: rel_bytes.len(),
            dst_ptr: @default_init[*u8](),
            dst_len: 0_usize,
            aux_flags: 0_u32,
            mode_bits: perms.posix_mode as u32,
        };
        if try_reactor_fs_submit(
            SIM_OP_FS_OP_BENEATH,
            2_u8,
            raw_fd_to_sim_i32(self.raw_fd),
            0_u64,
            (&raw mut req) as *mut u8,
            @size_of[SimPathOpReq](),
            0_u32,
        ) is .Some(sim_rc) {
            if sim_rc < 0_i64 {
                return .Err(sim_rc_to_fs_error(sim_rc, .Mkdir, rel_bytes));
            }
            return .Ok(());
        }
        os_create_dir_beneath(raw_fd_to_bits(self.raw_fd), rel_bytes, perms)
    }

    /| Unlinks a non-symlink regular file strictly confined beneath `self`.
    @std_cap_boundary(emits: [fs, blocking_sync], clears: [ffi, unsafe_op, indirect_opaque])
    pub fn unlink_file_beneath[P: str | Path](&self, rel_path: P, /) -> unit!FsError {
        let rel_bytes: &[u8] = rel_path.as_bytes();
        validate_beneath_lexical(rel_bytes, .Unlink)?;
        var req = SimPathOpReq {
            path_ptr: rel_bytes.as_ptr(),
            path_len: rel_bytes.len(),
            dst_ptr: @default_init[*u8](),
            dst_len: 0_usize,
            aux_flags: 0_u32,
            mode_bits: 0_u32,
        };
        if try_reactor_fs_submit(
            SIM_OP_FS_OP_BENEATH,
            3_u8,
            raw_fd_to_sim_i32(self.raw_fd),
            0_u64,
            (&raw mut req) as *mut u8,
            @size_of[SimPathOpReq](),
            0_u32,
        ) is .Some(sim_rc) {
            if sim_rc < 0_i64 {
                return .Err(sim_rc_to_fs_error(sim_rc, .Unlink, rel_bytes));
            }
            return .Ok(());
        }
        os_unlink_file_beneath(raw_fd_to_bits(self.raw_fd), rel_bytes)
    }

    /| Queries `Metadata` strictly confined beneath `self`.
    @std_cap_boundary(emits: [fs, blocking_sync], clears: [ffi, unsafe_op, indirect_opaque])
    pub fn metadata_beneath[P: str | Path](
        &self,
        rel_path: P,
        /,
        *,
        follow_symlinks: bool = false,
    ) -> Metadata!FsError {
        let rel_bytes: &[u8] = rel_path.as_bytes();
        validate_beneath_lexical(rel_bytes, .Stat)?;
        var sim_meta = Metadata {
            file_type: .RegularFile,
            size: 0_u64,
            permissions: FilePermissions.DEFAULT_FILE,
            modified: .None,
            accessed: .None,
            created: .None,
            dev_id: 0_u64,
            inode_or_file_id: 0_u64,
            hardlink_count: 1_u32,
        };
        if try_reactor_fs_submit(
            SIM_OP_FS_OP_BENEATH,
            if follow_symlinks => 5_u8 else 4_u8,
            raw_fd_to_sim_i32(self.raw_fd),
            (rel_bytes.as_ptr() as usize) as u64,
            (&raw mut sim_meta) as *mut u8,
            rel_bytes.len(),
            0_u32,
        ) is .Some(sim_rc) {
            if sim_rc < 0_i64 {
                return .Err(sim_rc_to_fs_error(sim_rc, .Stat, rel_bytes));
            }
            return .Ok(sim_meta);
        }
        os_metadata_beneath(raw_fd_to_bits(self.raw_fd), rel_bytes, follow_symlinks)
    }

    /| Returns a `@linear` streaming `DirIter` enumerating child entries of `self` (excluding `.` and `..`).
    @std_cap_boundary(emits: [fs, blocking_sync], clears: [ffi, unsafe_op, indirect_opaque])
    pub fn entries(&self) -> DirIter!FsError {
        if try_reactor_fs_submit(
            SIM_OP_FS_DIR_OP,
            1_u8,
            raw_fd_to_sim_i32(self.raw_fd),
            0_u64,
            @default_init[*mut u8](),
            0_usize,
            0_u32,
        ) is .Some(sim_rc) {
            if sim_rc < 0_i64 {
                return .Err(sim_rc_to_fs_error(sim_rc, .Readdir, EMPTY_BYTES));
            }
            return .Ok(DirIter { raw_state: (sim_rc as usize) as *mut opaque });
        }
        let raw_state: *mut opaque = os_dir_entries(raw_fd_to_bits(self.raw_fd))?;
        .Ok(DirIter { raw_state })
    }

    /| Synchronizes directory metadata updates inside `self` to stable storage.
    @std_cap_boundary(emits: [fs, blocking_sync], clears: [ffi, unsafe_op, indirect_opaque])
    pub fn sync(&self) -> unit!FsError {
        if try_reactor_fs_submit(
            SIM_OP_FS_SYNC,
            DurabilityMode.PowerSafe as u8,
            raw_fd_to_sim_i32(self.raw_fd),
            1_u64,
            @default_init[*mut u8](),
            0_usize,
            0_u32,
        ) is .Some(sim_rc) {
            if sim_rc < 0_i64 {
                return .Err(sim_rc_to_fs_error(sim_rc, .Flush, EMPTY_BYTES));
            }
            return .Ok(());
        }
        os_file_sync(raw_fd_to_bits(self.raw_fd), .PowerSafe)
    }
}

impl DirIter {
    /| Yields the next child `DirEntry` (skipping `.` and `..`), or `.Ok(.None)` at end-of-directory.
    @std_cap_boundary(emits: [fs, blocking_sync], clears: [ffi, unsafe_op, indirect_opaque])
    pub fn next(&mut self) -> DirEntry?!FsError {
        var sim_entry = DirEntry {
            name: PathBuf.new(),
            file_type: .RegularFile,
            inode_or_file_id: 0_u64,
        };
        if try_reactor_fs_submit(
            SIM_OP_FS_DIR_OP,
            2_u8,
            (self.raw_state as usize) as i32,
            0_u64,
            (&raw mut sim_entry) as *mut u8,
            @size_of[DirEntry](),
            0_u32,
        ) is .Some(sim_rc) {
            if sim_rc < 0_i64 {
                return .Err(sim_rc_to_fs_error(sim_rc, .Readdir, EMPTY_BYTES));
            }
            if sim_rc == 0_i64 {
                return .Ok(.None);
            }
            return .Ok(.Some(sim_entry));
        }
        os_dir_iter_next(self.raw_state)
    }

    /| Closes the underlying directory enumeration handle (`@linear` consumer).
    @std_cap_boundary(emits: [fs, blocking_sync], clears: [ffi, unsafe_op, indirect_opaque])
    pub fn close(own self) {
        let DirIter { raw_state } = self;
        if try_reactor_fs_submit(
            SIM_OP_FS_DIR_OP,
            3_u8,
            (raw_state as usize) as i32,
            0_u64,
            @default_init[*mut u8](),
            0_usize,
            0_u32,
        ) is .Some(_) {
            return;
        }
        os_dir_iter_close(raw_state);
    }
}

// --------------- Thresholded Mmap & LoadedFile ----------------
impl Mmap {
    /| Maps `file` read-only into memory (`0`-byte files return a static NUL-terminated view without syscalls).
    @std_cap_boundary(emits: [fs, blocking_sync], clears: [ffi, unsafe_op, indirect_opaque])
    pub fn open_read_only(
        file: &File,
        /,
        *,
        require_nul_sentinel: bool = false,
    ) -> Mmap!FsError {
        // [1] Consult `context.reactor` (`SIM_OP_FS_MMAP`) when running under `--sim`:
        var sim_req = SimMmapReq {
            mapped_ptr: @default_init[*u8](),
            mapped_len: 0_usize,
        };
        if try_reactor_fs_submit(
            SIM_OP_FS_MMAP,
            if require_nul_sentinel => 1_u8 else 0_u8,
            raw_fd_to_sim_i32(file.raw_fd),
            0_u64,
            (&raw mut sim_req) as *mut u8,
            @size_of[SimMmapReq](),
            0_u32,
        ) is .Some(sim_rc) {
            if sim_rc < 0_i64 {
                return .Err(sim_rc_to_fs_error(sim_rc, .Mmap, EMPTY_BYTES));
            }
            if sim_req.mapped_len == 0_usize or sim_req.mapped_ptr.is_null() {
                return .Ok(
                    Mmap {
                        ptr: STATIC_NUL_SENTINEL.as_ptr(),
                        len_bytes: 0_usize,
                        map_cap: 0_usize,
                    },
                );
            }
            return .Ok(
                Mmap {
                    ptr: sim_req.mapped_ptr,
                    len_bytes: sim_req.mapped_len,
                    map_cap: 0_usize,
                },
            );
        }

        // [2] Query file size (`0 B` short-circuits to static NUL sentinel, avoiding `EINVAL` on POSIX `mmap(…, 0)`):
        let meta: Metadata = file.metadata()?;
        if not meta.is_file() {
            return .Err(FsError.from_kind(.InvalidInput, op: .Mmap));
        }
        if meta.size == 0_u64 {
            return .Ok(
                Mmap {
                    ptr: STATIC_NUL_SENTINEL.as_ptr(),
                    len_bytes: 0_usize,
                    map_cap: 0_usize,
                },
            );
        }
        if meta.size > (usize.MAX as u64) {
            return .Err(FsError.from_kind(.OutOfMemory, op: .Mmap));
        }
        os_mmap_open_read_only(raw_fd_to_bits(file.raw_fd), meta.size as usize, require_nul_sentinel)
    }

    /| Borrows the mapped read-only byte slice `&[u8]`.
    @std_cap_boundary(clears: [unsafe_op]) @no_alloc @no_panic
    pub fn as_slice(&self) -> &[u8] {
        if self.len_bytes == 0_usize {
            return subslice_u8(STATIC_NUL_SENTINEL, 0_usize, 0_usize);
        }
        unsafe {
            @slice_from_raw_parts(self.ptr, self.len_bytes)
        }
    }

    /| Returns the logical byte length of `self`.
    @no_alloc @no_panic
    pub fn len(&self) -> usize = self.len_bytes;

    /| Returns `true` when `self.len_bytes == 0`.
    @no_alloc @no_panic
    pub fn is_empty(&self) -> bool = self.len_bytes == 0_usize;

    /| Unmaps `self` (`@linear` consumer).
    @std_cap_boundary(emits: [fs, blocking_sync], clears: [ffi, unsafe_op, indirect_opaque])
    pub fn close(own self) {
        let Mmap { ptr, len_bytes, map_cap } = self;
        _ = len_bytes;
        os_mmap_close(ptr, map_cap);
    }
}

impl LoadedFile {
    /| Borrows the loaded file bytes `&[u8]` (guaranteed NUL-terminated at `ptr[len]` when `nul_sentinel: true`).
    @std_cap_boundary(clears: [unsafe_op]) @no_alloc @no_panic
    pub fn as_slice(&self) -> &[u8] {
        match self {
            .ArenaBuf(slice_val) => slice_val,
            .Mapped(&mmap_ref) => {
                if mmap_ref.len_bytes == 0_usize {
                    return subslice_u8(STATIC_NUL_SENTINEL, 0_usize, 0_usize);
                }
                unsafe {
                    @slice_from_raw_parts(mmap_ref.ptr, mmap_ref.len_bytes)
                }
            },
        }
    }

    /| Validates and borrows `self` as UTF-8 `str`, returning `.Err(.InvalidData)` on non-UTF-8 bytes.
    @std_cap_boundary(clears: [unsafe_op]) @no_alloc @no_panic
    pub fn as_str(&self) -> str!FsError {
        let bytes: &[u8] = self.as_slice();
        if is_valid_utf8(bytes) {
            return .Ok(
                unsafe {
                    @str_from_utf8_unchecked(bytes)
                },
            );
        }
        .Err(FsError.from_kind(.InvalidData, op: .Read))
    }

    /| Returns the byte length of `self`.
    @no_alloc @no_panic
    pub fn len(&self) -> usize = self.as_slice().len();

    /| Returns `true` when `self.len() == 0`.
    @no_alloc @no_panic
    pub fn is_empty(&self) -> bool = self.as_slice().is_empty();

    /| Releases any backing `Mmap` (`ArenaBuf` is a zero-cost no-op; `@linear` consumer).
    @std_cap_boundary(emits: [fs, blocking_sync], clears: [ffi, unsafe_op, indirect_opaque])
    pub fn close(own self) {
        match self {
            .ArenaBuf(_) => {},
            .Mapped(mmap_val) => mmap_val.close(),
        }
    }
}

/| Loads `path` using the canonical `16 KiB` threshold (`< threshold` -> `Arena` + `\0`; `>= threshold` -> `Mmap`, `STD-02` §2.3).
@std_cap_boundary(emits: [fs, blocking_sync], clears: [ffi, unsafe_op, indirect_opaque])
pub fn load_file_thresholded[P: str | Path](
    arena: &mut Arena,
    path: P,
    /,
    *,
    threshold: usize = MMAP_THRESHOLD_BYTES,
    nul_sentinel: bool = true,
) -> LoadedFile!FsError {
    let path_bytes: &[u8] = path.as_bytes();
    var file: File = File.open(path)?;
    let meta: Metadata = file.metadata() catch |meta_err| {
        file.close();
        return .Err(meta_err);
    };
    if not meta.is_file() {
        file.close();
        return .Err(attach_failed_path(FsError.from_kind(.InvalidInput, op: .Read), path_bytes));
    }

    // [1] Probe `meta.size == 0` with a stack read first so virtual `0`-byte procfs/sysfs files stream cleanly:
    if meta.size == 0_u64 {
        var probe_buf: [u8; 4_096] = [0_u8; 4_096];
        var first_n = 0_usize;
        while true {
            var probe_out = OutBuf.over_slice(&mut probe_buf);
            let got_probe: usize = file.read_out(&mut probe_out) catch |probe_err| {
                if probe_err.is_interrupted() {
                    continue;
                }
                file.close();
                return .Err(attach_failed_path(FsError.from_io(probe_err, op: .Read), path_bytes));
            };
            first_n = got_probe;
            break;
        }
        if first_n == 0_usize {
            file.close();
            return .Ok(.ArenaBuf(subslice_u8(STATIC_NUL_SENTINEL, 0_usize, 0_usize)));
        }
        let virt_res: LoadedFile!FsError = stream_file_into_arena(
            arena,
            &mut file,
            subslice_u8(&probe_buf, 0_usize, first_n),
            16_384_usize,
            nul_sentinel,
            path_bytes,
        );
        file.close();
        return virt_res;
    }
    if meta.size > ((usize.MAX -% 2_usize) as u64) {
        file.close();
        return .Err(attach_failed_path(FsError.from_kind(.OutOfMemory, op: .Read), path_bytes));
    }
    let file_len = meta.size as usize;

    // [2] Files `>= threshold` try read-only `Mmap` first, verifying the page-tail `\0` sentinel when `nul_sentinel`:
    if file_len >= threshold
        and Mmap.open_read_only(&file, require_nul_sentinel: nul_sentinel) is .Ok(mapped) {
        let tail_ok: bool = if not nul_sentinel or (mapped.len() & 4_095_usize) == 0_usize {
            not nul_sentinel
        } else {
            unsafe {
                mapped.ptr.add(mapped.len()).read() == 0_u8
            }
        };
        if tail_ok {
            file.close();
            return .Ok(.Mapped(mapped));
        }
        mapped.close();
    }

    // [3] Stream into `Arena` until EOF (growing on concurrent appends) with trailing `\0` lexer sentinel:
    let stream_res: LoadedFile!FsError = stream_file_into_arena(
        arena,
        &mut file,
        EMPTY_BYTES,
        file_len,
        nul_sentinel,
        path_bytes,
    );
    file.close();
    stream_res
}

// ------------- Path Resolution & Convenience I/O --------------
/| Resolves all symlinks, junctions, `.`, and `..` components of an existing `path` (`AGENTS.md` §6, `STD-02` §2.3).
@std_cap_boundary(emits: [fs, blocking_sync], clears: [ffi, unsafe_op, indirect_opaque])
pub fn resolve_path[P: str | Path](path: P, /) -> PathBuf!FsError {
    let path_bytes: &[u8] = path.as_bytes();
    var sim_out: [u8; 1_024] = [0_u8; 1_024];
    var req = SimResolveReq {
        path_ptr: path_bytes.as_ptr(),
        path_len: path_bytes.len(),
        out_ptr: &raw mut sim_out[0],
        out_cap: 1_024_usize,
        written_len: 0_usize,
    };
    if try_reactor_fs_submit(
        SIM_OP_FS_RESOLVE,
        0_u8,
        -1,
        0_u64,
        (&raw mut req) as *mut u8,
        @size_of[SimResolveReq](),
        0_u32,
    ) is .Some(sim_rc) {
        if sim_rc < 0_i64 {
            return .Err(sim_rc_to_fs_error(sim_rc, .Resolve, path_bytes));
        }
        if req.written_len > 0_usize and req.written_len <= 1_024_usize {
            let sim_slice: &[u8] = unsafe {
                @slice_from_raw_parts(&raw sim_out[0], req.written_len)
            };
            return .Ok(PathBuf.from(sim_slice));
        }
        return .Ok(Path.from_bytes(path_bytes).normalize_lexical());
    }
    os_resolve_path(path_bytes)
}

/| Resolves `path` directly into caller `arena`, returning a borrowed `Path` view (`AGENTS.md` §6, `STD-02` §2.3).
@std_cap_boundary(emits: [fs, blocking_sync], clears: [ffi, unsafe_op, indirect_opaque])
pub fn resolve_path_in[P: str | Path](arena: &mut Arena, path: P, /) -> Path!FsError {
    let path_bytes: &[u8] = path.as_bytes();
    var sim_out: [u8; 1_024] = [0_u8; 1_024];
    var req = SimResolveReq {
        path_ptr: path_bytes.as_ptr(),
        path_len: path_bytes.len(),
        out_ptr: &raw mut sim_out[0],
        out_cap: 1_024_usize,
        written_len: 0_usize,
    };
    if try_reactor_fs_submit(
        SIM_OP_FS_RESOLVE,
        0_u8,
        -1,
        0_u64,
        (&raw mut req) as *mut u8,
        @size_of[SimResolveReq](),
        0_u32,
    ) is .Some(sim_rc) {
        if sim_rc < 0_i64 {
            return .Err(sim_rc_to_fs_error(sim_rc, .Resolve, path_bytes));
        }
        if req.written_len > 0_usize and req.written_len <= 1_024_usize {
            let sim_slice: &[u8] = unsafe {
                @slice_from_raw_parts(&raw sim_out[0], req.written_len)
            };
            return .Ok(Path.from_bytes(sim_slice).normalize_lexical_in(arena));
        }
        return .Ok(Path.from_bytes(path_bytes).normalize_lexical_in(arena));
    }
    let resolved_pb: PathBuf = os_resolve_path(path_bytes)?;
    let bytes: &[u8] = resolved_pb.as_bytes();
    let copy_ptr: *mut u8 = arena
        .as_handle()
        .alloc(Layout { size: bytes.len(), alignment: 1_usize })
        catch {
            return .Err(FsError.from_kind(.OutOfMemory, op: .Resolve));
        };
    if bytes.len() > 0_usize {
        unsafe {
            @memcpy(copy_ptr as *mut opaque, bytes.as_ptr() as *opaque, bytes.len());
        }
    }
    let arena_slice: &[u8] = unsafe {
        @slice_from_raw_parts(copy_ptr as *u8, bytes.len())
    };
    .Ok(Path.from_bytes(arena_slice))
}

/| Creates missing target/parent directories according to `kind` and returns the canonical `PathBuf` (`AGENTS.md` §6).
@std_cap_boundary(emits: [fs, blocking_sync], clears: [ffi, unsafe_op, indirect_opaque])
pub fn resolve_or_create_path[P: str | Path](
    path: P,
    /,
    *,
    kind: CreateTargetKind = .Dir,
    perms: FilePermissions = FilePermissions.DEFAULT_DIR,
) -> PathBuf!FsError {
    let path_bytes: &[u8] = path.as_bytes();
    let view = Path.from_bytes(path_bytes);
    if view.is_empty() {
        return .Err(FsError.from_kind(.InvalidInput, op: .Resolve));
    }

    var sim_out: [u8; 1_024] = [0_u8; 1_024];
    var req = SimResolveReq {
        path_ptr: path_bytes.as_ptr(),
        path_len: path_bytes.len(),
        out_ptr: &raw mut sim_out[0],
        out_cap: 1_024_usize,
        written_len: 0_usize,
    };
    if try_reactor_fs_submit(
        SIM_OP_FS_RESOLVE,
        1_u8 +% (kind as u8),
        -1,
        perms.posix_mode as u64,
        (&raw mut req) as *mut u8,
        @size_of[SimResolveReq](),
        0_u32,
    ) is .Some(sim_rc) {
        if sim_rc < 0_i64 {
            return .Err(sim_rc_to_fs_error(sim_rc, .Resolve, path_bytes));
        }
        if req.written_len > 0_usize and req.written_len <= 1_024_usize {
            let sim_slice: &[u8] = unsafe {
                @slice_from_raw_parts(&raw sim_out[0], req.written_len)
            };
            return .Ok(PathBuf.from(sim_slice));
        }
        return .Ok(view.normalize_lexical());
    }

    match kind {
        .Dir => {
            create_dir_all_inner(view, perms, 0_usize)?;
            os_resolve_path(path_bytes)
        },
        .FileParent => {
            let (parent_dir, leaf_bytes) = split_parent_and_leaf(view, .Resolve)?;
            create_dir_all_inner(parent_dir, perms, 0_usize)?;
            let canon_parent: PathBuf = os_resolve_path(parent_dir.as_bytes())?;
            .Ok(canon_parent.as_path().join(Path.from_bytes(leaf_bytes)))
        },
        .File => {
            let (parent_dir, _) = split_parent_and_leaf(view, .Resolve)?;
            create_dir_all_inner(parent_dir, perms, 0_usize)?;
            if os_path_metadata(path_bytes, true) is .Err(_) {
                let file_perms: FilePermissions = if perms == FilePermissions.DEFAULT_DIR => FilePermissions.DEFAULT_FILE
                    else perms;
                let touched: File = File.open_with(
                    view,
                    OpenOptions {
                        flags: OpenFlags {
                            read: false,
                            write: true,
                            append: true,
                            create: true,
                            create_new: false,
                            truncate: false,
                            no_follow: false,
                            sync_data: false,
                            lock_shared: false,
                            lock_exclusive: false,
                            nonblocking_lock: false,
                            reserved: 0_u8,
                        },
                        permissions: file_perms,
                    },
                )?;
                touched.close();
            }
            os_resolve_path(path_bytes)
        },
    }
}

/| Reads the entire regular file at `path` into a `Vec[u8]` (bounded by `max_bytes`, default `256 MiB`).
@std_cap_boundary(emits: [fs, blocking_sync], clears: [ffi, unsafe_op, indirect_opaque])
pub fn read_to_bytes[P: str | Path](
    path: P,
    /,
    *,
    max_bytes: usize = 268_435_456,
) -> Vec[u8]!FsError {
    var file: File = File.open(path)?;
    var out_vec = Vec[u8].new();
    if file.metadata() is .Ok(meta) and meta.is_file() and meta.size > 0_u64 {
        if meta.size > (max_bytes as u64) {
            file.close();
            return .Err(
                attach_failed_path(FsError.from_kind(.StreamTooLong, op: .Read), path.as_bytes()),
            );
        }
        out_vec.try_reserve(meta.size as usize) catch {
            file.close();
            return .Err(
                attach_failed_path(FsError.from_kind(.OutOfMemory, op: .Read), path.as_bytes()),
            );
        };
    }
    var reader: Reader = file.as_reader();
    let read_res: usize!IoError = reader.read_to_end(&mut out_vec, max_bytes: max_bytes);
    file.close();
    if read_res is .Err(io_err) {
        return .Err(attach_failed_path(FsError.from_io(io_err, op: .Read), path.as_bytes()));
    }
    .Ok(out_vec)
}

/| Reads the entire UTF-8 file at `path` into an owned `String` (returning `.Err(.InvalidData)` on invalid UTF-8).
@std_cap_boundary(emits: [fs, blocking_sync], clears: [ffi, unsafe_op, indirect_opaque])
pub fn read_to_string[P: str | Path](
    path: P,
    /,
    *,
    max_bytes: usize = 268_435_456,
) -> String!FsError {
    let raw_vec: Vec[u8] = read_to_bytes(path, max_bytes: max_bytes)?;
    let owned_str: String = String.from_utf8(own raw_vec) catch {
        return .Err(attach_failed_path(FsError.from_kind(.InvalidData, op: .Read), path.as_bytes()));
    };
    .Ok(owned_str)
}

/| Returns `true` if `path` exists and is accessible (following symlinks).
@std_cap_boundary(emits: [fs, blocking_sync], clears: [ffi, unsafe_op, indirect_opaque])
pub fn exists[P: str | Path](path: P, /) -> bool {
    metadata(path) is .Ok(_)
}

/| Queries `Metadata` for `path`, following symlinks.
@std_cap_boundary(emits: [fs, blocking_sync], clears: [ffi, unsafe_op, indirect_opaque])
pub fn metadata[P: str | Path](path: P, /) -> Metadata!FsError {
    let path_bytes: &[u8] = path.as_bytes();
    var sim_meta = Metadata {
        file_type: .RegularFile,
        size: 0_u64,
        permissions: FilePermissions.DEFAULT_FILE,
        modified: .None,
        accessed: .None,
        created: .None,
        dev_id: 0_u64,
        inode_or_file_id: 0_u64,
        hardlink_count: 1_u32,
    };
    if try_reactor_fs_submit(
        SIM_OP_FS_STAT,
        1_u8,
        -1,
        (path_bytes.as_ptr() as usize) as u64,
        (&raw mut sim_meta) as *mut u8,
        path_bytes.len(),
        0_u32,
    ) is .Some(sim_rc) {
        if sim_rc < 0_i64 {
            return .Err(sim_rc_to_fs_error(sim_rc, .Stat, path_bytes));
        }
        return .Ok(sim_meta);
    }
    os_path_metadata(path_bytes, true)
}

/| Queries `Metadata` for `path` without following terminal symlinks/reparse points (`lstat`).
@std_cap_boundary(emits: [fs, blocking_sync], clears: [ffi, unsafe_op, indirect_opaque])
pub fn symlink_metadata[P: str | Path](path: P, /) -> Metadata!FsError {
    let path_bytes: &[u8] = path.as_bytes();
    var sim_meta = Metadata {
        file_type: .RegularFile,
        size: 0_u64,
        permissions: FilePermissions.DEFAULT_FILE,
        modified: .None,
        accessed: .None,
        created: .None,
        dev_id: 0_u64,
        inode_or_file_id: 0_u64,
        hardlink_count: 1_u32,
    };
    if try_reactor_fs_submit(
        SIM_OP_FS_STAT,
        3_u8,
        -1,
        (path_bytes.as_ptr() as usize) as u64,
        (&raw mut sim_meta) as *mut u8,
        path_bytes.len(),
        0_u32,
    ) is .Some(sim_rc) {
        if sim_rc < 0_i64 {
            return .Err(sim_rc_to_fs_error(sim_rc, .Stat, path_bytes));
        }
        return .Ok(sim_meta);
    }
    os_path_metadata(path_bytes, false)
}

/| Creates `path` and all missing parent directories idempotently (`STD-02` §2.3).
@std_cap_boundary(emits: [fs, blocking_sync], clears: [ffi, unsafe_op, indirect_opaque])
pub fn create_dir_all[P: str | Path](
    path: P,
    /,
    *,
    perms: FilePermissions = FilePermissions.DEFAULT_DIR,
) -> unit!FsError {
    let path_bytes: &[u8] = path.as_bytes();
    var req = SimPathOpReq {
        path_ptr: path_bytes.as_ptr(),
        path_len: path_bytes.len(),
        dst_ptr: @default_init[*u8](),
        dst_len: 0_usize,
        aux_flags: 2_u32,
        mode_bits: perms.posix_mode as u32,
    };
    if try_reactor_fs_submit(
        SIM_OP_FS_DIR_OP,
        4_u8,
        -1,
        0_u64,
        (&raw mut req) as *mut u8,
        @size_of[SimPathOpReq](),
        0_u32,
    ) is .Some(sim_rc) {
        if sim_rc < 0_i64 {
            return .Err(sim_rc_to_fs_error(sim_rc, .Mkdir, path_bytes));
        }
        return .Ok(());
    }
    create_dir_all_inner(Path.from_bytes(path_bytes), perms, 0_usize)
}

/| Unlinks a regular file or symlink at `path` (`POSIX_SEMANTICS` on Windows 10 1709+).
@std_cap_boundary(emits: [fs, blocking_sync], clears: [ffi, unsafe_op, indirect_opaque])
pub fn remove_file[P: str | Path](path: P, /) -> unit!FsError {
    let path_bytes: &[u8] = path.as_bytes();
    var req = SimPathOpReq {
        path_ptr: path_bytes.as_ptr(),
        path_len: path_bytes.len(),
        dst_ptr: @default_init[*u8](),
        dst_len: 0_usize,
        aux_flags: 0_u32,
        mode_bits: 0_u32,
    };
    if try_reactor_fs_submit(
        SIM_OP_FS_DIR_OP,
        5_u8,
        -1,
        0_u64,
        (&raw mut req) as *mut u8,
        @size_of[SimPathOpReq](),
        0_u32,
    ) is .Some(sim_rc) {
        if sim_rc < 0_i64 {
            return .Err(sim_rc_to_fs_error(sim_rc, .Unlink, path_bytes));
        }
        return .Ok(());
    }
    os_remove_file(path_bytes)
}

/| Recursively deletes `path` and all children without following symlinks or NTFS junctions (`STD-02` §2.3).
@std_cap_boundary(emits: [fs, blocking_sync], clears: [ffi, unsafe_op, indirect_opaque])
pub fn remove_dir_all[P: str | Path](path: P, /) -> unit!FsError {
    let path_bytes: &[u8] = path.as_bytes();
    var req = SimPathOpReq {
        path_ptr: path_bytes.as_ptr(),
        path_len: path_bytes.len(),
        dst_ptr: @default_init[*u8](),
        dst_len: 0_usize,
        aux_flags: 1_u32,
        mode_bits: 0_u32,
    };
    if try_reactor_fs_submit(
        SIM_OP_FS_DIR_OP,
        6_u8,
        -1,
        0_u64,
        (&raw mut req) as *mut u8,
        @size_of[SimPathOpReq](),
        0_u32,
    ) is .Some(sim_rc) {
        if sim_rc < 0_i64 {
            return .Err(sim_rc_to_fs_error(sim_rc, .Unlink, path_bytes));
        }
        return .Ok(());
    }
    remove_dir_all_inner(Path.from_bytes(path_bytes), 0_usize)
}

// --------------- Atomic Publish, CoW & FileLock ---------------
impl StagedAtomicFile {
    /| Creates a fresh-inode temporary file in `dst_path`'s directory for atomic `UnlinkAndReplace` (`STD-02` §3.3).
    @std_cap_boundary(emits: [fs, blocking_sync], clears: [ffi, unsafe_op, indirect_opaque])
    pub fn create[P: str | Path](
        dst_path: P,
        /,
        *,
        perms: FilePermissions = FilePermissions.DEFAULT_FILE,
    ) -> StagedAtomicFile!FsError {
        let dst_bytes: &[u8] = dst_path.as_bytes();
        var req = SimPathOpReq {
            path_ptr: dst_bytes.as_ptr(),
            path_len: dst_bytes.len(),
            dst_ptr: dst_bytes.as_ptr(),
            dst_len: dst_bytes.len(),
            aux_flags: 1_u32,
            mode_bits: perms.posix_mode as u32,
        };
        if try_reactor_fs_submit(
            SIM_OP_FS_RENAME_ATOMIC,
            0_u8,
            -1,
            0_u64,
            (&raw mut req) as *mut u8,
            @size_of[SimPathOpReq](),
            0_u32,
        ) is .Some(sim_rc) {
            if sim_rc < 0_i64 {
                return .Err(sim_rc_to_fs_error(sim_rc, .Open, dst_bytes));
            }
            return .Ok(
                StagedAtomicFile {
                    file: File { raw_fd: sim_i32_to_raw_fd(sim_rc as i32) },
                    parent_dir_fd: -1_isize,
                    tmp_path: PathBuf.from(dst_bytes),
                    dst_path: PathBuf.from(dst_bytes),
                    perms,
                },
            );
        }
        os_staged_atomic_create(dst_bytes, perms)
    }

    /| Borrows the underlying staged `File` mutably.
    @no_alloc @no_panic
    pub fn file_mut(&mut self) -> &mut File = &mut self.file;

    /| Borrows the staged file as a zero-allocation `cx.io.Writer`.
    @no_alloc @no_panic
    pub fn as_writer(&mut self) -> Writer = self.file.as_writer();

    /| Flushes according to `durability` and atomically replaces `dst_path` (`@linear` consumer, `STD-02` §3.3).
    @std_cap_boundary(emits: [fs, blocking_sync], clears: [ffi, unsafe_op, indirect_opaque])
    pub fn publish(own self, *, durability: DurabilityMode = .CrashSafe) -> unit!FsError {
        let tmp_slice: &[u8] = self.tmp_path.as_bytes();
        let dst_slice: &[u8] = self.dst_path.as_bytes();
        var req = SimPathOpReq {
            path_ptr: tmp_slice.as_ptr(),
            path_len: tmp_slice.len(),
            dst_ptr: dst_slice.as_ptr(),
            dst_len: dst_slice.len(),
            aux_flags: durability as u32,
            mode_bits: self.perms.posix_mode as u32,
        };
        if try_reactor_fs_submit(
            SIM_OP_FS_RENAME_ATOMIC,
            1_u8,
            raw_fd_to_sim_i32(self.file.raw_fd),
            0_u64,
            (&raw mut req) as *mut u8,
            @size_of[SimPathOpReq](),
            0_u32,
        ) is .Some(sim_rc) {
            let StagedAtomicFile { file, parent_dir_fd, tmp_path, dst_path, perms } = self;
            let File { raw_fd } = file;
            _ = raw_fd;
            _ = parent_dir_fd;
            _ = tmp_path;
            _ = perms;
            if sim_rc < 0_i64 {
                return .Err(sim_rc_to_fs_error(sim_rc, .Rename, dst_path.as_bytes()));
            }
            return .Ok(());
        }
        os_staged_atomic_publish(own self, durability)
    }

    /| Closes and unlinks the staged temporary file without modifying `dst_path` (`@linear` consumer).
    @std_cap_boundary(emits: [fs, blocking_sync], clears: [ffi, unsafe_op, indirect_opaque])
    pub fn abort(own self) {
        if try_reactor_fs_submit(
            SIM_OP_FS_RENAME_ATOMIC,
            2_u8,
            raw_fd_to_sim_i32(self.file.raw_fd),
            0_u64,
            @default_init[*mut u8](),
            0_usize,
            0_u32,
        ) is .Some(_) {
            let StagedAtomicFile { file, parent_dir_fd, tmp_path, dst_path, perms } = self;
            let File { raw_fd } = file;
            _ = raw_fd;
            _ = parent_dir_fd;
            _ = tmp_path;
            _ = dst_path;
            _ = perms;
            return;
        }
        os_staged_atomic_abort(own self);
    }
}

/| Writes `bytes` into a fresh sibling file and atomically publishes it onto `dst_path` (`UnlinkAndReplace`, `STD-02` §3.3).
@std_cap_boundary(emits: [fs, blocking_sync], clears: [ffi, unsafe_op, indirect_opaque])
pub fn write_atomic[P: str | Path](
    dst_path: P,
    bytes: &[u8],
    /,
    *,
    perms: FilePermissions = FilePermissions.DEFAULT_FILE,
    durability: DurabilityMode = .CrashSafe,
) -> unit!FsError {
    var staged: StagedAtomicFile = StagedAtomicFile.create(dst_path, perms: perms)?;
    if staged.file.write_all(bytes) is .Err(write_err) {
        staged.abort();
        return .Err(attach_failed_path(FsError.from_io(write_err, op: .Write), dst_path.as_bytes()));
    }
    staged.publish(durability: durability)
}

/| Atomically publishes an already-written `staged_tmp_path` onto `dst_path` (`STD-02` §2.3, §3.3).
@std_cap_boundary(emits: [fs, blocking_sync], clears: [ffi, unsafe_op, indirect_opaque])
pub fn publish_staged_atomic[P1: str | Path, P2: str | Path](
    staged_tmp_path: P1,
    dst_path: P2,
    /,
    *,
    durability: DurabilityMode = .CrashSafe,
) -> unit!FsError {
    let staged_bytes: &[u8] = staged_tmp_path.as_bytes();
    let dst_bytes: &[u8] = dst_path.as_bytes();
    var req = SimPathOpReq {
        path_ptr: staged_bytes.as_ptr(),
        path_len: staged_bytes.len(),
        dst_ptr: dst_bytes.as_ptr(),
        dst_len: dst_bytes.len(),
        aux_flags: durability as u32,
        mode_bits: 0_u32,
    };
    if try_reactor_fs_submit(
        SIM_OP_FS_RENAME_ATOMIC,
        3_u8,
        -1,
        0_u64,
        (&raw mut req) as *mut u8,
        @size_of[SimPathOpReq](),
        0_u32,
    ) is .Some(sim_rc) {
        if sim_rc < 0_i64 {
            return .Err(sim_rc_to_fs_error(sim_rc, .Rename, dst_bytes));
        }
        return .Ok(());
    }
    os_publish_staged_path(staged_bytes, dst_bytes, durability)
}

/| Materializes `src` at `dst` via 3-tier `Reflink -> Hardlink (ImmutableCas) -> Kernel/64 KiB Copy` (`STD-02` §3.4A).
@std_cap_boundary(emits: [fs, blocking_sync], clears: [ffi, unsafe_op, indirect_opaque])
pub fn materialize_file[P1: str | Path, P2: str | Path](
    src: P1,
    dst: P2,
    /,
    *,
    policy: MaterializePolicy = .ReflinkOrCopy,
    overwrite: bool = true,
) -> MaterializeMethod!FsError {
    let src_bytes: &[u8] = src.as_bytes();
    let dst_bytes: &[u8] = dst.as_bytes();
    var req = SimPathOpReq {
        path_ptr: src_bytes.as_ptr(),
        path_len: src_bytes.len(),
        dst_ptr: dst_bytes.as_ptr(),
        dst_len: dst_bytes.len(),
        aux_flags: policy as u32,
        mode_bits: if overwrite => 1_u32 else 0_u32,
    };
    if try_reactor_fs_submit(
        SIM_OP_FS_MATERIALIZE,
        policy as u8,
        -1,
        0_u64,
        (&raw mut req) as *mut u8,
        @size_of[SimPathOpReq](),
        0_u32,
    ) is .Some(sim_rc) {
        if sim_rc < 0_i64 {
            return .Err(sim_rc_to_fs_error(sim_rc, .Clone, dst_bytes));
        }
        return match sim_rc {
            0_i64 => .Ok(.Reflinked),
            1_i64 => .Ok(.Hardlinked),
            _ => .Ok(.Copied),
        };
    }

    let src_meta: Metadata = os_path_metadata(src_bytes, true)?;
    if not src_meta.is_file() {
        return .Err(attach_failed_path(FsError.from_kind(.InvalidInput, op: .Clone), src_bytes));
    }
    if os_path_metadata(dst_bytes, false) is .Ok(dst_meta) {
        if not overwrite {
            return .Err(attach_failed_path(FsError.from_kind(.AlreadyExists, op: .Clone), dst_bytes));
        }
        // Guard against self-clobbering when `src` and non-symlink `dst` share `(dev_id, inode_or_file_id)`:
        if not dst_meta.is_symlink()
            and src_meta.dev_id != 0_u64
            and src_meta.inode_or_file_id != 0_u64
            and src_meta.dev_id == dst_meta.dev_id
            and src_meta.inode_or_file_id == dst_meta.inode_or_file_id {
            return .Ok(.Copied);
        }
    }
    os_materialize_file(src_bytes, dst_bytes, src_meta, policy)
}

impl FileLock {
    /| Acquires an advisory `Shared` or `Exclusive` lock on `lock_path` (`STD-02` §1.2, §2.3).
    @std_cap_boundary(emits: [fs, blocking_sync], clears: [ffi, unsafe_op, indirect_opaque])
    pub fn acquire[P: str | Path](
        lock_path: P,
        /,
        *,
        mode: LockMode = .Exclusive,
        nonblocking: bool = false,
    ) -> FileLock!FsError {
        let path_bytes: &[u8] = lock_path.as_bytes();
        var req = SimPathOpReq {
            path_ptr: path_bytes.as_ptr(),
            path_len: path_bytes.len(),
            dst_ptr: @default_init[*u8](),
            dst_len: 0_usize,
            aux_flags: mode as u32,
            mode_bits: if nonblocking => 1_u32 else 0_u32,
        };
        if try_reactor_fs_submit(
            SIM_OP_FS_LOCK,
            mode as u8,
            -1,
            if nonblocking => 1_u64 else 0_u64,
            (&raw mut req) as *mut u8,
            @size_of[SimPathOpReq](),
            0_u32,
        ) is .Some(sim_rc) {
            if sim_rc < 0_i64 {
                return .Err(sim_rc_to_fs_error(sim_rc, .Lock, path_bytes));
            }
            return .Ok(make_sim_file_lock(sim_rc as i32));
        }
        os_file_lock_acquire(path_bytes, mode, nonblocking)
    }

    /| Releases the advisory lock and closes the descriptor (`@linear` consumer; never unlinks on native OSes).
    @std_cap_boundary(emits: [fs, blocking_sync], clears: [ffi, unsafe_op, indirect_opaque])
    pub fn unlock_and_close(own self) {
        if try_reactor_fs_submit(
            SIM_OP_FS_LOCK,
            2_u8,
            raw_fd_to_sim_i32(self.file.raw_fd),
            0_u64,
            @default_init[*mut u8](),
            0_usize,
            0_u32,
        ) is .Some(_) {
            consume_sim_file_lock(own self);
            return;
        }
        os_file_lock_release(own self);
    }
}

// ---------------- Cross-OS Filesystem Watcher -----------------
impl WatchMask {
    /| Default recursive subscription mask (`create | modify | remove | rename | recursive`).
    pub const ALL_RECURSIVE: WatchMask = WatchMask {
        create: true,
        modify: true,
        remove: true,
        rename: true,
        attrib: false,
        recursive: true,
        reserved: 0_u16,
    };
}

impl TrivialDrop for WatchMask {}

impl TrivialDrop for WatchEventFlags {}

impl TrivialDrop for WatchId {}

impl Clone for WatchEvent {
    /| Returns an owned duplicate of `self`.
    pub fn clone(&self) -> WatchEvent {
        WatchEvent {
            watch_id: self.watch_id,
            path: self.path.clone(),
            flags: self.flags,
            rename_cookie: self.rename_cookie,
        }
    }
}

impl Debug for WatchEvent {
    /| Formats `self` structurally into `out`.
    @no_alloc
    pub fn fmt_debug(&self, out: &mut FmtWriter, spec: FmtSpec, /) -> unit!FmtError {
        _ = spec;
        let wid_u32 = self.watch_id as u32;
        @fmt_write(
            out,
            f"WatchEvent {{ watch_id: {wid_u32}, path: {self.path:?}, flags: {self.flags:?}, rename_cookie: {self.rename_cookie} }}",
        )
    }
}

impl FsWatcher {
    /| Creates a new `@linear` filesystem watcher (`inotify` / `kqueue` / `ReadDirectoryChangesW`).
    @std_cap_boundary(emits: [fs, blocking_sync], clears: [ffi, unsafe_op, indirect_opaque])
    pub fn new() -> FsWatcher!FsError {
        if try_reactor_fs_submit(
            SIM_OP_FS_WATCH_POLL,
            0_u8,
            -1,
            0_u64,
            @default_init[*mut u8](),
            0_usize,
            0_u32,
        ) is .Some(sim_rc) {
            if sim_rc < 0_i64 {
                return .Err(sim_rc_to_fs_error(sim_rc, .Watch, EMPTY_BYTES));
            }
            return .Ok(FsWatcher { backend_state: (sim_rc as usize) as *mut opaque });
        }
        let backend_state: *mut opaque = os_watcher_new()?;
        .Ok(FsWatcher { backend_state })
    }

    /| Subscribes to filesystem notifications on `path` and returns its `WatchId`.
    @std_cap_boundary(emits: [fs, blocking_sync], clears: [ffi, unsafe_op, indirect_opaque])
    pub fn watch[P: str | Path](
        &mut self,
        path: P,
        /,
        *,
        mask: WatchMask = WatchMask.ALL_RECURSIVE,
    ) -> WatchId!FsError {
        let path_bytes: &[u8] = path.as_bytes();
        var req = SimPathOpReq {
            path_ptr: path_bytes.as_ptr(),
            path_len: path_bytes.len(),
            dst_ptr: @default_init[*u8](),
            dst_len: 0_usize,
            aux_flags: @bit_cast[u16](mask) as u32,
            mode_bits: 0_u32,
        };
        if try_reactor_fs_submit(
            SIM_OP_FS_WATCH_POLL,
            1_u8,
            (self.backend_state as usize) as i32,
            0_u64,
            (&raw mut req) as *mut u8,
            @size_of[SimPathOpReq](),
            0_u32,
        ) is .Some(sim_rc) {
            if sim_rc < 0_i64 {
                return .Err(sim_rc_to_fs_error(sim_rc, .Watch, path_bytes));
            }
            return .Ok((sim_rc as u32) as WatchId);
        }
        os_watcher_watch(self.backend_state, path_bytes, mask)
    }

    /| Removes an active watch subscription identified by `id`.
    @std_cap_boundary(emits: [fs, blocking_sync], clears: [ffi, unsafe_op, indirect_opaque])
    pub fn unwatch(&mut self, id: WatchId, /) -> unit!FsError {
        if try_reactor_fs_submit(
            SIM_OP_FS_WATCH_POLL,
            2_u8,
            (self.backend_state as usize) as i32,
            (id as u32) as u64,
            @default_init[*mut u8](),
            0_usize,
            0_u32,
        ) is .Some(sim_rc) {
            if sim_rc < 0_i64 {
                return .Err(sim_rc_to_fs_error(sim_rc, .Watch, EMPTY_BYTES));
            }
            return .Ok(());
        }
        os_watcher_unwatch(self.backend_state, id)
    }

    /| Polls pending `WatchEvent`s into `out_events`, waiting up to `timeout` (`None` = indefinite).
    @std_cap_boundary(emits: [fs, clock, blocking_sync], clears: [ffi, unsafe_op, indirect_opaque])
    pub fn poll_events(
        &mut self,
        out_events: &mut Vec[WatchEvent],
        /,
        *,
        timeout: Duration? = .None,
    ) -> usize!FsError {
        let timeout_ns: u64 = match timeout {
            .Some(dur) => dur.as_nanos(),
            .None => u64.MAX,
        };
        if try_reactor_fs_submit(
            SIM_OP_FS_WATCH_POLL,
            3_u8,
            (self.backend_state as usize) as i32,
            timeout_ns,
            (&raw mut out_events.*) as *mut u8,
            0_usize,
            0_u32,
        ) is .Some(sim_rc) {
            if sim_rc < 0_i64 {
                return .Err(sim_rc_to_fs_error(sim_rc, .Watch, EMPTY_BYTES));
            }
            return .Ok(sim_rc as usize);
        }
        os_watcher_poll(self.backend_state, out_events, timeout)
    }

    /| Closes `self` and releases all OS watcher handles (`@linear` consumer).
    @std_cap_boundary(emits: [fs, blocking_sync], clears: [ffi, unsafe_op, indirect_opaque])
    pub fn close(own self) {
        let FsWatcher { backend_state } = self;
        if try_reactor_fs_submit(
            SIM_OP_FS_WATCH_POLL,
            4_u8,
            (backend_state as usize) as i32,
            0_u64,
            @default_init[*mut u8](),
            0_usize,
            0_u32,
        ) is .Some(_) {
            return;
        }
        os_watcher_close(backend_state);
    }
}

// ---------------------------------------- TESTS ----------------------------------------
/| Mock simulation state tracking `SIM_OP_FS_*` reactor submissions without touching the host OS.
@repr(C)
struct MockSimFsState {
    /| Number of `submit_io` calls intercepted.
    call_count: u32,
    /| Last `IoSubmission.kind` opcode observed.
    last_opcode: u8,
    /| Next synthetic return value (`>= 0` success or `< 0` negated `SimFault`).
    next_rc: i64,
}

/| Minimal 8-slot C-ABI `ReactorVTable` layout for `--sim` unit tests.
@repr(C)
struct MockFsReactorVTable {
    /| Slot `0`: `monotonic_ns` (`0`).
    monotonic_ns: usize,
    /| Slot `1`: `wall_epoch_ns` (`0`).
    wall_epoch_ns: usize,
    /| Slot `2`: `fill_rng` (`0`).
    fill_rng: usize,
    /| Slot `3`: `submit_io` callback.
    submit_io: (extern "C" fn(*mut opaque, *IoSubmission) -> i64)?,
    /| Slots `4..7`: unused async proactor slots.
    tail_slots: [usize; 4],
}

/| Mock `ReactorVTable.submit_io` callback recording `SIM_OP_FS_*` opcodes.
extern "C" fn mock_fs_submit_cb(ctx_raw: *mut opaque, sub_ptr: *IoSubmission) -> i64 {
    let st_ptr = ctx_raw as *mut MockSimFsState;
    if st_ptr.is_null() {
        return SIM_UNHANDLED_SENTINEL;
    }
    if sub_ptr.is_null() {
        return SIM_UNHANDLED_SENTINEL;
    }
    let sub_val: IoSubmission = unsafe {
        sub_ptr.read()
    };
    let st_ref: &mut MockSimFsState = unsafe {
        &mut st_ptr.*
    };
    st_ref.call_count = st_ref.call_count +% 1_u32;
    st_ref.last_opcode = sub_val.kind;
    st_ref.next_rc
}

/| Helper testing `?` automatic `FromError[IoError] for FsError` upcasting.
fn _test_upcast_io_to_fs(flag: bool, /) -> unit!FsError {
    if flag {
        let io_res: unit!IoError = .Err(IoError.from_kind(.BrokenPipe, op: .Write));
        io_res?;
    }
    .Ok(())
}

/| Helper testing `?` automatic `FromError[FsError] for IoError` upcasting.
fn _test_upcast_fs_to_io(flag: bool, /) -> unit!IoError {
    if flag {
        let fs_res: unit!FsError = .Err(FsError.from_kind(.NotFound, op: .Open));
        fs_res?;
    }
    .Ok(())
}

test "FsError 8B niche layout, bit_field widths, FsDiagPathRing, and FromError upcasting" {
    assert(@size_of[FsError]() == 8_usize);
    assert(@size_of[FsError?]() == 8_usize);
    assert(@size_of[FilePermissions]() == 4_usize);
    assert(@size_of[OpenFlags]() == 2_usize);
    assert(@size_of[WatchMask]() == 2_usize);
    assert(@size_of[WatchEventFlags]() == 2_usize);
    assert(@implements[FsError, TrivialDrop]());

    let fs_err = FsError.from_raw_os(2, domain: .PosixErrno, op: .Open);
    assert(fs_err.kind() == .NotFound);
    assert(fs_err.op() == .Open);
    assert(fs_err.domain() == .PosixErrno);
    assert(fs_err.os_error() == .Some(2));
    assert(fs_err.failed_path() == .None);

    // Bidirectional `?` upcasting between `IoError` and `FsError`:
    let up1: unit!FsError = _test_upcast_io_to_fs(true);
    assert(up1 is .Err(e1) and e1.kind() == .BrokenPipe);
    let up2: unit!IoError = _test_upcast_fs_to_io(true);
    assert(up2 is .Err(e2) and e2.kind() == .NotFound);

    // Scoped `FsDiagPathRing` in `context.diagnostics`:
    var ring = FsDiagPathRing {
        magic_tag: FS_DIAG_RING_MAGIC,
        write_cursor: 0_u32,
        reserved_word: 0_u32,
        slots: [@default_init[FsDiagPathSlot](); 8],
    };
    let ring_mut_ptr: *mut FsDiagPathRing = &raw mut ring;
    let diag_sink_val: DiagSink = unsafe {
        ((&raw ring_mut_ptr) as *DiagSink).read()
    };
    with context.diagnostics = diag_sink_val {
        let tagged_err: FsError = attach_failed_path(
            FsError.from_kind(.PermissionDenied, op: .Open),
            b"sandbox/secret.cx",
        );
        assert(tagged_err.failed_path() == .Some(Path.new("sandbox/secret.cx")));
        var fmt_buf: [u8; 128] = [0_u8; 128];
        let rendered: str = cx.str.format_into(&mut fmt_buf, f"{tagged_err}") catch "";
        assert(rendered == "permission denied: 'sandbox/secret.cx'");

        // Non-`FsDiagPathRing` `8 B` diagnostic sink must reject on `magic_tag` without reading past `8 B`:
        var foreign_tag: u64 = 0xDEAD_BEEF_CAFE_BABE_u64;
        let foreign_ptr: *mut u64 = &raw mut foreign_tag;
        let foreign_sink: DiagSink = unsafe {
            ((&raw foreign_ptr) as *DiagSink).read()
        };
        with context.diagnostics = foreign_sink {
            assert(tagged_err.failed_path() == .None);
            let untagged: FsError = attach_failed_path(
                FsError.from_kind(.NotFound, op: .Open),
                b"ignored.cx",
            );
            assert(untagged.failed_path() == .None);
        }
    }
}

test "Reactor SIM_OP_FS_* interception in zero host syscalls" {
    var sim_state = MockSimFsState {
        call_count: 0_u32,
        last_opcode: 0_u8,
        next_rc: 77_i64,
    };
    let vtable = MockFsReactorVTable {
        monotonic_ns: 0_usize,
        wall_epoch_ns: 0_usize,
        fill_rng: 0_usize,
        submit_io: .Some(mock_fs_submit_cb),
        tail_slots: [0_usize; 4],
    };
    let sim_reactor = Reactor {
        vtable: (&raw vtable) as *cx.async.ReactorVTable,
    };
    let sim_ctx = ReactorCtx { state: (&raw mut sim_state) as *mut opaque };

    with context.reactor = sim_reactor {
        with context.reactor_ctx = sim_ctx {
            var sim_file: File = File.open("virtual/input.cx") catch {
                panic("unexpected sim open error");
            };
            assert(sim_state.last_opcode == SIM_OP_FS_OPEN);
            sim_state.next_rc = 5_i64;
            var file_writer: Writer = sim_file.as_writer();
            let wrote: usize = file_writer.write(b"hello") catch 0_usize;
            assert(wrote == 5_usize);
            assert(sim_state.last_opcode == SIM_OP_FS_RW);
            sim_state.next_rc = 0_i64;
            var file_seeker: Seek = sim_file.as_seeker();
            assert((file_seeker.seek(.Start(0_u64)) catch 99_u64) == 0_u64);
            assert(sim_state.last_opcode == SIM_OP_FS_SEEK);
            var file_reader: Reader = sim_file.as_reader();
            var scratch_rd: [u8; 8] = [0_u8; 8];
            assert((file_reader.read(&mut scratch_rd) catch 99_usize) == 0_usize);
            assert(sim_state.last_opcode == SIM_OP_FS_RW);
            sim_file.close();
            assert(sim_state.last_opcode == SIM_OP_FS_CLOSE);

            // `Dir.*_beneath` must reject `..` and `:` lexically BEFORE submitting to `SimReactor`:
            sim_state.next_rc = 42_i64;
            let sim_dir: Dir = Dir.open("virtual/root") catch {
                panic("unexpected sim dir open error");
            };
            let count_before: u32 = sim_state.call_count;
            assert(
                sim_dir.open_file_beneath("../escape") is .Err(esc1)
                    and esc1.kind() == .FilesystemLoop,
            );
            assert(
                sim_dir.open_dir_beneath("sub/../escape") is .Err(esc2)
                    and esc2.kind() == .FilesystemLoop,
            );
            assert(
                sim_dir.create_dir_beneath("foo:ads") is .Err(ads1)
                    and ads1.kind() == .InvalidFilename,
            );
            assert(
                sim_dir.unlink_file_beneath("C:evil") is .Err(ads2)
                    and ads2.kind() == .InvalidFilename,
            );
            assert(
                sim_dir.metadata_beneath("../leak") is .Err(esc3) and esc3.kind() == .FilesystemLoop,
            );
            assert(sim_state.call_count == count_before);
            sim_state.next_rc = 0_i64;
            sim_dir.close();

            // Simulated `SimFault` injection (`sim_rc = -13` -> `ErrDomain.SimFault`):
            sim_state.next_rc = -13_i64;
            let fault_res: File!FsError = File.open("virtual/denied.cx");
            assert(fault_res is .Err(fe) and fe.domain() == .SimFault and fe.os_error() == .Some(13));
        }
    }
}

@cfg(target.os == "windows" or target.os == "linux" or target.os == "macos")
test "Host filesystem end-to-end: atomic replace over open reader, Dir beneath confinement, Mmap, CoW, Lock, Watcher" {
    let base_dir = Path.new(".cx_fs_self_test_tmp");
    if exists(base_dir) {
        remove_dir_all(base_dir) catch {};
    }
    let canon_root: PathBuf = resolve_or_create_path(base_dir, kind: .Dir) catch |re| {
        panic(f"resolve_or_create_path failed: {re}");
    };
    assert(exists(canon_root.as_path()));

    // [1] `File` create, write, pread, pwrite, seek, set_len, and `read_to_string`:
    let alpha_path: PathBuf = canon_root.as_path().join("alpha.txt");
    var out_f: File = File.create(alpha_path.as_path()) catch |ce| {
        panic(f"File.create failed: {ce}");
    };
    out_f.write_all(b"corex-fs-alpha") catch |we| {
        panic(f"write_all failed: {we}");
    };
    out_f.pwrite_all(b"FS", 6_u64) catch |pwe| {
        panic(f"pwrite_all failed: {pwe}");
    };
    out_f.sync_close() catch |se| {
        panic(f"sync_close failed: {se}");
    };
    let text_alpha: String = read_to_string(alpha_path.as_path()) catch |rse| {
        panic(f"read_to_string failed: {rse}");
    };
    assert(text_alpha.as_str() == "corex-FS-alpha");

    // [2] `UnlinkAndReplace` atomic publish WHILE an existing `File` handle holds `alpha.txt` open!
    var open_reader: File = File.open(alpha_path.as_path()) catch |oe| {
        panic(f"File.open failed: {oe}");
    };
    write_atomic(alpha_path.as_path(), b"atomic-v2-payload", durability: .FastLocal) catch |ae| {
        open_reader.close();
        panic(f"write_atomic over open handle failed: {ae}");
    };
    var old_buf: [u8; 32] = [0_u8; 32];
    let old_n: usize = open_reader.read(&mut old_buf) catch 0_usize;
    open_reader.close();
    assert(old_n == 14_usize);
    let updated_text: String = read_to_string(alpha_path.as_path()) catch {
        panic("read_to_string after write_atomic failed");
    };
    assert(updated_text.as_str() == "atomic-v2-payload");

    // [3] Capability `Dir` `*_beneath` confinement + `..` escape rejection + `DirIter`:
    let cap_dir: Dir = Dir.open(canon_root.as_path()) catch |de| {
        panic(f"Dir.open failed: {de}");
    };
    assert(
        cap_dir.open_file_beneath("../escape.txt") is .Err(esc_e)
            and esc_e.kind() == .FilesystemLoop,
    );
    cap_dir.create_dir_beneath("nested") catch |mke| {
        cap_dir.close();
        panic(f"create_dir_beneath failed: {mke}");
    };
    var sub_f: File = cap_dir.open_file_beneath("nested/item.txt", OpenOptions.write_create())
        catch |sfe| {
            cap_dir.close();
            panic(f"open_file_beneath failed: {sfe}");
        };
    sub_f.write_all(b"confined-ok") catch {};
    sub_f.close();
    let sub_meta: Metadata = cap_dir.metadata_beneath("nested/item.txt") catch |sme| {
        cap_dir.close();
        panic(f"metadata_beneath failed: {sme}");
    };
    assert(sub_meta.is_file() and sub_meta.len() == 11_u64);

    var iter: DirIter = cap_dir.entries() catch |ie| {
        cap_dir.close();
        panic(f"Dir.entries failed: {ie}");
    };
    var entry_count = 0_usize;
    while (iter.next() catch .None) is .Some(_) {
        entry_count = entry_count +% 1_usize;
    }
    iter.close();
    assert(entry_count == 2_usize);
    cap_dir.unlink_file_beneath("nested/item.txt") catch |ue| {
        cap_dir.close();
        panic(f"unlink_file_beneath failed: {ue}");
    };
    cap_dir.close();

    // [4] `16 KiB` `load_file_thresholded` (`0 B`, `< 16 KiB` Arena + `\0`, and `>= 16 KiB` `Mmap`):
    var arena = Arena.new();
    let empty_path: PathBuf = canon_root.as_path().join("empty.cx");
    write_atomic(empty_path.as_path(), b"", durability: .FastLocal) catch {
        panic("empty write_atomic failed");
    };
    let loaded_empty: LoadedFile = load_file_thresholded(&mut arena, empty_path.as_path()) catch {
        panic("load empty failed");
    };
    assert(loaded_empty.is_empty());
    loaded_empty.close();

    let loaded_small: LoadedFile = load_file_thresholded(&mut arena, alpha_path.as_path()) catch {
        panic("load small failed");
    };
    assert((loaded_small.as_str() catch "") == "atomic-v2-payload");
    loaded_small.close();

    let big_path: PathBuf = canon_root.as_path().join("big_mmap.bin");
    var big_vec = Vec[u8].with_capacity(20_000_usize);
    var fill_i = 0_usize;
    while fill_i < 20_000_usize {
        big_vec.push(b'A' +% ((fill_i % 26_usize) as u8));
        fill_i = fill_i +% 1_usize;
    }
    write_atomic(big_path.as_path(), big_vec.as_slice(), durability: .FastLocal) catch {
        panic("big write_atomic failed");
    };
    let loaded_big: LoadedFile = load_file_thresholded(&mut arena, big_path.as_path()) catch {
        panic("load big failed");
    };
    assert(loaded_big.len() == 20_000_usize);
    assert(loaded_big is .Mapped(_));
    loaded_big.close();
    arena.deinit();

    // [5] `materialize_file` (`ImmutableCas` & `ReflinkOrCopy`) + `FileLock` + `FsWatcher`:
    let cas_dst: PathBuf = canon_root.as_path().join("cas_clone.bin");
    let method: MaterializeMethod = materialize_file(
        big_path.as_path(),
        cas_dst.as_path(),
        policy: .ImmutableCas,
    ) catch |me| {
        panic(f"materialize_file failed: {me}");
    };
    assert(method == .Reflinked or method == .Hardlinked or method == .Copied);
    assert((metadata(cas_dst.as_path()) catch panic("cas stat")).len() == 20_000_usize);

    let lock_path: PathBuf = canon_root.as_path().join("build.lock");
    let guard1: FileLock = FileLock.acquire(lock_path.as_path(), mode: .Exclusive, nonblocking: true)
        catch |le| {
            panic(f"FileLock.acquire failed: {le}");
        };
    let conflict_res: FileLock!FsError = FileLock.acquire(
        lock_path.as_path(),
        mode: .Exclusive,
        nonblocking: true,
    );
    assert(conflict_res is .Err(ce_lock) and ce_lock.kind() == .FileLockConflict);
    guard1.unlock_and_close();

    var watcher: FsWatcher = FsWatcher.new() catch |we| {
        panic(f"FsWatcher.new failed: {we}");
    };
    let wid: WatchId = watcher.watch(canon_root.as_path()) catch |wwe| {
        watcher.close();
        panic(f"FsWatcher.watch failed: {wwe}");
    };
    let watched_file: PathBuf = canon_root.as_path().join("watched_ping.txt");
    write_atomic(watched_file.as_path(), b"ping", durability: .FastLocal) catch {
        watcher.close();
        panic("watched write_atomic failed");
    };
    var events = Vec[WatchEvent].new();
    let ev_count: usize = watcher.poll_events(&mut events, timeout: .Some(Duration.from_millis(250)))
        catch |pe| {
            watcher.close();
            panic(f"poll_events failed: {pe}");
        };
    assert(ev_count >= 1_usize and not events.is_empty());
    watcher.unwatch(wid) catch |uwe| {
        watcher.close();
        panic(f"unwatch failed: {uwe}");
    };
    watcher.close();

    remove_dir_all(canon_root.as_path()) catch |rme| {
        panic(f"remove_dir_all cleanup failed: {rme}");
    };
    assert(not exists(canon_root.as_path()));
}
