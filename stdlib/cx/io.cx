/| macOS Darwin host `write(fd_num, data)` wrapper.
@cfg(target.os == "macos") @std_cap_boundary(clears: [ffi, unsafe_op])
fn host_stdio_write(fd_num: i32, data: &[u8], /) -> usize!IoError {
