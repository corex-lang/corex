/| Returns deterministic process ID `1` on WASI and freestanding targets.
@cfg(target.os == "wasi" or target.os == "freestanding")
fn host_process_id() -> u32 = 1_u32;

/| Queries an optional standard directory through `context.reactor` (`SIM_OP_ENV_OP`) before host fallback.
fn query_optional_std_dir(sub_op: SimEnvSubOp, /) -> (PathBuf?)? {
    var payload: SimEnvPayload = make_sim_payload(empty_u8_slice(), empty_u8_slice());
    let sim_rc: i64 = submit_reactor_env_op(sub_op, &mut payload);
    if sim_rc == SIM_UNHANDLED_SENTINEL {
        return .None;
    }
    if sim_rc <= 0_i64 {
        return .Some(.None);
    }
    let dir_bytes: &[u8] = sim_slice_as_bytes(payload.out_slice);
    if dir_bytes.is_empty() {
        return .Some(.None);
    }
    .Some(.Some(PathBuf.from(dir_bytes)))
}

// ------------------------------------- PUBLIC API --------------------------------------
// ------------------- VarError & Formatting --------------------
impl Display for VarError {
    /| Formats `self` as a human-readable environment lookup/mutation failure description.
    @no_alloc
    pub fn fmt(&self, out: &mut FmtWriter, spec: FmtSpec, /) -> unit!FmtError {
        let msg_bytes: &[u8] = match self.* {
            .NotPresent => b"environment variable not found",
            .NotUnicode => b"environment variable was not valid unicode",
            .InvalidName => b"invalid environment variable name or interior NUL",
        };
        out.write_padded(msg_bytes, spec)
    }
}

impl TrivialDrop for VarError {}

// --------------------- Process Arguments ----------------------
/| Tokenizes Win32 UTF-16 `cmd_wtf16` into `arena` following exact MSVCRT / `CommandLineToArgvW` rules (`0` `shell32.dll`).
@expect(unused-pkg-visibility, reason: "tested on all host OSes for Win32 MSVCRT command-line parsing")
@std_cap_boundary(clears: [unsafe_op])
pub(pkg) fn parse_win32_cmdline_in(arena: &mut Arena, cmd_wtf16: &[u16], /) -> &[Path] {
    let raw_parsed: ParsedCmdLineRaw = parse_win32_cmdline_raw(arena, cmd_wtf16);
    if raw_parsed.count == 0_usize or raw_parsed.ptr_addr == 0_usize {
        return empty_path_slice();
    }
    unsafe {
        @slice_from_raw_parts(raw_parsed.ptr_addr as *Path, raw_parsed.count)
    }
}

/| Returns command-line arguments inside `arena` as `&[str]` (lossily replacing non-Unicode bytes with `U+FFFD`).
@std_cap_boundary(emits: [env], clears: [ffi, unsafe_op, indirect_opaque])
pub fn args_in(arena: &mut Arena, /) -> &[str] {
    // [1] Route through `context.reactor` (`SimEnvSubOp.Args`) when active:
    var payload: SimEnvPayload = make_sim_payload(empty_u8_slice(), empty_u8_slice());
    let sim_rc: i64 = submit_reactor_env_op(.Args, &mut payload);
    if sim_rc != SIM_UNHANDLED_SENTINEL {
        if sim_rc < 0_i64 or payload.out_count == 0_usize or payload.out_items_ptr.is_null() {
            return empty_str_slice();
        }
        let count: usize = payload.out_count;
        let out_ptr: *mut str = arena.alloc_slice[str](count, zeroed: false).as_mut_ptr();
        var i: usize = 0;
        while i < count {
            let item_slice: SimEnvSlice = unsafe {
                payload.out_items_ptr.add(i).read()
            };
            let copied_raw: SimEnvSlice = copy_lossy_utf8_in_arena_raw(
                &mut arena.*,
                sim_slice_as_bytes(item_slice),
            );
            unsafe {
                out_ptr.add(i).write(str_from_sim_slice(copied_raw));
            }
            i = i +% 1_usize;
        }
        return unsafe {
            @slice_from_raw_parts(out_ptr as *str, count)
        };
    }

    // [2] Read host OS / WASI startup arguments strictly into `arena`:
    host_args_in(arena)
}

/| Returns all command-line arguments as a lossless OS-byte / WTF-8 `Vec[PathBuf]`.
@std_cap_boundary(emits: [env, alloc], clears: [ffi, unsafe_op, indirect_opaque])
pub fn args_os() -> Vec[PathBuf] {
    var payload: SimEnvPayload = make_sim_payload(empty_u8_slice(), empty_u8_slice());
    let sim_rc: i64 = submit_reactor_env_op(.Args, &mut payload);
    if sim_rc != SIM_UNHANDLED_SENTINEL {
        if sim_rc < 0_i64 or payload.out_count == 0_usize or payload.out_items_ptr.is_null() {
            return Vec[PathBuf].new();
        }
        let count: usize = payload.out_count;
        var out = Vec[PathBuf].with_capacity(count);
        var i: usize = 0;
        while i < count {
            let item_slice: SimEnvSlice = unsafe {
                payload.out_items_ptr.add(i).read()
            };
            out.push(PathBuf.from(sim_slice_as_bytes(item_slice)));
            i = i +% 1_usize;
        }
        return out;
    }
    host_args_os()
}

// ------------------- Environment Variables --------------------
/| Queries environment variable `key` as an owned UTF-8 `String`, validating `key` and Unicode contents.
@std_cap_boundary(emits: [env, alloc], clears: [ffi, unsafe_op, indirect_opaque])
pub fn get_var(key: str, /) -> String!VarError {
    if not is_valid_env_key(key) {
        return .Err(.InvalidName);
    }

    // [1] Route through `context.reactor` (`SimEnvSubOp.GetVar`) when active:
    var payload: SimEnvPayload = make_sim_payload(key.as_bytes(), empty_u8_slice());
    let sim_rc: i64 = submit_reactor_env_op(.GetVar, &mut payload);
    if sim_rc != SIM_UNHANDLED_SENTINEL {
        if sim_rc <= 0_i64 {
            return .Err(.NotPresent);
        }
        let val_bytes: &[u8] = sim_slice_as_bytes(payload.out_slice);
        if not is_valid_utf8(val_bytes) {
            return .Err(.NotUnicode);
        }
        return .Ok(
            String.from_str(
                unsafe {
                    @str_from_utf8_unchecked(val_bytes)
                },
            ),
        );
    }

    // [2] Query host OS / WASI environment and transfer ownership in `O(1)` when valid UTF-8:
    let raw_pb: PathBuf = host_var_os(key) orelse return .Err(.NotPresent);
    match (own raw_pb).into_string() {
        .Ok(valid_str) => .Ok(own valid_str),
        .Err(_) => .Err(.NotUnicode),
    }
}

/| Queries environment variable `key` directly into `arena` without touching the general heap.
@std_cap_boundary(emits: [env], clears: [ffi, unsafe_op, indirect_opaque])
pub fn get_var_in(arena: &mut Arena, key: str, /) -> str!VarError {
    if not is_valid_env_key(key) {
        return .Err(.InvalidName);
    }

    var payload: SimEnvPayload = make_sim_payload(key.as_bytes(), empty_u8_slice());
    let sim_rc: i64 = submit_reactor_env_op(.GetVar, &mut payload);
    if sim_rc != SIM_UNHANDLED_SENTINEL {
        if sim_rc <= 0_i64 {
            return .Err(.NotPresent);
        }
        let val_bytes: &[u8] = sim_slice_as_bytes(payload.out_slice);
        if not is_valid_utf8(val_bytes) {
            return .Err(.NotUnicode);
        }
        return .Ok(
            arena.dupe_str(
                unsafe {
                    @str_from_utf8_unchecked(val_bytes)
                },
            ),
        );
    }

    host_var_in(arena, key)
}

/| Queries environment variable `key` as a lossless OS-byte / WTF-8 `PathBuf?` (`.None` if absent or invalid `key`).
@std_cap_boundary(emits: [env, alloc], clears: [ffi, unsafe_op, indirect_opaque])
pub fn get_var_os(key: str, /) -> PathBuf? {
    if not is_valid_env_key(key) {
        return .None;
    }

    var payload: SimEnvPayload = make_sim_payload(key.as_bytes(), empty_u8_slice());
    let sim_rc: i64 = submit_reactor_env_op(.GetVar, &mut payload);
    if sim_rc != SIM_UNHANDLED_SENTINEL {
        if sim_rc <= 0_i64 {
            return .None;
        }
        return .Some(PathBuf.from(sim_slice_as_bytes(payload.out_slice)));
    }

    host_var_os(key)
}

/| Snapshots all process `(key, value)` environment pairs (lossily decoding non-Unicode bytes with `U+FFFD`).
@std_cap_boundary(emits: [env, alloc], clears: [ffi, unsafe_op, indirect_opaque])
pub fn vars() -> Vec[(String, String)] {
    var payload: SimEnvPayload = make_sim_payload(empty_u8_slice(), empty_u8_slice());
    let sim_rc: i64 = submit_reactor_env_op(.ListVars, &mut payload);
    if sim_rc != SIM_UNHANDLED_SENTINEL {
        if sim_rc < 0_i64 or payload.out_count == 0_usize or payload.out_pairs_ptr.is_null() {
            return EnvPairVec.new();
        }
        let count: usize = payload.out_count;
        var out = EnvPairVec.with_capacity(count);
        var i: usize = 0;
        while i < count {
            let pair: SimEnvKvPair = unsafe {
                payload.out_pairs_ptr.add(i).read()
            };
            let key_str: String = os_bytes_to_string_lossy(sim_slice_as_bytes(pair.key));
            let val_str: String = os_bytes_to_string_lossy(sim_slice_as_bytes(pair.val));
            out.push((own key_str, own val_str));
            i = i +% 1_usize;
        }
        return out;
    }

    host_vars()
}

/| Sets `key = val` in the process environment; `unsafe` because concurrent C FFI `getenv` reads `environ` unlocked.
@std_cap_boundary(emits: [env, unsafe_op, blocking_sync], clears: [ffi, indirect_opaque])
pub unsafe fn set_var(key: str, val: str, /) -> unit!VarError {
    if not is_valid_env_key(key) or has_nul_byte(val.as_bytes()) {
        return .Err(.InvalidName);
    }

    var payload: SimEnvPayload = make_sim_payload(key.as_bytes(), val.as_bytes());
    let sim_rc: i64 = submit_reactor_env_op(.SetVar, &mut payload);
    if sim_rc != SIM_UNHANDLED_SENTINEL {
        return if sim_rc >= 0_i64 => .Ok(()) else .Err(.InvalidName);
    }

    host_mutate_var(key, .Some(val))
}

/| Removes `key` from the process environment; `unsafe` because concurrent C FFI `getenv` reads `environ` unlocked.
@std_cap_boundary(emits: [env, unsafe_op, blocking_sync], clears: [ffi, indirect_opaque])
pub unsafe fn remove_var(key: str, /) -> unit!VarError {
    if not is_valid_env_key(key) {
        return .Err(.InvalidName);
    }

    var payload: SimEnvPayload = make_sim_payload(key.as_bytes(), empty_u8_slice());
    let sim_rc: i64 = submit_reactor_env_op(.RemoveVar, &mut payload);
    if sim_rc != SIM_UNHANDLED_SENTINEL {
        return if sim_rc >= 0_i64 => .Ok(()) else .Err(.InvalidName);
    }

    host_mutate_var(key, .None)
}

// ------------------ Working Directory & Exe -------------------
/| Returns the current working directory of the calling process.
@std_cap_boundary(emits: [env, fs, blocking_sync], clears: [ffi, unsafe_op, indirect_opaque])
pub fn current_dir() -> PathBuf!FsError {
    var payload: SimEnvPayload = make_sim_payload(empty_u8_slice(), empty_u8_slice());
    let sim_rc: i64 = submit_reactor_env_op(.CurrentDir, &mut payload);
    if sim_rc != SIM_UNHANDLED_SENTINEL {
        if sim_rc >= 0_i64 {
            return .Ok(PathBuf.from(sim_slice_as_bytes(payload.out_slice)));
        }
        return .Err(FsError.from_raw_os((0_i64 -% sim_rc) as i32, domain: .SimFault, op: .Env));
    }

    host_current_dir()
}

/| Changes the current working directory of the calling process to `dir`.
@std_cap_boundary(emits: [env, fs, blocking_sync], clears: [ffi, unsafe_op, indirect_opaque])
pub fn set_current_dir[P: str | Path](dir: P, /) -> unit!FsError {
    let dir_bytes: &[u8] = dir.as_bytes();
    var payload: SimEnvPayload = make_sim_payload(dir_bytes, empty_u8_slice());
    let sim_rc: i64 = submit_reactor_env_op(.SetCurrentDir, &mut payload);
    if sim_rc != SIM_UNHANDLED_SENTINEL {
        if sim_rc >= 0_i64 {
            return .Ok(());
        }
        return .Err(FsError.from_raw_os((0_i64 -% sim_rc) as i32, domain: .SimFault, op: .Env));
    }

    host_set_current_dir(dir_bytes)
}

/| Returns the filesystem path of the currently running executable.
@std_cap_boundary(emits: [env, fs, blocking_sync], clears: [ffi, unsafe_op, indirect_opaque])
pub fn current_exe() -> PathBuf!FsError {
    var payload: SimEnvPayload = make_sim_payload(empty_u8_slice(), empty_u8_slice());
    let sim_rc: i64 = submit_reactor_env_op(.CurrentExe, &mut payload);
    if sim_rc != SIM_UNHANDLED_SENTINEL {
        if sim_rc >= 0_i64 {
            return .Ok(PathBuf.from(sim_slice_as_bytes(payload.out_slice)));
        }
        return .Err(FsError.from_raw_os((0_i64 -% sim_rc) as i32, domain: .SimFault, op: .Env));
    }

    host_current_exe()
}

// ----------------- Standard Directories & PID -----------------
/| Returns the current user's home directory (`$HOME` on Unix/WASI, `%USERPROFILE%` / `%HOMEDRIVE%%HOMEPATH%` on Windows).
@std_cap_boundary(emits: [env, fs, alloc], clears: [ffi, unsafe_op, indirect_opaque])
pub fn home_dir() -> PathBuf? {
    if query_optional_std_dir(.HomeDir) is .Some(sim_res) {
        return sim_res;
    }
    host_home_dir()
}

/| Returns the user-specific cache directory (`XDG_CACHE_HOME`, `~/Library/Caches`, or `%LOCALAPPDATA%` / `advapi32` fallback).
@std_cap_boundary(emits: [env, fs, alloc], clears: [ffi, unsafe_op, indirect_opaque])
pub fn cache_dir() -> PathBuf? {
    if query_optional_std_dir(.CacheDir) is .Some(sim_res) {
        return sim_res;
    }
    host_cache_dir()
}

/| Returns the user-specific configuration directory (`XDG_CONFIG_HOME`, `~/Library/Application Support`, or `%APPDATA%`).
@std_cap_boundary(emits: [env, fs, alloc], clears: [ffi, unsafe_op, indirect_opaque])
pub fn config_dir() -> PathBuf? {
    if query_optional_std_dir(.ConfigDir) is .Some(sim_res) {
        return sim_res;
    }
    host_config_dir()
}

/| Returns the user-local data directory (`XDG_DATA_HOME`, `~/Library/Application Support`, or `%LOCALAPPDATA%`).
@std_cap_boundary(emits: [env, fs, alloc], clears: [ffi, unsafe_op, indirect_opaque])
pub fn data_local_dir() -> PathBuf? {
    if query_optional_std_dir(.DataLocalDir) is .Some(sim_res) {
        return sim_res;
    }
    host_data_local_dir()
}

/| Returns the platform temporary directory (`$TMPDIR`/`/tmp` on Unix, `GetTempPath2W`/`GetTempPathW` on Windows, `/tmp` on WASI).
@std_cap_boundary(emits: [env, fs, alloc], clears: [ffi, unsafe_op, indirect_opaque])
pub fn temp_dir() -> PathBuf {
    var payload: SimEnvPayload = make_sim_payload(empty_u8_slice(), empty_u8_slice());
    let sim_rc: i64 = submit_reactor_env_op(.TempDir, &mut payload);
    if sim_rc != SIM_UNHANDLED_SENTINEL {
        let dir_bytes: &[u8] = sim_slice_as_bytes(payload.out_slice);
        if sim_rc >= 0_i64 and not dir_bytes.is_empty() {
            return PathBuf.from(dir_bytes);
        }
        return PathBuf.from("/tmp");
    }
    host_temp_dir()
}

/| Returns the OS-assigned process identifier (`SimReactor` virtual PID when active, `1` on WASI).
@std_cap_boundary(emits: [env], clears: [ffi, unsafe_op, indirect_opaque])
pub fn process_id() -> u32 {
    var payload: SimEnvPayload = make_sim_payload(empty_u8_slice(), empty_u8_slice());
    let sim_rc: i64 = submit_reactor_env_op(.ProcessId, &mut payload);
    if sim_rc != SIM_UNHANDLED_SENTINEL and sim_rc >= 0_i64 {
        return sim_rc as u32;
    }
    host_process_id()
}

// ---------------------------------------- TESTS ----------------------------------------
/| Mock `SimReactor` environment state used by inline `context.reactor` hermeticity unit tests.
@repr(C)
struct MockSimEnvState {
    /| Virtual process identifier returned for `SimEnvSubOp.ProcessId`.
    virtual_pid: u32,
    /| Count of `SetVar` mutations intercepted without touching host `environ`.
    set_calls: u32,
    /| Count of `RemoveVar` mutations intercepted without touching host `environ`.
    remove_calls: u32,
    /| Pointer to simulated `argv` array (`2` entries).
    sim_args_ptr: *SimEnvSlice,
    /| Pointer to simulated `(key, val)` pair array (`1` entry).
    sim_pairs_ptr: *SimEnvKvPair,
    /| Simulated current working directory bytes.
    cwd_slice: SimEnvSlice,
}

/| Full 8-word C-ABI reactor dispatch table used by inline `cx.env` unit tests.
@repr(C)
struct MockEnvReactorVTable {
    /| Slot `0`: `monotonic_ns` placeholder (`0`).
    monotonic_ns: usize,
    /| Slot `1`: `wall_epoch_ns` placeholder (`0`).
    wall_epoch_ns: usize,
    /| Slot `2`: `fill_rng` placeholder (`0`).
    fill_rng: usize,
    /| Slot `3`: `submit_io` callback intercepting `SIM_OP_ENV_OP`.
    submit_io: (extern "C" fn(*mut opaque, *IoSubmission) -> i64)?,
    /| Slots `4..7`: Unused async proactor callbacks (`[0; 4]`).
    tail_slots: [usize; 4],
}

/| Mock C-ABI `submit_io` callback servicing `SIM_OP_ENV_OP` subcodes in complete isolation from the host OS.
extern "C" fn mock_env_submit_io_cb(ctx_raw: *mut opaque, sub_ptr: *IoSubmission) -> i64 {
    let state_ptr = ctx_raw as *mut MockSimEnvState;
    if state_ptr.is_null() {
        return SIM_UNHANDLED_SENTINEL;
    }
    if sub_ptr.is_null() {
        return SIM_UNHANDLED_SENTINEL;
    }
    let op_kind: u8 = unsafe {
        sub_ptr.*.kind
    };
    if op_kind != SIM_OP_ENV_OP {
        return SIM_UNHANDLED_SENTINEL;
    }
    let sub_code: u8 = unsafe {
        sub_ptr.*.flags
    };
    let payload_ptr: *mut SimEnvPayload = unsafe {
        sub_ptr.*.buf_ptr as *mut SimEnvPayload
    };
    if payload_ptr.is_null() {
        return SIM_UNHANDLED_SENTINEL;
    }
    if sub_code == 13_u8 {
        return unsafe {
            state_ptr.*.virtual_pid as i64
        };
    }
    if sub_code == 0_u8 {
        unsafe {
            payload_ptr.*.out_items_ptr = state_ptr.*.sim_args_ptr;
            payload_ptr.*.out_count = 2_usize;
        }
        return 2_i64;
    }
    if sub_code == 1_u8 {
        let key_len: usize = unsafe {
            payload_ptr.*.in_primary.len
        };
        if key_len == 7_usize {
            unsafe {
                payload_ptr.*.out_slice = SimEnvSlice {
                    ptr: b"sim_value_42".as_ptr(),
                    len: 12_usize,
                };
            }
            return 1_i64;
        }
        if key_len == 12_usize {
            unsafe {
                payload_ptr.*.out_slice = SimEnvSlice {
                    ptr: b"\xFF\xFE".as_ptr(),
                    len: 2_usize,
                };
            }
            return 1_i64;
        }
        return 0_i64;
    }
    if sub_code == 2_u8 {
        unsafe {
            payload_ptr.*.out_pairs_ptr = state_ptr.*.sim_pairs_ptr;
            payload_ptr.*.out_count = 1_usize;
        }
        return 1_i64;
    }
    if sub_code == 3_u8 {
        unsafe {
            state_ptr.*.set_calls += 1_u32;
        }
        return 0_i64;
    }
    if sub_code == 4_u8 {
        unsafe {
            state_ptr.*.remove_calls += 1_u32;
        }
        return 0_i64;
    }
    if sub_code == 5_u8 {
        unsafe {
            payload_ptr.*.out_slice = state_ptr.*.cwd_slice;
        }
        return 1_i64;
    }
    if sub_code == 6_u8 {
        unsafe {
            state_ptr.*.cwd_slice = payload_ptr.*.in_primary;
        }
        return 0_i64;
    }
    let dir_bytes: &[u8] = match sub_code {
        7_u8 => b"/sim/bin/corex",
        8_u8 => b"/sim/home",
        9_u8 => b"/sim/home/.cache",
        10_u8 => b"/sim/home/.config",
        11_u8 => b"/sim/home/.local/share",
        12_u8 => b"/sim/tmp",
        _ => return SIM_UNHANDLED_SENTINEL,
    };
    unsafe {
        payload_ptr.*.out_slice = SimEnvSlice {
            ptr: dir_bytes.as_ptr(),
            len: dir_bytes.len(),
        };
    }
    1_i64
}

test "parse_win32_cmdline_in matches MSVCRT argv[0], 2n/2n+1 backslashes, and unpaired WTF-16" {
    var arena = Arena.new();

    // [1] Empty and whitespace-only command lines:
    let empty_u16: [u16; 0] = [];
    assert(parse_win32_cmdline_in(&mut arena, &empty_u16).is_empty());
    var spaces_u16: [u16; 16] = [0_u16; 16];
    let spaces_n: usize = encode_wtf8_to_wtf16(b"   \t  ", &mut spaces_u16) catch 0_usize;
    assert(
        parse_win32_cmdline_in(&mut arena, subslice_u16(&spaces_u16, 0_usize, spaces_n)).is_empty(),
    );

    // [2] Quoted `argv[0]` with spaces/backslashes + `2n` vs `2n + 1` backslashes + `""` in `argv[1..]`:
    var complex_u16: [u16; 128] = [0_u16; 128];
    let complex_n: usize = encode_wtf8_to_wtf16(
        b"\"C:\\Program Files\\CoreX\\corex.exe\" build \"\" \"a\\\\\" \"a\\\"b\" a\\\\b \"x\"\"y\"",
        &mut complex_u16,
    ) catch 0_usize;
    let parsed: &[Path] = parse_win32_cmdline_in(
        &mut arena,
        subslice_u16(&complex_u16, 0_usize, complex_n),
    );
    assert(parsed.len() == 7_usize);
    assert((parsed[0].to_str() orelse "BAD") == "C:\\Program Files\\CoreX\\corex.exe");
    assert((parsed[1].to_str() orelse "BAD") == "build");
    assert((parsed[2].to_str() orelse "BAD") == "");
    assert((parsed[3].to_str() orelse "BAD") == "a\\");
    assert((parsed[4].to_str() orelse "BAD") == "a\"b");
    assert((parsed[5].to_str() orelse "BAD") == "a\\\\b");
    assert((parsed[6].to_str() orelse "BAD") == "x\"y");

    // [3] Unpaired UTF-16 high surrogate `0xD800` preserved losslessly in WTF-8 `Path`:
    let surrogate_cmd: [u16; 7] = [
        0x0061_u16,
        0x0070_u16,
        0x0070_u16,
        0x0020_u16,
        0x0078_u16,
        0xD800_u16,
        0x0079_u16,
    ];
    let surr_parsed: &[Path] = parse_win32_cmdline_in(&mut arena, &surrogate_cmd);
    assert(surr_parsed.len() == 2_usize);
    assert((surr_parsed[0].to_str() orelse "") == "app");
    assert(surr_parsed[1].to_str() is .None);
    assert(surr_parsed[1].as_os_bytes().len() == 5_usize);
    assert(surr_parsed[1].to_str_lossy_in(&mut arena) == "x\u{FFFD}y");
    (own arena).release();
}

/| Asserts Windows absolute-path and `HOMEDRIVE` + `HOMEPATH` standard-directory filtering invariants.
@cfg(target.os == "windows")
fn assert_target_std_dir_filters() {
    assert(filter_absolute_dir(.None) is .None);
    assert(filter_absolute_dir(.Some(PathBuf.new())) is .None);
    assert(filter_absolute_dir(.Some(PathBuf.from("rel\\.cache"))) is .None);
    assert(filter_absolute_dir(.Some(PathBuf.from("C:Users\\Alice"))) is .None);
    assert(filter_absolute_dir(.Some(PathBuf.from("\\Users\\Alice"))) is .None);
    assert(filter_absolute_dir(.Some(PathBuf.from("C:\\Users\\Alice"))) is .Some(_));

    assert(
        join_win32_home_drive_path(PathBuf.from("C:"), Path.from_bytes(b"Users\\Alice")) is .None,
    );
    assert(
        join_win32_home_drive_path(PathBuf.from("rel"), Path.from_bytes(b"\\Users\\Alice")) is .None,
    );
    assert(
        join_win32_home_drive_path(PathBuf.from("C:"), Path.from_bytes(b"\\Users\\Alice")) is .Some(
            _,
        ),
    );
    assert(
        join_win32_home_drive_path(PathBuf.from("C:"), Path.from_bytes(b"/Users/Alice")) is .Some(_),
    );
}

/| Asserts POSIX and WASI absolute-path standard-directory filtering invariants.
@cfg(not (target.os == "windows"))
fn assert_target_std_dir_filters() {
    assert(filter_absolute_dir(.None) is .None);
    assert(filter_absolute_dir(.Some(PathBuf.new())) is .None);
    assert(filter_absolute_dir(.Some(PathBuf.from("rel/.cache"))) is .None);
    assert(filter_absolute_dir(.Some(PathBuf.from("./tmp"))) is .None);
    assert(filter_absolute_dir(.Some(PathBuf.from("/home/alice"))) is .Some(_));
    assert(
        join_win32_home_drive_path(PathBuf.from("C:"), Path.from_bytes(b"Users/Alice")) is .None,
    );
}

test "VarError Display and environment variable key/value validation" {
    var msg_buf: [u8; 64] = [0_u8; 64];
    assert(
        (cx.str.format_into(&mut msg_buf, f"{VarError.NotPresent}") catch "")
            == "environment variable not found",
    );
    assert(get_var("") is .Err(.InvalidName));
    assert(get_var("=") is .Err(.InvalidName));
    assert(get_var("=C:") is .Err(.InvalidName));
    assert(get_var("BAD=KEY") is .Err(.InvalidName));
    assert(get_var("BAD\0KEY") is .Err(.InvalidName));
    assert(get_var_os("") is .None);
    assert(get_var_os("=") is .None);
    assert(get_var_os("=C:") is .None);
    assert(get_var_os("BAD=KEY") is .None);
    assert(get_var_os("BAD\0KEY") is .None);

    var arena = Arena.new();
    assert(get_var_in(&mut arena, "") is .Err(.InvalidName));
    assert(get_var_in(&mut arena, "=") is .Err(.InvalidName));
    assert(get_var_in(&mut arena, "=C:") is .Err(.InvalidName));
    assert(get_var_in(&mut arena, "BAD=KEY") is .Err(.InvalidName));
    assert(get_var_in(&mut arena, "BAD\0KEY") is .Err(.InvalidName));
    let e1 = unsafe {
        set_var("", "x")
    };
    let e2 = unsafe {
        set_var("A=B", "x")
    };
    let e3 = unsafe {
        set_var("VALID_K", "bad\0val")
    };
    let e4 = unsafe {
        remove_var("A=B")
    };
    assert(
        e1 is .Err(.InvalidName)
            and e2 is .Err(.InvalidName)
            and e3 is .Err(.InvalidName)
            and e4 is .Err(
                .InvalidName,
            ),
    );
    assert_target_std_dir_filters();
    (own arena).release();
}

test "SimReactor hermetic routing for args, vars, and environment mutations" {
    var arena = Arena.new();

    let mock_args: [SimEnvSlice; 2] = [make_sim_slice(b"corex"), make_sim_slice(b"--sim")];
    let mock_pairs: [SimEnvKvPair; 1] = [
        SimEnvKvPair {
            key: make_sim_slice(b"HERMETIC"),
            val: make_sim_slice(b"1"),
        },
    ];
    var sim_state = MockSimEnvState {
        virtual_pid: 4242_u32,
        set_calls: 0_u32,
        remove_calls: 0_u32,
        sim_args_ptr: (&mock_args).as_ptr(),
        sim_pairs_ptr: (&mock_pairs).as_ptr(),
        cwd_slice: make_sim_slice(b"/sim/work"),
    };
    let sim_vt = MockEnvReactorVTable {
        monotonic_ns: 0_usize,
        wall_epoch_ns: 0_usize,
        fill_rng: 0_usize,
        submit_io: .Some(mock_env_submit_io_cb),
        tail_slots: [0_usize; 4],
    };
    let sim_reactor = Reactor {
        vtable: (&raw sim_vt) as *core.async.ReactorVTable,
    };
    let sim_ctx = ReactorCtx {
        state: (&raw mut sim_state) as *mut opaque,
    };

    with context.reactor = sim_reactor {
        with context.reactor_ctx = sim_ctx {
            assert(process_id() == 4242_u32);
            let s_args: &[str] = args_in(&mut arena);
            assert(s_args.len() == 2_usize and s_args[0] == "corex" and s_args[1] == "--sim");

            let os_args: Vec[PathBuf] = args_os();
            assert(
                os_args.len() == 2_usize and (os_args[1].as_path().to_str() orelse "") == "--sim",
            );

            assert((get_var("SIM_KEY") catch String.new()).as_str() == "sim_value_42");
            assert((get_var_in(&mut arena, "SIM_KEY") catch "") == "sim_value_42");
            assert(
                get_var("SIM_BAD_UTF8") is .Err(.NotUnicode)
                    and get_var_in(
                        &mut arena,
                        "SIM_BAD_UTF8",
                    ) is .Err(.NotUnicode),
            );
            assert(
                get_var_os("SIM_BAD_UTF8") is .Some(_)
                    and get_var("MISSING_SIM_KEY") is .Err(
                        .NotPresent,
                    ),
            );

            let all_vars: EnvPairVec = vars();
            assert(all_vars.len() == 1_usize and all_vars[0].0.as_str() == "HERMETIC");

            let set_res = unsafe {
                set_var("COREX_NEVER_TOUCH_HOST", "1")
            };
            let rem_res = unsafe {
                remove_var("COREX_NEVER_TOUCH_HOST")
            };
            assert(
                set_res is .Ok(_)
                    and rem_res is .Ok(_)
                    and sim_state.set_calls == 1_u32
                    and sim_state.remove_calls == 1_u32,
            );
        }
    }
    assert(get_var("COREX_NEVER_TOUCH_HOST") is .Err(.NotPresent));
    (own arena).release();
}

test "SimReactor hermetic routing for working directory and standard directories" {
    var sim_state = MockSimEnvState {
        virtual_pid: 7_u32,
        set_calls: 0_u32,
        remove_calls: 0_u32,
        sim_args_ptr: @default_init[*SimEnvSlice](),
        sim_pairs_ptr: @default_init[*SimEnvKvPair](),
        cwd_slice: make_sim_slice(b"/sim/work"),
    };
    let sim_vt = MockEnvReactorVTable {
        monotonic_ns: 0_usize,
        wall_epoch_ns: 0_usize,
        fill_rng: 0_usize,
        submit_io: .Some(mock_env_submit_io_cb),
        tail_slots: [0_usize; 4],
    };
    let sim_reactor = Reactor {
        vtable: (&raw sim_vt) as *core.async.ReactorVTable,
    };
    let sim_ctx = ReactorCtx {
        state: (&raw mut sim_state) as *mut opaque,
    };

    with context.reactor = sim_reactor {
        with context.reactor_ctx = sim_ctx {
            assert(((current_dir() catch PathBuf.new()).as_path().to_str() orelse "") == "/sim/work");
            assert(set_current_dir("/sim/next") is .Ok(_));
            assert(((current_dir() catch PathBuf.new()).as_path().to_str() orelse "") == "/sim/next");
            assert(
                ((current_exe() catch PathBuf.new()).as_path().to_str() orelse "")
                    == "/sim/bin/corex",
            );
            assert(((home_dir() orelse PathBuf.new()).as_path().to_str() orelse "") == "/sim/home");
            assert(
                ((cache_dir() orelse PathBuf.new()).as_path().to_str() orelse "")
                    == "/sim/home/.cache",
            );
            assert(
                ((config_dir() orelse PathBuf.new()).as_path().to_str() orelse "")
                    == "/sim/home/.config",
            );
            assert(
                ((data_local_dir() orelse PathBuf.new()).as_path().to_str() orelse "")
                    == "/sim/home/.local/share",
            );
            assert((temp_dir().as_path().to_str() orelse "") == "/sim/tmp");
        }
    }
}
