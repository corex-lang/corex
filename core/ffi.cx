/# Foreign Function Interface C ABI Primitives, `VaList`, and `CStr` (`core.ffi`)
/#
/# Defines target-calibrated C integer aliases (`c_char` through `c_ulonglong`), `c_void` (`opaque`),
/# platform-sized `@repr(C)` `VaList` / `VaListParam` ABI types, and the zero-overhead `CStr` view across
/# all 11 canonical compilation targets (`DR-10` §2.1–2.4, `DR-21`, `DR-22` `ADR-22F`).
/#
/# All `CStr` methods are heap-allocation-free (`@no_alloc`) and preserve identical ABI representation
/# to `const char*` across `MirVm`, Tier A (`-ofmt=c`), and Tier B (`LLVM`).

// ---------------------------------------- TYPES ----------------------------------------
/| Target-calibrated C `char` (`u8` on `aarch64-linux-*` AAPCS64).
@cfg(target.arch == "aarch64" and target.os == "linux")
pub type c_char = u8;

/| Target-calibrated C `char` (`i8` on `x86_64`, `macos`, `windows`, and `wasm32`).
@cfg(not (target.arch == "aarch64" and target.os == "linux"))
pub type c_char = i8;

/| Target C `signed char` (`i8` across all targets).
pub type c_schar = i8;

/| Target C `unsigned char` (`u8` across all targets).
pub type c_uchar = u8;

/| Target C `short` (`i16` across all targets).
pub type c_short = i16;

/| Target C `unsigned short` (`u16` across all targets).
pub type c_ushort = u16;

/| Target C `int` (`i32` across all LP64, LLP64, and ILP32 targets).
pub type c_int = i32;

/| Target C `unsigned int` (`u32` across all LP64, LLP64, and ILP32 targets).
pub type c_uint = u32;

/| Target-calibrated C `long` (`i32` on Windows LLP64 and `wasm32` ILP32).
@cfg(target.os == "windows" or target.arch == "wasm32")
pub type c_long = i32;

/| Target-calibrated C `long` (`i64` on 64-bit Linux and macOS LP64).
@cfg(not (target.os == "windows" or target.arch == "wasm32"))
pub type c_long = i64;

/| Target-calibrated C `unsigned long` (`u32` on Windows LLP64 and `wasm32` ILP32).
@cfg(target.os == "windows" or target.arch == "wasm32")
pub type c_ulong = u32;

/| Target-calibrated C `unsigned long` (`u64` on 64-bit Linux and macOS LP64).
@cfg(not (target.os == "windows" or target.arch == "wasm32"))
pub type c_ulong = u64;

/| Target C `long long` (`i64` across all targets).
pub type c_longlong = i64;

/| Target C `unsigned long long` (`u64` across all targets).
pub type c_ulonglong = u64;

/| Unsized C `void` pointee alias (`*c_void` = `*opaque`, `*mut c_void` = `*mut opaque`).
pub type c_void = opaque;

/| System V AMD64 C `va_list` storage wrapper (`24` bytes on `x86_64-linux-*` and `x86_64-apple-darwin`).
@cfg(target.arch == "x86_64" and (target.os == "linux" or target.os == "macos")) @repr(C) @not_send
pub struct VaList {
    /| Three pointer-width ABI words matching `struct __va_list_tag`.
    _storage: [usize; 3],
}

/| AAPCS64 Linux C `va_list` storage wrapper (`32` bytes on `aarch64-linux-*`).
@cfg(target.arch == "aarch64" and target.os == "linux") @repr(C) @not_send
pub struct VaList {
    /| Four pointer-width ABI words matching `struct __va_list`.
    _storage: [usize; 4],
}

/| Single-pointer C `va_list` storage wrapper (`windows`, `aarch64-apple-darwin`, and `wasm32`).
@cfg(target.os == "windows"
    or (target.arch == "aarch64" and target.os == "macos")
    or target.arch == "wasm32")
@repr(C)
@not_send
pub struct VaList {
    /| Backing variadic argument stack cursor (`char*`).
    _storage: *mut u8,
}

/| Decayed System V AMD64 C `va_list` parameter ABI alias (`8` bytes on `x86_64-linux-*` and `x86_64-apple-darwin`).
@cfg(target.arch == "x86_64" and (target.os == "linux" or target.os == "macos"))
pub type VaListParam = *mut VaList;

/| By-value C `va_list` parameter ABI alias (`aarch64-linux-*`, `windows`, `aarch64-apple-darwin`, and `wasm32`).
@cfg(not (target.arch == "x86_64" and (target.os == "linux" or target.os == "macos")))
pub type VaListParam = VaList;

/| Zero-overhead NUL-terminated C string wrapper ABI-identical to `const char*`.
@repr(C)
pub struct CStr {
    /| Pointer to the first byte of a NUL-terminated byte sequence.
    ptr: *u8,
}

// --------------------------------------- CONSTS ----------------------------------------
/| Trailing ASCII NUL byte (`0x00`) terminating every valid C string.
pub const CSTR_NUL_TERMINATOR: u8 = 0_u8;

// ------------------------------------- PUBLIC API --------------------------------------
impl CStr {
    /| Constructs a `CStr` from a caller-proven non-null NUL-terminated byte pointer.
    @inline @no_alloc @no_panic
    pub unsafe fn from_ptr(ptr: *u8) -> CStr {
        CStr { ptr }
    }

    /| Validates that `bytes` is non-empty and has its sole NUL byte at `bytes.len() - 1`.
    @inline @no_alloc @no_panic
    pub fn from_bytes_with_nul(bytes: &[u8]) -> CStr? {
        let total_len: usize = bytes.len();
        if total_len == 0 {
            return .None;
        }
        let last_idx: usize = total_len -% 1;
        for byte_val, i in bytes {
            if i < last_idx {
                if byte_val == CSTR_NUL_TERMINATOR {
                    return .None;
                }
            } else if byte_val != CSTR_NUL_TERMINATOR {
                return .None;
            }
        }
        .Some(CStr { ptr: &raw bytes[0] })
    }

    /| Returns the underlying raw `*u8` byte pointer.
    @inline @no_alloc @no_panic
    pub fn as_ptr(&self) -> *u8 {
        self.ptr
    }

    /| Returns the underlying pointer typed as target `*c_char` (`const char*`).
    @inline @no_alloc @no_panic
    pub fn as_c_char_ptr(&self) -> *c_char {
        self.ptr as *c_char
    }

    /| Computes the byte length (`strlen`) preceding the trailing `0_u8` NUL byte.
    @std_cap_boundary(clears: [unsafe_op]) @inline @no_alloc @no_panic
    pub fn count_bytes(&self) -> usize {
        let raw_bytes: *u8 = self.ptr;
        if raw_bytes == @default_init[*u8]() {
            return 0;
        }
        var byte_count: usize = 0;
        unsafe {
            while raw_bytes[byte_count] != CSTR_NUL_TERMINATOR {
                byte_count = byte_count +% 1;
            }
        }
        byte_count
    }

    /| Returns `true` when `self` has zero content bytes before the trailing NUL byte.
    @std_cap_boundary(clears: [unsafe_op]) @inline @no_alloc @no_panic
    pub fn is_empty(&self) -> bool {
        if self.ptr == @default_init[*u8]() {
            return true;
        }
        unsafe {
            self.ptr.* == CSTR_NUL_TERMINATOR
        }
    }
}
