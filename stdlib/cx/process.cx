];

/| NUL-terminated UTF-16 `PATH\0` environment variable name used for safe Win32 executable lookup.
@cfg(target.os == "windows")
const WIN32_PATH_KEY_UTF16: [u16; 5] = [0x0050, 0x0041, 0x0054, 0x0048, 0x0000];

/| UTF-16 `\System32` directory suffix appended to `%SystemRoot%` (`9` code units).
@cfg(target.os == "windows")
const WIN32_SYS32_DIR_SUFFIX_UTF16: [u16; 9] = [
    0x005C, 0x0053, 0x0079, 0x0073, 0x0074, 0x0065, 0x006D, 0x0033,
