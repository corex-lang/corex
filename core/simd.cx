/// Broadcasts `scalar_lane` across all 16 byte lanes of a `Vec16u8`.
@inline
@no_alloc
@no_panic
pub fn splat_v16u8(scalar_lane: u8) -> Vec16u8 {
    return Vec16u8 { lanes: @simd_splat[[u8; 16]](scalar_lane) };
}

/// Computes lane-wise wrapping `left_vec + right_vec` (`Vec16u8`).
@inline
@no_alloc
@no_panic
pub fn add_v16u8(left_vec: Vec16u8, right_vec: Vec16u8) -> Vec16u8 {
    return Vec16u8 { lanes: @simd_add(left_vec.lanes, right_vec.lanes) };
