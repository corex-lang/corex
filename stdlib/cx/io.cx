/| Windows host `GetConsoleMode(GetStdHandle(STD_OUTPUT_HANDLE))` TTY predicate.
@cfg(target.os == "windows") @std_cap_boundary(clears: [ffi, unsafe_op])
fn is_host_stdout_tty() -> bool {
    let handle: *mut opaque = unsafe {
        sys.windows.win32_get_std_handle(sys.windows.STD_OUTPUT_HANDLE)
    };
    if handle.is_null() or (handle as isize) == sys.windows.INVALID_HANDLE_BITS {
        return false;
    }
    var mode_out = 0_u32;
    unsafe {
        sys.windows.win32_get_console_mode(handle, &raw mut mode_out) != 0
    }
}

/| Windows host `ReadFile(STD_INPUT_HANDLE)` wrapper normalizing pipe closure (`ERROR_BROKEN_PIPE`) to EOF (`0`).
@cfg(target.os == "windows") @std_cap_boundary(clears: [ffi, unsafe_op])
fn host_stdin_read(dst_ptr: *mut u8, cap: usize, /) -> usize!IoError {
    let handle: *mut opaque = unsafe {
        sys.windows.win32_get_std_handle(sys.windows.STD_INPUT_HANDLE)
    };
    if handle.is_null() or (handle as isize) == sys.windows.INVALID_HANDLE_BITS {
        return .Ok(0_usize);
    }
    let chunk_u32: u32 = if cap > 0x7FFF_FFFF_usize => 0x7FFF_FFFF_u32 else cap as u32;
    var read_bytes = 0_u32;
    let ok: i32 = unsafe {
        sys.windows.win32_read_file(
            handle,
            dst_ptr,
            chunk_u32,
            &raw mut read_bytes,
            @default_init[*mut opaque](),
        )
    };
    if ok == 0 {
        let win_err: u32 = unsafe {
            sys.windows.win32_get_last_error()
        };
        if win_err == sys.windows.ERROR_BROKEN_PIPE or win_err == sys.windows.ERROR_HANDLE_EOF {
            return .Ok(0_usize);
        }
        return .Err(IoError.from_raw_os(@bit_cast[i32](win_err), domain: .Win32Error, op: .Read));
    }
    .Ok(read_bytes as usize)
}

/| Windows host `WriteFile(STD_OUTPUT_HANDLE / STD_ERROR_HANDLE)` wrapper.
@cfg(target.os == "windows") @std_cap_boundary(clears: [ffi, unsafe_op])
fn host_stdio_write(fd_num: i32, data: &[u8], /) -> usize!IoError {
    let std_id: u32 = if fd_num == 2 => sys.windows.STD_ERROR_HANDLE
        else sys.windows.STD_OUTPUT_HANDLE;
    let handle: *mut opaque = unsafe {
        sys.windows.win32_get_std_handle(std_id)
    };
    if handle.is_null() or (handle as isize) == sys.windows.INVALID_HANDLE_BITS {
        return .Ok(data.len());
    }
    let chunk_u32: u32 = if data.len() > 0x7FFF_FFFF_usize => 0x7FFF_FFFF_u32 else data.len() as u32;
    var wrote_bytes = 0_u32;
    let ok: i32 = unsafe {
        sys.windows.win32_write_file(
            handle,
            data.as_ptr(),
            chunk_u32,
            &raw mut wrote_bytes,
            @default_init[*mut opaque](),
        )
    };
    if ok == 0 {
        let win_err: u32 = unsafe {
            sys.windows.win32_get_last_error()
        };
        return .Err(IoError.from_raw_os(@bit_cast[i32](win_err), domain: .Win32Error, op: .Write));
    }
    .Ok(wrote_bytes as usize)
}

/| WASI Preview 1 `fd_fdstat_get(1)` TTY predicate (`WASI_FILETYPE_CHARACTER_DEVICE`).
@cfg(target.os == "wasi") @std_cap_boundary(clears: [ffi, unsafe_op])
fn is_host_stdout_tty() -> bool {
    var stat_out = @default_init[sys.wasi.WasiFdstat]();
    let rc: u16 = unsafe {
        sys.wasi.wasi_fd_fdstat_get(sys.wasi.WASI_STDOUT_FD, &raw mut stat_out)
    };
    rc == 0_u16 and stat_out.fs_filetype == sys.wasi.WASI_FILETYPE_CHARACTER_DEVICE
}

/| WASI Preview 1 `fd_read(0)` wrapper.
@cfg(target.os == "wasi") @std_cap_boundary(clears: [ffi, unsafe_op])
fn host_stdin_read(dst_ptr: *mut u8, cap: usize, /) -> usize!IoError {
    let iov = sys.wasi.WasiIovec {
        buf_ptr: dst_ptr,
        buf_len: cap,
    };
    var nread = 0_usize;
    let rc: u16 = unsafe {
        sys.wasi.wasi_fd_read(sys.wasi.WASI_STDIN_FD, &raw iov, 1_usize, &raw mut nread)
    };
    if rc != 0_u16 {
        return .Err(IoError.from_raw_os(rc as i32, domain: .WasiErrno, op: .Read));
    }
    .Ok(nread)
}

/| WASI Preview 1 `fd_write(fd_num)` wrapper.
@cfg(target.os == "wasi") @std_cap_boundary(clears: [ffi, unsafe_op])
fn host_stdio_write(fd_num: i32, data: &[u8], /) -> usize!IoError {
    let ciov = sys.wasi.WasiCiovec {
        buf_ptr: data.as_ptr(),
        buf_len: data.len(),
    };
    var nwritten = 0_usize;
    let rc: u16 = unsafe {
        sys.wasi.wasi_fd_write(fd_num, &raw ciov, 1_usize, &raw mut nwritten)
    };
    if rc != 0_u16 {
        return .Err(IoError.from_raw_os(rc as i32, domain: .WasiErrno, op: .Write));
    }
    .Ok(nwritten)
}

/| Freestanding target TTY stub (`wasm32-unknown-freestanding`) keeping zero host imports.
@cfg(not (
    target.os == "linux" or target.os == "macos" or target.os == "windows" or target.os == "wasi"
))
fn is_host_stdout_tty() -> bool = false;

/| Freestanding target `stdin` stub returning immediate EOF (`0`).
@cfg(not (
    target.os == "linux" or target.os == "macos" or target.os == "windows" or target.os == "wasi"
))
fn host_stdin_read(dst_ptr: *mut u8, cap: usize, /) -> usize!IoError {
    _ = dst_ptr;
    _ = cap;
    .Ok(0_usize)
}

/| Freestanding target `stdout`/`stderr` stub discarding bytes without host imports.
@cfg(not (
    target.os == "linux" or target.os == "macos" or target.os == "windows" or target.os == "wasi"
))
fn host_stdio_write(fd_num: i32, data: &[u8], /) -> usize!IoError {
    _ = fd_num;
    .Ok(data.len())
}

/| Acquires locked buffered `stdout` (`is_stderr == false`) or `stderr` (`is_stderr == true`).
@std_cap_boundary(clears: [ffi, unsafe_op, alloc, may_panic, indirect_opaque])
fn lock_stdio_output_stream(is_stderr: bool, /) -> StdoutLock {
    let fd_usize: usize = if is_stderr => 2_usize else 1_usize;
    let raw_writer = Writer {
        ctx: fd_usize as *mut opaque,
        vtable: WRITER_SENTINEL_STDIO as *WriterVTable,
    };
    let hdr_ptr: *mut StdioTlsHeader = stdio_tls_header();
    if hdr_ptr.is_null() {
        return StdoutLock {
            inner_writer: BufWriter {
                downstream: raw_writer,
                buf_ptr: @default_init[*mut u8](),
                filled: 0_u32,
                cap_and_flags: 0_u32,
            },
            lock_token: if is_stderr => STDIO_TOKEN_STDERR_BIT else 0_usize,
        };
    }
    let hdr_addr = hdr_ptr as usize;
    let token_bits: usize = hdr_addr | (if is_stderr => STDIO_TOKEN_STDERR_BIT else 0_usize);
    let hdr: &mut StdioTlsHeader = unsafe {
        &mut hdr_ptr.*
    };
    let lock_ptr: *mut u8 = if is_stderr => &raw mut hdr.stderr_lock else &raw mut hdr.stdout_lock;
    acquire_stdio_lock(lock_ptr);

    let line_flag: u32 = if not is_stderr and is_stdout_tty_cached(hdr) => BUF_WRITER_LINE_BUF_FLAG
        else 0_u32;
    let slab_ptr: *mut StdioSlab = ensure_stdio_slab(hdr);
    if not slab_ptr.is_null() {
        let slab: &mut StdioSlab = unsafe {
            &mut slab_ptr.*
        };
        let (buf_base, prev_filled) = if is_stderr {
            (&raw mut slab.stderr_buf[0], slab.stderr_filled)
        } else {
            (&raw mut slab.stdout_buf[0], slab.stdout_filled)
        };
        return StdoutLock {
            inner_writer: BufWriter {
                downstream: raw_writer,
                buf_ptr: buf_base,
                filled: prev_filled,
                cap_and_flags: (DEFAULT_IO_BUF_SIZE as u32) | line_flag,
            },
            lock_token: token_bits,
        };
    }
    let em_off: usize = if is_stderr => 5_usize else 2_usize;
    StdoutLock {
        inner_writer: BufWriter {
            downstream: raw_writer,
            buf_ptr: unsafe {
                (&raw mut hdr.emergency_buf[0]).add(em_off)
            },
            filled: 0_u32,
            cap_and_flags: 3_u32 | line_flag,
        },
        lock_token: token_bits,
    }
}

/| Persists `remaining_filled` into `StdioSlab` (when active) and unlocks `stdout` or `stderr`.
@std_cap_boundary(clears: [unsafe_op])
fn finish_stdout_lock_token(lock_token: usize, remaining_filled: u32, /) {
    let is_stderr: bool = (lock_token & STDIO_TOKEN_STDERR_BIT) != 0_usize;
    let hdr_addr: usize = lock_token & ~STDIO_TOKEN_STDERR_BIT;
    let hdr_ptr = hdr_addr as *mut StdioTlsHeader;
    if hdr_ptr.is_null() {
        return;
    }
    let hdr: &mut StdioTlsHeader = unsafe {
        &mut hdr_ptr.*
    };
    let slab_ptr: *mut StdioSlab = hdr.slab_ptr;
    if not slab_ptr.is_null() {
        let slab: &mut StdioSlab = unsafe {
            &mut slab_ptr.*
        };
        if is_stderr {
            slab.stderr_filled = remaining_filled;
        } else {
            slab.stdout_filled = remaining_filled;
        }
    }
    let lock_ptr: *mut u8 = if is_stderr => &raw mut hdr.stderr_lock else &raw mut hdr.stdout_lock;
    release_stdio_lock(lock_ptr);
}

// ------------------------------------- PUBLIC API --------------------------------------
// ------------------ IoError & Error Domains -------------------
impl ErrDomain {
    /| Encodes `self` into its compact 6-bit integer discriminant (`0..=5`).
    @expect(unused-pkg-visibility, reason: "used by cx.fs, cx.env, and cx.process in Phase 11.2b")
    pub(pkg) fn to_code(self) -> u8 {
        match self {
            .Generic => 0_u8,
            .PosixErrno => 1_u8,
            .Win32Error => 2_u8,
            .NtStatus => 3_u8,
            .WasiErrno => 4_u8,
            .SimFault => 5_u8,
        }
    }

    /| Decodes a 6-bit integer discriminant back into `ErrDomain` (defaulting unknown codes to `.Generic`).
    @expect(unused-pkg-visibility, reason: "used by cx.fs, cx.env, and cx.process in Phase 11.2b")
    pub(pkg) fn from_code(code: u8, /) -> ErrDomain {
        match code {
            1_u8 => .PosixErrno,
            2_u8 => .Win32Error,
            3_u8 => .NtStatus,
            4_u8 => .WasiErrno,
            5_u8 => .SimFault,
            _ => .Generic,
        }
    }
}

impl IoErrorKind {
    /| Encodes `self` into its 8-bit `IoErrorBits.kind` wire code (`0..=26`, `255` for `.Other`).
    @expect(unused-pkg-visibility, reason: "used by cx.fs, cx.env, and cx.process in Phase 11.2b")
    pub(pkg) fn to_code(self) -> u8 {
        match self {
            .NotFound => 0_u8,
            .PermissionDenied => 1_u8,
            .AlreadyExists => 2_u8,
            .WouldBlock => 3_u8,
            .Interrupted => 4_u8,
            .TimedOut => 5_u8,
            .UnexpectedEof => 6_u8,
            .WriteZero => 7_u8,
            .BrokenPipe => 8_u8,
            .InvalidInput => 9_u8,
            .InvalidData => 10_u8,
            .DirectoryNotEmpty => 11_u8,
            .IsADirectory => 12_u8,
            .NotADirectory => 13_u8,
            .CrossesDevices => 14_u8,
            .FilesystemLoop => 15_u8,
            .FileLockConflict => 16_u8,
            .ResourceBusy => 17_u8,
            .StorageFull => 18_u8,
            .StreamTooLong => 19_u8,
            .InvalidScriptExtension => 20_u8,
            .Unsupported => 21_u8,
            .Canceled => 22_u8,
            .OutOfMemory => 23_u8,
            .InvalidFilename => 24_u8,
            .ReadOnlyFilesystem => 25_u8,
            .ArgumentListTooLong => 26_u8,
            .Other => 255_u8,
        }
    }

    /| Decodes an 8-bit `IoErrorBits.kind` wire code into `IoErrorKind` (mapping unknown codes to `.Other`).
    @expect(unused-pkg-visibility, reason: "used by cx.fs, cx.env, and cx.process in Phase 11.2b")
    pub(pkg) fn from_code(code: u8, /) -> IoErrorKind {
        match code {
            0_u8 => .NotFound,
            1_u8 => .PermissionDenied,
            2_u8 => .AlreadyExists,
            3_u8 => .WouldBlock,
            4_u8 => .Interrupted,
            5_u8 => .TimedOut,
            6_u8 => .UnexpectedEof,
            7_u8 => .WriteZero,
            8_u8 => .BrokenPipe,
            9_u8 => .InvalidInput,
            10_u8 => .InvalidData,
            11_u8 => .DirectoryNotEmpty,
            12_u8 => .IsADirectory,
            13_u8 => .NotADirectory,
            14_u8 => .CrossesDevices,
            15_u8 => .FilesystemLoop,
            16_u8 => .FileLockConflict,
            17_u8 => .ResourceBusy,
            18_u8 => .StorageFull,
            19_u8 => .StreamTooLong,
            20_u8 => .InvalidScriptExtension,
            21_u8 => .Unsupported,
            22_u8 => .Canceled,
            23_u8 => .OutOfMemory,
            24_u8 => .InvalidFilename,
            25_u8 => .ReadOnlyFilesystem,
            26_u8 => .ArgumentListTooLong,
            _ => .Other,
        }
    }
}

impl IoOp {
    /| Encodes `self` into its 8-bit `IoErrorBits.op` wire code (`0..=18`).
    @expect(unused-pkg-visibility, reason: "used by cx.fs, cx.env, and cx.process in Phase 11.2b")
    pub(pkg) fn to_code(self) -> u8 {
        match self {
            .None => 0_u8,
            .Read => 1_u8,
            .Write => 2_u8,
            .Flush => 3_u8,
            .Seek => 4_u8,
            .Open => 5_u8,
            .Stat => 6_u8,
            .Resolve => 7_u8,
            .Rename => 8_u8,
            .Unlink => 9_u8,
            .Mkdir => 10_u8,
            .Readdir => 11_u8,
            .Clone => 12_u8,
            .Mmap => 13_u8,
            .Lock => 14_u8,
            .Watch => 15_u8,
            .Spawn => 16_u8,
            .Wait => 17_u8,
            .Env => 18_u8,
        }
    }

    /| Decodes an 8-bit `IoErrorBits.op` wire code into `IoOp` (mapping unknown codes to `.None`).
    @expect(unused-pkg-visibility, reason: "used by cx.fs, cx.env, and cx.process in Phase 11.2b")
    pub(pkg) fn from_code(code: u8, /) -> IoOp {
        match code {
            1_u8 => .Read,
            2_u8 => .Write,
            3_u8 => .Flush,
            4_u8 => .Seek,
            5_u8 => .Open,
            6_u8 => .Stat,
            7_u8 => .Resolve,
            8_u8 => .Rename,
            9_u8 => .Unlink,
            10_u8 => .Mkdir,
            11_u8 => .Readdir,
            12_u8 => .Clone,
            13_u8 => .Mmap,
            14_u8 => .Lock,
            15_u8 => .Watch,
            16_u8 => .Spawn,
            17_u8 => .Wait,
            18_u8 => .Env,
            _ => .None,
        }
    }
}

impl TrivialDrop for IoError {}

impl IoError {
    /| Constructs a zero-allocation `IoError` from `kind` and optional `op` (`ErrDomain.Generic`).
    @inline @no_alloc @no_panic
    pub fn from_kind(kind: IoErrorKind, /, *, op: IoOp = .None) -> IoError {
        pack_io_error_bits(
            IoErrorBits {
                tag: IO_ERR_INLINE_TAG,
                domain: ErrDomain.Generic.to_code(),
                kind: kind.to_code(),
                op: op.to_code(),
                diag_slot: 0_u8,
                raw_code: 0_u32,
            },
        )
    }

    /| Constructs a zero-allocation `IoError` classifying `raw_code` according to `domain`.
    @inline @no_alloc @no_panic
    pub fn from_raw_os(raw_code: i32, /, *, domain: ErrDomain, op: IoOp = .None) -> IoError {
        IoError.from_raw_os_with_slot(raw_code, domain: domain, op: op, diag_slot: 0_u8)
    }

    /| Constructs an `IoError` carrying both `raw_code` and a thread-local `Context.diagnostics` `diag_slot`.
    @expect(unused-pkg-visibility, reason: "used by cx.fs diagnostic path ring in Phase 11.2b")
    pub(pkg) fn from_raw_os_with_slot(
        raw_code: i32,
        /,
        *,
        domain: ErrDomain,
        op: IoOp = .None,
        diag_slot: u8 = 0_u8,
    ) -> IoError {
        let mapped_kind: IoErrorKind = match domain {
            .PosixErrno => IoError.map_posix_errno(raw_code),
            .Win32Error => IoError.map_win32_error(@bit_cast[u32](raw_code)),
            .NtStatus => IoError.map_ntstatus(raw_code),
            .WasiErrno => IoError.map_wasi_errno((@bit_cast[u32](raw_code) & 0xFFFF_u32) as u16),
            .SimFault => map_sim_fault_code(raw_code),
            .Generic => .Other,
        };
        pack_io_error_bits(
            IoErrorBits {
                tag: IO_ERR_INLINE_TAG,
                domain: domain.to_code(),
                kind: mapped_kind.to_code(),
                op: op.to_code(),
                diag_slot,
                raw_code: @bit_cast[u32](raw_code),
            },
        )
    }

    /| Classifies a Darwin (`macos`) POSIX `errno` into `IoErrorKind` (`EAGAIN = 35`, `EDEADLK = 11`, `ELOOP = 62`).
    @cfg(target.os == "macos") @no_alloc @no_panic
    pub fn map_posix_errno(errno_code: i32, /) -> IoErrorKind {
        match errno_code {
            1 => .PermissionDenied,
            2 => .NotFound,
            4 => .Interrupted,
            7 => .ArgumentListTooLong,
            9 => .InvalidInput,
            11 => .FileLockConflict,
            12 => .OutOfMemory,
            13 => .PermissionDenied,
            16 => .ResourceBusy,
            17 => .AlreadyExists,
            18 => .CrossesDevices,
            19 => .Unsupported,
            20 => .NotADirectory,
            21 => .IsADirectory,
            22 => .InvalidInput,
            27 => .StorageFull,
            28 => .StorageFull,
            29 => .InvalidInput,
            30 => .ReadOnlyFilesystem,
            32 => .BrokenPipe,
            35 => .WouldBlock,
            45 => .Unsupported,
            60 => .TimedOut,
            62 => .FilesystemLoop,
            63 => .InvalidFilename,
            66 => .DirectoryNotEmpty,
            78 => .Unsupported,
            89 => .Canceled,
            92 => .InvalidData,
            102 => .Unsupported,
            _ => .Other,
        }
    }

    /| Classifies a Linux / standard POSIX `errno` into `IoErrorKind` (`EAGAIN = 11`, `EDEADLK = 35`, `ELOOP = 40`).
    @cfg(not (target.os == "macos")) @no_alloc @no_panic
    pub fn map_posix_errno(errno_code: i32, /) -> IoErrorKind = map_sim_fault_code(errno_code);

    /| Classifies a Win32 `GetLastError` `DWORD` into `IoErrorKind`.
    @no_alloc @no_panic
    pub fn map_win32_error(win32_code: u32, /) -> IoErrorKind {
        match win32_code {
            1_u32 | 50_u32 | 120_u32 => .Unsupported,
            2_u32 | 3_u32 | 15_u32 | 53_u32 | 67_u32 => .NotFound,
            5_u32 | 1_314_u32 => .PermissionDenied,
            6_u32 | 87_u32 | 131_u32 | 4_390_u32 => .InvalidInput,
            8_u32 | 14_u32 | 1_450_u32 => .OutOfMemory,
            13_u32 | 1_113_u32 => .InvalidData,
            17_u32 => .CrossesDevices,
            19_u32 => .ReadOnlyFilesystem,
            32_u32 => .ResourceBusy,
            33_u32 | 158_u32 => .FileLockConflict,
            38_u32 => .UnexpectedEof,
            39_u32 | 112_u32 => .StorageFull,
            80_u32 | 183_u32 => .AlreadyExists,
            109_u32 | 232_u32 | 233_u32 => .BrokenPipe,
            121_u32 | 258_u32 | 1_460_u32 => .TimedOut,
            123_u32 | 161_u32 | 206_u32 => .InvalidFilename,
            145_u32 => .DirectoryNotEmpty,
            267_u32 => .NotADirectory,
            995_u32 | 1_223_u32 => .Canceled,
            997_u32 | 10_035_u32 => .WouldBlock,
            1_921_u32 => .FilesystemLoop,
            10_004_u32 => .Interrupted,
            _ => .Other,
        }
    }

    /| Classifies a Windows Native `NTSTATUS` code into `IoErrorKind`.
    @no_alloc @no_panic
    pub fn map_ntstatus(nt_status: i32, /) -> IoErrorKind {
        match @bit_cast[u32](nt_status) {
            0xC000_0002_u32 | 0xC000_00BB_u32 => .Unsupported,
            0xC000_0008_u32 | 0xC000_000D_u32 | 0xC000_0275_u32 => .InvalidInput,
            0xC000_000F_u32 | 0xC000_0034_u32 | 0xC000_003A_u32 => .NotFound,
            0xC000_0011_u32 => .UnexpectedEof,
            0xC000_0017_u32 | 0xC000_009A_u32 => .OutOfMemory,
            0xC000_0022_u32 | 0xC000_0061_u32 => .PermissionDenied,
            0xC000_0033_u32 | 0xC000_0039_u32 | 0xC000_0106_u32 => .InvalidFilename,
            0xC000_0035_u32 => .AlreadyExists,
            0xC000_0043_u32 | 0xC000_0056_u32 => .ResourceBusy,
            0xC000_0054_u32 | 0xC000_0055_u32 => .FileLockConflict,
            0xC000_007F_u32 => .StorageFull,
            0xC000_00A2_u32 => .ReadOnlyFilesystem,
            0xC000_00B0_u32 | 0xC000_014B_u32 => .BrokenPipe,
            0xC000_00B5_u32 => .TimedOut,
            0xC000_00BA_u32 => .IsADirectory,
            0xC000_00D4_u32 => .CrossesDevices,
            0xC000_0101_u32 => .DirectoryNotEmpty,
            0xC000_0103_u32 => .NotADirectory,
            0xC000_0120_u32 => .Canceled,
            0xC000_0279_u32 | 0xC000_04B3_u32 => .FilesystemLoop,
            _ => .Other,
        }
    }

    /| Classifies a WASI Preview 1 `__wasi_errno_t` code (`u16`) into `IoErrorKind`.
    @no_alloc @no_panic
    pub fn map_wasi_errno(wasi_code: u16, /) -> IoErrorKind {
        match wasi_code {
            1_u16 => .ArgumentListTooLong,
            2_u16 | 63_u16 | 76_u16 => .PermissionDenied,
            6_u16 => .WouldBlock,
            8_u16 | 28_u16 | 70_u16 => .InvalidInput,
            10_u16 => .ResourceBusy,
            11_u16 => .Canceled,
            16_u16 => .FileLockConflict,
            20_u16 => .AlreadyExists,
            22_u16 | 51_u16 => .StorageFull,
            25_u16 => .InvalidData,
            27_u16 => .Interrupted,
            31_u16 => .IsADirectory,
            32_u16 => .FilesystemLoop,
            37_u16 => .InvalidFilename,
            44_u16 => .NotFound,
            48_u16 => .OutOfMemory,
            52_u16 | 58_u16 => .Unsupported,
            54_u16 => .NotADirectory,
            55_u16 => .DirectoryNotEmpty,
            64_u16 => .BrokenPipe,
            69_u16 => .ReadOnlyFilesystem,
            73_u16 => .TimedOut,
            75_u16 => .CrossesDevices,
            _ => .Other,
        }
    }

    /| Extracts the normalized `IoErrorKind` of `self`.
    @inline @no_alloc @no_panic
    pub fn kind(self) -> IoErrorKind {
        let bits = @bit_cast[IoErrorBits](self.packed_repr as u64);
        IoErrorKind.from_code(bits.kind)
    }

    /| Extracts the `IoOp` operation context recorded on `self`.
    @inline @no_alloc @no_panic
    pub fn op(self) -> IoOp {
        let bits = @bit_cast[IoErrorBits](self.packed_repr as u64);
        IoOp.from_code(bits.op)
    }

    /| Extracts the `ErrDomain` origin recorded on `self`.
    @inline @no_alloc @no_panic
    pub fn domain(self) -> ErrDomain {
        let bits = @bit_cast[IoErrorBits](self.packed_repr as u64);
        ErrDomain.from_code(bits.domain)
    }

    /| Extracts the optional thread-local `Context.diagnostics` path-ring index (`0` when unset).
    @expect(unused-pkg-visibility, reason: "reserved for cx.fs diagnostic path ring in Phase 11.2a")
    pub(pkg) fn diag_slot(self) -> u8 {
        let bits = @bit_cast[IoErrorBits](self.packed_repr as u64);
        bits.diag_slot
    }

    /| Returns the raw 32-bit OS or `--sim` error code when `domain != .Generic`, or `.None` otherwise.
    @inline @no_alloc @no_panic
    pub fn os_error(self) -> i32? {
        let bits = @bit_cast[IoErrorBits](self.packed_repr as u64);
        if ErrDomain.from_code(bits.domain) == .Generic {
            return .None;
        }
        .Some(@bit_cast[i32](bits.raw_code))
    }

    /| Returns `true` when `self.kind() == .Interrupted` (`EINTR` retry predicate).
    @no_alloc @no_panic
    pub fn is_interrupted(self) -> bool = self.kind() == .Interrupted;

    /| Returns a static `.rodata` human-readable description for `self.kind()` (`0` heap allocations).
    @no_alloc @no_panic
    pub fn message(self) -> str {
        match self.kind() {
            .NotFound => "entity not found",
            .PermissionDenied => "permission denied",
            .AlreadyExists => "entity already exists",
            .WouldBlock => "operation would block",
            .Interrupted => "operation interrupted",
            .TimedOut => "operation timed out",
            .UnexpectedEof => "unexpected end of file",
            .WriteZero => "write returned zero bytes",
            .BrokenPipe => "broken pipe",
            .InvalidInput => "invalid input parameter",
            .InvalidData => "invalid stream data",
            .DirectoryNotEmpty => "directory not empty",
            .IsADirectory => "target is a directory",
            .NotADirectory => "target is not a directory",
            .CrossesDevices => "cross-device link or rename",
            .FilesystemLoop => "filesystem symlink loop or confinement escape",
            .FileLockConflict => "advisory file lock conflict",
            .ResourceBusy => "resource busy",
            .StorageFull => "no space left on storage device",
            .StreamTooLong => "stream exceeded maximum byte limit",
            .InvalidScriptExtension => "implicit batch script execution rejected",
            .Unsupported => "operation not supported",
            .Canceled => "operation canceled",
            .OutOfMemory => "out of memory",
            .InvalidFilename => "invalid filename or path",
            .ReadOnlyFilesystem => "read-only filesystem",
            .ArgumentListTooLong => "argument or environment list too long",
            .Other => "unclassified I/O error",
        }
    }
}

impl Display for IoError {
    /| Formats `self.message()` (plus `(os error <code>)` when present) into `out`.
    @no_alloc
    pub fn fmt(&self, out: &mut FmtWriter, spec: FmtSpec, /) -> unit!FmtError {
        _ = spec;
        let msg: str = self.*.message();
        if self.*.os_error() is .Some(code) {
            return @fmt_write(out, f"{msg} (os error {code})");
        }
        out.write_str(msg)
    }
}

impl Debug for IoError {
    /| Formats structural `IoError` fields (`kind`, `op`, `domain`, `os_error`) into `out`.
    @no_alloc
    pub fn fmt_debug(&self, out: &mut FmtWriter, spec: FmtSpec, /) -> unit!FmtError {
        _ = spec;
        let err_val: IoError = self.*;
        @fmt_write(
            out,
            f"IoError {{ kind: {err_val.kind():?}, op: {err_val.op():?}, domain: {err_val.domain():?}, os_error: {err_val.os_error():?} }}",
        )
    }
}

// ------------------ OutBuf & Vectored Slices ------------------
impl OutBuf {
    /| Wraps uninitialized stack/array storage `buf` (`&out [u8; N]`) with `0` `memset` cost (`STD-02` §2.1).
    @no_alloc @no_panic
    pub fn over_uninit[const N: usize](buf: &out [u8; N], /) -> OutBuf {
        OutBuf {
            ptr: (&raw mut buf.*) as *mut u8,
            cap: N,
            filled_bytes: 0_usize,
        }
    }

    /| Wraps an initialized mutable slice `buf` with `filled_len()` reset to `0`.
    @inline @no_alloc @no_panic
    pub fn over_slice(buf: &mut [u8], /) -> OutBuf {
        OutBuf {
            ptr: buf.as_mut_ptr(),
            cap: buf.len(),
            filled_bytes: 0_usize,
        }
    }

    /| Constructs an `OutBuf` over caller-proven writable `ptr[0..cap]` (`filled_len() = 0`).
    @inline @no_alloc @no_panic
    pub unsafe fn from_raw_parts(ptr: *mut u8, cap: usize, /) -> OutBuf {
        OutBuf {
            ptr,
            cap,
            filled_bytes: 0_usize,
        }
    }

    /| Returns the total byte capacity of `self`.
    @no_alloc @no_panic
    pub fn capacity(&self) -> usize = self.cap;

    /| Returns the count of initialized bytes written into `self` so far.
    @no_alloc @no_panic
    pub fn filled_len(&self) -> usize = self.filled_bytes;

    /| Returns the remaining uninitialized capacity (`capacity() - filled_len()`).
    @no_alloc @no_panic
    pub fn remaining(&self) -> usize = self.cap -| self.filled_bytes;

    /| Returns `true` when zero bytes have been written to `self`.
    @no_alloc @no_panic
    pub fn is_empty(&self) -> bool = self.filled_bytes == 0_usize;

    /| Returns `true` when `filled_len() == capacity()`.
    @no_alloc @no_panic
    pub fn is_full(&self) -> bool = self.filled_bytes >= self.cap;

    /| Borrows the initialized prefix `0..filled_len()` as `&[u8]`.
    @std_cap_boundary(clears: [unsafe_op]) @inline @no_alloc @no_panic
    pub fn filled(&self) -> &[u8] {
        if self.filled_bytes == 0_usize or self.ptr.is_null() {
            return EMPTY_BYTES;
        }
        unsafe {
            @slice_from_raw_parts(self.ptr as *u8, self.filled_bytes)
        }
    }

    /| Resets `filled_len()` to `0` without touching backing memory.
    @inline @no_alloc @no_panic
    pub fn clear(&mut self) {
        self.filled_bytes = 0_usize;
    }

    /| Copies `min(src.len(), remaining())` bytes into `self`, advancing `filled_len()` and returning copied count.
    @std_cap_boundary(clears: [unsafe_op]) @inline @no_alloc @no_panic
    pub fn append(&mut self, src: &[u8], /) -> usize {
        let rem: usize = self.remaining();
        let copy_n: usize = if src.len() < rem => src.len() else rem;
        if copy_n > 0_usize and not self.ptr.is_null() {
            unsafe {
                @memcpy(
                    self.ptr.add(self.filled_bytes) as *mut opaque,
                    src.as_ptr() as *opaque,
                    copy_n,
                );
            }
            self.filled_bytes = self.filled_bytes +% copy_n;
        }
        copy_n
    }

    /| Returns `(unfilled_base_ptr, remaining_len)` for FFI / syscall read wrappers.
    @std_cap_boundary(clears: [unsafe_op]) @inline @no_alloc @no_panic
    pub fn unfilled_raw(&mut self) -> (*mut u8, usize) {
        let rem: usize = self.remaining();
        if self.ptr.is_null() {
            return (self.ptr, rem);
        }
        let raw_dst: *mut u8 = unsafe {
            self.ptr.add(self.filled_bytes)
        };
        (raw_dst, rem)
    }

    /| Marks `n` additional bytes in `unfilled_raw()` as initialized (`caller` must have written `n` bytes).
    @inline @no_alloc @no_panic
    pub unsafe fn advance_init(&mut self, n: usize, /) {
        let rem: usize = self.remaining();
        debug_assert(n <= rem, "OutBuf.advance_init exceeded remaining capacity");
        let step: usize = if n <= rem => n else rem;
        self.filled_bytes = self.filled_bytes +% step;
    }
}

impl TrivialDrop for IoSlice {}

impl TrivialDrop for IoSliceMut {}

impl IoSlice {
    /| Wraps `slice` in a target-ABI `IoSlice` (`WSABUF` on Windows, `iovec` / `ciovec` on POSIX / WASI).
    @inline @no_alloc @no_panic
    pub fn new(slice: &[u8], /) -> IoSlice {
        IoSlice {
            raw: ActiveIoSliceRaw.from_slice(slice),
        }
    }

    /| Projects `self` back as `&[u8]`.
    @std_cap_boundary(clears: [unsafe_op]) @inline @no_alloc @no_panic
    pub fn as_slice(self) -> &[u8] {
        let byte_len: usize = self.raw.raw_len();
        if byte_len == 0_usize {
            return EMPTY_BYTES;
        }
        unsafe {
            @slice_from_raw_parts(self.raw.raw_ptr(), byte_len)
        }
    }

    /| Returns the byte length of `self`.
    @no_alloc @no_panic
    pub fn len(self) -> usize = self.raw.raw_len();

    /| Returns `true` when `self.len() == 0`.
    @no_alloc @no_panic
    pub fn is_empty(self) -> bool = self.raw.raw_len() == 0_usize;

    /| Advances `slices` past `n` consumed bytes, trimming the leading partial `IoSlice` in place when needed.
    @std_cap_boundary(clears: [may_panic]) @no_alloc @no_panic
    pub fn advance_slices(slices: &mut &mut [IoSlice], var n: usize, /) {
        var idx = 0_usize;
        let total_slices: usize = slices.*.len();
        while idx < total_slices {
            let cur_len: usize = slices.*[idx].len();
            if n < cur_len {
                let full_bytes: &[u8] = slices.*[idx].as_slice();
                if n < full_bytes.len() {
                    slices.*[idx] = IoSlice.new(full_bytes[n..full_bytes.len()]);
                }
                slices.* = slices.*[idx..total_slices];
                return;
            }
            n = n -% cur_len;
            idx += 1_usize;
        }
        slices.* = slices.*[total_slices..total_slices];
    }
}

impl IoSliceMut {
    /| Wraps mutable `slice` in a target-ABI `IoSliceMut` (`WSABUF` on Windows, `iovec` on POSIX / WASI).
    @inline @no_alloc @no_panic
    pub fn new(slice: &mut [u8], /) -> IoSliceMut {
        IoSliceMut {
            raw: ActiveIoSliceMutRaw.from_slice(slice),
        }
    }

    /| Borrows `self` immutably as `&[u8]`.
    @std_cap_boundary(clears: [unsafe_op]) @inline @no_alloc @no_panic
    pub fn as_slice(&self) -> &[u8] {
        let byte_len: usize = self.raw.raw_len();
        if byte_len == 0_usize {
            return EMPTY_BYTES;
        }
        unsafe {
            @slice_from_raw_parts(self.raw.raw_ptr() as *u8, byte_len)
        }
    }

    /| Borrows `self` mutably as `&mut [u8]`.
    @std_cap_boundary(clears: [unsafe_op]) @inline @no_alloc @no_panic
    pub fn as_mut_slice(&mut self) -> &mut [u8] {
        let byte_len: usize = self.raw.raw_len();
        unsafe {
            @slice_from_raw_parts_mut(self.raw.raw_ptr(), byte_len)
        }
    }

    /| Returns the byte length of `self`.
    @no_alloc @no_panic
    pub fn len(&self) -> usize = self.raw.raw_len();

    /| Returns `true` when `self.len() == 0`.
    @no_alloc @no_panic
    pub fn is_empty(&self) -> bool = self.raw.raw_len() == 0_usize;

    /| Advances `slices` past `n` filled bytes, trimming the leading partial `IoSliceMut` in place when needed.
    @std_cap_boundary(clears: [unsafe_op, may_panic]) @no_alloc @no_panic
    pub fn advance_mut_slices(slices: &mut &mut [IoSliceMut], var n: usize, /) {
        var idx = 0_usize;
        let total_slices: usize = slices.*.len();
        while idx < total_slices {
            let cur_len: usize = slices.*[idx].len();
            if n < cur_len {
                let rem_len: usize = cur_len -% n;
                let base_ptr: *mut u8 = slices.*[idx].raw.raw_ptr();
                let next_ptr: *mut u8 = unsafe {
                    base_ptr.add(n)
                };
                slices.*[idx] = IoSliceMut.new(
                    unsafe {
                        @slice_from_raw_parts_mut(next_ptr, rem_len)
                    },
                );
                slices.* = slices.*[idx..total_slices];
                return;
            }
            n = n -% cur_len;
            idx += 1_usize;
        }
        slices.* = slices.*[total_slices..total_slices];
    }
}

// ------------------ Stream Handles & VTables ------------------
impl Seek {
    /| Constructs a `Seek` handle from a raw context pointer and non-null `SeekVTable`.
    @no_alloc @no_panic
    pub unsafe fn from_raw(ctx: *mut opaque, vtable: *SeekVTable, /) -> Seek = Seek {
        ctx,
        vtable,
    };

    /| Repositions the stream cursor according to `pos` and returns the new byte offset from start.
    @std_cap_boundary(clears: [fs, blocking_sync, ffi, unsafe_op])
    pub fn seek(&mut self, pos: SeekFrom, /) -> u64!IoError {
        let vt_addr = self.vtable as usize;
        if (vt_addr & 1_usize) != 0_usize {
            return match vt_addr {
                SEEK_SENTINEL_BYTES => byte_reader_seek_cb(self.ctx, pos),
                SEEK_SENTINEL_FILE => file_sentinel_seek(self.ctx, pos),
                _ => slice_writer_seek_cb(self.ctx, pos),
            };
        }
        let seek_fn = unsafe {
            self.vtable.*.seek
        };
        seek_fn(self.ctx, pos)
    }

    /| Queries the current stream byte offset (`seek(.Current(0))`).
    @inline
    pub fn stream_position(&mut self) -> u64!IoError {
        self.seek(.Current(0_i64))
    }

    /| Rewinds the stream cursor to byte `0` (`seek(.Start(0))`).
    @inline
    pub fn rewind(&mut self) -> unit!IoError {
        _ = self.seek(.Start(0_u64))?;
        .Ok(())
    }
}

impl Reader {
    /| Constructs a `Reader` handle from a raw context pointer and non-null `ReaderVTable`.
    @no_alloc @no_panic
    pub unsafe fn from_raw(ctx: *mut opaque, vtable: *ReaderVTable, /) -> Reader = Reader {
        ctx,
        vtable,
    };

    /| Borrows a `ByteReader` cursor as a `Reader`.
    @inline @no_alloc @no_panic
    pub fn from_bytes(cursor: &mut ByteReader, /) -> Reader {
        cursor.as_reader()
    }

    /| Returns a stateless `Reader` that immediately yields `0` bytes (EOF) on every read.
    @inline @no_alloc @no_panic
    pub fn empty() -> Reader {
        Reader {
            ctx: @default_init[*mut opaque](),
            vtable: READER_SENTINEL_EMPTY as *ReaderVTable,
        }
    }

    /| Returns a stateless `Reader` yielding an infinite stream of `byte_val` with zero allocations.
    @inline @no_alloc @no_panic
    pub fn repeat(byte_val: u8, /) -> Reader {
        Reader {
            ctx: (byte_val as usize) as *mut opaque,
            vtable: READER_SENTINEL_REPEAT as *ReaderVTable,
        }
    }

    /| Reads available bytes into uninitialized `out` (`0` = EOF) without zero-initializing `out`.
    @std_cap_boundary(clears: [fs, blocking_sync, ffi, unsafe_op])
    pub fn read_out(&mut self, out: &mut OutBuf, /) -> usize!IoError {
        let vt_addr = self.vtable as usize;
        if (vt_addr & 1_usize) != 0_usize {
            return match vt_addr {
                READER_SENTINEL_EMPTY => empty_read_out_cb(self.ctx, out),
                READER_SENTINEL_REPEAT => repeat_read_out_cb(self.ctx, out),
                READER_SENTINEL_BUF => buf_reader_read_out_cb(self.ctx, out),
                READER_SENTINEL_LIMIT => limit_reader_read_out_cb(self.ctx, out),
                READER_SENTINEL_BYTES => byte_reader_read_out_cb(self.ctx, out),
                READER_SENTINEL_FILE => file_sentinel_read_out(self.ctx, out),
                _ => raw_stdin_read_out_cb(self.ctx, out),
            };
        }
        let read_fn = unsafe {
            self.vtable.*.read_out
        };
        read_fn(self.ctx, out)
    }

    /| Reads available bytes into `buf` (`0` = EOF).
    @inline
    pub fn read(&mut self, buf: &mut [u8], /) -> usize!IoError {
        if buf.is_empty() {
            return .Ok(0_usize);
        }
        var out = OutBuf.over_slice(buf);
        self.read_out(&mut out)
    }

    /| Reads into scatter-gather `bufs`, falling back to the first non-empty slice when `vtable.read_vectored` is `.None`.
    @std_cap_boundary(clears: [fs, blocking_sync, ffi, unsafe_op, may_panic])
    pub fn read_vectored(&mut self, bufs: &mut [IoSliceMut], /) -> usize!IoError {
        let vt_addr = self.vtable as usize;
        if (vt_addr & 1_usize) != 0_usize {
            if vt_addr == READER_SENTINEL_EMPTY {
                let reborrowed: &mut [IoSliceMut] = unsafe {
                    @slice_from_raw_parts_mut(bufs.as_mut_ptr(), bufs.len())
                };
                return empty_read_vectored_cb(self.ctx, reborrowed);
            } else if vt_addr == READER_SENTINEL_BYTES {
                let reborrowed: &mut [IoSliceMut] = unsafe {
                    @slice_from_raw_parts_mut(bufs.as_mut_ptr(), bufs.len())
                };
                return byte_reader_read_vectored_cb(self.ctx, reborrowed);
            } else if vt_addr == READER_SENTINEL_FILE {
                let reborrowed: &mut [IoSliceMut] = unsafe {
                    @slice_from_raw_parts_mut(bufs.as_mut_ptr(), bufs.len())
                };
                return file_sentinel_read_vectored(self.ctx, reborrowed);
            }
        } else {
            let opt_vec_fn = unsafe {
                self.vtable.*.read_vectored
            };
            if opt_vec_fn is .Some(vec_fn) {
                let reborrowed: &mut [IoSliceMut] = unsafe {
                    @slice_from_raw_parts_mut(bufs.as_mut_ptr(), bufs.len())
                };
                return vec_fn(self.ctx, reborrowed);
            }
        }
        var idx = 0_usize;
        let count: usize = bufs.len();
        while idx < count {
            if not bufs[idx].is_empty() {
                return self.read(bufs[idx].as_mut_slice());
            }
            idx += 1_usize;
        }
        .Ok(0_usize)
    }

    /| Fills `buf` completely (retrying on `.Interrupted`), or returns `.Err(.UnexpectedEof)` on premature EOF.
    @std_cap_boundary(clears: [may_panic])
    pub fn read_exact(&mut self, buf: &mut [u8], /) -> unit!IoError {
        var filled = 0_usize;
        let target_len: usize = buf.len();
        while filled < target_len {
            let n: usize = self.read(buf[filled..target_len]) catch |err| {
                if err.is_interrupted() {
                    continue;
                }
                return .Err(err);
            };
            if n == 0_usize {
                return .Err(IoError.from_kind(.UnexpectedEof, op: .Read));
            }
            filled = filled +% n;
        }
        .Ok(())
    }

    /| Appends exactly `exact_len` bytes into `out` without `memset`, failing with `.UnexpectedEof` on short stream.
    @std_cap_boundary(clears: [unsafe_op])
    pub fn read_exact_out(&mut self, out: &mut OutBuf, exact_len: usize, /) -> unit!IoError {
        if exact_len > out.remaining() {
            return .Err(IoError.from_kind(.InvalidInput, op: .Read));
        }
        var got = 0_usize;
        while got < exact_len {
            let (dst_ptr, _) = out.unfilled_raw();
            let need: usize = exact_len -% got;
            var sub_out = unsafe {
                OutBuf.from_raw_parts(dst_ptr, need)
            };
            let n: usize = self.read_out(&mut sub_out) catch |err| {
                if err.is_interrupted() {
                    continue;
                }
                return .Err(err);
            };
            if n == 0_usize {
                return .Err(IoError.from_kind(.UnexpectedEof, op: .Read));
            }
            unsafe {
                out.advance_init(n);
            }
            got = got +% n;
        }
        .Ok(())
    }

    /| Appends all remaining bytes from `self` into `dst`, failing with `.StreamTooLong` if stream exceeds `max_bytes`.
    @std_cap_boundary(clears: [unsafe_op])
    pub fn read_to_end(
        &mut self,
        dst: &mut Vec[u8],
        /,
        *,
        max_bytes: usize = usize.MAX,
    ) -> usize!IoError {
        var total_read = 0_usize;
        var raw_chunk: [u8; 4_096];
        while true {
            var out = OutBuf.over_uninit(&out raw_chunk);
            if max_bytes < usize.MAX and total_read == max_bytes {
                var probe_out = unsafe {
                    OutBuf.from_raw_parts(out.unfilled_raw().0, 1_usize)
                };
                let probe_n: usize = self.read_out(&mut probe_out) catch |err| {
                    if err.is_interrupted() {
                        continue;
                    }
                    return .Err(err);
                };
                if probe_n > 0_usize {
                    return .Err(IoError.from_kind(.StreamTooLong, op: .Read));
                }
                return .Ok(total_read);
            }
            let rem_max: usize = max_bytes -| total_read;
            let budget: usize = if max_bytes == usize.MAX or rem_max >= 4_096_usize => 4_096_usize
                else rem_max;
            var bounded_out = unsafe {
                OutBuf.from_raw_parts(out.unfilled_raw().0, budget)
            };
            let n: usize = self.read_out(&mut bounded_out) catch |err| {
                if err.is_interrupted() {
                    continue;
                }
                return .Err(err);
            };
            if n == 0_usize {
                return .Ok(total_read);
            }
            dst.try_reserve(n) catch {
                return .Err(IoError.from_kind(.OutOfMemory, op: .Read));
            };
            dst.extend_from_slice(bounded_out.filled());
            total_read = total_read +% n;
        }
        .Ok(total_read)
    }

    /| Reads all remaining UTF-8 bytes into `dst`, returning `.Err(.InvalidData)` without mutating `dst` on invalid UTF-8.
    @std_cap_boundary(clears: [unsafe_op])
    pub fn read_to_string(
        &mut self,
        dst: &mut String,
        /,
        *,
        max_bytes: usize = usize.MAX,
    ) -> usize!IoError {
        var raw_vec = Vec[u8].new();
        let count: usize = self.read_to_end(&mut raw_vec, max_bytes: max_bytes)?;
        if count == 0_usize {
            return .Ok(0_usize);
        }
        if dst.is_empty() {
            let owned_str: String = String.from_utf8(own raw_vec) catch {
                return .Err(IoError.from_kind(.InvalidData, op: .Read));
            };
            dst.* = own owned_str;
            return .Ok(count);
        }
        let slice: &[u8] = raw_vec.as_slice();
        if not is_valid_utf8(slice) {
            return .Err(IoError.from_kind(.InvalidData, op: .Read));
        }
        let valid_str: str = unsafe {
            @str_from_utf8_unchecked(slice)
        };
        dst.try_push_str(valid_str) catch {
            return .Err(IoError.from_kind(.OutOfMemory, op: .Read));
        };
        .Ok(count)
    }

    /| Reads all remaining bytes directly into `arena` (`0` heap drop overhead) up to `max_bytes`.
    @std_cap_boundary(clears: [unsafe_op])
    pub fn read_all_arena(
        &mut self,
        arena: &mut Arena,
        /,
        *,
        max_bytes: usize = usize.MAX,
    ) -> (&[u8])!IoError {
        var buf = Vec[u8].in_arena(arena);
        _ = self.read_to_end(&mut buf, max_bytes: max_bytes)?;
        let (ptr, len, _, _) = (own buf).into_raw_parts();
        if len == 0_usize {
            return .Ok(EMPTY_BYTES);
        }
        .Ok(
            unsafe {
                @slice_from_raw_parts(ptr as *u8, len)
            },
        )
    }

    /| Skips up to `bytes` from `self`, using `vtable.discard` when available or draining into a stack `OutBuf`.
    @std_cap_boundary(clears: [unsafe_op])
    pub fn discard(&mut self, bytes: u64, /) -> u64!IoError {
        if bytes == 0_u64 {
            return .Ok(0_u64);
        }
        let vt_addr = self.vtable as usize;
        if (vt_addr & 1_usize) != 0_usize {
            if vt_addr == READER_SENTINEL_EMPTY {
                return empty_discard_cb(self.ctx, bytes);
            } else if vt_addr == READER_SENTINEL_REPEAT {
                return repeat_discard_cb(self.ctx, bytes);
            } else if vt_addr == READER_SENTINEL_BUF {
                while true {
                    let n: u64 = buf_reader_discard_cb(self.ctx, bytes) catch |err| {
                        if err.is_interrupted() {
                            continue;
                        }
                        return .Err(err);
                    };
                    return .Ok(n);
                }
            } else if vt_addr == READER_SENTINEL_LIMIT {
                while true {
                    let n: u64 = limit_reader_discard_cb(self.ctx, bytes) catch |err| {
                        if err.is_interrupted() {
                            continue;
                        }
                        return .Err(err);
                    };
                    return .Ok(n);
                }
            } else if vt_addr == READER_SENTINEL_BYTES {
                return byte_reader_discard_cb(self.ctx, bytes);
            }
        } else {
            let opt_discard_fn = unsafe {
                self.vtable.*.discard
            };
            if opt_discard_fn is .Some(discard_fn) {
                while true {
                    let n: u64 = discard_fn(self.ctx, bytes) catch |err| {
                        if err.is_interrupted() {
                            continue;
                        }
                        return .Err(err);
                    };
                    return .Ok(n);
                }
            }
        }
        var skipped = 0_u64;
        var scratch: [u8; 4_096];
        while skipped < bytes {
            let rem_u64: u64 = bytes -% skipped;
            let chunk_cap: usize = if rem_u64 < 4_096_u64 => rem_u64 as usize else 4_096_usize;
            var base_out = OutBuf.over_uninit(&out scratch);
            var bounded_out = unsafe {
                OutBuf.from_raw_parts(base_out.unfilled_raw().0, chunk_cap)
            };
            let n: usize = self.read_out(&mut bounded_out) catch |err| {
                if err.is_interrupted() {
                    continue;
                }
                return .Err(err);
            };
            if n == 0_usize {
                break;
            }
            skipped = skipped +% (n as u64);
        }
        .Ok(skipped)
    }
}

impl Writer {
    /| Constructs a `Writer` handle from a raw context pointer and non-null `WriterVTable`.
    @no_alloc @no_panic
    pub unsafe fn from_raw(ctx: *mut opaque, vtable: *WriterVTable, /) -> Writer = Writer {
        ctx,
        vtable,
    };

    /| Returns a stateless null sink `Writer` that discards all written bytes in `O(1)`.
    @inline @no_alloc @no_panic
    pub fn sink() -> Writer {
        Writer {
            ctx: @default_init[*mut opaque](),
            vtable: WRITER_SENTINEL_SINK as *WriterVTable,
        }
    }

    /| Borrows a `SliceWriter` cursor as a `Writer`.
    @inline @no_alloc @no_panic
    pub fn over_slice(cursor: &mut SliceWriter, /) -> Writer {
        cursor.as_writer()
    }

    /| Writes a prefix of `buf` into the underlying sink and returns the byte count accepted.
    @std_cap_boundary(clears: [fs, blocking_sync, ffi, unsafe_op])
    pub fn write(&mut self, buf: &[u8], /) -> usize!IoError {
        let vt_addr = self.vtable as usize;
        if (vt_addr & 1_usize) != 0_usize {
            return match vt_addr {
                WRITER_SENTINEL_SINK => sink_write_cb(self.ctx, buf),
                WRITER_SENTINEL_BUF => buf_writer_write_cb(self.ctx, buf),
                WRITER_SENTINEL_SLICE => slice_writer_write_cb(self.ctx, buf),
                WRITER_SENTINEL_FILE => file_sentinel_write(self.ctx, buf),
                _ => raw_stdio_write_cb(self.ctx, buf),
            };
        }
        let write_fn = unsafe {
            self.vtable.*.write
        };
        write_fn(self.ctx, buf)
    }

    /| Writes all of `buf` (retrying on `.Interrupted`), returning `.Err(.WriteZero)` if progress stalls.
    @std_cap_boundary(clears: [may_panic])
    pub fn write_all(&mut self, buf: &[u8], /) -> unit!IoError {
        let total: usize = buf.len();
        var written = 0_usize;
        while written < total {
            let n: usize = self.write(buf[written..total]) catch |err| {
                if err.is_interrupted() {
                    continue;
                }
                return .Err(err);
            };
            if n == 0_usize {
                return .Err(IoError.from_kind(.WriteZero, op: .Write));
            }
            written = written +| n;
        }
        .Ok(())
    }

    /| Writes a single byte `byte_val` into `self`.
    @inline
    pub fn write_byte(&mut self, byte_val: u8, /) -> unit!IoError {
        self.write_all(&[byte_val])
    }

    /| Writes `count` repetitions of `byte_val` in `256 B` stack-batched chunks (`0` heap allocations).
    @std_cap_boundary(clears: [may_panic])
    pub fn write_splat(&mut self, byte_val: u8, var count: usize, /) -> unit!IoError {
        if count == 0_usize {
            return .Ok(());
        }
        let batch: [u8; 256] = [byte_val; 256];
        while count >= 256_usize {
            self.write_all(&batch)?;
            count -= 256_usize;
        }
        if count > 0_usize {
            self.write_all(batch[0..count])?;
        }
        .Ok(())
    }

    /| Writes scatter-gather `bufs`, falling back to the first non-empty `IoSlice` when `vtable.write_vectored` is `.None`.
    @std_cap_boundary(clears: [fs, blocking_sync, ffi, unsafe_op])
    pub fn write_vectored(&mut self, bufs: &[IoSlice], /) -> usize!IoError {
        let vt_addr = self.vtable as usize;
        if (vt_addr & 1_usize) != 0_usize {
            if vt_addr == WRITER_SENTINEL_SINK {
                return sink_write_vectored_cb(self.ctx, bufs);
            } else if vt_addr == WRITER_SENTINEL_BUF {
                return buf_writer_write_vectored_cb(self.ctx, bufs);
            } else if vt_addr == WRITER_SENTINEL_SLICE {
                return slice_writer_write_vectored_cb(self.ctx, bufs);
            } else if vt_addr == WRITER_SENTINEL_FILE {
                return file_sentinel_write_vectored(self.ctx, bufs);
            }
        } else {
            let opt_vec_fn = unsafe {
                self.vtable.*.write_vectored
            };
            if opt_vec_fn is .Some(vec_fn) {
                return vec_fn(self.ctx, bufs);
            }
        }
        for slice in bufs {
            if not slice.is_empty() {
                return self.write(slice.as_slice());
            }
        }
        .Ok(0_usize)
    }

    /| Writes every byte across `bufs` (retrying on `.Interrupted` and handling partial mid-slice progress).
    @std_cap_boundary(clears: [may_panic])
    pub fn write_all_vectored(&mut self, bufs: &[IoSlice], /) -> unit!IoError {
        let total_slices: usize = bufs.len();
        var slice_idx = 0_usize;
        var head_skip = 0_usize;
        while slice_idx < total_slices {
            let first_full: &[u8] = bufs[slice_idx].as_slice();
            if head_skip >= first_full.len() {
                head_skip = 0_usize;
                slice_idx += 1_usize;
                continue;
            }
            if head_skip > 0_usize {
                let tail_part: &[u8] = first_full[head_skip..first_full.len()];
                var wrote: usize = write_vectored_tail_batch(
                    self,
                    tail_part,
                    bufs,
                    slice_idx + 1_usize,
                ) catch |err| {
                    if err.is_interrupted() {
                        continue;
                    }
                    return .Err(err);
                };
                if wrote == 0_usize {
                    return .Err(IoError.from_kind(.WriteZero, op: .Write));
                }
                if wrote < tail_part.len() {
                    head_skip = head_skip +% wrote;
                    continue;
                }
                wrote = wrote -% tail_part.len();
                head_skip = 0_usize;
                slice_idx += 1_usize;
                while slice_idx < total_slices {
                    let step_len: usize = bufs[slice_idx].len();
                    if wrote < step_len {
                        break;
                    }
                    wrote = wrote -% step_len;
                    slice_idx += 1_usize;
                }
                head_skip = wrote;
                continue;
            }
            var wrote_direct: usize = self.write_vectored(bufs[slice_idx..total_slices]) catch |err| {
                if err.is_interrupted() {
                    continue;
                }
                return .Err(err);
            };
            if wrote_direct == 0_usize {
                return .Err(IoError.from_kind(.WriteZero, op: .Write));
            }
            while slice_idx < total_slices {
                let step_len: usize = bufs[slice_idx].len();
                if wrote_direct < step_len {
                    break;
                }
                wrote_direct = wrote_direct -% step_len;
                slice_idx += 1_usize;
            }
            head_skip = wrote_direct;
        }
        .Ok(())
    }

    /| Streams `args` (`SE-12` `FmtArgs`) via a `512 B` stack coalescing bridge with `0` heap allocations.
    @std_cap_boundary(clears: [unsafe_op, alloc]) @no_alloc
    pub fn print(&mut self, args: FmtArgs, /) -> unit!IoError {
        var bridge = WriterFmtBridge {
            target: &raw mut self.*,
            scratch: [0_u8; 512],
            filled: 0_usize,
            sticky_err: .None,
        };
        var fmt_sink = FmtWriter {
            ctx: (&raw mut bridge) as *mut opaque,
            write_fn: writer_fmt_bridge_cb,
        };
        @fmt_write(&mut fmt_sink, args) catch {
            return .Err(bridge.sticky_err orelse IoError.from_kind(.Other, op: .Write));
        };
        if bridge.filled > 0_usize {
            let tail_slice: &[u8] = unsafe {
                @slice_from_raw_parts(&raw bridge.scratch[0], bridge.filled)
            };
            self.write_all(tail_slice)?;
        }
        .Ok(())
    }

    /| Flushes buffered downstream state when `vtable.flush` is present (retrying on `.Interrupted`).
    @std_cap_boundary(clears: [fs, blocking_sync, ffi, unsafe_op])
    pub fn flush(&mut self) -> unit!IoError {
        let vt_addr = self.vtable as usize;
        if (vt_addr & 1_usize) != 0_usize {
            return match vt_addr {
                WRITER_SENTINEL_SINK => sink_flush_cb(self.ctx),
                WRITER_SENTINEL_BUF => {
                    while true {
                        buf_writer_flush_cb(self.ctx) catch |err| {
                            if err.is_interrupted() {
                                continue;
                            }
                            return .Err(err);
                        };
                        break;
                    }
                    .Ok(())
                },
                WRITER_SENTINEL_FILE => {
                    while true {
                        file_sentinel_flush(self.ctx) catch |err| {
                            if err.is_interrupted() {
                                continue;
                            }
                            return .Err(err);
                        };
                        break;
                    }
                    .Ok(())
                },
                _ => .Ok(()),
            };
        }
        let opt_flush_fn = unsafe {
            self.vtable.*.flush
        };
        if opt_flush_fn is .Some(flush_fn) {
            while true {
                flush_fn(self.ctx) catch |err| {
                    if err.is_interrupted() {
                        continue;
                    }
                    return .Err(err);
                };
                return .Ok(());
            }
        }
        .Ok(())
    }
}

// ---------------- Buffered Streams & Adapters -----------------
impl BufReader {
    /| Allocates an `8 KiB` (`DEFAULT_IO_BUF_SIZE`) `BufReader` backed by `cx.mem.System` (`AutoDrop` frees on exit).
    pub fn new(upstream: Reader, /) -> BufReader {
        BufReader.with_capacity(upstream, DEFAULT_IO_BUF_SIZE)
    }

    /| Allocates a `cap`-byte `BufReader` backed by `cx.mem.System` (`cap == 0` defaults to `DEFAULT_IO_BUF_SIZE`).
    @std_cap_boundary(clears: [unsafe_op])
    pub fn with_capacity(upstream: Reader, cap: usize, /) -> BufReader {
        let eff_cap: usize = if cap == 0_usize => DEFAULT_IO_BUF_SIZE
            else (cap & BUF_READER_CAP_MASK);
        let raw_ptr: *mut u8 = System
            .handle()
            .alloc(
                Layout { size: eff_cap, alignment: OWNED_IO_BUF_ALIGN },
            ) catch {
            panic(f"BufReader.with_capacity({eff_cap=}) out of memory");
        };
        BufReader {
            upstream,
            buf_ptr: raw_ptr,
            cap_and_flag: eff_cap | BUF_READER_OWNS_SYS_MASK,
            pos: 0_usize,
            filled: 0_usize,
        }
    }

    /| Wraps uninitialized stack/array storage `backing` (`0` heap allocations, `0` `memset`).
    @no_alloc @no_panic
    pub fn over_uninit[const N: usize](upstream: Reader, backing: &out [u8; N], /) -> BufReader {
        BufReader {
            upstream,
            buf_ptr: (&raw mut backing.*) as *mut u8,
            cap_and_flag: N & BUF_READER_CAP_MASK,
            pos: 0_usize,
            filled: 0_usize,
        }
    }

    /| Wraps caller-provided mutable slice `backing` (`0` heap allocations).
    @inline @no_alloc @no_panic
    pub fn over_slice(upstream: Reader, backing: &mut [u8], /) -> BufReader {
        BufReader {
            upstream,
            buf_ptr: backing.as_mut_ptr(),
            cap_and_flag: backing.len() & BUF_READER_CAP_MASK,
            pos: 0_usize,
            filled: 0_usize,
        }
    }

    /| Allocates an unzeroed `cap`-byte buffer inside `arena` (`AutoDrop` is a no-op because `OWNS_SYS == 0`).
    pub fn in_arena(
        arena: &mut Arena,
        upstream: Reader,
        /,
        *,
        cap: usize = DEFAULT_IO_BUF_SIZE,
    ) -> BufReader {
        let eff_cap: usize = if cap == 0_usize => DEFAULT_IO_BUF_SIZE
            else (cap & BUF_READER_CAP_MASK);
        let slice: &mut [u8] = arena.alloc_slice[u8](eff_cap, zeroed: false);
        BufReader {
            upstream,
            buf_ptr: slice.as_mut_ptr(),
            cap_and_flag: eff_cap,
            pos: 0_usize,
            filled: 0_usize,
        }
    }

    /| Returns the unconsumed byte count currently buffered (`filled - pos`).
    @no_alloc @no_panic
    pub fn available(&self) -> usize = self.filled -| self.pos;

    /| Returns the backing buffer capacity in bytes.
    @no_alloc @no_panic
    pub fn capacity(&self) -> usize = self.cap_and_flag & BUF_READER_CAP_MASK;

    /| Borrows the active unread window `buf[pos..filled]` as `&[u8]`.
    @std_cap_boundary(clears: [unsafe_op]) @inline @no_alloc @no_panic
    pub fn buffered(&self) -> &[u8] {
        let avail: usize = self.available();
        if avail == 0_usize or self.buf_ptr.is_null() {
            return EMPTY_BYTES;
        }
        unsafe {
            @slice_from_raw_parts(self.buf_ptr.add(self.pos) as *u8, avail)
        }
    }

    /| Ensures at least `min_bytes` are buffered (or `&[]` at clean EOF), returning `.UnexpectedEof` on short tail.
    @std_cap_boundary(clears: [unsafe_op])
    pub fn peek(&mut self, min_bytes: usize = 1_usize, /) -> (&[u8])!IoError {
        let cap: usize = self.capacity();
        if min_bytes > cap {
            return .Err(IoError.from_kind(.InvalidInput, op: .Read));
        }
        if self.available() >= min_bytes {
            return .Ok(self.buffered());
        }
        let tail_len: usize = self.available();
        if tail_len > 0_usize and self.pos > 0_usize and not self.buf_ptr.is_null() {
            unsafe {
                @memmove(
                    self.buf_ptr as *mut opaque,
                    self.buf_ptr.add(self.pos) as *opaque,
                    tail_len,
                );
            }
        }
        self.pos = 0_usize;
        self.filled = tail_len;

        while self.filled < min_bytes {
            var out = unsafe {
                OutBuf.from_raw_parts(self.buf_ptr.add(self.filled), cap -% self.filled)
            };
            let n: usize = self.upstream.read_out(&mut out) catch |err| {
                if err.is_interrupted() {
                    continue;
                }
                return .Err(err);
            };
            if n == 0_usize {
                if self.filled == 0_usize {
                    return .Ok(EMPTY_BYTES);
                }
                return .Err(IoError.from_kind(.UnexpectedEof, op: .Read));
            }
            self.filled = self.filled +% n;
        }
        .Ok(self.buffered())
    }

    /| Advances the read cursor by `n` buffered bytes, resetting `pos` and `filled` to `0` when drained.
    @inline @no_alloc @no_panic
    pub fn consume(&mut self, n: usize, /) {
        let avail: usize = self.available();
        debug_assert(n <= avail, "BufReader.consume exceeded buffered byte count");
        let step: usize = if n <= avail => n else avail;
        self.pos = self.pos +% step;
        if self.pos >= self.filled {
            self.pos = 0_usize;
            self.filled = 0_usize;
        }
    }

    /| Scans for `delim` via SIMD/SWAR + lazy tail rebase, returning slice excluding `delim` (or `.None` at EOF).
    @std_cap_boundary(clears: [unsafe_op, may_panic])
    pub fn read_until(&mut self, delim: u8, /) -> (&[u8])?!IoError {
        let cap: usize = self.capacity();
        var scanned_offset = 0_usize;
        while true {
            let window: &[u8] = self.buffered();
            let win_len: usize = window.len();
            if scanned_offset < win_len {
                if find_byte_fast(window[scanned_offset..win_len], delim) is .Some(rel_idx) {
                    let match_len: usize = scanned_offset +% rel_idx;
                    let base_ptr: *u8 = unsafe {
                        self.buf_ptr.add(self.pos) as *u8
                    };
                    self.pos = self.pos +% match_len +% 1_usize;
                    if self.pos >= self.filled {
                        self.pos = 0_usize;
                        self.filled = 0_usize;
                    }
                    return .Ok(
                        .Some(
                            unsafe {
                                @slice_from_raw_parts(base_ptr, match_len)
                            },
                        ),
                    );
                }
                scanned_offset = win_len;
            }
            if win_len >= cap {
                return .Err(IoError.from_kind(.StreamTooLong, op: .Read));
            }
            if self.pos > 0_usize and win_len > 0_usize and not self.buf_ptr.is_null() {
                unsafe {
                    @memmove(
                        self.buf_ptr as *mut opaque,
                        self.buf_ptr.add(self.pos) as *opaque,
                        win_len,
                    );
                }
            }
            self.filled = win_len;
            self.pos = 0_usize;

            var out = unsafe {
                OutBuf.from_raw_parts(self.buf_ptr.add(self.filled), cap -% self.filled)
            };
            let n: usize = self.upstream.read_out(&mut out) catch |err| {
                if err.is_interrupted() {
                    continue;
                }
                return .Err(err);
            };
            if n == 0_usize {
                if self.filled == 0_usize {
                    return .Ok(.None);
                }
                let final_len: usize = self.filled;
                self.filled = 0_usize;
                return .Ok(
                    .Some(
                        unsafe {
                            @slice_from_raw_parts(self.buf_ptr as *u8, final_len)
                        },
                    ),
                );
            }
            self.filled = self.filled +% n;
        }
        .Ok(.None)
    }

    /| Appends bytes up through `delim` into `dst` across multiple refills (capping at `max_bytes`, returning `0` on EOF).
    @std_cap_boundary(clears: [unsafe_op, may_panic])
    pub fn read_until_into(
        &mut self,
        delim: u8,
        dst: &mut Vec[u8],
        /,
        *,
        max_bytes: usize = DEFAULT_READ_UNTIL_MAX,
    ) -> usize!IoError {
        let cap: usize = self.capacity();
        if cap == 0_usize {
            return .Err(IoError.from_kind(.InvalidInput, op: .Read));
        }
        var total_appended = 0_usize;
        while true {
            if self.available() == 0_usize {
                self.pos = 0_usize;
                self.filled = 0_usize;
                var refill = unsafe {
                    OutBuf.from_raw_parts(self.buf_ptr, cap)
                };
                let n: usize = self.upstream.read_out(&mut refill) catch |err| {
                    if err.is_interrupted() {
                        continue;
                    }
                    return .Err(err);
                };
                if n == 0_usize {
                    return .Ok(total_appended);
                }
                self.filled = n;
            }
            let window: &[u8] = self.buffered();
            let win_len: usize = window.len();
            if find_byte_fast(window, delim) is .Some(rel_idx) {
                let take_len: usize = if rel_idx < win_len => rel_idx + 1_usize else win_len;
                if take_len > max_bytes -| total_appended {
                    return .Err(IoError.from_kind(.StreamTooLong, op: .Read));
                }
                dst.try_reserve(take_len) catch {
                    return .Err(IoError.from_kind(.OutOfMemory, op: .Read));
                };
                if take_len <= win_len {
                    dst.extend_from_slice(window[0..take_len]);
                }
                self.consume(take_len);
                return .Ok(total_appended +% take_len);
            }
            if win_len > max_bytes -| total_appended {
                return .Err(IoError.from_kind(.StreamTooLong, op: .Read));
            }
            dst.try_reserve(win_len) catch {
                return .Err(IoError.from_kind(.OutOfMemory, op: .Read));
            };
            dst.extend_from_slice(window);
            total_appended = total_appended +% win_len;
            self.consume(win_len);
        }
        .Ok(total_appended)
    }

    /| Reads the next UTF-8 line stripped of `\n` / `\r\n`, returning `.None` on EOF or `.Err(.InvalidData)` on bad UTF-8.
    @std_cap_boundary(clears: [unsafe_op, may_panic])
    pub fn next_line(&mut self) -> str?!IoError {
        let opt_raw: (&[u8])? = self.read_until(b'\n')?;
        let raw_line: &[u8] = opt_raw orelse return .Ok(.None);
        let raw_len: usize = raw_line.len();
        let trimmed: &[u8] = if raw_len > 0_usize and raw_line[raw_len - 1_usize] == b'\r' {
            raw_line[0..(raw_len - 1_usize)]
        } else {
            raw_line
        };
        if not is_valid_utf8(trimmed) {
            return .Err(IoError.from_kind(.InvalidData, op: .Read));
        }
        .Ok(
            .Some(
                unsafe {
                    @str_from_utf8_unchecked(trimmed)
                },
            ),
        )
    }

    /| Borrows `self` as a type-erased `Reader`.
    @inline @no_alloc @no_panic
    pub fn as_reader(&mut self) -> Reader {
        Reader {
            ctx: (&raw mut self.*) as *mut opaque,
            vtable: READER_SENTINEL_BUF as *ReaderVTable,
        }
    }
}

impl AutoDrop for BufReader {
    /| Releases `buf_ptr` back to `cx.mem.System` iff `OWNS_SYSTEM_BUF` is set (`0` ops on stack/arena buffers).
    @no_alloc @no_panic
    pub fn drop(&mut self) {
        if (self.cap_and_flag & BUF_READER_OWNS_SYS_MASK) != 0_usize {
            let cap_bytes: usize = self.cap_and_flag & BUF_READER_CAP_MASK;
            if cap_bytes > 0_usize and not self.buf_ptr.is_null() {
                System
                    .handle()
                    .dealloc(
                        self.buf_ptr,
                        Layout { size: cap_bytes, alignment: OWNED_IO_BUF_ALIGN },
                    );
            }
            self.cap_and_flag = 0_usize;
        }
    }
}

impl BufWriter {
    /| Allocates an `8 KiB` (`DEFAULT_IO_BUF_SIZE`) `@linear BufWriter` via `cx.mem.System`.
    pub fn new(downstream: Writer, /, *, line_buffered: bool = false) -> BufWriter {
        BufWriter.with_capacity(downstream, DEFAULT_IO_BUF_SIZE, line_buffered: line_buffered)
    }

    /| Allocates a `cap`-byte (`<= 1 GiB - 1`) `@linear BufWriter` via `cx.mem.System`.
    @std_cap_boundary(clears: [unsafe_op])
    pub fn with_capacity(
        downstream: Writer,
        cap: usize,
        /,
        *,
        line_buffered: bool = false,
    ) -> BufWriter {
        let clamped_u32: u32 = if cap == 0_usize => DEFAULT_IO_BUF_SIZE as u32
            else if cap > (BUF_WRITER_CAP_MASK as usize) => BUF_WRITER_CAP_MASK
            else cap as u32;
        let raw_ptr: *mut u8 = System
            .handle()
            .alloc(
                Layout { size: clamped_u32 as usize, alignment: OWNED_IO_BUF_ALIGN },
            ) catch {
            panic(f"BufWriter.with_capacity({clamped_u32=}) out of memory");
        };
        let line_bit: u32 = if line_buffered => BUF_WRITER_LINE_BUF_FLAG else 0_u32;
        BufWriter {
            downstream,
            buf_ptr: raw_ptr,
            filled: 0_u32,
            cap_and_flags: clamped_u32 | BUF_WRITER_OWNS_SYS_FLAG | line_bit,
        }
    }

    /| Wraps uninitialized stack/array storage `backing` (`0` heap allocations, `0` `memset`).
    @no_alloc @no_panic
    pub fn over_uninit[const N: usize](
        downstream: Writer,
        backing: &out [u8; N],
        /,
        *,
        line_buffered: bool = false,
    ) -> BufWriter {
        let cap_u32: u32 = if N > (BUF_WRITER_CAP_MASK as usize) => BUF_WRITER_CAP_MASK
            else N as u32;
        let line_bit: u32 = if line_buffered => BUF_WRITER_LINE_BUF_FLAG else 0_u32;
        BufWriter {
            downstream,
            buf_ptr: (&raw mut backing.*) as *mut u8,
            filled: 0_u32,
            cap_and_flags: cap_u32 | line_bit,
        }
    }

    /| Wraps caller-provided mutable slice `backing` (`0` heap allocations).
    @inline @no_alloc @no_panic
    pub fn over_slice(
        downstream: Writer,
        backing: &mut [u8],
        /,
        *,
        line_buffered: bool = false,
    ) -> BufWriter {
        let cap_u32: u32 = if backing.len() > (BUF_WRITER_CAP_MASK as usize) => BUF_WRITER_CAP_MASK
            else backing.len() as u32;
        let line_bit: u32 = if line_buffered => BUF_WRITER_LINE_BUF_FLAG else 0_u32;
        BufWriter {
            downstream,
            buf_ptr: backing.as_mut_ptr(),
            filled: 0_u32,
            cap_and_flags: cap_u32 | line_bit,
        }
    }

    /| Allocates an unzeroed `cap`-byte buffer inside `arena` (`OWNS_SYSTEM_BUF == 0`).
    pub fn in_arena(
        arena: &mut Arena,
        downstream: Writer,
        /,
        *,
        cap: u32 = 8_192_u32,
        line_buffered: bool = false,
    ) -> BufWriter {
        let eff_u32: u32 = if cap == 0_u32 => 8_192_u32 else (cap & BUF_WRITER_CAP_MASK);
        let slice: &mut [u8] = arena.alloc_slice[u8](eff_u32 as usize, zeroed: false);
        let line_bit: u32 = if line_buffered => BUF_WRITER_LINE_BUF_FLAG else 0_u32;
        BufWriter {
            downstream,
            buf_ptr: slice.as_mut_ptr(),
            filled: 0_u32,
            cap_and_flags: eff_u32 | line_bit,
        }
    }

    /| Returns the count of unflushed bytes currently buffered in `self`.
    @no_alloc @no_panic
    pub fn buffered_len(&self) -> usize = self.filled as usize;

    /| Returns the total byte capacity of `self`'s internal buffer.
    @no_alloc @no_panic
    pub fn capacity(&self) -> usize = (self.cap_and_flags & BUF_WRITER_CAP_MASK) as usize;

    /| Returns the remaining free buffer capacity (`capacity() - buffered_len()`).
    @no_alloc @no_panic
    pub fn spare_capacity(&self) -> usize = self.capacity() -| self.buffered_len();

    /| Returns `true` when automatic newline (`b'\n'`) flushing is enabled on `self`.
    @no_alloc @no_panic
    pub fn is_line_buffered(&self) -> bool =
        (self.cap_and_flags & BUF_WRITER_LINE_BUF_FLAG) != 0_u32;

    /| Drains `buf_ptr[0..filled]` into `downstream`, preserving any unwritten suffix on partial failure.
    @std_cap_boundary(clears: [unsafe_op, may_panic])
    fn flush_buffer_only(&mut self) -> unit!IoError {
        let total_buf = self.filled as usize;
        if total_buf == 0_usize or self.buf_ptr.is_null() {
            self.filled = 0_u32;
            return .Ok(());
        }
        var written = 0_usize;
        while written < total_buf {
            let pending: &[u8] = unsafe {
                @slice_from_raw_parts(self.buf_ptr.add(written) as *u8, total_buf -% written)
            };
            let res: usize!IoError = self.downstream.write(pending);
            match res {
                .Ok(n) => {
                    if n == 0_usize {
                        if written > 0_usize {
                            let rem_zero: usize = total_buf -% written;
                            unsafe {
                                @memmove(
                                    self.buf_ptr as *mut opaque,
                                    self.buf_ptr.add(written) as *opaque,
                                    rem_zero,
                                );
                            }
                            self.filled = rem_zero as u32;
                        }
                        return .Err(IoError.from_kind(.WriteZero, op: .Write));
                    }
                    written = written +% n;
                },
                .Err(err) => {
                    if err.is_interrupted() {
                        continue;
                    }
                    if written > 0_usize {
                        let rem_err: usize = total_buf -% written;
                        unsafe {
                            @memmove(
                                self.buf_ptr as *mut opaque,
                                self.buf_ptr.add(written) as *opaque,
                                rem_err,
                            );
                        }
                        self.filled = rem_err as u32;
                    }
                    return .Err(err);
                },
            }
        }
        self.filled = 0_u32;
        .Ok(())
    }

    /| Appends `data` to `self` (flushing or bypassing when full, and honoring `is_line_buffered()`).
    @std_cap_boundary(clears: [unsafe_op, may_panic])
    pub fn write(&mut self, data: &[u8], /) -> usize!IoError {
        let data_len: usize = data.len();
        if data_len == 0_usize {
            return .Ok(0_usize);
        }
        let cap: usize = self.capacity();
        if cap == 0_usize or self.buf_ptr.is_null() {
            return self.downstream.write(data);
        }
        if self.is_line_buffered() {
            if rfind_byte(data, b'\n') is .Some(nl_idx) {
                let prefix_len: usize = if nl_idx < data_len => nl_idx + 1_usize else data_len;
                if prefix_len <= self.spare_capacity() {
                    unsafe {
                        @memcpy(
                            self.buf_ptr.add(self.filled as usize) as *mut opaque,
                            data.as_ptr() as *opaque,
                            prefix_len,
                        );
                    }
                    self.filled = self.filled +% (prefix_len as u32);
                    self.flush()?;
                } else {
                    self.flush_buffer_only()?;
                    if prefix_len <= data_len {
                        self.downstream.write_all(data[0..prefix_len])?;
                    }
                    self.downstream.flush()?;
                }
                if prefix_len < data_len {
                    let tail: &[u8] = data[prefix_len..data_len];
                    if tail.len() >= cap {
                        self.downstream.write_all(tail)?;
                    } else {
                        unsafe {
                            @memcpy(
                                self.buf_ptr as *mut opaque,
                                tail.as_ptr() as *opaque,
                                tail.len(),
                            );
                        }
                        self.filled = tail.len() as u32;
                    }
                }
                return .Ok(data_len);
            }
        }
        if data_len <= self.spare_capacity() {
            unsafe {
                @memcpy(
                    self.buf_ptr.add(self.filled as usize) as *mut opaque,
                    data.as_ptr() as *opaque,
                    data_len,
                );
            }
            self.filled = self.filled +% (data_len as u32);
            return .Ok(data_len);
        }
        self.flush_buffer_only()?;
        if data_len >= cap {
            return self.downstream.write(data);
        }
        unsafe {
            @memcpy(self.buf_ptr as *mut opaque, data.as_ptr() as *opaque, data_len);
        }
        self.filled = data_len as u32;
        .Ok(data_len)
    }

    /| Writes all bytes of `data` into `self` (coalescing in `buf_ptr` and honoring `is_line_buffered()`).
    @std_cap_boundary(clears: [may_panic])
    pub fn write_all(&mut self, data: &[u8], /) -> unit!IoError {
        let total: usize = data.len();
        var written = 0_usize;
        while written < total {
            let n: usize = self.write(data[written..total]) catch |err| {
                if err.is_interrupted() {
                    continue;
                }
                return .Err(err);
            };
            if n == 0_usize {
                return .Err(IoError.from_kind(.WriteZero, op: .Write));
            }
            written = written +| n;
        }
        .Ok(())
    }

    /| Appends a single byte `byte_val` to `self` without slice loop overhead when buffer space remains.
    @std_cap_boundary(clears: [unsafe_op])
    pub fn write_byte(&mut self, byte_val: u8, /) -> unit!IoError {
        if self.capacity() == 0_usize or self.buf_ptr.is_null() {
            return self.downstream.write_byte(byte_val);
        }
        if self.spare_capacity() == 0_usize {
            self.flush_buffer_only()?;
        }
        let write_ptr: *mut u8 = unsafe {
            self.buf_ptr.add(self.filled as usize)
        };
        if not write_ptr.is_null() {
            unsafe {
                write_ptr.* = byte_val;
            }
        }
        self.filled = self.filled +% 1_u32;
        if byte_val == b'\n' and self.is_line_buffered() {
            return self.flush();
        }
        .Ok(())
    }

    /| Coalesces small scatter `bufs` into `self.buf_ptr` or forwards combined `IoSlice` vectors downstream.
    @std_cap_boundary(clears: [unsafe_op, may_panic])
    pub fn write_vectored(&mut self, bufs: &[IoSlice], /) -> usize!IoError {
        var total_incoming = 0_usize;
        for slice in bufs {
            total_incoming = total_incoming +| slice.len();
        }
        if total_incoming == 0_usize {
            return .Ok(0_usize);
        }
        if self.is_line_buffered() or self.buf_ptr.is_null() {
            var written_lb = 0_usize;
            for slice in bufs {
                let bytes: &[u8] = slice.as_slice();
                if not bytes.is_empty() {
                    self.write_all(bytes)?;
                    written_lb = written_lb +% bytes.len();
                }
            }
            return .Ok(written_lb);
        }
        if total_incoming <= self.spare_capacity() {
            self.filled = copy_io_slices_to_buf(self.buf_ptr, self.filled, bufs);
            return .Ok(total_incoming);
        }
        if self.filled == 0_u32 {
            return self.downstream.write_vectored(bufs);
        }
        var combined: [IoSlice; 16] = [IoSlice.new(EMPTY_BYTES); 16];
        let buf_len = self.filled as usize;
        combined[0] = IoSlice.new(
            unsafe {
                @slice_from_raw_parts(self.buf_ptr as *u8, buf_len)
            },
        );
        let take_n: usize = if bufs.len() < 15_usize => bufs.len() else 15_usize;
        var idx = 0_usize;
        while idx < take_n {
            if idx < bufs.len() and (idx + 1_usize) < 16_usize {
                combined[idx + 1_usize] = bufs[idx];
            }
            idx += 1_usize;
        }
        let batch_total: usize = take_n + 1_usize;
        let combined_view: &[IoSlice] = if batch_total <= 16_usize => combined[0..batch_total]
            else &combined;
        let written: usize = self.downstream.write_vectored(combined_view)?;
        if written < buf_len {
            let rem: usize = buf_len -% written;
            unsafe {
                @memmove(
                    self.buf_ptr as *mut opaque,
                    self.buf_ptr.add(written) as *opaque,
                    rem,
                );
            }
            self.filled = rem as u32;
            self.flush_buffer_only()?;
            return self.downstream.write_vectored(bufs);
        }
        self.filled = 0_u32;
        if written > buf_len {
            return .Ok(written -% buf_len);
        }
        if total_incoming <= self.capacity() {
            self.filled = copy_io_slices_to_buf(self.buf_ptr, 0_u32, bufs);
            return .Ok(total_incoming);
        }
        self.downstream.write_vectored(bufs)
    }

    /| Writes all bytes across `bufs` into `self` (coalescing small slices before flushing).
    @std_cap_boundary(clears: [may_panic])
    pub fn write_all_vectored(&mut self, bufs: &[IoSlice], /) -> unit!IoError {
        if self.is_line_buffered() {
            for slice in bufs {
                let bytes: &[u8] = slice.as_slice();
                if not bytes.is_empty() {
                    self.write_all(bytes)?;
                }
            }
            return .Ok(());
        }
        var adapter: Writer = self.as_writer();
        adapter.write_all_vectored(bufs)
    }

    /| Streams `args` (`FmtArgs`) directly into `self.buf_ptr` with `0` heap allocations.
    @std_cap_boundary(clears: [unsafe_op, alloc]) @no_alloc
    pub fn print(&mut self, args: FmtArgs, /) -> unit!IoError {
        var bridge = BufWriterFmtBridge {
            target: &raw mut self.*,
            sticky_err: .None,
        };
        var fmt_sink = FmtWriter {
            ctx: (&raw mut bridge) as *mut opaque,
            write_fn: buf_writer_fmt_bridge_cb,
        };
        @fmt_write(&mut fmt_sink, args) catch {
            return .Err(bridge.sticky_err orelse IoError.from_kind(.Other, op: .Write));
        };
        .Ok(())
    }

    /| Drains all buffered bytes to `downstream` and invokes `downstream.flush()`.
    pub fn flush(&mut self) -> unit!IoError {
        self.flush_buffer_only()?;
        self.downstream.flush()
    }

    /| Borrows `self` as a type-erased `Writer`.
    @inline @no_alloc @no_panic
    pub fn as_writer(&mut self) -> Writer {
        Writer {
            ctx: (&raw mut self.*) as *mut opaque,
            vtable: WRITER_SENTINEL_BUF as *WriterVTable,
        }
    }

    /| Flushes `self`, always deallocating `System`-owned buffer storage even if `flush()` fails, and returns flush status.
    pub fn close(own self) -> unit!IoError {
        let BufWriter { downstream, buf_ptr, filled, cap_and_flags } = self;
        var target: Writer = downstream;
        let flush_res: unit!IoError = flush_raw_buf_writer_parts(&mut target, buf_ptr, filled);
        if (cap_and_flags & BUF_WRITER_OWNS_SYS_FLAG) != 0_u32 {
            let cap_bytes = (cap_and_flags & BUF_WRITER_CAP_MASK) as usize;
            if cap_bytes > 0_usize and not buf_ptr.is_null() {
                System
                    .handle()
                    .dealloc(
                        buf_ptr,
                        Layout { size: cap_bytes, alignment: OWNED_IO_BUF_ALIGN },
                    );
            }
        }
        flush_res
    }

    /| Consumes `self` without flushing buffered bytes and deallocates `System`-owned buffer storage when present.
    @no_alloc @no_panic
    pub fn discard(own self) {
        let BufWriter { buf_ptr, cap_and_flags, .. } = self;
        if (cap_and_flags & BUF_WRITER_OWNS_SYS_FLAG) != 0_u32 {
            let cap_bytes = (cap_and_flags & BUF_WRITER_CAP_MASK) as usize;
            if cap_bytes > 0_usize and not buf_ptr.is_null() {
                System
                    .handle()
                    .dealloc(
                        buf_ptr,
                        Layout { size: cap_bytes, alignment: OWNED_IO_BUF_ALIGN },
                    );
            }
        }
    }
}

impl LimitReader {
    /| Wraps `upstream` so at most `limit` bytes can be read before synthetic EOF (`0`).
    @no_alloc @no_panic
    pub fn new(upstream: Reader, limit: u64, /) -> LimitReader = LimitReader {
        upstream,
        remaining_bytes: limit,
    };

    /| Returns the unread byte budget remaining on `self`.
    @no_alloc @no_panic
    pub fn remaining(&self) -> u64 = self.remaining_bytes;

    /| Reads at most `min(out.remaining(), self.remaining())` bytes from `upstream` into `out`.
    @std_cap_boundary(clears: [unsafe_op])
    pub fn read_out(&mut self, out: &mut OutBuf, /) -> usize!IoError {
        if self.remaining_bytes == 0_u64 or out.is_full() {
            return .Ok(0_usize);
        }
        let max_usize: usize = clamp_u64_to_usize(self.remaining_bytes);
        let (dst_ptr, out_rem) = out.unfilled_raw();
        let cap_chunk: usize = if out_rem < max_usize => out_rem else max_usize;
        var sub_out = unsafe {
            OutBuf.from_raw_parts(dst_ptr, cap_chunk)
        };
        let n: usize = self.upstream.read_out(&mut sub_out)?;
        unsafe {
            out.advance_init(n);
        }
        self.remaining_bytes = self.remaining_bytes -| (n as u64);
        .Ok(n)
    }

    /| Borrows `self` as a type-erased `Reader`.
    @inline @no_alloc @no_panic
    pub fn as_reader(&mut self) -> Reader {
        Reader {
            ctx: (&raw mut self.*) as *mut opaque,
            vtable: READER_SENTINEL_LIMIT as *ReaderVTable,
        }
    }
}

impl ByteReader {
    /| Constructs a `ByteReader` positioned at offset `0` of `data`.
    @no_alloc @no_panic
    pub fn new(data: &[u8], /) -> ByteReader = ByteReader {
        data,
        pos: 0_usize,
    };

    /| Returns the unread byte count remaining from `position()` to `data.len()`.
    @no_alloc @no_panic
    pub fn remaining(&self) -> usize = self.data.len() -| self.pos;

    /| Returns the current cursor byte offset.
    @no_alloc @no_panic
    pub fn position(&self) -> u64 = self.pos as u64;

    /| Returns `true` when zero unread bytes remain (`pos >= data.len()`).
    @no_alloc @no_panic
    pub fn is_empty(&self) -> bool = self.pos >= self.data.len();

    /| Copies `min(remaining(), out.remaining())` bytes into `out` and advances `pos`.
    @std_cap_boundary(clears: [may_panic]) @no_alloc @no_panic
    pub fn read_out(&mut self, out: &mut OutBuf, /) -> usize!IoError {
        if self.pos >= self.data.len() or out.is_full() {
            return .Ok(0_usize);
        }
        let unread: &[u8] = self.data[self.pos..self.data.len()];
        let copied: usize = out.append(unread);
        self.pos = self.pos +% copied;
        .Ok(copied)
    }

    /| Repositions `self.pos` according to `pos` (failing with `.InvalidInput` on negative or `> usize.MAX` offset).
    @no_alloc @no_panic
    pub fn seek(&mut self, pos: SeekFrom, /) -> u64!IoError {
        let next_u64: u64 = compute_seek_offset(self.pos as u64, self.data.len() as u64, pos)?;
        if next_u64 > (usize.MAX as u64) {
            return .Err(IoError.from_kind(.InvalidInput, op: .Seek));
        }
        self.pos = next_u64 as usize;
        .Ok(next_u64)
    }

    /| Borrows `self` as a `Reader`.
    @inline @no_alloc @no_panic
    pub fn as_reader(&mut self) -> Reader {
        Reader {
            ctx: (&raw mut self.*) as *mut opaque,
            vtable: READER_SENTINEL_BYTES as *ReaderVTable,
        }
    }

    /| Borrows `self` as a `Seek` handle.
    @inline @no_alloc @no_panic
    pub fn as_seeker(&mut self) -> Seek {
        Seek {
            ctx: (&raw mut self.*) as *mut opaque,
            vtable: SEEK_SENTINEL_BYTES as *SeekVTable,
        }
    }
}

impl SliceWriter {
    /| Constructs a `SliceWriter` writing from index `0` of `buf`.
    @inline @no_alloc @no_panic
    pub fn new(buf: &mut [u8], /) -> SliceWriter {
        SliceWriter {
            ptr: buf.as_mut_ptr(),
            cap: buf.len(),
            pos: 0_usize,
        }
    }

    /| Borrows the slice prefix `0..position()` written up to the current cursor.
    @std_cap_boundary(clears: [unsafe_op]) @inline @no_alloc @no_panic
    pub fn written(&self) -> &[u8] {
        let len: usize = if self.pos <= self.cap => self.pos else self.cap;
        if len == 0_usize or self.ptr.is_null() {
            return EMPTY_BYTES;
        }
        unsafe {
            @slice_from_raw_parts(self.ptr as *u8, len)
        }
    }

    /| Returns the current write cursor offset in `0..=cap`.
    @no_alloc @no_panic
    pub fn position(&self) -> u64 = self.pos as u64;

    /| Returns the remaining writable capacity (`cap - pos`).
    @no_alloc @no_panic
    pub fn remaining(&self) -> usize = self.cap -| self.pos;

    /| Returns `true` when the cursor sits at offset `0`.
    @no_alloc @no_panic
    pub fn is_empty(&self) -> bool = self.pos == 0_usize;

    /| Returns `true` when `remaining() == 0`.
    @no_alloc @no_panic
    pub fn is_full(&self) -> bool = self.pos >= self.cap;

    /| Copies `min(data.len(), remaining())` bytes into `self` and returns bytes written (`0` when full).
    @std_cap_boundary(clears: [unsafe_op]) @no_alloc @no_panic
    pub fn write(&mut self, data: &[u8], /) -> usize!IoError {
        if data.is_empty() {
            return .Ok(0_usize);
        }
        let rem: usize = self.remaining();
        let copy_n: usize = if data.len() < rem => data.len() else rem;
        if copy_n > 0_usize and not self.ptr.is_null() {
            unsafe {
                @memcpy(
                    self.ptr.add(self.pos) as *mut opaque,
                    data.as_ptr() as *opaque,
                    copy_n,
                );
            }
            self.pos = self.pos +% copy_n;
        }
        .Ok(copy_n)
    }

    /| Repositions `self.pos` within `0..=cap` (failing with `.InvalidInput` if `< 0` or `> cap`).
    @no_alloc @no_panic
    pub fn seek(&mut self, pos: SeekFrom, /) -> u64!IoError {
        let next_u64: u64 = compute_seek_offset(self.pos as u64, self.cap as u64, pos)?;
        if next_u64 > (self.cap as u64) {
            return .Err(IoError.from_kind(.InvalidInput, op: .Seek));
        }
        self.pos = next_u64 as usize;
        .Ok(next_u64)
    }

    /| Borrows `self` as a `Writer`.
    @inline @no_alloc @no_panic
    pub fn as_writer(&mut self) -> Writer {
        Writer {
            ctx: (&raw mut self.*) as *mut opaque,
            vtable: WRITER_SENTINEL_SLICE as *WriterVTable,
        }
    }

    /| Borrows `self` as a `Seek` handle.
    @inline @no_alloc @no_panic
    pub fn as_seeker(&mut self) -> Seek {
        Seek {
            ctx: (&raw mut self.*) as *mut opaque,
            vtable: SEEK_SENTINEL_SLICE as *SeekVTable,
        }
    }
}

/| Streams all bytes from `src` into `dst` using an uninitialized `8 KiB` stack buffer (`0` `memset`, `0` heap allocs).
@std_cap_boundary(clears: [unsafe_op])
pub fn copy_stream(
    src: &mut Reader,
    dst: &mut Writer,
    /,
    *,
    max_bytes: u64 = u64.MAX,
) -> u64!IoError {
    var total_copied = 0_u64;
    var raw_buf: [u8; DEFAULT_IO_BUF_SIZE];
    while true {
        var base_out = OutBuf.over_uninit(&out raw_buf);
        if max_bytes < u64.MAX and total_copied == max_bytes {
            var probe_out = unsafe {
                OutBuf.from_raw_parts(base_out.unfilled_raw().0, 1_usize)
            };
            let probe_n: usize = src.read_out(&mut probe_out) catch |err| {
                if err.is_interrupted() {
                    continue;
                }
                return .Err(err);
            };
            if probe_n > 0_usize {
                return .Err(IoError.from_kind(.StreamTooLong, op: .Read));
            }
            return .Ok(total_copied);
        }
        let rem_u64: u64 = max_bytes -| total_copied;
        let chunk_cap: usize = if max_bytes == u64.MAX or rem_u64 >= (DEFAULT_IO_BUF_SIZE as u64) => DEFAULT_IO_BUF_SIZE
            else rem_u64 as usize;
        var bounded_out = unsafe {
            OutBuf.from_raw_parts(base_out.unfilled_raw().0, chunk_cap)
        };
        let n: usize = src.read_out(&mut bounded_out) catch |err| {
            if err.is_interrupted() {
                continue;
            }
            return .Err(err);
        };
        if n == 0_usize {
            return .Ok(total_copied);
        }
        dst.write_all(bounded_out.filled())?;
        total_copied = total_copied +% (n as u64);
    }
    .Ok(total_copied)
}

// ------------------ Locked Standard Streams -------------------
impl StdinLock {
    /| Borrows the inner `8 KiB` `BufReader` over standard input (`fd = 0`).
    @no_alloc @no_panic
    pub fn reader(&mut self) -> &mut BufReader = &mut self.inner_reader;

    /| Saves any unread lookahead window back to `StdioSlab` and releases the `stdin` lock.
    @std_cap_boundary(emits: [fs, blocking_sync], clears: [ffi, unsafe_op, indirect_opaque])
    @no_alloc @no_panic
    pub fn release(own self) {
        let StdinLock { inner_reader, lock_token } = self;
        let hdr_ptr = lock_token as *mut StdioTlsHeader;
        if not hdr_ptr.is_null() {
            let hdr: &mut StdioTlsHeader = unsafe {
                &mut hdr_ptr.*
            };
            let slab_ptr: *mut StdioSlab = hdr.slab_ptr;
            if not slab_ptr.is_null() {
                let slab: &mut StdioSlab = unsafe {
                    &mut slab_ptr.*
                };
                slab.stdin_pos = inner_reader.pos;
                slab.stdin_filled = inner_reader.filled;
            }
            release_stdio_lock(&raw mut hdr.stdin_lock);
        }
    }
}

impl StdoutLock {
    /| Borrows the inner `8 KiB` `BufWriter` over `stdout` / `stderr`.
    @no_alloc @no_panic
    pub fn writer(&mut self) -> &mut BufWriter = &mut self.inner_writer;

    /| Writes all of `data` into the locked buffered standard stream.
    @std_cap_boundary(emits: [fs, blocking_sync], clears: [ffi, unsafe_op, indirect_opaque])
    pub fn write_all(&mut self, data: &[u8], /) -> unit!IoError {
        self.inner_writer.write_all(data)
    }

    /| Formats `args` (`FmtArgs`) into the locked buffered standard stream with `0` heap allocations.
    @std_cap_boundary(emits: [fs, blocking_sync], clears: [ffi, unsafe_op, alloc, indirect_opaque])
    @no_alloc
    pub fn print(&mut self, args: FmtArgs, /) -> unit!IoError {
        self.inner_writer.print(args)
    }

    /| Flushes buffered bytes to `context.reactor` or the host OS descriptor.
    @std_cap_boundary(emits: [fs, blocking_sync], clears: [ffi, unsafe_op, indirect_opaque])
    pub fn flush(&mut self) -> unit!IoError {
        self.inner_writer.flush()
    }

    /| Flushes all buffered bytes, releases the stream lock, and propagates any flush `IoError`.
    @std_cap_boundary(emits: [fs, blocking_sync], clears: [ffi, unsafe_op, indirect_opaque])
    pub fn flush_and_release(own self) -> unit!IoError {
        let StdoutLock { var inner_writer, lock_token } = self;
        let flush_res: unit!IoError = inner_writer.flush();
        let rem_filled: u32 = inner_writer.filled;
        inner_writer.discard();
        finish_stdout_lock_token(lock_token, rem_filled);
        flush_res
    }

    /| Flushes buffered bytes on best-effort and releases the stream lock (`defer`-safe).
    @std_cap_boundary(emits: [fs, blocking_sync], clears: [ffi, unsafe_op, indirect_opaque])
    pub fn release(own self) {
        let StdoutLock { var inner_writer, lock_token } = self;
        inner_writer.flush() catch {};
        let rem_filled: u32 = inner_writer.filled;
        inner_writer.discard();
        finish_stdout_lock_token(lock_token, rem_filled);
    }
}

/| Acquires exclusive buffered access to standard input (`fd = 0`, `8 KiB` window).
@std_cap_boundary(emits: [fs, blocking_sync], clears: [
    ffi,
    unsafe_op,
    alloc,
    may_panic,
    indirect_opaque,
])
pub fn stdin_locked() -> StdinLock {
    let raw_reader = Reader {
        ctx: @default_init[*mut opaque](),
        vtable: READER_SENTINEL_STDIN as *ReaderVTable,
    };
    let hdr_ptr: *mut StdioTlsHeader = stdio_tls_header();
    if hdr_ptr.is_null() {
        return StdinLock {
            inner_reader: BufReader {
                upstream: raw_reader,
                buf_ptr: @default_init[*mut u8](),
                cap_and_flag: 0_usize,
                pos: 0_usize,
                filled: 0_usize,
            },
            lock_token: 0_usize,
        };
    }
    let hdr_addr = hdr_ptr as usize;
    let hdr: &mut StdioTlsHeader = unsafe {
        &mut hdr_ptr.*
    };
    acquire_stdio_lock(&raw mut hdr.stdin_lock);
    let slab_ptr: *mut StdioSlab = ensure_stdio_slab(hdr);
    if not slab_ptr.is_null() {
        let slab: &mut StdioSlab = unsafe {
            &mut slab_ptr.*
        };
        return StdinLock {
            inner_reader: BufReader {
                upstream: raw_reader,
                buf_ptr: &raw mut slab.stdin_buf[0],
                cap_and_flag: DEFAULT_IO_BUF_SIZE,
                pos: slab.stdin_pos,
                filled: slab.stdin_filled,
            },
            lock_token: hdr_addr,
        };
    }
    StdinLock {
        inner_reader: BufReader {
            upstream: raw_reader,
            buf_ptr: &raw mut hdr.emergency_buf[0],
            cap_and_flag: 2_usize,
            pos: 0_usize,
            filled: 0_usize,
        },
        lock_token: hdr_addr,
    }
}

/| Acquires exclusive buffered access to standard output (`fd = 1`; auto-line-buffered on TTY).
@std_cap_boundary(emits: [fs, blocking_sync], clears: [
    ffi,
    unsafe_op,
    alloc,
    may_panic,
    indirect_opaque,
])
pub fn stdout_locked() -> StdoutLock {
    lock_stdio_output_stream(false)
}

/| Acquires exclusive buffered access to standard error (`fd = 2`).
@std_cap_boundary(emits: [fs, blocking_sync], clears: [
    ffi,
    unsafe_op,
    alloc,
    may_panic,
    indirect_opaque,
])
pub fn stderr_locked() -> StderrLock {
    lock_stdio_output_stream(true)
}

/| Formats `args` into locked `stdout` (`0` heap allocations) and flushes in a single coalesced write.
@std_cap_boundary(emits: [fs, blocking_sync], clears: [
    ffi,
    unsafe_op,
    alloc,
    may_panic,
    indirect_opaque,
])
pub fn print(args: FmtArgs, /) {
    var out: StdoutLock = stdout_locked();
    out.print(args) catch {};
    out.release();
}

/| Formats `args` followed by `"\n"` into locked `stdout` (`0` heap allocations) and flushes.
@std_cap_boundary(emits: [fs, blocking_sync], clears: [
    ffi,
    unsafe_op,
    alloc,
    may_panic,
    indirect_opaque,
])
pub fn println(args: FmtArgs = "", /) {
    var out: StdoutLock = stdout_locked();
    if out.print(args) is .Ok(_) {
        out.write_all(b"\n") catch {};
    }
    out.release();
}

/| Formats `args` into locked `stderr` (`0` heap allocations) and flushes immediately.
@std_cap_boundary(emits: [fs, blocking_sync], clears: [
    ffi,
    unsafe_op,
    alloc,
    may_panic,
    indirect_opaque,
])
pub fn eprint(args: FmtArgs, /) {
    var err_out: StderrLock = stderr_locked();
    err_out.print(args) catch {};
    err_out.release();
}

/| Formats `args` followed by `"\n"` into locked `stderr` (`0` heap allocations) and flushes immediately.
@std_cap_boundary(emits: [fs, blocking_sync], clears: [
    ffi,
    unsafe_op,
    alloc,
    may_panic,
    indirect_opaque,
])
pub fn eprintln(args: FmtArgs = "", /) {
    var err_out: StderrLock = stderr_locked();
    if err_out.print(args) is .Ok(_) {
        err_out.write_all(b"\n") catch {};
    }
    err_out.release();
}

// ---------------------------------------- TESTS ----------------------------------------
/| Stateful mock writer recording `write_count`, `flush_count`, and optional failure triggers for unit tests.
struct FailingTestSink {
    /| Captured output bytes.
    buf: [u8; 64],
    /| Number of bytes accepted before failure.
    len: usize,
    /| Count of `flush` invocations observed.
    flushes: usize,
    /| When `true`, `write` and `flush` fail with `StorageFull`.
    fail_all: bool,
}

impl FailingTestSink {
    /| `WriterVTable.write` callback for `FailingTestSink`.
    @std_cap_boundary(clears: [unsafe_op, may_panic])
    fn write_cb(ctx: *mut opaque, data: &[u8]) -> usize!IoError {
        let sink_ptr = ctx as *mut FailingTestSink;
        if sink_ptr.is_null() {
            return .Ok(0_usize);
        }
        let sink: &mut FailingTestSink = unsafe {
            &mut sink_ptr.*
        };
        if sink.fail_all {
            return .Err(IoError.from_kind(.StorageFull, op: .Write));
        }
        let rem: usize = 64_usize -| sink.len;
        let take_n: usize = if data.len() < rem => data.len() else rem;
        if take_n > 0_usize {
            unsafe {
                @memcpy(
                    (&raw mut sink.buf[0]).add(sink.len) as *mut opaque,
                    data.as_ptr() as *opaque,
                    take_n,
                );
            }
            sink.len = sink.len +% take_n;
        }
        .Ok(take_n)
    }

    /| `WriterVTable.flush` callback for `FailingTestSink`.
    @std_cap_boundary(clears: [unsafe_op])
    fn flush_cb(ctx: *mut opaque) -> unit!IoError {
        let sink_ptr = ctx as *mut FailingTestSink;
        if sink_ptr.is_null() {
            return .Ok(());
        }
        let sink: &mut FailingTestSink = unsafe {
            &mut sink_ptr.*
        };
        sink.flushes = sink.flushes +% 1_usize;
        if sink.fail_all {
            return .Err(IoError.from_kind(.StorageFull, op: .Flush));
        }
        .Ok(())
    }
}

/| Full 8-word C-ABI reactor table layout used by `context.reactor` standard-stream unit tests.
@repr(C)
struct MockStdioReactorVTable {
    /| Slots `0..2`: Unused clock and RNG callbacks (`[0; 3]`).
    head_slots: [usize; 3],
    /| Slot `3`: `submit_io` callback.
    submit_io: ReactorSubmitFn?,
    /| Slots `4..7`: Unused async proactor callbacks (`[0; 4]`).
    tail_slots: [usize; 4],
}

/| Mock `--sim` stdio state capturing `stdout`/`stderr` and feeding `stdin` via `ReactorVTable.submit_io`.
struct MockSimStdio {
    /| Fixtures fed to `stdin` (`fd = 0`).
    stdin_src: [u8; 32],
    /| Length of `stdin_src`.
    stdin_len: usize,
    /| Current read cursor in `stdin_src`.
    stdin_pos: usize,
    /| Captured `stdout` (`fd = 1`) bytes.
    stdout_cap: [u8; 64],
    /| Captured `stdout` byte count.
    stdout_len: usize,
    /| Captured `stderr` (`fd = 2`) bytes.
    stderr_cap: [u8; 64],
    /| Captured `stderr` byte count.
    stderr_len: usize,
}

/| C-ABI `ReactorVTable.submit_io` handler intercepting `SIM_OP_STDIO_RW` in unit tests.
@std_cap_boundary(clears: [unsafe_op])
extern "C" fn mock_sim_submit_io(ctx: *mut opaque, sub_ptr: *IoSubmission) -> i64 {
    if ctx.is_null() {
        return SIM_UNHANDLED_SENTINEL;
    }
    if sub_ptr.is_null() {
        return SIM_UNHANDLED_SENTINEL;
    }
    let sub: IoSubmission = unsafe {
        sub_ptr.*
    };
    let kind_code: u8 = sub.kind;
    let rw_flags: u8 = sub.flags;
    let fd_num: i32 = sub.fd_or_handle;
    let buf_ptr: *mut u8 = sub.buf_ptr;
    let req_len = sub.buf_len as usize;
    if kind_code != SIM_OP_STDIO_RW {
        return SIM_UNHANDLED_SENTINEL;
    }
    let state_ptr = ctx as *mut MockSimStdio;
    if state_ptr.is_null() {
        return SIM_UNHANDLED_SENTINEL;
    }
    let state: &mut MockSimStdio = unsafe {
        &mut state_ptr.*
    };
    if rw_flags == 0_u8 and fd_num == 0 {
        let avail: usize = state.stdin_len -| state.stdin_pos;
        let copy_n: usize = if req_len < avail => req_len else avail;
        if copy_n > 0_usize and not buf_ptr.is_null() {
            unsafe {
                @memcpy(
                    buf_ptr as *mut opaque,
                    (&raw state.stdin_src[0]).add(state.stdin_pos) as *opaque,
                    copy_n,
                );
            }
            state.stdin_pos = state.stdin_pos +% copy_n;
        }
        return copy_n as i64;
    }
    if rw_flags == 1_u8 and (fd_num == 1 or fd_num == 2) {
        if fd_num == 1 {
            let avail_out: usize = 64_usize -| state.stdout_len;
            let copy_out: usize = if req_len < avail_out => req_len else avail_out;
            if copy_out > 0_usize and not buf_ptr.is_null() {
                unsafe {
                    @memcpy(
                        (&raw mut state.stdout_cap[0]).add(state.stdout_len) as *mut opaque,
                        buf_ptr as *opaque,
                        copy_out,
                    );
                }
                state.stdout_len = state.stdout_len +% copy_out;
            }
        } else {
            let avail_err: usize = 64_usize -| state.stderr_len;
            let copy_err: usize = if req_len < avail_err => req_len else avail_err;
            if copy_err > 0_usize and not buf_ptr.is_null() {
                unsafe {
                    @memcpy(
                        (&raw mut state.stderr_cap[0]).add(state.stderr_len) as *mut opaque,
                        buf_ptr as *opaque,
                        copy_err,
                    );
                }
                state.stderr_len = state.stderr_len +% copy_err;
            }
        }
        return req_len as i64;
    }
    SIM_UNHANDLED_SENTINEL
}

test "IoError layout, niche size, and OS error mappers" {
    assert(@size_of[IoErrorKind?]() == 1_usize);
    assert(@size_of[IoOp?]() == 1_usize);
    assert(@size_of[IoError]() == 8_usize);
    assert(@size_of[IoError?]() == 8_usize);
    assert(@size_of[IoErrorBits]() == 8_usize);

    let generic_err = IoError.from_kind(.InvalidScriptExtension, op: .Spawn);
    assert((generic_err.packed_repr as u64 & 1_u64) == 0_u64);
    assert(generic_err.kind() == .InvalidScriptExtension);
    assert(generic_err.op() == .Spawn);
    assert(generic_err.domain() == .Generic);
    assert(generic_err.os_error() == .None);
    assert(not generic_err.is_interrupted());

    let win_err = IoError.from_raw_os(32, domain: .Win32Error, op: .Rename);
    assert(win_err.kind() == .ResourceBusy);
    assert(win_err.op() == .Rename);
    assert(win_err.domain() == .Win32Error);
    assert(win_err.os_error() == .Some(32));

    let nt_err = IoError.from_raw_os(@bit_cast[i32](0xC000_04B3_u32), domain: .NtStatus, op: .Open);
    assert(nt_err.kind() == .FilesystemLoop);

    let wasi_err = IoError.from_raw_os(76, domain: .WasiErrno, op: .Resolve);
    assert(wasi_err.kind() == .PermissionDenied);

    let intr_err = IoError.from_raw_os(4, domain: .PosixErrno, op: .Read);
    assert(intr_err.is_interrupted());

    // Target-OS-independent `.SimFault` codes (`11 == WouldBlock`, `35 == FileLockConflict` even on macOS):
    assert(IoError.from_raw_os(11, domain: .SimFault, op: .Read).kind() == .WouldBlock);
    assert(IoError.from_raw_os(35, domain: .SimFault, op: .Lock).kind() == .FileLockConflict);
    assert(IoError.from_raw_os(5, domain: .SimFault, op: .Read).kind() == .Other);
    assert(IoError.from_raw_os(40, domain: .SimFault, op: .Open).kind() == .FilesystemLoop);
    assert(IoError.from_raw_os(110, domain: .SimFault, op: .Read).kind() == .TimedOut);

    let formatted = String.fmt(f"{win_err}");
    assert(formatted.as_str() == "resource busy (os error 32)");
}

test "OutBuf, IoSlice, and IoSliceMut zero-memset and advance invariants" {
    var raw_backing: [u8; 16];
    var out = OutBuf.over_uninit(&out raw_backing);
    assert(out.capacity() == 16_usize);
    assert(out.is_empty());
    assert(not out.is_full());
    assert(out.append(b"corex") == 5_usize);
    assert(out.append(b"-io-stream-overflow") == 11_usize);
    assert(out.is_full());
    assert(out.filled() == "corex-io-stream-".as_bytes());
    out.clear();
    assert(out.is_empty());

    var slices_arr: [IoSlice; 3] = [
        IoSlice.new(b"ab"),
        IoSlice.new(EMPTY_BYTES),
        IoSlice.new(b"cdef"),
    ];
    var slices_view: &mut [IoSlice] = &mut slices_arr;
    IoSlice.advance_slices(&mut slices_view, 4_usize);
    assert(slices_view.len() == 1_usize);
    if slices_view.get(0) is .Some(first_slice) {
        assert(first_slice.as_slice() == "ef".as_bytes());
    }

    var mut_a: [u8; 3] = [b'1', b'2', b'3'];
    var mut_b: [u8; 4] = [b'4', b'5', b'6', b'7'];
    var mut_arr: [IoSliceMut; 2] = [IoSliceMut.new(&mut mut_a), IoSliceMut.new(&mut mut_b)];
    var mut_view: &mut [IoSliceMut] = &mut mut_arr;
    IoSliceMut.advance_mut_slices(&mut mut_view, 5_usize);
    assert(mut_view.len() == 1_usize);
    if mut_view.get(0) is .Some(first_mut) {
        assert(first_mut.as_slice() == "67".as_bytes());
    }
}

test "BufReader peek, consume, SIMD/SWAR read_until, and CRLF next_line" {
    if @size_of[usize]() == 8_usize {
        assert(@size_of[BufReader]() == 48_usize);
        assert(@size_of[BufWriter]() == 32_usize);
        assert(@size_of[Reader]() == 16_usize);
        assert(@size_of[Reader?]() == 16_usize);
        assert(@size_of[Writer]() == 16_usize);
        assert(@size_of[Seek]() == 16_usize);
    }

    var cursor = ByteReader.new(b"alpha\r\nbeta\ngamma-tail");
    var raw_buf: [u8; 8];
    var br = BufReader.over_uninit(cursor.as_reader(), &out raw_buf);

    let peeked: &[u8] = br.peek(5_usize) catch unreachable;
    if peeked.len() >= 5_usize {
        assert(peeked[0..5] == "alpha".as_bytes());
    }

    let line1: str? = br.next_line() catch unreachable;
    assert(line1 == .Some("alpha"));

    let line2: str? = br.next_line() catch unreachable;
    assert(line2 == .Some("beta"));

    // `"gamma-tail"` is 10 bytes > 8-byte buffer -> `read_until` returns `StreamTooLong`,
    // whereas `read_until_into` streams across multiple refills cleanly!
    if br.read_until(b'\n') is .Err(err) {
        assert(err.kind() == .StreamTooLong);
    } else {
        assert(false);
    }

    var cursor2 = ByteReader.new(b"long-line-across-refills\ndone");
    var br_sys = BufReader.with_capacity(cursor2.as_reader(), 6_usize);
    var line_vec = Vec[u8].new();
    let n_into: usize = br_sys.read_until_into(b'\n', &mut line_vec) catch unreachable;
    assert(n_into == 25_usize);
    assert(line_vec.as_slice() == "long-line-across-refills\n".as_bytes());
    let final_line: str? = br_sys.next_line() catch unreachable;
    assert(final_line == .Some("done"));
    let eof_line: str? = br_sys.next_line() catch unreachable;
    assert(eof_line == .None);
}

test "BufWriter vectored coalescing, FmtArgs print, and close on flush error" {
    var dst_bytes: [u8; 64] = [0_u8; 64];
    var sw = SliceWriter.new(&mut dst_bytes);
    var bw = BufWriter.new(sw.as_writer());
    let parts: [IoSlice; 3] = [
        IoSlice.new(b"item="),
        IoSlice.new(b"42"),
        IoSlice.new(b"; "),
    ];
    let vec_n: usize = bw.write_vectored(&parts) catch unreachable;
    assert(vec_n == 9_usize);
    bw.print(f"ok={true}") catch unreachable;
    assert(sw.position() == 0_u64);
    bw.close() catch unreachable;
    assert(sw.written() == "item=42; ok=true".as_bytes());

    // Verify `BufWriter.close` frees `System` buffer and propagates `.Err` when downstream flush fails:
    var fail_sink = FailingTestSink {
        buf: [0_u8; 64],
        len: 0_usize,
        flushes: 0_usize,
        fail_all: true,
    };
    let fail_vtable = WriterVTable {
        write: FailingTestSink.write_cb,
        write_vectored: .None,
        flush: .Some(FailingTestSink.flush_cb),
    };
    let fail_writer = unsafe {
        Writer.from_raw((&raw mut fail_sink) as *mut opaque, &raw fail_vtable)
    };
    var bw_fail = BufWriter.with_capacity(fail_writer, 32_usize);
    bw_fail.write_all(b"buffered") catch unreachable;
    if bw_fail.close() is .Err(err) {
        assert(err.kind() == .StorageFull);
    } else {
        assert(false);
    }
}

test "BufWriter write_all_vectored after pre-buffering hello over SliceWriter" {
    // [1] Direct `SliceWriter` with an `8 B` `BufWriter` overflowing spare capacity after `"hello"`:
    var direct_storage: [u8; 32] = [0_u8; 32];
    var direct_sw = SliceWriter.new(&mut direct_storage);
    var raw_backing1: [u8; 8];
    var bw_direct = BufWriter.over_uninit(direct_sw.as_writer(), &out raw_backing1);
    bw_direct.write_all(b"hello") catch unreachable;
    let tail_slices1: [IoSlice; 2] = [IoSlice.new(b" "), IoSlice.new(b"world!")];
    bw_direct.write_all_vectored(&tail_slices1) catch unreachable;
    bw_direct.close() catch unreachable;
    assert(direct_sw.written() == "hello world!".as_bytes());

    // [2] Single-slice `WriterVTable` (`write_vectored: .None`) forcing `written == buf_len` (`<= cap` & `> cap`):
    let single_slice_vtable = WriterVTable {
        write: slice_writer_write_cb,
        write_vectored: .None,
        flush: .None,
    };
    var small_storage: [u8; 32] = [0_u8; 32];
    var small_sw = SliceWriter.new(&mut small_storage);
    let small_writer = unsafe {
        Writer.from_raw((&raw mut small_sw) as *mut opaque, &raw single_slice_vtable)
    };
    var raw_backing2: [u8; 8];
    var bw_small = BufWriter.over_uninit(small_writer, &out raw_backing2);
    bw_small.write_all(b"hello") catch unreachable;
    let tail_slices2: [IoSlice; 2] = [IoSlice.new(b" "), IoSlice.new(b"ok")];
    bw_small.write_all_vectored(&tail_slices2) catch unreachable;
    bw_small.close() catch unreachable;
    assert(small_sw.written() == "hello ok".as_bytes());

    var large_storage: [u8; 32] = [0_u8; 32];
    var large_sw = SliceWriter.new(&mut large_storage);
    let large_writer = unsafe {
        Writer.from_raw((&raw mut large_sw) as *mut opaque, &raw single_slice_vtable)
    };
    var raw_backing3: [u8; 8];
    var bw_large = BufWriter.over_uninit(large_writer, &out raw_backing3);
    bw_large.write_all(b"hello") catch unreachable;
    let tail_slices3: [IoSlice; 2] = [IoSlice.new(b" "), IoSlice.new(b"oversized-tail")];
    bw_large.write_all_vectored(&tail_slices3) catch unreachable;
    bw_large.close() catch unreachable;
    assert(large_sw.written() == "hello oversized-tail".as_bytes());
}

test "LimitReader, ByteReader/SliceWriter seek, repeat, and copy_stream" {
    let rep = Reader.repeat(b'Z');
    var lim = LimitReader.new(rep, 12_u64);
    var lim_reader: Reader = lim.as_reader();
    var dst_storage: [u8; 32] = [0_u8; 32];
    var sw = SliceWriter.new(&mut dst_storage);
    var sw_writer: Writer = sw.as_writer();

    let copied: u64 = copy_stream(&mut lim_reader, &mut sw_writer, max_bytes: 12_u64)
        catch unreachable;
    assert(copied == 12_u64);
    assert(sw.written() == "ZZZZZZZZZZZZ".as_bytes());

    var seeker: Seek = sw.as_seeker();
    seeker.rewind() catch unreachable;
    sw_writer.print("ABCD") catch unreachable;
    let end_pos: u64 = seeker.seek(.End(-2_i64)) catch unreachable;
    assert(end_pos == 30_u64);
    let written_view: &[u8] = sw.written();
    if written_view.len() >= 12_usize {
        assert(written_view[0..12] == "ABCDZZZZZZZZ".as_bytes());
    }
}

test "Reactor-routed stdin_locked, stdout_locked, stderr_locked, println, and eprintln" {
    var sim_state = MockSimStdio {
        stdin_src: [0_u8; 32],
        stdin_len: 11_usize,
        stdin_pos: 0_usize,
        stdout_cap: [0_u8; 64],
        stdout_len: 0_usize,
        stderr_cap: [0_u8; 64],
        stderr_len: 0_usize,
    };
    let fixture = b"line1\nline2";
    var idx = 0_usize;
    while idx < fixture.len() and idx < sim_state.stdin_src.len() {
        sim_state.stdin_src[idx] = fixture[idx];
        idx += 1_usize;
    }

    let vtable = MockStdioReactorVTable {
        head_slots: [0_usize; 3],
        submit_io: .Some(mock_sim_submit_io),
        tail_slots: [0_usize; 4],
    };

    with context.reactor = &raw vtable {
        with context.reactor_ctx = (&raw mut sim_state) as *mut opaque {
            var in_guard1: StdinLock = stdin_locked();
            let first_line: str? = in_guard1.reader().next_line() catch unreachable;
            assert(first_line == .Some("line1"));
            in_guard1.release();

            // Unread lookahead `"line2"` in `StdioSlab` is preserved across `StdinLock` scopes:
            var in_guard2: StdinLock = stdin_locked();
            let second_line: str? = in_guard2.reader().next_line() catch unreachable;
            assert(second_line == .Some("line2"));
            in_guard2.release();

            println(f"count={2 + 3}");
            eprintln(f"warn={7}");
        }
    }

    let out_len: usize = sim_state.stdout_len;
    let out_cap_ref: &[u8] = &sim_state.stdout_cap;
    if out_len <= out_cap_ref.len() {
        assert(out_cap_ref[0..out_len] == "count=5\n".as_bytes());
    }
    let err_len: usize = sim_state.stderr_len;
    let err_cap_ref: &[u8] = &sim_state.stderr_cap;
    if err_len <= err_cap_ref.len() {
        assert(err_cap_ref[0..err_len] == "warn=7\n".as_bytes());
    }
}
