/| Returns `.None` for `data_local_dir` on freestanding targets.
@cfg(target.os == "freestanding")
fn host_data_local_dir() -> OptPathBuf = .None;

/| Resolves `temp_dir` on Linux and macOS (`$TMPDIR` when non-empty and absolute, else `"/tmp"`).
@cfg(target.os == "linux" or target.os == "macos")
fn host_temp_dir() -> PathBuf {
    if filter_absolute_dir(host_var_os("TMPDIR")) is .Some(tmp_pb) {
        return tmp_pb;
    }
    PathBuf.from("/tmp")
}

/| Invokes dynamically resolved `GetTempPath2W` (when available) or falls back to `GetTempPathW`.
@std_cap_boundary(clears: [ffi, unsafe_op, indirect_opaque, blocking_sync])
fn invoke_win32_temp_path(cap_wchars: u32, buf_out: *mut u16, /) -> u32 {
    let kernel32_mod: *mut opaque = unsafe {
        sys.windows.win32_get_module_handle_w((&WIN32_KERNEL32_DLL_W).as_ptr())
    };
    if not kernel32_mod.is_null() {
        let proc_raw: *mut opaque = unsafe {
            sys.windows.win32_get_proc_address(kernel32_mod, WIN32_GET_TEMP_PATH2_Z.as_ptr())
        };
        if not proc_raw.is_null() and (proc_raw as usize) >= WIN32_REAL_PROC_MIN_ADDR {
            let temp_path_2: Win32GetTempPathFn = unsafe {
                @ptr_read(&raw proc_raw as *Win32GetTempPathFn)
            };
            return unsafe {
                temp_path_2(cap_wchars, buf_out)
            };
        }
    }
    unsafe {
        sys.windows.win32_get_temp_path_w(cap_wchars, buf_out)
    }
}

/| Resolves `temp_dir` on Windows via dynamic `GetTempPath2W` with `GetTempPathW` fallback.
@cfg(target.os == "windows")
fn host_temp_dir() -> PathBuf {
    var stack_w: [u16; STACK_WCHAR_CAP] = [0_u16; STACK_WCHAR_CAP];
    let first_len: u32 = invoke_win32_temp_path(STACK_WCHAR_CAP as u32, &raw mut stack_w[0]);
    if first_len > 0_u32 and (first_len as usize) < STACK_WCHAR_CAP {
        return decode_wtf16_to_path_buf(subslice_u16(&stack_w, 0_usize, first_len as usize));
    }
    if (first_len as usize) >= STACK_WCHAR_CAP and (first_len as usize) <= MAX_PATH_GROW_UNITS {
        let dyn_cap = first_len as usize;
        var heap_w = Vec[u16].with_capacity(dyn_cap);
        var i: usize = 0;
        while i < dyn_cap {
            heap_w.push(0_u16);
            i = i +% 1_usize;
        }
        let got_len: u32 = invoke_win32_temp_path(
            dyn_cap as u32,
            heap_w.as_mut_slice().as_mut_ptr(),
        );
        if got_len > 0_u32 and (got_len as usize) < dyn_cap {
            return decode_wtf16_to_path_buf(
                subslice_u16(heap_w.as_slice(), 0_usize, got_len as usize),
            );
        }
    }
    PathBuf.from("C:\\Temp")
}

/| Returns `"/tmp"` for `temp_dir` on WASI and freestanding targets.
@cfg(target.os == "wasi" or target.os == "freestanding")
fn host_temp_dir() -> PathBuf = PathBuf.from("/tmp");

/| Queries `getpid()` on Linux.
@cfg(target.os == "linux")
@std_cap_boundary(clears: [ffi, unsafe_op, alloc, may_panic, blocking_sync])
fn host_process_id() -> u32 {
    let raw_pid: i32 = unsafe {
        sys.linux.linux_getpid()
    };
    if raw_pid > 0 => raw_pid as u32 else 1_u32
}

/| Queries `getpid()` on macOS.
@cfg(target.os == "macos")
@std_cap_boundary(clears: [ffi, unsafe_op, alloc, may_panic, blocking_sync])
fn host_process_id() -> u32 {
    let raw_pid: i32 = unsafe {
        sys.macos.darwin_getpid()
    };
    if raw_pid > 0 => raw_pid as u32 else 1_u32
}

/| Queries `GetCurrentProcessId()` on Windows.
@cfg(target.os == "windows")
@std_cap_boundary(clears: [ffi, unsafe_op, alloc, may_panic, blocking_sync])
fn host_process_id() -> u32 {
    unsafe {
        sys.windows.win32_get_current_process_id()
    }
