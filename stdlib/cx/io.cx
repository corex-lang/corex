@cfg(target.os == "macos") @std_cap_boundary(clears: [ffi, unsafe_op])
fn is_host_stdout_tty() -> bool {
    unsafe {
        sys.macos.darwin_isatty(sys.macos.STDOUT_FILENO) != 0
    }
}

/| macOS Darwin host `read(STDIN_FILENO, dst_ptr, cap)` wrapper.
@cfg(target.os == "macos") @std_cap_boundary(clears: [ffi, unsafe_op])
fn host_stdin_read(dst_ptr: *mut u8, cap: usize, /) -> usize!IoError {
    let rc: isize = unsafe {
