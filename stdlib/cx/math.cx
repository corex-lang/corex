const LN_POLY_LG7: f64 = 0.14798198605116586;

// -------------------------------------- INTERNALS --------------------------------------
// ------------ Double-Double Error-Free Primitives -------------
/| Knuth error-free addition `x + y = (sum_hi, sum_lo)`.
fn two_sum_f64(x: f64, y: f64, /) -> (f64, f64) {
    let sum_hi: f64 = x + y;
    let virt_y: f64 = sum_hi - x;
    let sum_lo: f64 = (x - (sum_hi - virt_y)) + (y - virt_y);
    (sum_hi, sum_lo)
}

/| Veltkamp 27-bit split error-free multiplication `x * y = (prod_hi, prod_lo)` on scaled finite inputs.
fn two_prod_f64(x: f64, y: f64, /) -> (f64, f64) {
    let cx_val: f64 = VELTKAMP_SPLIT * x;
    let x_hi: f64 = cx_val - (cx_val - x);
    let x_lo: f64 = x - x_hi;
    let cy_val: f64 = VELTKAMP_SPLIT * y;
    let y_hi: f64 = cy_val - (cy_val - y);
    let y_lo: f64 = y - y_hi;
    let prod_hi: f64 = x * y;
    let prod_lo: f64 = ((x_hi * y_hi - prod_hi) + x_hi * y_lo + x_lo * y_hi) + x_lo * y_lo;
    (prod_hi, prod_lo)
}

/| Double-double division `(num_hi + num_lo) / (den_hi + den_lo)` accurate to `~105` bits.
fn dd_div_f64(num_hi: f64, num_lo: f64, den_hi: f64, den_lo: f64, /) -> (f64, f64) {
    let quo_hi: f64 = num_hi / den_hi;
    let (prod_hi, prod_lo) = two_prod_f64(quo_hi, den_hi);
    let rem: f64 = ((num_hi - prod_hi) - prod_lo) + (num_lo - quo_hi * den_lo);
    let quo_lo: f64 = rem / (den_hi + den_lo);
    two_sum_f64(quo_hi, quo_lo)
}

/| Double-double principal square root `sqrt(val_hi + val_lo)` accurate to `~105` bits.
fn dd_sqrt_f64(val_hi: f64, val_lo: f64, /) -> (f64, f64) {
    if val_hi <= 0.0 {
        return (0.0, 0.0);
    }
    let root: f64 = sqrt_f64(val_hi);
    let (prod_hi, prod_lo) = two_prod_f64(root, root);
    let rem: f64 = ((val_hi - prod_hi) - prod_lo) + val_lo;
    let root_lo: f64 = rem / (2.0 * root);
    two_sum_f64(root, root_lo)
}

/| Boldo–Melquiond round-to-odd sticky adjustment of `hi` given exact remainder `lo`.
fn round_to_odd_f64(hi: f64, lo: f64, /) -> f64 {
    if lo == 0.0 {
        return hi;
    }
    let bits: u64 = @bit_cast[u64](hi);
    if (bits & 1_u64) == 1_u64 {
        return hi;
    }
    if hi == 0.0 {
        return if lo > 0.0 => @bit_cast[f64](1_u64) else @bit_cast[f64](0x8000_0000_0000_0001_u64);
    }
    let same_sign: bool = (hi > 0.0) == (lo > 0.0);
    let next_bits: u64 = if same_sign => bits +% 1_u64 else bits -% 1_u64;
    @bit_cast[f64](next_bits)
}

/| Exact single-rounded scaling `(u_hi + v_hi + v_lo) * 2^scale_exp` across normal and subnormal `f64` ranges.
fn scale_triple_to_f64(u_hi: f64, v_hi: f64, v_lo: f64, scale_exp: i32, /) -> f64 {
    let v_odd: f64 = round_to_odd_f64(v_hi, v_lo);
    let (comb_hi, comb_lo) = two_sum_f64(u_hi, v_odd);
    if comb_hi == 0.0 {
        return 0.0;
    }
    let (_, cur_exp) = frexp_f64(comb_hi);
    let target_exp: i32 = cur_exp -% 1 +% scale_exp;
    if target_exp >= 1024 {
        return copysign_f64(@bit_cast[f64](0x7FF0_0000_0000_0000_u64), comb_hi);
    }
    if target_exp < -1075 {
        return copysign_f64(0.0, comb_hi);
    }
    let abs_comb: f64 = abs_f64(comb_hi);
    let stays_normal: bool = target_exp > -1022 or (
        target_exp == -1022 and (
            abs_comb > 0.5 or (
                abs_comb == 0.5 and (comb_lo == 0.0 or (comb_lo > 0.0) == (comb_hi > 0.0))
            )
        )
    );
    if stays_normal {
        if target_exp == 1023 {
            return ldexp_f64(u_hi + v_odd, scale_exp -% 1) * 2.0;
        }
        return ldexp_f64(u_hi + v_odd, scale_exp);
    }

    let sub_hi: f64 = ldexp_f64(comb_hi, scale_exp +% 1074);
    let int_part: f64 = trunc_f64(sub_hi);
    let frac_hi: f64 = sub_hi - int_part;
    let mag_int: f64 = abs_f64(int_part);
    let mag_frac: f64 = abs_f64(frac_hi);
    let same_dir: i32 = if comb_lo == 0.0 => 0
        else if (comb_lo > 0.0) == (comb_hi > 0.0) => 1
        else -1;
    let round_up: bool = if mag_frac == 0.0 and same_dir < 0 and mag_int >= 1.0 {
        false
    } else if mag_frac > 0.5 {
        true
    } else if mag_frac < 0.5 {
        false
    } else if same_dir > 0 {
        true
    } else if same_dir < 0 {
        false
    } else {
        (trunc_f64(mag_int * 0.5) * 2.0) != mag_int
    };
    let final_mag: f64 = if round_up => mag_int + 1.0 else mag_int;
    copysign_f64(ldexp_f64(final_mag, -1074), comb_hi)
}

/| Converts an already-integral `f64` in `[-2_147_483_648.0, +2_147_483_647.0]` to `i32` via pure bit extraction (`@no_panic`).
@std_cap_boundary(clears: [may_panic]) @inline @no_alloc @no_panic
fn exact_f64_to_i32(int_val: f64, /) -> i32 {
    let bits: u64 = @bit_cast[u64](int_val);
    let biased_exp = ((bits >> 52_u64) & 0x7FF_u64) as i32;
    if biased_exp < 1023 {
        return 0;
    }
    let unbiased: i32 = biased_exp -% 1023;
    if unbiased >= 31 {
        return if (bits >> 63_u64) != 0_u64 => -2_147_483_648 else 2_147_483_647;
    }
    let sig53: u64 = (bits & ((1_u64 << 52_u64) - 1_u64)) | (1_u64 << 52_u64);
    let rshift: u64 = ((52 -% unbiased) as u32) as u64 & 63_u64;
    let mag = (sig53 >> rshift) as i32;
    if (bits >> 63_u64) != 0_u64 => 0 -% mag else mag
}

// ----------------- IEEE-754 f64 & f32 Kernels -----------------
/| Returns `true` iff `x` is `NaN` (`f64`).
fn is_nan_f64(x: f64, /) -> bool =
    (@bit_cast[u64](x) & 0x7FFF_FFFF_FFFF_FFFF_u64) > 0x7FF0_0000_0000_0000_u64;

/| Returns `true` iff `x` is `NaN` (`f32`).
fn is_nan_f32(x: f32, /) -> bool = (@bit_cast[u32](x) & 0x7FFF_FFFF_u32) > 0x7F80_0000_u32;

/| Returns `true` iff `x` is finite (`f64`).
fn is_finite_f64(x: f64, /) -> bool =
    (@bit_cast[u64](x) & 0x7FF0_0000_0000_0000_u64) != 0x7FF0_0000_0000_0000_u64;

/| Returns `true` iff `x` is finite (`f32`).
fn is_finite_f32(x: f32, /) -> bool = (@bit_cast[u32](x) & 0x7F80_0000_u32) != 0x7F80_0000_u32;

/| Returns `true` iff `x` is a non-zero subnormal (`f64`).
fn is_subnormal_f64(x: f64, /) -> bool {
    let abs_bits: u64 = @bit_cast[u64](x) & 0x7FFF_FFFF_FFFF_FFFF_u64;
    abs_bits != 0_u64 and (abs_bits >> 52_u64) == 0_u64
}

/| Returns `true` iff `x` is a non-zero subnormal (`f32`).
fn is_subnormal_f32(x: f32, /) -> bool {
    let abs_bits: u32 = @bit_cast[u32](x) & 0x7FFF_FFFF_u32;
    abs_bits != 0_u32 and (abs_bits >> 23_u32) == 0_u32
}

/| Clears the IEEE-754 sign bit of `x` (`abs_f64(-0.0) == +0.0`).
fn abs_f64(x: f64, /) -> f64 = @bit_cast[f64](@bit_cast[u64](x) & 0x7FFF_FFFF_FFFF_FFFF_u64);

/| Clears the IEEE-754 sign bit of `x` (`abs_f32(-0.0) == +0.0`).
fn abs_f32(x: f32, /) -> f32 = @bit_cast[f32](@bit_cast[u32](x) & 0x7FFF_FFFF_u32);

/| Copies the IEEE-754 sign bit of `sgn` onto `mag` (`f64`).
fn copysign_f64(mag: f64, sgn: f64, /) -> f64 {
    let mag_bits: u64 = @bit_cast[u64](mag) & 0x7FFF_FFFF_FFFF_FFFF_u64;
    let sgn_bit: u64 = @bit_cast[u64](sgn) & 0x8000_0000_0000_0000_u64;
    @bit_cast[f64](mag_bits | sgn_bit)
}

/| Copies the IEEE-754 sign bit of `sgn` onto `mag` (`f32`).
fn copysign_f32(mag: f32, sgn: f32, /) -> f32 {
    let mag_bits: u32 = @bit_cast[u32](mag) & 0x7FFF_FFFF_u32;
    let sgn_bit: u32 = @bit_cast[u32](sgn) & 0x8000_0000_u32;
    @bit_cast[f32](mag_bits | sgn_bit)
}

/| Least representable `f64` strictly greater than `x` (`next_up_f64(-0.0) == +MIN_SUBNORMAL`).
fn next_up_f64(x: f64, /) -> f64 {
    let pos_inf: f64 = @bit_cast[f64](0x7FF0_0000_0000_0000_u64);
    if is_nan_f64(x) or x == pos_inf {
        return x;
    }
    if x == 0.0 {
        return @bit_cast[f64](1_u64);
    }
    let bits: u64 = @bit_cast[u64](x);
    let next_bits: u64 = if x > 0.0 => bits +% 1_u64 else bits -% 1_u64;
    @bit_cast[f64](next_bits)
}

/| Least representable `f32` strictly greater than `x` (`next_up_f32(-0.0_f32) == +MIN_SUBNORMAL`).
fn next_up_f32(x: f32, /) -> f32 {
    let pos_inf: f32 = @bit_cast[f32](0x7F80_0000_u32);
    if is_nan_f32(x) or x == pos_inf {
        return x;
    }
    if x == 0.0_f32 {
        return @bit_cast[f32](1_u32);
    }
    let bits: u32 = @bit_cast[u32](x);
    let next_bits: u32 = if x > 0.0_f32 => bits +% 1_u32 else bits -% 1_u32;
    @bit_cast[f32](next_bits)
}

/| Greatest representable `f64` strictly less than `x` (`next_down_f64(+0.0) == -MIN_SUBNORMAL`).
fn next_down_f64(x: f64, /) -> f64 = -next_up_f64(-x);

/| Greatest representable `f32` strictly less than `x` (`next_down_f32(+0.0_f32) == -MIN_SUBNORMAL`).
fn next_down_f32(x: f32, /) -> f32 = -next_up_f32(-x);

/| Returns `1` unit in the last place at `x`'s `f64` binade (`NaN` for `NaN` or `+-Inf`).
@std_cap_boundary(clears: [may_panic]) @inline @no_alloc @no_panic
fn ulp_f64(x: f64, /) -> f64 {
    let abs_bits: u64 = @bit_cast[u64](x) & 0x7FFF_FFFF_FFFF_FFFF_u64;
    let biased_exp: u64 = abs_bits >> 52_u64;
    if biased_exp == 0x7FF_u64 {
        return @bit_cast[f64](0x7FF8_0000_0000_0000_u64);
    }
    if biased_exp <= 52_u64 {
        return @bit_cast[f64](1_u64);
    }
    @bit_cast[f64]((biased_exp -% 52_u64) << 52_u64)
}

/| Returns `1` unit in the last place at `x`'s `f32` binade (`NaN` for `NaN` or `+-Inf`).
@std_cap_boundary(clears: [may_panic]) @inline @no_alloc @no_panic
fn ulp_f32(x: f32, /) -> f32 {
    let abs_bits: u32 = @bit_cast[u32](x) & 0x7FFF_FFFF_u32;
    let biased_exp: u32 = abs_bits >> 23_u32;
    if biased_exp == 0xFF_u32 {
        return @bit_cast[f32](0x7FC0_0000_u32);
    }
    if biased_exp <= 23_u32 {
        return @bit_cast[f32](1_u32);
    }
    @bit_cast[f32]((biased_exp -% 23_u32) << 23_u32)
}

/| Branchless IEEE-754 `totalOrder` on `f64` (`-NaN < -Inf < -0.0 < +0.0 < +Inf < +NaN`).
fn total_cmp_f64(lhs: f64, rhs: f64, /) -> Ordering {
    let lhs_bits: u64 = @bit_cast[u64](lhs);
    let rhs_bits: u64 = @bit_cast[u64](rhs);
    let lhs_mask: u64 = if (lhs_bits >> 63_u64) != 0_u64 => 0x7FFF_FFFF_FFFF_FFFF_u64 else 0_u64;
    let rhs_mask: u64 = if (rhs_bits >> 63_u64) != 0_u64 => 0x7FFF_FFFF_FFFF_FFFF_u64 else 0_u64;
    let lhs_key: i64 = @bit_cast[i64](lhs_bits ^ lhs_mask);
    let rhs_key: i64 = @bit_cast[i64](rhs_bits ^ rhs_mask);
    if lhs_key < rhs_key {
        return .Less;
    } else if lhs_key > rhs_key {
        return .Greater;
    }
    .Equal
}

/| Branchless IEEE-754 `totalOrder` on `f32` (`-NaN < -Inf < -0.0 < +0.0 < +Inf < +NaN`).
fn total_cmp_f32(lhs: f32, rhs: f32, /) -> Ordering {
    let lhs_bits: u32 = @bit_cast[u32](lhs);
    let rhs_bits: u32 = @bit_cast[u32](rhs);
    let lhs_mask: u32 = if (lhs_bits >> 31_u32) != 0_u32 => 0x7FFF_FFFF_u32 else 0_u32;
    let rhs_mask: u32 = if (rhs_bits >> 31_u32) != 0_u32 => 0x7FFF_FFFF_u32 else 0_u32;
    let lhs_key: i32 = @bit_cast[i32](lhs_bits ^ lhs_mask);
    let rhs_key: i32 = @bit_cast[i32](rhs_bits ^ rhs_mask);
    if lhs_key < rhs_key {
        return .Less;
    } else if lhs_key > rhs_key {
        return .Greater;
    }
    .Equal
}

/| Rounds `f64` toward `0.0` preserving `-0.0` (`trunc_f64(-0.9) == -0.0`, `0.0000 ULP`).
@std_cap_boundary(clears: [may_panic]) @inline @no_alloc @no_panic
fn trunc_f64(x: f64, /) -> f64 {
    let bits: u64 = @bit_cast[u64](x);
    let unbiased_exp: i32 = (((bits >> 52_u64) & 0x7FF_u64) as i32) -% 1023;
    if unbiased_exp < 0 {
        return @bit_cast[f64](bits & 0x8000_0000_0000_0000_u64);
    }
    if unbiased_exp >= 52 {
        return x;
    }
    let shift_cnt: u64 = ((52 -% unbiased_exp) as u32) as u64 & 63_u64;
    let frac_mask: u64 = (1_u64 << shift_cnt) -% 1_u64;
    @bit_cast[f64](bits & ~frac_mask)
}

/| Rounds `f32` toward `0.0` preserving `-0.0` (`0.0000 ULP`).
@std_cap_boundary(clears: [may_panic]) @inline @no_alloc @no_panic
fn trunc_f32(x: f32, /) -> f32 {
    let bits: u32 = @bit_cast[u32](x);
    let unbiased_exp: i32 = (((bits >> 23_u32) & 0xFF_u32) as i32) -% 127;
    if unbiased_exp < 0 {
        return @bit_cast[f32](bits & 0x8000_0000_u32);
    }
    if unbiased_exp >= 23 {
        return x;
    }
    let shift_cnt: u32 = ((23 -% unbiased_exp) as u32) & 31_u32;
    let frac_mask: u32 = (1_u32 << shift_cnt) -% 1_u32;
    @bit_cast[f32](bits & ~frac_mask)
}

/| Rounds `f64` toward `-Infinity` preserving `-0.0` (`0.0000 ULP`).
fn floor_f64(x: f64, /) -> f64 {
    if is_nan_f64(x) {
        return x;
    }
    let tr: f64 = trunc_f64(x);
    if x < tr => tr - 1.0 else tr
}

/| Rounds `f32` toward `-Infinity` preserving `-0.0` (`0.0000 ULP`).
fn floor_f32(x: f32, /) -> f32 {
    if is_nan_f32(x) {
        return x;
    }
    let tr: f32 = trunc_f32(x);
    if x < tr => tr - 1.0_f32 else tr
}

/| Rounds `f64` toward `+Infinity` preserving `-0.0` (`ceil_f64(-0.5) == -0.0`, `0.0000 ULP`).
fn ceil_f64(x: f64, /) -> f64 {
    if is_nan_f64(x) {
        return x;
    }
    let tr: f64 = trunc_f64(x);
    if x > tr {
        let next_int: f64 = tr + 1.0;
        return if next_int == 0.0 => copysign_f64(next_int, x) else next_int;
    }
    tr
}

/| Rounds `f32` toward `+Infinity` preserving `-0.0` (`0.0000 ULP`).
fn ceil_f32(x: f32, /) -> f32 {
    if is_nan_f32(x) {
        return x;
    }
    let tr: f32 = trunc_f32(x);
    if x > tr {
        let next_int: f32 = tr + 1.0_f32;
        return if next_int == 0.0_f32 => copysign_f32(next_int, x) else next_int;
    }
    tr
}

/| IEEE-754 `f64` `roundToIntegralTiesToEven` preserving `-0.0` (`round_ties_even_f64(-0.5) == -0.0`).
fn round_ties_even_f64(x: f64, /) -> f64 {
    if is_nan_f64(x) {
        return x;
    }
    let abs_x: f64 = abs_f64(x);
    if abs_x >= TWO_POW_52 {
        return x;
    }
    copysign_f64((abs_x + TWO_POW_52) - TWO_POW_52, x)
}

/| IEEE-754 `f32` `roundToIntegralTiesToEven` preserving `-0.0` (`round_ties_even_f32(-0.5_f32) == -0.0_f32`).
fn round_ties_even_f32(x: f32, /) -> f32 {
    if is_nan_f32(x) {
        return x;
    }
    let abs_x: f32 = abs_f32(x);
    if abs_x >= TWO_POW_23 {
        return x;
    }
    copysign_f32((abs_x + TWO_POW_23) - TWO_POW_23, x)
}

/| Decomposes `f64` `x = frac * 2^exp` with `|frac| in [0.5, 1.0)`, normalizing subnormals.
fn frexp_f64(x: f64, /) -> (f64, i32) {
    let bits: u64 = @bit_cast[u64](x);
    let abs_bits: u64 = bits & 0x7FFF_FFFF_FFFF_FFFF_u64;
    if abs_bits == 0_u64 or abs_bits >= 0x7FF0_0000_0000_0000_u64 {
        return (x, 0);
    }
    var work_bits: u64 = bits;
    var exp_adj: i32 = 0;
    if (abs_bits >> 52_u64) == 0_u64 {
        work_bits = @bit_cast[u64](x * 18_014_398_509_481_984.0);
        exp_adj = -54;
    }
    let biased_exp = ((work_bits >> 52_u64) & 0x7FF_u64) as i32;
    let out_exp: i32 = biased_exp -% 1022 +% exp_adj;
    let frac_bits: u64 = (work_bits & 0x800F_FFFF_FFFF_FFFF_u64) | 0x3FE0_0000_0000_0000_u64;
    (@bit_cast[f64](frac_bits), out_exp)
}

/| Decomposes `f32` `x = frac * 2^exp` with `|frac| in [0.5, 1.0)`, normalizing subnormals.
fn frexp_f32(x: f32, /) -> (f32, i32) {
    let bits: u32 = @bit_cast[u32](x);
    let abs_bits: u32 = bits & 0x7FFF_FFFF_u32;
    if abs_bits == 0_u32 or abs_bits >= 0x7F80_0000_u32 {
        return (x, 0);
    }
    var work_bits: u32 = bits;
    var exp_adj: i32 = 0;
    if (abs_bits >> 23_u32) == 0_u32 {
        work_bits = @bit_cast[u32](x * 33_554_432.0_f32);
        exp_adj = -25;
    }
    let biased_exp = ((work_bits >> 23_u32) & 0xFF_u32) as i32;
    let out_exp: i32 = biased_exp -% 126 +% exp_adj;
    let frac_bits: u32 = (work_bits & 0x807F_FFFF_u32) | 0x3F00_0000_u32;
    (@bit_cast[f32](frac_bits), out_exp)
}

/| Scales `f64` `x * 2^exp2` safely across `i32.MIN..=i32.MAX` (`[-2100, 2100]` clamped, gradual underflow).
@std_cap_boundary(clears: [may_panic]) @no_alloc @no_panic
fn ldexp_f64(x: f64, exp2: i32, /) -> f64 {
    if x == 0.0 or is_nan_f64(x) or not is_finite_f64(x) {
        return x;
    }
    var rem_exp: i32 = if exp2 < -2100 => -2100
        else if exp2 > 2100 => 2100
        else exp2;
    var res: f64 = x;
    while rem_exp > 1023 {
        res *= SCALE_UP_1023;
        rem_exp = rem_exp -% 1023;
    }
    while rem_exp < -1022 {
        res *= SCALE_DN_1022;
        rem_exp = rem_exp +% 1022;
    }
    let biased_bits: u64 = (((rem_exp +% 1023) as u32) as u64 & 0x7FF_u64) << 52_u64;
    res * @bit_cast[f64](biased_bits)
}

/| Scales `f32` `x * 2^exp2` safely across `i32.MIN..=i32.MAX` (`[-280, 280]` clamped).
fn ldexp_f32(x: f32, exp2: i32, /) -> f32 {
    if x == 0.0_f32 or is_nan_f32(x) or not is_finite_f32(x) {
        return x;
    }
    let clamped: i32 = if exp2 < -280 => -280
        else if exp2 > 280 => 280
        else exp2;
    ldexp_f64(x as f64, clamped) as f32
}

/| Exact single-rounded software `f64` `mul_add` (`0.0000 ULP` vs IEEE-754 across normals, subnormals & cancellation).
fn mul_add_f64(x: f64, y: f64, z: f64, /) -> f64 {
    if is_nan_f64(x) or is_nan_f64(y) or is_nan_f64(z) {
        return @bit_cast[f64](0x7FF8_0000_0000_0000_u64);
    }
    let x_inf: bool = not is_finite_f64(x);
    let y_inf: bool = not is_finite_f64(y);
    if (x_inf and y == 0.0) or (y_inf and x == 0.0) {
        return @bit_cast[f64](0x7FF8_0000_0000_0000_u64);
    }
    if x_inf or y_inf {
        return (x * y) + z;
    }
    if not is_finite_f64(z) {
        return z;
    }
    if x == 0.0 or y == 0.0 {
        return (x * y) + z;
    }
    if z == 0.0 {
        return x * y;
    }

    let (fx, ex) = frexp_f64(x);
    let (fy, ey) = frexp_f64(y);
    let (p_hi, p_lo) = two_prod_f64(fx, fy);
    let prod_exp: i32 = ex +% ey;
    let (fz, ez) = frexp_f64(z);
    let exp_diff: i32 = ez -% prod_exp;

    if exp_diff > 110 {
        let tiny_p: f64 = copysign_f64(7.703719777548943e-34, p_hi);
        return scale_triple_to_f64(fz, tiny_p, 0.0, ez);
    }
    if exp_diff < -110 {
        let tiny_z: f64 = copysign_f64(7.703719777548943e-34, z);
        return scale_triple_to_f64(p_hi, p_lo, tiny_z, prod_exp);
    }

    let z_scaled: f64 = ldexp_f64(fz, exp_diff);
    let (s_hi, s_lo) = two_sum_f64(p_hi, z_scaled);
    let (t_hi, t_lo) = two_sum_f64(s_lo, p_lo);
    let (u_hi, u_lo) = two_sum_f64(s_hi, t_hi);
    if u_hi == 0.0 and u_lo == 0.0 and t_lo == 0.0 {
        return 0.0;
    }
    let (v_hi, v_lo) = two_sum_f64(u_lo, t_lo);
    scale_triple_to_f64(u_hi, v_hi, v_lo, prod_exp)
}

/| Exact single-rounded `f32` `mul_add` via Boldo–Melquiond `f64` round-to-odd (`0.0000 ULP` across normals & subnormals).
fn mul_add_f32(x: f32, y: f32, z: f32, /) -> f32 {
    if is_nan_f32(x) or is_nan_f32(y) or is_nan_f32(z) {
        return @bit_cast[f32](0x7FC0_0000_u32);
    }
    let x64 = x as f64;
    let y64 = y as f64;
    let z64 = z as f64;
    let x_inf: bool = not is_finite_f64(x64);
    let y_inf: bool = not is_finite_f64(y64);
    if (x_inf and y == 0.0_f32) or (y_inf and x == 0.0_f32) {
        return @bit_cast[f32](0x7FC0_0000_u32);
    }
    if x_inf or y_inf or not is_finite_f64(z64) {
        return (x64 * y64 + z64) as f32;
    }
    if x == 0.0_f32 or y == 0.0_f32 {
        return (x * y) + z;
    }
    let (s_hi, s_lo) = two_sum_f64(x64 * y64, z64);
    round_to_odd_f64(s_hi, s_lo) as f32
}

/| Pure-software correctly-rounded IEEE-754 `f64` `sqrt` (`0.0000 ULP`, zero `libm`).
@std_cap_boundary(clears: [may_panic]) @no_alloc @no_panic
fn sqrt_f64(x: f64, /) -> f64 {
    if is_nan_f64(x) or x == 0.0 or x == @bit_cast[f64](0x7FF0_0000_0000_0000_u64) {
        return x;
    }
    if x < 0.0 {
        return @bit_cast[f64](0x7FF8_0000_0000_0000_u64);
    }
    var (mant, exp2) = frexp_f64(x);
    if (exp2 & 1) != 0 {
        mant *= 2.0;
        exp2 = exp2 -% 1;
    }
    var root: f64 = 0.5 + 0.5 * mant;
    root = 0.5 * (root + mant / root);
    root = 0.5 * (root + mant / root);
    root = 0.5 * (root + mant / root);
    root = 0.5 * (root + mant / root);
    let (p_hi, p_lo) = two_prod_f64(root, root);
    let rem: f64 = (mant - p_hi) - p_lo;
    ldexp_f64(root + rem / (2.0 * root), exp2 >> 1)
}

/| Pure-software correctly-rounded `f32` `sqrt` (`0.0000 ULP`).
fn sqrt_f32(x: f32, /) -> f32 {
    if is_nan_f32(x) or x == 0.0_f32 {
        return x;
    }
    if x < 0.0_f32 {
        return @bit_cast[f32](0x7FC0_0000_u32);
    }
    sqrt_f64(x as f64) as f32
}

/| Reduces `abs_x >= 2^20` modulo `pi / 2` via the 19-word Payne–Hanek `TWO_OVER_PI_WORDS` expansion (`> 115` bits).
@std_cap_boundary(clears: [may_panic]) @no_alloc @no_panic
fn payne_hanek_reduce_f64(abs_x: f64, /) -> (i32, f64, f64) {
    let bits: u64 = @bit_cast[u64](abs_x);
    let unbiased_exp: i32 = (((bits >> 52_u64) & 0x7FF_u64) as i32) -% 1023;
    let sig53: u64 = (bits & ((1_u64 << 52_u64) - 1_u64)) | (1_u64 << 52_u64);

    let bit_pos = (unbiased_exp +% 12) as u32;
    let word_idx = (bit_pos >> 6_u32) as usize;
    let bit_rem = (bit_pos & 63_u32) as u64;

    let prev_idx: usize = if word_idx >= 1_usize => (word_idx -% 1_usize) % 19_usize else 0_usize;
    let w_prev: u64 = if word_idx >= 1_usize => TWO_OVER_PI_WORDS[prev_idx] else 0_u64;
    let w0: u64 = TWO_OVER_PI_WORDS[word_idx % 19_usize];
    let w1: u64 = TWO_OVER_PI_WORDS[(word_idx +% 1_usize) % 19_usize];
    let w2: u64 = TWO_OVER_PI_WORDS[(word_idx +% 2_usize) % 19_usize];
    let w3: u64 = if (word_idx +% 3_usize) < 19_usize {
        TWO_OVER_PI_WORDS[
            (word_idx +% 3_usize) % 19_usize,
        ]
    } else {
        0_u64
    };

    var a_int = 0_u64;
    var a0 = 0_u64;
    var a1 = 0_u64;
    var a2 = 0_u64;
    if bit_rem == 0_u64 {
        a_int = w_prev & 3_u64;
        a0 = w0;
        a1 = w1;
        a2 = w2;
    } else {
        let rsh: u64 = (64_u64 -% bit_rem) & 63_u64;
        a_int = ((w_prev << bit_rem) | (w0 >> rsh)) & 3_u64;
        a0 = (w0 << bit_rem) | (w1 >> rsh);
        a1 = (w1 << bit_rem) | (w2 >> rsh);
        a2 = (w2 << bit_rem) | (w3 >> rsh);
    }

    let (p2_lo, p2_hi) = widening_mul_u64(a2, sig53);
    let (p1_lo, p1_hi) = widening_mul_u64(a1, sig53);
    let (p0_lo, p0_hi) = widening_mul_u64(a0, sig53);

    let (s1, c1) = carrying_add_u64(p1_lo, p2_hi, false);
    let (s0, c0) = carrying_add_u64(p0_lo, p1_hi, c1);
    let int_part: u64 = ((a_int *% sig53) +% p0_hi +% (c0 as u64)) & 3_u64;

    let neg_frac: bool = (s0 >> 63_u64) != 0_u64;
    var quad: i32 = 0;
    var n0: u64 = s0;
    var n1: u64 = s1;
    if neg_frac {
        quad = ((int_part +% 1_u64) & 3_u64) as i32;
        let borrow2: bool = p2_lo != 0_u64;
        n1 = (~s1) +% (if borrow2 => 0_u64 else 1_u64);
        let borrow1: bool = borrow2 or (s1 != 0_u64);
        n0 = (~s0) +% (if borrow1 => 0_u64 else 1_u64);
    } else {
        quad = (int_part & 3_u64) as i32;
    }

    let (_, m_lo_hi) = widening_mul_u64(n0, PIO2_W1);
    let (_, m_hi_lo) = widening_mul_u64(n1, PIO2_W0);
    let (r0_lo, r0_hi) = widening_mul_u64(n0, PIO2_W0);
    let (mid_a, mid_c1) = carrying_add_u64(r0_lo, m_lo_hi, false);
    let (mid_sum, mid_c2) = carrying_add_u64(mid_a, m_hi_lo, false);
    let top_hi: u64 = r0_hi +% (mid_c1 as u64) +% (mid_c2 as u64);

    let top_hi_lo32: u64 = top_hi & 0xFFFF_FFFF_u64;
    let top_hi_hi32: u64 = top_hi >> 32_u64;
    let (f_top, f_top_rem) = two_sum_f64(
        (top_hi_hi32 as f64) * 4_294_967_296.0 * SCALE_M63,
        (top_hi_lo32 as f64) * SCALE_M63,
    );
    let f_lo: f64 = f_top_rem + (mid_sum as f64) * SCALE_M127;
    let signed_top: f64 = if neg_frac => -f_top else f_top;
    let signed_lo: f64 = if neg_frac => -f_lo else f_lo;
    let (r_hi, r_lo) = two_sum_f64(signed_top, signed_lo);
    (quad, r_hi, r_lo)
}

/| Hybrid 4-part Cody–Waite (`|x| < 2^20`) + 19-word Payne–Hanek (`|x| >= 2^20`) `pi / 2` range reduction.
fn reduce_pio2_f64(x: f64, /) -> (i32, f64, f64) {
    let abs_x: f64 = abs_f64(x);
    if abs_x < 0.7853981633974483 {
        return (0, x, 0.0);
    }
    if abs_x < 1_048_576.0 {
        let pio2_1: f64 = @bit_cast[f64](0x3FF9_21FB_5440_0000_u64);
        let pio2_2: f64 = @bit_cast[f64](0x3DD0_B461_1A60_0000_u64);
        let pio2_3: f64 = @bit_cast[f64](0x3BA3_198A_2E00_0000_u64);
        let pio2_4: f64 = @bit_cast[f64](0x397B_839A_2520_49C1_u64);

        let k_flt: f64 = round_ties_even_f64(x * INV_PIO2);
        let quad: i32 = exact_f64_to_i32(k_flt) & 3;
        let w1: f64 = x - k_flt * pio2_1;
        let (s1, e1) = two_sum_f64(w1, -(k_flt * pio2_2));
        let (s2, e2) = two_sum_f64(s1, -(k_flt * pio2_3));
        let (t_hi, t_lo) = two_prod_f64(k_flt, pio2_4);
        let (s3, e3) = two_sum_f64(s2, -t_hi);
        let (r_hi, r_lo) = two_sum_f64(s3, (e1 + e2) + (e3 - t_lo));
        return (quad, r_hi, r_lo);
    }
    let (quad_pos, r_hi, r_lo) = payne_hanek_reduce_f64(abs_x);
    if x < 0.0 {
        return ((0 -% quad_pos) & 3, -r_hi, -r_lo);
    }
    return (quad_pos, r_hi, r_lo);
}

/| Degree-13 minimax `sin(r_hi + r_lo)` kernel on `[-pi / 4, +pi / 4]`.
fn kernel_sin_f64(r_hi: f64, r_lo: f64, /) -> f64 {
    let s1: f64 = @bit_cast[f64](0xBFC5_5555_5555_5549_u64);
    let s2: f64 = @bit_cast[f64](0x3F81_1111_1110_F8A6_u64);
    let s3: f64 = @bit_cast[f64](0xBF2A_01A0_19C1_61D5_u64);
    let s4: f64 = @bit_cast[f64](0x3EC7_1DE3_57B1_FE7D_u64);
    let s5: f64 = @bit_cast[f64](0xBE5A_E5E6_8A2B_9CEB_u64);
    let s6: f64 = @bit_cast[f64](0x3DE5_D93A_5ACF_D57C_u64);
    let z: f64 = r_hi * r_hi;
    let w: f64 = z * z;
    let r_poly: f64 = s2 + z * (s3 + z * s4) + z * w * (s5 + z * s6);
    if r_lo == 0.0 {
        return r_hi + z * (r_hi * (s1 + z * r_poly));
    }
    r_hi - (((z * (0.5 * r_lo - z * (r_hi * r_poly)) - r_lo) - z * (r_hi * s1)))
}

/| Degree-12 minimax `cos(r_hi + r_lo)` kernel on `[-pi / 4, +pi / 4]`.
fn kernel_cos_f64(r_hi: f64, r_lo: f64, /) -> f64 {
    let c1: f64 = @bit_cast[f64](0x3FA5_5555_5555_554C_u64);
    let c2: f64 = @bit_cast[f64](0xBF56_C16C_16C1_5177_u64);
    let c3: f64 = @bit_cast[f64](0x3EFA_01A0_19CB_1590_u64);
    let c4: f64 = @bit_cast[f64](0xBE92_7E4F_809C_52AD_u64);
    let c5: f64 = @bit_cast[f64](0x3E21_EE9E_BDB4_B1C4_u64);
    let c6: f64 = @bit_cast[f64](0xBDA8_FAE9_BE88_38D4_u64);
    let z: f64 = r_hi * r_hi;
    let w: f64 = z * z;
    let r_poly: f64 = c1 + z * (c2 + z * c3) + z * w * (c4 + z * (c5 + z * c6));
    let hz: f64 = 0.5 * z;
    let w_top: f64 = 1.0 - hz;
    w_top + (((1.0 - w_top) - hz) + (w * r_poly - r_hi * r_lo))
}

/| Double-double `(sin_hi, sin_lo, cos_hi, cos_lo)` on `[-pi / 4, +pi / 4]` for `<= 0.52 ULP` `tan` across poles.
fn sin_cos_dd_f64(r_hi: f64, r_lo: f64, /) -> (f64, f64, f64, f64) {
    let (z_a, z_b) = two_prod_f64(r_hi, r_hi);
    let (z_hi, z_lo) = two_sum_f64(z_a, z_b + 2.0 * r_hi * r_lo);

    var s_tail: f64 = 1.0 / 355_687_428_096_000.0;
    s_tail = (-1.0 / 1_307_674_368_000.0) + z_hi * s_tail;
    s_tail = (1.0 / 6_227_020_800.0) + z_hi * s_tail;
    s_tail = (-1.0 / 39_916_800.0) + z_hi * s_tail;
    s_tail = (1.0 / 362_880.0) + z_hi * s_tail;
    s_tail = (-1.0 / 5_040.0) + z_hi * s_tail;

    let (c120_hi, c120_lo) = dd_div_f64(1.0, 0.0, 120.0, 0.0);
    let (ps1_hi, ps1_lo) = two_prod_f64(z_hi, s_tail);
    let (ss1_hi, ss1_lo) = two_sum_f64(c120_hi, ps1_hi);
    let (as1_hi, as1_lo) = two_sum_f64(ss1_hi, ss1_lo + c120_lo + ps1_lo);

    let (c6_hi, c6_lo) = dd_div_f64(-1.0, 0.0, 6.0, 0.0);
    let (ps2_hi, ps2_lo) = two_prod_f64(z_hi, as1_hi);
    let (ss2_hi, ss2_lo) = two_sum_f64(c6_hi, ps2_hi);
    let (as2_hi, as2_lo) = two_sum_f64(
        ss2_hi,
        ss2_lo + c6_lo + ps2_lo + z_hi * as1_lo + z_lo * as1_hi,
    );

    let (ps3_hi, ps3_lo) = two_prod_f64(z_hi, as2_hi);
    let (ss3_hi, ss3_lo) = two_sum_f64(1.0, ps3_hi);
    let (as3_hi, as3_lo) = two_sum_f64(ss3_hi, ss3_lo + ps3_lo + z_hi * as2_lo + z_lo * as2_hi);

    let (sn_a, sn_b) = two_prod_f64(r_hi, as3_hi);
    let (sin_hi, sin_lo) = two_sum_f64(sn_a, sn_b + r_hi * as3_lo + r_lo * as3_hi);

    var c_tail: f64 = 1.0 / 20_922_789_888_000.0;
    c_tail = (-1.0 / 87_178_291_200.0) + z_hi * c_tail;
    c_tail = (1.0 / 479_001_600.0) + z_hi * c_tail;
    c_tail = (-1.0 / 3_628_800.0) + z_hi * c_tail;
    c_tail = (1.0 / 40_320.0) + z_hi * c_tail;
    c_tail = (-1.0 / 720.0) + z_hi * c_tail;

    let (c24_hi, c24_lo) = dd_div_f64(1.0, 0.0, 24.0, 0.0);
    let (pc1_hi, pc1_lo) = two_prod_f64(z_hi, c_tail);
    let (sc1_hi, sc1_lo) = two_sum_f64(c24_hi, pc1_hi);
    let (ac1_hi, ac1_lo) = two_sum_f64(sc1_hi, sc1_lo + c24_lo + pc1_lo);

    let (pc2_hi, pc2_lo) = two_prod_f64(z_hi, ac1_hi);
    let (sc2_hi, sc2_lo) = two_sum_f64(-0.5, pc2_hi);
    let (ac2_hi, ac2_lo) = two_sum_f64(sc2_hi, sc2_lo + pc2_lo + z_hi * ac1_lo + z_lo * ac1_hi);

    let (pc3_hi, pc3_lo) = two_prod_f64(z_hi, ac2_hi);
    let (sc3_hi, sc3_lo) = two_sum_f64(1.0, pc3_hi);
    let (cos_hi, cos_lo) = two_sum_f64(sc3_hi, sc3_lo + pc3_lo + z_hi * ac2_lo + z_lo * ac2_hi);
    (sin_hi, sin_lo, cos_hi, cos_lo)
}

/| Double-double `atan(x_hi + x_lo)` for `x_hi >= 0`, shared across `atan`, `atan2`, `asin`, and `acos`.
@std_cap_boundary(clears: [may_panic]) @no_alloc @no_panic
fn atan_pos_ext_f64(x_hi: f64, x_lo: f64, /) -> (f64, f64) {
    if x_hi >= 7.3786976294838206e19 {
        return (@bit_cast[f64](0x3FF9_21FB_5444_2D18_u64), @bit_cast[f64](0x3C91_A626_3314_5C07_u64));
    }
    if x_hi < 1.862645149230957e-9 {
        return (x_hi, x_lo);
    }

    var id_idx: i32 = -1;
    var t_hi: f64 = x_hi;
    var t_lo: f64 = x_lo;
    if x_hi >= 0.4375 {
        if x_hi < 0.6875 {
            id_idx = 0;
            let (nh, nl) = two_sum_f64(2.0 * x_hi - 1.0, 2.0 * x_lo);
            let (dh, dl) = two_sum_f64(2.0, x_hi);
            (t_hi, t_lo) = dd_div_f64(nh, nl, dh, dl + x_lo);
        } else if x_hi < 1.1875 {
            id_idx = 1;
            let (nh, nl) = two_sum_f64(x_hi - 1.0, x_lo);
            let (dh, dl) = two_sum_f64(x_hi, 1.0);
            (t_hi, t_lo) = dd_div_f64(nh, nl, dh, dl + x_lo);
        } else if x_hi < 2.4375 {
            id_idx = 2;
            let (ph, pl) = two_prod_f64(1.5, x_hi);
            let (nh, nl) = two_sum_f64(x_hi, -1.5);
            let (dh, dl) = two_sum_f64(1.0, ph);
            (t_hi, t_lo) = dd_div_f64(nh, nl + x_lo, dh, dl + pl + 1.5 * x_lo);
        } else {
            id_idx = 3;
            (t_hi, t_lo) = dd_div_f64(-1.0, 0.0, x_hi, x_lo);
        }
    }

    let at0: f64 = @bit_cast[f64](0x3FD5_5555_5555_550D_u64);
    let at1: f64 = @bit_cast[f64](0xBFC9_9999_9998_EBC4_u64);
    let at2: f64 = @bit_cast[f64](0x3FC2_4924_9200_83FF_u64);
    let at3: f64 = @bit_cast[f64](0xBFBC_71C6_FE23_1671_u64);
    let at4: f64 = @bit_cast[f64](0x3FB7_45CD_C54C_206E_u64);
    let at5: f64 = @bit_cast[f64](0xBFB3_B0F2_AF74_9A6D_u64);
    let at6: f64 = @bit_cast[f64](0x3FB1_0D66_A0D0_3D51_u64);
    let at7: f64 = @bit_cast[f64](0xBFAD_DE2D_52DE_FD9A_u64);
    let at8: f64 = @bit_cast[f64](0x3FA9_7B4B_2476_0DEB_u64);
    let at9: f64 = @bit_cast[f64](0xBFA2_B444_2C6A_6C2F_u64);
    let at10: f64 = @bit_cast[f64](0x3F90_AD3A_E322_DA11_u64);

    let z: f64 = t_hi * t_hi;
    let w: f64 = z * z;
    let s1: f64 = z * (at0 + w * (at2 + w * (at4 + w * (at6 + w * (at8 + w * at10)))));
    let s2: f64 = w * (at1 + w * (at3 + w * (at5 + w * (at7 + w * at9))));
    let poly_tail: f64 = t_lo - t_hi * (s1 + s2);
    if id_idx < 0 {
        return two_sum_f64(t_hi, poly_tail);
    }
    let slot: usize = (id_idx as usize) & 3_usize;
    let (sh, sl) = two_sum_f64(ATAN_ANCHOR_HI[slot], t_hi);
    two_sum_f64(sh, sl + ATAN_ANCHOR_LO[slot] + poly_tail)
}

/| Evaluates the degree-14 minimax polynomial tail for `ln((1 + s) / (1 - s))` on `z = s^2`.
fn ln_remez_poly_f64(z: f64, /) -> f64 {
    let w: f64 = z * z;
    z * (LN_POLY_LG1 + w * (LN_POLY_LG3 + w * (LN_POLY_LG5 + w * LN_POLY_LG7))) + w * (
        LN_POLY_LG2 + w * (LN_POLY_LG4 + w * LN_POLY_LG6)
    )
}

/| Evaluates the rational Remez `exp` auxiliary `r_val - r_val^2 * P(r_val^2)` shared by `exp`, `exp2`, and `powf`.
fn exp_remez_c_f64(r_val: f64, /) -> f64 {
    let z: f64 = r_val * r_val;
    r_val - z * (
        EXP_POLY_P1 + z * (EXP_POLY_P2 + z * (EXP_POLY_P3 + z * (EXP_POLY_P4 + z * EXP_POLY_P5)))
    )
}

/| Minimax `ln(f_val) + corr / f_val` kernel on `[sqrt(2)/2, sqrt(2)]` returning `(hi, lo)`.
fn ln_kernel_ext_f64(f_val: f64, corr: f64, /) -> (f64, f64) {
    let s_arg: f64 = (f_val - 1.0) / (f_val + 1.0);
    let r_poly: f64 = ln_remez_poly_f64(s_arg * s_arg);
    let f_minus_1: f64 = f_val - 1.0;
    let hfsq: f64 = 0.5 * f_minus_1 * f_minus_1;
    let (hi, e0) = two_sum_f64(f_minus_1, -hfsq);
    let lo: f64 = e0 + s_arg * (hfsq + r_poly) + corr / f_val;
    two_sum_f64(hi, lo)
}

/| Double-double Horner step `1 / odd_denom + z * acc` for `log2_ext_f64`.
fn dd_horner_odd_recip(
    z_hi: f64,
    z_lo: f64,
    acc_hi: f64,
    acc_lo: f64,
    odd_denom: f64,
    /,
) -> (f64, f64) {
    let (ph, pl) = two_prod_f64(z_hi, acc_hi);
    let (rh, rl) = dd_div_f64(1.0, 0.0, odd_denom, 0.0);
    let (sh, sl) = two_sum_f64(rh, ph);
    two_sum_f64(sh, sl + rl + pl + z_hi * acc_lo + z_lo * acc_hi)
}

/| Extended-precision `log2(x) = (hi, lo)` accurate to `~98` bits (`0 B` `.rodata`), powering `log2`, `log10`, `powf`, and `powi`.
fn log2_ext_f64(x: f64, /) -> (f64, f64) {
    var (frac, k) = frexp_f64(x);
    if frac < 0.7071067811865475 {
        frac *= 2.0;
        k = k -% 1;
    }
    let (rt_hi, rt_lo) = dd_sqrt_f64(frac, 0.0);
    let (nh, nl) = two_sum_f64(rt_hi - 1.0, rt_lo);
    let (d0, d1) = two_sum_f64(1.0, rt_hi);
    let (dh, dl) = two_sum_f64(d0, d1 + rt_lo);
    let (s_hi, s_lo) = dd_div_f64(nh, nl, dh, dl);
    let (za, zb) = two_prod_f64(s_hi, s_hi);
    let (z_hi, z_lo) = two_sum_f64(za, zb + 2.0 * s_hi * s_lo);

    var tail: f64 = 1.0 / 27.0;
    tail = (1.0 / 25.0) + z_hi * tail;
    tail = (1.0 / 23.0) + z_hi * tail;
    tail = (1.0 / 21.0) + z_hi * tail;
    tail = (1.0 / 19.0) + z_hi * tail;
    tail = (1.0 / 17.0) + z_hi * tail;
    tail = (1.0 / 15.0) + z_hi * tail;
    tail = (1.0 / 13.0) + z_hi * tail;
    tail = (1.0 / 11.0) + z_hi * tail;

    let (a9_hi, a9_lo) = dd_horner_odd_recip(z_hi, z_lo, tail, 0.0, 9.0);
    let (a7_hi, a7_lo) = dd_horner_odd_recip(z_hi, z_lo, a9_hi, a9_lo, 7.0);
    let (a5_hi, a5_lo) = dd_horner_odd_recip(z_hi, z_lo, a7_hi, a7_lo, 5.0);
    let (a3_hi, a3_lo) = dd_horner_odd_recip(z_hi, z_lo, a5_hi, a5_lo, 3.0);
    let (ph, pl) = two_prod_f64(z_hi, a3_hi);
    let (sh, sl) = two_sum_f64(1.0, ph);
    let (acc_hi, acc_lo) = two_sum_f64(sh, sl + pl + z_hi * a3_lo + z_lo * a3_hi);

    let four_inv_ln2_hi: f64 = @bit_cast[f64](0x4017_1547_652B_82FE_u64);
    let four_inv_ln2_lo: f64 = @bit_cast[f64](0x3C97_77D0_FFDA_0D24_u64);
    let (p1_a, p1_b) = two_prod_f64(s_hi, acc_hi);
    let (p1_hi, p1_lo) = two_sum_f64(p1_a, p1_b + s_hi * acc_lo + s_lo * acc_hi);
    let (lg_hi, lg_lo) = two_prod_f64(p1_hi, four_inv_ln2_hi);
    let (kh, kl) = two_sum_f64(k as f64, lg_hi);
    two_sum_f64(kh, kl + lg_lo + p1_hi * four_inv_ln2_lo + p1_lo * four_inv_ln2_hi)
}

/| Extended-precision `2^(y_hi + y_lo)` kernel for `powf` and `powi`.
fn exp2_ext_f64(y_hi: f64, y_lo: f64, /) -> f64 {
    let total: f64 = y_hi + y_lo;
    if total >= 1024.0 and (y_hi > 1024.0 or (y_hi == 1024.0 and y_lo >= 0.0)) {
        return @bit_cast[f64](0x7FF0_0000_0000_0000_u64);
    }
    if total < -1075.0 {
        return 0.0;
    }
    let k_flt: f64 = round_ties_even_f64(total);
    let k: i32 = exact_f64_to_i32(k_flt);
    let (f_hi, f_lo) = two_sum_f64(y_hi - k_flt, y_lo);
    let ln2_hi: f64 = @bit_cast[f64](0x3FE6_2E42_FEFA_39EF_u64);
    let ln2_lo: f64 = @bit_cast[f64](0x3ABC_9E3B_3980_3F30_u64);
    let (ra, rb) = two_prod_f64(f_hi, ln2_hi);
    let (r_hi, r_lo) = two_sum_f64(ra, rb + f_hi * ln2_lo + f_lo * ln2_hi);
    let c_val: f64 = exp_remez_c_f64(r_hi);
    let y_val: f64 = 1.0 + (r_hi + ((r_hi * c_val) / (2.0 - c_val) + r_lo * (1.0 + r_hi)));
    if k == 1024 {
        return (y_val * @bit_cast[f64](0x7FD0_0000_0000_0000_u64)) * 4.0;
    }
    ldexp_f64(y_val, k)
}

/| Classifies `exp` as `0 = non-integer`, `1 = odd integer`, or `2 = even integer` without `i64` cast overflow.
fn float_int_parity_f64(exp: f64, /) -> i32 {
    if abs_f64(exp) >= 9_007_199_254_740_992.0 {
        return 2;
    }
    if trunc_f64(exp) != exp {
        return 0;
    }
    if trunc_f64(exp * 0.5) * 2.0 == exp => 2 else 1
}

/| Real `f64` cube root `cbrt` (`max 0.5000 ULP`; odd-symmetric, `frexp`-scaled to prevent `> MAX/2` overflow).
@std_cap_boundary(clears: [may_panic]) @no_alloc @no_panic
fn cbrt_f64(x: f64, /) -> f64 {
    if x == 0.0 or is_nan_f64(x) or not is_finite_f64(x) {
        return x;
    }
    let (mant, exp2) = frexp_f64(abs_f64(x));
    let quo_neg_adj: i32 = if exp2 >= 0 => exp2 / 3 else 0 -% (((0 -% exp2) +% 2) / 3);
    let rem_exp: i32 = exp2 -% 3 *% quo_neg_adj;
    let m_scaled: f64 = ldexp_f64(mant, rem_exp);

    var est: f64 = 0.6 + 0.28 * m_scaled;
    var step_i = 0_u32;
    while step_i < 3_u32 {
        let est3: f64 = est * est * est;
        est *= (est3 + 2.0 * m_scaled) / (2.0 * est3 + m_scaled);
        step_i = step_i +% 1_u32;
    }
    let (sq_hi, sq_lo) = two_prod_f64(est, est);
    let (cb_hi, cb_lo) = two_prod_f64(sq_hi, est);
    let rem: f64 = (m_scaled - cb_hi) - (cb_lo + sq_lo * est);
    let refined: f64 = est + rem / (3.0 * sq_hi);
    copysign_f64(ldexp_f64(refined, quo_neg_adj), x)
}

/| Overflow/underflow-immune `f64` Euclidean norm (`max 0.4999 ULP`; `hypot(+-Inf, NaN) == +Inf`).
fn hypot_f64(x: f64, y: f64, /) -> f64 {
    let abs_x: f64 = abs_f64(x);
    let abs_y: f64 = abs_f64(y);
    let pos_inf: f64 = @bit_cast[f64](0x7FF0_0000_0000_0000_u64);
    if abs_x == pos_inf or abs_y == pos_inf {
        return pos_inf;
    }
    if is_nan_f64(x) or is_nan_f64(y) {
        return @bit_cast[f64](0x7FF8_0000_0000_0000_u64);
    }
    let hi: f64 = if abs_x >= abs_y => abs_x else abs_y;
    let lo: f64 = if abs_x >= abs_y => abs_y else abs_x;
    if hi == 0.0 {
        return 0.0;
    }
    let (_, k) = frexp_f64(hi);
    let hs: f64 = ldexp_f64(hi, 0 -% k);
    let ls: f64 = ldexp_f64(lo, 0 -% k);
    if ls < 9.313225746154785e-10 {
        return hi;
    }
    let (h2_hi, h2_lo) = two_prod_f64(hs, hs);
    let (l2_hi, l2_lo) = two_prod_f64(ls, ls);
    let (sum_hi, sum_lo) = two_sum_f64(h2_hi, l2_hi);
    let (rt_hi, rt_lo) = dd_sqrt_f64(sum_hi, sum_lo + h2_lo + l2_lo);
    ldexp_f64(rt_hi + rt_lo, k)
}

/| Simultaneous `f64` `(sin(x), cos(x))` (`max 0.7121 ULP` `sin`, `0.7366 ULP` `cos`).
fn sin_cos_f64(x: f64, /) -> (f64, f64) {
    if is_nan_f64(x) or not is_finite_f64(x) {
        let nan_val: f64 = @bit_cast[f64](0x7FF8_0000_0000_0000_u64);
        return (nan_val, nan_val);
    }
    if x == 0.0 {
        return (x, 1.0);
    }
    let (quad, r_hi, r_lo) = reduce_pio2_f64(x);
    let ks: f64 = kernel_sin_f64(r_hi, r_lo);
    let kc: f64 = kernel_cos_f64(r_hi, r_lo);
    match quad {
        0 => (ks, kc),
        1 => (kc, -ks),
        2 => (-ks, -kc),
        _ => (-kc, ks),
    }
}

/| Trigonometric `f64` tangent (`max 0.5200 ULP` across all quadrants and odd-quadrant poles).
fn tan_f64(x: f64, /) -> f64 {
    if is_nan_f64(x) or not is_finite_f64(x) {
        return @bit_cast[f64](0x7FF8_0000_0000_0000_u64);
    }
    if x == 0.0 {
        return x;
    }
    let (quad, r_hi, r_lo) = reduce_pio2_f64(x);
    let (s_hi, s_lo, c_hi, c_lo) = sin_cos_dd_f64(r_hi, r_lo);
    let (t_hi, t_lo) = if (quad & 1) == 0 => dd_div_f64(s_hi, s_lo, c_hi, c_lo)
        else dd_div_f64(-c_hi, -c_lo, s_hi, s_lo);
    t_hi + t_lo
}

/| Principal `f64` arc-sine in `[-pi / 2, +pi / 2]` (`max 0.6717 ULP`).
fn asin_f64(x: f64, /) -> f64 {
    if is_nan_f64(x) {
        return x;
    }
    let abs_x: f64 = abs_f64(x);
    if abs_x > 1.0 {
        return @bit_cast[f64](0x7FF8_0000_0000_0000_u64);
    }
    if abs_x == 1.0 {
        return copysign_f64(FRAC_PI_2, x);
    }
    if abs_x < 7.450580596923828e-9 {
        return x;
    }
    var om_hi: f64 = 0.0;
    var om_lo: f64 = 0.0;
    if abs_x < 0.5 {
        let (x2_hi, x2_lo) = two_prod_f64(abs_x, abs_x);
        let (s_hi, s_lo) = two_sum_f64(1.0, -x2_hi);
        om_hi = s_hi;
        om_lo = s_lo - x2_lo;
    } else {
        let diff: f64 = 1.0 - abs_x;
        let (op_hi, op_lo) = two_sum_f64(1.0, abs_x);
        let (p_hi, p_lo) = two_prod_f64(diff, op_hi);
        om_hi = p_hi;
        om_lo = p_lo + diff * op_lo;
    }
    let (rt_hi, rt_lo) = dd_sqrt_f64(om_hi, om_lo);
    let (q_hi, q_lo) = dd_div_f64(abs_x, 0.0, rt_hi, rt_lo);
    let (a_hi, a_lo) = atan_pos_ext_f64(q_hi, q_lo);
    copysign_f64(a_hi + a_lo, x)
}

/| Principal `f64` arc-cosine in `[0, pi]` (`max 0.6551 ULP`).
fn acos_f64(x: f64, /) -> f64 {
    if is_nan_f64(x) {
        return x;
    }
    let abs_x: f64 = abs_f64(x);
    if abs_x > 1.0 {
        return @bit_cast[f64](0x7FF8_0000_0000_0000_u64);
    }
    if x == 1.0 {
        return 0.0;
    }
    if x == -1.0 {
        return PI;
    }
    let (om_hi, om_lo) = two_sum_f64(1.0, -abs_x);
    let (op_hi, op_lo) = two_sum_f64(1.0, abs_x);
    let (r_hi, r_lo) = dd_div_f64(om_hi, om_lo, op_hi, op_lo);
    let (rt_hi, rt_lo) = dd_sqrt_f64(r_hi, r_lo);
    let (a_hi, a_lo) = atan_pos_ext_f64(rt_hi, rt_lo);
    if x >= 0.0 {
        return 2.0 * (a_hi + a_lo);
    }
    let pi_hi: f64 = @bit_cast[f64](0x4009_21FB_5444_2D18_u64);
    let pi_lo: f64 = @bit_cast[f64](0x3CA1_A626_3314_5C07_u64);
    let (sh, sl) = two_sum_f64(pi_hi, -2.0 * a_hi);
    sh + (sl + pi_lo - 2.0 * a_lo)
}

/| Principal `f64` arc-tangent in `[-pi / 2, +pi / 2]` (`max 0.7227 ULP`).
fn atan_f64(x: f64, /) -> f64 {
    if is_nan_f64(x) or x == 0.0 {
        return x;
    }
    let (a_hi, a_lo) = atan_pos_ext_f64(abs_f64(x), 0.0);
    copysign_f64(a_hi + a_lo, x)
}

/| Four-quadrant `f64` `atan2(y, x)` honoring IEEE-754 signed zeros via sign-bit inspection (`max 1.1074 ULP`).
fn atan2_f64(y: f64, x: f64, /) -> f64 {
    if is_nan_f64(x) or is_nan_f64(y) {
        return @bit_cast[f64](0x7FF8_0000_0000_0000_u64);
    }
    let x_neg: bool = (@bit_cast[u64](x) >> 63_u64) != 0_u64;
    let y_neg: bool = (@bit_cast[u64](y) >> 63_u64) != 0_u64;
    if y == 0.0 {
        if x_neg {
            return if y_neg => -PI else PI;
        }
        return y;
    }
    if x == 0.0 {
        return if y_neg => -FRAC_PI_2 else FRAC_PI_2;
    }
    if not is_finite_f64(x) {
        if not is_finite_f64(y) {
            let mag: f64 = if x_neg => 3.0 * FRAC_PI_4 else FRAC_PI_4;
            return if y_neg => -mag else mag;
        }
        let mag: f64 = if x_neg => PI else 0.0;
        return copysign_f64(mag, y);
    }
    if not is_finite_f64(y) {
        return if y_neg => -FRAC_PI_2 else FRAC_PI_2;
    }

    let ratio: f64 = abs_f64(y / x);
    var ang: f64 = 0.0;
    if ratio > 1.152921504606847e18 {
        ang = FRAC_PI_2;
    } else if x_neg and ratio < 8.673617379884035e-19 {
        ang = PI;
    } else {
        let (base_hi, base_lo) = atan_pos_ext_f64(ratio, 0.0);
        if x_neg {
            let pi_lo: f64 = @bit_cast[f64](0x3CA1_A626_3314_5C07_u64);
            ang = PI - ((base_hi + base_lo) - pi_lo);
        } else {
            ang = base_hi + base_lo;
        }
    }
    if y_neg => -ang else ang
}

/| Natural `f64` exponential `e^x` (`max 0.8079 ULP`).
fn exp_f64(x: f64, /) -> f64 {
    if is_nan_f64(x) {
        return x;
    }
    if x > 709.78271289338397 {
        return @bit_cast[f64](0x7FF0_0000_0000_0000_u64);
    }
    if x < -745.1332191019411 {
        return 0.0;
    }
    if abs_f64(x) < 5.551115123125783e-17 {
        return 1.0 + x;
    }
    let inv_ln2: f64 = @bit_cast[f64](0x3FF7_1547_652B_82FE_u64);
    let k_flt: f64 = round_ties_even_f64(x * inv_ln2);
    let k: i32 = exact_f64_to_i32(k_flt);
    let hi: f64 = x - k_flt * LN2_CW_HI;
    let lo: f64 = k_flt * LN2_CW_LO;
    let r_val: f64 = hi - lo;
    let c_val: f64 = exp_remez_c_f64(r_val);
    let y_val: f64 = 1.0 - ((lo - (r_val * c_val) / (2.0 - c_val)) - hi);
    ldexp_f64(y_val, k)
}

/| Base-2 `f64` exponential `2^x` (`max 0.9778 ULP`).
fn exp2_f64(x: f64, /) -> f64 {
    if is_nan_f64(x) {
        return x;
    }
    if x >= 1024.0 {
        return @bit_cast[f64](0x7FF0_0000_0000_0000_u64);
    }
    if x < -1075.0 {
        return 0.0;
    }
    if abs_f64(x) < 5.551115123125783e-17 {
        return 1.0 + x;
    }
    let k_flt: f64 = round_ties_even_f64(x);
    let k: i32 = exact_f64_to_i32(k_flt);
    let frac: f64 = x - k_flt;
    let ln2_hi: f64 = @bit_cast[f64](0x3FE6_2E42_FEFA_3800_u64);
    let ln2_lo: f64 = @bit_cast[f64](0x3D2E_F357_93C7_6730_u64);
    let hi: f64 = frac * ln2_hi;
    let lo: f64 = -(frac * ln2_lo);
    let r_val: f64 = hi - lo;
    let c_val: f64 = exp_remez_c_f64(r_val);
    let y_val: f64 = 1.0 - ((lo - (r_val * c_val) / (2.0 - c_val)) - hi);
    ldexp_f64(y_val, k)
}

/| Cancellation-free `f64` `e^x - 1` (`max 0.9825 ULP`).
fn expm1_f64(x: f64, /) -> f64 {
    if is_nan_f64(x) or x == 0.0 {
        return x;
    }
    if x > 709.78271289338397 {
        return @bit_cast[f64](0x7FF0_0000_0000_0000_u64);
    }
    if x < -37.42994775023705 {
        return -1.0;
    }
    let abs_x: f64 = abs_f64(x);
    let q1: f64 = @bit_cast[f64](0xBFA1_1111_1111_10F4_u64);
    let q2: f64 = @bit_cast[f64](0x3F5A_01A0_19FE_5585_u64);
    let q3: f64 = @bit_cast[f64](0xBF14_CE19_9EAA_DBB7_u64);
    let q4: f64 = @bit_cast[f64](0x3ED0_CFCA_86E6_5239_u64);
    let q5: f64 = @bit_cast[f64](0xBE8A_FDB7_6E09_C32D_u64);
    if abs_x < 0.34657359027997264 {
        if abs_x < 5.551115123125783e-17 {
            return x;
        }
        let hfx: f64 = 0.5 * x;
        let hxs: f64 = x * hfx;
        let r1: f64 = 1.0 + hxs * (q1 + hxs * (q2 + hxs * (q3 + hxs * (q4 + hxs * q5))));
        let t_val: f64 = 3.0 - r1 * hfx;
        let err_term: f64 = hxs * ((r1 - t_val) / (6.0 - x * t_val));
        return x - (x * err_term - hxs);
    }

    let inv_ln2: f64 = @bit_cast[f64](0x3FF7_1547_652B_82FE_u64);
    let k_flt: f64 = round_ties_even_f64(x * inv_ln2);
    let k: i32 = exact_f64_to_i32(k_flt);
    let hi: f64 = x - k_flt * LN2_CW_HI;
    let lo: f64 = k_flt * LN2_CW_LO;
    let r_val: f64 = hi - lo;
    let hfx: f64 = 0.5 * r_val;
    let hxs: f64 = r_val * hfx;
    let r1: f64 = 1.0 + hxs * (q1 + hxs * (q2 + hxs * (q3 + hxs * (q4 + hxs * q5))));
    let t_val: f64 = 3.0 - r1 * hfx;
    let c_corr: f64 = (hi - r_val) - lo;
    let err_term: f64 = (r_val * (hxs * ((r1 - t_val) / (6.0 - r_val * t_val)) - c_corr) - c_corr) - hxs;
    if k == -1 {
        return 0.5 * (r_val - err_term) - 0.5;
    }
    if k == 1 {
        return if r_val < -0.25 => 2.0 * (r_val - err_term) + 1.0
            else 1.0 + 2.0 * (r_val - err_term);
    }
    if k < -2 or k > 56 {
        return ldexp_f64(1.0 - (err_term - r_val), k) - 1.0;
    }
    let twop_neg_k: f64 = ldexp_f64(1.0, 0 -% k);
    if k < 20 {
        return ldexp_f64((1.0 - twop_neg_k) - (err_term - r_val), k);
    }
    ldexp_f64((r_val - (err_term + twop_neg_k)) + 1.0, k)
}

/| Natural `f64` logarithm `ln(x)` (`max 0.6885 ULP`).
fn ln_f64(x: f64, /) -> f64 {
    if is_nan_f64(x) or x == @bit_cast[f64](0x7FF0_0000_0000_0000_u64) {
        return x;
    }
    if x == 0.0 {
        return @bit_cast[f64](0xFFF0_0000_0000_0000_u64);
    }
    if x < 0.0 {
        return @bit_cast[f64](0x7FF8_0000_0000_0000_u64);
    }
    var (frac, k) = frexp_f64(x);
    if frac < 0.7071067811865475 {
        frac *= 2.0;
        k = k -% 1;
    }
    let (k_hi, k_lo) = ln_kernel_ext_f64(frac, 0.0);
    if k == 0 {
        return k_hi + k_lo;
    }
    let kf = k as f64;
    kf * LN2_CW_HI + ((k_lo + kf * LN2_CW_LO) + k_hi)
}

/| Base-2 `f64` logarithm `log2(x)` (`max 0.5000 ULP`; exact on integer powers of `2`).
fn log2_f64(x: f64, /) -> f64 {
    if is_nan_f64(x) or x == @bit_cast[f64](0x7FF0_0000_0000_0000_u64) {
        return x;
    }
    if x == 0.0 {
        return @bit_cast[f64](0xFFF0_0000_0000_0000_u64);
    }
    if x < 0.0 {
        return @bit_cast[f64](0x7FF8_0000_0000_0000_u64);
    }
    let (hi, lo) = log2_ext_f64(x);
    hi + lo
}

/| Base-10 `f64` logarithm `log10(x)` (`max 0.5000 ULP`).
fn log10_f64(x: f64, /) -> f64 {
    if is_nan_f64(x) or x == @bit_cast[f64](0x7FF0_0000_0000_0000_u64) {
        return x;
    }
    if x == 0.0 {
        return @bit_cast[f64](0xFFF0_0000_0000_0000_u64);
    }
    if x < 0.0 {
        return @bit_cast[f64](0x7FF8_0000_0000_0000_u64);
    }
    let (l2_hi, l2_lo) = log2_ext_f64(x);
    let log10_2_hi: f64 = @bit_cast[f64](0x3FD3_4413_509F_79FF_u64);
    let log10_2_lo: f64 = @bit_cast[f64](0xBC49_DC1D_A994_FD21_u64);
    let (ph, pl) = two_prod_f64(l2_hi, log10_2_hi);
    ph + (pl + l2_hi * log10_2_lo + l2_lo * log10_2_hi)
}

/| Cancellation-free `f64` `ln(1 + x)` (`max 0.5754 ULP`).
fn ln_1p_f64(x: f64, /) -> f64 {
    if is_nan_f64(x) or x == 0.0 or x == @bit_cast[f64](0x7FF0_0000_0000_0000_u64) {
        return x;
    }
    if x < -1.0 {
        return @bit_cast[f64](0x7FF8_0000_0000_0000_u64);
    }
    if x == -1.0 {
        return @bit_cast[f64](0xFFF0_0000_0000_0000_u64);
    }
    let abs_x: f64 = abs_f64(x);
    if abs_x < 5.551115123125783e-17 {
        return x;
    }
    if abs_x < 0.2928932188134524 {
        let s_arg: f64 = x / (2.0 + x);
        let r_poly: f64 = ln_remez_poly_f64(s_arg * s_arg);
        let hfsq: f64 = 0.5 * x * x;
        return x - (hfsq - s_arg * (hfsq + r_poly));
    }
    let (u_val, corr_u) = two_sum_f64(1.0, x);
    var (frac, k) = frexp_f64(u_val);
    var corr: f64 = ldexp_f64(corr_u, 0 -% k);
    if frac < 0.7071067811865475 {
        frac *= 2.0;
        corr *= 2.0;
        k = k -% 1;
    }
    let (k_hi, k_lo) = ln_kernel_ext_f64(frac, corr);
    if k == 0 {
        return k_hi + k_lo;
    }
    let kf = k as f64;
    kf * LN2_CW_HI + ((k_lo + kf * LN2_CW_LO) + k_hi)
}

/| Floating-point `f64` power `base^exp` honoring all 19 IEEE-754-2019 special cases (`max 0.8450 ULP`).
fn powf_f64(base: f64, exp: f64, /) -> f64 {
    if exp == 0.0 or base == 1.0 {
        return 1.0;
    }
    if is_nan_f64(base) or is_nan_f64(exp) {
        return @bit_cast[f64](0x7FF8_0000_0000_0000_u64);
    }
    let pos_inf: f64 = @bit_cast[f64](0x7FF0_0000_0000_0000_u64);
    if not is_finite_f64(exp) {
        let abs_b: f64 = abs_f64(base);
        if abs_b == 1.0 {
            return 1.0;
        }
        return if (abs_b > 1.0) == (exp > 0.0) => pos_inf else 0.0;
    }
    let parity: i32 = float_int_parity_f64(exp);
    if not is_finite_f64(base) {
        let mag: f64 = if exp > 0.0 => pos_inf else 0.0;
        return if base < 0.0 and parity == 1 => -mag else mag;
    }
    if base == 0.0 {
        let mag: f64 = if exp < 0.0 => pos_inf else 0.0;
        let base_neg: bool = (@bit_cast[u64](base) >> 63_u64) != 0_u64;
        return if parity == 1 and base_neg => -mag else mag;
    }
    var neg_res = false;
    if base < 0.0 {
        if parity == 0 {
            return @bit_cast[f64](0x7FF8_0000_0000_0000_u64);
        }
        neg_res = parity == 1;
    }
    let abs_base: f64 = abs_f64(base);
    if abs_base == 1.0 {
        return if neg_res => -1.0 else 1.0;
    }
    if abs_f64(exp) > 1.0e20 {
        let mag_lim: f64 = if (abs_base > 1.0) == (exp > 0.0) => pos_inf else 0.0;
        return if neg_res => -mag_lim else mag_lim;
    }
    let (l2_hi, l2_lo) = log2_ext_f64(abs_base);
    let (ya, yb) = two_prod_f64(exp, l2_hi);
    let (y_hi, y_lo) = two_sum_f64(ya, yb + exp * l2_lo);
    let mag: f64 = exp2_ext_f64(y_hi, y_lo);
    if neg_res => -mag else mag
}

/| Integer-exponent `f64` power `base^exp` in `O(1)` via `log2_ext` + `exp2_ext` (`max 0.8422 ULP`).
fn powi_f64(base: f64, exp: i32, /) -> f64 {
    if exp == 0 {
        return 1.0;
    }
    if is_nan_f64(base) {
        return base;
    }
    let pos_inf: f64 = @bit_cast[f64](0x7FF0_0000_0000_0000_u64);
    let is_odd: bool = (exp & 1) != 0;
    if base == 0.0 {
        let mag: f64 = if exp < 0 => pos_inf else 0.0;
        let base_neg: bool = (@bit_cast[u64](base) >> 63_u64) != 0_u64;
        return if is_odd and base_neg => -mag else mag;
    }
    if not is_finite_f64(base) {
        let mag: f64 = if exp > 0 => pos_inf else 0.0;
        return if is_odd and base < 0.0 => -mag else mag;
    }
    let neg_out: bool = base < 0.0 and is_odd;
    let exp_flt = exp as f64;
    let (l2_hi, l2_lo) = log2_ext_f64(abs_f64(base));
    let (ya, yb) = two_prod_f64(exp_flt, l2_hi);
    let (y_hi, y_lo) = two_sum_f64(ya, yb + exp_flt * l2_lo);
    let mag: f64 = exp2_ext_f64(y_hi, y_lo);
    if neg_out => -mag else mag
}

// ------------------------------------- PUBLIC API --------------------------------------
// ------------ Scalar, Bitwise & Checked Arithmetic ------------
/| Returns the smaller of `lhs` and `rhs` (signed-zero-commutative `-0.0 < +0.0` & non-`NaN` preferring on `Float`).
@no_alloc @no_panic
pub fn min[T: Comparable + Copy](lhs: T, rhs: T, /) -> T {
    comptime if @implements[T, Float]() {
        comptime if @size_of[T]() == 4_usize {
            if is_nan_f32(lhs as f32) {
                return rhs;
            }
            if is_nan_f32(rhs as f32) {
                return lhs;
            }
            if lhs == rhs and (@bit_cast[u32](rhs as f32) >> 31_u32) != 0_u32 {
                return rhs;
            }
        } else {
            if is_nan_f64(lhs as f64) {
                return rhs;
            }
            if is_nan_f64(rhs as f64) {
                return lhs;
            }
            if lhs == rhs and (@bit_cast[u64](rhs as f64) >> 63_u64) != 0_u64 {
                return rhs;
            }
        }
    }
    if rhs < lhs => rhs else lhs
}

/| Returns the larger of `lhs` and `rhs` (signed-zero-commutative `+0.0 > -0.0` & non-`NaN` preferring on `Float`).
@no_alloc @no_panic
pub fn max[T: Comparable + Copy](lhs: T, rhs: T, /) -> T {
    comptime if @implements[T, Float]() {
        comptime if @size_of[T]() == 4_usize {
            if is_nan_f32(lhs as f32) {
                return rhs;
            }
            if is_nan_f32(rhs as f32) {
                return lhs;
            }
            if lhs == rhs and (@bit_cast[u32](lhs as f32) >> 31_u32) != 0_u32 {
                return rhs;
            }
        } else {
            if is_nan_f64(lhs as f64) {
                return rhs;
            }
            if is_nan_f64(rhs as f64) {
                return lhs;
            }
            if lhs == rhs and (@bit_cast[u64](lhs as f64) >> 63_u64) != 0_u64 {
                return rhs;
            }
        }
    }
    if lhs < rhs => rhs else lhs
}

/| Clamps `value` into the inclusive range `[low, high]`.
@no_alloc @no_panic
pub fn clamp[T: Comparable + Copy](value: T, low: T, high: T, /) -> T {
    if value < low {
        return low;
    } else if value > high {
        return high;
    }
    value
}

/| Overflow-free unsigned ceiling division `ceil(lhs / rhs)` for `rhs >= 1`.
@std_cap_boundary(clears: [may_panic]) @inline @no_alloc @no_panic
pub fn div_ceil[T: Unsigned](lhs: T, rhs: T is 1..=T.MAX, /) -> T {
    if rhs == (0 as T) or lhs == (0 as T) {
        return 0 as T;
    }
    return ((lhs -% (1 as T)) / rhs) +% (1 as T);
}

/| Euclidean floor division `floor(lhs / rhs)`, returning `.None` when `rhs == 0` or signed `T.MIN / -1`.
@std_cap_boundary(clears: [may_panic]) @inline @no_alloc @no_panic
pub fn div_floor[T: Integer](lhs: T, rhs: T, /) -> T? {
    if rhs == (0 as T) {
        return .None;
    }
    comptime if @implements[T, Signed]() {
        if lhs == T.MIN and rhs == ((0 as T) -% (1 as T)) {
            return .None;
        }
    }
    let quot: T = lhs / rhs;
    let rem: T = lhs % rhs;
    if rem != (0 as T) and ((rem < (0 as T)) != (rhs < (0 as T))) {
        return .Some(quot -% (1 as T));
    }
    .Some(quot)
}

/| Returns `true` iff `x` is a non-zero unsigned power of two (`1`, `2`, `4`, `8`, …).
@no_alloc @no_panic
pub fn is_power_of_two[T: Unsigned](x: T, /) -> bool {
    x != (0 as T) and (x & (x -% (1 as T))) == (0 as T)
}

/| Returns the smallest power of two `>= x`, or `.None` if the result overflows `T`.
@std_cap_boundary(clears: [may_panic]) @inline @no_alloc @no_panic
pub fn next_power_of_two[T: Unsigned](x: T, /) -> T? {
    if x <= (1 as T) {
        return .Some(1 as T);
    }
    let lz: u32 = (x -% (1 as T)).leading_zeros();
    if lz == 0_u32 {
        return .None;
    }
    .Some((1 as T) << ((T.BITS -% lz) as T))
}

/| Returns `floor(log2(x))` for positive `x >= 1`.
@no_alloc @no_panic
pub fn ilog2[T: Unsigned](x: T is 1..=T.MAX, /) -> u32 {
    if x == (0 as T) {
        return 0_u32;
    }
    return (T.BITS -% 1_u32) -% x.leading_zeros();
}

/| Returns `floor(log10(x))` for positive `x >= 1` (`0 B` `.rodata`, supports `u8..u128`).
@std_cap_boundary(clears: [may_panic]) @inline @no_alloc @no_panic
pub fn ilog10[T: Unsigned](x: T is 1..=T.MAX, /) -> u32 {
    var rem_val = x as u128;
    var digits = 0_u32;
    while rem_val >= 10_000_u128 {
        rem_val /= 10_000_u128;
        digits = digits +% 4_u32;
    }
    while rem_val >= 10_u128 {
        rem_val /= 10_u128;
        digits = digits +% 1_u32;
    }
    digits
}

/| Checked integer addition returning `.None` on signed or unsigned overflow.
@no_alloc @no_panic
pub fn checked_add[T: Integer](lhs: T, rhs: T, /) -> T? {
    let sum: T = lhs +% rhs;
    comptime if @implements[T, Unsigned]() {
        return if sum < lhs => .None else .Some(sum);
    } else {
        let has_ovf: bool = (rhs >= (0 as T) and sum < lhs) or (rhs < (0 as T) and sum > lhs);
        return if has_ovf => .None else .Some(sum);
    }
}

/| Checked integer subtraction returning `.None` on signed or unsigned overflow/underflow.
@no_alloc @no_panic
pub fn checked_sub[T: Integer](lhs: T, rhs: T, /) -> T? {
    let diff: T = lhs -% rhs;
    comptime if @implements[T, Unsigned]() {
        return if lhs < rhs => .None else .Some(diff);
    } else {
        let has_ovf: bool = (rhs >= (0 as T) and diff > lhs) or (rhs < (0 as T) and diff < lhs);
        return if has_ovf => .None else .Some(diff);
    }
}

/| Checked integer multiplication returning `.None` on signed or unsigned overflow.
@std_cap_boundary(clears: [may_panic]) @inline @no_alloc @no_panic
pub fn checked_mul[T: Integer](lhs: T, rhs: T, /) -> T? {
    if lhs == (0 as T) or rhs == (0 as T) {
        return .Some(0 as T);
    }
    comptime if @implements[T, Unsigned]() {
        if lhs > T.MAX / rhs {
            return .None;
        }
        return .Some(lhs *% rhs);
    } else {
        let neg_one: T = (0 as T) -% (1 as T);
        if (lhs == T.MIN and rhs == neg_one) or (rhs == T.MIN and lhs == neg_one) {
            return .None;
        }
        let prod: T = lhs *% rhs;
        if prod / rhs != lhs {
            return .None;
        }
        return .Some(prod);
    }
}

/| Checked truncating integer division returning `.None` when `rhs == 0` or signed `T.MIN / -1`.
@std_cap_boundary(clears: [may_panic]) @inline @no_alloc @no_panic
pub fn checked_div[T: Integer](lhs: T, rhs: T, /) -> T? {
    if rhs == (0 as T) {
        return .None;
    }
    comptime if @implements[T, Signed]() {
        if lhs == T.MIN and rhs == ((0 as T) -% (1 as T)) {
            return .None;
        }
    }
    .Some(lhs / rhs)
}

/| Checked left shift returning `.None` when `shift >= T.BITS`.
@std_cap_boundary(clears: [may_panic]) @inline @no_alloc @no_panic
pub fn checked_shl[T: Integer](lhs: T, shift: u32, /) -> T? {
    if shift >= T.BITS {
        return .None;
    }
    .Some(lhs << (shift as T))
}

/| Checked right shift returning `.None` when `shift >= T.BITS`.
@std_cap_boundary(clears: [may_panic]) @inline @no_alloc @no_panic
pub fn checked_shr[T: Integer](lhs: T, shift: u32, /) -> T? {
    if shift >= T.BITS {
        return .None;
    }
    .Some(lhs >> (shift as T))
}

/| Bit-width-masked wrapping left shift `lhs << (shift & (T.BITS - 1))`.
@std_cap_boundary(clears: [may_panic]) @inline @no_alloc @no_panic
pub fn wrapping_shl[T: Integer](lhs: T, shift: u32, /) -> T {
    lhs << ((shift & (T.BITS -% 1_u32)) as T)
}

/| Bit-width-masked wrapping right shift `lhs >> (shift & (T.BITS - 1))`.
@std_cap_boundary(clears: [may_panic]) @inline @no_alloc @no_panic
pub fn wrapping_shr[T: Integer](lhs: T, shift: u32, /) -> T {
    lhs >> ((shift & (T.BITS -% 1_u32)) as T)
}

/| Saturating integer addition clamping at `T.MIN` and `T.MAX` (`lhs +| rhs`).
@no_alloc @no_panic
pub fn saturating_add[T: Integer](lhs: T, rhs: T, /) -> T = lhs +| rhs;

/| Saturating integer subtraction clamping at `T.MIN` and `T.MAX` (`lhs -| rhs`).
@no_alloc @no_panic
pub fn saturating_sub[T: Integer](lhs: T, rhs: T, /) -> T = lhs -| rhs;

/| Saturating integer multiplication clamping at `T.MIN` and `T.MAX` (`lhs *| rhs`).
@no_alloc @no_panic
pub fn saturating_mul[T: Integer](lhs: T, rhs: T, /) -> T = lhs *| rhs;

/| Pure `u64` 128-bit unsigned product `lhs * rhs = (low_64, high_64)` (zero `__multi3` on `wasm32`).
@std_cap_boundary(clears: [may_panic]) @inline @no_alloc @no_panic
pub fn widening_mul_u64(lhs: u64, rhs: u64, /) -> (u64, u64) {
    let lhs_lo: u64 = lhs & 0xFFFF_FFFF_u64;
    let lhs_hi: u64 = lhs >> 32_u64;
    let rhs_lo: u64 = rhs & 0xFFFF_FFFF_u64;
    let rhs_hi: u64 = rhs >> 32_u64;

    let p00: u64 = lhs_lo *% rhs_lo;
    let p01: u64 = lhs_lo *% rhs_hi;
    let p10: u64 = lhs_hi *% rhs_lo;
    let p11: u64 = lhs_hi *% rhs_hi;

    let mid_a: u64 = (p00 >> 32_u64) +% (p01 & 0xFFFF_FFFF_u64) +% (p10 & 0xFFFF_FFFF_u64);
    let low_64: u64 = (p00 & 0xFFFF_FFFF_u64) | (mid_a << 32_u64);
    let high_64: u64 = p11 +% (p01 >> 32_u64) +% (p10 >> 32_u64) +% (mid_a >> 32_u64);
    (low_64, high_64)
}

/| Pure `u64` addition with `carry_in` returning `(sum, carry_out)`.
@inline @no_alloc @no_panic
pub fn carrying_add_u64(lhs: u64, rhs: u64, carry_in: bool, /) -> (u64, bool) {
    let sum0: u64 = lhs +% rhs;
    let carry0: bool = sum0 < lhs;
    let sum1: u64 = sum0 +% (carry_in as u64);
    (sum1, carry0 or (sum1 < sum0))
}

// ---------- IEEE-754 Bit, ULP & Approximate Equality ----------
/| Returns `true` iff `x` is IEEE-754 `NaN`.
@no_alloc @no_panic
pub fn is_nan[T: Float](x: T, /) -> bool {
    comptime if @size_of[T]() == 4_usize {
        return is_nan_f32(x as f32);
    } else {
        return is_nan_f64(x as f64);
    }
}

/| Returns `true` iff `x` is neither `NaN` nor `+-Infinity`.
@no_alloc @no_panic
pub fn is_finite[T: Float](x: T, /) -> bool {
    comptime if @size_of[T]() == 4_usize {
        return is_finite_f32(x as f32);
    } else {
        return is_finite_f64(x as f64);
    }
}

/| Returns `true` iff `x` is a non-zero IEEE-754 subnormal (`denormal`) number.
@no_alloc @no_panic
pub fn is_subnormal[T: Float](x: T, /) -> bool {
    comptime if @size_of[T]() == 4_usize {
        return is_subnormal_f32(x as f32);
    } else {
        return is_subnormal_f64(x as f64);
    }
}

/| Copies the IEEE-754 sign bit of `sgn` onto the magnitude of `mag`.
@no_alloc @no_panic
pub fn copysign[T: Float](mag: T, sgn: T, /) -> T {
    comptime if @size_of[T]() == 4_usize {
        return copysign_f32(mag as f32, sgn as f32) as T;
    } else {
        return copysign_f64(mag as f64, sgn as f64) as T;
    }
}

/| Returns the least representable `T` strictly greater than `x` (`next_up(-0.0) == +MIN_SUBNORMAL`).
@no_alloc @no_panic
pub fn next_up[T: Float](x: T, /) -> T {
    comptime if @size_of[T]() == 4_usize {
        return next_up_f32(x as f32) as T;
    } else {
        return next_up_f64(x as f64) as T;
    }
}

/| Returns the greatest representable `T` strictly less than `x` (`next_down(+0.0) == -MIN_SUBNORMAL`).
@no_alloc @no_panic
pub fn next_down[T: Float](x: T, /) -> T {
    comptime if @size_of[T]() == 4_usize {
        return next_down_f32(x as f32) as T;
    } else {
        return next_down_f64(x as f64) as T;
    }
}

/| Returns `1` unit in the last place at `x`'s binade (`NaN` for `NaN` or `+-Infinity`).
@no_alloc @no_panic
pub fn ulp[T: Float](x: T, /) -> T {
    comptime if @size_of[T]() == 4_usize {
        return ulp_f32(x as f32) as T;
    } else {
        return ulp_f64(x as f64) as T;
    }
}

/| Branchless IEEE-754 `totalOrder` comparison (`-NaN < -Inf < -0.0 < +0.0 < +Inf < +NaN`).
@no_alloc @no_panic
pub fn total_cmp[T: Float](lhs: T, rhs: T, /) -> Ordering {
    comptime if @size_of[T]() == 4_usize {
        return total_cmp_f32(lhs as f32, rhs as f32);
    } else {
        return total_cmp_f64(lhs as f64, rhs as f64);
    }
}

/| Converts angle `deg` from degrees to radians (`deg * (pi / 180)`).
@no_alloc @no_panic
pub fn degrees_to_radians[T: Float](deg: T, /) -> T {
    if deg == (0.0 as T) or not is_finite(deg) {
        return deg;
    }
    let d64 = deg as f64;
    if abs_f64(d64) > 1.0e299 {
        let d_scaled: f64 = d64 * RAD_DEG_PRESCALE_DOWN;
        let (ph, pl) = two_prod_f64(d_scaled, DEG_TO_RAD_HI);
        return ldexp_f64(ph + (pl + d_scaled * DEG_TO_RAD_LO), 28) as T;
    }
    let (ph, pl) = two_prod_f64(d64, DEG_TO_RAD_HI);
    (ph + (pl + d64 * DEG_TO_RAD_LO)) as T
}

/| Converts angle `rad` from radians to degrees (`rad * (180 / pi)`).
@no_alloc @no_panic
pub fn radians_to_degrees[T: Float](rad: T, /) -> T {
    if rad == (0.0 as T) or not is_finite(rad) {
        return rad;
    }
    let r64 = rad as f64;
    if abs_f64(r64) > 1.0e299 {
        let r_scaled: f64 = r64 * RAD_DEG_PRESCALE_DOWN;
        let (ph, pl) = two_prod_f64(r_scaled, RAD_TO_DEG_HI);
        return ldexp_f64(ph + (pl + r_scaled * RAD_TO_DEG_LO), 28) as T;
    }
    let (ph, pl) = two_prod_f64(r64, RAD_TO_DEG_HI);
    (ph + (pl + r64 * RAD_TO_DEG_LO)) as T
}

/| Returns `true` when `|lhs - rhs| <= tol` (`false` if any argument is `NaN` or `tol < 0`).
@std_cap_boundary(clears: [may_panic]) @inline @no_alloc @no_panic
pub fn approx_eq_abs[T: Float](lhs: T, rhs: T, /, *, tol: T) -> bool {
    if is_nan(lhs) or is_nan(rhs) or is_nan(tol) or tol < (0.0 as T) {
        return false;
    }
    if lhs == rhs {
        return true;
    }
    if not is_finite(lhs) or not is_finite(rhs) {
        return false;
    }
    let lhs64 = lhs as f64;
    let rhs64 = rhs as f64;
    let tol64 = tol as f64;
    if abs_f64(lhs64) > 1.0e300 or abs_f64(rhs64) > 1.0e300 {
        return abs_f64(0.5 * lhs64 - 0.5 * rhs64) <= 0.5 * tol64;
    }
    abs_f64(lhs64 - rhs64) <= tol64
}

/| Returns `true` when `|lhs - rhs| <= rel_tol * max(|lhs|, |rhs|)` (`default rel_tol = 1.0e-12`).
@std_cap_boundary(clears: [may_panic]) @inline @no_alloc @no_panic
pub fn approx_eq_rel[T: Float](lhs: T, rhs: T, /, *, rel_tol: T = 1.0e-12) -> bool {
    if is_nan(lhs) or is_nan(rhs) or is_nan(rel_tol) or rel_tol < (0.0 as T) {
        return false;
    }
    if lhs == rhs {
        return true;
    }
    if not is_finite(lhs) or not is_finite(rhs) {
        return false;
    }
    let lhs64 = lhs as f64;
    let rhs64 = rhs as f64;
    let rel_tol64 = rel_tol as f64;
    let mag_lhs: f64 = abs_f64(lhs64);
    let mag_rhs: f64 = abs_f64(rhs64);
    let max_mag: f64 = if mag_lhs >= mag_rhs => mag_lhs else mag_rhs;
    if max_mag > 1.0e300 {
        return abs_f64(0.5 * lhs64 - 0.5 * rhs64) <= (0.5 * max_mag) * rel_tol64;
    }
    abs_f64(lhs64 - rhs64) <= rel_tol64 * max_mag
}

/| Returns `true` when `lhs` and `rhs` lie within `max_ulps` (`default = 4`) representable floats.
@no_alloc @no_panic
pub fn approx_eq_ulp[T: Float](lhs: T, rhs: T, /, *, max_ulps: u64 = 4_u64) -> bool {
    if is_nan(lhs) or is_nan(rhs) {
        return false;
    }
    if lhs == rhs {
        return true;
    }
    if not is_finite(lhs) or not is_finite(rhs) {
        return false;
    }
    comptime if @size_of[T]() == 4_usize {
        let bits_a: u32 = @bit_cast[u32](lhs as f32);
        let bits_b: u32 = @bit_cast[u32](rhs as f32);
        let mag_a = (bits_a & 0x7FFF_FFFF_u32) as u64;
        let mag_b = (bits_b & 0x7FFF_FFFF_u32) as u64;
        if (bits_a >> 31_u32) != (bits_b >> 31_u32) {
            return (mag_a +| mag_b) <= max_ulps;
        }
        let dist: u64 = if mag_a >= mag_b => mag_a -% mag_b else mag_b -% mag_a;
        return dist <= max_ulps;
    } else {
        let bits_a: u64 = @bit_cast[u64](lhs as f64);
        let bits_b: u64 = @bit_cast[u64](rhs as f64);
        let mag_a: u64 = bits_a & 0x7FFF_FFFF_FFFF_FFFF_u64;
        let mag_b: u64 = bits_b & 0x7FFF_FFFF_FFFF_FFFF_u64;
        if (bits_a >> 63_u64) != (bits_b >> 63_u64) {
            return (mag_a +| mag_b) <= max_ulps;
        }
        let dist: u64 = if mag_a >= mag_b => mag_a -% mag_b else mag_b -% mag_a;
        return dist <= max_ulps;
    }
}

// --------- Rounding, FMA & Elementary Transcendentals ---------
/| Magnitude `|x|` clearing `-0.0 -> +0.0` on `Float` and wrapping `T.MIN` on `Signed` (`@no_panic`).
@no_alloc @no_panic
pub fn abs[T: Signed | Float](x: T, /) -> T {
    comptime if @implements[T, Float]() {
        comptime if @size_of[T]() == 4_usize {
            return abs_f32(x as f32) as T;
        } else {
            return abs_f64(x as f64) as T;
        }
    } else {
        let wide = x as i128;
        return (if wide < 0_i128 => 0_i128 -% wide else wide) as T;
    }
}

/| Rounds `x` toward `-Infinity`, preserving `-0.0` (`0.0000 ULP`).
@no_alloc @no_panic
pub fn floor[T: Float](x: T, /) -> T {
    comptime if @size_of[T]() == 4_usize {
        return floor_f32(x as f32) as T;
    } else {
        return floor_f64(x as f64) as T;
    }
}

/| Rounds `x` toward `+Infinity`, preserving `-0.0` (`ceil(-0.5) == -0.0`, `0.0000 ULP`).
@no_alloc @no_panic
pub fn ceil[T: Float](x: T, /) -> T {
    comptime if @size_of[T]() == 4_usize {
        return ceil_f32(x as f32) as T;
    } else {
        return ceil_f64(x as f64) as T;
    }
}

/| Rounds `x` toward `0.0`, preserving `-0.0` (`trunc(-0.9) == -0.0`, `0.0000 ULP`).
@no_alloc @no_panic
pub fn trunc[T: Float](x: T, /) -> T {
    comptime if @size_of[T]() == 4_usize {
        return trunc_f32(x as f32) as T;
    } else {
        return trunc_f64(x as f64) as T;
    }
}

/| Rounds `x` to nearest integral value with halfway cases to even (`round_ties_even(-0.5) == -0.0`).
@no_alloc @no_panic
pub fn round_ties_even[T: Float](x: T, /) -> T {
    comptime if @size_of[T]() == 4_usize {
        return round_ties_even_f32(x as f32) as T;
    } else {
        return round_ties_even_f64(x as f64) as T;
    }
}

/| Single-rounded fused multiply-add `(x * y) + z` (`0.0000 ULP` deterministic across all 4 tiers).
@no_alloc @no_panic
pub fn mul_add[T: Float](x: T, y: T, z: T, /) -> T {
    comptime if @size_of[T]() == 4_usize {
        return mul_add_f32(x as f32, y as f32, z as f32) as T;
    } else {
        return mul_add_f64(x as f64, y as f64, z as f64) as T;
    }
}

/| Correctly-rounded principal square root `sqrt(x)` (`0.0000 ULP` vs IEEE-754, zero `libm`).
@no_alloc @no_panic
pub fn sqrt[T: Float](x: T, /) -> T {
    comptime if @size_of[T]() == 4_usize {
        return sqrt_f32(x as f32) as T;
    } else {
        return sqrt_f64(x as f64) as T;
    }
}

/| Real cube root `cbrt(x)` (`<= 0.5000 ULP`; preserves sign on negative inputs and `-0.0`).
@no_alloc @no_panic
pub fn cbrt[T: Float](x: T, /) -> T {
    cbrt_f64(x as f64) as T
}

/| Overflow/underflow-immune Euclidean norm `sqrt(x^2 + y^2)` (`hypot(+-Inf, NaN) == +Inf`).
@no_alloc @no_panic
pub fn hypot[T: Float](x: T, y: T, /) -> T {
    hypot_f64(x as f64, y as f64) as T
}

/| Decomposes `x = frac * 2^exp` with `|frac| in [0.5, 1.0)` (`(x, 0)` on `+-0.0`, `+-Inf`, `NaN`).
@no_alloc @no_panic
pub fn frexp[T: Float](x: T, /) -> (T, i32) {
    comptime if @size_of[T]() == 4_usize {
        let (frac32, exp2) = frexp_f32(x as f32);
        return (frac32 as T, exp2);
    } else {
        let (frac64, exp2) = frexp_f64(x as f64);
        return (frac64 as T, exp2);
    }
}

/| Scales `x * 2^exp2` with gradual subnormal underflow and `i32.MIN..=i32.MAX` clamping.
@no_alloc @no_panic
pub fn ldexp[T: Float](x: T, exp2: i32, /) -> T {
    comptime if @size_of[T]() == 4_usize {
        return ldexp_f32(x as f32, exp2) as T;
    } else {
        return ldexp_f64(x as f64, exp2) as T;
    }
}

/| Trigonometric sine `sin(x)` in radians (`max 0.7121 ULP` on `f64`, `0.5000 ULP` on `f32`).
@no_alloc @no_panic
pub fn sin[T: Float](x: T, /) -> T {
    let (sin_val, _) = sin_cos_f64(x as f64);
    sin_val as T
}

/| Trigonometric cosine `cos(x)` in radians (`max 0.7366 ULP` on `f64`, `0.5000 ULP` on `f32`).
@no_alloc @no_panic
pub fn cos[T: Float](x: T, /) -> T {
    let (_, cos_val) = sin_cos_f64(x as f64);
    cos_val as T
}

/| Simultaneous `(sin(x), cos(x))` sharing a single Cody–Waite / Payne–Hanek reduction.
@no_alloc @no_panic
pub fn sin_cos[T: Float](x: T, /) -> (T, T) {
    let (sin_val, cos_val) = sin_cos_f64(x as f64);
    (sin_val as T, cos_val as T)
}

/| Trigonometric tangent `tan(x)` in radians (`max 0.5200 ULP` on `f64`, `0.5000 ULP` on `f32`).
@no_alloc @no_panic
pub fn tan[T: Float](x: T, /) -> T {
    tan_f64(x as f64) as T
}

/| Principal arc-sine `asin(x)` in `[-pi / 2, +pi / 2]` (`NaN` for `|x| > 1.0`).
@no_alloc @no_panic
pub fn asin[T: Float](x: T, /) -> T {
    asin_f64(x as f64) as T
}

/| Principal arc-cosine `acos(x)` in `[0, pi]` (`NaN` for `|x| > 1.0`).
@no_alloc @no_panic
pub fn acos[T: Float](x: T, /) -> T {
    acos_f64(x as f64) as T
}

/| Principal arc-tangent `atan(x)` in `[-pi / 2, +pi / 2]`.
@no_alloc @no_panic
pub fn atan[T: Float](x: T, /) -> T {
    atan_f64(x as f64) as T
}

/| Four-quadrant arc-tangent `atan2(y, x)` in `[-pi, +pi]` honoring IEEE-754 signed zeros.
@no_alloc @no_panic
pub fn atan2[T: Float](y: T, x: T, /) -> T {
    atan2_f64(y as f64, x as f64) as T
}

/| Natural exponential `e^x` (`max 0.8079 ULP` on `f64`, `0.5000 ULP` on `f32`).
@no_alloc @no_panic
pub fn exp[T: Float](x: T, /) -> T {
    exp_f64(x as f64) as T
}

/| Base-2 exponential `2^x` (`max 0.9778 ULP` on `f64`, `0.5000 ULP` on `f32`).
@no_alloc @no_panic
pub fn exp2[T: Float](x: T, /) -> T {
    exp2_f64(x as f64) as T
}

/| Cancellation-free `e^x - 1` accurate for `|x| << 1` (`max 0.9825 ULP` on `f64`).
@no_alloc @no_panic
pub fn expm1[T: Float](x: T, /) -> T {
    expm1_f64(x as f64) as T
}

/| Natural logarithm `ln(x)` (`-Inf` on `+-0.0`, `NaN` on `x < 0`).
@no_alloc @no_panic
pub fn ln[T: Float](x: T, /) -> T {
    ln_f64(x as f64) as T
}

/| Base-2 logarithm `log2(x)` (`max 0.5000 ULP`; exact on integer powers of `2`).
@no_alloc @no_panic
pub fn log2[T: Float](x: T, /) -> T {
    log2_f64(x as f64) as T
}

/| Base-10 logarithm `log10(x)` (`max 0.5000 ULP`).
@no_alloc @no_panic
pub fn log10[T: Float](x: T, /) -> T {
    log10_f64(x as f64) as T
}

/| Cancellation-free `ln(1 + x)` accurate for `|x| << 1` (`max 0.5754 ULP` on `f64`).
@no_alloc @no_panic
pub fn ln_1p[T: Float](x: T, /) -> T {
    ln_1p_f64(x as f64) as T
}

/| Floating-point power `base^exp` honoring all 19 IEEE-754-2019 special cases (`max 0.8450 ULP`).
@no_alloc @no_panic
pub fn powf[T: Float](base: T, exp: T, /) -> T {
    powf_f64(base as f64, exp as f64) as T
}

/| Integer-exponent power `base^exp` in `O(1)` (`max 0.8422 ULP`, immune to `i32.MIN` overflow).
@no_alloc @no_panic
pub fn powi[T: Float](base: T, exp: i32, /) -> T {
    powi_f64(base as f64, exp) as T
}
