pub const LOCKFILE_FAIL_IMMEDIATELY: u32 = 0x0000_0001;

/| `LockFileEx` request exclusive write lock (`0x0000_0002`).
pub const LOCKFILE_EXCLUSIVE_LOCK: u32 = 0x0000_0002;

/| `ReadDirectoryChangesW` notify on file creation/rename/deletion (`0x0000_0001`).
pub const FILE_NOTIFY_CHANGE_FILE_NAME: u32 = 0x0000_0001;

/| `ReadDirectoryChangesW` notify on directory creation/rename/deletion (`0x0000_0002`).
pub const FILE_NOTIFY_CHANGE_DIR_NAME: u32 = 0x0000_0002;

/| `ReadDirectoryChangesW` notify on attribute change (`0x0000_0004`).
pub const FILE_NOTIFY_CHANGE_ATTRIBUTES: u32 = 0x0000_0004;

/| `ReadDirectoryChangesW` notify on size change (`0x0000_0008`).
pub const FILE_NOTIFY_CHANGE_SIZE: u32 = 0x0000_0008;

/| `ReadDirectoryChangesW` notify on last-write timestamp update (`0x0000_0010`).
pub const FILE_NOTIFY_CHANGE_LAST_WRITE: u32 = 0x0000_0010;

/| `FILE_NOTIFY_INFORMATION` file created (`1`).
pub const FILE_ACTION_ADDED: u32 = 1;

/| `FILE_NOTIFY_INFORMATION` file deleted (`2`).
pub const FILE_ACTION_REMOVED: u32 = 2;

/| `FILE_NOTIFY_INFORMATION` file modified (`3`).
pub const FILE_ACTION_MODIFIED: u32 = 3;

/| `FILE_NOTIFY_INFORMATION` rename source name (`4`).
