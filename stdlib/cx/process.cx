/# Injection-Hardened Child Process Spawning, Pipes, and Exit Status (cx.process)
/#
/# Provides `@linear` child process handles (`ChildProcess`, `ChildStdin`, `ChildStdout`, `Stdio`),
/# deadlock-free concurrent pipe draining, `ExitStatus` decoding, and `BatBadBut`-hardened `Command`
/# builders across Windows (`CreateProcessW`), Linux/macOS (`posix_spawn`), and WASI (`STD-02` §2.6).
/#
/# Implicit `.bat`/`.cmd` execution is rejected fail-closed (`CVE-2024-24576`) unless opted in via
/# `Command.cmd_script`, and Windows handle inheritance allowlists only deduplicated stdio handles.

use core.async.{
    IoSubmission,
    SIM_OP_PROC_OP,
    SIM_UNHANDLED_SENTINEL,
};
use core.sys;
use cx.col.Vec;
use cx.fs.{File, RawOsFd};
use cx.io.{IoError, IoOp, OutBuf, Reader, Writer};
use cx.path.{Path, PathBuf, encode_wtf8_to_wtf16};
use cx.str.String;

// ---------------------------------------- TYPES ----------------------------------------
// --------------------- Stdio & ExitStatus ---------------------
/| C-ABI callback signature for `ReactorVTable.submit_io` (`slot 3` inside `context.reactor`).
type ReactorSubmitFn = extern "C" fn(*mut opaque, *IoSubmission) -> i64;

/| Child standard-stream attachment mode (`STD-02` §2.6).
@derive(Copy, Equatable, Hash, Clone, Debug)
pub enum StdioKind: u8 {
    /| Inherit the parent process's corresponding standard stream (`0`).
    Inherit = 0,
    /| Create a unidirectional OS pipe between parent and child (`1`).
    Piped = 1,
    /| Attach the child stream to the OS null device (`NUL` / `/dev/null`, `2`).
    Null = 2,
    /| Transfer an owned `File` descriptor into the child stream (`3`).
    Fd = 3,
}

/| `@linear` child standard-stream configuration preventing leaked `.Fd` descriptors (`STD-02` §2.6).
@linear
pub struct Stdio {
    /| Selected stream attachment mode.
    pub(pkg) kind: StdioKind,
    /| Owned OS file descriptor or `HANDLE` when `kind == .Fd` (invalid sentinel otherwise).
    @expect(unused-pkg-visibility, reason: "inspected by cx.test SimReactor and process tests")
    pub(pkg) owned_fd: RawOsFd,
}

/| Internal `AutoDrop` wrapper holding a configured `Stdio` slot inside `Command` prior to `spawn`.
struct OwnedStdioSlot {
    /| Selected stream attachment mode.
    kind: StdioKind,
    /| Owned OS descriptor closed automatically if `Command` drops before spawning.
    owned_fd: RawOsFd,
}

/| Single environment variable mutation queued on a `Command` builder.
struct EnvOverride {
    /| Environment variable name (`UTF-8`, without `'='` or NUL bytes).
    key: String,
    /| Replacement value when `.Some(val)`, or `.None` to unset `key` in the child environment.
    val: String?,
}

/| Decoded child process termination status (`waitpid` `wstatus` on POSIX, exit `DWORD` on Windows).
@repr(C) @derive(Copy, Equatable, Hash)
pub struct ExitStatus {
    /| Raw platform status word (`waitpid` bitmask on Linux/macOS; 32-bit exit code on Windows/WASI).
    raw_status: i32,
}

/| Captured exit status and standard output/error byte buffers returned by `wait_with_output` (`STD-02` §2.6).
pub struct Output {
    /| Final process exit status or terminating signal.
    pub status: ExitStatus,
    /| Captured standard output bytes.
    pub stdout: Vec[u8],
    /| Captured standard error bytes.
    pub stderr: Vec[u8],
}

// ------------------ Child Handles & Command -------------------
/| `@linear` writable pipe connected to a spawned child process's standard input (`fd 0`).
@linear
pub struct ChildStdin {
    /| Underlying OS pipe write handle.
    file: File,
}

/| `@linear` readable pipe connected to a spawned child process's standard output (`fd 1`) or error (`fd 2`).
@linear
pub struct ChildStdout {
    /| Underlying OS pipe read handle.
    file: File,
}

/| `@linear` readable pipe alias connected to a spawned child process's standard error (`fd 2`).
pub type ChildStderr = ChildStdout;

/| `@linear` handle to a running or exited child process requiring explicit reap or detach (`E0304`).
@linear
pub struct ChildProcess {
    /| OS or simulated child process identifier (`PID`).
    pub pid: u32,
    /| Process `HANDLE` on Windows (invalid sentinel `-1` on POSIX/WASI).
    os_handle: RawOsFd,
    /| Optional parent-writable pipe attached to child `stdin` (`.Some` when `Stdio.piped()`).
    pub stdin: ChildStdin?,
    /| Optional parent-readable pipe attached to child `stdout` (`.Some` when `Stdio.piped()`).
    pub stdout: ChildStdout?,
    /| Optional parent-readable pipe attached to child `stderr` (`.Some` when `Stdio.piped()`).
    pub stderr: ChildStderr?,
    /| Cached `ExitStatus` once `try_wait` observes process exit (preventing `ECHILD` double-wait).
    reaped_status: ExitStatus?,
    /| `true` when spawned through `context.reactor` (`SimReactor`) rather than the host kernel.
    is_sim_child: bool,
}

/| Injection-hardened child process builder (`AutoDrop`; rejects implicit `.bat`/`.cmd` per `CVE-2024-24576`).
pub struct Command {
    /| Target executable path/name (or batch script path when `allow_windows_batch` is `true`).
    program_path: PathBuf,
    /| Ordered command-line arguments excluding `argv[0]`.
    arg_list: Vec[PathBuf],
    /| Ordered environment variable additions, replacements, and removals.
    env_list: Vec[EnvOverride],
    /| Optional working directory for the child process.
    cwd_path: PathBuf?,
    /| Child `stdin` attachment configuration.
    stdin_slot: OwnedStdioSlot,
    /| Child `stdout` attachment configuration.
    stdout_slot: OwnedStdioSlot,
    /| Child `stderr` attachment configuration.
    stderr_slot: OwnedStdioSlot,
    /| `true` when `env_clear()` was called to start from an empty environment block.
    env_clear_all: bool,
    /| `true` only when constructed via `Command.cmd_script` (`false` blocks `.bat`/`.cmd` targets).
    allow_windows_batch: bool,
    /| `true` when `Command.new` detected a `.bat` or `.cmd` extension on `program_path`.
    has_rejected_script_ext: bool,
}

// -------------------- SimReactor Protocol ---------------------
/| `@repr(C)` spawn payload passed via `IoSubmission.buf_ptr` for `SIM_OP_PROC_OP` (`PROC_SIM_SPAWN`).
@repr(C)
struct SimProcSpawnPayload {
    /| Pointer to UTF-8 / WTF-8 `program` bytes.
    program_ptr: *u8,
    /| Byte length of `program_ptr`.
    program_len: usize,
    /| Pointer to optional working directory bytes (`null` when `cwd` is `.None`).
    cwd_ptr: *u8,
    /| Byte length of `cwd_ptr` (`0` when `cwd` is `.None`).
    cwd_len: usize,
    /| Number of command-line arguments in `Command.args`.
    arg_count: u32,
    /| Encoded `StdioKind` for `stdin` (`0..=3`).
    stdin_kind: u8,
    /| Encoded `StdioKind` for `stdout` (`0..=3`).
    stdout_kind: u8,
    /| Encoded `StdioKind` for `stderr` (`0..=3`).
    stderr_kind: u8,
    /| `1` when constructed via `Command.cmd_script`, `0` otherwise.
    is_cmd_script: u8,
    /| Populated by `SimReactor` with the virtual child PID on success.
    out_pid: u32,
    /| Populated by `SimReactor` with virtual parent `stdin` write fd (`-1` when none).
    out_stdin_fd: i32,
    /| Populated by `SimReactor` with virtual parent `stdout` read fd (`-1` when none).
    out_stdout_fd: i32,
    /| Populated by `SimReactor` with virtual parent `stderr` read fd (`-1` when none).
    out_stderr_fd: i32,
}

/| Windows `FSCTL_PIPE_PEEK` (`FILE_PIPE_PEEK_BUFFER`) header + 16-byte sample buffer (`32 B`).
@cfg(target.os == "windows") @repr(C)
struct Win32PipePeekBuf {
    /| Pipe state flags (`NamedPipeState`).
    pipe_state: u32,
    /| Total unread bytes queued in the kernel pipe buffer (`ReadDataAvailable`).
    read_data_available: u32,
    /| Number of queued messages (`NumberOfMessages`).
    message_count: u32,
    /| Head message byte length (`MessageLength`).
    message_length: u32,
    /| First 8 bytes of the trailing 16-byte sample window.
    sample_lo: u64,
    /| Second 8 bytes of the trailing 16-byte sample window.
    sample_hi: u64,
}

// --------------------------------------- CONSTS ----------------------------------------
// --------------------- Platform Constants ---------------------
/| Default `wait_with_output` / `Command.output` combined pipe capture ceiling (`64 MiB`).
pub const DEFAULT_MAX_OUTPUT_BYTES: usize = 67_108_864;

/| Stack read chunk size used when draining child `stdout` and `stderr` pipes (`8 KiB`).
const PIPE_READ_CHUNK_BYTES: usize = 8_192;

/| `SIM_OP_PROC_OP` sub-opcode for `Command.spawn` (`0`).
const PROC_SIM_SPAWN: u8 = 0;

/| `SIM_OP_PROC_OP` sub-opcode for blocking `ChildProcess.wait` (`1`).
const PROC_SIM_WAIT: u8 = 1;

/| `SIM_OP_PROC_OP` sub-opcode for non-blocking `ChildProcess.try_wait` (`2`).
const PROC_SIM_TRY_WAIT: u8 = 2;

/| `SIM_OP_PROC_OP` sub-opcode for `ChildProcess.kill_and_wait` (`3`).
const PROC_SIM_KILL_WAIT: u8 = 3;

/| `SIM_OP_PROC_OP` sub-opcode for `ChildProcess.detach` (`4`).
const PROC_SIM_DETACH: u8 = 4;

/| `SIM_OP_PROC_OP` sub-opcode for `cx.process.exit` (`5`).
const PROC_SIM_EXIT: u8 = 5;

/| Return value from `SimReactor` `PROC_SIM_TRY_WAIT` indicating the virtual child is still running.
const PROC_SIM_STILL_RUNNING: i64 = 0x1_0000_0000;

/| UTF-16 `%%cd:~,%` sequence neutralizing `%` expansion in `cmd.exe /d /v:off /e:on /c`.
const CMD_PERCENT_ESCAPE_UTF16: [u16; 8] = [
    0x0025,
    0x0025,
    0x0063,
    0x0064,
    0x003A,
    0x007E,
    0x002C,
    0x0025,
];

/| UTF-16 `/d /v:off /e:on /c "` prefix passed to `cmd.exe` in `Command.cmd_script`.
const CMD_SCRIPT_SWITCHES_UTF16: [u16; 20] = [
    0x002F, 0x0064, 0x0020, 0x002F, 0x0076, 0x003A, 0x006F, 0x0066,
    0x0066, 0x0020, 0x002F, 0x0065, 0x003A, 0x006F, 0x006E, 0x0020,
    0x002F, 0x0063, 0x0020, 0x0022,
];

/| `O(1)` ASCII `0..63` bitset for MSVCRT quote triggers (`\t`, `\n`, `\v`, `\r`, `' '`, `'"'`).
const MSVCRT_QUOTE_LO_MASK: u64 = 0x0000_0005_0000_2E00;

/| `O(1)` ASCII `0..63` bitset for `cmd.exe` metacharacters (`!`, `&`, `(`, `)`, `<`, `>`).
const CMD_METACHAR_LO_MASK: u64 = 0x5000_0342_0000_0000;

/| `O(1)` ASCII `64..127` bitset for `cmd.exe` metacharacters (`^` at `94`, `|` at `124`).
const CMD_METACHAR_HI_MASK: u64 = 0x1000_0000_4000_0000;

/| `O(1)` ASCII `0..63` bitset for `cmd.exe` argument delimiters (`\t`, `\v`, `' '`, `'"'`, `,`, `;`, `=`).
const CMD_DELIM_LO_MASK: u64 = 0x2800_1005_0000_0A00;

/| Windows `FSCTL_PIPE_PEEK` `DeviceIoControl` code (`CTL_CODE(FILE_DEVICE_NAMED_PIPE, 3, METHOD_BUFFERED, FILE_READ_DATA)`).
@cfg(target.os == "windows")
const WIN32_FSCTL_PIPE_PEEK: u32 = 0x0011_400C;

/| Windows pipe buffer allocation hint (`64 KiB`) reducing context switches on compiler/linker output.
@cfg(target.os == "windows")
const WIN32_PIPE_BUF_HINT: u32 = 65_536;

/| NUL-terminated UTF-16 `.exe\0` extension enforced by `SearchPathW` in `Command.new`.
@cfg(target.os == "windows")
const WIN32_DOT_EXE_UTF16: [u16; 5] = [0x002E, 0x0065, 0x0078, 0x0065, 0x0000];

/| NUL-terminated UTF-16 `NUL\0` device path for `Stdio.null()` on Windows.
@cfg(target.os == "windows")
const WIN32_NUL_DEV_UTF16: [u16; 4] = [0x004E, 0x0055, 0x004C, 0x0000];

/| NUL-terminated UTF-16 `SystemRoot\0` environment variable name used to locate `System32\cmd.exe`.
@cfg(target.os == "windows")
