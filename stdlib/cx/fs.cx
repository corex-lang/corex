/# Capability-Safe Filesystem, Thresholded Mmap, Atomic Publish, and Watchers (cx.fs)
/#
/# Provides register-sized 8-byte `FsError`, `@linear` `File` / `Dir` / `Mmap` / `FileLock` / `FsWatcher`
/# handles, `16 KiB`-thresholded source loading, `resolve_path` and `resolve_or_create_path`,
/# `UnlinkAndReplace` atomic publishing, and 3-tier copy-on-write `materialize_file` (`STD-02` §1.2, §2.3).
/#
/# Every OS entry point carries a `DR-17` `@std_cap_boundary` and routes through `context.reactor`
/# (`ReactorVTable.submit_io` `SIM_OP_FS_*`) for deterministic `corex test --sim` replay with zero pre-`main` code.

use core.async.{
    IoSubmission,
    SIM_OP_FS_CLOSE,
    SIM_OP_FS_DIR_OP,
    SIM_OP_FS_LOCK,
    SIM_OP_FS_MATERIALIZE,
    SIM_OP_FS_MMAP,
    SIM_OP_FS_OPEN,
    SIM_OP_FS_OP_BENEATH,
    SIM_OP_FS_RENAME_ATOMIC,
    SIM_OP_FS_RESOLVE,
    SIM_OP_FS_RW,
    SIM_OP_FS_SEEK,
    SIM_OP_FS_STAT,
    SIM_OP_FS_SYNC,
    SIM_OP_FS_WATCH_POLL,
    SIM_UNHANDLED_SENTINEL,
};
use core.sys;
use cx.col.Vec;
use cx.io.{
    ErrDomain,
    IoError,
    IoErrorBits,
    IoErrorKind,
    IoOp,
    IoSlice,
    IoSliceMut,
    OutBuf,
    READER_SENTINEL_FILE,
    Reader,
    ReaderVTable,
    SEEK_SENTINEL_FILE,
    Seek,
    SeekFrom,
    SeekVTable,
    WRITER_SENTINEL_FILE,
    Writer,
    WriterVTable,
};
use cx.mem.{Arena, Layout, System, align_up};
use cx.path.{
    Path,
    PathBuf,
    VerbatimMode,
    decode_wtf16_to_path_buf,
    encode_wtf8_to_wtf16,
    should_promote_verbatim_win32,
};
use cx.str.{String, is_valid_utf8};
use cx.time.{Duration, Instant, SystemTime};

// ---------------------------------------- TYPES ----------------------------------------
// ---------------- Raw OS Descriptors & FsError ----------------
/| Operating-system raw file or directory handle (`HANDLE` / `*mut opaque` on Windows).
@cfg(target.os == "windows")
pub type RawOsFd = *mut opaque;

/| Operating-system raw file or directory descriptor (`i32` on POSIX and WASI).
@cfg(not (target.os == "windows"))
pub type RawOsFd = i32;

/| Register-sized 8-byte filesystem error isomorphic to `IoError` (`swifterror`-ready, `bit[0] == 0`, `0` heap allocs).
@repr(C) @derive(Copy, Equatable, Hash)
pub struct FsError {
    /| Non-zero even 64-bit payload (`tag == 0b10` for inline errors; `0` and `1` reserved as niches).
    pub(pkg) packed_repr: u64 is 2..=u64.MAX,
}

/| Single `264 B` entry inside an optional `Context.diagnostics` `FsDiagPathRing`.
@repr(C)
pub struct FsDiagPathSlot {
    /| Byte length of the captured path in `0..=256`.
    pub byte_len: u16,
    /| Explicit alignment padding (`[0; 6]`).
    pub pad_bytes: [u8; 6],
    /| UTF-8 / WTF-8 path prefix captured at failure time.
    pub path_bytes: [u8; 256],
}

/| Optional magic-tagged 8-slot failed-path ring attachable to `context.diagnostics` (`0` pre-`main` init).
@repr(C, align: 8)
pub struct FsDiagPathRing {
    /| Magic header word (`FS_DIAG_RING_MAGIC`) identifying an initialized `FsDiagPathRing`.
    pub magic_tag: u64,
    /| Next ring write cursor (`0..7`, wrapping modulo `8` -> encoded as `diag_slot = 1..=8`).
    pub write_cursor: u32,
    /| Reserved header word (`0`).
    pub reserved_word: u32,
    /| Eight bounded `264 B` path slots.
    pub slots: [FsDiagPathSlot; 8],
}

// -------------- Metadata, Permissions & Options ---------------
/| Cross-platform filesystem inode or entry classification (`STD-02` §2.3).
@derive(Copy, Equatable, Hash, Clone, Debug)
pub enum FileType: u8 {
    /| Standard data file (`S_IFREG` / regular file).
    RegularFile = 0,
    /| Filesystem directory (`S_IFDIR` / `FILE_ATTRIBUTE_DIRECTORY`).
    Directory = 1,
    /| Symbolic link or NTFS reparse-point symlink/junction (`S_IFLNK`).
    Symlink = 2,
    /| Named pipe / FIFO (`S_IFIFO` / `FILE_TYPE_PIPE`).
    Fifo = 3,
    /| Unix-domain socket (`S_IFSOCK`).
    Socket = 4,
    /| Character or console device (`S_IFCHR` / `FILE_TYPE_CHAR`).
    CharDevice = 5,
    /| Block storage device (`S_IFBLK`).
    BlockDevice = 6,
    /| Unclassified or filesystem-opaque entry kind (`255`).
    Unknown = 255,
}

/| Cross-platform file mode and permission bitfield (`16 + 1 + 1 + 14 == 32` bits, `STD-02` §2.3).
@derive(Copy, Equatable, Hash, Clone, Debug)
pub bit_field FilePermissions: u32 {
    /| Low 12-bit POSIX permission mode (`0o644`, `0o755`, etc.).
    pub posix_mode: u16 | 16,
    /| `true` when write access is disabled (`FILE_ATTRIBUTE_READONLY` or `(mode & 0o222) == 0`).
    pub readonly: bool | 1,
    /| `true` when owner/group/world execute bits are set (`(mode & 0o111) != 0`).
    pub executable: bool | 1,
    /| Reserved zero bits keeping `sizeof(FilePermissions) == 4 B`.
    reserved: u16 | 14,
}

/| Normalized file, directory, or symlink metadata record (`STD-02` §2.3).
@derive(Copy, Equatable, Clone, Debug)
pub struct Metadata {
    /| Entry classification (`RegularFile`, `Directory`, `Symlink`, etc.).
    pub file_type: FileType,
    /| Logical byte length (`0` for directories on some platforms).
    pub size: u64,
    /| Cross-platform permissions and POSIX mode bits.
    pub permissions: FilePermissions,
    /| Last data-modification timestamp when reported by the filesystem.
    pub modified: SystemTime?,
    /| Last data-access timestamp when reported by the filesystem.
    pub accessed: SystemTime?,
    /| File creation / birth timestamp (`STATX_BTIME`, `st_birthtimespec`, `CreationTime`).
    pub created: SystemTime?,
    /| Backing filesystem volume or device identifier.
    pub dev_id: u64,
    /| 64-bit inode or folded NTFS/ReFS file identifier.
    pub inode_or_file_id: u64,
    /| Number of directory hardlinks referencing this inode.
    pub hardlink_count: u32,
}

/| Bit-packed file open flags (`11 * 1 + 5 == 16` bits, `STD-02` §2.3).
@derive(Copy, Equatable, Hash, Clone, Debug)
pub bit_field OpenFlags: u16 {
    /| Open descriptor with read access (`O_RDONLY` / `O_RDWR` / `GENERIC_READ`).
    pub read: bool | 1,
    /| Open descriptor with write access (`O_WRONLY` / `O_RDWR` / `GENERIC_WRITE`).
    pub write: bool | 1,
    /| Append every write atomically at end-of-file (`O_APPEND` / `FILE_APPEND_DATA`).
    pub append: bool | 1,
    /| Create target file if absent (`O_CREAT` / `OPEN_ALWAYS`).
    pub create: bool | 1,
    /| Fail with `.AlreadyExists` if target exists (`O_CREAT | O_EXCL` / `CREATE_NEW`).
    pub create_new: bool | 1,
    /| Truncate existing regular file to zero bytes (`O_TRUNC` / `TRUNCATE_EXISTING`).
    pub truncate: bool | 1,
    /| Reject terminal symbolic link or reparse point (`O_NOFOLLOW` / `FILE_FLAG_OPEN_REPARSE_POINT`).
    pub no_follow: bool | 1,
    /| Flush data writes synchronously (`O_DSYNC` / `FILE_FLAG_WRITE_THROUGH`).
    pub sync_data: bool | 1,
    /| Acquire advisory shared lock during open (`LOCK_SH` / `LockFileEx`).
    pub lock_shared: bool | 1,
    /| Acquire advisory exclusive lock during open (`LOCK_EX` / `LOCKFILE_EXCLUSIVE_LOCK`).
    pub lock_exclusive: bool | 1,
    /| Fail immediately with `.FileLockConflict` when lock is contended (`LOCK_NB` / `LOCKFILE_FAIL_IMMEDIATELY`).
    pub nonblocking_lock: bool | 1,
    /| Reserved zero bits keeping `sizeof(OpenFlags) == 2 B`.
    reserved: u8 | 5,
}

/| Complete file open configuration pairing `OpenFlags` and creation `FilePermissions` (`STD-02` §2.3).
@derive(Copy, Equatable, Clone, Debug)
pub struct OpenOptions {
    /| Requested access, creation, symlink, sync, and lock flags.
    pub flags: OpenFlags = OpenFlags {
        read: true,
        write: false,
        append: false,
        create: false,
        create_new: false,
        truncate: false,
        no_follow: false,
        sync_data: false,
        lock_shared: false,
        lock_exclusive: false,
        nonblocking_lock: false,
        reserved: 0_u8,
    },
    /| Creation permissions applied when `create` or `create_new` creates a new file.
    pub permissions: FilePermissions = FilePermissions {
        posix_mode: 0o644_u16,
        readonly: false,
        executable: false,
        reserved: 0_u16,
    },
}

/| Storage durability barrier strength for `File.sync`, `StagedAtomicFile.publish`, and `write_atomic` (`STD-02` §2.3).
@derive(Copy, Equatable, Hash, Clone, Debug)
pub enum DurabilityMode: u8 {
    /| Page-cache visibility only (`0 ms` NVMe stall; suitable for intermediate `.o` / build scratch).
    FastLocal = 0,
    /| Crash-consistent barrier (`fdatasync` / `F_BARRIERFSYNC` / `FlushFileBuffers` / `fd_datasync`).
    CrashSafe = 1,
    /| Power-loss barrier (`fsync`+dir / `F_FULLFSYNC`+dir / `FlushFileBuffers` / `fd_sync`).
    PowerSafe = 2,
}

// ---------------- Linear File, Dir & Iteration ----------------
/| Tier-3 `@linear` file handle preventing descriptor leaks at compile time (`E0304`, `STD-02` §2.3).
@linear
pub struct File {
    /| Underlying host OS descriptor or simulated `--sim` virtual handle.
    pub(pkg) raw_fd: RawOsFd,
}

/| Tier-3 `@linear` capability directory handle for sandboxed `*_beneath` traversal (`E0304`, `STD-02` §2.3).
@linear
pub struct Dir {
    /| Underlying host OS directory descriptor or simulated `--sim` virtual handle.
    pub(pkg) raw_fd: RawOsFd,
}

/| Single child entry yielded by `DirIter.next` (excluding `.` and `..`, `STD-02` §2.3).
@derive(Clone, Debug)
pub struct DirEntry {
    /| Entry base filename relative to the iterated `Dir` (`<= 23 B` inline SSO).
    pub name: PathBuf,
    /| Entry classification (`RegularFile`, `Directory`, `Symlink`, etc.).
    pub file_type: FileType,
    /| Inode or file serial number (`0` when not reported by `FindFirstFileExW`).
    pub inode_or_file_id: u64,
}

/| Tier-3 `@linear` streaming directory iterator (`must` call `.close()`, `E0304`, `STD-02` §2.3).
@linear
pub struct DirIter {
    /| Opaque pointer to platform directory-enumeration state (`null` when exhausted/simulated).
    raw_state: *mut opaque,
}

/| Windows `FindFirstFileExW` directory enumeration state allocated via `System`.
struct WinDirIterState {
    /| Active `FindFirstFileExW` search handle (`INVALID_HANDLE_VALUE` when finished).
    find_handle: *mut opaque,
    /| Buffered `WIN32_FIND_DATAW` record from `FindFirstFileExW` or `FindNextFileW`.
    find_data: sys.windows.Win32FindDataW,
    /| `true` while `find_data` holds the unconsumed initial record from `FindFirstFileExW`.
    has_pending_first: bool,
    /| `true` once `ERROR_NO_MORE_FILES` has been reached.
    is_finished: bool,
}

/| Linux `getdents64` batched directory enumeration state (`8 KiB` buffer) allocated via `System`.
struct LinuxDirIterState {
    /| Independent `O_RDONLY | O_DIRECTORY | O_CLOEXEC` descriptor duplicated via `openat(dir, ".")`.
    dup_fd: i32,
    /| Read cursor within `dirent_buf`.
    buf_pos: usize,
    /| Valid byte count returned by `SYS_getdents64`.
    buf_filled: usize,
    /| `true` once `SYS_getdents64` returned `0`.
    is_eof: bool,
    /| `8 KiB` aligned kernel `linux_dirent64` batch buffer.
    dirent_buf: [u64; 1_024],
}

/| macOS Darwin `__getdirentries64` batched directory enumeration state (`8 KiB` buffer).
struct DarwinDirIterState {
    /| Independent `O_RDONLY | O_DIRECTORY | O_CLOEXEC` descriptor duplicated via `openat(dir, ".")`.
    dup_fd: i32,
    /| Kernel seek offset cookie updated by `__getdirentries64`.
    seek_base: i64,
    /| Read cursor within `dirent_buf`.
    buf_pos: usize,
    /| Valid byte count returned by `__getdirentries64`.
    buf_filled: usize,
    /| `true` once `__getdirentries64` returned `0`.
    is_eof: bool,
    /| `8 KiB` aligned `DarwinDirent64Hdr` batch buffer.
    dirent_buf: [u64; 1_024],
}

/| WASI Preview 1 `fd_readdir` batched directory enumeration state (`8 KiB` buffer).
struct WasiDirIterState {
    /| Borrowed capability directory descriptor.
    dir_fd: i32,
    /| Next `d_next` directory cookie (`0` at start).
    next_cookie: u64,
    /| Current read offset inside `dirent_buf`.
    buf_pos: usize,
    /| Valid byte count returned by `wasi_fd_readdir`.
    buf_filled: usize,
    /| `true` once `buf_used < 8_192` and `buf_pos >= buf_filled`.
    is_eof: bool,
    /| `true` when the last `wasi_fd_readdir` call filled the entire buffer (`buf_used == 8_192`).
    was_full_batch: bool,
    /| `8 KiB` linear-memory buffer receiving `WasiDirentHdr` + UTF-8 names.
    dirent_buf: [u8; 8_192],
}

// --------------- Thresholded Mmap & LoadedFile ----------------
/| Tier-3 `@linear` read-only memory mapping (`must` call `.close()`, `E0304`, `STD-02` §2.3).
@linear
pub struct Mmap {
    /| Read-only base byte pointer (`STATIC_NUL_SENTINEL.as_ptr()` when `len_bytes == 0`).
    ptr: *u8,
    /| Exact logical file byte length.
    len_bytes: usize,
    /| Mapped byte capacity passed to `munmap` (`0` for `0`-byte or simulated slices; `1` on Win32 `UnmapViewOfFile`).
    map_cap: usize,
}

/| Tier-3 `@linear` result of `load_file_thresholded` (`< 16 KiB` `Arena` buffer vs. `>= 16 KiB` `Mmap`).
@linear
pub enum LoadedFile {
    /| Contiguous slice inside caller `Arena` (or static `b"\0"[0..0]` when empty).
    ArenaBuf(&[u8]),
    /| Page-backed read-only OS memory mapping.
    Mapped(Mmap),
}

// --------------- Atomic Publish, CoW & FileLock ---------------
/| Missing-directory creation policy for `resolve_or_create_path` (`AGENTS.md` §6, `STD-02` §2.3).
@derive(Copy, Equatable, Hash, Clone, Debug)
pub enum CreateTargetKind: u8 {
    /| Ensure `path` itself exists as a directory before canonicalizing (`0`).
    Dir = 0,
    /| Ensure `path.parent()` exists as a directory and canonicalize `parent / file_name` (`1`).
    FileParent = 1,
    /| Ensure `path.parent()` exists and touch `path` as a regular file if absent before canonicalizing (`2`).
    File = 2,
}

/| Tier-3 `@linear` staged temporary file in the destination directory for crash-safe `UnlinkAndReplace` (`STD-02` §3.3).
@linear
pub struct StagedAtomicFile {
    /| Open writable temporary file handle (`DELETE` + `FILE_SHARE_ALL` on Windows; `0o600` fresh inode on POSIX).
    file: File,
    /| Open parent directory descriptor on POSIX (`-1` when unused on Windows/WASI).
    parent_dir_fd: isize,
    /| Full or parent-relative staged `.tmp` path for atomic rename or `abort()` cleanup.
    tmp_path: PathBuf,
    /| Full or parent-relative destination path replaced on `publish()`.
    dst_path: PathBuf,
    /| Target permissions applied before publishing.
    perms: FilePermissions,
}

/| Copy-on-write and hardlink sharing policy for `materialize_file` (`STD-02` §2.3, §3.4).
@derive(Copy, Equatable, Hash, Clone, Debug)
pub enum MaterializePolicy: u8 {
    /| Mutable destination file: try `Reflink` (`FICLONE` / `clonefileat` / ReFS), else `Copy` (never hardlink).
    ReflinkOrCopy = 0,
    /| Immutable content-addressable artifact: try `Reflink` -> `Hardlink` (`< 1023` links) -> `Copy`.
    ImmutableCas = 1,
}

/| Strategy actually used by `materialize_file` (`STD-02` §2.3, §3.4).
@derive(Copy, Equatable, Hash, Clone, Debug)
pub enum MaterializeMethod: u8 {
    /| `O(1)` copy-on-write extent clone (`FICLONE`, `clonefileat`, or ReFS `FSCTL_DUPLICATE_EXTENTS_TO_FILE`).
    Reflinked = 0,
    /| `O(1)` directory hardlink (`linkat`, `CreateHardLinkW`, or `path_link`).
    Hardlinked = 1,
    /| Kernel splice (`copy_file_range` / `fcopyfile`) or `64 KiB` read/write copy into staged atomic file.
    Copied = 2,
}

/| Advisory file lock mode (`STD-02` §2.3).
@derive(Copy, Equatable, Hash, Clone, Debug)
pub enum LockMode: u8 {
    /| Concurrent reader lock (`LOCK_SH` / shared `LockFileEx`).
    Shared = 0,
    /| Exclusive writer lock (`LOCK_EX` / `LOCKFILE_EXCLUSIVE_LOCK` / WASI `.lock` sentinel).
    Exclusive = 1,
}

/| Tier-3 `@linear` advisory file lock guard (`must` call `.unlock_and_close()`, `E0304`, `STD-02` §2.3).
@linear
pub struct FileLock {
    /| Underlying locked `File` descriptor (or boxed `WasiLockEntry` handle on WASI).
    file: File,
}

/| Heap-allocated sentinel lock record backing `FileLock` on WASI Preview 1.
struct WasiLockEntry {
    /| Open exclusive sentinel descriptor.
    raw_fd: i32,
    /| Sentinel lockfile path unlinked on release.
    sentinel_path: PathBuf,
}

// ---------------- Cross-OS Filesystem Watcher -----------------
/| Subscription filter bitfield for `FsWatcher.watch` (`6 + 10 == 16` bits, `STD-02` §2.3).
@derive(Copy, Equatable, Hash, Clone, Debug)
pub bit_field WatchMask: u16 {
    /| Report newly created files and directories (`1`).
    pub create: bool | 1,
    /| Report content writes and truncations (`1`).
    pub modify: bool | 1,
    /| Report file and directory deletions (`1`).
    pub remove: bool | 1,
    /| Report source and destination rename events (`1`).
    pub rename: bool | 1,
    /| Report permission and metadata changes (`1`).
    pub attrib: bool | 1,
    /| Watch subdirectories recursively when target is a directory (`1`).
    pub recursive: bool | 1,
    /| Reserved zero bits keeping `sizeof(WatchMask) == 2 B`.
    reserved: u16 | 10,
}

/| Event classification bitfield carried on `WatchEvent` (`8 + 8 == 16` bits, `STD-02` §2.3).
@derive(Copy, Equatable, Hash, Clone, Debug)
pub bit_field WatchEventFlags: u16 {
    /| Entry was created (`IN_CREATE` / `FILE_ACTION_ADDED`).
    pub created: bool | 1,
    /| Entry data was modified (`IN_MODIFY` / `NOTE_WRITE` / `FILE_ACTION_MODIFIED`).
    pub modified: bool | 1,
    /| Entry was unlinked (`IN_DELETE` / `NOTE_DELETE` / `FILE_ACTION_REMOVED`).
    pub removed: bool | 1,
    /| Entry was renamed away from `path` (`IN_MOVED_FROM` / `FILE_ACTION_RENAMED_OLD_NAME`).
    pub renamed_from: bool | 1,
    /| Entry was renamed to `path` (`IN_MOVED_TO` / `FILE_ACTION_RENAMED_NEW_NAME`).
    pub renamed_to: bool | 1,
    /| Entry attributes or permissions changed (`IN_ATTRIB` / `NOTE_ATTRIB`).
    pub attrib: bool | 1,
    /| Event target is a directory (`IN_ISDIR`).
    pub is_dir: bool | 1,
    /| Kernel event queue overflowed (`IN_Q_OVERFLOW` / `ERROR_NOTIFY_ENUM_DIR`); caller must rescan.
    pub rescan_required: bool | 1,
    /| Reserved zero bits keeping `sizeof(WatchEventFlags) == 2 B`.
    reserved: u8 | 8,
}

/| Strongly typed identifier for an active `FsWatcher` registration (`STD-02` §2.3).
@derive(Copy, Equatable, Hash)
pub type WatchId = distinct u32;

/| Single filesystem change notification yielded by `FsWatcher.poll_events` (`STD-02` §2.3).
pub struct WatchEvent {
    /| Registration handle that produced this event.
    pub watch_id: WatchId,
    /| Affected path (joined beneath watched root directory).
    pub path: PathBuf,
    /| Triggered event flags.
    pub flags: WatchEventFlags,
    /| Non-zero correlation cookie pairing `renamed_from` and `renamed_to` events (`0` when unpaired).
    pub rename_cookie: u32 = 0,
}

/| Tier-3 `@linear` cross-platform filesystem change watcher (`must` call `.close()`, `E0304`, `STD-02` §2.3).
@linear
pub struct FsWatcher {
    /| Opaque pointer to platform watcher backend state (`inotify`, `kqueue`, `ReadDirectoryChangesW`, or `--sim`).
    backend_state: *mut opaque,
}

/| Single watched directory slot managed by `WinWatcherState` (`ReadDirectoryChangesW`).
struct WinWatchSlot {
    /| Public registration handle (`>= 1`).
    watch_id: u32,
    /| Watched directory handle opened with `FILE_FLAG_BACKUP_SEMANTICS | FILE_FLAG_OVERLAPPED`.
    dir_handle: *mut opaque,
    /| Manual-reset Win32 event handle signaled on `OVERLAPPED` completion.
    event_handle: *mut opaque,
    /| `64 KiB` aligned notification buffer allocated via `System.alloc_pages`.
    notify_buf: *mut u8,
    /| Heap-pinned `Win32Overlapped` structure (`32 B`) remaining at a stable address while I/O is pending.
    overlapped_ptr: *mut sys.windows.Win32Overlapped,
    /| Canonical or user-supplied root directory path.
    root_path: PathBuf,
    /| Optional leaf filename filter when `watch()` targeted a single file rather than a directory.
    leaf_filter: PathBuf,
    /| `true` when `leaf_filter` restricts events to a single file inside `root_path`.
    has_leaf_filter: bool,
    /| Subscription mask requested by caller.
    mask: WatchMask,
    /| Win32 `FILE_NOTIFY_CHANGE_*` filter bits.
    notify_filter: u32,
    /| `true` while an asynchronous `ReadDirectoryChangesW` request is in flight.
    is_armed: bool,
}

/| Windows `FsWatcher` state managing bounded overlapped `ReadDirectoryChangesW` registrations.
struct WinWatcherState {
    /| Active watch slots (`<= MAX_WATCH_ENTRIES`).
    slots: Vec[WinWatchSlot],
    /| Monotonic `WatchId` generator (`>= 1`).
    next_watch_id: u32,
    /| Monotonic rename correlation cookie (`>= 1`) pairing `OLD_NAME` and `NEW_NAME`.
    next_rename_cookie: u32,
    /| Active cookie carried across adjacent `OLD_NAME` -> `NEW_NAME` records (`0` when idle).
    pending_cookie: u32,
}

/| Single `inotify` watch descriptor mapping back to its logical `WatchId` and directory path.
struct LinuxWatchNode {
    /| Kernel watch descriptor returned by `inotify_add_watch`.
    wd: i32,
    /| Owning logical `WatchId` (`u32`).
    watch_id: u32,
    /| Subscription mask for this registration.
    mask: WatchMask,
    /| Directory or file path corresponding to `wd`.
    node_path: PathBuf,
}

/| Linux `FsWatcher` state backed by `inotify_init1(IN_NONBLOCK | IN_CLOEXEC)`.
struct LinuxWatcherState {
    /| `inotify` queue file descriptor.
    inotify_fd: i32,
    /| Monotonic `WatchId` counter (`>= 1`).
    next_watch_id: u32,
    /| Active `inotify` watch nodes (`<= MAX_WATCH_ENTRIES`).
    nodes: Vec[LinuxWatchNode],
}

/| Single `kqueue` `EVFILT_VNODE` vnode descriptor tracked on macOS.
struct DarwinWatchNode {
    /| `O_EVTONLY | O_CLOEXEC` descriptor monitored by `EVFILT_VNODE`.
    evt_fd: i32,
    /| Owning logical `WatchId` (`u32`).
    watch_id: u32,
    /| Subscription mask for this registration.
    mask: WatchMask,
    /| Watched file or directory path.
    node_path: PathBuf,
    /| `true` when `evt_fd` refers to a directory.
    is_dir: bool,
}

/| macOS Darwin `FsWatcher` state backed by `kqueue` and `EVFILT_VNODE`.
struct DarwinWatcherState {
    /| `kqueue` descriptor.
    kq_fd: i32,
    /| Monotonic `WatchId` counter (`>= 1`).
    next_watch_id: u32,
    /| Active `EVFILT_VNODE` descriptors (`<= MAX_WATCH_ENTRIES`).
    nodes: Vec[DarwinWatchNode],
}

// --------------- Reactor Sim & OS Path Buffers ----------------
/| C-ABI callback signature for `ReactorVTable.submit_io` (`slot 3` of `ReactorVTable`).
type ReactorSubmitFn = extern "C" fn(ctx: *mut opaque, sub: *IoSubmission) -> i64;

/| Structured `--sim` request/response payload for `SIM_OP_FS_OPEN` and `SIM_OP_FS_OP_BENEATH`.
@repr(C)
struct SimPathOpReq {
    /| Input UTF-8 / WTF-8 path bytes pointer.
    path_ptr: *u8,
    /| Input path byte length.
    path_len: usize,
    /| Secondary path pointer (used by `rename_atomic` and `materialize_file`).
    dst_ptr: *u8,
    /| Secondary path byte length.
    dst_len: usize,
    /| Encoded `OpenFlags` (`u16`) or `CreateTargetKind` / `MaterializePolicy`.
    aux_flags: u32,
    /| Encoded `FilePermissions.posix_mode` (`u16`) or `DurabilityMode`.
    mode_bits: u32,
}

/| Structured `--sim` request/response payload for `SIM_OP_FS_RESOLVE`.
@repr(C)
struct SimResolveReq {
    /| Input path pointer.
    path_ptr: *u8,
    /| Input path byte length.
    path_len: usize,
    /| Destination buffer receiving canonical simulated path bytes.
    out_ptr: *mut u8,
    /| Capacity of `out_ptr` in bytes.
    out_cap: usize,
    /| Populated byte count written into `out_ptr` by `SimReactor` (`0` uses lexical fallback).
    written_len: usize,
}

/| Structured `--sim` request/response payload for `SIM_OP_FS_MMAP`.
@repr(C)
struct SimMmapReq {
    /| Populated read-only snapshot pointer returned by `SimReactor`.
    mapped_ptr: *u8,
    /| Populated snapshot byte length.
    mapped_len: usize,
}

/| Zero-heap-fast-path (`[u16; 528]` = `1,056 B` stack) Windows UTF-16 + `\\?\` / `\??\` path buffer (`STD-02` §3.2).
struct Win32PathBuf {
    /| Stack UTF-16 scratch buffer handling all normal paths `< 512` `WCHAR`s with `0` heap allocations.
    stack_u16: [u16; 528],
    /| Optional `System`-allocated overflow buffer for extended paths up to `32,768` `WCHAR`s (`null` when stack).
    heap_ptr: *mut u16,
    /| Allocated `u16` capacity of `heap_ptr` (`0` when `heap_ptr` is `null`).
    heap_cap_u16: usize,
    /| Start index of the active NUL-terminated path slice inside `stack_u16` or `heap_ptr`.
    start_idx: usize,
    /| Active `u16` code-unit length (excluding the trailing `0_u16` NUL).
    len_u16: usize,
}

/| Zero-heap-fast-path (`[u8; 1024]` stack) POSIX NUL-terminated path buffer for Linux and macOS.
struct PosixCStrBuf {
    /| Stack byte buffer handling paths `< 1,024` bytes without heap allocation.
    stack_bytes: [u8; 1_024],
    /| Optional `System`-allocated overflow buffer for paths `>= 1,024` bytes (`null` when stack).
    heap_ptr: *mut u8,
    /| Allocated byte capacity of `heap_ptr` (`0` when `heap_ptr` is `null`).
    heap_cap: usize,
    /| Active path byte length (excluding trailing `0_u8`).
    byte_len: usize,
}

// --------------------------------------- CONSTS ----------------------------------------
/| Canonical `16 KiB` (`16,384 B`) split between NUL-terminated `Arena` reads and read-only `Mmap` (`STD-02` §2.3).
pub const MMAP_THRESHOLD_BYTES: usize = 16_384;

/| Magic header (`"CXFSDIAG"`) identifying an initialized `FsDiagPathRing` in `context.diagnostics`.
pub const FS_DIAG_RING_MAGIC: u64 = 0x4358_4653_4449_4147_u64;

/| Inline tag `0b10` (`2`) keeping `FsError.packed_repr >= 2` and `bit[0] == 0`.
const FS_ERR_INLINE_TAG: u8 = 2_u8;

/| Maximum scatter-gather `iovec` count per `writev` call on Linux and macOS (`IOV_MAX = 1024`, `rust#68042`).
const POSIX_IOV_MAX: usize = 1_024;

/| Maximum scatter-gather `ciovec` count per `fd_write` call on WASI Preview 1 (`128`).
const WASI_IOV_MAX: usize = 128;

/| Fallback user-space copy chunk size (`64 KiB`) for `materialize_file` Tier 3 (`STD-02` §3.4).
const COPY_CHUNK_BYTES: usize = 65_536;

/| Maximum directory recursion depth (`256`) enforced by `remove_dir_all` and recursive `FsWatcher` (`AGENTS.md` §2).
const MAX_DIR_WALK_DEPTH: usize = 256;

/| Maximum watched nodes (`4,096`) per `FsWatcher` instance (`AGENTS.md` §2 bounded memory).
const MAX_WATCH_ENTRIES: usize = 4_096;

/| Maximum symbolic-link hops (`40`, matching POSIX `SYMLOOP_MAX`) during WASI `resolve_path`.
const MAX_SYMLINK_HOPS: usize = 40;

/| Maximum hardlink count (`1,023`, below NTFS `1,024` link ceiling) permitted before `ImmutableCas` falls back to copy.
const MAX_SAFE_HARDLINKS: u32 = 1_023;

/| Static 1-byte `.rodata` NUL buffer backing `0`-byte `Mmap` and `load_file_thresholded` (`ptr[0] == 0`).
const STATIC_NUL_SENTINEL: &[u8] = b"\0";

/| Static empty byte slice in `.rodata`.
const EMPTY_BYTES: &[u8] = b"";

/| Lowercase ASCII hex lookup table (`16 B`) for collision-free staged `.cxtmp.<hex>` filenames.
const HEX_LOWER_DIGITS: [u8; 16] = [
    b'0', b'1', b'2', b'3', b'4', b'5', b'6', b'7',
    b'8', b'9', b'a', b'b', b'c', b'd', b'e', b'f',
];

/| Win32 `FileEndOfFileInfo` (`6`) class setting logical file length without mutating seek cursor.
const WIN32_FILE_END_OF_FILE_INFO_CLASS: i32 = 6;

/| Win32 `ERROR_INVALID_FUNCTION` (`1`) returned on volumes rejecting `FileRenameInfoEx` / `FSCTL`.
const WIN32_ERROR_INVALID_FUNCTION: u32 = 1;

/| Win32 `ERROR_NO_MORE_FILES` (`18`) terminating `FindNextFileW`.
const WIN32_ERROR_NO_MORE_FILES: u32 = 18;

/| Win32 `ERROR_NOTIFY_ENUM_DIR` (`1022`) signaling `ReadDirectoryChangesW` buffer overflow (`rescan_required`).
const WIN32_ERROR_NOTIFY_ENUM_DIR: u32 = 1_022;

/| Maximum confined relative symbolic-link hops (`8`) resolved by `Dir.metadata_beneath(…, follow_symlinks: true)`.
const MAX_BENEATH_SYMLINK_HOPS: usize = 8;

/| Win32 `NT_CREATE_FILE` `FILE_WRITE_THROUGH` (`0x0000_0002`) synchronous write option.
const NT_FILE_WRITE_THROUGH: u32 = 0x0000_0002;

/| Win32 `NT_CREATE_FILE` `FILE_OPEN_FOR_BACKUP_INTENT` (`0x0000_4000`) for intermediate directory traversal.
const NT_FILE_OPEN_FOR_BACKUP_INTENT: u32 = 0x0000_4000;

/| Win32 `NT_CREATE_FILE` `FILE_TRAVERSE` (`0x0000_0020`) directory traversal right.
const NT_FILE_TRAVERSE: u32 = 0x0000_0020;

/| Win32 `FSCTL_GET_REPARSE_POINT` (`0x0009_00A8`) `DeviceIoControl` code reading symlink reparse buffers.
const WIN32_FSCTL_GET_REPARSE_POINT: u32 = 0x0009_00A8;

/| Win32 `SYMLINK_FLAG_RELATIVE` (`0x0000_0001`) bit inside `SymbolicLinkReparseBuffer.Flags`.
const WIN32_SYMLINK_FLAG_RELATIVE: u32 = 0x0000_0001;

/| Maximum `WCHAR` length (`32,760`) accepted by NT extended-length `UNICODE_STRING` paths.
const WIN32_MAX_EXTENDED_WCHARS: usize = 32_760;

/| Linux `IN_ISDIR` (`0x4000_0000`) flag on `inotify_event.mask` indicating directory target.
const LINUX_IN_ISDIR: u32 = 0x4000_0000;

// -------------------------------------- INTERNALS --------------------------------------
// --------------- Slice, String & Error Helpers ----------------
/| Reads `slice[idx]` without bounds panics (`0` when `idx >= slice.len()`).
@std_cap_boundary(clears: [unsafe_op, may_panic])
fn byte_at(slice: &[u8], idx: usize, /) -> u8 {
    if idx >= slice.len() {
        return 0_u8;
    }
    unsafe {
        slice.as_ptr().add(idx).read()
    }
}

/| Reads `slice[idx]` on a UTF-16 slice without bounds panics (`0` when `idx >= slice.len()`).
@std_cap_boundary(clears: [unsafe_op, may_panic])
fn u16_at(slice: &[u16], idx: usize, /) -> u16 {
    if idx >= slice.len() {
        return 0_u16;
    }
    unsafe {
        slice.as_ptr().add(idx).read()
    }
}

/| Projects `slice[start_idx..end_idx]` without bounds panics (`EMPTY_BYTES` on invalid range).
@std_cap_boundary(clears: [unsafe_op, may_panic])
fn subslice_u8(slice: &[u8], start_idx: usize, end_idx: usize, /) -> &[u8] {
    if start_idx >= end_idx or end_idx > slice.len() {
        return EMPTY_BYTES;
    }
    unsafe {
        @slice_from_raw_parts(slice.as_ptr().add(start_idx), end_idx -% start_idx)
    }
}

/| Projects `slice[start_idx..end_idx]` on a UTF-16 slice without bounds panics.
@std_cap_boundary(clears: [unsafe_op, may_panic])
fn subslice_u16(slice: &[u16], start_idx: usize, end_idx: usize, /) -> &[u16] {
    if start_idx >= end_idx or end_idx > slice.len() {
        return unsafe {
            @slice_from_raw_parts(2_usize as *u16, 0_usize)
        };
    }
    unsafe {
        @slice_from_raw_parts(slice.as_ptr().add(start_idx), end_idx -% start_idx)
    }
}

/| Scans `ptr` up to `max_len` bytes for a NUL terminator (`0_u8`).
@std_cap_boundary(clears: [unsafe_op])
fn cstr_len_bounded(ptr: *u8, max_len: usize, /) -> usize {
    if ptr.is_null() {
        return 0_usize;
    }
    var idx = 0_usize;
    while idx < max_len {
        let cur_byte: u8 = unsafe {
            ptr.add(idx).read()
        };
        if cur_byte == 0_u8 {
            break;
        }
        idx = idx +% 1_usize;
    }
    idx
}

/| Scans `ptr` up to `max_units` UTF-16 code units for a NUL terminator (`0_u16`).
@std_cap_boundary(clears: [unsafe_op])
fn wstr_len_bounded(ptr: *u16, max_units: usize, /) -> usize {
    if ptr.is_null() {
        return 0_usize;
    }
    var idx = 0_usize;
    while idx < max_units {
        let cur_unit: u16 = unsafe {
            ptr.add(idx).read()
        };
        if cur_unit == 0_u16 {
            break;
        }
        idx = idx +% 1_usize;
    }
    idx
}

/| Returns `true` if `seg` equals `"."`.
fn is_single_dot(seg: &[u8], /) -> bool {
    seg.len() == 1_usize and byte_at(seg, 0_usize) == b'.'
}

/| Returns `true` if `seg` equals `"."` or `".."`.
fn is_dot_or_dotdot(seg: &[u8], /) -> bool {
    if seg.len() == 1_usize and byte_at(seg, 0_usize) == b'.' {
        return true;
    }
    seg.len() == 2_usize and byte_at(seg, 0_usize) == b'.' and byte_at(seg, 1_usize) == b'.'
}

/| Returns `true` when `slice` contains an interior `0_u8` NUL byte.
fn has_interior_nul(slice: &[u8], /) -> bool {
    var idx = 0_usize;
    let total: usize = slice.len();
    while idx < total {
        if byte_at(slice, idx) == 0_u8 {
            return true;
        }
        idx = idx +% 1_usize;
    }
    false
}

/| Packs `IoErrorBits` into a range-refined `FsError` (`packed_repr >= 2`, `bit[0] == 0`).
fn pack_fs_error_bits(bits: IoErrorBits, /) -> FsError {
    let raw_word: u64 = (@bit_cast[u64](bits) & ~3_u64) | (FS_ERR_INLINE_TAG as u64);
    FsError {
        packed_repr: raw_word.narrow[u64 is 2..=u64.MAX](),
    }
}

/| Records `failed_bytes` inside `context.diagnostics` when an `FsDiagPathRing` is attached, returning `err` with `diag_slot`.
@std_cap_boundary(clears: [unsafe_op, may_panic])
fn attach_failed_path(err: FsError, failed_bytes: &[u8], /) -> FsError {
    if failed_bytes.is_empty() {
        return err;
    }
    let diag_slot: DiagSink = context.diagnostics;
    let ring_ptr: *mut FsDiagPathRing = unsafe {
        ((&raw diag_slot) as **mut FsDiagPathRing).read()
    };
    if ring_ptr.is_null() {
        return err;
    }
    if ((ring_ptr as usize) & 7_usize) != 0_usize {
        return err;
    }
    if unsafe {
        (ring_ptr as *u64).read()
    }
        != FS_DIAG_RING_MAGIC {
        return err;
    }
    let cursor_ptr: *mut u32 = unsafe {
        &raw mut ring_ptr.*.write_cursor
    };
    let cur_cursor: u32 = unsafe {
        cursor_ptr.read()
    };
    let slot_idx = (cur_cursor & 7_u32) as usize;
    unsafe {
        cursor_ptr.write(cur_cursor +% 1_u32);
    }
    let copy_len: usize = if failed_bytes.len() > 256_usize => 256_usize else failed_bytes.len();
    let slot_ptr: *mut FsDiagPathSlot = unsafe {
        (&raw mut ring_ptr.*.slots[0]).add(slot_idx)
    };
    if slot_ptr.is_null() {
        return err;
    }
    unsafe {
        (&raw mut slot_ptr.*.byte_len).write(copy_len as u16);
        @memcpy(
            (&raw mut slot_ptr.*.path_bytes[0]) as *mut opaque,
            failed_bytes.as_ptr() as *opaque,
            copy_len,
        );
    }
    var bits = @bit_cast[IoErrorBits](err.packed_repr as u64);
    bits.diag_slot = (slot_idx +% 1_usize) as u8;
    pack_fs_error_bits(bits)
}

/| Converts signed `(sec, nsec)` timestamps into `SystemTime?` (returning `.None` when `nsec` is invalid).
fn make_system_time_opt(secs: i64, nsec: i64, /) -> SystemTime? {
    if nsec < 0_i64 or nsec > 999_999_999_i64 {
        return .None;
    }
    SystemTime.from_unix_timestamp(secs, nsec as u32)
}

/| Validates relative path `rel_bytes` for capability-confined `*_beneath` operations (`STD-02` §3.4B).
fn validate_beneath_lexical(rel_bytes: &[u8], op: IoOp, /) -> unit!FsError {
    if rel_bytes.is_empty() {
        return .Err(attach_failed_path(FsError.from_kind(.InvalidInput, op: op), rel_bytes));
    }
    if has_interior_nul(rel_bytes) {
        return .Err(attach_failed_path(FsError.from_kind(.InvalidFilename, op: op), rel_bytes));
    }
    let first_b: u8 = byte_at(rel_bytes, 0_usize);
    if first_b == b'/' or first_b == b'\\' {
        return .Err(attach_failed_path(FsError.from_kind(.FilesystemLoop, op: op), rel_bytes));
    }
    var seg_start = 0_usize;
    var idx = 0_usize;
    let total: usize = rel_bytes.len();
    var saw_normal = false;
    while idx <= total {
        let cur_b: u8 = byte_at(rel_bytes, idx);
        if idx < total and cur_b == b':' {
            return .Err(attach_failed_path(FsError.from_kind(.FilesystemLoop, op: op), rel_bytes));
        }
        let is_sep: bool = if idx == total => true else cur_b == b'/' or cur_b == b'\\';
        if is_sep {
            let seg: &[u8] = subslice_u8(rel_bytes, seg_start, idx);
            if seg.len() == 2_usize
                and byte_at(seg, 0_usize) == b'.'
                and byte_at(seg, 1_usize) == b'.' {
                return .Err(
                    attach_failed_path(FsError.from_kind(.FilesystemLoop, op: op), rel_bytes),
                );
            }
            if seg.len() > 0_usize and not (seg.len() == 1_usize and byte_at(seg, 0_usize) == b'.') {
                saw_normal = true;
            }
            seg_start = idx +% 1_usize;
        }
        idx = idx +% 1_usize;
    }
    if not saw_normal {
        return .Err(attach_failed_path(FsError.from_kind(.InvalidInput, op: op), rel_bytes));
    }
    .Ok(())
}

/| Resolves relative symlink `link_target` against `cur_rel`'s parent strictly beneath `Dir` (empty `PathBuf` = `Dir` root).
fn join_confined_symlink_target(
    cur_rel: &[u8],
    link_target: &[u8],
    op: IoOp,
    /,
) -> PathBuf!FsError {
    if link_target.is_empty() {
        return .Err(attach_failed_path(FsError.from_kind(.FilesystemLoop, op: op), cur_rel));
    }
    if has_interior_nul(link_target) {
        return .Err(attach_failed_path(FsError.from_kind(.InvalidFilename, op: op), cur_rel));
    }
    let lead_b: u8 = byte_at(link_target, 0_usize);
    if lead_b == b'/' or lead_b == b'\\' {
        return .Err(attach_failed_path(FsError.from_kind(.FilesystemLoop, op: op), cur_rel));
    }

    // [1] Seed segment stack with normal components from `cur_rel.parent()`:
    var seg_srcs: [u8; 128] = [0_u8; 128];
    var seg_starts: [usize; 128] = [0_usize; 128];
    var seg_ends: [usize; 128] = [0_usize; 128];
    var stack_len = 0_usize;

    let parent_bytes: &[u8] = if Path.from_bytes(cur_rel).parent() is .Some(par_view) {
        par_view.as_bytes()
    } else {
        EMPTY_BYTES
    };
    if not parent_bytes.is_empty() and not is_single_dot(parent_bytes) {
        var par_start = 0_usize;
        var par_idx = 0_usize;
        let par_total: usize = parent_bytes.len();
        while par_idx <= par_total {
            let par_b: u8 = byte_at(parent_bytes, par_idx);
            let is_par_sep: bool = if par_idx == par_total => true
                else par_b == b'/' or par_b == b'\\';
            if is_par_sep {
                let par_seg: &[u8] = subslice_u8(parent_bytes, par_start, par_idx);
                if par_seg.len() > 0_usize and not is_single_dot(par_seg) {
                    if stack_len >= 128_usize {
                        return .Err(
                            attach_failed_path(FsError.from_kind(.InvalidFilename, op: op), cur_rel),
                        );
                    }
                    seg_srcs[stack_len] = 0_u8;
                    seg_starts[stack_len] = par_start;
                    seg_ends[stack_len] = par_idx;
                    stack_len = stack_len +% 1_usize;
                }
                par_start = par_idx +% 1_usize;
            }
            par_idx = par_idx +% 1_usize;
        }
    }

    // [2] Apply `link_target` segments, failing with `.FilesystemLoop` on `:` or `..` root escape:
    var tgt_start = 0_usize;
    var tgt_idx = 0_usize;
    let tgt_total: usize = link_target.len();
    while tgt_idx <= tgt_total {
        let tgt_b: u8 = byte_at(link_target, tgt_idx);
        if tgt_idx < tgt_total and tgt_b == b':' {
            return .Err(attach_failed_path(FsError.from_kind(.FilesystemLoop, op: op), cur_rel));
        }
        let is_tgt_sep: bool = if tgt_idx == tgt_total => true else tgt_b == b'/' or tgt_b == b'\\';
        if is_tgt_sep {
            let tgt_seg: &[u8] = subslice_u8(link_target, tgt_start, tgt_idx);
            if tgt_seg.len() == 2_usize
                and byte_at(tgt_seg, 0_usize) == b'.'
                and byte_at(tgt_seg, 1_usize) == b'.' {
                if stack_len == 0_usize {
                    return .Err(
                        attach_failed_path(FsError.from_kind(.FilesystemLoop, op: op), cur_rel),
                    );
                }
                stack_len = stack_len -% 1_usize;
            } else if tgt_seg.len() > 0_usize and not is_single_dot(tgt_seg) {
                if stack_len >= 128_usize {
                    return .Err(
                        attach_failed_path(FsError.from_kind(.InvalidFilename, op: op), cur_rel),
                    );
                }
                seg_srcs[stack_len] = 1_u8;
                seg_starts[stack_len] = tgt_start;
                seg_ends[stack_len] = tgt_idx;
                stack_len = stack_len +% 1_usize;
            }
            tgt_start = tgt_idx +% 1_usize;
        }
        tgt_idx = tgt_idx +% 1_usize;
    }

    if stack_len == 0_usize {
        return .Ok(PathBuf.new());
    }

    var joined = Vec[u8].new();
    var out_i = 0_usize;
    while out_i < stack_len and out_i < 128_usize {
        if out_i > 0_usize {
            joined.push(b'/');
        }
        let src_slice: &[u8] = if seg_srcs[out_i] == 0_u8 => parent_bytes else link_target;
        joined.extend_from_slice(subslice_u8(src_slice, seg_starts[out_i], seg_ends[out_i]));
        out_i = out_i +% 1_usize;
    }
    .Ok(PathBuf.from(joined.as_slice()))
}

/| Splits `dst_path` into `(parent_dir_path_or_dot, leaf_name_bytes)`, failing with `.InvalidInput` when leaf is missing.
fn split_parent_and_leaf(dst_path: Path, op: IoOp, /) -> (Path, &[u8])!FsError {
    let leaf_bytes: &[u8] = dst_path.file_name() orelse {
        return .Err(
            attach_failed_path(FsError.from_kind(.InvalidInput, op: op), dst_path.as_bytes()),
        );
    };
    if dst_path.parent() is .Some(parent_view) and not parent_view.is_empty() {
        return .Ok((parent_view, leaf_bytes));
    }
    .Ok((Path.from_bytes(b"."), leaf_bytes))
}

/| Formats a collision-resistant staged sibling filename `.<stem>.cxtmp.<hex16>` inside `parent_dir`.
@std_cap_boundary(clears: [unsafe_op, may_panic])
fn build_staged_tmp_path(parent_dir: Path, leaf_bytes: &[u8], attempt: u32, /) -> PathBuf {
    let now_ns: u64 = Instant.now().duration_since(Instant.from_raw_nanos(0_u64)).as_nanos();
    let rng_mix: u64 = @ctx_next_rng_seed();
    var state: u64 = now_ns ^ rng_mix ^ ((attempt as u64) *% 0x9E37_79B9_7F4A_7C15_u64);
    state = (state ^ (state >> 30_u64)) *% 0xBF58_476D_1CE4_E5B9_u64;
    state = (state ^ (state >> 27_u64)) *% 0x94D0_49BB_1331_11EB_u64;
    let token: u64 = state ^ (state >> 31_u64);

    let stem_cap: usize = if leaf_bytes.len() > 32_usize => 32_usize else leaf_bytes.len();
    var name_buf: [u8; 64] = [0_u8; 64];
    name_buf[0] = b'.';
    if stem_cap > 0_usize {
        unsafe {
            @memcpy(
                (&raw mut name_buf[0]).add(1_usize) as *mut opaque,
                leaf_bytes.as_ptr() as *opaque,
                stem_cap,
            );
        }
    }
    let tag_bytes = b".cxtmp.";
    let tag_off = 1_usize +% stem_cap;
    unsafe {
        @memcpy(
            (&raw mut name_buf[0]).add(tag_off) as *mut opaque,
            tag_bytes.as_ptr() as *opaque,
            7_usize,
        );
    }
    let hex_off: usize = tag_off +% 7_usize;
    var nib_idx = 0_usize;
    while nib_idx < 16_usize {
        let shift = ((15_usize -% nib_idx) *% 4_usize) as u64;
        let nib = ((token >> shift) & 0xF_u64) as usize;
        let hex_char: u8 = byte_at(&HEX_LOWER_DIGITS, nib);
        unsafe {
            (&raw mut name_buf[0]).add(hex_off +% nib_idx).write(hex_char);
        }
        nib_idx = nib_idx +% 1_usize;
    }
    let total_name_len: usize = hex_off +% 16_usize;
    let tmp_leaf_slice: &[u8] = unsafe {
        @slice_from_raw_parts(&raw name_buf[0], total_name_len)
    };
    if is_single_dot(parent_dir.as_bytes()) {
        return PathBuf.from(tmp_leaf_slice);
    }
    parent_dir.join(Path.from_bytes(tmp_leaf_slice))
}

/| Streams `src_file` into `dst_file` in `64 KiB` chunks (`System.alloc_pages` with `8 KiB` stack fallback).
@std_cap_boundary(clears: [unsafe_op])
fn copy_file_loop_64k(src_file: &mut File, dst_file: &mut File, /) -> unit!FsError {
    if System.alloc_pages(COPY_CHUNK_BYTES) is .Ok(page_buf) {
        while true {
            var out = unsafe {
                OutBuf.from_raw_parts(page_buf, COPY_CHUNK_BYTES)
            };
            let read_n: usize = src_file.read_out(&mut out) catch |read_err| {
                if read_err.is_interrupted() {
                    continue;
                }
                System.free_pages(page_buf, COPY_CHUNK_BYTES);
                return .Err(FsError.from_io(read_err, op: .Clone));
            };
            if read_n == 0_usize {
                break;
            }
            dst_file.write_all(out.filled()) catch |write_err| {
                System.free_pages(page_buf, COPY_CHUNK_BYTES);
                return .Err(FsError.from_io(write_err, op: .Clone));
            };
        }
        System.free_pages(page_buf, COPY_CHUNK_BYTES);
        return .Ok(());
    }
    var fallback_buf: [u8; 8_192];
    while true {
        var out = OutBuf.over_uninit(&out fallback_buf);
        let read_n: usize = src_file.read_out(&mut out) catch |read_err| {
            if read_err.is_interrupted() {
                continue;
            }
            return .Err(FsError.from_io(read_err, op: .Clone));
        };
        if read_n == 0_usize {
            break;
        }
        dst_file.write_all(out.filled()) catch |write_err| {
            return .Err(FsError.from_io(write_err, op: .Clone));
        };
    }
    .Ok(())
}

// ---------------- Reactor Simulation Dispatch -----------------
/| Converts `RawOsFd` into OS-neutral `isize` bits (`-1` on invalid Win32/POSIX/WASI descriptor).
fn raw_fd_to_bits(raw_fd: RawOsFd, /) -> isize = raw_fd as isize;

/| Converts OS-neutral `isize` bits back into `RawOsFd`.
fn bits_to_raw_fd(fd_bits: isize, /) -> RawOsFd = fd_bits as RawOsFd;

/| Encodes `RawOsFd` into a 32-bit integer descriptor slot for `IoSubmission.fd_or_handle`.
fn raw_fd_to_sim_i32(raw_fd: RawOsFd, /) -> i32 = (raw_fd as isize) as i32;

/| Decodes a non-negative `SimReactor` descriptor integer into `RawOsFd`.
fn sim_i32_to_raw_fd(sim_fd: i32, /) -> RawOsFd = (sim_fd as isize) as RawOsFd;

/| Submits an `IoSubmission` to `context.reactor.vtable.submit_io` when attached (`STD-02` §4.1).
@std_cap_boundary(clears: [ffi, unsafe_op, indirect_opaque])
fn try_reactor_fs_submit(
    kind: u8,
    flags: u8,
    fd_or_handle: i32,
    offset_or_ns: u64,
    buf_ptr: *mut u8,
    buf_len: usize,
    slot_index: u32,
    /,
) -> i64? {
    let reactor_slot = context.reactor;
    let vt_ptr: *u8 = unsafe {
        (&raw reactor_slot as **u8).read()
    };
    if vt_ptr.is_null() {
        return .None;
    }
    let slot_ptr = unsafe {
        vt_ptr.add(3_usize * @size_of[usize]()) as *(ReactorSubmitFn?)
    };
    if slot_ptr.is_null() {
        return .None;
    }
    let opt_submit: ReactorSubmitFn? = unsafe {
        slot_ptr.read()
    };
    let submit_cb: ReactorSubmitFn = opt_submit orelse return .None;
    let clamped_u32: u32 = if buf_len > (u32.MAX as usize) => u32.MAX else buf_len as u32;
    let sub = IoSubmission {
        kind,
        flags,
        worker_id: 0_u16,
        fd_or_handle,
        offset_or_ns,
        buf_ptr,
        buf_len: clamped_u32,
        slot_index,
    };
    let reactor_ctx_slot = context.reactor_ctx;
    let state_ptr: *mut opaque = unsafe {
        (&raw reactor_ctx_slot as **mut opaque).read()
    };
    let sim_rc: i64 = unsafe {
        submit_cb(state_ptr, &raw sub)
    };
    if sim_rc == SIM_UNHANDLED_SENTINEL {
        return .None;
    }
    .Some(sim_rc)
}

/| Converts a negative `SimReactor` fault return code into `FsError` (`ErrDomain.SimFault`).
fn sim_rc_to_fs_error(sim_rc: i64, op: IoOp, path_bytes: &[u8], /) -> FsError {
    let fault_code = (0_i64 -% sim_rc) as i32;
    attach_failed_path(FsError.from_raw_os(fault_code, domain: .SimFault, op: op), path_bytes)
}

/| Converts a negative `SimReactor` fault return code into `IoError` (`ErrDomain.SimFault`).
fn sim_rc_to_io_error(sim_rc: i64, op: IoOp, /) -> IoError {
    let fault_code = (0_i64 -% sim_rc) as i32;
    IoError.from_raw_os(fault_code, domain: .SimFault, op: op)
}

/| Constructs a simulated `FileLock` from `sim_fd`.
fn make_sim_file_lock(sim_fd: i32, /) -> FileLock {
    FileLock {
        file: File { raw_fd: sim_i32_to_raw_fd(sim_fd) },
    }
}

/| Consumes a simulated `FileLock` without host syscalls.
fn consume_sim_file_lock(lock: own FileLock, /) {
    let FileLock { file } = lock;
    let File { raw_fd } = file;
    _ = raw_fd;
}

// ---------------- File Stream VTable Callbacks ----------------
/| Sentinel `Reader.read_out` callback dispatching `READER_SENTINEL_FILE` to `File.read_out`.
@std_cap_boundary(clears: [fs, blocking_sync, ffi, unsafe_op, indirect_opaque])
pub(super) fn file_sentinel_read_out(ctx: *mut opaque, out: &mut OutBuf, /) -> usize!IoError {
    let file_ptr = ctx as *mut File;
    if file_ptr.is_null() {
        return .Ok(0_usize);
    }
    let file_ref: &mut File = unsafe {
        &mut file_ptr.*
    };
    file_ref.read_out(out)
}

/| Sentinel `Reader.read_vectored` callback dispatching `READER_SENTINEL_FILE` across `IoSliceMut` slices.
@std_cap_boundary(clears: [fs, blocking_sync, ffi, unsafe_op, indirect_opaque, may_panic])
pub(super) fn file_sentinel_read_vectored(
    ctx: *mut opaque,
    bufs: &mut [IoSliceMut],
    /,
) -> usize!IoError {
    let file_ptr = ctx as *mut File;
    if file_ptr.is_null() {
        return .Ok(0_usize);
    }
    let file_ref: &mut File = unsafe {
        &mut file_ptr.*
    };
    var idx = 0_usize;
    while idx < bufs.len() {
        if not bufs[idx].is_empty() {
            return file_ref.read(bufs[idx].as_mut_slice());
        }
        idx = idx +% 1_usize;
    }
    .Ok(0_usize)
}

/| Sentinel `Writer.write` callback dispatching `WRITER_SENTINEL_FILE` to `File.write`.
@std_cap_boundary(clears: [fs, blocking_sync, ffi, unsafe_op, indirect_opaque])
pub(super) fn file_sentinel_write(ctx: *mut opaque, buf: &[u8], /) -> usize!IoError {
    let file_ptr = ctx as *mut File;
    if file_ptr.is_null() {
        return .Ok(0_usize);
    }
    let file_ref: &mut File = unsafe {
        &mut file_ptr.*
    };
    file_ref.write(buf)
}

/| Sentinel `Writer.write_vectored` callback dispatching `WRITER_SENTINEL_FILE` to `File.write_vectored`.
@std_cap_boundary(clears: [fs, blocking_sync, ffi, unsafe_op, indirect_opaque])
pub(super) fn file_sentinel_write_vectored(ctx: *mut opaque, bufs: &[IoSlice], /) -> usize!IoError {
    let file_ptr = ctx as *mut File;
    if file_ptr.is_null() {
        return .Ok(0_usize);
    }
    let file_ref: &mut File = unsafe {
        &mut file_ptr.*
    };
    file_ref.write_vectored(bufs)
}

/| Sentinel `Writer.flush` callback for `WRITER_SENTINEL_FILE` (unbuffered OS `File` no-op).
@std_cap_boundary(clears: [fs, blocking_sync, ffi, unsafe_op, indirect_opaque])
pub(super) fn file_sentinel_flush(ctx: *mut opaque) -> unit!IoError {
    _ = ctx;
    .Ok(())
}

/| Sentinel `Seek.seek` callback dispatching `SEEK_SENTINEL_FILE` to `File.seek`.
@std_cap_boundary(clears: [fs, blocking_sync, ffi, unsafe_op, indirect_opaque])
pub(super) fn file_sentinel_seek(ctx: *mut opaque, pos: SeekFrom, /) -> u64!IoError {
    let file_ptr = ctx as *mut File;
    if file_ptr.is_null() {
        return .Ok(0_u64);
    }
    let file_ref: &mut File = unsafe {
        &mut file_ptr.*
    };
    file_ref.seek(pos)
}

// ---------------- Windows Host Implementation -----------------
impl Win32PathBuf {
    /| Transcodes WTF-8 `path_bytes` into a NUL-terminated Win32/NT UTF-16 buffer with `\\?\` / `\??\` promotion (`STD-02` §3.2).
    @std_cap_boundary(clears: [ffi, unsafe_op, may_panic])
    fn encode(path_bytes: &[u8], mode: VerbatimMode, op: IoOp, /) -> Win32PathBuf!FsError {
        if path_bytes.is_empty() {
            return .Err(FsError.from_kind(.NotFound, op: op));
        }
        var out_buf = Win32PathBuf {
            stack_u16: [0_u16; 528],
            heap_ptr: @default_init[*mut u16](),
            heap_cap_u16: 0_usize,
            start_idx: 0_usize,
            len_u16: 0_usize,
        };
        if path_bytes.len() >= 512_usize {
            let need_cap: usize = if path_bytes.len() +% 16_usize > 32_768_usize => 32_768_usize
                else path_bytes.len() +% 16_usize;
            let raw_mem: *mut u8 = System
                .handle()
                .alloc(
                    Layout { size: need_cap * 2_usize, alignment: 2_usize },
                ) catch {
                return .Err(attach_failed_path(FsError.from_kind(.OutOfMemory, op: op), path_bytes));
            };
            out_buf.heap_ptr = raw_mem as *mut u16;
            out_buf.heap_cap_u16 = need_cap;
        }
        let work_cap: usize = if out_buf.heap_ptr.is_null() => 519_usize
            else out_buf.heap_cap_u16 -| 9_usize;
        let work_base: *mut u16 = unsafe {
            if out_buf.heap_ptr.is_null() => (&raw mut out_buf.stack_u16[0]).add(8_usize)
                else out_buf.heap_ptr.add(8_usize)
        };
        let work_slice: &mut [u16] = unsafe {
            @slice_from_raw_parts_mut(work_base, work_cap)
        };
        let raw_len: usize = encode_wtf8_to_wtf16(path_bytes, work_slice) catch {
            out_buf.deinit();
            return .Err(attach_failed_path(FsError.from_kind(.InvalidFilename, op: op), path_bytes));
        };
        let imm_view: &[u16] = unsafe {
            @slice_from_raw_parts(work_base as *u16, raw_len)
        };
        let is_already_verbatim: bool = raw_len >= 4_usize
            and u16_at(imm_view, 0_usize) == 0x005C_u16
            and (u16_at(imm_view, 1_usize) == 0x005C_u16 or u16_at(imm_view, 1_usize) == 0x003F_u16)
            and (u16_at(imm_view, 2_usize) == 0x003F_u16 or u16_at(imm_view, 2_usize) == 0x002E_u16)
            and u16_at(
                imm_view,
                3_usize,
            )
                == 0x005C_u16;

        if not is_already_verbatim {
            var norm_idx = 0_usize;
            while norm_idx < raw_len {
                let ch16: u16 = unsafe {
                    work_base.add(norm_idx).read()
                };
                if ch16 == 0x002F_u16 {
                    unsafe {
                        work_base.add(norm_idx).write(0x005C_u16);
                    }
                }
                norm_idx = norm_idx +% 1_usize;
            }
        } else if mode == .NtNamespace
            and u16_at(imm_view, 1_usize) == 0x005C_u16
            and u16_at(
                imm_view,
                2_usize,
            )
                == 0x003F_u16 {
            unsafe {
                work_base.add(1_usize).write(0x003F_u16);
            }
        }
        unsafe {
            work_base.add(raw_len).write(0_u16);
        }
        out_buf.start_idx = 8_usize;
        out_buf.len_u16 = raw_len;

        if is_already_verbatim {
            return .Ok(out_buf);
        }
        let norm_view: &[u16] = unsafe {
            @slice_from_raw_parts(work_base as *u16, raw_len)
        };
        let should_promote: bool = (mode != .AutoPromote)
            or should_promote_verbatim_win32(norm_view);
        if not should_promote {
            return .Ok(out_buf);
        }

        // Resolve relative / `.` / `..` segments via `GetFullPathNameW` before prepending `\\?\` or `\??\`:
        var full_stack: [u16; 528] = [0_u16; 528];
        let full_len1: u32 = unsafe {
            sys.windows.win32_get_full_path_name_w(
                work_base as *u16,
                512_u32,
                (&raw mut full_stack[0]).add(8_usize),
                @default_init[*mut *mut u16](),
            )
        };
        if full_len1 == 0_u32 {
            let win_err: u32 = unsafe {
                sys.windows.win32_get_last_error()
            };
            out_buf.deinit();
            return .Err(
                attach_failed_path(
                    FsError.from_raw_os(@bit_cast[i32](win_err), domain: .Win32Error, op: op),
                    path_bytes,
                ),
            );
        }
        let second_char: u16 = if mode == .NtNamespace => 0x003F_u16 else 0x005C_u16;
        if full_len1 < 512_u32 {
            out_buf.deinit();
            var stack_res = Win32PathBuf {
                stack_u16: full_stack,
                heap_ptr: @default_init[*mut u16](),
                heap_cap_u16: 0_usize,
                start_idx: 0_usize,
                len_u16: 0_usize,
            };
            stack_res.apply_verbatim_prefix(full_len1 as usize, second_char);
            return .Ok(stack_res);
        }
        if (full_len1 as usize) > WIN32_MAX_EXTENDED_WCHARS {
            out_buf.deinit();
            return .Err(attach_failed_path(FsError.from_kind(.InvalidFilename, op: op), path_bytes));
        }
        let needed_u16 = (full_len1 as usize) +% 16_usize;
        let dyn_bytes: *mut u8 = System
            .handle()
            .alloc(
                Layout { size: needed_u16 * 2_usize, alignment: 2_usize },
            ) catch {
            out_buf.deinit();
            return .Err(attach_failed_path(FsError.from_kind(.OutOfMemory, op: op), path_bytes));
        };
        let dyn_u16 = dyn_bytes as *mut u16;
        let cap_u32: u32 = full_len1 +% 4_u32;
        let full_len2: u32 = unsafe {
            sys.windows.win32_get_full_path_name_w(
                work_base as *u16,
                cap_u32,
                dyn_u16.add(8_usize),
                @default_init[*mut *mut u16](),
            )
        };
        out_buf.deinit();
        if full_len2 == 0_u32
            or full_len2 >= cap_u32
            or (full_len2 as usize) > WIN32_MAX_EXTENDED_WCHARS {
            System
                .handle()
                .dealloc(dyn_bytes, Layout { size: needed_u16 * 2_usize, alignment: 2_usize });
            return .Err(attach_failed_path(FsError.from_kind(.InvalidFilename, op: op), path_bytes));
        }
        var dyn_res = Win32PathBuf {
            stack_u16: [0_u16; 528],
            heap_ptr: dyn_u16,
            heap_cap_u16: needed_u16,
            start_idx: 0_usize,
            len_u16: 0_usize,
        };
        dyn_res.apply_verbatim_prefix(full_len2 as usize, second_char);
        .Ok(dyn_res)
    }

    /| Prepends `\\?\` / `\??\` (or `\\?\UNC\` / `\??\UNC\` on `\\server\share`) in-place at offset `4` or `2`.
    @std_cap_boundary(clears: [unsafe_op])
    fn apply_verbatim_prefix(&mut self, resolved_len: usize, second_char: u16, /) {
        let base_ptr: *mut u16 = if self.heap_ptr.is_null() => &raw mut self.stack_u16[0]
            else self.heap_ptr;
        let end_idx = 8_usize +% resolved_len;
        unsafe {
            base_ptr.add(end_idx).write(0_u16);
        }
        let is_already_prefixed: bool = resolved_len >= 4_usize
            and unsafe {
                base_ptr.add(8_usize).read() == 0x005C_u16
                    and (
                        base_ptr.add(9_usize).read() == 0x005C_u16
                            or base_ptr.add(9_usize).read() == 0x003F_u16
                    )
                    and (
                        base_ptr.add(10_usize).read() == 0x003F_u16
                            or base_ptr.add(10_usize).read() == 0x002E_u16
                    )
                    and base_ptr
                        .add(
                            11_usize,
                        )
                        .read()
                        == 0x005C_u16
            };
        if is_already_prefixed {
            if second_char == 0x003F_u16 {
                unsafe {
                    base_ptr.add(9_usize).write(0x003F_u16);
                }
            }
            self.start_idx = 8_usize;
            self.len_u16 = resolved_len;
            return;
        }
        let is_unc: bool = resolved_len >= 2_usize
            and unsafe {
                base_ptr.add(8_usize).read() == 0x005C_u16
                    and base_ptr.add(9_usize).read() == 0x005C_u16
            };
        if is_unc {
            unsafe {
                base_ptr.add(2_usize).write(0x005C_u16);
                base_ptr.add(3_usize).write(second_char);
                base_ptr.add(4_usize).write(0x003F_u16);
                base_ptr.add(5_usize).write(0x005C_u16);
                base_ptr.add(6_usize).write(0x0055_u16);
                base_ptr.add(7_usize).write(0x004E_u16);
                base_ptr.add(8_usize).write(0x0043_u16);
            }
            self.start_idx = 2_usize;
            self.len_u16 = end_idx -% 2_usize;
            return;
        }
        unsafe {
            base_ptr.add(4_usize).write(0x005C_u16);
            base_ptr.add(5_usize).write(second_char);
            base_ptr.add(6_usize).write(0x003F_u16);
            base_ptr.add(7_usize).write(0x005C_u16);
        }
        self.start_idx = 4_usize;
        self.len_u16 = end_idx -% 4_usize;
    }

    /| Returns the NUL-terminated `*u16` pointer for Win32 syscalls.
    @std_cap_boundary(clears: [unsafe_op])
    fn as_ptr(&self) -> *u16 {
        let base_ptr: *u16 = if self.heap_ptr.is_null() => &raw self.stack_u16[0]
            else self.heap_ptr as *u16;
        unsafe {
            base_ptr.add(self.start_idx)
        }
    }

    /| Releases any overflow `System` buffer owned by `self`.
    fn deinit(&mut self) {
        if not self.heap_ptr.is_null() and self.heap_cap_u16 > 0_usize {
            System
                .handle()
                .dealloc(
                    self.heap_ptr as *mut u8,
                    Layout { size: self.heap_cap_u16 * 2_usize, alignment: 2_usize },
                );
            self.heap_ptr = @default_init[*mut u16]();
            self.heap_cap_u16 = 0_usize;
        }
    }
}

/| Returns `true` when `raw_fd` is `null` or `INVALID_HANDLE_VALUE` on Windows.
fn is_invalid_win_handle(raw_fd: *mut opaque, /) -> bool {
    raw_fd.is_null() or (raw_fd as isize) == sys.windows.INVALID_HANDLE_BITS
}

/| Builds `FsError` from `GetLastError()` with optional `failed_bytes` context.
@std_cap_boundary(clears: [ffi, unsafe_op])
fn win32_last_fs_error(op: IoOp, failed_bytes: &[u8], /) -> FsError {
    let win_err: u32 = unsafe {
        sys.windows.win32_get_last_error()
    };
    attach_failed_path(
        FsError.from_raw_os(@bit_cast[i32](win_err), domain: .Win32Error, op: op),
        failed_bytes,
    )
}

/| Converts a Win32 `FILETIME` (`100 ns` ticks since `1601-01-01`) into `SystemTime?` (`None` when `0`).
fn win32_filetime_to_systime(ft: sys.windows.Win32FileTime, /) -> SystemTime? {
    let raw_ticks: u64 = ((ft.high_date_time as u64) << 32_u64) | (ft.low_date_time as u64);
    if raw_ticks == 0_u64 {
        return .None;
    }
    let epoch_ticks = sys.windows.WINDOWS_TO_UNIX_EPOCH_TICKS as u64;
    if raw_ticks >= epoch_ticks {
        let rel_ticks: u64 = raw_ticks -% epoch_ticks;
        let secs = (rel_ticks / 10_000_000_u64) as i64;
        let sub_nanos = ((rel_ticks % 10_000_000_u64) * 100_u64) as u32;
        return SystemTime.from_unix_timestamp(secs, sub_nanos);
    }
    let before_ticks: u64 = epoch_ticks -% raw_ticks;
    let whole_before = (before_ticks / 10_000_000_u64) as i64;
    let rem_ticks: u64 = before_ticks % 10_000_000_u64;
    if rem_ticks == 0_u64 {
        return SystemTime.from_unix_timestamp(0_i64 -% whole_before, 0_u32);
    }
    SystemTime.from_unix_timestamp(
        (0_i64 -% whole_before) -% 1_i64,
        ((10_000_000_u64 -% rem_ticks) * 100_u64) as u32,
    )
}

/| Classifies Win32 `file_attributes` + optional `reparse_tag` + `GetFileType` into `FileType`.
fn classify_win32_attrs(attrs: u32, reparse_tag: u32, win_file_type: u32, /) -> FileType {
    if win_file_type == sys.windows.FILE_TYPE_CHAR {
        return .CharDevice;
    }
    if win_file_type == sys.windows.FILE_TYPE_PIPE {
        return .Fifo;
    }
    if (attrs & sys.windows.FILE_ATTRIBUTE_REPARSE_POINT) != 0_u32
        and (
            reparse_tag == 0_u32
                or reparse_tag == sys.windows.IO_REPARSE_TAG_SYMLINK
                or reparse_tag == sys.windows.IO_REPARSE_TAG_MOUNT_POINT
        ) {
        return .Symlink;
    }
    if (attrs & sys.windows.FILE_ATTRIBUTE_DIRECTORY) != 0_u32 {
        return .Directory;
    }
    .RegularFile
}

/| Synthesizes `FilePermissions` from Win32 `FILE_ATTRIBUTE_*` flags.
fn perms_from_win32_attrs(attrs: u32, is_dir: bool, /) -> FilePermissions {
    let is_ro: bool = (attrs & sys.windows.FILE_ATTRIBUTE_READONLY) != 0_u32;
    let mode_u16: u16 = if is_dir {
        if is_ro => 0o555_u16 else 0o755_u16
    } else if is_ro {
        0o444_u16
    } else {
        0o644_u16
    };
    FilePermissions {
        posix_mode: mode_u16,
        readonly: is_ro,
        executable: is_dir,
        reserved: 0_u16,
    }
}

/| Opens a Win32 `File` handle enforcing `FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE` (`STD-02` §1.2).
@cfg(target.os == "windows") @std_cap_boundary(clears: [ffi, unsafe_op])
fn os_file_open(path_bytes: &[u8], opts: OpenOptions, /) -> isize!FsError {
    var wpath: Win32PathBuf = Win32PathBuf.encode(path_bytes, .AutoPromote, .Open)?;
    var access = 0_u32;
    if opts.flags.read {
        access |= sys.windows.GENERIC_READ;
    }
    if opts.flags.append {
        access |= sys.windows.FILE_APPEND_DATA
            | sys.windows.FILE_WRITE_ATTRIBUTES
            | sys.windows.SYNCHRONIZE_ACCESS;
        if opts.flags.truncate {
            access |= sys.windows.GENERIC_WRITE;
        }
    } else if opts.flags.write {
        access |= sys.windows.GENERIC_WRITE;
    }
    let disposition: u32 = if opts.flags.create_new => sys.windows.CREATE_NEW
        else if opts.flags.create and opts.flags.truncate => sys.windows.CREATE_ALWAYS
        else if opts.flags.create => sys.windows.OPEN_ALWAYS
        else if opts.flags.truncate => sys.windows.TRUNCATE_EXISTING
        else sys.windows.OPEN_EXISTING;
    var flags_attrs: u32 = if opts.permissions.readonly => sys.windows.FILE_ATTRIBUTE_READONLY
        else sys.windows.FILE_ATTRIBUTE_NORMAL;
    if opts.flags.no_follow {
        flags_attrs |= sys.windows.FILE_FLAG_OPEN_REPARSE_POINT;
    }
    if opts.flags.sync_data {
        flags_attrs |= sys.windows.FILE_FLAG_WRITE_THROUGH;
    }
    let handle: *mut opaque = unsafe {
        sys.windows.win32_create_file_w(
            wpath.as_ptr(),
            access,
            sys.windows.FILE_SHARE_ALL,
            @default_init[*sys.windows.Win32SecurityAttributes](),
            disposition,
            flags_attrs,
            @default_init[*mut opaque](),
        )
    };
    if is_invalid_win_handle(handle) {
        let win_err: u32 = unsafe {
            sys.windows.win32_get_last_error()
        };
        if win_err == sys.windows.ERROR_ACCESS_DENIED {
            let probe_attrs: u32 = unsafe {
                sys.windows.win32_get_file_attributes_w(wpath.as_ptr())
            };
            if probe_attrs != sys.windows.INVALID_FILE_ATTRIBUTES
                and (probe_attrs & sys.windows.FILE_ATTRIBUTE_DIRECTORY) != 0_u32 {
                wpath.deinit();
                return .Err(
                    attach_failed_path(FsError.from_kind(.IsADirectory, op: .Open), path_bytes),
                );
            }
        }
        wpath.deinit();
        return .Err(
            attach_failed_path(
                FsError.from_raw_os(@bit_cast[i32](win_err), domain: .Win32Error, op: .Open),
                path_bytes,
            ),
        );
    }
    wpath.deinit();

    if opts.flags.no_follow {
        var tag_info = @default_init[sys.windows.Win32FileAttributeTagInfo]();
        let tag_ok: i32 = unsafe {
            sys.windows.win32_get_file_information_by_handle_ex(
                handle,
                sys.windows.FILE_ATTRIBUTE_TAG_INFO_CLASS,
                (&raw mut tag_info) as *mut opaque,
                @size_of[sys.windows.Win32FileAttributeTagInfo]() as u32,
            )
        };
        if tag_ok != 0
            and (tag_info.file_attributes & sys.windows.FILE_ATTRIBUTE_REPARSE_POINT) != 0_u32 {
            unsafe {
                _ = sys.windows.win32_close_handle(handle);
            }
            return .Err(
                attach_failed_path(FsError.from_kind(.FilesystemLoop, op: .Open), path_bytes),
            );
        }
    }

    win32_lock_opened_handle(handle, opts, path_bytes)?;
    .Ok(handle as isize)
}

/| Applies `opts.flags.{lock_shared, lock_exclusive, nonblocking_lock}` on `handle`, closing `handle` if locking fails.
@cfg(target.os == "windows") @std_cap_boundary(clears: [ffi, unsafe_op])
fn win32_lock_opened_handle(
    handle: *mut opaque,
    opts: OpenOptions,
    failed_bytes: &[u8],
    /,
) -> unit!FsError {
    if not opts.flags.lock_shared and not opts.flags.lock_exclusive {
        return .Ok(());
    }
    var lock_flags: u32 = if opts.flags.lock_exclusive => sys.windows.LOCKFILE_EXCLUSIVE_LOCK
        else 0_u32;
    if opts.flags.nonblocking_lock {
        lock_flags |= sys.windows.LOCKFILE_FAIL_IMMEDIATELY;
    }
    var ov_zero = @default_init[sys.windows.Win32Overlapped]();
    let lock_ok: i32 = unsafe {
        sys.windows.win32_lock_file_ex(
            handle,
            lock_flags,
            0_u32,
            0xFFFF_FFFF_u32,
            0xFFFF_FFFF_u32,
            &raw mut ov_zero,
        )
    };
    if lock_ok == 0 {
        let win_err: u32 = unsafe {
            sys.windows.win32_get_last_error()
        };
        unsafe {
            _ = sys.windows.win32_close_handle(handle);
        }
        if win_err == sys.windows.ERROR_LOCK_VIOLATION
            or win_err == sys.windows.ERROR_SHARING_VIOLATION {
            return .Err(
                attach_failed_path(FsError.from_kind(.FileLockConflict, op: .Lock), failed_bytes),
            );
        }
        return .Err(
            attach_failed_path(
                FsError.from_raw_os(@bit_cast[i32](win_err), domain: .Win32Error, op: .Lock),
                failed_bytes,
            ),
        );
    }
    .Ok(())
}

/| Closes a Win32 `File` or `Dir` handle if valid.
@cfg(target.os == "windows") @std_cap_boundary(clears: [ffi, unsafe_op])
fn os_close_fd(fd_bits: isize, /) -> unit!FsError {
    let raw_fd = fd_bits as *mut opaque;
    if is_invalid_win_handle(raw_fd) {
        return .Ok(());
    }
    let ok: i32 = unsafe {
        sys.windows.win32_close_handle(raw_fd)
    };
    if ok == 0 {
        return .Err(win32_last_fs_error(.None, EMPTY_BYTES));
    }
    .Ok(())
}

/| Reads sequentially from a Win32 `HANDLE` into `dst_ptr[0..cap]`.
@cfg(target.os == "windows") @std_cap_boundary(clears: [ffi, unsafe_op])
fn os_file_read(fd_bits: isize, dst_ptr: *mut u8, cap: usize, /) -> usize!IoError {
    let raw_fd = fd_bits as *mut opaque;
    let chunk_u32: u32 = if cap > 0x7FFF_FFFF_usize => 0x7FFF_FFFF_u32 else cap as u32;
    var read_n = 0_u32;
    let ok: i32 = unsafe {
        sys.windows.win32_read_file(
            raw_fd,
            dst_ptr,
            chunk_u32,
            &raw mut read_n,
            @default_init[*mut opaque](),
        )
    };
    if ok == 0 {
        let win_err: u32 = unsafe {
            sys.windows.win32_get_last_error()
        };
        if win_err == sys.windows.ERROR_BROKEN_PIPE or win_err == sys.windows.ERROR_HANDLE_EOF {
            return .Ok(0_usize);
        }
        return .Err(IoError.from_raw_os(@bit_cast[i32](win_err), domain: .Win32Error, op: .Read));
    }
    .Ok(read_n as usize)
}

/| Reads positionally at `offset` from a Win32 `HANDLE`.
@cfg(target.os == "windows") @std_cap_boundary(clears: [ffi, unsafe_op])
fn os_file_pread(fd_bits: isize, dst_ptr: *mut u8, cap: usize, offset: u64, /) -> usize!IoError {
    let raw_fd = fd_bits as *mut opaque;
    let chunk_u32: u32 = if cap > 0x7FFF_FFFF_usize => 0x7FFF_FFFF_u32 else cap as u32;
    var ov = @default_init[sys.windows.Win32Overlapped]();
    ov.offset_low = (offset & 0xFFFF_FFFF_u64) as u32;
    ov.offset_high = (offset >> 32_u64) as u32;
    var read_n = 0_u32;
    let ok: i32 = unsafe {
        sys.windows.win32_read_file(
            raw_fd,
            dst_ptr,
            chunk_u32,
            &raw mut read_n,
            (&raw mut ov) as *mut opaque,
        )
    };
    if ok == 0 {
        let win_err: u32 = unsafe {
            sys.windows.win32_get_last_error()
        };
        if win_err == sys.windows.ERROR_HANDLE_EOF or win_err == sys.windows.ERROR_BROKEN_PIPE {
            return .Ok(0_usize);
        }
        return .Err(IoError.from_raw_os(@bit_cast[i32](win_err), domain: .Win32Error, op: .Read));
    }
    .Ok(read_n as usize)
}

/| Writes sequentially to a Win32 `HANDLE`.
@cfg(target.os == "windows") @std_cap_boundary(clears: [ffi, unsafe_op])
fn os_file_write(fd_bits: isize, buf: &[u8], /) -> usize!IoError {
    let raw_fd = fd_bits as *mut opaque;
    if buf.is_empty() {
        return .Ok(0_usize);
    }
    let chunk_u32: u32 = if buf.len() > 0x7FFF_FFFF_usize => 0x7FFF_FFFF_u32 else buf.len() as u32;
    var wrote_n = 0_u32;
    let ok: i32 = unsafe {
        sys.windows.win32_write_file(
            raw_fd,
            buf.as_ptr(),
            chunk_u32,
            &raw mut wrote_n,
            @default_init[*mut opaque](),
        )
    };
    if ok == 0 {
        let win_err: u32 = unsafe {
            sys.windows.win32_get_last_error()
        };
        return .Err(IoError.from_raw_os(@bit_cast[i32](win_err), domain: .Win32Error, op: .Write));
    }
    .Ok(wrote_n as usize)
}

/| Writes positionally at `offset` to a Win32 `HANDLE`.
@cfg(target.os == "windows") @std_cap_boundary(clears: [ffi, unsafe_op])
fn os_file_pwrite(fd_bits: isize, buf: &[u8], offset: u64, /) -> usize!IoError {
    let raw_fd = fd_bits as *mut opaque;
    if buf.is_empty() {
        return .Ok(0_usize);
    }
    let chunk_u32: u32 = if buf.len() > 0x7FFF_FFFF_usize => 0x7FFF_FFFF_u32 else buf.len() as u32;
    var ov = @default_init[sys.windows.Win32Overlapped]();
    ov.offset_low = (offset & 0xFFFF_FFFF_u64) as u32;
    ov.offset_high = (offset >> 32_u64) as u32;
    var wrote_n = 0_u32;
    let ok: i32 = unsafe {
        sys.windows.win32_write_file(
            raw_fd,
            buf.as_ptr(),
            chunk_u32,
            &raw mut wrote_n,
            (&raw mut ov) as *mut opaque,
        )
    };
    if ok == 0 {
        let win_err: u32 = unsafe {
            sys.windows.win32_get_last_error()
        };
        return .Err(IoError.from_raw_os(@bit_cast[i32](win_err), domain: .Win32Error, op: .Write));
    }
    .Ok(wrote_n as usize)
}

/| Writes the first non-empty `IoSlice` on Windows (skipping leading empty slices per `STD-02` §1.1 / `rust#58452`).
@cfg(target.os == "windows")
fn os_file_write_vectored(fd_bits: isize, bufs: &[IoSlice], /) -> usize!IoError {
    let raw_fd = fd_bits as *mut opaque;
    for slice in bufs {
        if not slice.is_empty() {
            return os_file_write(raw_fd as isize, slice.as_slice());
        }
    }
    .Ok(0_usize)
}

/| Seeks a Win32 `HANDLE` via `SetFilePointerEx`.
@cfg(target.os == "windows") @std_cap_boundary(clears: [ffi, unsafe_op])
fn os_file_seek(fd_bits: isize, pos: SeekFrom, /) -> u64!IoError {
    let raw_fd = fd_bits as *mut opaque;
    let (dist_i64, method_u32) = match pos {
        .Start(abs_off) => {
            if abs_off > (i64.MAX as u64) {
                return .Err(IoError.from_kind(.InvalidInput, op: .Seek));
            }
            (abs_off as i64, sys.windows.FILE_BEGIN)
        },
        .Current(rel_off) => (rel_off, sys.windows.FILE_CURRENT),
        .End(end_off) => (end_off, sys.windows.FILE_END),
    };
    var new_pos = 0_i64;
    let ok: i32 = unsafe {
        sys.windows.win32_set_file_pointer_ex(raw_fd, dist_i64, &raw mut new_pos, method_u32)
    };
    if ok == 0 {
        let win_err: u32 = unsafe {
            sys.windows.win32_get_last_error()
        };
        return .Err(IoError.from_raw_os(@bit_cast[i32](win_err), domain: .Win32Error, op: .Seek));
    }
    .Ok(new_pos as u64)
}

/| Truncates or extends a Win32 `HANDLE` via `FileEndOfFileInfo` without disturbing the seek cursor.
@cfg(target.os == "windows") @std_cap_boundary(clears: [ffi, unsafe_op])
fn os_file_set_len(fd_bits: isize, size: u64, /) -> unit!FsError {
    let raw_fd = fd_bits as *mut opaque;
    if size > (i64.MAX as u64) {
        return .Err(FsError.from_kind(.InvalidInput, op: .Write));
    }
    let eof_i64 = size as i64;
    let ok: i32 = unsafe {
        sys.windows.win32_set_file_information_by_handle(
            raw_fd,
            WIN32_FILE_END_OF_FILE_INFO_CLASS,
            (&raw eof_i64) as *opaque,
            8_u32,
        )
    };
    if ok == 0 {
        return .Err(win32_last_fs_error(.Write, EMPTY_BYTES));
    }
    .Ok(())
}

/| Updates `FILE_ATTRIBUTE_READONLY` on a Win32 `HANDLE` via `FileBasicInfo`.
@cfg(target.os == "windows") @std_cap_boundary(clears: [ffi, unsafe_op])
fn os_file_set_permissions(fd_bits: isize, perms: FilePermissions, /) -> unit!FsError {
    let raw_fd = fd_bits as *mut opaque;
    var basic = @default_init[sys.windows.Win32FileBasicInfo]();
    basic.file_attributes = if perms.readonly => sys.windows.FILE_ATTRIBUTE_READONLY
        else sys.windows.FILE_ATTRIBUTE_NORMAL;
    let ok: i32 = unsafe {
        sys.windows.win32_set_file_information_by_handle(
            raw_fd,
            sys.windows.FILE_BASIC_INFO_CLASS,
            (&raw basic) as *opaque,
            @size_of[sys.windows.Win32FileBasicInfo]() as u32,
        )
    };
    if ok == 0 {
        return .Err(win32_last_fs_error(.Stat, EMPTY_BYTES));
    }
    .Ok(())
}

/| Flushes a Win32 `HANDLE` according to `mode` (`FastLocal` is a zero-syscall no-op).
@cfg(target.os == "windows") @std_cap_boundary(clears: [ffi, unsafe_op])
fn os_file_sync(fd_bits: isize, mode: DurabilityMode, /) -> unit!FsError {
    let raw_fd = fd_bits as *mut opaque;
    if mode == .FastLocal {
        return .Ok(());
    }
    let ok: i32 = unsafe {
        sys.windows.win32_flush_file_buffers(raw_fd)
    };
    if ok == 0 {
        let win_err: u32 = unsafe {
            sys.windows.win32_get_last_error()
        };
        if win_err == sys.windows.ERROR_ACCESS_DENIED {
            return .Ok(());
        }
        return .Err(FsError.from_raw_os(@bit_cast[i32](win_err), domain: .Win32Error, op: .Flush));
    }
    .Ok(())
}

/| Queries `Metadata` from an open Win32 `HANDLE`.
@cfg(target.os == "windows") @std_cap_boundary(clears: [ffi, unsafe_op])
fn os_file_metadata(fd_bits: isize, /) -> Metadata!FsError {
    let raw_fd = fd_bits as *mut opaque;
    let win_ftype: u32 = unsafe {
        sys.windows.win32_get_file_type(raw_fd)
    };
    if win_ftype == sys.windows.FILE_TYPE_CHAR or win_ftype == sys.windows.FILE_TYPE_PIPE {
        return .Ok(
            Metadata {
                file_type: if win_ftype == sys.windows.FILE_TYPE_CHAR => .CharDevice else .Fifo,
                size: 0_u64,
                permissions: FilePermissions.DEFAULT_FILE,
                modified: .None,
                accessed: .None,
                created: .None,
                dev_id: 0_u64,
                inode_or_file_id: 0_u64,
                hardlink_count: 1_u32,
            },
        );
    }
    var info = @default_init[sys.windows.Win32ByHandleFileInfo]();
    let ok: i32 = unsafe {
        sys.windows.win32_get_file_information_by_handle(raw_fd, &raw mut info)
    };
    if ok == 0 {
        return .Err(win32_last_fs_error(.Stat, EMPTY_BYTES));
    }
    var reparse_tag = 0_u32;
    if (info.file_attributes & sys.windows.FILE_ATTRIBUTE_REPARSE_POINT) != 0_u32 {
        var tag_info = @default_init[sys.windows.Win32FileAttributeTagInfo]();
        let tag_ok: i32 = unsafe {
            sys.windows.win32_get_file_information_by_handle_ex(
                raw_fd,
                sys.windows.FILE_ATTRIBUTE_TAG_INFO_CLASS,
                (&raw mut tag_info) as *mut opaque,
                @size_of[sys.windows.Win32FileAttributeTagInfo]() as u32,
            )
        };
        if tag_ok != 0 {
            reparse_tag = tag_info.reparse_tag;
        }
    }
    let ftype: FileType = classify_win32_attrs(info.file_attributes, reparse_tag, win_ftype);
    let size_u64: u64 = ((info.file_size_high as u64) << 32_u64) | (info.file_size_low as u64);
    var file_id: u64 = ((info.file_index_high as u64) << 32_u64) | (info.file_index_low as u64);
    var dev_u64 = info.volume_serial_number as u64;
    var id128 = @default_init[sys.windows.Win32FileIdInfo]();
    let id_ok: i32 = unsafe {
        sys.windows.win32_get_file_information_by_handle_ex(
            raw_fd,
            sys.windows.FILE_ID_INFO_CLASS,
            (&raw mut id128) as *mut opaque,
            @size_of[sys.windows.Win32FileIdInfo]() as u32,
        )
    };
    if id_ok != 0 {
        dev_u64 = id128.volume_serial_number;
        let lo64: u64 = @from_le_bytes[u64](id128.file_id_bytes[0..8]);
        let hi64: u64 = @from_le_bytes[u64](id128.file_id_bytes[8..16]);
        file_id = lo64 ^ (hi64 *% 0x9E37_79B9_7F4A_7C15_u64);
    }
    .Ok(
        Metadata {
            file_type: ftype,
            size: size_u64,
            permissions: perms_from_win32_attrs(info.file_attributes, ftype == .Directory),
            modified: win32_filetime_to_systime(info.last_write_time),
            accessed: win32_filetime_to_systime(info.last_access_time),
            created: win32_filetime_to_systime(info.creation_time),
            dev_id: dev_u64,
            inode_or_file_id: file_id,
            hardlink_count: info.number_of_links,
        },
    )
}

/| Opens a Win32 directory handle (`FILE_FLAG_BACKUP_SEMANTICS | FILE_SHARE_ALL`).
@cfg(target.os == "windows") @std_cap_boundary(clears: [ffi, unsafe_op])
fn os_dir_open(path_bytes: &[u8], /) -> isize!FsError {
    var wpath: Win32PathBuf = Win32PathBuf.encode(path_bytes, .AutoPromote, .Open)?;
    let handle: *mut opaque = unsafe {
        sys.windows.win32_create_file_w(
            wpath.as_ptr(),
            sys.windows.FILE_LIST_DIRECTORY
                | sys.windows.FILE_READ_ATTRIBUTES
                | sys.windows.SYNCHRONIZE_ACCESS,
            sys.windows.FILE_SHARE_ALL,
            @default_init[*sys.windows.Win32SecurityAttributes](),
            sys.windows.OPEN_EXISTING,
            sys.windows.FILE_FLAG_BACKUP_SEMANTICS,
            @default_init[*mut opaque](),
        )
    };
    wpath.deinit();
    if is_invalid_win_handle(handle) {
        return .Err(win32_last_fs_error(.Open, path_bytes));
    }
    var info = @default_init[sys.windows.Win32ByHandleFileInfo]();
    let stat_ok: i32 = unsafe {
        sys.windows.win32_get_file_information_by_handle(handle, &raw mut info)
    };
    if stat_ok == 0 or (info.file_attributes & sys.windows.FILE_ATTRIBUTE_DIRECTORY) == 0_u32 {
        unsafe {
            _ = sys.windows.win32_close_handle(handle);
        }
        return .Err(attach_failed_path(FsError.from_kind(.NotADirectory, op: .Open), path_bytes));
    }
    .Ok(handle as isize)
}

/| Walks single-component `NtCreateFile` segments beneath `root_dir` (`leaf_kind`: `0` = file, `1` = dir, `2` = any entry).
@std_cap_boundary(clears: [ffi, unsafe_op, may_panic])
fn win_nt_open_beneath(
    root_dir: *mut opaque,
    rel_bytes: &[u8],
    leaf_desired_access: u32,
    leaf_disposition: u32,
    leaf_kind: u8,
    leaf_file_attrs: u32,
    leaf_extra_opts: u32,
    reject_leaf_reparse: bool,
    op: IoOp,
    /,
) -> (*mut opaque)!FsError {
    validate_beneath_lexical(rel_bytes, op)?;
    var stack_u16: [u16; 520] = [0_u16; 520];
    var heap_u16: *mut u16 = @default_init[*mut u16]();
    var heap_cap = 0_usize;
    if rel_bytes.len() >= 512_usize {
        let cap: usize = if rel_bytes.len() +% 8_usize > 32_768_usize => 32_768_usize
            else rel_bytes.len() +% 8_usize;
        let mem: *mut u8 = System.handle().alloc(Layout { size: cap * 2_usize, alignment: 2_usize })
            catch {
                return .Err(attach_failed_path(FsError.from_kind(.OutOfMemory, op: op), rel_bytes));
            };
        heap_u16 = mem as *mut u16;
        heap_cap = cap;
    }
    let dst_slice: &mut [u16] = unsafe {
        if heap_u16.is_null() => @slice_from_raw_parts_mut(&raw mut stack_u16[0], 516_usize)
            else @slice_from_raw_parts_mut(heap_u16, heap_cap)
    };
    let rel_u16_len: usize = encode_wtf8_to_wtf16(rel_bytes, dst_slice) catch {
        if not heap_u16.is_null() {
            System
                .handle()
                .dealloc(
                    heap_u16 as *mut u8,
                    Layout { size: heap_cap * 2_usize, alignment: 2_usize },
                );
        }
        return .Err(attach_failed_path(FsError.from_kind(.InvalidFilename, op: op), rel_bytes));
    };
    let rel_u16_view: &[u16] = unsafe {
        @slice_from_raw_parts(dst_slice.as_ptr(), rel_u16_len)
    };

    var cur_dir: *mut opaque = root_dir;
    var pos = 0_usize;
    while pos < rel_u16_len {
        var seg_end: usize = pos;
        while seg_end < rel_u16_len {
            let ch16: u16 = u16_at(rel_u16_view, seg_end);
            if ch16 == 0x005C_u16 or ch16 == 0x002F_u16 {
                break;
            }
            if ch16 == 0x003A_u16 {
                if cur_dir != root_dir {
                    unsafe {
                        _ = sys.windows.win32_close_handle(cur_dir);
                    }
                }
                if not heap_u16.is_null() {
                    System
                        .handle()
                        .dealloc(
                            heap_u16 as *mut u8,
                            Layout { size: heap_cap * 2_usize, alignment: 2_usize },
                        );
                }
                return .Err(
                    attach_failed_path(FsError.from_kind(.FilesystemLoop, op: op), rel_bytes),
                );
            }
            seg_end = seg_end +% 1_usize;
        }
        let seg_slice: &[u16] = subslice_u16(rel_u16_view, pos, seg_end);
        var next_pos: usize = seg_end;
        while next_pos < rel_u16_len {
            let sep_ch: u16 = u16_at(rel_u16_view, next_pos);
            if sep_ch != 0x005C_u16 and sep_ch != 0x002F_u16 {
                break;
            }
            next_pos = next_pos +% 1_usize;
        }
        pos = next_pos;

        if seg_slice.is_empty()
            or (seg_slice.len() == 1_usize and u16_at(seg_slice, 0_usize) == 0x002E_u16) {
            continue;
        }
        if seg_slice.len() > 16_384_usize {
            if cur_dir != root_dir {
                unsafe {
                    _ = sys.windows.win32_close_handle(cur_dir);
                }
            }
            if not heap_u16.is_null() {
                System
                    .handle()
                    .dealloc(
                        heap_u16 as *mut u8,
                        Layout { size: heap_cap * 2_usize, alignment: 2_usize },
                    );
            }
            return .Err(attach_failed_path(FsError.from_kind(.InvalidFilename, op: op), rel_bytes));
        }

        let is_leaf: bool = pos >= rel_u16_len;
        let seg_bytes_u16 = (seg_slice.len() * 2_usize) as u16;
        let ustr = sys.windows.NtUnicodeString {
            byte_len: seg_bytes_u16,
            max_byte_len: seg_bytes_u16,
            buf_ptr: seg_slice.as_ptr() as *mut u16,
        };
        let obj_attrs = sys.windows.NtObjectAttributes {
            struct_bytes: @size_of[sys.windows.NtObjectAttributes]() as u32,
            root_directory: cur_dir,
            object_name: &raw ustr,
            attributes: sys.windows.OBJ_CASE_INSENSITIVE,
            security_descriptor: @default_init[*mut opaque](),
            security_qos: @default_init[*mut opaque](),
        };
        var io_status = @default_init[sys.windows.NtIoStatusBlock]();
        var next_handle = @default_init[*mut opaque]();
        let req_access: u32 = if is_leaf {
            leaf_desired_access | sys.windows.SYNCHRONIZE_ACCESS | sys.windows.FILE_READ_ATTRIBUTES
        } else {
            NT_FILE_TRAVERSE | sys.windows.SYNCHRONIZE_ACCESS | sys.windows.FILE_READ_ATTRIBUTES
        };
        let leaf_kind_opts: u32 = if leaf_kind == 1_u8 {
            sys.windows.FILE_DIRECTORY_FILE | NT_FILE_OPEN_FOR_BACKUP_INTENT
        } else if leaf_kind == 2_u8 {
            NT_FILE_OPEN_FOR_BACKUP_INTENT
        } else {
            sys.windows.FILE_NON_DIRECTORY_FILE
        };
        let create_opts: u32 = if is_leaf {
            sys.windows.FILE_SYNCHRONOUS_IO_NONALERT
                | sys.windows.FILE_OPEN_REPARSE_POINT
                | leaf_kind_opts
                | leaf_extra_opts
        } else {
            sys.windows.FILE_SYNCHRONOUS_IO_NONALERT
                | sys.windows.FILE_OPEN_REPARSE_POINT
                | NT_FILE_OPEN_FOR_BACKUP_INTENT
                | sys.windows.FILE_DIRECTORY_FILE
        };
        let disp: u32 = if is_leaf => leaf_disposition else sys.windows.FILE_OPEN;
        let attrs_u32: u32 = if is_leaf => leaf_file_attrs else sys.windows.FILE_ATTRIBUTE_NORMAL;

        let nt_rc: i32 = unsafe {
            sys.windows.nt_create_file(
                &raw mut next_handle,
                req_access,
                &raw obj_attrs,
                &raw mut io_status,
                @default_init[*i64](),
                attrs_u32,
                sys.windows.FILE_SHARE_ALL,
                disp,
                create_opts,
                @default_init[*opaque](),
                0_u32,
            )
        };
        if nt_rc < 0 {
            if cur_dir != root_dir {
                unsafe {
                    _ = sys.windows.win32_close_handle(cur_dir);
                }
            }
            if not heap_u16.is_null() {
                System
                    .handle()
                    .dealloc(
                        heap_u16 as *mut u8,
                        Layout { size: heap_cap * 2_usize, alignment: 2_usize },
                    );
            }
            return .Err(
                attach_failed_path(
                    FsError.from_raw_os(nt_rc, domain: .NtStatus, op: op),
                    rel_bytes,
                ),
            );
        }

        // Mandatory post-open `FileAttributeTagInfo` check rejecting junctions/symlinks/mount points:
        var tag_info = @default_init[sys.windows.Win32FileAttributeTagInfo]();
        let tag_ok: i32 = unsafe {
            sys.windows.win32_get_file_information_by_handle_ex(
                next_handle,
                sys.windows.FILE_ATTRIBUTE_TAG_INFO_CLASS,
                (&raw mut tag_info) as *mut opaque,
                @size_of[sys.windows.Win32FileAttributeTagInfo]() as u32,
            )
        };
        let has_reparse: bool = (tag_info.file_attributes & sys.windows.FILE_ATTRIBUTE_REPARSE_POINT)
            != 0_u32;
        let bad_reparse: bool = if is_leaf => reject_leaf_reparse and has_reparse else has_reparse;
        let bad_interm_dir: bool = not is_leaf
            and (tag_info.file_attributes & sys.windows.FILE_ATTRIBUTE_DIRECTORY) == 0_u32;
        if tag_ok == 0 or bad_reparse or bad_interm_dir {
            unsafe {
                _ = sys.windows.win32_close_handle(next_handle);
            }
            if cur_dir != root_dir {
                unsafe {
                    _ = sys.windows.win32_close_handle(cur_dir);
                }
            }
            if not heap_u16.is_null() {
                System
                    .handle()
                    .dealloc(
                        heap_u16 as *mut u8,
                        Layout { size: heap_cap * 2_usize, alignment: 2_usize },
                    );
            }
            return .Err(attach_failed_path(FsError.from_kind(.FilesystemLoop, op: op), rel_bytes));
        }

        if cur_dir != root_dir {
            unsafe {
                _ = sys.windows.win32_close_handle(cur_dir);
            }
        }
        if is_leaf {
            if not heap_u16.is_null() {
                System
                    .handle()
                    .dealloc(
                        heap_u16 as *mut u8,
                        Layout { size: heap_cap * 2_usize, alignment: 2_usize },
                    );
            }
            return .Ok(next_handle);
        }
        cur_dir = next_handle;
    }

    if cur_dir != root_dir {
        unsafe {
            _ = sys.windows.win32_close_handle(cur_dir);
        }
    }
    if not heap_u16.is_null() {
        System
            .handle()
            .dealloc(
                heap_u16 as *mut u8,
                Layout { size: heap_cap * 2_usize, alignment: 2_usize },
            );
    }
    .Err(attach_failed_path(FsError.from_kind(.InvalidInput, op: op), rel_bytes))
}

/| Opens a file strictly beneath `dir_fd` on Windows (`NtCreateFile` + reparse verification + optional lock).
@cfg(target.os == "windows")
fn os_open_file_beneath(dir_bits: isize, rel_bytes: &[u8], opts: OpenOptions, /) -> isize!FsError {
    var access = 0_u32;
    if opts.flags.read {
        access |= sys.windows.GENERIC_READ;
    }
    if opts.flags.append {
        access |= sys.windows.FILE_APPEND_DATA | sys.windows.FILE_WRITE_ATTRIBUTES;
        if opts.flags.truncate {
            access |= sys.windows.GENERIC_WRITE;
        }
    } else if opts.flags.write {
        access |= sys.windows.GENERIC_WRITE;
    }
    let nt_disp: u32 = if opts.flags.create_new => sys.windows.FILE_CREATE
        else if opts.flags.create and opts.flags.truncate => sys.windows.FILE_OVERWRITE_IF
        else if opts.flags.create => sys.windows.FILE_OPEN_IF
        else if opts.flags.truncate => sys.windows.FILE_OVERWRITE
        else sys.windows.FILE_OPEN;
    let file_attrs: u32 = if opts.permissions.readonly => sys.windows.FILE_ATTRIBUTE_READONLY
        else sys.windows.FILE_ATTRIBUTE_NORMAL;
    let extra_opts: u32 = if opts.flags.sync_data => NT_FILE_WRITE_THROUGH else 0_u32;
    let opened_handle: *mut opaque = win_nt_open_beneath(
        dir_bits as *mut opaque,
        rel_bytes,
        access,
        nt_disp,
        0_u8,
        file_attrs,
        extra_opts,
        true,
        .Open,
    )?;
    win32_lock_opened_handle(opened_handle, opts, rel_bytes)?;
    .Ok(opened_handle as isize)
}

/| Opens a subdirectory strictly beneath `dir_fd` on Windows.
@cfg(target.os == "windows")
fn os_open_dir_beneath(dir_bits: isize, rel_bytes: &[u8], /) -> isize!FsError {
    let opened_handle: *mut opaque = win_nt_open_beneath(
        dir_bits as *mut opaque,
        rel_bytes,
        sys.windows.FILE_LIST_DIRECTORY | sys.windows.FILE_READ_ATTRIBUTES,
        sys.windows.FILE_OPEN,
        1_u8,
        sys.windows.FILE_ATTRIBUTE_NORMAL,
        0_u32,
        true,
        .Open,
    )?;
    .Ok(opened_handle as isize)
}

/| Creates a subdirectory strictly beneath `dir_fd` on Windows.
@cfg(target.os == "windows") @std_cap_boundary(clears: [ffi, unsafe_op])
fn os_create_dir_beneath(dir_bits: isize, rel_bytes: &[u8], perms: FilePermissions, /) -> unit!FsError {
    _ = perms;
    let created_h: *mut opaque = win_nt_open_beneath(
        dir_bits as *mut opaque,
        rel_bytes,
        sys.windows.FILE_LIST_DIRECTORY,
        sys.windows.FILE_CREATE,
        1_u8,
        sys.windows.FILE_ATTRIBUTE_NORMAL,
        0_u32,
        true,
        .Mkdir,
    )?;
    unsafe {
        _ = sys.windows.win32_close_handle(created_h);
    }
    .Ok(())
}

/| Unlinks a regular file strictly beneath `dir_fd` on Windows (`FileDispositionInfoEx` POSIX delete).
@cfg(target.os == "windows") @std_cap_boundary(clears: [ffi, unsafe_op])
fn os_unlink_file_beneath(dir_bits: isize, rel_bytes: &[u8], /) -> unit!FsError {
    let target_h: *mut opaque = win_nt_open_beneath(
        dir_bits as *mut opaque,
        rel_bytes,
        sys.windows.DELETE_ACCESS,
        sys.windows.FILE_OPEN,
        0_u8,
        sys.windows.FILE_ATTRIBUTE_NORMAL,
        0_u32,
        true,
        .Unlink,
    )?;
    let disp_ex = sys.windows.Win32FileDispositionInfoEx {
        flags: sys.windows.FILE_DISPOSITION_FLAG_DELETE
            | sys.windows.FILE_DISPOSITION_FLAG_POSIX_SEMANTICS
            | sys.windows.FILE_DISPOSITION_FLAG_IGNORE_READONLY_ATTRIBUTE,
    };
    var del_ok: i32 = unsafe {
        sys.windows.win32_set_file_information_by_handle(
            target_h,
            sys.windows.FILE_DISPOSITION_INFO_EX_CLASS,
            (&raw disp_ex) as *opaque,
            4_u32,
        )
    };
    if del_ok == 0 {
        let legacy_disp = sys.windows.Win32FileDispositionInfo { delete_file: 1_u8 };
        del_ok = unsafe {
            sys.windows.win32_set_file_information_by_handle(
                target_h,
                sys.windows.FILE_DISPOSITION_INFO_CLASS,
                (&raw legacy_disp) as *opaque,
                1_u32,
            )
        };
    }
    let del_err: FsError = if del_ok == 0 => win32_last_fs_error(.Unlink, rel_bytes)
        else FsError.from_kind(.NotFound);
    unsafe {
        _ = sys.windows.win32_close_handle(target_h);
    }
    if del_ok == 0 {
        return .Err(del_err);
    }
    .Ok(())
}

/| Reads a relative NTFS symlink target (`IO_REPARSE_TAG_SYMLINK` + `SYMLINK_FLAG_RELATIVE`) via `FSCTL_GET_REPARSE_POINT`.
@cfg(target.os == "windows") @std_cap_boundary(clears: [ffi, unsafe_op, may_panic])
fn win32_read_relative_symlink_target(
    reparse_handle: *mut opaque,
    failed_bytes: &[u8],
    /,
) -> PathBuf!FsError {
    var stack_words: [u64; 260] = [0_u64; 260];
    let buf_ptr = (&raw mut stack_words[0]) as *mut u8;
    var bytes_ret = 0_u32;
    let io_ok: i32 = unsafe {
        sys.windows.win32_device_io_control(
            reparse_handle,
            WIN32_FSCTL_GET_REPARSE_POINT,
            @default_init[*opaque](),
            0_u32,
            buf_ptr as *mut opaque,
            2_080_u32,
            &raw mut bytes_ret,
            @default_init[*mut sys.windows.Win32Overlapped](),
        )
    };
    if io_ok == 0 or bytes_ret < 20_u32 or bytes_ret > 2_080_u32 {
        return .Err(attach_failed_path(FsError.from_kind(.FilesystemLoop, op: .Stat), failed_bytes));
    }
    let reparse_tag = (stack_words[0] & 0xFFFF_FFFF_u64) as u32;
    let symlink_flags = (stack_words[2] & 0xFFFF_FFFF_u64) as u32;
    if reparse_tag != sys.windows.IO_REPARSE_TAG_SYMLINK
        or (symlink_flags & WIN32_SYMLINK_FLAG_RELATIVE) == 0_u32 {
        return .Err(attach_failed_path(FsError.from_kind(.FilesystemLoop, op: .Stat), failed_bytes));
    }
    let sub_off = (stack_words[1] & 0xFFFF_u64) as usize;
    let sub_byte_len = ((stack_words[1] >> 16_u64) & 0xFFFF_u64) as usize;
    let start_byte: usize = 20_usize +% sub_off;
    if sub_byte_len == 0_usize
        or (sub_byte_len & 1_usize) != 0_usize
        or start_byte +% sub_byte_len > (bytes_ret as usize) {
        return .Err(attach_failed_path(FsError.from_kind(.FilesystemLoop, op: .Stat), failed_bytes));
    }
    let target_u16: &[u16] = unsafe {
        @slice_from_raw_parts(buf_ptr.add(start_byte) as *u16, sub_byte_len / 2_usize)
    };
    .Ok(decode_wtf16_to_path_buf(target_u16))
}

/| Queries metadata strictly beneath `dir_fd` on Windows (`lstat` when `not follow_symlinks`; confined relative hops otherwise).
@cfg(target.os == "windows") @std_cap_boundary(clears: [ffi, unsafe_op])
fn os_metadata_beneath(
    dir_bits: isize,
    rel_bytes: &[u8],
    follow_symlinks: bool,
    /,
) -> Metadata!FsError {
    let dir_fd = dir_bits as *mut opaque;
    validate_beneath_lexical(rel_bytes, .Stat)?;
    if not follow_symlinks {
        let nofollow_h: *mut opaque = win_nt_open_beneath(
            dir_fd,
            rel_bytes,
            sys.windows.FILE_READ_ATTRIBUTES,
            sys.windows.FILE_OPEN,
            2_u8,
            sys.windows.FILE_ATTRIBUTE_NORMAL,
            0_u32,
            false,
            .Stat,
        )?;
        let meta_out: Metadata!FsError = os_file_metadata(nofollow_h as isize);
        unsafe {
            _ = sys.windows.win32_close_handle(nofollow_h);
        }
        return meta_out;
    }

    var cur_pb = PathBuf.from(rel_bytes);
    var hops = 0_usize;
    while hops <= MAX_BENEATH_SYMLINK_HOPS {
        let entry_h: *mut opaque = win_nt_open_beneath(
            dir_fd,
            cur_pb.as_bytes(),
            sys.windows.FILE_READ_ATTRIBUTES,
            sys.windows.FILE_OPEN,
            2_u8,
            sys.windows.FILE_ATTRIBUTE_NORMAL,
            0_u32,
            false,
            .Stat,
        )?;
        var tag_info = @default_init[sys.windows.Win32FileAttributeTagInfo]();
        let tag_ok: i32 = unsafe {
            sys.windows.win32_get_file_information_by_handle_ex(
                entry_h,
                sys.windows.FILE_ATTRIBUTE_TAG_INFO_CLASS,
                (&raw mut tag_info) as *mut opaque,
                @size_of[sys.windows.Win32FileAttributeTagInfo]() as u32,
            )
        };
        if tag_ok != 0
            and (tag_info.file_attributes & sys.windows.FILE_ATTRIBUTE_REPARSE_POINT) == 0_u32 {
            let meta_res: Metadata!FsError = os_file_metadata(entry_h as isize);
            unsafe {
                _ = sys.windows.win32_close_handle(entry_h);
            }
            return meta_res;
        }
        if hops >= MAX_BENEATH_SYMLINK_HOPS {
            unsafe {
                _ = sys.windows.win32_close_handle(entry_h);
            }
            return .Err(
                attach_failed_path(FsError.from_kind(.FilesystemLoop, op: .Stat), rel_bytes),
            );
        }
        let target_res: PathBuf!FsError = win32_read_relative_symlink_target(entry_h, rel_bytes);
        unsafe {
            _ = sys.windows.win32_close_handle(entry_h);
        }
        let target_pb: PathBuf = target_res?;
        let next_pb: PathBuf = join_confined_symlink_target(
            cur_pb.as_bytes(),
            target_pb.as_bytes(),
            .Stat,
        )?;
        if next_pb.as_bytes().is_empty() {
            return os_file_metadata(dir_bits);
        }
        cur_pb = own next_pb;
        hops = hops +% 1_usize;
    }
    .Err(attach_failed_path(FsError.from_kind(.FilesystemLoop, op: .Stat), rel_bytes))
}

/| Starts directory enumeration on `dir_fd` via `GetFinalPathNameByHandleW` + `FindFirstFileExW`.
@cfg(target.os == "windows") @std_cap_boundary(clears: [ffi, unsafe_op, may_panic])
fn os_dir_entries(dir_bits: isize, /) -> (*mut opaque)!FsError {
    let dir_fd = dir_bits as *mut opaque;
    var stack_path: [u16; 1_040] = [0_u16; 1_040];
    let path_len: u32 = unsafe {
        sys.windows.win32_get_final_path_name_by_handle_w(
            dir_fd,
            &raw mut stack_path[0],
            1_024_u32,
            0_u32,
        )
    };
    if path_len == 0_u32 or path_len >= 1_020_u32 {
        return .Err(win32_last_fs_error(.Readdir, EMPTY_BYTES));
    }
    var pat_len = path_len as usize;
    let last_u16: u16 = unsafe {
        (&raw stack_path[0]).add(pat_len -% 1_usize).read()
    };
    if last_u16 != 0x005C_u16 and last_u16 != 0x002F_u16 {
        unsafe {
            (&raw mut stack_path[0]).add(pat_len).write(0x005C_u16);
        }
        pat_len = pat_len +% 1_usize;
    }
    unsafe {
        (&raw mut stack_path[0]).add(pat_len).write(0x002A_u16);
        (&raw mut stack_path[0]).add(pat_len +% 1_usize).write(0_u16);
    }

    let state_mem: *mut u8 = System
        .handle()
        .alloc(
            Layout { size: @size_of[WinDirIterState](), alignment: @align_of[WinDirIterState]() },
        ) catch {
        return .Err(FsError.from_kind(.OutOfMemory, op: .Readdir));
    };
    let state_ptr = state_mem as *mut WinDirIterState;
    if state_ptr.is_null() {
        return .Err(FsError.from_kind(.OutOfMemory, op: .Readdir));
    }
    unsafe {
        state_ptr.write(
            WinDirIterState {
                find_handle: sys.windows.INVALID_HANDLE_BITS as *mut opaque,
                find_data: @default_init[sys.windows.Win32FindDataW](),
                has_pending_first: false,
                is_finished: false,
            },
        );
    }
    let find_h: *mut opaque = unsafe {
        sys.windows.win32_find_first_file_ex_w(
            &raw stack_path[0],
            sys.windows.FIND_INFO_BASIC,
            &raw mut state_ptr.*.find_data,
            0,
            @default_init[*mut opaque](),
            sys.windows.FIND_FIRST_EX_LARGE_FETCH,
        )
    };
    if is_invalid_win_handle(find_h) {
        let win_err: u32 = unsafe {
            sys.windows.win32_get_last_error()
        };
        if win_err == sys.windows.ERROR_FILE_NOT_FOUND or win_err == WIN32_ERROR_NO_MORE_FILES {
            unsafe {
                state_ptr.*.is_finished = true;
            }
            return .Ok(state_ptr as *mut opaque);
        }
        System
            .handle()
            .dealloc(
                state_mem,
                Layout { size: @size_of[WinDirIterState](), alignment: @align_of[WinDirIterState]() },
            );
        return .Err(FsError.from_raw_os(@bit_cast[i32](win_err), domain: .Win32Error, op: .Readdir));
    }
    unsafe {
        state_ptr.*.find_handle = find_h;
        state_ptr.*.has_pending_first = true;
    }
    .Ok(state_ptr as *mut opaque)
}

/| Advances `WinDirIterState`, skipping `.` and `..` entries.
@cfg(target.os == "windows") @std_cap_boundary(clears: [ffi, unsafe_op])
fn os_dir_iter_next(raw_state: *mut opaque, /) -> DirEntry?!FsError {
    let state_ptr = raw_state as *mut WinDirIterState;
    if state_ptr.is_null() {
        return .Ok(.None);
    }
    let state: &mut WinDirIterState = unsafe {
        &mut state_ptr.*
    };
    while not state.is_finished {
        if state.has_pending_first {
            state.has_pending_first = false;
        } else {
            let next_ok: i32 = unsafe {
                sys.windows.win32_find_next_file_w(state.find_handle, &raw mut state.find_data)
            };
            if next_ok == 0 {
                let win_err: u32 = unsafe {
                    sys.windows.win32_get_last_error()
                };
                state.is_finished = true;
                if win_err == WIN32_ERROR_NO_MORE_FILES {
                    return .Ok(.None);
                }
                return .Err(
                    FsError.from_raw_os(@bit_cast[i32](win_err), domain: .Win32Error, op: .Readdir),
                );
            }
        }
        let name_ptr: *u16 = &raw state.find_data.file_name[0];
        let name_len: usize = wstr_len_bounded(name_ptr, 260_usize);
        let is_dot: bool = (
            name_len == 1_usize
                and unsafe {
                    name_ptr.read() == 0x002E_u16
                }
        )
            or (
                name_len == 2_usize
                    and unsafe {
                        name_ptr.read() == 0x002E_u16 and name_ptr.add(1_usize).read() == 0x002E_u16
                    }
            );
        if is_dot or name_len == 0_usize {
            continue;
        }
        let name_slice: &[u16] = unsafe {
            @slice_from_raw_parts(name_ptr, name_len)
        };
        let ftype: FileType = classify_win32_attrs(
            state.find_data.file_attributes,
            state.find_data.reserved0,
            sys.windows.FILE_TYPE_DISK,
        );
        return .Ok(
            .Some(
                DirEntry {
                    name: decode_wtf16_to_path_buf(name_slice),
                    file_type: ftype,
                    inode_or_file_id: 0_u64,
                },
            ),
        );
    }
    .Ok(.None)
}

/| Closes `FindFirstFileExW` and frees `WinDirIterState`.
@cfg(target.os == "windows") @std_cap_boundary(clears: [ffi, unsafe_op])
fn os_dir_iter_close(raw_state: *mut opaque, /) {
    let state_ptr = raw_state as *mut WinDirIterState;
    if state_ptr.is_null() {
        return;
    }
    let state_ref: &WinDirIterState = unsafe {
        &state_ptr.*
    };
    let find_h: *mut opaque = state_ref.find_handle;
    if not is_invalid_win_handle(find_h) {
        unsafe {
            _ = sys.windows.win32_find_close(find_h);
        }
    }
    System
        .handle()
        .dealloc(
            raw_state as *mut u8,
            Layout { size: @size_of[WinDirIterState](), alignment: @align_of[WinDirIterState]() },
        );
}

/| Maps a non-empty Win32 `File` read-only via `CreateFileMappingW` + `MapViewOfFile`.
@cfg(target.os == "windows") @std_cap_boundary(clears: [ffi, unsafe_op])
fn os_mmap_open_read_only(
    fd_bits: isize,
    len_bytes: usize,
    require_nul_sentinel: bool,
    /,
) -> Mmap!FsError {
    let raw_fd = fd_bits as *mut opaque;
    // Win32 zero-fills mapped pages up to `4 KiB`; exact page multiples fall back to `Arena` + `\0`:
    if require_nul_sentinel and (len_bytes & 4_095_usize) == 0_usize {
        return .Err(FsError.from_kind(.Unsupported, op: .Mmap));
    }
    let mapping_h: *mut opaque = unsafe {
        sys.windows.win32_create_file_mapping_w(
            raw_fd,
            @default_init[*sys.windows.Win32SecurityAttributes](),
            sys.windows.PAGE_READONLY,
            0_u32,
            0_u32,
            @default_init[*u16](),
        )
    };
    if mapping_h.is_null() {
        return .Err(win32_last_fs_error(.Mmap, EMPTY_BYTES));
    }
    let view_ptr: *mut opaque = unsafe {
        sys.windows.win32_map_view_of_file(
            mapping_h,
            sys.windows.FILE_MAP_READ,
            0_u32,
            0_u32,
            len_bytes,
        )
    };
    unsafe {
        _ = sys.windows.win32_close_handle(mapping_h);
    }
    if view_ptr.is_null() {
        return .Err(win32_last_fs_error(.Mmap, EMPTY_BYTES));
    }
    if require_nul_sentinel
        and unsafe {
            (view_ptr as *u8).add(len_bytes).read() != 0_u8
        } {
        unsafe {
            _ = sys.windows.win32_unmap_view_of_file(view_ptr);
        }
        return .Err(FsError.from_kind(.Unsupported, op: .Mmap));
    }
    .Ok(
        Mmap {
            ptr: view_ptr as *u8,
            len_bytes,
            map_cap: 1_usize,
        },
    )
}

/| Unmaps a Win32 view created by `MapViewOfFile`.
@cfg(target.os == "windows") @std_cap_boundary(clears: [ffi, unsafe_op])
fn os_mmap_close(ptr: *u8, map_cap: usize, /) {
    if map_cap != 0_usize and not ptr.is_null() {
        unsafe {
            _ = sys.windows.win32_unmap_view_of_file(ptr as *opaque);
        }
    }
}

/| Strips `\\?\` or converts `\\?\UNC\` -> `\\` on a `GetFinalPathNameByHandleW` slice unless verbatim promotion is required.
@std_cap_boundary(clears: [unsafe_op, may_panic])
fn trim_win32_final_path_u16(buf_ptr: *mut u16, raw_len: usize, /) -> &[u16] {
    let full_slice: &[u16] = unsafe {
        @slice_from_raw_parts(buf_ptr as *u16, raw_len)
    };
    if raw_len >= 8_usize
        and u16_at(full_slice, 0_usize) == 0x005C_u16
        and u16_at(
            full_slice,
            1_usize,
        )
            == 0x005C_u16
        and u16_at(full_slice, 2_usize) == 0x003F_u16
        and u16_at(
            full_slice,
            3_usize,
        )
            == 0x005C_u16
        and u16_at(full_slice, 4_usize) == 0x0055_u16
        and u16_at(
            full_slice,
            5_usize,
        )
            == 0x004E_u16
        and u16_at(full_slice, 6_usize) == 0x0043_u16
        and u16_at(
            full_slice,
            7_usize,
        )
            == 0x005C_u16 {
        unsafe {
            buf_ptr.add(6_usize).write(0x005C_u16);
        }
        let unc_cand: &[u16] = unsafe {
            @slice_from_raw_parts(buf_ptr.add(6_usize) as *u16, raw_len -% 6_usize)
        };
        if not should_promote_verbatim_win32(unc_cand) {
            return unc_cand;
        }
        unsafe {
            buf_ptr.add(6_usize).write(0x0043_u16);
        }
        return full_slice;
    }
    if raw_len >= 6_usize
        and u16_at(full_slice, 0_usize) == 0x005C_u16
        and u16_at(
            full_slice,
            1_usize,
        )
            == 0x005C_u16
        and u16_at(full_slice, 2_usize) == 0x003F_u16
        and u16_at(
            full_slice,
            3_usize,
        )
            == 0x005C_u16 {
        let dos_cand: &[u16] = subslice_u16(full_slice, 4_usize, raw_len);
        if not should_promote_verbatim_win32(dos_cand) {
            return dos_cand;
        }
    }
    full_slice
}

/| Returns `true` if `path_bytes` starts with `\\wsl` or `//wsl` (WSL Plan 9 network redirector).
fn is_wsl_plan9_path(path_bytes: &[u8], /) -> bool {
    if path_bytes.len() < 5_usize {
        return false;
    }
    let b0: u8 = byte_at(path_bytes, 0_usize);
    let b1: u8 = byte_at(path_bytes, 1_usize);
    let b2: u8 = byte_at(path_bytes, 2_usize) | 0x20_u8;
    let b3: u8 = byte_at(path_bytes, 3_usize) | 0x20_u8;
    let b4: u8 = byte_at(path_bytes, 4_usize) | 0x20_u8;
    (b0 == b'\\' or b0 == b'/')
        and (b1 == b'\\' or b1 == b'/')
        and b2 == b'w'
        and b3 == b's'
        and b4 == b'l'
}

/| Resolves canonical physical path on Windows (`GetFinalPathNameByHandleW` + WSL Plan 9 fallback, `STD-02` §1.2).
@cfg(target.os == "windows") @std_cap_boundary(clears: [ffi, unsafe_op])
fn os_resolve_path(path_bytes: &[u8], /) -> PathBuf!FsError {
    var wpath: Win32PathBuf = Win32PathBuf.encode(path_bytes, .AutoPromote, .Resolve)?;
    let handle: *mut opaque = unsafe {
        sys.windows.win32_create_file_w(
            wpath.as_ptr(),
            0_u32,
            sys.windows.FILE_SHARE_ALL,
            @default_init[*sys.windows.Win32SecurityAttributes](),
            sys.windows.OPEN_EXISTING,
            sys.windows.FILE_FLAG_BACKUP_SEMANTICS,
            @default_init[*mut opaque](),
        )
    };
    if is_invalid_win_handle(handle) {
        if is_wsl_plan9_path(path_bytes) {
            var attr_data = @default_init[sys.windows.Win32FileAttributeData]();
            let ex_ok: i32 = unsafe {
                sys.windows.win32_get_file_attributes_ex_w(wpath.as_ptr(), 0, &raw mut attr_data)
            };
            if ex_ok != 0 {
                wpath.deinit();
                return .Ok(Path.from_bytes(path_bytes).normalize_lexical());
            }
        }
        let open_err: FsError = win32_last_fs_error(.Resolve, path_bytes);
        wpath.deinit();
        return .Err(open_err);
    }

    var stack_out: [u16; 528] = [0_u16; 528];
    let len1: u32 = unsafe {
        sys.windows.win32_get_final_path_name_by_handle_w(
            handle,
            &raw mut stack_out[0],
            520_u32,
            0_u32,
        )
    };
    if len1 == 0_u32 {
        let final_err: FsError = win32_last_fs_error(.Resolve, path_bytes);
        unsafe {
            _ = sys.windows.win32_close_handle(handle);
        }
        if is_wsl_plan9_path(path_bytes) {
            wpath.deinit();
            return .Ok(Path.from_bytes(path_bytes).normalize_lexical());
        }
        wpath.deinit();
        return .Err(final_err);
    }
    wpath.deinit();

    if len1 < 520_u32 {
        unsafe {
            _ = sys.windows.win32_close_handle(handle);
        }
        let trimmed: &[u16] = trim_win32_final_path_u16(&raw mut stack_out[0], len1 as usize);
        return .Ok(decode_wtf16_to_path_buf(trimmed));
    }

    let cap_u16 = (len1 as usize) +% 8_usize;
    let dyn_mem: *mut u8 = System
        .handle()
        .alloc(
            Layout { size: cap_u16 * 2_usize, alignment: 2_usize },
        ) catch {
        unsafe {
            _ = sys.windows.win32_close_handle(handle);
        }
        return .Err(attach_failed_path(FsError.from_kind(.OutOfMemory, op: .Resolve), path_bytes));
    };
    let dyn_u16 = dyn_mem as *mut u16;
    let len2: u32 = unsafe {
        sys.windows.win32_get_final_path_name_by_handle_w(handle, dyn_u16, cap_u16 as u32, 0_u32)
    };
    unsafe {
        _ = sys.windows.win32_close_handle(handle);
    }
    if len2 == 0_u32 or (len2 as usize) >= cap_u16 {
        System.handle().dealloc(dyn_mem, Layout { size: cap_u16 * 2_usize, alignment: 2_usize });
        return .Err(win32_last_fs_error(.Resolve, path_bytes));
    }
    let trimmed_dyn: &[u16] = trim_win32_final_path_u16(dyn_u16, len2 as usize);
    let out_pb: PathBuf = decode_wtf16_to_path_buf(trimmed_dyn);
    System.handle().dealloc(dyn_mem, Layout { size: cap_u16 * 2_usize, alignment: 2_usize });
    .Ok(out_pb)
}

/| Queries path `Metadata` on Windows (following or not following terminal reparse points).
@cfg(target.os == "windows") @std_cap_boundary(clears: [ffi, unsafe_op])
fn os_path_metadata(path_bytes: &[u8], follow_symlinks: bool, /) -> Metadata!FsError {
    var wpath: Win32PathBuf = Win32PathBuf.encode(path_bytes, .AutoPromote, .Stat)?;
    var flags: u32 = sys.windows.FILE_FLAG_BACKUP_SEMANTICS;
    if not follow_symlinks {
        flags |= sys.windows.FILE_FLAG_OPEN_REPARSE_POINT;
    }
    let handle: *mut opaque = unsafe {
        sys.windows.win32_create_file_w(
            wpath.as_ptr(),
            sys.windows.FILE_READ_ATTRIBUTES,
            sys.windows.FILE_SHARE_ALL,
            @default_init[*sys.windows.Win32SecurityAttributes](),
            sys.windows.OPEN_EXISTING,
            flags,
            @default_init[*mut opaque](),
        )
    };
    if not is_invalid_win_handle(handle) {
        wpath.deinit();
        let meta_res: Metadata!FsError = os_file_metadata(handle as isize);
        unsafe {
            _ = sys.windows.win32_close_handle(handle);
        }
        return meta_res;
    }
    // Fallback to `GetFileAttributesExW` for locked system files (`pagefile.sys` / `hiberfil.sys`):
    var attr_data = @default_init[sys.windows.Win32FileAttributeData]();
    let ex_ok: i32 = unsafe {
        sys.windows.win32_get_file_attributes_ex_w(wpath.as_ptr(), 0, &raw mut attr_data)
    };
    let last_err: FsError = win32_last_fs_error(.Stat, path_bytes);
    wpath.deinit();
    if ex_ok == 0 {
        return .Err(last_err);
    }
    let is_dir: bool = (attr_data.file_attributes & sys.windows.FILE_ATTRIBUTE_DIRECTORY) != 0_u32;
    let ftype: FileType = classify_win32_attrs(
        attr_data.file_attributes,
        0_u32,
        sys.windows.FILE_TYPE_DISK,
    );
    .Ok(
        Metadata {
            file_type: ftype,
            size: ((attr_data.file_size_high as u64) << 32_u64) | (attr_data.file_size_low as u64),
            permissions: perms_from_win32_attrs(attr_data.file_attributes, is_dir),
            modified: win32_filetime_to_systime(attr_data.last_write_time),
            accessed: win32_filetime_to_systime(attr_data.last_access_time),
            created: win32_filetime_to_systime(attr_data.creation_time),
            dev_id: 0_u64,
            inode_or_file_id: 0_u64,
            hardlink_count: 1_u32,
        },
    )
}

/| Creates a single directory on Windows via `CreateDirectoryW`.
@cfg(target.os == "windows") @std_cap_boundary(clears: [ffi, unsafe_op])
fn os_mkdir_single(path_bytes: &[u8], perms: FilePermissions, /) -> unit!FsError {
    _ = perms;
    var wpath: Win32PathBuf = Win32PathBuf.encode(path_bytes, .AutoPromote, .Mkdir)?;
    let ok: i32 = unsafe {
        sys.windows.win32_create_directory_w(
            wpath.as_ptr(),
            @default_init[*sys.windows.Win32SecurityAttributes](),
        )
    };
    if ok == 0 {
        let err: FsError = win32_last_fs_error(.Mkdir, path_bytes);
        wpath.deinit();
        return .Err(err);
    }
    wpath.deinit();
    .Ok(())
}

/| Unlinks a file or file-symlink on Windows using `FileDispositionInfoEx` (`POSIX_SEMANTICS`) + `DeleteFileW` fallback.
@cfg(target.os == "windows") @std_cap_boundary(clears: [ffi, unsafe_op])
fn os_remove_file(path_bytes: &[u8], /) -> unit!FsError {
    var wpath: Win32PathBuf = Win32PathBuf.encode(path_bytes, .AutoPromote, .Unlink)?;
    let handle: *mut opaque = unsafe {
        sys.windows.win32_create_file_w(
            wpath.as_ptr(),
            sys.windows.DELETE_ACCESS | sys.windows.FILE_READ_ATTRIBUTES,
            sys.windows.FILE_SHARE_ALL,
            @default_init[*sys.windows.Win32SecurityAttributes](),
            sys.windows.OPEN_EXISTING,
            sys.windows.FILE_FLAG_OPEN_REPARSE_POINT,
            @default_init[*mut opaque](),
        )
    };
    if not is_invalid_win_handle(handle) {
        let disp_ex = sys.windows.Win32FileDispositionInfoEx {
            flags: sys.windows.FILE_DISPOSITION_FLAG_DELETE
                | sys.windows.FILE_DISPOSITION_FLAG_POSIX_SEMANTICS
                | sys.windows.FILE_DISPOSITION_FLAG_IGNORE_READONLY_ATTRIBUTE,
        };
        let ex_ok: i32 = unsafe {
            sys.windows.win32_set_file_information_by_handle(
                handle,
                sys.windows.FILE_DISPOSITION_INFO_EX_CLASS,
                (&raw disp_ex) as *opaque,
                4_u32,
            )
        };
        unsafe {
            _ = sys.windows.win32_close_handle(handle);
        }
        if ex_ok != 0 {
            wpath.deinit();
            return .Ok(());
        }
    }
    let attrs: u32 = unsafe {
        sys.windows.win32_get_file_attributes_w(wpath.as_ptr())
    };
    if attrs != sys.windows.INVALID_FILE_ATTRIBUTES {
        if (attrs & sys.windows.FILE_ATTRIBUTE_DIRECTORY) != 0_u32 {
            // Directory symlink / junction cannot be removed by `DeleteFileW`:
            if (attrs & sys.windows.FILE_ATTRIBUTE_REPARSE_POINT) != 0_u32 {
                let rm_junc: i32 = unsafe {
                    sys.windows.win32_remove_directory_w(wpath.as_ptr())
                };
                if rm_junc != 0 {
                    wpath.deinit();
                    return .Ok(());
                }
            }
            wpath.deinit();
            return .Err(
                attach_failed_path(FsError.from_kind(.IsADirectory, op: .Unlink), path_bytes),
            );
        }
        if (attrs & sys.windows.FILE_ATTRIBUTE_READONLY) != 0_u32 {
            unsafe {
                _ = sys.windows.win32_set_file_attributes_w(
                    wpath.as_ptr(),
                    attrs & ~sys.windows.FILE_ATTRIBUTE_READONLY,
                );
            }
        }
    }
    let del_ok: i32 = unsafe {
        sys.windows.win32_delete_file_w(wpath.as_ptr())
    };
    if del_ok == 0 {
        let del_err: FsError = win32_last_fs_error(.Unlink, path_bytes);
        wpath.deinit();
        return .Err(del_err);
    }
    wpath.deinit();
    .Ok(())
}

/| Removes an empty directory (or directory junction) on Windows via `RemoveDirectoryW`.
@cfg(target.os == "windows") @std_cap_boundary(clears: [ffi, unsafe_op])
fn os_remove_empty_dir(path_bytes: &[u8], /) -> unit!FsError {
    var wpath: Win32PathBuf = Win32PathBuf.encode(path_bytes, .AutoPromote, .Unlink)?;
    let attrs: u32 = unsafe {
        sys.windows.win32_get_file_attributes_w(wpath.as_ptr())
    };
    if attrs != sys.windows.INVALID_FILE_ATTRIBUTES
        and (attrs & sys.windows.FILE_ATTRIBUTE_READONLY) != 0_u32 {
        unsafe {
            _ = sys.windows.win32_set_file_attributes_w(
                wpath.as_ptr(),
                attrs & ~sys.windows.FILE_ATTRIBUTE_READONLY,
            );
        }
    }
    let ok: i32 = unsafe {
        sys.windows.win32_remove_directory_w(wpath.as_ptr())
    };
    if ok == 0 {
        let err: FsError = win32_last_fs_error(.Unlink, path_bytes);
        wpath.deinit();
        return .Err(err);
    }
    wpath.deinit();
    .Ok(())
}

/| Unlinks a staged Win32 temporary handle + path on error or `abort()` (`STD-02` §3.3).
@std_cap_boundary(clears: [ffi, unsafe_op])
fn win32_cleanup_staged_handle(tmp_handle: *mut opaque, tmp_bytes: &[u8], /) {
    if not is_invalid_win_handle(tmp_handle) {
        let disp_ex = sys.windows.Win32FileDispositionInfoEx {
            flags: sys.windows.FILE_DISPOSITION_FLAG_DELETE
                | sys.windows.FILE_DISPOSITION_FLAG_POSIX_SEMANTICS
                | sys.windows.FILE_DISPOSITION_FLAG_IGNORE_READONLY_ATTRIBUTE,
        };
        let ex_ok: i32 = unsafe {
            sys.windows.win32_set_file_information_by_handle(
                tmp_handle,
                sys.windows.FILE_DISPOSITION_INFO_EX_CLASS,
                (&raw disp_ex) as *opaque,
                4_u32,
            )
        };
        if ex_ok == 0 {
            let legacy = sys.windows.Win32FileDispositionInfo { delete_file: 1_u8 };
            unsafe {
                _ = sys.windows.win32_set_file_information_by_handle(
                    tmp_handle,
                    sys.windows.FILE_DISPOSITION_INFO_CLASS,
                    (&raw legacy) as *opaque,
                    1_u32,
                );
            }
        }
        unsafe {
            _ = sys.windows.win32_close_handle(tmp_handle);
        }
    }
    if Win32PathBuf.encode(tmp_bytes, .AutoPromote, .Unlink) is .Ok(var wtmp) {
        unsafe {
            _ = sys.windows.win32_delete_file_w(wtmp.as_ptr());
        }
        wtmp.deinit();
    }
}

/| Creates a fresh-inode `StagedAtomicFile` with `GENERIC_WRITE | DELETE` and `FILE_SHARE_ALL` on Windows (`STD-02` §3.3).
@cfg(target.os == "windows") @std_cap_boundary(clears: [ffi, unsafe_op])
fn os_staged_atomic_create(
    dst_bytes: &[u8],
    perms: FilePermissions,
    /,
) -> StagedAtomicFile!FsError {
    let dst_view = Path.from_bytes(dst_bytes);
    let (parent_dir, leaf_bytes) = split_parent_and_leaf(dst_view, .Open)?;
    var attempt = 0_u32;
    while attempt < 64_u32 {
        let tmp_pb: PathBuf = build_staged_tmp_path(parent_dir, leaf_bytes, attempt);
        var wtmp: Win32PathBuf = Win32PathBuf.encode(tmp_pb.as_bytes(), .AutoPromote, .Open)?;
        let handle: *mut opaque = unsafe {
            sys.windows.win32_create_file_w(
                wtmp.as_ptr(),
                sys.windows.GENERIC_WRITE | sys.windows.GENERIC_READ | sys.windows.DELETE_ACCESS,
                sys.windows.FILE_SHARE_ALL,
                @default_init[*sys.windows.Win32SecurityAttributes](),
                sys.windows.CREATE_NEW,
                sys.windows.FILE_ATTRIBUTE_NORMAL,
                @default_init[*mut opaque](),
            )
        };
        wtmp.deinit();
        if not is_invalid_win_handle(handle) {
            return .Ok(
                StagedAtomicFile {
                    file: File { raw_fd: bits_to_raw_fd(handle as isize) },
                    parent_dir_fd: -1_isize,
                    tmp_path: tmp_pb,
                    dst_path: PathBuf.from(dst_bytes),
                    perms,
                },
            );
        }
        let win_err: u32 = unsafe {
            sys.windows.win32_get_last_error()
        };
        if win_err != sys.windows.ERROR_FILE_EXISTS and win_err != sys.windows.ERROR_ALREADY_EXISTS {
            return .Err(
                attach_failed_path(
                    FsError.from_raw_os(@bit_cast[i32](win_err), domain: .Win32Error, op: .Open),
                    dst_bytes,
                ),
            );
        }
        attempt = attempt +% 1_u32;
    }
    .Err(attach_failed_path(FsError.from_kind(.AlreadyExists, op: .Open), dst_bytes))
}

/| Publishes an open `tmp_handle` atomically onto `dst_bytes` on Windows (`FileRenameInfoEx` + `POSIX_SEMANTICS` + AV retry, `STD-02` §3.3).
@std_cap_boundary(clears: [ffi, unsafe_op, may_panic])
fn win32_publish_handle_to_dst(
    var tmp_handle: *mut opaque,
    tmp_bytes: &[u8],
    dst_bytes: &[u8],
    perms: FilePermissions,
    durability: DurabilityMode,
    /,
) -> unit!FsError {
    if durability != .FastLocal {
        let flush_ok: i32 = unsafe {
            sys.windows.win32_flush_file_buffers(tmp_handle)
        };
        if flush_ok == 0 {
            let flush_err: FsError = win32_last_fs_error(.Flush, dst_bytes);
            win32_cleanup_staged_handle(tmp_handle, tmp_bytes);
            return .Err(flush_err);
        }
    }

    // `SetFileInformationByHandle(FileRenameInfoEx)` forwards directly to `NtSetInformationFile`,
    // which expects an NT-namespace `\??\C:\…` or `\??\UNC\…` path when `RootDirectory == null`:
    var nt_dst: Win32PathBuf = Win32PathBuf.encode(dst_bytes, .NtNamespace, .Rename) catch |enc_err| {
        win32_cleanup_staged_handle(tmp_handle, tmp_bytes);
        return .Err(enc_err);
    };
    var win_dst: Win32PathBuf = Win32PathBuf.encode(dst_bytes, .AutoPromote, .Rename) catch |enc_err2| {
        nt_dst.deinit();
        win32_cleanup_staged_handle(tmp_handle, tmp_bytes);
        return .Err(enc_err2);
    };

    let dst_byte_len: usize = nt_dst.len_u16 * 2_usize;
    let info_bytes = 20_usize +% dst_byte_len +% 2_usize;
    var stack_ren: [u64; 140] = [0_u64; 140];
    var heap_ren: *mut u8 = @default_init[*mut u8]();
    if info_bytes > 1_120_usize {
        heap_ren = System.handle().alloc(Layout { size: info_bytes, alignment: 8_usize }) catch {
            nt_dst.deinit();
            win_dst.deinit();
            win32_cleanup_staged_handle(tmp_handle, tmp_bytes);
            return .Err(attach_failed_path(FsError.from_kind(.OutOfMemory, op: .Rename), dst_bytes));
        };
    }
    let ren_base: *mut u8 = if heap_ren.is_null() => (&raw mut stack_ren[0]) as *mut u8
        else heap_ren;
    let ren_hdr = ren_base as *mut sys.windows.Win32FileRenameInfoHdr;
    if ren_hdr.is_null() {
        nt_dst.deinit();
        win_dst.deinit();
        win32_cleanup_staged_handle(tmp_handle, tmp_bytes);
        return .Err(FsError.from_kind(.InvalidInput, op: .Rename));
    }
    unsafe {
        ren_hdr.*.flags_or_replace = 0_u32;
        ren_hdr.*.reserved_pad = 0_u32;
        ren_hdr.*.root_directory = @default_init[*mut opaque]();
        ren_hdr.*.file_name_byte_len = dst_byte_len as u32;
        @memcpy(
            ren_base.add(20_usize) as *mut opaque,
            nt_dst.as_ptr() as *opaque,
            dst_byte_len +% 2_usize,
        );
    }

    var last_err: u32 = sys.windows.ERROR_SUCCESS;
    var attempt = 0_u32;
    while attempt < 6_u32 {
        unsafe {
            ren_hdr.*.flags_or_replace = sys.windows.FILE_RENAME_FLAG_REPLACE_IF_EXISTS
                | sys.windows.FILE_RENAME_FLAG_POSIX_SEMANTICS;
        }
        let ex_ok: i32 = unsafe {
            sys.windows.win32_set_file_information_by_handle(
                tmp_handle,
                sys.windows.FILE_RENAME_INFO_EX_CLASS,
                ren_base as *opaque,
                info_bytes as u32,
            )
        };
        if ex_ok != 0 {
            last_err = sys.windows.ERROR_SUCCESS;
            break;
        }
        last_err = unsafe {
            sys.windows.win32_get_last_error()
        };

        // Fallback 1: `FileRenameInfo` (`3`) on FAT32 / exFAT / SMB lacking `POSIX_SEMANTICS`:
        if last_err == sys.windows.ERROR_INVALID_PARAMETER
            or last_err == sys.windows.ERROR_NOT_SUPPORTED
            or last_err == WIN32_ERROR_INVALID_FUNCTION {
            unsafe {
                ren_hdr.*.flags_or_replace = 1_u32;
            }
            let leg_ok: i32 = unsafe {
                sys.windows.win32_set_file_information_by_handle(
                    tmp_handle,
                    sys.windows.FILE_RENAME_INFO_CLASS,
                    ren_base as *opaque,
                    info_bytes as u32,
                )
            };
            if leg_ok != 0 {
                last_err = sys.windows.ERROR_SUCCESS;
                break;
            }
            last_err = unsafe {
                sys.windows.win32_get_last_error()
            };
        }

        // Clear `FILE_ATTRIBUTE_READONLY` on existing target file on first `ERROR_ACCESS_DENIED`:
        if last_err == sys.windows.ERROR_ACCESS_DENIED and attempt == 0_u32 {
            let dst_attrs: u32 = unsafe {
                sys.windows.win32_get_file_attributes_w(win_dst.as_ptr())
            };
            if dst_attrs != sys.windows.INVALID_FILE_ATTRIBUTES
                and (dst_attrs & sys.windows.FILE_ATTRIBUTE_DIRECTORY) == 0_u32
                and (dst_attrs & sys.windows.FILE_ATTRIBUTE_READONLY) != 0_u32 {
                unsafe {
                    _ = sys.windows.win32_set_file_attributes_w(
                        win_dst.as_ptr(),
                        dst_attrs & ~sys.windows.FILE_ATTRIBUTE_READONLY,
                    );
                }
                attempt = attempt +% 1_u32;
                continue;
            }
        }

        if last_err != sys.windows.ERROR_ACCESS_DENIED
            and last_err != sys.windows.ERROR_SHARING_VIOLATION {
            break;
        }
        unsafe {
            sys.windows.win32_sleep(1_u32 << attempt);
        }
        attempt = attempt +% 1_u32;
    }

    if not heap_ren.is_null() {
        System.handle().dealloc(heap_ren, Layout { size: info_bytes, alignment: 8_usize });
    }
    nt_dst.deinit();

    // Fallback 2: Close `tmp_handle` and try `MoveFileExW` if network redirector rejected handle rename:
    if last_err != sys.windows.ERROR_SUCCESS {
        var win_tmp: Win32PathBuf = Win32PathBuf.encode(tmp_bytes, .AutoPromote, .Rename) catch |tmp_err| {
            win_dst.deinit();
            win32_cleanup_staged_handle(tmp_handle, tmp_bytes);
            return .Err(tmp_err);
        };
        unsafe {
            _ = sys.windows.win32_close_handle(tmp_handle);
        }
        tmp_handle = sys.windows.INVALID_HANDLE_BITS as *mut opaque;
        let mv_flags: u32 = sys.windows.MOVEFILE_REPLACE_EXISTING
            | (if durability == .PowerSafe => sys.windows.MOVEFILE_WRITE_THROUGH else 0_u32);
        let mv_ok: i32 = unsafe {
            sys.windows.win32_move_file_ex_w(win_tmp.as_ptr(), win_dst.as_ptr(), mv_flags)
        };
        if mv_ok != 0 {
            if perms.readonly {
                unsafe {
                    _ = sys.windows.win32_set_file_attributes_w(
                        win_dst.as_ptr(),
                        sys.windows.FILE_ATTRIBUTE_READONLY,
                    );
                }
            }
            win_tmp.deinit();
            win_dst.deinit();
            return .Ok(());
        }
        let mv_err: u32 = unsafe {
            sys.windows.win32_get_last_error()
        };
        unsafe {
            _ = sys.windows.win32_delete_file_w(win_tmp.as_ptr());
        }
        win_tmp.deinit();
        win_dst.deinit();
        return .Err(
            attach_failed_path(
                FsError.from_raw_os(@bit_cast[i32](mv_err), domain: .Win32Error, op: .Rename),
                dst_bytes,
            ),
        );
    }

    win_dst.deinit();
    if perms.readonly {
        var basic = @default_init[sys.windows.Win32FileBasicInfo]();
        basic.file_attributes = sys.windows.FILE_ATTRIBUTE_READONLY;
        unsafe {
            _ = sys.windows.win32_set_file_information_by_handle(
                tmp_handle,
                sys.windows.FILE_BASIC_INFO_CLASS,
                (&raw basic) as *opaque,
                @size_of[sys.windows.Win32FileBasicInfo]() as u32,
            );
        }
    }
    unsafe {
        _ = sys.windows.win32_close_handle(tmp_handle);
    }
    .Ok(())
}

/| Publishes a `StagedAtomicFile` on Windows (`FileRenameInfoEx` + `POSIX_SEMANTICS`).
@cfg(target.os == "windows")
fn os_staged_atomic_publish(
    staged: own StagedAtomicFile,
    durability: DurabilityMode,
    /,
) -> unit!FsError {
    let StagedAtomicFile { file, parent_dir_fd, tmp_path, dst_path, perms } = staged;
    _ = parent_dir_fd;
    let File { raw_fd } = file;
    win32_publish_handle_to_dst(
        raw_fd_to_bits(raw_fd) as *mut opaque,
        tmp_path.as_bytes(),
        dst_path.as_bytes(),
        perms,
        durability,
    )
}

/| Aborts and unlinks a `StagedAtomicFile` on Windows without modifying `dst_path`.
@cfg(target.os == "windows")
fn os_staged_atomic_abort(staged: own StagedAtomicFile, /) {
    let StagedAtomicFile { file, parent_dir_fd, tmp_path, dst_path, perms } = staged;
    _ = parent_dir_fd;
    _ = dst_path;
    _ = perms;
    let File { raw_fd } = file;
    win32_cleanup_staged_handle(raw_fd_to_bits(raw_fd) as *mut opaque, tmp_path.as_bytes());
}

/| Publishes an already-staged `staged_bytes` path onto `dst_bytes` on Windows.
@cfg(target.os == "windows") @std_cap_boundary(clears: [ffi, unsafe_op])
fn os_publish_staged_path(
    staged_bytes: &[u8],
    dst_bytes: &[u8],
    durability: DurabilityMode,
    /,
) -> unit!FsError {
    var wstaged: Win32PathBuf = Win32PathBuf.encode(staged_bytes, .AutoPromote, .Rename)?;
    let handle: *mut opaque = unsafe {
        sys.windows.win32_create_file_w(
            wstaged.as_ptr(),
            sys.windows.GENERIC_WRITE | sys.windows.DELETE_ACCESS | sys.windows.FILE_READ_ATTRIBUTES,
            sys.windows.FILE_SHARE_ALL,
            @default_init[*sys.windows.Win32SecurityAttributes](),
            sys.windows.OPEN_EXISTING,
            sys.windows.FILE_ATTRIBUTE_NORMAL,
            @default_init[*mut opaque](),
        )
    };
    wstaged.deinit();
    if is_invalid_win_handle(handle) {
        return .Err(win32_last_fs_error(.Rename, staged_bytes));
    }
    let cur_meta: Metadata = os_file_metadata(handle as isize) catch {
        Metadata {
            file_type: .RegularFile,
            size: 0_u64,
            permissions: FilePermissions.DEFAULT_FILE,
            modified: .None,
            accessed: .None,
            created: .None,
            dev_id: 0_u64,
            inode_or_file_id: 0_u64,
            hardlink_count: 1_u32,
        }
    };
    win32_publish_handle_to_dst(handle, staged_bytes, dst_bytes, cur_meta.permissions, durability)
}

/| Attempts ReFS `FSCTL_DUPLICATE_EXTENTS_TO_FILE` (`64 KiB` / `4 KiB` cluster alignment + tail write, `STD-02` §3.4A).
@std_cap_boundary(clears: [ffi, unsafe_op])
fn try_win32_refs_block_clone(
    src_handle: *mut opaque,
    dst_handle: *mut opaque,
    file_size: u64,
    cluster_size: u64,
    /,
) -> bool {
    if file_size == 0_u64 {
        return true;
    }
    let eof_i64 = file_size as i64;
    let eof_ok: i32 = unsafe {
        sys.windows.win32_set_file_information_by_handle(
            dst_handle,
            WIN32_FILE_END_OF_FILE_INFO_CLASS,
            (&raw eof_i64) as *opaque,
            8_u32,
        )
    };
    if eof_ok == 0 {
        return false;
    }
    let aligned_bytes: u64 = file_size & ~(cluster_size -% 1_u64);
    let max_chunk = 1_073_741_824_u64;
    var offset = 0_u64;
    while offset < aligned_bytes {
        let rem: u64 = aligned_bytes -% offset;
        let chunk: u64 = if rem < max_chunk => rem else max_chunk;
        let dup_req = sys.windows.Win32DuplicateExtentsData {
            source_handle: src_handle,
            source_file_offset: offset as i64,
            target_file_offset: offset as i64,
            byte_count: chunk as i64,
        };
        var bytes_ret = 0_u32;
        let io_ok: i32 = unsafe {
            sys.windows.win32_device_io_control(
                dst_handle,
                sys.windows.FSCTL_DUPLICATE_EXTENTS_TO_FILE,
                (&raw dup_req) as *opaque,
                @size_of[sys.windows.Win32DuplicateExtentsData]() as u32,
                @default_init[*mut opaque](),
                0_u32,
                &raw mut bytes_ret,
                @default_init[*mut sys.windows.Win32Overlapped](),
            )
        };
        if io_ok == 0 {
            let zero_eof = 0_i64;
            unsafe {
                _ = sys.windows.win32_set_file_information_by_handle(
                    dst_handle,
                    WIN32_FILE_END_OF_FILE_INFO_CLASS,
                    (&raw zero_eof) as *opaque,
                    8_u32,
                );
            }
            return false;
        }
        offset = offset +% chunk;
    }
    let tail_len = (file_size -% aligned_bytes) as usize;
    if tail_len > 0_usize {
        let page_ptr: *mut u8 = System.alloc_pages(COPY_CHUNK_BYTES) catch {
            return false;
        };
        let read_res: usize!IoError = os_file_pread(
            src_handle as isize,
            page_ptr,
            tail_len,
            aligned_bytes,
        );
        if read_res is .Ok(got_n) and got_n == tail_len {
            let tail_slice: &[u8] = unsafe {
                @slice_from_raw_parts(page_ptr as *u8, tail_len)
            };
            let write_res: usize!IoError = os_file_pwrite(
                dst_handle as isize,
                tail_slice,
                aligned_bytes,
            );
            System.free_pages(page_ptr, COPY_CHUNK_BYTES);
            if write_res is .Ok(put_n) {
                return put_n == tail_len;
            }
            return false;
        }
        System.free_pages(page_ptr, COPY_CHUNK_BYTES);
        return false;
    }
    true
}

/| Executes 3-tier `Reflink -> Hardlink -> 64 KiB Copy` materialization on Windows (`STD-02` §3.4A).
@cfg(target.os == "windows") @std_cap_boundary(clears: [ffi, unsafe_op])
fn os_materialize_file(
    src_bytes: &[u8],
    dst_bytes: &[u8],
    src_meta: Metadata,
    policy: MaterializePolicy,
    /,
) -> MaterializeMethod!FsError {
    // Tier 2 fast-path for `ImmutableCas` when ReFS isn't active or after Tier 1 probe:
    var src_file: File = File.open(Path.from_bytes(src_bytes))?;
    var staged: StagedAtomicFile = os_staged_atomic_create(dst_bytes, src_meta.permissions) catch |se| {
        src_file.close();
        return .Err(se);
    };

    // [1] Tier 1: ReFS `FSCTL_DUPLICATE_EXTENTS_TO_FILE` (`64 KiB` then `4 KiB` cluster probe):
    if src_meta.size >= 4_096_u64
        and (
            try_win32_refs_block_clone(
                raw_fd_to_bits(src_file.raw_fd) as *mut opaque,
                raw_fd_to_bits(staged.file.raw_fd) as *mut opaque,
                src_meta.size,
                65_536_u64,
            )
                or try_win32_refs_block_clone(
                    raw_fd_to_bits(src_file.raw_fd) as *mut opaque,
                    raw_fd_to_bits(staged.file.raw_fd) as *mut opaque,
                    src_meta.size,
                    4_096_u64,
                )
        ) {
        src_file.close();
        staged.publish(durability: .FastLocal)?;
        return .Ok(.Reflinked);
    }

    // [2] Tier 2: `CreateHardLinkW` into a staged sibling + atomic replace (`ImmutableCas`, `< 1023` links):
    if policy == .ImmutableCas and src_meta.hardlink_count < MAX_SAFE_HARDLINKS {
        src_file.close();
        staged.abort();
        let dst_view = Path.from_bytes(dst_bytes);
        let (parent_dir, leaf_bytes) = split_parent_and_leaf(dst_view, .Clone)?;
        let link_tmp: PathBuf = build_staged_tmp_path(parent_dir, leaf_bytes, 99_u32);
        var wsrc: Win32PathBuf = Win32PathBuf.encode(src_bytes, .AutoPromote, .Clone)?;
        var wtmp: Win32PathBuf = Win32PathBuf.encode(link_tmp.as_bytes(), .AutoPromote, .Clone) catch |we| {
            wsrc.deinit();
            return .Err(we);
        };
        let hl_ok: i32 = unsafe {
            sys.windows.win32_create_hard_link_w(
                wtmp.as_ptr(),
                wsrc.as_ptr(),
                @default_init[*mut opaque](),
            )
        };
        wsrc.deinit();
        wtmp.deinit();
        if hl_ok != 0 {
            if os_publish_staged_path(link_tmp.as_bytes(), dst_bytes, .FastLocal) is .Ok(_) {
                return .Ok(.Hardlinked);
            }
            os_remove_file(link_tmp.as_bytes()) catch {};
        }
        src_file = File.open(Path.from_bytes(src_bytes))?;
        staged = os_staged_atomic_create(dst_bytes, src_meta.permissions) catch |se2| {
            src_file.close();
            return .Err(se2);
        };
    }

    // [3] Tier 3: `64 KiB` streaming copy into `staged` + atomic `UnlinkAndReplace`:
    if copy_file_loop_64k(&mut src_file, &mut staged.file) is .Err(cp_err) {
        src_file.close();
        staged.abort();
        return .Err(cp_err);
    }
    src_file.close();
    staged.publish(durability: .FastLocal)?;
    .Ok(.Copied)
}

/| Acquires an advisory `LockFileEx` whole-file lock on Windows (`STD-02` §1.2).
@cfg(target.os == "windows") @std_cap_boundary(clears: [ffi, unsafe_op])
fn os_file_lock_acquire(
    path_bytes: &[u8],
    mode: LockMode,
    nonblocking: bool,
    /,
) -> FileLock!FsError {
    var wpath: Win32PathBuf = Win32PathBuf.encode(path_bytes, .AutoPromote, .Lock)?;
    let handle: *mut opaque = unsafe {
        sys.windows.win32_create_file_w(
            wpath.as_ptr(),
            sys.windows.GENERIC_READ | sys.windows.GENERIC_WRITE,
            sys.windows.FILE_SHARE_ALL,
            @default_init[*sys.windows.Win32SecurityAttributes](),
            sys.windows.OPEN_ALWAYS,
            sys.windows.FILE_ATTRIBUTE_NORMAL,
            @default_init[*mut opaque](),
        )
    };
    wpath.deinit();
    if is_invalid_win_handle(handle) {
        return .Err(win32_last_fs_error(.Lock, path_bytes));
    }
    var flags: u32 = if mode == .Exclusive => sys.windows.LOCKFILE_EXCLUSIVE_LOCK else 0_u32;
    if nonblocking {
        flags |= sys.windows.LOCKFILE_FAIL_IMMEDIATELY;
    }
    var ov = @default_init[sys.windows.Win32Overlapped]();
    let ok: i32 = unsafe {
        sys.windows.win32_lock_file_ex(
            handle,
            flags,
            0_u32,
            0xFFFF_FFFF_u32,
            0xFFFF_FFFF_u32,
            &raw mut ov,
        )
    };
    if ok == 0 {
        let win_err: u32 = unsafe {
            sys.windows.win32_get_last_error()
        };
        unsafe {
            _ = sys.windows.win32_close_handle(handle);
        }
        if win_err == sys.windows.ERROR_LOCK_VIOLATION
            or win_err == sys.windows.ERROR_SHARING_VIOLATION {
            return .Err(
                attach_failed_path(FsError.from_kind(.FileLockConflict, op: .Lock), path_bytes),
            );
        }
        return .Err(
            attach_failed_path(
                FsError.from_raw_os(@bit_cast[i32](win_err), domain: .Win32Error, op: .Lock),
                path_bytes,
            ),
        );
    }
    .Ok(FileLock { file: File { raw_fd: bits_to_raw_fd(handle as isize) } })
}

/| Releases a Win32 `LockFileEx` lock and closes the handle without unlinking the lockfile.
@cfg(target.os == "windows") @std_cap_boundary(clears: [ffi, unsafe_op])
fn os_file_lock_release(lock: own FileLock, /) {
    let FileLock { file } = lock;
    let File { raw_fd } = file;
    let handle = raw_fd_to_bits(raw_fd) as *mut opaque;
    if not is_invalid_win_handle(handle) {
        var ov = @default_init[sys.windows.Win32Overlapped]();
        unsafe {
            _ = sys.windows.win32_unlock_file_ex(
                handle,
                0_u32,
                0xFFFF_FFFF_u32,
                0xFFFF_FFFF_u32,
                &raw mut ov,
            );
            _ = sys.windows.win32_close_handle(handle);
        }
    }
}

/| Arms an overlapped `ReadDirectoryChangesW` call on `slot`.
@std_cap_boundary(clears: [ffi, unsafe_op])
fn win32_arm_watch_slot(slot_ptr: *mut WinWatchSlot, /) -> unit!FsError {
    if slot_ptr.is_null() {
        return .Ok(());
    }
    let slot: &mut WinWatchSlot = unsafe {
        &mut slot_ptr.*
    };
    if slot.is_armed or slot.overlapped_ptr.is_null() {
        return .Ok(());
    }
    unsafe {
        slot.overlapped_ptr.write(
            sys.windows.Win32Overlapped {
                internal_status: 0_usize,
                internal_high: 0_usize,
                offset_low: 0_u32,
                offset_high: 0_u32,
                event_handle: slot.event_handle,
            },
        );
    }
    var unused_bytes = 0_u32;
    let ok: i32 = unsafe {
        sys.windows.win32_read_directory_changes_w(
            slot.dir_handle,
            slot.notify_buf,
            COPY_CHUNK_BYTES as u32,
            if slot.mask.recursive and not slot.has_leaf_filter => 1 else 0,
            slot.notify_filter,
            &raw mut unused_bytes,
            slot.overlapped_ptr,
            @default_init[*mut opaque](),
        )
    };
    if ok == 0 {
        let win_err: u32 = unsafe {
            sys.windows.win32_get_last_error()
        };
        if win_err != sys.windows.ERROR_IO_PENDING {
            return .Err(
                FsError.from_raw_os(@bit_cast[i32](win_err), domain: .Win32Error, op: .Watch),
            );
        }
    }
    slot.is_armed = true;
    .Ok(())
}

/| Tears down handles and buffers owned by a single `WinWatchSlot`.
@std_cap_boundary(clears: [ffi, unsafe_op])
fn win32_free_watch_slot(slot_ptr: *mut WinWatchSlot, /) {
    if slot_ptr.is_null() {
        return;
    }
    let slot: &mut WinWatchSlot = unsafe {
        &mut slot_ptr.*
    };
    if not is_invalid_win_handle(slot.dir_handle) {
        if slot.is_armed and not slot.overlapped_ptr.is_null() {
            unsafe {
                _ = sys.windows.win32_cancel_io_ex(
                    slot.dir_handle,
                    slot.overlapped_ptr as *sys.windows.Win32Overlapped,
                );
                var dummy_bytes = 0_u32;
                _ = sys.windows.win32_get_overlapped_result(
                    slot.dir_handle,
                    slot.overlapped_ptr,
                    &raw mut dummy_bytes,
                    1,
                );
            }
        }
        unsafe {
            _ = sys.windows.win32_close_handle(slot.dir_handle);
        }
        slot.dir_handle = sys.windows.INVALID_HANDLE_BITS as *mut opaque;
    }
    if not slot.event_handle.is_null() {
        unsafe {
            _ = sys.windows.win32_close_handle(slot.event_handle);
        }
        slot.event_handle = @default_init[*mut opaque]();
    }
    if not slot.notify_buf.is_null() {
        System.free_pages(slot.notify_buf, COPY_CHUNK_BYTES);
        slot.notify_buf = @default_init[*mut u8]();
    }
    if not slot.overlapped_ptr.is_null() {
        System
            .handle()
            .dealloc(
                slot.overlapped_ptr as *mut u8,
                Layout {
                    size: @size_of[sys.windows.Win32Overlapped](),
                    alignment: @align_of[sys.windows.Win32Overlapped](),
                },
            );
        slot.overlapped_ptr = @default_init[*mut sys.windows.Win32Overlapped]();
    }
    slot.is_armed = false;
}

/| Allocates a new `WinWatcherState` on Windows.
@cfg(target.os == "windows") @std_cap_boundary(clears: [unsafe_op])
fn os_watcher_new() -> (*mut opaque)!FsError {
    let mem: *mut u8 = System
        .handle()
        .alloc(
            Layout { size: @size_of[WinWatcherState](), alignment: @align_of[WinWatcherState]() },
        ) catch {
        return .Err(FsError.from_kind(.OutOfMemory, op: .Watch));
    };
    let ptr = mem as *mut WinWatcherState;
    unsafe {
        @ptr_write(
            ptr,
            WinWatcherState {
                slots: Vec[WinWatchSlot].new(),
                next_watch_id: 1_u32,
                next_rename_cookie: 1_u32,
                pending_cookie: 0_u32,
            },
        );
    }
    .Ok(ptr as *mut opaque)
}

/| Registers `path_bytes` on a Windows `FsWatcher` (`ReadDirectoryChangesW` with `FILE_SHARE_ALL`).
@cfg(target.os == "windows") @std_cap_boundary(clears: [ffi, unsafe_op])
fn os_watcher_watch(
    backend_state: *mut opaque,
    path_bytes: &[u8],
    mask: WatchMask,
    /,
) -> WatchId!FsError {
    let state_ptr = backend_state as *mut WinWatcherState;
    if state_ptr.is_null() {
        return .Err(FsError.from_kind(.InvalidInput, op: .Watch));
    }
    let state: &mut WinWatcherState = unsafe {
        &mut state_ptr.*
    };
    if state.slots.len() >= MAX_WATCH_ENTRIES {
        return .Err(FsError.from_kind(.OutOfMemory, op: .Watch));
    }
    let target_meta: Metadata = os_path_metadata(path_bytes, true)?;
    let target_path = Path.from_bytes(path_bytes);
    var dir_to_open = PathBuf.from(path_bytes);
    var leaf_filter = PathBuf.new();
    var has_leaf = false;
    if not target_meta.is_dir() {
        let (parent_view, leaf_bytes) = split_parent_and_leaf(target_path, .Watch)?;
        dir_to_open = parent_view.to_path_buf();
        leaf_filter = PathBuf.from(leaf_bytes);
        has_leaf = true;
    }

    var wdir: Win32PathBuf = Win32PathBuf.encode(dir_to_open.as_bytes(), .AutoPromote, .Watch)?;
    let dir_h: *mut opaque = unsafe {
        sys.windows.win32_create_file_w(
            wdir.as_ptr(),
            sys.windows.FILE_LIST_DIRECTORY,
            sys.windows.FILE_SHARE_ALL,
            @default_init[*sys.windows.Win32SecurityAttributes](),
            sys.windows.OPEN_EXISTING,
            sys.windows.FILE_FLAG_BACKUP_SEMANTICS | sys.windows.FILE_FLAG_OVERLAPPED,
            @default_init[*mut opaque](),
        )
    };
    wdir.deinit();
    if is_invalid_win_handle(dir_h) {
        return .Err(win32_last_fs_error(.Watch, path_bytes));
    }

    let evt_h: *mut opaque = unsafe {
        sys.windows.win32_create_event_w(
            @default_init[*sys.windows.Win32SecurityAttributes](),
            1,
            0,
            @default_init[*u16](),
        )
    };
    if evt_h.is_null() {
        let evt_err: FsError = win32_last_fs_error(.Watch, path_bytes);
        unsafe {
            _ = sys.windows.win32_close_handle(dir_h);
        }
        return .Err(evt_err);
    }

    let notify_buf: *mut u8 = System.alloc_pages(COPY_CHUNK_BYTES) catch {
        unsafe {
            _ = sys.windows.win32_close_handle(evt_h);
            _ = sys.windows.win32_close_handle(dir_h);
        }
        return .Err(FsError.from_kind(.OutOfMemory, op: .Watch));
    };
    let ov_mem: *mut u8 = System
        .handle()
        .alloc(
            Layout {
                size: @size_of[sys.windows.Win32Overlapped](),
                alignment: @align_of[sys.windows.Win32Overlapped](),
            },
        ) catch {
        System.free_pages(notify_buf, COPY_CHUNK_BYTES);
        unsafe {
            _ = sys.windows.win32_close_handle(evt_h);
            _ = sys.windows.win32_close_handle(dir_h);
        }
        return .Err(FsError.from_kind(.OutOfMemory, op: .Watch));
    };

    var filter_bits = 0_u32;
    if mask.create or mask.remove or mask.rename {
        filter_bits |= sys.windows.FILE_NOTIFY_CHANGE_FILE_NAME
            | sys.windows.FILE_NOTIFY_CHANGE_DIR_NAME;
    }
    if mask.modify {
        filter_bits |= sys.windows.FILE_NOTIFY_CHANGE_LAST_WRITE
            | sys.windows.FILE_NOTIFY_CHANGE_SIZE;
    }
    if mask.attrib {
        filter_bits |= sys.windows.FILE_NOTIFY_CHANGE_ATTRIBUTES;
    }
    if filter_bits == 0_u32 {
        filter_bits = sys.windows.FILE_NOTIFY_CHANGE_FILE_NAME
            | sys.windows.FILE_NOTIFY_CHANGE_LAST_WRITE;
    }

    let assigned_id: u32 = state.next_watch_id;
    state.next_watch_id = state.next_watch_id +% 1_u32;
    var slot = WinWatchSlot {
        watch_id: assigned_id,
        dir_handle: dir_h,
        event_handle: evt_h,
        notify_buf,
        overlapped_ptr: ov_mem as *mut sys.windows.Win32Overlapped,
        root_path: dir_to_open,
        leaf_filter,
        has_leaf_filter: has_leaf,
        mask,
        notify_filter: filter_bits,
        is_armed: false,
    };
    if win32_arm_watch_slot(&raw mut slot) is .Err(arm_err) {
        win32_free_watch_slot(&raw mut slot);
        return .Err(arm_err);
    }
    state.slots.push(own slot);
    .Ok(assigned_id as WatchId)
}

/| Removes an active registration by `WatchId` from `WinWatcherState`.
@cfg(target.os == "windows") @std_cap_boundary(clears: [unsafe_op, may_panic])
fn os_watcher_unwatch(backend_state: *mut opaque, id: WatchId, /) -> unit!FsError {
    let state_ptr = backend_state as *mut WinWatcherState;
    if state_ptr.is_null() {
        return .Err(FsError.from_kind(.InvalidInput, op: .Watch));
    }
    let state: &mut WinWatcherState = unsafe {
        &mut state_ptr.*
    };
    let target_u32 = id as u32;
    var idx = 0_usize;
    while idx < state.slots.len() {
        if state.slots[idx].watch_id == target_u32 {
            var removed: WinWatchSlot = state.slots.swap_remove(idx);
            win32_free_watch_slot(&raw mut removed);
            return .Ok(());
        }
        idx = idx +% 1_usize;
    }
    .Err(FsError.from_kind(.NotFound, op: .Watch))
}

/| Polls armed `WinWatchSlot`s and appends decoded `WatchEvent`s into `out_events`.
@cfg(target.os == "windows") @std_cap_boundary(clears: [ffi, unsafe_op, may_panic])
fn os_watcher_poll(
    backend_state: *mut opaque,
    out_events: &mut Vec[WatchEvent],
    timeout: Duration?,
    /,
) -> usize!FsError {
    let state_ptr = backend_state as *mut WinWatcherState;
    if state_ptr.is_null() {
        return .Ok(0_usize);
    }
    let state: &mut WinWatcherState = unsafe {
        &mut state_ptr.*
    };
    if state.slots.is_empty() {
        return .Ok(0_usize);
    }

    let deadline_opt: Instant? = match timeout {
        .Some(dur) => .Some(Instant.now().saturating_add(dur)),
        .None => .None,
    };
    var emitted = 0_usize;
    while true {
        var slot_idx = 0_usize;
        while slot_idx < state.slots.len() {
            let wait_rc: u32 = unsafe {
                sys.windows.win32_wait_for_single_object(state.slots[slot_idx].event_handle, 0_u32)
            };
            if wait_rc == sys.windows.WAIT_OBJECT_0 {
                var transferred = 0_u32;
                let ov_ok: i32 = unsafe {
                    sys.windows.win32_get_overlapped_result(
                        state.slots[slot_idx].dir_handle,
                        state.slots[slot_idx].overlapped_ptr,
                        &raw mut transferred,
                        0,
                    )
                };
                state.slots[slot_idx].is_armed = false;
                let slot_wid = state.slots[slot_idx].watch_id as WatchId;
                if ov_ok == 0 {
                    let ov_err: u32 = unsafe {
                        sys.windows.win32_get_last_error()
                    };
                    if ov_err == WIN32_ERROR_NOTIFY_ENUM_DIR {
                        out_events.push(
                            WatchEvent {
                                watch_id: slot_wid,
                                path: state.slots[slot_idx].root_path.clone(),
                                flags: WatchEventFlags {
                                    created: false,
                                    modified: false,
                                    removed: false,
                                    renamed_from: false,
                                    renamed_to: false,
                                    attrib: false,
                                    is_dir: true,
                                    rescan_required: true,
                                    reserved: 0_u8,
                                },
                                rename_cookie: 0_u32,
                            },
                        );
                        emitted = emitted +% 1_usize;
                    }
                } else if transferred == 0_u32 {
                    out_events.push(
                        WatchEvent {
                            watch_id: slot_wid,
                            path: state.slots[slot_idx].root_path.clone(),
                            flags: WatchEventFlags {
                                created: false,
                                modified: false,
                                removed: false,
                                renamed_from: false,
                                renamed_to: false,
                                attrib: false,
                                is_dir: true,
                                rescan_required: true,
                                reserved: 0_u8,
                            },
                            rename_cookie: 0_u32,
                        },
                    );
                    emitted = emitted +% 1_usize;
                } else {
                    var byte_off = 0_usize;
                    let raw_transferred = transferred as usize;
                    let max_bytes: usize = if raw_transferred > COPY_CHUNK_BYTES => COPY_CHUNK_BYTES
                        else raw_transferred;
                    let base_buf = state.slots[slot_idx].notify_buf as *u8;
                    while byte_off +% 12_usize <= max_bytes {
                        let rec_ptr = unsafe {
                            base_buf.add(byte_off) as *sys.windows.Win32FileNotifyInformationHdr
                        };
                        let rec_val: sys.windows.Win32FileNotifyInformationHdr = unsafe {
                            rec_ptr.read()
                        };
                        let next_step = rec_val.next_entry_offset as usize;
                        let action_code: u32 = rec_val.action;
                        let name_bytes = rec_val.file_name_byte_len as usize;
                        if name_bytes <= max_bytes -| (byte_off +% 12_usize) {
                            let name_u16_slice: &[u16] = unsafe {
                                @slice_from_raw_parts(
                                    base_buf.add(byte_off +% 12_usize) as *u16,
                                    name_bytes / 2_usize,
                                )
                            };
                            let rel_pb: PathBuf = decode_wtf16_to_path_buf(name_u16_slice);
                            let matches_leaf: bool = if state.slots[slot_idx].has_leaf_filter {
                                rel_pb.as_path() == state.slots[slot_idx].leaf_filter.as_path()
                            } else {
                                true
                            };
                            if matches_leaf {
                                let full_pb: PathBuf = state
                                    .slots[slot_idx]
                                    .root_path
                                    .as_path()
                                    .join(rel_pb.as_path());
                                var cookie = 0_u32;
                                if action_code == sys.windows.FILE_ACTION_RENAMED_OLD_NAME {
                                    cookie = state.next_rename_cookie;
                                    state.next_rename_cookie = state.next_rename_cookie +% 1_u32;
                                    state.pending_cookie = cookie;
                                } else if action_code == sys.windows.FILE_ACTION_RENAMED_NEW_NAME {
                                    cookie = state.pending_cookie;
                                    state.pending_cookie = 0_u32;
                                }
                                let ev_flags = WatchEventFlags {
                                    created: action_code == sys.windows.FILE_ACTION_ADDED,
                                    modified: action_code == sys.windows.FILE_ACTION_MODIFIED,
                                    removed: action_code == sys.windows.FILE_ACTION_REMOVED,
                                    renamed_from: action_code
                                        == sys.windows.FILE_ACTION_RENAMED_OLD_NAME,
                                    renamed_to: action_code
                                        == sys.windows.FILE_ACTION_RENAMED_NEW_NAME,
                                    attrib: false,
                                    is_dir: false,
                                    rescan_required: false,
                                    reserved: 0_u8,
                                };
                                out_events.push(
                                    WatchEvent {
                                        watch_id: slot_wid,
                                        path: full_pb,
                                        flags: ev_flags,
                                        rename_cookie: cookie,
                                    },
                                );
                                emitted = emitted +% 1_usize;
                            }
                        }
                        if next_step == 0_usize
                            or next_step < 12_usize
                            or next_step > max_bytes -| byte_off {
                            break;
                        }
                        byte_off = byte_off +% next_step;
                    }
                }
                let arm_ptr: *mut WinWatchSlot = unsafe {
                    state.slots.as_mut_ptr().add(slot_idx)
                };
                win32_arm_watch_slot(arm_ptr)?;
            }
            slot_idx = slot_idx +% 1_usize;
        }

        if emitted > 0_usize {
            return .Ok(emitted);
        }
        if deadline_opt is .Some(deadline) {
            let now_inst = Instant.now();
            if now_inst >= deadline {
                return .Ok(0_usize);
            }
            let rem_ms: u64 = deadline.duration_since(now_inst).as_millis();
            let sleep_ms: u32 = if rem_ms == 0_u64 => 1_u32
                else if rem_ms > 5_u64 => 5_u32
                else rem_ms as u32;
            unsafe {
                sys.windows.win32_sleep(sleep_ms);
            }
        } else if state.slots.len() == 1_usize {
            unsafe {
                _ = sys.windows.win32_wait_for_single_object(
                    state.slots[0_usize].event_handle,
                    sys.windows.INFINITE_TIMEOUT,
                );
            }
        } else {
            unsafe {
                sys.windows.win32_sleep(2_u32);
            }
        }
    }
    .Ok(emitted)
}

/| Closes all watched handles and releases `WinWatcherState`.
@cfg(target.os == "windows") @std_cap_boundary(clears: [unsafe_op, may_panic])
fn os_watcher_close(backend_state: *mut opaque, /) {
    let state_ptr = backend_state as *mut WinWatcherState;
    if state_ptr.is_null() {
        return;
    }
    let state: &mut WinWatcherState = unsafe {
        &mut state_ptr.*
    };
    var idx = 0_usize;
    while idx < state.slots.len() {
        let free_ptr: *mut WinWatchSlot = unsafe {
            state.slots.as_mut_ptr().add(idx)
        };
        win32_free_watch_slot(free_ptr);
        idx = idx +% 1_usize;
    }
    unsafe {
        @drop_in_place(state_ptr);
    }
    System
        .handle()
        .dealloc(
            backend_state as *mut u8,
            Layout { size: @size_of[WinWatcherState](), alignment: @align_of[WinWatcherState]() },
        );
}

// ----------------- Posix Shared C-String Buf ------------------
impl PosixCStrBuf {
    /| Copies `path_bytes` into a NUL-terminated buffer (`[u8; 1024]` stack fast path), rejecting empty or interior-NUL inputs.
    @std_cap_boundary(clears: [unsafe_op, may_panic])
    fn encode(path_bytes: &[u8], op: IoOp, /) -> PosixCStrBuf!FsError {
        if path_bytes.is_empty() {
            return .Err(FsError.from_kind(.NotFound, op: op));
        }
        if has_interior_nul(path_bytes) {
            return .Err(attach_failed_path(FsError.from_kind(.InvalidFilename, op: op), path_bytes));
        }
        let src_len: usize = path_bytes.len();
        if src_len >= 65_535_usize {
            return .Err(attach_failed_path(FsError.from_kind(.InvalidFilename, op: op), path_bytes));
        }
        var out_buf = PosixCStrBuf {
            stack_bytes: [0_u8; 1_024],
            heap_ptr: @default_init[*mut u8](),
            heap_cap: 0_usize,
            byte_len: src_len,
        };
        if src_len < 1_024_usize {
            unsafe {
                @memcpy(
                    (&raw mut out_buf.stack_bytes[0]) as *mut opaque,
                    path_bytes.as_ptr() as *opaque,
                    src_len,
                );
                (&raw mut out_buf.stack_bytes[0]).add(src_len).write(0_u8);
            }
            return .Ok(out_buf);
        }
        let need_cap: usize = src_len +% 1_usize;
        let dyn_ptr: *mut u8 = System.handle().alloc(Layout { size: need_cap, alignment: 1_usize })
            catch {
                return .Err(attach_failed_path(FsError.from_kind(.OutOfMemory, op: op), path_bytes));
            };
        unsafe {
            @memcpy(dyn_ptr as *mut opaque, path_bytes.as_ptr() as *opaque, src_len);
            dyn_ptr.add(src_len).write(0_u8);
        }
        out_buf.heap_ptr = dyn_ptr;
        out_buf.heap_cap = need_cap;
        .Ok(out_buf)
    }

    /| Returns the NUL-terminated `*u8` pointer for POSIX syscalls.
    fn as_ptr(&self) -> *u8 {
        if self.heap_ptr.is_null() {
            return &raw self.stack_bytes[0];
        }
        self.heap_ptr as *u8
    }

    /| Releases any overflow `System` buffer owned by `self`.
    fn deinit(&mut self) {
        if not self.heap_ptr.is_null() and self.heap_cap > 0_usize {
            System
                .handle()
                .dealloc(
                    self.heap_ptr,
                    Layout { size: self.heap_cap, alignment: 1_usize },
                );
            self.heap_ptr = @default_init[*mut u8]();
            self.heap_cap = 0_usize;
        }
    }
}

/| Classifies POSIX `S_IFMT` mode bits (`u32`) into `FileType`.
fn classify_posix_mode(mode_bits: u32, /) -> FileType {
    let kind_bits: u32 = mode_bits & 0o170_000_u32;
    if kind_bits == 0o100_000_u32 {
        return .RegularFile;
    }
    if kind_bits == 0o040_000_u32 {
        return .Directory;
    }
    if kind_bits == 0o120_000_u32 {
        return .Symlink;
    }
    if kind_bits == 0o010_000_u32 {
        return .Fifo;
    }
    if kind_bits == 0o140_000_u32 {
        return .Socket;
    }
    if kind_bits == 0o020_000_u32 {
        return .CharDevice;
    }
    if kind_bits == 0o060_000_u32 {
        return .BlockDevice;
    }
    .Unknown
}

/| Classifies POSIX `dirent.d_type` (`DT_*`) into `FileType`.
fn classify_posix_dtype(dtype: u8, /) -> FileType {
    if dtype == 8_u8 {
        return .RegularFile;
    }
    if dtype == 4_u8 {
        return .Directory;
    }
    if dtype == 10_u8 {
        return .Symlink;
    }
    if dtype == 1_u8 {
        return .Fifo;
    }
    if dtype == 12_u8 {
        return .Socket;
    }
    if dtype == 2_u8 {
        return .CharDevice;
    }
    if dtype == 6_u8 {
        return .BlockDevice;
    }
    .Unknown
}

/| Builds `FilePermissions` from a POSIX `st_mode` low 12-bit mask.
fn perms_from_posix_bits(raw_mode: u32, /) -> FilePermissions {
    let low_mode = (raw_mode & 0o7777_u32) as u16;
    FilePermissions {
        posix_mode: low_mode,
        readonly: (low_mode & 0o222_u16) == 0_u16,
        executable: (low_mode & 0o111_u16) != 0_u16,
        reserved: 0_u16,
    }
}

// ----------------- Linux Host Implementation ------------------
/| Reads thread-local `errno` on Linux (`__errno_location`).
@std_cap_boundary(clears: [ffi, unsafe_op])
fn linux_errno() -> i32 {
    unsafe {
        sys.linux.linux_errno_location().read()
    }
}

/| Builds `FsError` from `linux_errno()` with optional `failed_bytes` context.
fn linux_last_fs_error(op: IoOp, failed_bytes: &[u8], /) -> FsError {
    attach_failed_path(
        FsError.from_raw_os(linux_errno(), domain: .PosixErrno, op: op),
        failed_bytes,
    )
}

/| Extracts a positive `errno` from a `syscall(…)` return value (`-1` + `errno` or `-errno`).
fn linux_syscall_err(sys_rc: isize, /) -> i32 {
    if sys_rc >= 0_isize {
        return 0;
    }
    if sys_rc == -1_isize {
        let tls_err: i32 = linux_errno();
        return if tls_err > 0 => tls_err else sys.linux.EIO;
    }
    (0_isize -% sys_rc) as i32
}

/| Applies optional advisory `flock` flags (`lock_shared` / `lock_exclusive`) to `raw_fd` on Linux, closing `raw_fd` on failure.
@cfg(target.os == "linux") @std_cap_boundary(clears: [ffi, unsafe_op])
fn linux_apply_open_flock(raw_fd: i32, flags: OpenFlags, failed_bytes: &[u8], /) -> unit!FsError {
    if not flags.lock_shared and not flags.lock_exclusive {
        return .Ok(());
    }
    var lock_op: i32 = if flags.lock_exclusive => sys.linux.LOCK_EX else sys.linux.LOCK_SH;
    if flags.nonblocking_lock {
        lock_op |= sys.linux.LOCK_NB;
    }
    while true {
        let lock_rc: i32 = unsafe {
            sys.linux.linux_flock(raw_fd, lock_op)
        };
        if lock_rc == 0 {
            return .Ok(());
        }
        let err_no: i32 = linux_errno();
        if err_no == sys.linux.EINTR and not flags.nonblocking_lock {
            continue;
        }
        unsafe {
            _ = sys.linux.linux_close(raw_fd);
        }
        if err_no == sys.linux.EAGAIN {
            return .Err(
                attach_failed_path(FsError.from_kind(.FileLockConflict, op: .Lock), failed_bytes),
            );
        }
        return .Err(
            attach_failed_path(
                FsError.from_raw_os(err_no, domain: .PosixErrno, op: .Lock),
                failed_bytes,
            ),
        );
    }
    .Ok(())
}

/| Opens a Linux `File` descriptor with `O_CLOEXEC` and optional `flock`.
@cfg(target.os == "linux") @std_cap_boundary(clears: [ffi, unsafe_op])
fn os_file_open(path_bytes: &[u8], opts: OpenOptions, /) -> isize!FsError {
    var cpath: PosixCStrBuf = PosixCStrBuf.encode(path_bytes, .Open)?;
    var flags: i32 = sys.linux.O_CLOEXEC;
    if opts.flags.append {
        flags |= (if opts.flags.read => sys.linux.O_RDWR else sys.linux.O_WRONLY)
            | sys.linux.O_APPEND;
    } else if opts.flags.read and opts.flags.write {
        flags |= sys.linux.O_RDWR;
    } else if opts.flags.write {
        flags |= sys.linux.O_WRONLY;
    } else {
        flags |= sys.linux.O_RDONLY;
    }
    if opts.flags.create_new {
        flags |= sys.linux.O_CREAT | sys.linux.O_EXCL;
    } else if opts.flags.create {
        flags |= sys.linux.O_CREAT;
    }
    if opts.flags.truncate {
        flags |= sys.linux.O_TRUNC;
    }
    if opts.flags.no_follow {
        flags |= sys.linux.O_NOFOLLOW;
    }
    if opts.flags.sync_data {
        flags |= sys.linux.O_DSYNC;
    }
    let raw_fd: i32 = unsafe {
        sys.linux.linux_openat_mode(
            sys.linux.AT_FDCWD,
            cpath.as_ptr(),
            flags,
            opts.permissions.posix_mode as u32,
        )
    };
    cpath.deinit();
    if raw_fd < 0 {
        return .Err(linux_last_fs_error(.Open, path_bytes));
    }
    linux_apply_open_flock(raw_fd, opts.flags, path_bytes)?;
    .Ok(raw_fd as isize)
}

/| Closes a Linux descriptor if non-negative.
@cfg(target.os == "linux") @std_cap_boundary(clears: [ffi, unsafe_op])
fn os_close_fd(fd_bits: isize, /) -> unit!FsError {
    let raw_fd = fd_bits as i32;
    if raw_fd < 0 {
        return .Ok(());
    }
    let rc: i32 = unsafe {
        sys.linux.linux_close(raw_fd)
    };
    if rc < 0 {
        let err_no: i32 = linux_errno();
        if err_no != sys.linux.EINTR {
            return .Err(FsError.from_raw_os(err_no, domain: .PosixErrno, op: .None));
        }
    }
    .Ok(())
}

/| Reads sequentially from a Linux descriptor.
@cfg(target.os == "linux") @std_cap_boundary(clears: [ffi, unsafe_op])
fn os_file_read(fd_bits: isize, dst_ptr: *mut u8, cap: usize, /) -> usize!IoError {
    let raw_fd = fd_bits as i32;
    let rc: isize = unsafe {
        sys.linux.linux_posix_read(raw_fd, dst_ptr, cap)
    };
    if rc < 0_isize {
        return .Err(IoError.from_raw_os(linux_errno(), domain: .PosixErrno, op: .Read));
    }
    .Ok(rc as usize)
}

/| Reads positionally at `offset` from a Linux descriptor via `pread`.
@cfg(target.os == "linux") @std_cap_boundary(clears: [ffi, unsafe_op])
fn os_file_pread(fd_bits: isize, dst_ptr: *mut u8, cap: usize, offset: u64, /) -> usize!IoError {
    let raw_fd = fd_bits as i32;
    if offset > (i64.MAX as u64) {
        return .Err(IoError.from_kind(.InvalidInput, op: .Read));
    }
    let rc: isize = unsafe {
        sys.linux.linux_pread(raw_fd, dst_ptr, cap, offset as i64)
    };
    if rc < 0_isize {
        return .Err(IoError.from_raw_os(linux_errno(), domain: .PosixErrno, op: .Read));
    }
    .Ok(rc as usize)
}

/| Writes sequentially to a Linux descriptor.
@cfg(target.os == "linux") @std_cap_boundary(clears: [ffi, unsafe_op])
fn os_file_write(fd_bits: isize, buf: &[u8], /) -> usize!IoError {
    let raw_fd = fd_bits as i32;
    if buf.is_empty() {
        return .Ok(0_usize);
    }
    let rc: isize = unsafe {
        sys.linux.linux_posix_write(raw_fd, buf.as_ptr(), buf.len())
    };
    if rc < 0_isize {
        return .Err(IoError.from_raw_os(linux_errno(), domain: .PosixErrno, op: .Write));
    }
    .Ok(rc as usize)
}

/| Writes positionally at `offset` to a Linux descriptor via `pwrite`.
@cfg(target.os == "linux") @std_cap_boundary(clears: [ffi, unsafe_op])
fn os_file_pwrite(fd_bits: isize, buf: &[u8], offset: u64, /) -> usize!IoError {
    let raw_fd = fd_bits as i32;
    if buf.is_empty() {
        return .Ok(0_usize);
    }
    if offset > (i64.MAX as u64) {
        return .Err(IoError.from_kind(.InvalidInput, op: .Write));
    }
    let rc: isize = unsafe {
        sys.linux.linux_pwrite(raw_fd, buf.as_ptr(), buf.len(), offset as i64)
    };
    if rc < 0_isize {
        return .Err(IoError.from_raw_os(linux_errno(), domain: .PosixErrno, op: .Write));
    }
    .Ok(rc as usize)
}

/| Writes scatter-gather `IoSlice`s via `writev` clamped to `POSIX_IOV_MAX = 1024` (`STD-02` §1.1).
@cfg(target.os == "linux") @std_cap_boundary(clears: [ffi, unsafe_op])
fn os_file_write_vectored(fd_bits: isize, bufs: &[IoSlice], /) -> usize!IoError {
    let raw_fd = fd_bits as i32;
    if bufs.is_empty() {
        return .Ok(0_usize);
    }
    let count: usize = if bufs.len() > POSIX_IOV_MAX => POSIX_IOV_MAX else bufs.len();
    // `IoSlice` is `@repr(C) { ptr: *u8, len: usize }`, ABI-identical to `PosixIovec` on 64-bit Linux:
    let rc: isize = unsafe {
        sys.linux.linux_writev(raw_fd, bufs.as_ptr() as *sys.linux.PosixIovec, count as i32)
    };
    if rc < 0_isize {
        return .Err(IoError.from_raw_os(linux_errno(), domain: .PosixErrno, op: .Write));
    }
    .Ok(rc as usize)
}

/| Seeks a Linux descriptor via `lseek`.
@cfg(target.os == "linux") @std_cap_boundary(clears: [ffi, unsafe_op])
fn os_file_seek(fd_bits: isize, pos: SeekFrom, /) -> u64!IoError {
    let raw_fd = fd_bits as i32;
    let (delta, whence) = match pos {
        .Start(abs_off) => {
            if abs_off > (i64.MAX as u64) {
                return .Err(IoError.from_kind(.InvalidInput, op: .Seek));
            }
            (abs_off as i64, sys.linux.SEEK_SET)
        },
        .Current(rel_off) => (rel_off, sys.linux.SEEK_CUR),
        .End(end_off) => (end_off, sys.linux.SEEK_END),
    };
    let res: i64 = unsafe {
        sys.linux.linux_lseek(raw_fd, delta, whence)
    };
    if res < 0_i64 {
        return .Err(IoError.from_raw_os(linux_errno(), domain: .PosixErrno, op: .Seek));
    }
    .Ok(res as u64)
}

/| Truncates or extends a Linux descriptor via `ftruncate`.
@cfg(target.os == "linux") @std_cap_boundary(clears: [ffi, unsafe_op])
fn os_file_set_len(fd_bits: isize, size: u64, /) -> unit!FsError {
    let raw_fd = fd_bits as i32;
    if size > (i64.MAX as u64) {
        return .Err(FsError.from_kind(.InvalidInput, op: .Write));
    }
    let rc: i32 = unsafe {
        sys.linux.linux_ftruncate(raw_fd, size as i64)
    };
    if rc < 0 {
        return .Err(linux_last_fs_error(.Write, EMPTY_BYTES));
    }
    .Ok(())
}

/| Sets POSIX mode bits on a Linux descriptor via `fchmod`.
@cfg(target.os == "linux") @std_cap_boundary(clears: [ffi, unsafe_op])
fn os_file_set_permissions(fd_bits: isize, perms: FilePermissions, /) -> unit!FsError {
    let raw_fd = fd_bits as i32;
    let rc: i32 = unsafe {
        sys.linux.linux_fchmod(raw_fd, perms.posix_mode as u32)
    };
    if rc < 0 {
        return .Err(linux_last_fs_error(.Stat, EMPTY_BYTES));
    }
    .Ok(())
}

/| Flushes a Linux descriptor according to `mode` (`fdatasync` vs. `fsync`).
@cfg(target.os == "linux") @std_cap_boundary(clears: [ffi, unsafe_op])
fn os_file_sync(fd_bits: isize, mode: DurabilityMode, /) -> unit!FsError {
    let raw_fd = fd_bits as i32;
    if mode == .FastLocal {
        return .Ok(());
    }
    let rc: i32 = unsafe {
        if mode == .CrashSafe => sys.linux.linux_fdatasync(raw_fd)
            else sys.linux.linux_fsync(raw_fd)
    };
    if rc < 0 {
        let err_no: i32 = linux_errno();
        if err_no == sys.linux.EINVAL or err_no == sys.linux.EROFS {
            return .Ok(());
        }
        return .Err(FsError.from_raw_os(err_no, domain: .PosixErrno, op: .Flush));
    }
    .Ok(())
}

/| Converts `LinuxStatx` into `Metadata`.
fn metadata_from_linux_statx(stx: &sys.linux.LinuxStatx, /) -> Metadata {
    let created_opt: SystemTime? = if (stx.stx_mask & sys.linux.STATX_BTIME) != 0_u32 {
        make_system_time_opt(stx.stx_btime.tv_sec, stx.stx_btime.tv_nsec as i64)
    } else {
        .None
    };
    let dev_combined: u64 = ((stx.stx_dev_major as u64) << 32_u64) | (stx.stx_dev_minor as u64);
    Metadata {
        file_type: classify_posix_mode(stx.stx_mode as u32),
        size: stx.stx_size,
        permissions: perms_from_posix_bits(stx.stx_mode as u32),
        modified: make_system_time_opt(stx.stx_mtime.tv_sec, stx.stx_mtime.tv_nsec as i64),
        accessed: make_system_time_opt(stx.stx_atime.tv_sec, stx.stx_atime.tv_nsec as i64),
        created: created_opt,
        dev_id: dev_combined,
        inode_or_file_id: stx.stx_ino,
        hardlink_count: stx.stx_nlink,
    }
}

/| Converts fallback `LinuxStat` (`newfstatat`) into `Metadata`.
fn metadata_from_linux_stat(st: &sys.linux.LinuxStat, /) -> Metadata {
    let clamped_size: u64 = if st.st_size < 0_i64 => 0_u64 else st.st_size as u64;
    Metadata {
        file_type: classify_posix_mode(st.st_mode),
        size: clamped_size,
        permissions: perms_from_posix_bits(st.st_mode),
        modified: make_system_time_opt(st.st_mtime_sec, st.st_mtime_nsec),
        accessed: make_system_time_opt(st.st_atime_sec, st.st_atime_nsec),
        created: .None,
        dev_id: st.st_dev,
        inode_or_file_id: st.st_ino,
        hardlink_count: st.st_nlink as u32,
    }
}

/| Queries `Metadata` on `dir_fd` + `cpath_ptr` via `SYS_statx` with `SYS_newfstatat` fallback.
@std_cap_boundary(clears: [ffi, unsafe_op])
fn linux_stat_at(
    dir_fd: i32,
    cpath_ptr: *u8,
    at_flags: i32,
    failed_bytes: &[u8],
    /,
) -> Metadata!FsError {
    var stx = @default_init[sys.linux.LinuxStatx]();
    let stx_rc: isize = unsafe {
        sys.linux.linux_sys_statx(
            dir_fd,
            cpath_ptr,
            at_flags | sys.linux.AT_STATX_SYNC_AS_STAT,
            sys.linux.STATX_BASIC_STATS | sys.linux.STATX_BTIME,
            &raw mut stx,
        )
    };
    let stx_err: i32 = linux_syscall_err(stx_rc);
    if stx_err == 0 {
        return .Ok(metadata_from_linux_statx(&stx));
    }
    if stx_err != sys.linux.ENOSYS and stx_err != sys.linux.EINVAL {
        return .Err(
            attach_failed_path(
                FsError.from_raw_os(stx_err, domain: .PosixErrno, op: .Stat),
                failed_bytes,
            ),
        );
    }
    var st_legacy = @default_init[sys.linux.LinuxStat]();
    let leg_rc: isize = unsafe {
        sys.linux.linux_sys_newfstatat(dir_fd, cpath_ptr, &raw mut st_legacy, at_flags)
    };
    let leg_err: i32 = linux_syscall_err(leg_rc);
    if leg_err != 0 {
        return .Err(
            attach_failed_path(
                FsError.from_raw_os(leg_err, domain: .PosixErrno, op: .Stat),
                failed_bytes,
            ),
        );
    }
    .Ok(metadata_from_linux_stat(&st_legacy))
}

/| Queries `Metadata` from an open Linux descriptor (`AT_EMPTY_PATH`).
@cfg(target.os == "linux")
fn os_file_metadata(fd_bits: isize, /) -> Metadata!FsError {
    let raw_fd = fd_bits as i32;
    let empty_nul: [u8; 1] = [0_u8];
    linux_stat_at(raw_fd, &raw empty_nul[0], sys.linux.AT_EMPTY_PATH, EMPTY_BYTES)
}

/| Opens a directory descriptor on Linux (`O_RDONLY | O_DIRECTORY | O_CLOEXEC`).
@cfg(target.os == "linux") @std_cap_boundary(clears: [ffi, unsafe_op])
fn os_dir_open(path_bytes: &[u8], /) -> isize!FsError {
    var cpath: PosixCStrBuf = PosixCStrBuf.encode(path_bytes, .Open)?;
    let fd: i32 = unsafe {
        sys.linux.linux_openat_mode(
            sys.linux.AT_FDCWD,
            cpath.as_ptr(),
            sys.linux.O_RDONLY | sys.linux.O_DIRECTORY | sys.linux.O_CLOEXEC,
            0_u32,
        )
    };
    cpath.deinit();
    if fd < 0 {
        return .Err(linux_last_fs_error(.Open, path_bytes));
    }
    .Ok(fd as isize)
}

/| Per-component `O_NOFOLLOW` fallback beneath `root_dir` for pre-5.6 Linux kernels (`ENOSYS`).
@std_cap_boundary(clears: [ffi, unsafe_op])
fn linux_walk_beneath_fallback(
    root_dir: i32,
    rel_bytes: &[u8],
    leaf_flags: i32,
    leaf_mode: u32,
    op: IoOp,
    /,
) -> i32!FsError {
    validate_beneath_lexical(rel_bytes, op)?;
    var cur_fd: i32 = root_dir;
    var pos = 0_usize;
    let total: usize = rel_bytes.len();
    while pos < total {
        var seg_end: usize = pos;
        while seg_end < total and byte_at(rel_bytes, seg_end) != b'/' {
            seg_end = seg_end +% 1_usize;
        }
        let seg: &[u8] = subslice_u8(rel_bytes, pos, seg_end);
        var next_pos: usize = seg_end;
        while next_pos < total and byte_at(rel_bytes, next_pos) == b'/' {
            next_pos = next_pos +% 1_usize;
        }
        pos = next_pos;
        if seg.is_empty() or (seg.len() == 1_usize and byte_at(seg, 0_usize) == b'.') {
            continue;
        }
        let is_leaf: bool = pos >= total;
        var seg_cstr: PosixCStrBuf = PosixCStrBuf.encode(seg, op) catch |ce| {
            if cur_fd != root_dir {
                unsafe {
                    _ = sys.linux.linux_close(cur_fd);
                }
            }
            return .Err(ce);
        };
        let step_flags: i32 = if is_leaf {
            leaf_flags | sys.linux.O_CLOEXEC | sys.linux.O_NOFOLLOW
        } else {
            sys.linux.O_RDONLY | sys.linux.O_DIRECTORY | sys.linux.O_CLOEXEC | sys.linux.O_NOFOLLOW
        };
        let next_fd: i32 = unsafe {
            sys.linux.linux_openat_mode(
                cur_fd,
                seg_cstr.as_ptr(),
                step_flags,
                if is_leaf => leaf_mode else 0_u32,
            )
        };
        seg_cstr.deinit();
        if next_fd < 0 {
            let err_no: i32 = linux_errno();
            if cur_fd != root_dir {
                unsafe {
                    _ = sys.linux.linux_close(cur_fd);
                }
            }
            if err_no == sys.linux.ELOOP {
                return .Err(
                    attach_failed_path(FsError.from_kind(.FilesystemLoop, op: op), rel_bytes),
                );
            }
            return .Err(
                attach_failed_path(
                    FsError.from_raw_os(err_no, domain: .PosixErrno, op: op),
                    rel_bytes,
                ),
            );
        }
        if cur_fd != root_dir {
            unsafe {
                _ = sys.linux.linux_close(cur_fd);
            }
        }
        if is_leaf {
            return .Ok(next_fd);
        }
        cur_fd = next_fd;
    }
    if cur_fd != root_dir {
        unsafe {
            _ = sys.linux.linux_close(cur_fd);
        }
    }
    .Err(attach_failed_path(FsError.from_kind(.InvalidInput, op: op), rel_bytes))
}

/| Opens a descriptor strictly beneath `dir_fd` via Linux 5.6+ `SYS_openat2` (`RESOLVE_BENEATH`) with `ENOSYS` fallback (`STD-02` §3.4B).
@std_cap_boundary(clears: [ffi, unsafe_op])
fn linux_open_beneath(
    dir_fd: i32,
    rel_bytes: &[u8],
    flags: i32,
    mode_bits: u32,
    op: IoOp,
    /,
) -> i32!FsError {
    validate_beneath_lexical(rel_bytes, op)?;
    var cpath: PosixCStrBuf = PosixCStrBuf.encode(rel_bytes, op)?;
    let open_flags: i32 = flags | sys.linux.O_CLOEXEC;
    let create_mode: u64 = if (open_flags & sys.linux.O_CREAT) != 0 => mode_bits as u64 else 0_u64;
    let how = sys.linux.LinuxOpenHow {
        flags: (open_flags as u32) as u64,
        mode: create_mode,
        resolve: sys.linux.RESOLVE_BENEATH
            | sys.linux.RESOLVE_NO_SYMLINKS
            | sys.linux.RESOLVE_NO_MAGICLINKS,
    };
    let sys_rc: isize = unsafe {
        sys.linux.linux_sys_openat2(
            dir_fd,
            cpath.as_ptr(),
            &raw how,
            @size_of[sys.linux.LinuxOpenHow](),
        )
    };
    cpath.deinit();
    let err_no: i32 = linux_syscall_err(sys_rc);
    if err_no == 0 {
        return .Ok(sys_rc as i32);
    }
    if err_no == sys.linux.ENOSYS {
        return linux_walk_beneath_fallback(dir_fd, rel_bytes, flags, mode_bits, op);
    }
    if err_no == sys.linux.EXDEV or err_no == sys.linux.ELOOP {
        return .Err(attach_failed_path(FsError.from_kind(.FilesystemLoop, op: op), rel_bytes));
    }
    .Err(attach_failed_path(FsError.from_raw_os(err_no, domain: .PosixErrno, op: op), rel_bytes))
}

/| Opens a confined parent directory + single leaf name beneath `dir_fd` on Linux.
fn linux_open_parent_beneath(
    dir_fd: i32,
    rel_bytes: &[u8],
    op: IoOp,
    /,
) -> (i32, bool, PosixCStrBuf)!FsError {
    validate_beneath_lexical(rel_bytes, op)?;
    let rel_view = Path.from_bytes(rel_bytes);
    let (parent_view, leaf_bytes) = split_parent_and_leaf(rel_view, op)?;
    let leaf_cstr: PosixCStrBuf = PosixCStrBuf.encode(leaf_bytes, op)?;
    if is_single_dot(parent_view.as_bytes()) {
        return .Ok((dir_fd, false, leaf_cstr));
    }
    var cleanup_cstr: PosixCStrBuf = leaf_cstr;
    let parent_fd: i32 = linux_open_beneath(
        dir_fd,
        parent_view.as_bytes(),
        sys.linux.O_RDONLY | sys.linux.O_DIRECTORY,
        0_u32,
        op,
    ) catch |pe| {
        cleanup_cstr.deinit();
        return .Err(pe);
    };
    .Ok((parent_fd, true, cleanup_cstr))
}

/| Opens a file strictly beneath `dir_fd` on Linux.
@cfg(target.os == "linux")
fn os_open_file_beneath(dir_bits: isize, rel_bytes: &[u8], opts: OpenOptions, /) -> isize!FsError {
    let dir_fd = dir_bits as i32;
    var flags: i32 = 0;
    if opts.flags.append {
        flags = (if opts.flags.read => sys.linux.O_RDWR else sys.linux.O_WRONLY)
            | sys.linux.O_APPEND;
    } else if opts.flags.read and opts.flags.write {
        flags = sys.linux.O_RDWR;
    } else if opts.flags.write {
        flags = sys.linux.O_WRONLY;
    } else {
        flags = sys.linux.O_RDONLY;
    }
    if opts.flags.create_new {
        flags |= sys.linux.O_CREAT | sys.linux.O_EXCL;
    } else if opts.flags.create {
        flags |= sys.linux.O_CREAT;
    }
    if opts.flags.truncate {
        flags |= sys.linux.O_TRUNC;
    }
    if opts.flags.sync_data {
        flags |= sys.linux.O_DSYNC;
    }
    let fd: i32 = linux_open_beneath(
        dir_fd,
        rel_bytes,
        flags,
        opts.permissions.posix_mode as u32,
        .Open,
    )?;
    linux_apply_open_flock(fd, opts.flags, rel_bytes)?;
    .Ok(fd as isize)
}

/| Opens a subdirectory strictly beneath `dir_fd` on Linux.
@cfg(target.os == "linux")
fn os_open_dir_beneath(dir_bits: isize, rel_bytes: &[u8], /) -> isize!FsError {
    let dir_fd = dir_bits as i32;
    let fd: i32 = linux_open_beneath(
        dir_fd,
        rel_bytes,
        sys.linux.O_RDONLY | sys.linux.O_DIRECTORY,
        0_u32,
        .Open,
    )?;
    .Ok(fd as isize)
}

/| Creates a directory strictly beneath `dir_fd` on Linux.
@cfg(target.os == "linux") @std_cap_boundary(clears: [ffi, unsafe_op])
fn os_create_dir_beneath(dir_bits: isize, rel_bytes: &[u8], perms: FilePermissions, /) -> unit!FsError {
    let dir_fd = dir_bits as i32;
    var (parent_fd, owns_parent, leaf_cstr) = linux_open_parent_beneath(dir_fd, rel_bytes, .Mkdir)?;
    let rc: i32 = unsafe {
        sys.linux.linux_mkdirat(parent_fd, leaf_cstr.as_ptr(), perms.posix_mode as u32)
    };
    let err_opt: FsError? = if rc < 0 => .Some(linux_last_fs_error(.Mkdir, rel_bytes)) else .None;
    leaf_cstr.deinit();
    if owns_parent {
        unsafe {
            _ = sys.linux.linux_close(parent_fd);
        }
    }
    if err_opt is .Some(err_val) {
        return .Err(err_val);
    }
    .Ok(())
}

/| Unlinks a non-symlink file strictly beneath `dir_fd` on Linux.
@cfg(target.os == "linux") @std_cap_boundary(clears: [ffi, unsafe_op])
fn os_unlink_file_beneath(dir_bits: isize, rel_bytes: &[u8], /) -> unit!FsError {
    let dir_fd = dir_bits as i32;
    var (parent_fd, owns_parent, leaf_cstr) = linux_open_parent_beneath(dir_fd, rel_bytes, .Unlink)?;
    let leaf_meta: Metadata!FsError = linux_stat_at(
        parent_fd,
        leaf_cstr.as_ptr(),
        sys.linux.AT_SYMLINK_NOFOLLOW,
        rel_bytes,
    );
    if leaf_meta is .Ok(meta_val) and meta_val.is_symlink() {
        leaf_cstr.deinit();
        if owns_parent {
            unsafe {
                _ = sys.linux.linux_close(parent_fd);
            }
        }
        return .Err(attach_failed_path(FsError.from_kind(.FilesystemLoop, op: .Unlink), rel_bytes));
    }
    let rc: i32 = unsafe {
        sys.linux.linux_unlinkat(parent_fd, leaf_cstr.as_ptr(), 0)
    };
    let err_opt: FsError? = if rc < 0 => .Some(linux_last_fs_error(.Unlink, rel_bytes)) else .None;
    leaf_cstr.deinit();
    if owns_parent {
        unsafe {
            _ = sys.linux.linux_close(parent_fd);
        }
    }
    if err_opt is .Some(err_val) {
        return .Err(err_val);
    }
    .Ok(())
}

/| Queries metadata strictly beneath `dir_fd` on Linux (`RESOLVE_BENEATH` + `ENOSYS` `readlinkat` fallback).
@cfg(target.os == "linux") @std_cap_boundary(clears: [ffi, unsafe_op])
fn os_metadata_beneath(
    dir_bits: isize,
    rel_bytes: &[u8],
    follow_symlinks: bool,
    /,
) -> Metadata!FsError {
    let dir_fd = dir_bits as i32;
    validate_beneath_lexical(rel_bytes, .Stat)?;
    if not follow_symlinks {
        var (parent_fd, owns_parent, leaf_cstr) = linux_open_parent_beneath(dir_fd, rel_bytes, .Stat)?;
        let res: Metadata!FsError = linux_stat_at(
            parent_fd,
            leaf_cstr.as_ptr(),
            sys.linux.AT_SYMLINK_NOFOLLOW,
            rel_bytes,
        );
        leaf_cstr.deinit();
        if owns_parent {
            unsafe {
                _ = sys.linux.linux_close(parent_fd);
            }
        }
        return res;
    }

    // [1] Fast path on Linux >= 5.6; `openat2(RESOLVE_BENEATH | RESOLVE_NO_MAGICLINKS)` resolves confined symlinks:
    var cpath: PosixCStrBuf = PosixCStrBuf.encode(rel_bytes, .Stat)?;
    let how = sys.linux.LinuxOpenHow {
        flags: ((sys.linux.O_PATH | sys.linux.O_CLOEXEC) as u32) as u64,
        mode: 0_u64,
        resolve: sys.linux.RESOLVE_BENEATH | sys.linux.RESOLVE_NO_MAGICLINKS,
    };
    let sys_rc: isize = unsafe {
        sys.linux.linux_sys_openat2(
            dir_fd,
            cpath.as_ptr(),
            &raw how,
            @size_of[sys.linux.LinuxOpenHow](),
        )
    };
    cpath.deinit();
    let err_no: i32 = linux_syscall_err(sys_rc);
    if err_no == 0 {
        let fd = sys_rc as i32;
        let res: Metadata!FsError = os_file_metadata(fd as isize);
        unsafe {
            _ = sys.linux.linux_close(fd);
        }
        return res;
    }
    if err_no == sys.linux.EXDEV or err_no == sys.linux.ELOOP {
        return .Err(attach_failed_path(FsError.from_kind(.FilesystemLoop, op: .Stat), rel_bytes));
    }
    if err_no != sys.linux.ENOSYS {
        return .Err(
            attach_failed_path(
                FsError.from_raw_os(err_no, domain: .PosixErrno, op: .Stat),
                rel_bytes,
            ),
        );
    }

    // [2] Pre-5.6 `ENOSYS` fallback: step relative leaf symlinks confined beneath `dir_fd` up to `8` hops:
    var cur_pb = PathBuf.from(rel_bytes);
    var link_buf: [u8; 4_096] = [0_u8; 4_096];
    var hops = 0_usize;
    while hops <= MAX_BENEATH_SYMLINK_HOPS {
        var (parent_fd, owns_parent, leaf_cstr) = linux_open_parent_beneath(
            dir_fd,
            cur_pb.as_bytes(),
            .Stat,
        )?;
        let st_res: Metadata!FsError = linux_stat_at(
            parent_fd,
            leaf_cstr.as_ptr(),
            sys.linux.AT_SYMLINK_NOFOLLOW,
            rel_bytes,
        );
        if st_res is .Err(st_err) {
            leaf_cstr.deinit();
            if owns_parent {
                unsafe {
                    _ = sys.linux.linux_close(parent_fd);
                }
            }
            return .Err(st_err);
        }
        let meta_val: Metadata = st_res catch unreachable;
        if not meta_val.is_symlink() {
            leaf_cstr.deinit();
            if owns_parent {
                unsafe {
                    _ = sys.linux.linux_close(parent_fd);
                }
            }
            return .Ok(meta_val);
        }
        if hops == MAX_BENEATH_SYMLINK_HOPS {
            leaf_cstr.deinit();
            if owns_parent {
                unsafe {
                    _ = sys.linux.linux_close(parent_fd);
                }
            }
            return .Err(attach_failed_path(FsError.from_kind(.FilesystemLoop, op: .Stat), rel_bytes));
        }
        let rl_rc: isize = unsafe {
            sys.linux.linux_readlinkat(
                parent_fd,
                leaf_cstr.as_ptr(),
                &raw mut link_buf[0],
                4_096_usize,
            )
        };
        let rl_err: i32 = if rl_rc < 0_isize => linux_errno() else 0;
        leaf_cstr.deinit();
        if owns_parent {
            unsafe {
                _ = sys.linux.linux_close(parent_fd);
            }
        }
        if rl_rc < 0_isize {
            return .Err(
                attach_failed_path(
                    FsError.from_raw_os(rl_err, domain: .PosixErrno, op: .Stat),
                    rel_bytes,
                ),
            );
        }
        if rl_rc == 0_isize or (rl_rc as usize) >= 4_096_usize {
            return .Err(attach_failed_path(FsError.from_kind(.FilesystemLoop, op: .Stat), rel_bytes));
        }
        let link_slice: &[u8] = unsafe {
            @slice_from_raw_parts(&raw link_buf[0], rl_rc as usize)
        };
        let next_pb: PathBuf = join_confined_symlink_target(cur_pb.as_bytes(), link_slice, .Stat)?;
        if next_pb.as_bytes().is_empty() {
            return os_file_metadata(dir_fd as isize);
        }
        cur_pb = next_pb;
        hops = hops +% 1_usize;
    }
    .Err(attach_failed_path(FsError.from_kind(.FilesystemLoop, op: .Stat), rel_bytes))
}

/| Opens an independent `LinuxDirIterState` (`openat(dir_fd, ".")` + `getdents64` `8 KiB` batching).
@cfg(target.os == "linux") @std_cap_boundary(clears: [ffi, unsafe_op])
fn os_dir_entries(dir_bits: isize, /) -> (*mut opaque)!FsError {
    let dir_fd = dir_bits as i32;
    let dot_nul: [u8; 2] = [b'.', 0_u8];
    let dup_fd: i32 = unsafe {
        sys.linux.linux_openat_mode(
            dir_fd,
            &raw dot_nul[0],
            sys.linux.O_RDONLY | sys.linux.O_DIRECTORY | sys.linux.O_CLOEXEC,
            0_u32,
        )
    };
    if dup_fd < 0 {
        return .Err(linux_last_fs_error(.Readdir, EMPTY_BYTES));
    }
    let mem: *mut u8 = System
        .handle()
        .alloc(
            Layout { size: @size_of[LinuxDirIterState](), alignment: @align_of[LinuxDirIterState]() },
        ) catch {
        unsafe {
            _ = sys.linux.linux_close(dup_fd);
        }
        return .Err(FsError.from_kind(.OutOfMemory, op: .Readdir));
    };
    let state_ptr = mem as *mut LinuxDirIterState;
    if state_ptr.is_null() {
        unsafe {
            _ = sys.linux.linux_close(dup_fd);
        }
        return .Err(FsError.from_kind(.OutOfMemory, op: .Readdir));
    }
    unsafe {
        state_ptr.*.dup_fd = dup_fd;
        state_ptr.*.buf_pos = 0_usize;
        state_ptr.*.buf_filled = 0_usize;
        state_ptr.*.is_eof = false;
    }
    .Ok(state_ptr as *mut opaque)
}

/| Advances `LinuxDirIterState` via `SYS_getdents64`, resolving `DT_UNKNOWN` via `AT_SYMLINK_NOFOLLOW`.
@cfg(target.os == "linux") @std_cap_boundary(clears: [ffi, unsafe_op, may_panic])
fn os_dir_iter_next(raw_state: *mut opaque, /) -> DirEntry?!FsError {
    let state_ptr = raw_state as *mut LinuxDirIterState;
    if state_ptr.is_null() {
        return .Ok(.None);
    }
    let state: &mut LinuxDirIterState = unsafe {
        &mut state_ptr.*
    };
    while not state.is_eof {
        if state.buf_pos >= state.buf_filled {
            let nread: isize = unsafe {
                sys.linux.linux_sys_getdents64(
                    state.dup_fd,
                    (&raw mut state.dirent_buf[0]) as *mut u8,
                    8_192_usize,
                )
            };
            let err_no: i32 = linux_syscall_err(nread);
            if err_no != 0 {
                return .Err(FsError.from_raw_os(err_no, domain: .PosixErrno, op: .Readdir));
            }
            if nread == 0_isize {
                state.is_eof = true;
                return .Ok(.None);
            }
            state.buf_pos = 0_usize;
            state.buf_filled = nread as usize;
        }
        if state.buf_pos +% 19_usize > state.buf_filled {
            state.buf_pos = state.buf_filled;
            continue;
        }
        let base_ptr = (&raw state.dirent_buf[0]) as *u8;
        let hdr_ptr = unsafe {
            base_ptr.add(state.buf_pos) as *sys.linux.LinuxDirent64Hdr
        };
        let hdr_val: sys.linux.LinuxDirent64Hdr = unsafe {
            hdr_ptr.read()
        };
        let reclen = hdr_val.d_reclen as usize;
        if reclen < 19_usize or state.buf_pos +% reclen > state.buf_filled {
            state.is_eof = true;
            return .Err(FsError.from_kind(.InvalidData, op: .Readdir));
        }
        let ino_val: u64 = hdr_val.d_ino;
        let raw_dtype: u8 = hdr_val.d_type;
        let name_ptr: *u8 = unsafe {
            base_ptr.add(state.buf_pos +% 19_usize)
        };
        let max_name: usize = reclen -% 19_usize;
        let name_len: usize = cstr_len_bounded(name_ptr, max_name);
        state.buf_pos = state.buf_pos +% reclen;

        let name_slice: &[u8] = unsafe {
            @slice_from_raw_parts(name_ptr, name_len)
        };
        if name_slice.is_empty() or is_dot_or_dotdot(name_slice) {
            continue;
        }
        var ftype: FileType = classify_posix_dtype(raw_dtype);
        if raw_dtype == sys.linux.DT_UNKNOWN
            and linux_stat_at(
                state.dup_fd,
                name_ptr,
                sys.linux.AT_SYMLINK_NOFOLLOW,
                EMPTY_BYTES,
            ) is .Ok(st_meta) {
            ftype = st_meta.file_type;
        }
        return .Ok(
            .Some(
                DirEntry {
                    name: PathBuf.from(name_slice),
                    file_type: ftype,
                    inode_or_file_id: ino_val,
                },
            ),
        );
    }
    .Ok(.None)
}

/| Closes `dup_fd` and deallocates `LinuxDirIterState`.
@cfg(target.os == "linux") @std_cap_boundary(clears: [ffi, unsafe_op])
fn os_dir_iter_close(raw_state: *mut opaque, /) {
    let state_ptr = raw_state as *mut LinuxDirIterState;
    if state_ptr.is_null() {
        return;
    }
    let dup_fd: i32 = unsafe {
        state_ptr.read().dup_fd
    };
    if dup_fd >= 0 {
        unsafe {
            _ = sys.linux.linux_close(dup_fd);
        }
    }
    System
        .handle()
        .dealloc(
            raw_state as *mut u8,
            Layout { size: @size_of[LinuxDirIterState](), alignment: @align_of[LinuxDirIterState]() },
        );
}

/| Maps a non-empty Linux `File` read-only via `mmap(PROT_READ, MAP_PRIVATE)`.
@cfg(target.os == "linux") @std_cap_boundary(clears: [ffi, unsafe_op])
fn os_mmap_open_read_only(
    fd_bits: isize,
    len_bytes: usize,
    require_nul_sentinel: bool,
    /,
) -> Mmap!FsError {
    let raw_fd = fd_bits as i32;
    if require_nul_sentinel and (len_bytes & 4_095_usize) == 0_usize {
        return .Err(FsError.from_kind(.Unsupported, op: .Mmap));
    }
    let mapped: *mut opaque = unsafe {
        sys.linux.linux_mmap(
            @default_init[*mut opaque](),
            len_bytes,
            sys.linux.PROT_READ,
            sys.linux.MAP_PRIVATE,
            raw_fd,
            0_i64,
        )
    };
    if (mapped as isize) == -1_isize or mapped.is_null() {
        return .Err(linux_last_fs_error(.Mmap, EMPTY_BYTES));
    }
    if require_nul_sentinel {
        let tail_byte: u8 = unsafe {
            (mapped as *u8).add(len_bytes).read()
        };
        if tail_byte != 0_u8 {
            unsafe {
                _ = sys.linux.linux_munmap(mapped, len_bytes);
            }
            return .Err(FsError.from_kind(.Unsupported, op: .Mmap));
        }
    }
    .Ok(
        Mmap {
            ptr: mapped as *u8,
            len_bytes,
            map_cap: len_bytes,
        },
    )
}

/| Unmaps a Linux `Mmap` region via `munmap`.
@cfg(target.os == "linux") @std_cap_boundary(clears: [ffi, unsafe_op])
fn os_mmap_close(ptr: *u8, map_cap: usize, /) {
    if map_cap > 0_usize and not ptr.is_null() {
        unsafe {
            _ = sys.linux.linux_munmap(ptr as *mut opaque, map_cap);
        }
    }
}

/| Resolves canonical physical path on Linux via `realpath` (`4 KiB` stack buffer).
@cfg(target.os == "linux") @std_cap_boundary(clears: [ffi, unsafe_op])
fn os_resolve_path(path_bytes: &[u8], /) -> PathBuf!FsError {
    var cpath: PosixCStrBuf = PosixCStrBuf.encode(path_bytes, .Resolve)?;
    var resolved: [u8; 4_096] = [0_u8; 4_096];
    let res_ptr: *mut u8 = unsafe {
        sys.linux.linux_realpath(cpath.as_ptr(), &raw mut resolved[0])
    };
    if res_ptr.is_null() {
        let err: FsError = linux_last_fs_error(.Resolve, path_bytes);
        cpath.deinit();
        return .Err(err);
    }
    cpath.deinit();
    let out_len: usize = cstr_len_bounded(&raw resolved[0], 4_096_usize);
    let out_slice: &[u8] = unsafe {
        @slice_from_raw_parts(&raw resolved[0], out_len)
    };
    .Ok(PathBuf.from(out_slice))
}

/| Queries path `Metadata` on Linux (`AT_SYMLINK_NOFOLLOW` when `not follow_symlinks`).
@cfg(target.os == "linux")
fn os_path_metadata(path_bytes: &[u8], follow_symlinks: bool, /) -> Metadata!FsError {
    var cpath: PosixCStrBuf = PosixCStrBuf.encode(path_bytes, .Stat)?;
    let at_flags: i32 = if follow_symlinks => 0 else sys.linux.AT_SYMLINK_NOFOLLOW;
    let res: Metadata!FsError = linux_stat_at(
        sys.linux.AT_FDCWD,
        cpath.as_ptr(),
        at_flags,
        path_bytes,
    );
    cpath.deinit();
    res
}

/| Creates a single directory on Linux via `mkdirat`.
@cfg(target.os == "linux") @std_cap_boundary(clears: [ffi, unsafe_op])
fn os_mkdir_single(path_bytes: &[u8], perms: FilePermissions, /) -> unit!FsError {
    var cpath: PosixCStrBuf = PosixCStrBuf.encode(path_bytes, .Mkdir)?;
    let rc: i32 = unsafe {
        sys.linux.linux_mkdirat(sys.linux.AT_FDCWD, cpath.as_ptr(), perms.posix_mode as u32)
    };
    cpath.deinit();
    if rc < 0 {
        return .Err(linux_last_fs_error(.Mkdir, path_bytes));
    }
    .Ok(())
}

/| Unlinks a regular file or symlink on Linux via `unlinkat(…, 0)`.
@cfg(target.os == "linux") @std_cap_boundary(clears: [ffi, unsafe_op])
fn os_remove_file(path_bytes: &[u8], /) -> unit!FsError {
    var cpath: PosixCStrBuf = PosixCStrBuf.encode(path_bytes, .Unlink)?;
    let rc: i32 = unsafe {
        sys.linux.linux_unlinkat(sys.linux.AT_FDCWD, cpath.as_ptr(), 0)
    };
    cpath.deinit();
    if rc < 0 {
        return .Err(linux_last_fs_error(.Unlink, path_bytes));
    }
    .Ok(())
}

/| Removes an empty directory on Linux via `unlinkat(…, AT_REMOVEDIR)`.
@cfg(target.os == "linux") @std_cap_boundary(clears: [ffi, unsafe_op])
fn os_remove_empty_dir(path_bytes: &[u8], /) -> unit!FsError {
    var cpath: PosixCStrBuf = PosixCStrBuf.encode(path_bytes, .Unlink)?;
    let rc: i32 = unsafe {
        sys.linux.linux_unlinkat(sys.linux.AT_FDCWD, cpath.as_ptr(), sys.linux.AT_REMOVEDIR)
    };
    cpath.deinit();
    if rc < 0 {
        return .Err(linux_last_fs_error(.Unlink, path_bytes));
    }
    .Ok(())
}

/| Creates a fresh-inode `0o600` `StagedAtomicFile` inside `dst`'s parent `dir_fd` on Linux (`STD-02` §3.3).
@cfg(target.os == "linux") @std_cap_boundary(clears: [ffi, unsafe_op])
fn os_staged_atomic_create(
    dst_bytes: &[u8],
    perms: FilePermissions,
    /,
) -> StagedAtomicFile!FsError {
    let dst_view = Path.from_bytes(dst_bytes);
    let (parent_dir, leaf_bytes) = split_parent_and_leaf(dst_view, .Open)?;
    let parent_fd = os_dir_open(parent_dir.as_bytes())? as i32;
    var attempt = 0_u32;
    while attempt < 64_u32 {
        let tmp_leaf_pb: PathBuf = build_staged_tmp_path(Path.from_bytes(b"."), leaf_bytes, attempt);
        var ctmp: PosixCStrBuf = PosixCStrBuf.encode(tmp_leaf_pb.as_bytes(), .Open) catch |ce| {
            unsafe {
                _ = sys.linux.linux_close(parent_fd);
            }
            return .Err(ce);
        };
        let fd: i32 = unsafe {
            sys.linux.linux_openat_mode(
                parent_fd,
                ctmp.as_ptr(),
                sys.linux.O_WRONLY
                    | sys.linux.O_CREAT
                    | sys.linux.O_EXCL
                    | sys.linux.O_CLOEXEC
                    | sys.linux.O_NOFOLLOW,
                0o600_u32,
            )
        };
        ctmp.deinit();
        if fd >= 0 {
            return .Ok(
                StagedAtomicFile {
                    file: File { raw_fd: bits_to_raw_fd(fd as isize) },
                    parent_dir_fd: parent_fd as isize,
                    tmp_path: tmp_leaf_pb,
                    dst_path: PathBuf.from(leaf_bytes),
                    perms,
                },
            );
        }
        let err_no: i32 = linux_errno();
        if err_no != sys.linux.EEXIST {
            unsafe {
                _ = sys.linux.linux_close(parent_fd);
            }
            return .Err(
                attach_failed_path(
                    FsError.from_raw_os(err_no, domain: .PosixErrno, op: .Open),
                    dst_bytes,
                ),
            );
        }
        attempt = attempt +% 1_u32;
    }
    unsafe {
        _ = sys.linux.linux_close(parent_fd);
    }
    .Err(attach_failed_path(FsError.from_kind(.AlreadyExists, op: .Open), dst_bytes))
}

/| Unlinks a parent-relative temporary file inside `parent_dir_fd` on Linux (`[u8; 1024]` zero-alloc fast path).
@cfg(target.os == "linux") @std_cap_boundary(clears: [ffi, unsafe_op])
fn linux_unlink_staged_at(parent_dir_fd: i32, tmp_bytes: &[u8], /) {
    if parent_dir_fd < 0 or tmp_bytes.is_empty() or has_interior_nul(tmp_bytes) {
        return;
    }
    if tmp_bytes.len() < 1_024_usize {
        var stack_cstr: [u8; 1_024] = [0_u8; 1_024];
        unsafe {
            @memcpy(
                (&raw mut stack_cstr[0]) as *mut opaque,
                tmp_bytes.as_ptr() as *opaque,
                tmp_bytes.len(),
            );
            _ = sys.linux.linux_unlinkat(parent_dir_fd, &raw stack_cstr[0], 0);
        }
        return;
    }
    if PosixCStrBuf.encode(tmp_bytes, .Unlink) is .Ok(var ctmp) {
        unsafe {
            _ = sys.linux.linux_unlinkat(parent_dir_fd, ctmp.as_ptr(), 0);
        }
        ctmp.deinit();
    }
}

/| Publishes `StagedAtomicFile` on Linux (`fchmod` -> `fdatasync`/`fsync` -> `renameat` -> optional dir `fsync`).
@cfg(target.os == "linux") @std_cap_boundary(clears: [ffi, unsafe_op])
fn os_staged_atomic_publish(
    staged: own StagedAtomicFile,
    durability: DurabilityMode,
    /,
) -> unit!FsError {
    let StagedAtomicFile { file, parent_dir_fd: parent_bits, tmp_path, dst_path, perms } = staged;
    let parent_dir_fd = parent_bits as i32;
    let File { raw_fd: file_raw } = file;
    let raw_fd = raw_fd_to_bits(file_raw) as i32;
    let chmod_rc: i32 = unsafe {
        sys.linux.linux_fchmod(raw_fd, perms.posix_mode as u32)
    };
    if chmod_rc < 0 {
        let chmod_err: FsError = linux_last_fs_error(.Stat, dst_path.as_bytes());
        unsafe {
            _ = sys.linux.linux_close(raw_fd);
        }
        linux_unlink_staged_at(parent_dir_fd, tmp_path.as_bytes());
        unsafe {
            _ = sys.linux.linux_close(parent_dir_fd);
        }
        return .Err(chmod_err);
    }
    if os_file_sync(raw_fd as isize, durability) is .Err(sync_err) {
        unsafe {
            _ = sys.linux.linux_close(raw_fd);
        }
        linux_unlink_staged_at(parent_dir_fd, tmp_path.as_bytes());
        unsafe {
            _ = sys.linux.linux_close(parent_dir_fd);
        }
        return .Err(sync_err);
    }
    unsafe {
        _ = sys.linux.linux_close(raw_fd);
    }
    var ctmp: PosixCStrBuf = PosixCStrBuf.encode(tmp_path.as_bytes(), .Rename) catch |tmp_err| {
        linux_unlink_staged_at(parent_dir_fd, tmp_path.as_bytes());
        unsafe {
            _ = sys.linux.linux_close(parent_dir_fd);
        }
        return .Err(tmp_err);
    };
    var cdst: PosixCStrBuf = PosixCStrBuf.encode(dst_path.as_bytes(), .Rename) catch |dst_err| {
        unsafe {
            _ = sys.linux.linux_unlinkat(parent_dir_fd, ctmp.as_ptr(), 0);
            _ = sys.linux.linux_close(parent_dir_fd);
        }
        ctmp.deinit();
        return .Err(dst_err);
    };
    let ren_rc: i32 = unsafe {
        sys.linux.linux_renameat(parent_dir_fd, ctmp.as_ptr(), parent_dir_fd, cdst.as_ptr())
    };
    if ren_rc < 0 {
        let ren_err: FsError = linux_last_fs_error(.Rename, dst_path.as_bytes());
        unsafe {
            _ = sys.linux.linux_unlinkat(parent_dir_fd, ctmp.as_ptr(), 0);
            _ = sys.linux.linux_close(parent_dir_fd);
        }
        ctmp.deinit();
        cdst.deinit();
        return .Err(ren_err);
    }
    ctmp.deinit();
    cdst.deinit();
    if durability == .PowerSafe {
        os_file_sync(parent_dir_fd as isize, .PowerSafe) catch {};
    }
    unsafe {
        _ = sys.linux.linux_close(parent_dir_fd);
    }
    .Ok(())
}

/| Aborts and unlinks `StagedAtomicFile` on Linux.
@cfg(target.os == "linux") @std_cap_boundary(clears: [ffi, unsafe_op])
fn os_staged_atomic_abort(staged: own StagedAtomicFile, /) {
    let StagedAtomicFile { file, parent_dir_fd: parent_bits, tmp_path, dst_path, perms } = staged;
    _ = dst_path;
    _ = perms;
    let parent_dir_fd = parent_bits as i32;
    let File { raw_fd: file_raw } = file;
    let raw_fd = raw_fd_to_bits(file_raw) as i32;
    if raw_fd >= 0 {
        unsafe {
            _ = sys.linux.linux_close(raw_fd);
        }
    }
    if parent_dir_fd >= 0 {
        linux_unlink_staged_at(parent_dir_fd, tmp_path.as_bytes());
        unsafe {
            _ = sys.linux.linux_close(parent_dir_fd);
        }
    }
}

/| Publishes an existing staged file onto `dst_bytes` on Linux.
@cfg(target.os == "linux") @std_cap_boundary(clears: [ffi, unsafe_op])
fn os_publish_staged_path(
    staged_bytes: &[u8],
    dst_bytes: &[u8],
    durability: DurabilityMode,
    /,
) -> unit!FsError {
    if durability != .FastLocal {
        var f_staged: File = File.open_with(
            Path.from_bytes(staged_bytes),
            OpenOptions {
                flags: OpenFlags {
                    read: true,
                    write: false,
                    append: false,
                    create: false,
                    create_new: false,
                    truncate: false,
                    no_follow: true,
                    sync_data: false,
                    lock_shared: false,
                    lock_exclusive: false,
                    nonblocking_lock: false,
                    reserved: 0_u8,
                },
                permissions: FilePermissions.DEFAULT_FILE,
            },
        )?;
        let sync_res: unit!FsError = f_staged.sync(durability);
        f_staged.close();
        sync_res?;
    }
    var csrc: PosixCStrBuf = PosixCStrBuf.encode(staged_bytes, .Rename)?;
    var cdst: PosixCStrBuf = PosixCStrBuf.encode(dst_bytes, .Rename) catch |de| {
        csrc.deinit();
        return .Err(de);
    };
    let rc: i32 = unsafe {
        sys.linux.linux_renameat(
            sys.linux.AT_FDCWD,
            csrc.as_ptr(),
            sys.linux.AT_FDCWD,
            cdst.as_ptr(),
        )
    };
    csrc.deinit();
    cdst.deinit();
    if rc < 0 {
        return .Err(linux_last_fs_error(.Rename, dst_bytes));
    }
    if durability == .PowerSafe {
        let (parent_dir, _) = split_parent_and_leaf(Path.from_bytes(dst_bytes), .Flush)?;
        if os_dir_open(parent_dir.as_bytes()) is .Ok(dir_bits) {
            os_file_sync(dir_bits, .PowerSafe) catch {};
            unsafe {
                _ = sys.linux.linux_close(dir_bits as i32);
            }
        }
    }
    .Ok(())
}

/| Executes 3-tier `FICLONE -> linkat -> copy_file_range / 64 KiB` materialization on Linux (`STD-02` §3.4A).
@cfg(target.os == "linux") @std_cap_boundary(clears: [ffi, unsafe_op])
fn os_materialize_file(
    src_bytes: &[u8],
    dst_bytes: &[u8],
    src_meta: Metadata,
    policy: MaterializePolicy,
    /,
) -> MaterializeMethod!FsError {
    var src_file: File = File.open(Path.from_bytes(src_bytes))?;
    var staged: StagedAtomicFile = os_staged_atomic_create(dst_bytes, src_meta.permissions) catch |se| {
        src_file.close();
        return .Err(se);
    };

    // [1] Tier 1: `ioctl(dst_fd, FICLONE, src_fd)` CoW reflink on Btrfs / XFS / bcachefs / OCFS2:
    let clone_rc: i32 = unsafe {
        sys.linux.linux_ioctl_int(
            raw_fd_to_bits(staged.file.raw_fd) as i32,
            sys.linux.FICLONE,
            raw_fd_to_bits(src_file.raw_fd) as i32,
        )
    };
    if clone_rc == 0 {
        src_file.close();
        os_staged_atomic_publish(own staged, .FastLocal)?;
        return .Ok(.Reflinked);
    }

    // [2] Tier 2: `linkat` into staged sibling + `renameat` for `ImmutableCas` (`< 1023` links):
    if policy == .ImmutableCas and src_meta.hardlink_count < MAX_SAFE_HARDLINKS {
        let dst_view = Path.from_bytes(dst_bytes);
        let (parent_dir, leaf_bytes) = split_parent_and_leaf(dst_view, .Clone) catch |pe| {
            src_file.close();
            os_staged_atomic_abort(own staged);
            return .Err(pe);
        };
        if os_dir_open(parent_dir.as_bytes()) is .Ok(par_bits) {
            let par_fd = par_bits as i32;
            let hl_leaf: PathBuf = build_staged_tmp_path(Path.from_bytes(b"."), leaf_bytes, 97_u32);
            if PosixCStrBuf.encode(src_bytes, .Clone) is .Ok(var csrc) {
                if PosixCStrBuf.encode(hl_leaf.as_bytes(), .Clone) is .Ok(var chl) {
                    let link_rc: i32 = unsafe {
                        sys.linux.linux_linkat(
                            sys.linux.AT_FDCWD,
                            csrc.as_ptr(),
                            par_fd,
                            chl.as_ptr(),
                            sys.linux.AT_SYMLINK_FOLLOW,
                        )
                    };
                    if link_rc == 0 {
                        if PosixCStrBuf.encode(leaf_bytes, .Rename) is .Ok(var cdst_leaf) {
                            let ren_rc: i32 = unsafe {
                                sys.linux.linux_renameat(
                                    par_fd,
                                    chl.as_ptr(),
                                    par_fd,
                                    cdst_leaf.as_ptr(),
                                )
                            };
                            cdst_leaf.deinit();
                            if ren_rc == 0 {
                                csrc.deinit();
                                chl.deinit();
                                unsafe {
                                    _ = sys.linux.linux_close(par_fd);
                                }
                                src_file.close();
                                os_staged_atomic_abort(own staged);
                                return .Ok(.Hardlinked);
                            }
                        }
                        unsafe {
                            _ = sys.linux.linux_unlinkat(par_fd, chl.as_ptr(), 0);
                        }
                    }
                    chl.deinit();
                }
                csrc.deinit();
            }
            unsafe {
                _ = sys.linux.linux_close(par_fd);
            }
        }
    }

    // [3] Tier 3: `copy_file_range` zero-copy kernel splice falling back to `64 KiB` loop:
    var copied_bytes = 0_u64;
    var cfr_supported = true;
    while copied_bytes < src_meta.size and cfr_supported {
        let rem_u64: u64 = src_meta.size -% copied_bytes;
        let chunk_sz: usize = if rem_u64 > 0x4000_0000_u64 => 0x4000_0000_usize
            else rem_u64 as usize;
        let cfr_rc: isize = unsafe {
            sys.linux.linux_copy_file_range(
                raw_fd_to_bits(src_file.raw_fd) as i32,
                @default_init[*mut i64](),
                raw_fd_to_bits(staged.file.raw_fd) as i32,
                @default_init[*mut i64](),
                chunk_sz,
                0_u32,
            )
        };
        if cfr_rc > 0_isize {
            copied_bytes = copied_bytes +% (cfr_rc as u64);
        } else if cfr_rc == 0_isize {
            break;
        } else {
            let cfr_err: i32 = linux_errno();
            if cfr_err == sys.linux.EINTR {
                continue;
            }
            cfr_supported = false;
        }
    }
    if not cfr_supported or copied_bytes < src_meta.size {
        if src_file.seek(.Start(copied_bytes)) is .Err(sk_err) {
            src_file.close();
            os_staged_atomic_abort(own staged);
            return .Err(FsError.from_io(sk_err, op: .Clone));
        }
        if staged.file.seek(.Start(copied_bytes)) is .Err(sk_err2) {
            src_file.close();
            os_staged_atomic_abort(own staged);
            return .Err(FsError.from_io(sk_err2, op: .Clone));
        }
        if copy_file_loop_64k(&mut src_file, &mut staged.file) is .Err(cp_err) {
            src_file.close();
            os_staged_atomic_abort(own staged);
            return .Err(cp_err);
        }
    }
    src_file.close();
    os_staged_atomic_publish(own staged, .FastLocal)?;
    .Ok(.Copied)
}

/| Acquires an advisory `flock` lock on Linux (`EAGAIN` -> `.FileLockConflict`, never unlinked on release).
@cfg(target.os == "linux") @std_cap_boundary(clears: [ffi, unsafe_op])
fn os_file_lock_acquire(
    path_bytes: &[u8],
    mode: LockMode,
    nonblocking: bool,
    /,
) -> FileLock!FsError {
    var cpath: PosixCStrBuf = PosixCStrBuf.encode(path_bytes, .Lock)?;
    let fd: i32 = unsafe {
        sys.linux.linux_openat_mode(
            sys.linux.AT_FDCWD,
            cpath.as_ptr(),
            sys.linux.O_RDWR | sys.linux.O_CREAT | sys.linux.O_CLOEXEC,
            0o644_u32,
        )
    };
    cpath.deinit();
    if fd < 0 {
        return .Err(linux_last_fs_error(.Lock, path_bytes));
    }
    var lock_op: i32 = if mode == .Exclusive => sys.linux.LOCK_EX else sys.linux.LOCK_SH;
    if nonblocking {
        lock_op |= sys.linux.LOCK_NB;
    }
    while true {
        let rc: i32 = unsafe {
            sys.linux.linux_flock(fd, lock_op)
        };
        if rc == 0 {
            return .Ok(FileLock { file: File { raw_fd: bits_to_raw_fd(fd as isize) } });
        }
        let err_no: i32 = linux_errno();
        if err_no == sys.linux.EINTR {
            continue;
        }
        unsafe {
            _ = sys.linux.linux_close(fd);
        }
        if err_no == sys.linux.EAGAIN {
            return .Err(
                attach_failed_path(FsError.from_kind(.FileLockConflict, op: .Lock), path_bytes),
            );
        }
        return .Err(
            attach_failed_path(
                FsError.from_raw_os(err_no, domain: .PosixErrno, op: .Lock),
                path_bytes,
            ),
        );
    }
    .Err(FsError.from_kind(.Other, op: .Lock))
}

/| Unlocks and closes a Linux `FileLock` without unlinking the lockfile.
@cfg(target.os == "linux") @std_cap_boundary(clears: [ffi, unsafe_op])
fn os_file_lock_release(lock: own FileLock, /) {
    let FileLock { file } = lock;
    let File { raw_fd: file_raw } = file;
    let raw_fd = raw_fd_to_bits(file_raw) as i32;
    if raw_fd >= 0 {
        unsafe {
            _ = sys.linux.linux_flock(raw_fd, sys.linux.LOCK_UN);
            _ = sys.linux.linux_close(raw_fd);
        }
    }
}

/| Builds an `inotify` event mask from `WatchMask`.
fn linux_inotify_mask_bits(mask: WatchMask, /) -> u32 {
    var bits = 0_u32;
    if mask.create {
        bits |= sys.linux.IN_CREATE;
    }
    if mask.modify {
        bits |= sys.linux.IN_MODIFY;
    }
    if mask.remove {
        bits |= sys.linux.IN_DELETE | sys.linux.IN_DELETE_SELF;
    }
    if mask.rename {
        bits |= sys.linux.IN_MOVED_FROM | sys.linux.IN_MOVED_TO | sys.linux.IN_MOVE_SELF;
    }
    if mask.attrib {
        bits |= sys.linux.IN_ATTRIB;
    }
    if bits == 0_u32 {
        bits = sys.linux.IN_CREATE
            | sys.linux.IN_MODIFY
            | sys.linux.IN_DELETE
            | sys.linux.IN_MOVED_FROM
            | sys.linux.IN_MOVED_TO;
    }
    bits
}

/| Registers `dir_path` (and recursive subdirectories up to `MAX_DIR_WALK_DEPTH`) with `inotify`.
@std_cap_boundary(clears: [ffi, unsafe_op, may_panic])
fn linux_add_watch_tree(
    state: &mut LinuxWatcherState,
    watch_id: u32,
    node_path: Path,
    mask: WatchMask,
    depth: usize,
    /,
) -> unit!FsError {
    if state.nodes.len() >= MAX_WATCH_ENTRIES {
        return .Err(FsError.from_kind(.OutOfMemory, op: .Watch));
    }
    var cpath: PosixCStrBuf = PosixCStrBuf.encode(node_path.as_bytes(), .Watch)?;
    let wd: i32 = unsafe {
        sys.linux.linux_inotify_add_watch(
            state.inotify_fd,
            cpath.as_ptr(),
            linux_inotify_mask_bits(mask),
        )
    };
    cpath.deinit();
    if wd < 0 {
        return .Err(linux_last_fs_error(.Watch, node_path.as_bytes()));
    }
    state.nodes.push(
        LinuxWatchNode {
            wd,
            watch_id,
            mask,
            node_path: node_path.to_path_buf(),
        },
    );
    if not mask.recursive or depth >= MAX_DIR_WALK_DEPTH {
        return .Ok(());
    }
    if os_path_metadata(node_path.as_bytes(), false) is .Ok(meta)
        and meta.is_dir()
        and os_dir_open(
            node_path.as_bytes(),
        ) is .Ok(dir_bits) {
        let dir_fd = dir_bits as i32;
        if os_dir_entries(dir_bits) is .Ok(iter_raw) {
            while (os_dir_iter_next(iter_raw) catch .None) is .Some(entry) {
                if entry.file_type == FileType.Directory {
                    let child_pb: PathBuf = node_path.join(entry.name.as_path());
                    linux_add_watch_tree(
                        state,
                        watch_id,
                        child_pb.as_path(),
                        mask,
                        depth +% 1_usize,
                    ) catch {};
                }
            }
            os_dir_iter_close(iter_raw);
        }
        unsafe {
            _ = sys.linux.linux_close(dir_fd);
        }
    }
    .Ok(())
}

/| Allocates a `LinuxWatcherState` backed by `inotify_init1(IN_NONBLOCK | IN_CLOEXEC)`.
@cfg(target.os == "linux") @std_cap_boundary(clears: [ffi, unsafe_op])
fn os_watcher_new() -> (*mut opaque)!FsError {
    let ifd: i32 = unsafe {
        sys.linux.linux_inotify_init1(sys.linux.IN_NONBLOCK | sys.linux.IN_CLOEXEC)
    };
    if ifd < 0 {
        return .Err(linux_last_fs_error(.Watch, EMPTY_BYTES));
    }
    let mem: *mut u8 = System
        .handle()
        .alloc(
            Layout { size: @size_of[LinuxWatcherState](), alignment: @align_of[LinuxWatcherState]() },
        ) catch {
        unsafe {
            _ = sys.linux.linux_close(ifd);
        }
        return .Err(FsError.from_kind(.OutOfMemory, op: .Watch));
    };
    let ptr = mem as *mut LinuxWatcherState;
    unsafe {
        @ptr_write(
            ptr,
            LinuxWatcherState {
                inotify_fd: ifd,
                next_watch_id: 1_u32,
                nodes: Vec[LinuxWatchNode].new(),
            },
        );
    }
    .Ok(ptr as *mut opaque)
}

/| Registers `path_bytes` on a Linux `FsWatcher`.
@cfg(target.os == "linux") @std_cap_boundary(clears: [unsafe_op])
fn os_watcher_watch(
    backend_state: *mut opaque,
    path_bytes: &[u8],
    mask: WatchMask,
    /,
) -> WatchId!FsError {
    let state_ptr = backend_state as *mut LinuxWatcherState;
    if state_ptr.is_null() {
        return .Err(FsError.from_kind(.InvalidInput, op: .Watch));
    }
    let state: &mut LinuxWatcherState = unsafe {
        &mut state_ptr.*
    };
    let wid: u32 = state.next_watch_id;
    state.next_watch_id = state.next_watch_id +% 1_u32;
    linux_add_watch_tree(state, wid, Path.from_bytes(path_bytes), mask, 0_usize)?;
    .Ok(wid as WatchId)
}

/| Unwatches all `inotify` descriptors associated with `id`.
@cfg(target.os == "linux") @std_cap_boundary(clears: [ffi, unsafe_op, may_panic])
fn os_watcher_unwatch(backend_state: *mut opaque, id: WatchId, /) -> unit!FsError {
    let state_ptr = backend_state as *mut LinuxWatcherState;
    if state_ptr.is_null() {
        return .Err(FsError.from_kind(.InvalidInput, op: .Watch));
    }
    let state: &mut LinuxWatcherState = unsafe {
        &mut state_ptr.*
    };
    let target_u32 = id as u32;
    var removed_any = false;
    var idx = 0_usize;
    while idx < state.nodes.len() {
        if state.nodes[idx].watch_id == target_u32 {
            let wd_val: i32 = state.nodes[idx].wd;
            unsafe {
                _ = sys.linux.linux_inotify_rm_watch(state.inotify_fd, wd_val);
            }
            _ = state.nodes.swap_remove(idx);
            removed_any = true;
        } else {
            idx = idx +% 1_usize;
        }
    }
    if not removed_any {
        return .Err(FsError.from_kind(.NotFound, op: .Watch));
    }
    .Ok(())
}

/| Polls `inotify_fd` via `poll` + `read`, translating `inotify_event` records into `out_events`.
@cfg(target.os == "linux") @std_cap_boundary(clears: [ffi, unsafe_op, may_panic])
fn os_watcher_poll(
    backend_state: *mut opaque,
    out_events: &mut Vec[WatchEvent],
    timeout: Duration?,
    /,
) -> usize!FsError {
    let state_ptr = backend_state as *mut LinuxWatcherState;
    if state_ptr.is_null() {
        return .Ok(0_usize);
    }
    let state: &mut LinuxWatcherState = unsafe {
        &mut state_ptr.*
    };
    let timeout_ms: i32 = match timeout {
        .None => -1,
        .Some(dur) => {
            let ms_u64: u64 = dur.as_millis();
            if ms_u64 > (i32.MAX as u64) => i32.MAX else ms_u64 as i32
        },
    };
    var pfd = sys.linux.PosixPollFd {
        file_desc: state.inotify_fd,
        events: sys.linux.POLLIN,
        revents: 0_i16,
    };
    let poll_rc: i32 = unsafe {
        sys.linux.linux_poll(&raw mut pfd, 1_u64, timeout_ms)
    };
    if poll_rc < 0 {
        let err_no: i32 = linux_errno();
        if err_no == sys.linux.EINTR {
            return .Ok(0_usize);
        }
        return .Err(FsError.from_raw_os(err_no, domain: .PosixErrno, op: .Watch));
    }
    if poll_rc == 0 {
        return .Ok(0_usize);
    }

    var ev_buf: [u64; 1_024] = [0_u64; 1_024];
    let nread: isize = unsafe {
        sys.linux.linux_posix_read(
            state.inotify_fd,
            (&raw mut ev_buf[0]) as *mut u8,
            8_192_usize,
        )
    };
    if nread <= 0_isize {
        return .Ok(0_usize);
    }
    var pos = 0_usize;
    let filled = nread as usize;
    var count = 0_usize;
    let base_ptr = (&raw ev_buf[0]) as *u8;
    while pos +% 16_usize <= filled {
        let hdr_ptr = unsafe {
            base_ptr.add(pos) as *sys.linux.LinuxInotifyEventHdr
        };
        let hdr_val: sys.linux.LinuxInotifyEventHdr = unsafe {
            hdr_ptr.read()
        };
        let wd_val: i32 = hdr_val.wd;
        let ev_mask: u32 = hdr_val.mask;
        let cookie_val: u32 = hdr_val.cookie;
        let padded_name = hdr_val.name_len as usize;
        let rec_len = 16_usize +% padded_name;
        if pos +% rec_len > filled {
            break;
        }
        if (ev_mask & sys.linux.IN_Q_OVERFLOW) != 0_u32 {
            out_events.push(
                WatchEvent {
                    watch_id: 0_u32 as WatchId,
                    path: PathBuf.new(),
                    flags: WatchEventFlags {
                        created: false,
                        modified: false,
                        removed: false,
                        renamed_from: false,
                        renamed_to: false,
                        attrib: false,
                        is_dir: false,
                        rescan_required: true,
                        reserved: 0_u8,
                    },
                    rename_cookie: 0_u32,
                },
            );
            count = count +% 1_usize;
            pos = pos +% rec_len;
            continue;
        }

        var matched_idx: usize? = .None;
        var scan_idx = 0_usize;
        while scan_idx < state.nodes.len() {
            if state.nodes[scan_idx].wd == wd_val {
                matched_idx = .Some(scan_idx);
                break;
            }
            scan_idx = scan_idx +% 1_usize;
        }
        if matched_idx is .Some(nidx) {
            let wid = state.nodes[nidx].watch_id as WatchId;
            var event_pb: PathBuf = state.nodes[nidx].node_path.clone();
            if padded_name > 0_usize {
                let raw_name_ptr: *u8 = unsafe {
                    base_ptr.add(pos +% 16_usize)
                };
                let act_len: usize = cstr_len_bounded(raw_name_ptr, padded_name);
                if act_len > 0_usize {
                    let child_slice: &[u8] = unsafe {
                        @slice_from_raw_parts(raw_name_ptr, act_len)
                    };
                    event_pb = event_pb.as_path().join(Path.from_bytes(child_slice));
                }
            }
            let is_dir_ev: bool = (ev_mask & LINUX_IN_ISDIR) != 0_u32;
            if is_dir_ev
                and (ev_mask & (sys.linux.IN_CREATE | sys.linux.IN_MOVED_TO)) != 0_u32
                and state.nodes[
                    nidx,
                ]
                    .mask
                    .recursive {
                let rec_wid: u32 = state.nodes[nidx].watch_id;
                let rec_mask: WatchMask = state.nodes[nidx].mask;
                linux_add_watch_tree(state, rec_wid, event_pb.as_path(), rec_mask, 1_usize) catch {};
            }
            out_events.push(
                WatchEvent {
                    watch_id: wid,
                    path: event_pb,
                    flags: WatchEventFlags {
                        created: (ev_mask & sys.linux.IN_CREATE) != 0_u32,
                        modified: (ev_mask & sys.linux.IN_MODIFY) != 0_u32,
                        removed: (ev_mask & (sys.linux.IN_DELETE | sys.linux.IN_DELETE_SELF))
                            != 0_u32,
                        renamed_from: (ev_mask & (sys.linux.IN_MOVED_FROM | sys.linux.IN_MOVE_SELF))
                            != 0_u32,
                        renamed_to: (ev_mask & sys.linux.IN_MOVED_TO) != 0_u32,
                        attrib: (ev_mask & sys.linux.IN_ATTRIB) != 0_u32,
                        is_dir: is_dir_ev,
                        rescan_required: false,
                        reserved: 0_u8,
                    },
                    rename_cookie: cookie_val,
                },
            );
            count = count +% 1_usize;
        }
        pos = pos +% rec_len;
    }
    .Ok(count)
}

/| Closes `inotify_fd` and frees `LinuxWatcherState`.
@cfg(target.os == "linux") @std_cap_boundary(clears: [ffi, unsafe_op])
fn os_watcher_close(backend_state: *mut opaque, /) {
    let state_ptr = backend_state as *mut LinuxWatcherState;
    if state_ptr.is_null() {
        return;
    }
    let state_ref: &LinuxWatcherState = unsafe {
        &state_ptr.*
    };
    let ifd: i32 = state_ref.inotify_fd;
    if ifd >= 0 {
        unsafe {
            _ = sys.linux.linux_close(ifd);
        }
    }
    unsafe {
        @drop_in_place(state_ptr);
    }
    System
        .handle()
        .dealloc(
            backend_state as *mut u8,
            Layout { size: @size_of[LinuxWatcherState](), alignment: @align_of[LinuxWatcherState]() },
        );
}

// ----------------- macOS Host Implementation ------------------
/| Reads thread-local `errno` on macOS Darwin (`__error`).
@std_cap_boundary(clears: [ffi, unsafe_op])
fn darwin_errno() -> i32 {
    unsafe {
        sys.macos.darwin_errno_location().read()
    }
}

/| Builds `FsError` from `darwin_errno()` with optional `failed_bytes` context.
fn darwin_last_fs_error(op: IoOp, failed_bytes: &[u8], /) -> FsError {
    attach_failed_path(
        FsError.from_raw_os(darwin_errno(), domain: .PosixErrno, op: op),
        failed_bytes,
    )
}

/| Converts `DarwinStat64` (`144 B`) into `Metadata`.
fn metadata_from_darwin_stat(st: &sys.macos.DarwinStat64, /) -> Metadata {
    let clamped_size: u64 = if st.st_size < 0_i64 => 0_u64 else st.st_size as u64;
    let created_opt: SystemTime? = if st.st_birthtimespec.tv_sec <= 0_i64
        and st.st_birthtimespec.tv_nsec == 0_i64 {
        .None
    } else {
        make_system_time_opt(st.st_birthtimespec.tv_sec, st.st_birthtimespec.tv_nsec)
    };
    Metadata {
        file_type: classify_posix_mode(st.st_mode as u32),
        size: clamped_size,
        permissions: perms_from_posix_bits(st.st_mode as u32),
        modified: make_system_time_opt(st.st_mtimespec.tv_sec, st.st_mtimespec.tv_nsec),
        accessed: make_system_time_opt(st.st_atimespec.tv_sec, st.st_atimespec.tv_nsec),
        created: created_opt,
        dev_id: (st.st_dev as u32) as u64,
        inode_or_file_id: st.st_ino,
        hardlink_count: st.st_nlink as u32,
    }
}

/| Applies optional advisory `flock` flags (`lock_shared` / `lock_exclusive`) to `raw_fd` on macOS, closing `raw_fd` on failure.
@cfg(target.os == "macos") @std_cap_boundary(clears: [ffi, unsafe_op])
fn darwin_apply_open_flock(raw_fd: i32, flags: OpenFlags, failed_bytes: &[u8], /) -> unit!FsError {
    if not flags.lock_shared and not flags.lock_exclusive {
        return .Ok(());
    }
    var lock_op: i32 = if flags.lock_exclusive => sys.macos.LOCK_EX else sys.macos.LOCK_SH;
    if flags.nonblocking_lock {
        lock_op |= sys.macos.LOCK_NB;
    }
    while true {
        let lock_rc: i32 = unsafe {
            sys.macos.darwin_flock(raw_fd, lock_op)
        };
        if lock_rc == 0 {
            return .Ok(());
        }
        let err_no: i32 = darwin_errno();
        if err_no == sys.macos.EINTR and not flags.nonblocking_lock {
            continue;
        }
        unsafe {
            _ = sys.macos.darwin_close(raw_fd);
        }
        if err_no == sys.macos.EAGAIN {
            return .Err(
                attach_failed_path(FsError.from_kind(.FileLockConflict, op: .Lock), failed_bytes),
            );
        }
        return .Err(
            attach_failed_path(
                FsError.from_raw_os(err_no, domain: .PosixErrno, op: .Lock),
                failed_bytes,
            ),
        );
    }
    .Ok(())
}

/| Opens a macOS `File` descriptor with `O_CLOEXEC` and optional `flock`.
@cfg(target.os == "macos") @std_cap_boundary(clears: [ffi, unsafe_op])
fn os_file_open(path_bytes: &[u8], opts: OpenOptions, /) -> isize!FsError {
    var cpath: PosixCStrBuf = PosixCStrBuf.encode(path_bytes, .Open)?;
    var flags: i32 = sys.macos.O_CLOEXEC;
    if opts.flags.append {
        flags |= (if opts.flags.read => sys.macos.O_RDWR else sys.macos.O_WRONLY)
            | sys.macos.O_APPEND;
    } else if opts.flags.read and opts.flags.write {
        flags |= sys.macos.O_RDWR;
    } else if opts.flags.write {
        flags |= sys.macos.O_WRONLY;
    } else {
        flags |= sys.macos.O_RDONLY;
    }
    if opts.flags.create_new {
        flags |= sys.macos.O_CREAT | sys.macos.O_EXCL;
    } else if opts.flags.create {
        flags |= sys.macos.O_CREAT;
    }
    if opts.flags.truncate {
        flags |= sys.macos.O_TRUNC;
    }
    if opts.flags.no_follow {
        flags |= sys.macos.O_NOFOLLOW;
    }
    if opts.flags.sync_data {
        flags |= sys.macos.O_DSYNC;
    }
    let raw_fd: i32 = unsafe {
        sys.macos.darwin_openat_mode(
            sys.macos.AT_FDCWD,
            cpath.as_ptr(),
            flags,
            opts.permissions.posix_mode as u32,
        )
    };
    cpath.deinit();
    if raw_fd < 0 {
        let err_no: i32 = darwin_errno();
        if opts.flags.no_follow and err_no == sys.macos.ELOOP {
            return .Err(
                attach_failed_path(FsError.from_kind(.FilesystemLoop, op: .Open), path_bytes),
            );
        }
        return .Err(
            attach_failed_path(
                FsError.from_raw_os(err_no, domain: .PosixErrno, op: .Open),
                path_bytes,
            ),
        );
    }
    darwin_apply_open_flock(raw_fd, opts.flags, path_bytes)?;
    .Ok(raw_fd as isize)
}

/| Closes a macOS descriptor if non-negative.
@cfg(target.os == "macos") @std_cap_boundary(clears: [ffi, unsafe_op])
fn os_close_fd(fd_bits: isize, /) -> unit!FsError {
    let raw_fd = fd_bits as i32;
    if raw_fd < 0 {
        return .Ok(());
    }
    let rc: i32 = unsafe {
        sys.macos.darwin_close(raw_fd)
    };
    if rc < 0 {
        let err_no: i32 = darwin_errno();
        if err_no != sys.macos.EINTR {
            return .Err(FsError.from_raw_os(err_no, domain: .PosixErrno, op: .None));
        }
    }
    .Ok(())
}

/| Reads sequentially from a macOS descriptor.
@cfg(target.os == "macos") @std_cap_boundary(clears: [ffi, unsafe_op])
fn os_file_read(fd_bits: isize, dst_ptr: *mut u8, cap: usize, /) -> usize!IoError {
    let raw_fd = fd_bits as i32;
    let rc: isize = unsafe {
        sys.macos.darwin_read(raw_fd, dst_ptr, cap)
    };
    if rc < 0_isize {
        return .Err(IoError.from_raw_os(darwin_errno(), domain: .PosixErrno, op: .Read));
    }
    .Ok(rc as usize)
}

/| Reads positionally at `offset` from a macOS descriptor via `pread`.
@cfg(target.os == "macos") @std_cap_boundary(clears: [ffi, unsafe_op])
fn os_file_pread(fd_bits: isize, dst_ptr: *mut u8, cap: usize, offset: u64, /) -> usize!IoError {
    let raw_fd = fd_bits as i32;
    if offset > (i64.MAX as u64) {
        return .Err(IoError.from_kind(.InvalidInput, op: .Read));
    }
    let rc: isize = unsafe {
        sys.macos.darwin_pread(raw_fd, dst_ptr, cap, offset as i64)
    };
    if rc < 0_isize {
        return .Err(IoError.from_raw_os(darwin_errno(), domain: .PosixErrno, op: .Read));
    }
    .Ok(rc as usize)
}

/| Writes sequentially to a macOS descriptor.
@cfg(target.os == "macos") @std_cap_boundary(clears: [ffi, unsafe_op])
fn os_file_write(fd_bits: isize, buf: &[u8], /) -> usize!IoError {
    let raw_fd = fd_bits as i32;
    if buf.is_empty() {
        return .Ok(0_usize);
    }
    let rc: isize = unsafe {
        sys.macos.darwin_write(raw_fd, buf.as_ptr(), buf.len())
    };
    if rc < 0_isize {
        return .Err(IoError.from_raw_os(darwin_errno(), domain: .PosixErrno, op: .Write));
    }
    .Ok(rc as usize)
}

/| Writes positionally at `offset` to a macOS descriptor via `pwrite`.
@cfg(target.os == "macos") @std_cap_boundary(clears: [ffi, unsafe_op])
fn os_file_pwrite(fd_bits: isize, buf: &[u8], offset: u64, /) -> usize!IoError {
    let raw_fd = fd_bits as i32;
    if buf.is_empty() {
        return .Ok(0_usize);
    }
    if offset > (i64.MAX as u64) {
        return .Err(IoError.from_kind(.InvalidInput, op: .Write));
    }
    let rc: isize = unsafe {
        sys.macos.darwin_pwrite(raw_fd, buf.as_ptr(), buf.len(), offset as i64)
    };
    if rc < 0_isize {
        return .Err(IoError.from_raw_os(darwin_errno(), domain: .PosixErrno, op: .Write));
    }
    .Ok(rc as usize)
}

/| Writes scatter-gather `IoSlice`s via `writev` clamped to `POSIX_IOV_MAX = 1024`.
@cfg(target.os == "macos") @std_cap_boundary(clears: [ffi, unsafe_op])
fn os_file_write_vectored(fd_bits: isize, bufs: &[IoSlice], /) -> usize!IoError {
    let raw_fd = fd_bits as i32;
    if bufs.is_empty() {
        return .Ok(0_usize);
    }
    let count: usize = if bufs.len() > POSIX_IOV_MAX => POSIX_IOV_MAX else bufs.len();
    let rc: isize = unsafe {
        sys.macos.darwin_writev(raw_fd, bufs.as_ptr() as *sys.macos.PosixIovec, count as i32)
    };
    if rc < 0_isize {
        return .Err(IoError.from_raw_os(darwin_errno(), domain: .PosixErrno, op: .Write));
    }
    .Ok(rc as usize)
}

/| Seeks a macOS descriptor via `lseek`.
@cfg(target.os == "macos") @std_cap_boundary(clears: [ffi, unsafe_op])
fn os_file_seek(fd_bits: isize, pos: SeekFrom, /) -> u64!IoError {
    let raw_fd = fd_bits as i32;
    let (delta, whence) = match pos {
        .Start(abs_off) => {
            if abs_off > (i64.MAX as u64) {
                return .Err(IoError.from_kind(.InvalidInput, op: .Seek));
            }
            (abs_off as i64, sys.macos.SEEK_SET)
        },
        .Current(rel_off) => (rel_off, sys.macos.SEEK_CUR),
        .End(end_off) => (end_off, sys.macos.SEEK_END),
    };
    let res: i64 = unsafe {
        sys.macos.darwin_lseek(raw_fd, delta, whence)
    };
    if res < 0_i64 {
        return .Err(IoError.from_raw_os(darwin_errno(), domain: .PosixErrno, op: .Seek));
    }
    .Ok(res as u64)
}

/| Truncates or extends a macOS descriptor via `ftruncate`.
@cfg(target.os == "macos") @std_cap_boundary(clears: [ffi, unsafe_op])
fn os_file_set_len(fd_bits: isize, size: u64, /) -> unit!FsError {
    let raw_fd = fd_bits as i32;
    if size > (i64.MAX as u64) {
        return .Err(FsError.from_kind(.InvalidInput, op: .Write));
    }
    let rc: i32 = unsafe {
        sys.macos.darwin_ftruncate(raw_fd, size as i64)
    };
    if rc < 0 {
        return .Err(darwin_last_fs_error(.Write, EMPTY_BYTES));
    }
    .Ok(())
}

/| Sets POSIX mode bits on a macOS descriptor via `fchmod`.
@cfg(target.os == "macos") @std_cap_boundary(clears: [ffi, unsafe_op])
fn os_file_set_permissions(fd_bits: isize, perms: FilePermissions, /) -> unit!FsError {
    let raw_fd = fd_bits as i32;
    let rc: i32 = unsafe {
        sys.macos.darwin_fchmod(raw_fd, perms.posix_mode)
    };
    if rc < 0 {
        return .Err(darwin_last_fs_error(.Stat, EMPTY_BYTES));
    }
    .Ok(())
}

/| Flushes a macOS descriptor (`F_BARRIERFSYNC` for `CrashSafe`, `F_FULLFSYNC` for `PowerSafe`, `STD-02` §3.3).
@cfg(target.os == "macos") @std_cap_boundary(clears: [ffi, unsafe_op])
fn os_file_sync(fd_bits: isize, mode: DurabilityMode, /) -> unit!FsError {
    let raw_fd = fd_bits as i32;
    if mode == .FastLocal {
        return .Ok(());
    }
    let cmd: i32 = if mode == .CrashSafe => sys.macos.F_BARRIERFSYNC else sys.macos.F_FULLFSYNC;
    let fcntl_rc: i32 = unsafe {
        sys.macos.darwin_fcntl_int(raw_fd, cmd, 0)
    };
    if fcntl_rc == 0 {
        return .Ok(());
    }
    let fsync_rc: i32 = unsafe {
        sys.macos.darwin_fsync(raw_fd)
    };
    if fsync_rc < 0 {
        let err_no: i32 = darwin_errno();
        if err_no == sys.macos.EINVAL or err_no == sys.macos.ENOTSUP {
            return .Ok(());
        }
        return .Err(FsError.from_raw_os(err_no, domain: .PosixErrno, op: .Flush));
    }
    .Ok(())
}

/| Queries `Metadata` from an open macOS descriptor via `fstat`.
@cfg(target.os == "macos") @std_cap_boundary(clears: [ffi, unsafe_op])
fn os_file_metadata(fd_bits: isize, /) -> Metadata!FsError {
    let raw_fd = fd_bits as i32;
    var st = @default_init[sys.macos.DarwinStat64]();
    let rc: i32 = unsafe {
        sys.macos.darwin_fstat(raw_fd, &raw mut st)
    };
    if rc < 0 {
        return .Err(darwin_last_fs_error(.Stat, EMPTY_BYTES));
    }
    .Ok(metadata_from_darwin_stat(&st))
}

/| Opens a directory descriptor on macOS (`O_RDONLY | O_DIRECTORY | O_CLOEXEC`).
@cfg(target.os == "macos") @std_cap_boundary(clears: [ffi, unsafe_op])
fn os_dir_open(path_bytes: &[u8], /) -> isize!FsError {
    var cpath: PosixCStrBuf = PosixCStrBuf.encode(path_bytes, .Open)?;
    let fd: i32 = unsafe {
        sys.macos.darwin_openat_mode(
            sys.macos.AT_FDCWD,
            cpath.as_ptr(),
            sys.macos.O_RDONLY | sys.macos.O_DIRECTORY | sys.macos.O_CLOEXEC,
            0_u32,
        )
    };
    cpath.deinit();
    if fd < 0 {
        return .Err(darwin_last_fs_error(.Open, path_bytes));
    }
    .Ok(fd as isize)
}

/| Opens a descriptor strictly beneath `dir_fd` on macOS (`validate_beneath_lexical` + `O_NOFOLLOW_ANY`, `STD-02` §3.4B).
@std_cap_boundary(clears: [ffi, unsafe_op])
fn darwin_open_beneath(
    dir_fd: i32,
    rel_bytes: &[u8],
    flags: i32,
    mode_bits: u32,
    op: IoOp,
    /,
) -> i32!FsError {
    validate_beneath_lexical(rel_bytes, op)?;
    var cpath: PosixCStrBuf = PosixCStrBuf.encode(rel_bytes, op)?;
    let fast_fd: i32 = unsafe {
        sys.macos.darwin_openat_mode(
            dir_fd,
            cpath.as_ptr(),
            flags | sys.macos.O_CLOEXEC | sys.macos.O_NOFOLLOW_ANY,
            mode_bits,
        )
    };
    cpath.deinit();
    if fast_fd >= 0 {
        return .Ok(fast_fd);
    }
    let err_no: i32 = darwin_errno();
    if err_no == sys.macos.ELOOP {
        return .Err(attach_failed_path(FsError.from_kind(.FilesystemLoop, op: op), rel_bytes));
    }
    if err_no != sys.macos.EINVAL {
        return .Err(
            attach_failed_path(FsError.from_raw_os(err_no, domain: .PosixErrno, op: op), rel_bytes),
        );
    }

    // Per-component `O_NOFOLLOW` fallback if `O_NOFOLLOW_ANY` returned `EINVAL`:
    var cur_fd: i32 = dir_fd;
    var pos = 0_usize;
    let total: usize = rel_bytes.len();
    while pos < total {
        var seg_end: usize = pos;
        while seg_end < total and byte_at(rel_bytes, seg_end) != b'/' {
            seg_end = seg_end +% 1_usize;
        }
        let seg: &[u8] = subslice_u8(rel_bytes, pos, seg_end);
        var next_pos: usize = seg_end;
        while next_pos < total and byte_at(rel_bytes, next_pos) == b'/' {
            next_pos = next_pos +% 1_usize;
        }
        pos = next_pos;
        if seg.is_empty() or (seg.len() == 1_usize and byte_at(seg, 0_usize) == b'.') {
            continue;
        }
        let is_leaf: bool = pos >= total;
        var seg_cstr: PosixCStrBuf = PosixCStrBuf.encode(seg, op) catch |ce| {
            if cur_fd != dir_fd {
                unsafe {
                    _ = sys.macos.darwin_close(cur_fd);
                }
            }
            return .Err(ce);
        };
        let step_flags: i32 = if is_leaf {
            flags | sys.macos.O_CLOEXEC | sys.macos.O_NOFOLLOW
        } else {
            sys.macos.O_RDONLY | sys.macos.O_DIRECTORY | sys.macos.O_CLOEXEC | sys.macos.O_NOFOLLOW
        };
        let next_fd: i32 = unsafe {
            sys.macos.darwin_openat_mode(
                cur_fd,
                seg_cstr.as_ptr(),
                step_flags,
                if is_leaf => mode_bits else 0_u32,
            )
        };
        seg_cstr.deinit();
        if next_fd < 0 {
            let step_err: i32 = darwin_errno();
            if cur_fd != dir_fd {
                unsafe {
                    _ = sys.macos.darwin_close(cur_fd);
                }
            }
            if step_err == sys.macos.ELOOP {
                return .Err(
                    attach_failed_path(FsError.from_kind(.FilesystemLoop, op: op), rel_bytes),
                );
            }
            return .Err(
                attach_failed_path(
                    FsError.from_raw_os(step_err, domain: .PosixErrno, op: op),
                    rel_bytes,
                ),
            );
        }
        if cur_fd != dir_fd {
            unsafe {
                _ = sys.macos.darwin_close(cur_fd);
            }
        }
        if is_leaf {
            return .Ok(next_fd);
        }
        cur_fd = next_fd;
    }
    if cur_fd != dir_fd {
        unsafe {
            _ = sys.macos.darwin_close(cur_fd);
        }
    }
    .Err(attach_failed_path(FsError.from_kind(.InvalidInput, op: op), rel_bytes))
}

/| Opens a confined parent directory + leaf name beneath `dir_fd` on macOS.
fn darwin_open_parent_beneath(
    dir_fd: i32,
    rel_bytes: &[u8],
    op: IoOp,
    /,
) -> (i32, bool, PosixCStrBuf)!FsError {
    validate_beneath_lexical(rel_bytes, op)?;
    let rel_view = Path.from_bytes(rel_bytes);
    let (parent_view, leaf_bytes) = split_parent_and_leaf(rel_view, op)?;
    let leaf_cstr: PosixCStrBuf = PosixCStrBuf.encode(leaf_bytes, op)?;
    if is_single_dot(parent_view.as_bytes()) {
        return .Ok((dir_fd, false, leaf_cstr));
    }
    var cleanup_cstr: PosixCStrBuf = leaf_cstr;
    let parent_fd: i32 = darwin_open_beneath(
        dir_fd,
        parent_view.as_bytes(),
        sys.macos.O_RDONLY | sys.macos.O_DIRECTORY,
        0_u32,
        op,
    ) catch |pe| {
        cleanup_cstr.deinit();
        return .Err(pe);
    };
    .Ok((parent_fd, true, cleanup_cstr))
}

/| Opens a file strictly beneath `dir_fd` on macOS.
@cfg(target.os == "macos")
fn os_open_file_beneath(dir_bits: isize, rel_bytes: &[u8], opts: OpenOptions, /) -> isize!FsError {
    let dir_fd = dir_bits as i32;
    var flags: i32 = 0;
    if opts.flags.append {
        flags = (if opts.flags.read => sys.macos.O_RDWR else sys.macos.O_WRONLY)
            | sys.macos.O_APPEND;
    } else if opts.flags.read and opts.flags.write {
        flags = sys.macos.O_RDWR;
    } else if opts.flags.write {
        flags = sys.macos.O_WRONLY;
    } else {
        flags = sys.macos.O_RDONLY;
    }
    if opts.flags.create_new {
        flags |= sys.macos.O_CREAT | sys.macos.O_EXCL;
    } else if opts.flags.create {
        flags |= sys.macos.O_CREAT;
    }
    if opts.flags.truncate {
        flags |= sys.macos.O_TRUNC;
    }
    if opts.flags.sync_data {
        flags |= sys.macos.O_DSYNC;
    }
    let fd: i32 = darwin_open_beneath(
        dir_fd,
        rel_bytes,
        flags,
        opts.permissions.posix_mode as u32,
        .Open,
    )?;
    darwin_apply_open_flock(fd, opts.flags, rel_bytes)?;
    .Ok(fd as isize)
}

/| Opens a subdirectory strictly beneath `dir_fd` on macOS.
@cfg(target.os == "macos")
fn os_open_dir_beneath(dir_bits: isize, rel_bytes: &[u8], /) -> isize!FsError {
    let dir_fd = dir_bits as i32;
    let fd: i32 = darwin_open_beneath(
        dir_fd,
        rel_bytes,
        sys.macos.O_RDONLY | sys.macos.O_DIRECTORY,
        0_u32,
        .Open,
    )?;
    .Ok(fd as isize)
}

/| Creates a directory strictly beneath `dir_fd` on macOS.
@cfg(target.os == "macos") @std_cap_boundary(clears: [ffi, unsafe_op])
fn os_create_dir_beneath(dir_bits: isize, rel_bytes: &[u8], perms: FilePermissions, /) -> unit!FsError {
    let dir_fd = dir_bits as i32;
    var (parent_fd, owns_parent, leaf_cstr) = darwin_open_parent_beneath(dir_fd, rel_bytes, .Mkdir)?;
    let rc: i32 = unsafe {
        sys.macos.darwin_mkdirat(parent_fd, leaf_cstr.as_ptr(), perms.posix_mode)
    };
    let err_opt: FsError? = if rc < 0 => .Some(darwin_last_fs_error(.Mkdir, rel_bytes)) else .None;
    leaf_cstr.deinit();
    if owns_parent {
        unsafe {
            _ = sys.macos.darwin_close(parent_fd);
        }
    }
    if err_opt is .Some(err_val) {
        return .Err(err_val);
    }
    .Ok(())
}

/| Unlinks a non-symlink file strictly beneath `dir_fd` on macOS.
@cfg(target.os == "macos") @std_cap_boundary(clears: [ffi, unsafe_op])
fn os_unlink_file_beneath(dir_bits: isize, rel_bytes: &[u8], /) -> unit!FsError {
    let dir_fd = dir_bits as i32;
    var (parent_fd, owns_parent, leaf_cstr) = darwin_open_parent_beneath(dir_fd, rel_bytes, .Unlink)?;
    var st = @default_init[sys.macos.DarwinStat64]();
    let st_rc: i32 = unsafe {
        sys.macos.darwin_fstatat(
            parent_fd,
            leaf_cstr.as_ptr(),
            &raw mut st,
            sys.macos.AT_SYMLINK_NOFOLLOW,
        )
    };
    if st_rc == 0 and classify_posix_mode(st.st_mode as u32) == .Symlink {
        leaf_cstr.deinit();
        if owns_parent {
            unsafe {
                _ = sys.macos.darwin_close(parent_fd);
            }
        }
        return .Err(attach_failed_path(FsError.from_kind(.FilesystemLoop, op: .Unlink), rel_bytes));
    }
    let rc: i32 = unsafe {
        sys.macos.darwin_unlinkat(parent_fd, leaf_cstr.as_ptr(), 0)
    };
    let err_opt: FsError? = if rc < 0 => .Some(darwin_last_fs_error(.Unlink, rel_bytes)) else .None;
    leaf_cstr.deinit();
    if owns_parent {
        unsafe {
            _ = sys.macos.darwin_close(parent_fd);
        }
    }
    if err_opt is .Some(err_val) {
        return .Err(err_val);
    }
    .Ok(())
}

/| Queries metadata strictly beneath `dir_fd` on macOS (resolving confined relative leaf symlinks up to `8` hops when `follow_symlinks`).
@cfg(target.os == "macos") @std_cap_boundary(clears: [ffi, unsafe_op])
fn os_metadata_beneath(
    dir_bits: isize,
    rel_bytes: &[u8],
    follow_symlinks: bool,
    /,
) -> Metadata!FsError {
    let dir_fd = dir_bits as i32;
    if not follow_symlinks {
        var (parent_fd, owns_parent, leaf_cstr) = darwin_open_parent_beneath(
            dir_fd,
            rel_bytes,
            .Stat,
        )?;
        var st = @default_init[sys.macos.DarwinStat64]();
        let rc: i32 = unsafe {
            sys.macos.darwin_fstatat(
                parent_fd,
                leaf_cstr.as_ptr(),
                &raw mut st,
                sys.macos.AT_SYMLINK_NOFOLLOW,
            )
        };
        let res: Metadata!FsError = if rc < 0 => .Err(darwin_last_fs_error(.Stat, rel_bytes))
            else .Ok(metadata_from_darwin_stat(&st));
        leaf_cstr.deinit();
        if owns_parent {
            unsafe {
                _ = sys.macos.darwin_close(parent_fd);
            }
        }
        return res;
    }

    validate_beneath_lexical(rel_bytes, .Stat)?;
    var cur_rel = PathBuf.from(rel_bytes);
    var link_buf: [u8; 1_024] = [0_u8; 1_024];
    var hops = 0_usize;
    while hops <= MAX_BENEATH_SYMLINK_HOPS {
        var (parent_fd, owns_parent, leaf_cstr) = darwin_open_parent_beneath(
            dir_fd,
            cur_rel.as_bytes(),
            .Stat,
        ) catch |open_err| {
            return .Err(attach_failed_path(open_err, rel_bytes));
        };
        var st = @default_init[sys.macos.DarwinStat64]();
        let st_rc: i32 = unsafe {
            sys.macos.darwin_fstatat(
                parent_fd,
                leaf_cstr.as_ptr(),
                &raw mut st,
                sys.macos.AT_SYMLINK_NOFOLLOW,
            )
        };
        if st_rc < 0 {
            let st_err: FsError = darwin_last_fs_error(.Stat, rel_bytes);
            leaf_cstr.deinit();
            if owns_parent {
                unsafe {
                    _ = sys.macos.darwin_close(parent_fd);
                }
            }
            return .Err(st_err);
        }
        if classify_posix_mode(st.st_mode as u32) != .Symlink {
            leaf_cstr.deinit();
            if owns_parent {
                unsafe {
                    _ = sys.macos.darwin_close(parent_fd);
                }
            }
            return .Ok(metadata_from_darwin_stat(&st));
        }
        if hops == MAX_BENEATH_SYMLINK_HOPS {
            leaf_cstr.deinit();
            if owns_parent {
                unsafe {
                    _ = sys.macos.darwin_close(parent_fd);
                }
            }
            break;
        }
        let rl_len: isize = unsafe {
            sys.macos.darwin_readlinkat(
                parent_fd,
                leaf_cstr.as_ptr(),
                &raw mut link_buf[0],
                1_024_usize,
            )
        };
        let rl_err_no: i32 = if rl_len < 0_isize => darwin_errno() else 0;
        leaf_cstr.deinit();
        if owns_parent {
            unsafe {
                _ = sys.macos.darwin_close(parent_fd);
            }
        }
        if rl_len < 0_isize {
            return .Err(
                attach_failed_path(
                    FsError.from_raw_os(rl_err_no, domain: .PosixErrno, op: .Stat),
                    rel_bytes,
                ),
            );
        }
        if rl_len == 0_isize or (rl_len as usize) >= 1_024_usize {
            return .Err(
                attach_failed_path(FsError.from_kind(.InvalidFilename, op: .Stat), rel_bytes),
            );
        }
        let target_slice: &[u8] = unsafe {
            @slice_from_raw_parts(&raw link_buf[0], rl_len as usize)
        };
        cur_rel = join_confined_symlink_target(cur_rel.as_bytes(), target_slice, .Stat) catch |join_err| {
            return .Err(attach_failed_path(join_err, rel_bytes));
        };
        if cur_rel.as_bytes().is_empty() {
            return os_file_metadata(dir_fd as isize);
        }
        hops = hops +% 1_usize;
    }
    .Err(attach_failed_path(FsError.from_kind(.FilesystemLoop, op: .Stat), rel_bytes))
}

/| Opens an independent `DarwinDirIterState` (`openat(dir_fd, ".")` + `__getdirentries64`).
@cfg(target.os == "macos") @std_cap_boundary(clears: [ffi, unsafe_op])
fn os_dir_entries(dir_bits: isize, /) -> (*mut opaque)!FsError {
    let dir_fd = dir_bits as i32;
    let dot_nul: [u8; 2] = [b'.', 0_u8];
    let dup_fd: i32 = unsafe {
        sys.macos.darwin_openat_mode(
            dir_fd,
            &raw dot_nul[0],
            sys.macos.O_RDONLY | sys.macos.O_DIRECTORY | sys.macos.O_CLOEXEC,
            0_u32,
        )
    };
    if dup_fd < 0 {
        return .Err(darwin_last_fs_error(.Readdir, EMPTY_BYTES));
    }
    let mem: *mut u8 = System
        .handle()
        .alloc(
            Layout {
                size: @size_of[DarwinDirIterState](),
                alignment: @align_of[DarwinDirIterState](),
            },
        ) catch {
        unsafe {
            _ = sys.macos.darwin_close(dup_fd);
        }
        return .Err(FsError.from_kind(.OutOfMemory, op: .Readdir));
    };
    let state_ptr = mem as *mut DarwinDirIterState;
    if state_ptr.is_null() {
        unsafe {
            _ = sys.macos.darwin_close(dup_fd);
        }
        return .Err(FsError.from_kind(.OutOfMemory, op: .Readdir));
    }
    unsafe {
        state_ptr.*.dup_fd = dup_fd;
        state_ptr.*.seek_base = 0_i64;
        state_ptr.*.buf_pos = 0_usize;
        state_ptr.*.buf_filled = 0_usize;
        state_ptr.*.is_eof = false;
    }
    .Ok(state_ptr as *mut opaque)
}

/| Advances `DarwinDirIterState` via `__getdirentries64` (`d_name` at byte offset `21`).
@cfg(target.os == "macos") @std_cap_boundary(clears: [ffi, unsafe_op, may_panic])
fn os_dir_iter_next(raw_state: *mut opaque, /) -> DirEntry?!FsError {
    let state_ptr = raw_state as *mut DarwinDirIterState;
    if state_ptr.is_null() {
        return .Ok(.None);
    }
    let state: &mut DarwinDirIterState = unsafe {
        &mut state_ptr.*
    };
    while not state.is_eof {
        if state.buf_pos >= state.buf_filled {
            let nread: isize = unsafe {
                sys.macos.darwin_getdirentries64(
                    state.dup_fd,
                    (&raw mut state.dirent_buf[0]) as *mut u8,
                    8_192_usize,
                    &raw mut state.seek_base,
                )
            };
            if nread < 0_isize {
                return .Err(darwin_last_fs_error(.Readdir, EMPTY_BYTES));
            }
            if nread == 0_isize {
                state.is_eof = true;
                return .Ok(.None);
            }
            state.buf_pos = 0_usize;
            state.buf_filled = nread as usize;
        }
        if state.buf_pos +% 21_usize > state.buf_filled {
            state.buf_pos = state.buf_filled;
            continue;
        }
        let base_ptr = (&raw state.dirent_buf[0]) as *u8;
        let hdr_ptr = unsafe {
            base_ptr.add(state.buf_pos) as *sys.macos.DarwinDirent64Hdr
        };
        let hdr_val: sys.macos.DarwinDirent64Hdr = unsafe {
            hdr_ptr.read()
        };
        let reclen = hdr_val.d_reclen as usize;
        if reclen < 21_usize or state.buf_pos +% reclen > state.buf_filled {
            state.is_eof = true;
            return .Err(FsError.from_kind(.InvalidData, op: .Readdir));
        }
        let ino_val: u64 = hdr_val.d_ino;
        let namlen = hdr_val.d_namlen as usize;
        let raw_dtype: u8 = hdr_val.d_type;
        let name_ptr: *u8 = unsafe {
            base_ptr.add(state.buf_pos +% 21_usize)
        };
        let safe_namlen: usize = if 21_usize +% namlen <= reclen => namlen
            else cstr_len_bounded(name_ptr, reclen -% 21_usize);
        state.buf_pos = state.buf_pos +% reclen;

        if ino_val == 0_u64 or safe_namlen == 0_usize {
            continue;
        }
        let name_slice: &[u8] = unsafe {
            @slice_from_raw_parts(name_ptr, safe_namlen)
        };
        if is_dot_or_dotdot(name_slice) {
            continue;
        }
        var ftype: FileType = classify_posix_dtype(raw_dtype);
        if raw_dtype == sys.macos.DT_UNKNOWN {
            var st = @default_init[sys.macos.DarwinStat64]();
            let st_rc: i32 = unsafe {
                sys.macos.darwin_fstatat(
                    state.dup_fd,
                    name_ptr,
                    &raw mut st,
                    sys.macos.AT_SYMLINK_NOFOLLOW,
                )
            };
            if st_rc == 0 {
                ftype = classify_posix_mode(st.st_mode as u32);
            }
        }
        return .Ok(
            .Some(
                DirEntry {
                    name: PathBuf.from(name_slice),
                    file_type: ftype,
                    inode_or_file_id: ino_val,
                },
            ),
        );
    }
    .Ok(.None)
}

/| Closes `dup_fd` and deallocates `DarwinDirIterState`.
@cfg(target.os == "macos") @std_cap_boundary(clears: [ffi, unsafe_op])
fn os_dir_iter_close(raw_state: *mut opaque, /) {
    let state_ptr = raw_state as *mut DarwinDirIterState;
    if state_ptr.is_null() {
        return;
    }
    let dup_fd: i32 = unsafe {
        state_ptr.read().dup_fd
    };
    if dup_fd >= 0 {
        unsafe {
            _ = sys.macos.darwin_close(dup_fd);
        }
    }
    System
        .handle()
        .dealloc(
            raw_state as *mut u8,
            Layout {
                size: @size_of[DarwinDirIterState](),
                alignment: @align_of[DarwinDirIterState](),
            },
        );
}

/| Maps a non-empty macOS `File` read-only via `mmap(PROT_READ, MAP_PRIVATE)`.
@cfg(target.os == "macos") @std_cap_boundary(clears: [ffi, unsafe_op])
fn os_mmap_open_read_only(
    fd_bits: isize,
    len_bytes: usize,
    require_nul_sentinel: bool,
    /,
) -> Mmap!FsError {
    let raw_fd = fd_bits as i32;
    if require_nul_sentinel and (len_bytes & 4_095_usize) == 0_usize {
        return .Err(FsError.from_kind(.Unsupported, op: .Mmap));
    }
    let mapped: *mut opaque = unsafe {
        sys.macos.darwin_mmap(
            @default_init[*mut opaque](),
            len_bytes,
            sys.macos.PROT_READ,
            sys.macos.MAP_PRIVATE,
            raw_fd,
            0_i64,
        )
    };
    if (mapped as isize) == -1_isize or mapped.is_null() {
        return .Err(darwin_last_fs_error(.Mmap, EMPTY_BYTES));
    }
    if require_nul_sentinel {
        let tail_nul: u8 = unsafe {
            (mapped as *u8).add(len_bytes).read()
        };
        if tail_nul != 0_u8 {
            unsafe {
                _ = sys.macos.darwin_munmap(mapped, len_bytes);
            }
            return .Err(FsError.from_kind(.Unsupported, op: .Mmap));
        }
    }
    .Ok(
        Mmap {
            ptr: mapped as *u8,
            len_bytes,
            map_cap: len_bytes,
        },
    )
}

/| Unmaps a macOS `Mmap` region via `munmap`.
@cfg(target.os == "macos") @std_cap_boundary(clears: [ffi, unsafe_op])
fn os_mmap_close(ptr: *u8, map_cap: usize, /) {
    if map_cap > 0_usize and not ptr.is_null() {
        unsafe {
            _ = sys.macos.darwin_munmap(ptr as *mut opaque, map_cap);
        }
    }
}

/| Resolves canonical physical path on macOS via `open` + `fcntl(F_GETPATH)` with `realpath` fallback (`STD-02` §1.2).
@cfg(target.os == "macos") @std_cap_boundary(clears: [ffi, unsafe_op])
fn os_resolve_path(path_bytes: &[u8], /) -> PathBuf!FsError {
    var cpath: PosixCStrBuf = PosixCStrBuf.encode(path_bytes, .Resolve)?;
    var out_buf: [u8; 1_024] = [0_u8; 1_024];
    var fd: i32 = unsafe {
        sys.macos.darwin_openat_mode(
            sys.macos.AT_FDCWD,
            cpath.as_ptr(),
            sys.macos.O_RDONLY | sys.macos.O_CLOEXEC,
            0_u32,
        )
    };
    if fd < 0 {
        fd = unsafe {
            sys.macos.darwin_openat_mode(
                sys.macos.AT_FDCWD,
                cpath.as_ptr(),
                sys.macos.O_EVTONLY | sys.macos.O_CLOEXEC,
                0_u32,
            )
        };
    }
    var got_path = false;
    if fd >= 0 {
        let gp_rc: i32 = unsafe {
            sys.macos.darwin_fcntl_ptr(fd, sys.macos.F_GETPATH, &raw mut out_buf[0])
        };
        unsafe {
            _ = sys.macos.darwin_close(fd);
        }
        got_path = gp_rc == 0;
    }
    if not got_path {
        let rp_ptr: *mut u8 = unsafe {
            sys.macos.darwin_realpath(cpath.as_ptr(), &raw mut out_buf[0])
        };
        if rp_ptr.is_null() {
            let err: FsError = darwin_last_fs_error(.Resolve, path_bytes);
            cpath.deinit();
            return .Err(err);
        }
    }
    cpath.deinit();
    let out_len: usize = cstr_len_bounded(&raw out_buf[0], 1_024_usize);
    let out_slice: &[u8] = unsafe {
        @slice_from_raw_parts(&raw out_buf[0], out_len)
    };
    .Ok(PathBuf.from(out_slice))
}

/| Queries path `Metadata` on macOS (`stat` vs. `lstat`).
@cfg(target.os == "macos") @std_cap_boundary(clears: [ffi, unsafe_op])
fn os_path_metadata(path_bytes: &[u8], follow_symlinks: bool, /) -> Metadata!FsError {
    var cpath: PosixCStrBuf = PosixCStrBuf.encode(path_bytes, .Stat)?;
    var st = @default_init[sys.macos.DarwinStat64]();
    let rc: i32 = unsafe {
        if follow_symlinks => sys.macos.darwin_stat(cpath.as_ptr(), &raw mut st)
            else sys.macos.darwin_lstat(cpath.as_ptr(), &raw mut st)
    };
    cpath.deinit();
    if rc < 0 {
        return .Err(darwin_last_fs_error(.Stat, path_bytes));
    }
    .Ok(metadata_from_darwin_stat(&st))
}

/| Creates a single directory on macOS via `mkdirat`.
@cfg(target.os == "macos") @std_cap_boundary(clears: [ffi, unsafe_op])
fn os_mkdir_single(path_bytes: &[u8], perms: FilePermissions, /) -> unit!FsError {
    var cpath: PosixCStrBuf = PosixCStrBuf.encode(path_bytes, .Mkdir)?;
    let rc: i32 = unsafe {
        sys.macos.darwin_mkdirat(sys.macos.AT_FDCWD, cpath.as_ptr(), perms.posix_mode)
    };
    cpath.deinit();
    if rc < 0 {
        return .Err(darwin_last_fs_error(.Mkdir, path_bytes));
    }
    .Ok(())
}

/| Unlinks a file or symlink on macOS via `unlinkat(…, 0)`.
@cfg(target.os == "macos") @std_cap_boundary(clears: [ffi, unsafe_op])
fn os_remove_file(path_bytes: &[u8], /) -> unit!FsError {
    var cpath: PosixCStrBuf = PosixCStrBuf.encode(path_bytes, .Unlink)?;
    let rc: i32 = unsafe {
        sys.macos.darwin_unlinkat(sys.macos.AT_FDCWD, cpath.as_ptr(), 0)
    };
    cpath.deinit();
    if rc < 0 {
        return .Err(darwin_last_fs_error(.Unlink, path_bytes));
    }
    .Ok(())
}

/| Removes an empty directory on macOS via `unlinkat(…, AT_REMOVEDIR)`.
@cfg(target.os == "macos") @std_cap_boundary(clears: [ffi, unsafe_op])
fn os_remove_empty_dir(path_bytes: &[u8], /) -> unit!FsError {
    var cpath: PosixCStrBuf = PosixCStrBuf.encode(path_bytes, .Unlink)?;
    let rc: i32 = unsafe {
        sys.macos.darwin_unlinkat(sys.macos.AT_FDCWD, cpath.as_ptr(), sys.macos.AT_REMOVEDIR)
    };
    cpath.deinit();
    if rc < 0 {
        return .Err(darwin_last_fs_error(.Unlink, path_bytes));
    }
    .Ok(())
}

/| Creates a fresh-inode `0o600` `StagedAtomicFile` inside `dst`'s parent `dir_fd` on macOS (`STD-02` §3.3).
@cfg(target.os == "macos") @std_cap_boundary(clears: [ffi, unsafe_op])
fn os_staged_atomic_create(
    dst_bytes: &[u8],
    perms: FilePermissions,
    /,
) -> StagedAtomicFile!FsError {
    let dst_view = Path.from_bytes(dst_bytes);
    let (parent_dir, leaf_bytes) = split_parent_and_leaf(dst_view, .Open)?;
    let parent_fd = os_dir_open(parent_dir.as_bytes())? as i32;
    var attempt = 0_u32;
    while attempt < 64_u32 {
        let tmp_leaf_pb: PathBuf = build_staged_tmp_path(Path.from_bytes(b"."), leaf_bytes, attempt);
        var ctmp: PosixCStrBuf = PosixCStrBuf.encode(tmp_leaf_pb.as_bytes(), .Open) catch |ce| {
            unsafe {
                _ = sys.macos.darwin_close(parent_fd);
            }
            return .Err(ce);
        };
        let fd: i32 = unsafe {
            sys.macos.darwin_openat_mode(
                parent_fd,
                ctmp.as_ptr(),
                sys.macos.O_WRONLY
                    | sys.macos.O_CREAT
                    | sys.macos.O_EXCL
                    | sys.macos.O_CLOEXEC
                    | sys.macos.O_NOFOLLOW,
                0o600_u32,
            )
        };
        ctmp.deinit();
        if fd >= 0 {
            return .Ok(
                StagedAtomicFile {
                    file: File { raw_fd: bits_to_raw_fd(fd as isize) },
                    parent_dir_fd: parent_fd as isize,
                    tmp_path: tmp_leaf_pb,
                    dst_path: PathBuf.from(leaf_bytes),
                    perms,
                },
            );
        }
        let err_no: i32 = darwin_errno();
        if err_no != sys.macos.EEXIST {
            unsafe {
                _ = sys.macos.darwin_close(parent_fd);
            }
            return .Err(
                attach_failed_path(
                    FsError.from_raw_os(err_no, domain: .PosixErrno, op: .Open),
                    dst_bytes,
                ),
            );
        }
        attempt = attempt +% 1_u32;
    }
    unsafe {
        _ = sys.macos.darwin_close(parent_fd);
    }
    .Err(attach_failed_path(FsError.from_kind(.AlreadyExists, op: .Open), dst_bytes))
}

/| Unlinks a parent-relative temporary file inside `parent_dir_fd` on macOS (`[u8; 1024]` zero-alloc fast path).
@cfg(target.os == "macos") @std_cap_boundary(clears: [ffi, unsafe_op])
fn darwin_unlink_staged_at(parent_dir_fd: i32, tmp_bytes: &[u8], /) {
    if parent_dir_fd < 0 or tmp_bytes.is_empty() or has_interior_nul(tmp_bytes) {
        return;
    }
    if tmp_bytes.len() < 1_024_usize {
        var stack_cstr: [u8; 1_024] = [0_u8; 1_024];
        unsafe {
            @memcpy(
                (&raw mut stack_cstr[0]) as *mut opaque,
                tmp_bytes.as_ptr() as *opaque,
                tmp_bytes.len(),
            );
            _ = sys.macos.darwin_unlinkat(parent_dir_fd, &raw stack_cstr[0], 0);
        }
        return;
    }
    if PosixCStrBuf.encode(tmp_bytes, .Unlink) is .Ok(var ctmp) {
        unsafe {
            _ = sys.macos.darwin_unlinkat(parent_dir_fd, ctmp.as_ptr(), 0);
        }
        ctmp.deinit();
    }
}

/| Publishes `StagedAtomicFile` on macOS (`fchmod` -> `F_BARRIERFSYNC`/`F_FULLFSYNC` -> `renameat` -> optional dir sync).
@cfg(target.os == "macos") @std_cap_boundary(clears: [ffi, unsafe_op])
fn os_staged_atomic_publish(
    staged: own StagedAtomicFile,
    durability: DurabilityMode,
    /,
) -> unit!FsError {
    let StagedAtomicFile { file, parent_dir_fd: parent_bits, tmp_path, dst_path, perms } = staged;
    let parent_dir_fd = parent_bits as i32;
    let File { raw_fd: file_raw } = file;
    let raw_fd = raw_fd_to_bits(file_raw) as i32;
    let chmod_rc: i32 = unsafe {
        sys.macos.darwin_fchmod(raw_fd, perms.posix_mode)
    };
    if chmod_rc < 0 {
        let chmod_err: FsError = darwin_last_fs_error(.Stat, dst_path.as_bytes());
        unsafe {
            _ = sys.macos.darwin_close(raw_fd);
        }
        darwin_unlink_staged_at(parent_dir_fd, tmp_path.as_bytes());
        unsafe {
            _ = sys.macos.darwin_close(parent_dir_fd);
        }
        return .Err(chmod_err);
    }
    if os_file_sync(raw_fd as isize, durability) is .Err(sync_err) {
        unsafe {
            _ = sys.macos.darwin_close(raw_fd);
        }
        darwin_unlink_staged_at(parent_dir_fd, tmp_path.as_bytes());
        unsafe {
            _ = sys.macos.darwin_close(parent_dir_fd);
        }
        return .Err(sync_err);
    }
    unsafe {
        _ = sys.macos.darwin_close(raw_fd);
    }
    var ctmp: PosixCStrBuf = PosixCStrBuf.encode(tmp_path.as_bytes(), .Rename) catch |tmp_err| {
        darwin_unlink_staged_at(parent_dir_fd, tmp_path.as_bytes());
        unsafe {
            _ = sys.macos.darwin_close(parent_dir_fd);
        }
        return .Err(tmp_err);
    };
    var cdst: PosixCStrBuf = PosixCStrBuf.encode(dst_path.as_bytes(), .Rename) catch |dst_err| {
        unsafe {
            _ = sys.macos.darwin_unlinkat(parent_dir_fd, ctmp.as_ptr(), 0);
            _ = sys.macos.darwin_close(parent_dir_fd);
        }
        ctmp.deinit();
        return .Err(dst_err);
    };
    let ren_rc: i32 = unsafe {
        sys.macos.darwin_renameat(parent_dir_fd, ctmp.as_ptr(), parent_dir_fd, cdst.as_ptr())
    };
    if ren_rc < 0 {
        let ren_err: FsError = darwin_last_fs_error(.Rename, dst_path.as_bytes());
        unsafe {
            _ = sys.macos.darwin_unlinkat(parent_dir_fd, ctmp.as_ptr(), 0);
            _ = sys.macos.darwin_close(parent_dir_fd);
        }
        ctmp.deinit();
        cdst.deinit();
        return .Err(ren_err);
    }
    ctmp.deinit();
    cdst.deinit();
    if durability == .PowerSafe {
        os_file_sync(parent_dir_fd as isize, .PowerSafe) catch {};
    }
    unsafe {
        _ = sys.macos.darwin_close(parent_dir_fd);
    }
    .Ok(())
}

/| Aborts and unlinks `StagedAtomicFile` on macOS.
@cfg(target.os == "macos") @std_cap_boundary(clears: [ffi, unsafe_op])
fn os_staged_atomic_abort(staged: own StagedAtomicFile, /) {
    let StagedAtomicFile { file, parent_dir_fd: parent_bits, tmp_path, dst_path, perms } = staged;
    _ = dst_path;
    _ = perms;
    let parent_dir_fd = parent_bits as i32;
    let File { raw_fd: file_raw } = file;
    let raw_fd = raw_fd_to_bits(file_raw) as i32;
    if raw_fd >= 0 {
        unsafe {
            _ = sys.macos.darwin_close(raw_fd);
        }
    }
    if parent_dir_fd >= 0 {
        darwin_unlink_staged_at(parent_dir_fd, tmp_path.as_bytes());
        unsafe {
            _ = sys.macos.darwin_close(parent_dir_fd);
        }
    }
}

/| Publishes an existing staged file onto `dst_bytes` on macOS.
@cfg(target.os == "macos") @std_cap_boundary(clears: [ffi, unsafe_op])
fn os_publish_staged_path(
    staged_bytes: &[u8],
    dst_bytes: &[u8],
    durability: DurabilityMode,
    /,
) -> unit!FsError {
    if durability != .FastLocal {
        var f_staged: File = File.open_with(
            Path.from_bytes(staged_bytes),
            OpenOptions {
                flags: OpenFlags {
                    read: true,
                    write: false,
                    append: false,
                    create: false,
                    create_new: false,
                    truncate: false,
                    no_follow: true,
                    sync_data: false,
                    lock_shared: false,
                    lock_exclusive: false,
                    nonblocking_lock: false,
                    reserved: 0_u8,
                },
                permissions: FilePermissions.DEFAULT_FILE,
            },
        )?;
        let sync_res: unit!FsError = f_staged.sync(durability);
        f_staged.close();
        sync_res?;
    }
    var csrc: PosixCStrBuf = PosixCStrBuf.encode(staged_bytes, .Rename)?;
    var cdst: PosixCStrBuf = PosixCStrBuf.encode(dst_bytes, .Rename) catch |de| {
        csrc.deinit();
        return .Err(de);
    };
    let rc: i32 = unsafe {
        sys.macos.darwin_renameat(
            sys.macos.AT_FDCWD,
            csrc.as_ptr(),
            sys.macos.AT_FDCWD,
            cdst.as_ptr(),
        )
    };
    csrc.deinit();
    cdst.deinit();
    if rc < 0 {
        return .Err(darwin_last_fs_error(.Rename, dst_bytes));
    }
    if durability == .PowerSafe {
        let (parent_dir, _) = split_parent_and_leaf(Path.from_bytes(dst_bytes), .Flush)?;
        if os_dir_open(parent_dir.as_bytes()) is .Ok(dir_bits) {
            os_file_sync(dir_bits, .PowerSafe) catch {};
            unsafe {
                _ = sys.macos.darwin_close(dir_bits as i32);
            }
        }
    }
    .Ok(())
}

/| Executes 3-tier `clonefileat -> linkat -> fcopyfile / 64 KiB` materialization on macOS (`STD-02` §3.4A).
@cfg(target.os == "macos") @std_cap_boundary(clears: [ffi, unsafe_op])
fn os_materialize_file(
    src_bytes: &[u8],
    dst_bytes: &[u8],
    src_meta: Metadata,
    policy: MaterializePolicy,
    /,
) -> MaterializeMethod!FsError {
    let dst_view = Path.from_bytes(dst_bytes);
    let (parent_dir, leaf_bytes) = split_parent_and_leaf(dst_view, .Clone)?;
    let par_fd = os_dir_open(parent_dir.as_bytes())? as i32;
    var csrc: PosixCStrBuf = PosixCStrBuf.encode(src_bytes, .Clone) catch |se| {
        unsafe {
            _ = sys.macos.darwin_close(par_fd);
        }
        return .Err(se);
    };
    var cdst_leaf: PosixCStrBuf = PosixCStrBuf.encode(leaf_bytes, .Rename) catch |de| {
        csrc.deinit();
        unsafe {
            _ = sys.macos.darwin_close(par_fd);
        }
        return .Err(de);
    };

    // [1] Tier 1: APFS `clonefileat` into fresh sibling + `renameat` (`0` overwrite races):
    let clone_leaf: PathBuf = build_staged_tmp_path(Path.from_bytes(b"."), leaf_bytes, 91_u32);
    if PosixCStrBuf.encode(clone_leaf.as_bytes(), .Clone) is .Ok(var ctmp_clone) {
        let cf_rc: i32 = unsafe {
            sys.macos.darwin_clonefileat(
                sys.macos.AT_FDCWD,
                csrc.as_ptr(),
                par_fd,
                ctmp_clone.as_ptr(),
                0_u32,
            )
        };
        if cf_rc == 0 {
            let ren_rc: i32 = unsafe {
                sys.macos.darwin_renameat(par_fd, ctmp_clone.as_ptr(), par_fd, cdst_leaf.as_ptr())
            };
            if ren_rc == 0 {
                ctmp_clone.deinit();
                csrc.deinit();
                cdst_leaf.deinit();
                unsafe {
                    _ = sys.macos.darwin_close(par_fd);
                }
                return .Ok(.Reflinked);
            }
            unsafe {
                _ = sys.macos.darwin_unlinkat(par_fd, ctmp_clone.as_ptr(), 0);
            }
        }
        ctmp_clone.deinit();
    }

    // [2] Tier 2: `linkat` into staged sibling + `renameat` (`ImmutableCas`, `< 1023` links):
    if policy == .ImmutableCas and src_meta.hardlink_count < MAX_SAFE_HARDLINKS {
        let link_leaf: PathBuf = build_staged_tmp_path(Path.from_bytes(b"."), leaf_bytes, 93_u32);
        if PosixCStrBuf.encode(link_leaf.as_bytes(), .Clone) is .Ok(var ctmp_link) {
            let hl_rc: i32 = unsafe {
                sys.macos.darwin_linkat(
                    sys.macos.AT_FDCWD,
                    csrc.as_ptr(),
                    par_fd,
                    ctmp_link.as_ptr(),
                    sys.macos.AT_SYMLINK_FOLLOW,
                )
            };
            if hl_rc == 0 {
                let ren_rc: i32 = unsafe {
                    sys.macos.darwin_renameat(par_fd, ctmp_link.as_ptr(), par_fd, cdst_leaf.as_ptr())
                };
                if ren_rc == 0 {
                    ctmp_link.deinit();
                    csrc.deinit();
                    cdst_leaf.deinit();
                    unsafe {
                        _ = sys.macos.darwin_close(par_fd);
                    }
                    return .Ok(.Hardlinked);
                }
                unsafe {
                    _ = sys.macos.darwin_unlinkat(par_fd, ctmp_link.as_ptr(), 0);
                }
            }
            ctmp_link.deinit();
        }
    }
    csrc.deinit();
    cdst_leaf.deinit();
    unsafe {
        _ = sys.macos.darwin_close(par_fd);
    }

    // [3] Tier 3: `fcopyfile(COPYFILE_DATA)` into `StagedAtomicFile`, falling back to `64 KiB` loop:
    var src_file: File = File.open(Path.from_bytes(src_bytes))?;
    var staged: StagedAtomicFile = os_staged_atomic_create(dst_bytes, src_meta.permissions) catch |se2| {
        src_file.close();
        return .Err(se2);
    };
    let fc_rc: i32 = unsafe {
        sys.macos.darwin_fcopyfile(
            raw_fd_to_bits(src_file.raw_fd) as i32,
            raw_fd_to_bits(staged.file.raw_fd) as i32,
            @default_init[*mut opaque](),
            sys.macos.COPYFILE_DATA,
        )
    };
    if fc_rc < 0 {
        _ = src_file.seek(.Start(0_u64)) catch 0_u64;
        _ = staged.file.seek(.Start(0_u64)) catch 0_u64;
        staged.file.set_len(0_u64) catch {};
        if copy_file_loop_64k(&mut src_file, &mut staged.file) is .Err(cp_err) {
            src_file.close();
            os_staged_atomic_abort(own staged);
            return .Err(cp_err);
        }
    }
    src_file.close();
    os_staged_atomic_publish(own staged, .FastLocal)?;
    .Ok(.Copied)
}

/| Acquires an advisory `flock` lock on macOS (`EAGAIN = 35` -> `.FileLockConflict`).
@cfg(target.os == "macos") @std_cap_boundary(clears: [ffi, unsafe_op])
fn os_file_lock_acquire(
    path_bytes: &[u8],
    mode: LockMode,
    nonblocking: bool,
    /,
) -> FileLock!FsError {
    var cpath: PosixCStrBuf = PosixCStrBuf.encode(path_bytes, .Lock)?;
    let fd: i32 = unsafe {
        sys.macos.darwin_openat_mode(
            sys.macos.AT_FDCWD,
            cpath.as_ptr(),
            sys.macos.O_RDWR | sys.macos.O_CREAT | sys.macos.O_CLOEXEC,
            0o644_u32,
        )
    };
    cpath.deinit();
    if fd < 0 {
        return .Err(darwin_last_fs_error(.Lock, path_bytes));
    }
    var lock_op: i32 = if mode == .Exclusive => sys.macos.LOCK_EX else sys.macos.LOCK_SH;
    if nonblocking {
        lock_op |= sys.macos.LOCK_NB;
    }
    while true {
        let rc: i32 = unsafe {
            sys.macos.darwin_flock(fd, lock_op)
        };
        if rc == 0 {
            return .Ok(FileLock { file: File { raw_fd: bits_to_raw_fd(fd as isize) } });
        }
        let err_no: i32 = darwin_errno();
        if err_no == sys.macos.EINTR {
            continue;
        }
        unsafe {
            _ = sys.macos.darwin_close(fd);
        }
        if err_no == sys.macos.EAGAIN {
            return .Err(
                attach_failed_path(FsError.from_kind(.FileLockConflict, op: .Lock), path_bytes),
            );
        }
        return .Err(
            attach_failed_path(
                FsError.from_raw_os(err_no, domain: .PosixErrno, op: .Lock),
                path_bytes,
            ),
        );
    }
    .Err(FsError.from_kind(.Other, op: .Lock))
}

/| Unlocks and closes a macOS `FileLock` without unlinking the lockfile.
@cfg(target.os == "macos") @std_cap_boundary(clears: [ffi, unsafe_op])
fn os_file_lock_release(lock: own FileLock, /) {
    let FileLock { file } = lock;
    let File { raw_fd: file_raw } = file;
    let raw_fd = raw_fd_to_bits(file_raw) as i32;
    if raw_fd >= 0 {
        unsafe {
            _ = sys.macos.darwin_flock(raw_fd, sys.macos.LOCK_UN);
            _ = sys.macos.darwin_close(raw_fd);
        }
    }
}

/| Registers an `EVFILT_VNODE` descriptor (and recursive children when `mask.recursive`) on `DarwinWatcherState`.
@std_cap_boundary(clears: [ffi, unsafe_op, may_panic])
fn darwin_add_watch_tree(
    state: &mut DarwinWatcherState,
    watch_id: u32,
    node_path: Path,
    mask: WatchMask,
    depth: usize,
    /,
) -> unit!FsError {
    if state.nodes.len() >= MAX_WATCH_ENTRIES {
        return .Err(FsError.from_kind(.OutOfMemory, op: .Watch));
    }
    var cpath: PosixCStrBuf = PosixCStrBuf.encode(node_path.as_bytes(), .Watch)?;
    let evt_fd: i32 = unsafe {
        sys.macos.darwin_openat_mode(
            sys.macos.AT_FDCWD,
            cpath.as_ptr(),
            sys.macos.O_EVTONLY | sys.macos.O_CLOEXEC,
            0_u32,
        )
    };
    cpath.deinit();
    if evt_fd < 0 {
        return .Err(darwin_last_fs_error(.Watch, node_path.as_bytes()));
    }
    var st = @default_init[sys.macos.DarwinStat64]();
    let is_dir: bool = unsafe {
        sys.macos.darwin_fstat(evt_fd, &raw mut st) == 0
    }
        and classify_posix_mode(st.st_mode as u32) == .Directory;

    let vnode_fflags: u32 = sys.macos.NOTE_WRITE
        | sys.macos.NOTE_EXTEND
        | sys.macos.NOTE_ATTRIB
        | sys.macos.NOTE_DELETE
        | sys.macos.NOTE_RENAME
        | sys.macos.NOTE_REVOKE
        | sys.macos.NOTE_LINK;
    let kev = sys.macos.DarwinKevent64 {
        ident: evt_fd as u64,
        filter: sys.macos.EVFILT_VNODE,
        flags: sys.macos.EV_ADD | sys.macos.EV_ENABLE | sys.macos.EV_CLEAR,
        fflags: vnode_fflags,
        data: 0_i64,
        udata: watch_id as u64,
        ext: [0_u64; 2],
    };
    let krc: i32 = unsafe {
        sys.macos.darwin_kevent64(
            state.kq_fd,
            &raw kev,
            1,
            @default_init[*mut sys.macos.DarwinKevent64](),
            0,
            0_u32,
            @default_init[*sys.macos.PosixTimespec](),
        )
    };
    if krc < 0 {
        let kerr: FsError = darwin_last_fs_error(.Watch, node_path.as_bytes());
        unsafe {
            _ = sys.macos.darwin_close(evt_fd);
        }
        return .Err(kerr);
    }
    state.nodes.push(
        DarwinWatchNode {
            evt_fd,
            watch_id,
            mask,
            node_path: node_path.to_path_buf(),
            is_dir,
        },
    );
    if is_dir
        and mask.recursive
        and depth < MAX_DIR_WALK_DEPTH
        and os_dir_open(
            node_path.as_bytes(),
        ) is .Ok(dir_bits) {
        let dir_fd = dir_bits as i32;
        if os_dir_entries(dir_bits) is .Ok(iter_raw) {
            while (os_dir_iter_next(iter_raw) catch .None) is .Some(entry) {
                let child_pb: PathBuf = node_path.join(entry.name.as_path());
                darwin_add_watch_tree(
                    state,
                    watch_id,
                    child_pb.as_path(),
                    mask,
                    depth +% 1_usize,
                ) catch {};
            }
            os_dir_iter_close(iter_raw);
        }
        unsafe {
            _ = sys.macos.darwin_close(dir_fd);
        }
    }
    .Ok(())
}

/| Allocates a `DarwinWatcherState` backed by `kqueue()`.
@cfg(target.os == "macos") @std_cap_boundary(clears: [ffi, unsafe_op])
fn os_watcher_new() -> (*mut opaque)!FsError {
    let kq_fd: i32 = unsafe {
        sys.macos.darwin_kqueue()
    };
    if kq_fd < 0 {
        return .Err(darwin_last_fs_error(.Watch, EMPTY_BYTES));
    }
    let mem: *mut u8 = System
        .handle()
        .alloc(
            Layout {
                size: @size_of[DarwinWatcherState](),
                alignment: @align_of[DarwinWatcherState](),
            },
        ) catch {
        unsafe {
            _ = sys.macos.darwin_close(kq_fd);
        }
        return .Err(FsError.from_kind(.OutOfMemory, op: .Watch));
    };
    let ptr = mem as *mut DarwinWatcherState;
    unsafe {
        @ptr_write(
            ptr,
            DarwinWatcherState {
                kq_fd,
                next_watch_id: 1_u32,
                nodes: Vec[DarwinWatchNode].new(),
            },
        );
    }
    .Ok(ptr as *mut opaque)
}

/| Registers `path_bytes` on a macOS `FsWatcher`.
@cfg(target.os == "macos") @std_cap_boundary(clears: [unsafe_op])
fn os_watcher_watch(
    backend_state: *mut opaque,
    path_bytes: &[u8],
    mask: WatchMask,
    /,
) -> WatchId!FsError {
    let state_ptr = backend_state as *mut DarwinWatcherState;
    if state_ptr.is_null() {
        return .Err(FsError.from_kind(.InvalidInput, op: .Watch));
    }
    let state: &mut DarwinWatcherState = unsafe {
        &mut state_ptr.*
    };
    let wid: u32 = state.next_watch_id;
    state.next_watch_id = state.next_watch_id +% 1_u32;
    darwin_add_watch_tree(state, wid, Path.from_bytes(path_bytes), mask, 0_usize)?;
    .Ok(wid as WatchId)
}

/| Unwatches all `O_EVTONLY` descriptors associated with `id` on macOS.
@cfg(target.os == "macos") @std_cap_boundary(clears: [ffi, unsafe_op, may_panic])
fn os_watcher_unwatch(backend_state: *mut opaque, id: WatchId, /) -> unit!FsError {
    let state_ptr = backend_state as *mut DarwinWatcherState;
    if state_ptr.is_null() {
        return .Err(FsError.from_kind(.InvalidInput, op: .Watch));
    }
    let state: &mut DarwinWatcherState = unsafe {
        &mut state_ptr.*
    };
    let target_u32 = id as u32;
    var removed_any = false;
    var idx = 0_usize;
    while idx < state.nodes.len() {
        if state.nodes[idx].watch_id == target_u32 {
            let efd: i32 = state.nodes[idx].evt_fd;
            unsafe {
                _ = sys.macos.darwin_close(efd);
            }
            _ = state.nodes.swap_remove(idx);
            removed_any = true;
        } else {
            idx = idx +% 1_usize;
        }
    }
    if not removed_any {
        return .Err(FsError.from_kind(.NotFound, op: .Watch));
    }
    .Ok(())
}

/| Polls `kevent64` on macOS, classifying `NOTE_RENAME` prior to `NOTE_WRITE` (`STD-02` §1.2).
@cfg(target.os == "macos") @std_cap_boundary(clears: [ffi, unsafe_op, may_panic])
fn os_watcher_poll(
    backend_state: *mut opaque,
    out_events: &mut Vec[WatchEvent],
    timeout: Duration?,
    /,
) -> usize!FsError {
    let state_ptr = backend_state as *mut DarwinWatcherState;
    if state_ptr.is_null() {
        return .Ok(0_usize);
    }
    let state: &mut DarwinWatcherState = unsafe {
        &mut state_ptr.*
    };
    var ts_val = sys.macos.PosixTimespec { tv_sec: 0_i64, tv_nsec: 0_i64 };
    var has_ts = false;
    if timeout is .Some(dur) {
        let secs_u64: u64 = dur.as_secs();
        ts_val.tv_sec = if secs_u64 > (i64.MAX as u64) => i64.MAX else secs_u64 as i64;
        ts_val.tv_nsec = dur.subsec_nanos() as i64;
        has_ts = true;
    }
    let ts_ptr: *sys.macos.PosixTimespec = if has_ts => &raw ts_val
        else @default_init[*sys.macos.PosixTimespec]();
    var ev_batch: [sys.macos.DarwinKevent64; 32] = [@default_init[sys.macos.DarwinKevent64](); 32];
    let nready: i32 = unsafe {
        sys.macos.darwin_kevent64(
            state.kq_fd,
            @default_init[*sys.macos.DarwinKevent64](),
            0,
            &raw mut ev_batch[0],
            32,
            0_u32,
            ts_ptr,
        )
    };
    if nready < 0 {
        let err_no: i32 = darwin_errno();
        if err_no == sys.macos.EINTR {
            return .Ok(0_usize);
        }
        return .Err(FsError.from_raw_os(err_no, domain: .PosixErrno, op: .Watch));
    }
    var emitted = 0_usize;
    var idx = 0_usize;
    let ready_count = nready as usize;
    while idx < ready_count {
        let kev: sys.macos.DarwinKevent64 = unsafe {
            (&raw ev_batch[0]).add(idx).read()
        };
        let ident_fd = kev.ident as i32;
        let fflags: u32 = kev.fflags;
        var matched_idx: usize? = .None;
        var scan_idx = 0_usize;
        while scan_idx < state.nodes.len() {
            if state.nodes[scan_idx].evt_fd == ident_fd {
                matched_idx = .Some(scan_idx);
                break;
            }
            scan_idx = scan_idx +% 1_usize;
        }
        if matched_idx is .Some(nidx) {
            let is_ren: bool = (fflags & sys.macos.NOTE_RENAME) != 0_u32;
            let is_del: bool = (fflags & (sys.macos.NOTE_DELETE | sys.macos.NOTE_REVOKE)) != 0_u32;
            let is_dir_node: bool = state.nodes[nidx].is_dir;
            let is_mod: bool = not is_ren
                and (fflags & (sys.macos.NOTE_WRITE | sys.macos.NOTE_EXTEND)) != 0_u32;
            out_events.push(
                WatchEvent {
                    watch_id: state.nodes[nidx].watch_id as WatchId,
                    path: state.nodes[nidx].node_path.clone(),
                    flags: WatchEventFlags {
                        created: is_dir_node and is_mod,
                        modified: is_mod,
                        removed: is_del,
                        renamed_from: is_ren,
                        renamed_to: false,
                        attrib: (fflags & sys.macos.NOTE_ATTRIB) != 0_u32,
                        is_dir: is_dir_node,
                        rescan_required: is_dir_node and is_mod,
                        reserved: 0_u8,
                    },
                    rename_cookie: 0_u32,
                },
            );
            emitted = emitted +% 1_usize;
        }
        idx = idx +% 1_usize;
    }
    .Ok(emitted)
}

/| Closes all `O_EVTONLY` descriptors, `kq_fd`, and `DarwinWatcherState`.
@cfg(target.os == "macos") @std_cap_boundary(clears: [ffi, unsafe_op, may_panic])
fn os_watcher_close(backend_state: *mut opaque, /) {
    let state_ptr = backend_state as *mut DarwinWatcherState;
    if state_ptr.is_null() {
        return;
    }
    let state: &mut DarwinWatcherState = unsafe {
        &mut state_ptr.*
    };
    var idx = 0_usize;
    while idx < state.nodes.len() {
        let efd: i32 = state.nodes[idx].evt_fd;
        if efd >= 0 {
            unsafe {
                _ = sys.macos.darwin_close(efd);
            }
        }
        idx = idx +% 1_usize;
    }
    if state.kq_fd >= 0 {
        unsafe {
            _ = sys.macos.darwin_close(state.kq_fd);
        }
    }
    unsafe {
        @drop_in_place(state_ptr);
    }
    System
        .handle()
        .dealloc(
            backend_state as *mut u8,
            Layout {
                size: @size_of[DarwinWatcherState](),
                alignment: @align_of[DarwinWatcherState](),
            },
        );
}

// ------------------ WASI Host Implementation ------------------
/| Maps a WASI `u16` errno to `FsError` (`NOTCAPABLE = 76` and `LOOP = 32` -> `.FilesystemLoop`, `STD-02` §3.4B).
fn wasi_err_to_fs(errno_u16: u16, op: IoOp, failed_bytes: &[u8], /) -> FsError {
    if errno_u16 == sys.wasi.WASI_ERRNO_NOTCAPABLE or errno_u16 == sys.wasi.WASI_ERRNO_LOOP {
        return attach_failed_path(FsError.from_kind(.FilesystemLoop, op: op), failed_bytes);
    }
    attach_failed_path(
        FsError.from_raw_os(errno_u16 as i32, domain: .WasiErrno, op: op),
        failed_bytes,
    )
}

/| Maps a WASI `u16` errno to `IoError`.
fn wasi_err_to_io(errno_u16: u16, op: IoOp, /) -> IoError {
    IoError.from_raw_os(errno_u16 as i32, domain: .WasiErrno, op: op)
}

/| Classifies WASI `WASI_FILETYPE_*` into `FileType`.
fn classify_wasi_filetype(ft: u8, /) -> FileType {
    if ft == sys.wasi.WASI_FILETYPE_REGULAR_FILE {
        return .RegularFile;
    }
    if ft == sys.wasi.WASI_FILETYPE_DIRECTORY {
        return .Directory;
    }
    if ft == sys.wasi.WASI_FILETYPE_SYMBOLIC_LINK {
        return .Symlink;
    }
    if ft == sys.wasi.WASI_FILETYPE_CHARACTER_DEVICE {
        return .CharDevice;
    }
    if ft == sys.wasi.WASI_FILETYPE_BLOCK_DEVICE {
        return .BlockDevice;
    }
    if ft == sys.wasi.WASI_FILETYPE_SOCKET_DGRAM or ft == sys.wasi.WASI_FILETYPE_SOCKET_STREAM {
        return .Socket;
    }
    .Unknown
}

/| Converts WASI `u64` nanoseconds since the Unix epoch into `SystemTime?`.
fn wasi_ns_to_systime(ns: u64, /) -> SystemTime? {
    if ns == 0_u64 {
        return .None;
    }
    let secs = (ns / 1_000_000_000_u64) as i64;
    let sub_ns = (ns % 1_000_000_000_u64) as u32;
    SystemTime.from_unix_timestamp(secs, sub_ns)
}

/| Converts `WasiFilestat` (`64 B`) into `Metadata`.
fn metadata_from_wasi_stat(fst: &sys.wasi.WasiFilestat, /) -> Metadata {
    let ftype: FileType = classify_wasi_filetype(fst.filetype);
    let perms: FilePermissions = if ftype == .Directory => FilePermissions.DEFAULT_DIR
        else FilePermissions.DEFAULT_FILE;
    let links_u32: u32 = if fst.nlink > (u32.MAX as u64) => u32.MAX else fst.nlink as u32;
    Metadata {
        file_type: ftype,
        size: fst.size,
        permissions: perms,
        modified: wasi_ns_to_systime(fst.mtim),
        accessed: wasi_ns_to_systime(fst.atim),
        created: wasi_ns_to_systime(fst.ctim),
        dev_id: fst.dev,
        inode_or_file_id: fst.ino,
        hardlink_count: links_u32,
    }
}

/| Discovers the matching WASI preopened directory descriptor (`fd >= 3`) and capability-relative slice.
@std_cap_boundary(clears: [ffi, unsafe_op, may_panic])
fn wasi_resolve_preopen(path_bytes: &[u8], op: IoOp, /) -> (i32, &[u8])!FsError {
    if path_bytes.is_empty() {
        return .Err(FsError.from_kind(.NotFound, op: op));
    }
    if has_interior_nul(path_bytes) {
        return .Err(attach_failed_path(FsError.from_kind(.InvalidFilename, op: op), path_bytes));
    }
    let is_abs: bool = byte_at(path_bytes, 0_usize) == b'/';
    var best_fd: i32 = -1;
    var best_prefix_len = 0_usize;
    var fallback_rel_fd: i32 = -1;
    var pr_buf: [u8; 512] = [0_u8; 512];

    var cand_fd: i32 = 3;
    while cand_fd < 32 {
        var prestat = @default_init[sys.wasi.WasiPrestat]();
        let rc: u16 = unsafe {
            sys.wasi.wasi_fd_prestat_get(cand_fd, &raw mut prestat)
        };
        if rc != sys.wasi.WASI_ERRNO_SUCCESS {
            break;
        }
        if prestat.tag == sys.wasi.WASI_PREOPENTYPE_DIR and prestat.pr_name_len < 512_usize {
            let name_rc: u16 = unsafe {
                sys.wasi.wasi_fd_prestat_dir_name(cand_fd, &raw mut pr_buf[0], prestat.pr_name_len)
            };
            if name_rc == sys.wasi.WASI_ERRNO_SUCCESS {
                var name_len: usize = prestat.pr_name_len;
                while name_len > 0_usize
                    and unsafe {
                        (&raw pr_buf[0]).add(name_len -% 1_usize).read() == 0_u8
                    } {
                    name_len = name_len -% 1_usize;
                }
                let pr_slice: &[u8] = unsafe {
                    @slice_from_raw_parts(&raw pr_buf[0], name_len)
                };
                if not is_abs {
                    if is_single_dot(pr_slice)
                        or pr_slice.is_empty()
                        or (
                            pr_slice.len() == 2_usize
                                and byte_at(pr_slice, 0_usize) == b'.'
                                and byte_at(
                                    pr_slice,
                                    1_usize,
                                )
                                    == b'/'
                        ) {
                        best_fd = cand_fd;
                        break;
                    }
                    if fallback_rel_fd < 0 {
                        fallback_rel_fd = cand_fd;
                    }
                } else if pr_slice.len() == 1_usize and byte_at(pr_slice, 0_usize) == b'/' {
                    if best_fd < 0 or best_prefix_len == 0_usize {
                        best_fd = cand_fd;
                        best_prefix_len = 1_usize;
                    }
                } else if pr_slice.len() > 0_usize and byte_at(pr_slice, 0_usize) == b'/' {
                    var trim_pr_len: usize = pr_slice.len();
                    while trim_pr_len > 1_usize
                        and byte_at(pr_slice, trim_pr_len -% 1_usize) == b'/' {
                        trim_pr_len = trim_pr_len -% 1_usize;
                    }
                    let clean_pr: &[u8] = subslice_u8(pr_slice, 0_usize, trim_pr_len);
                    if path_bytes.len() >= clean_pr.len()
                        and subslice_u8(
                            path_bytes,
                            0_usize,
                            clean_pr.len(),
                        )
                            == clean_pr {
                        let boundary_ok: bool = path_bytes.len() == clean_pr.len()
                            or byte_at(
                                path_bytes,
                                clean_pr.len(),
                            )
                                == b'/';
                        if boundary_ok and clean_pr.len() >= best_prefix_len {
                            best_fd = cand_fd;
                            best_prefix_len = clean_pr.len();
                        }
                    }
                }
            }
        }
        cand_fd = cand_fd +% 1;
    }

    if not is_abs {
        let dir_fd: i32 = if best_fd >= 0 => best_fd else fallback_rel_fd;
        if dir_fd < 0 {
            return .Err(attach_failed_path(FsError.from_kind(.NotFound, op: op), path_bytes));
        }
        var rel_off = 0_usize;
        if path_bytes.len() >= 2_usize
            and byte_at(path_bytes, 0_usize) == b'.'
            and byte_at(
                path_bytes,
                1_usize,
            )
                == b'/' {
            rel_off = 2_usize;
            while rel_off < path_bytes.len() and byte_at(path_bytes, rel_off) == b'/' {
                rel_off = rel_off +% 1_usize;
            }
        }
        let rel_slice: &[u8] = subslice_u8(path_bytes, rel_off, path_bytes.len());
        if rel_slice.is_empty() {
            return .Ok((dir_fd, b"."));
        }
        return .Ok((dir_fd, rel_slice));
    }

    if best_fd < 0 {
        return .Err(attach_failed_path(FsError.from_kind(.PermissionDenied, op: op), path_bytes));
    }
    var rem_off: usize = best_prefix_len;
    while rem_off < path_bytes.len() and byte_at(path_bytes, rem_off) == b'/' {
        rem_off = rem_off +% 1_usize;
    }
    let rem_slice: &[u8] = subslice_u8(path_bytes, rem_off, path_bytes.len());
    if rem_slice.is_empty() {
        return .Ok((best_fd, b"."));
    }
    .Ok((best_fd, rem_slice))
}

/| Opens a WASI `File` capability handle via `wasi_path_open`.
@cfg(target.os == "wasi") @std_cap_boundary(clears: [ffi, unsafe_op])
fn os_file_open(path_bytes: &[u8], opts: OpenOptions, /) -> isize!FsError {
    let (pre_fd, rel_slice) = wasi_resolve_preopen(path_bytes, .Open)?;
    let dirflags: u32 = if opts.flags.no_follow => 0_u32
        else sys.wasi.WASI_LOOKUPFLAGS_SYMLINK_FOLLOW;
    var oflags = 0_u16;
    if opts.flags.create_new {
        oflags |= sys.wasi.WASI_OFLAGS_CREAT | sys.wasi.WASI_OFLAGS_EXCL;
    } else if opts.flags.create {
        oflags |= sys.wasi.WASI_OFLAGS_CREAT;
    }
    if opts.flags.truncate {
        oflags |= sys.wasi.WASI_OFLAGS_TRUNC;
    }
    var fdflags = 0_u16;
    if opts.flags.append {
        fdflags |= sys.wasi.WASI_FDFLAGS_APPEND;
    }
    if opts.flags.sync_data {
        fdflags |= sys.wasi.WASI_FDFLAGS_DSYNC;
    }
    var rights: u64 = sys.wasi.WASI_RIGHTS_FD_SEEK
        | sys.wasi.WASI_RIGHTS_FD_TELL
        | sys.wasi.WASI_RIGHTS_FD_FILESTAT_GET
        | sys.wasi.WASI_RIGHTS_FD_SYNC
        | sys.wasi.WASI_RIGHTS_FD_DATASYNC;
    if opts.flags.read {
        rights |= sys.wasi.WASI_RIGHTS_FD_READ;
    }
    if opts.flags.write
        or opts.flags.append
        or opts.flags.truncate
        or opts.flags.create
        or opts.flags.create_new {
        rights |= sys.wasi.WASI_RIGHTS_FD_WRITE | sys.wasi.WASI_RIGHTS_FD_FILESTAT_SET_SIZE;
    }
    var opened_fd: i32 = -1;
    let rc: u16 = unsafe {
        sys.wasi.wasi_path_open(
            pre_fd,
            dirflags,
            rel_slice.as_ptr(),
            rel_slice.len(),
            oflags,
            rights,
            rights,
            fdflags,
            &raw mut opened_fd,
        )
    };
    if rc != sys.wasi.WASI_ERRNO_SUCCESS {
        return .Err(wasi_err_to_fs(rc, .Open, path_bytes));
    }
    if opts.flags.lock_shared or opts.flags.lock_exclusive {
        unsafe {
            _ = sys.wasi.wasi_fd_close(opened_fd);
        }
        return .Err(attach_failed_path(FsError.from_kind(.Unsupported, op: .Lock), path_bytes));
    }
    .Ok(opened_fd as isize)
}

/| Closes a WASI descriptor via `wasi_fd_close`.
@cfg(target.os == "wasi") @std_cap_boundary(clears: [ffi, unsafe_op])
fn os_close_fd(fd_bits: isize, /) -> unit!FsError {
    let raw_fd = fd_bits as i32;
    if raw_fd < 0 {
        return .Ok(());
    }
    let rc: u16 = unsafe {
        sys.wasi.wasi_fd_close(raw_fd)
    };
    if rc != sys.wasi.WASI_ERRNO_SUCCESS {
        return .Err(wasi_err_to_fs(rc, .None, EMPTY_BYTES));
    }
    .Ok(())
}

/| Reads sequentially from a WASI descriptor via `wasi_fd_read`.
@cfg(target.os == "wasi") @std_cap_boundary(clears: [ffi, unsafe_op])
fn os_file_read(fd_bits: isize, dst_ptr: *mut u8, cap: usize, /) -> usize!IoError {
    let raw_fd = fd_bits as i32;
    let iov = sys.wasi.WasiIovec { buf_ptr: dst_ptr, buf_len: cap };
    var nread = 0_usize;
    let rc: u16 = unsafe {
        sys.wasi.wasi_fd_read(raw_fd, &raw iov, 1_usize, &raw mut nread)
    };
    if rc != sys.wasi.WASI_ERRNO_SUCCESS {
        return .Err(wasi_err_to_io(rc, .Read));
    }
    .Ok(nread)
}

/| Reads positionally at `offset` from a WASI descriptor via `wasi_fd_pread`.
@cfg(target.os == "wasi") @std_cap_boundary(clears: [ffi, unsafe_op])
fn os_file_pread(fd_bits: isize, dst_ptr: *mut u8, cap: usize, offset: u64, /) -> usize!IoError {
    let raw_fd = fd_bits as i32;
    let iov = sys.wasi.WasiIovec { buf_ptr: dst_ptr, buf_len: cap };
    var nread = 0_usize;
    let rc: u16 = unsafe {
        sys.wasi.wasi_fd_pread(raw_fd, &raw iov, 1_usize, offset, &raw mut nread)
    };
    if rc != sys.wasi.WASI_ERRNO_SUCCESS {
        return .Err(wasi_err_to_io(rc, .Read));
    }
    .Ok(nread)
}

/| Writes sequentially to a WASI descriptor via `wasi_fd_write`.
@cfg(target.os == "wasi") @std_cap_boundary(clears: [ffi, unsafe_op])
fn os_file_write(fd_bits: isize, buf: &[u8], /) -> usize!IoError {
    let raw_fd = fd_bits as i32;
    if buf.is_empty() {
        return .Ok(0_usize);
    }
    let ciov = sys.wasi.WasiCiovec { buf_ptr: buf.as_ptr(), buf_len: buf.len() };
    var nwritten = 0_usize;
    let rc: u16 = unsafe {
        sys.wasi.wasi_fd_write(raw_fd, &raw ciov, 1_usize, &raw mut nwritten)
    };
    if rc != sys.wasi.WASI_ERRNO_SUCCESS {
        return .Err(wasi_err_to_io(rc, .Write));
    }
    .Ok(nwritten)
}

/| Writes positionally at `offset` to a WASI descriptor via `wasi_fd_pwrite`.
@cfg(target.os == "wasi") @std_cap_boundary(clears: [ffi, unsafe_op])
fn os_file_pwrite(fd_bits: isize, buf: &[u8], offset: u64, /) -> usize!IoError {
    let raw_fd = fd_bits as i32;
    if buf.is_empty() {
        return .Ok(0_usize);
    }
    let ciov = sys.wasi.WasiCiovec { buf_ptr: buf.as_ptr(), buf_len: buf.len() };
    var nwritten = 0_usize;
    let rc: u16 = unsafe {
        sys.wasi.wasi_fd_pwrite(raw_fd, &raw ciov, 1_usize, offset, &raw mut nwritten)
    };
    if rc != sys.wasi.WASI_ERRNO_SUCCESS {
        return .Err(wasi_err_to_io(rc, .Write));
    }
    .Ok(nwritten)
}

/| Writes scatter-gather `IoSlice`s via `wasi_fd_write` clamped to `WASI_IOV_MAX = 128`.
@cfg(target.os == "wasi") @std_cap_boundary(clears: [ffi, unsafe_op])
fn os_file_write_vectored(fd_bits: isize, bufs: &[IoSlice], /) -> usize!IoError {
    let raw_fd = fd_bits as i32;
    if bufs.is_empty() {
        return .Ok(0_usize);
    }
    let count: usize = if bufs.len() > WASI_IOV_MAX => WASI_IOV_MAX else bufs.len();
    var nwritten = 0_usize;
    let rc: u16 = unsafe {
        sys.wasi.wasi_fd_write(
            raw_fd,
            bufs.as_ptr() as *sys.wasi.WasiCiovec,
            count,
            &raw mut nwritten,
        )
    };
    if rc != sys.wasi.WASI_ERRNO_SUCCESS {
        return .Err(wasi_err_to_io(rc, .Write));
    }
    .Ok(nwritten)
}

/| Seeks a WASI descriptor via `wasi_fd_seek`.
@cfg(target.os == "wasi") @std_cap_boundary(clears: [ffi, unsafe_op])
fn os_file_seek(fd_bits: isize, pos: SeekFrom, /) -> u64!IoError {
    let raw_fd = fd_bits as i32;
    let (delta, whence) = match pos {
        .Start(abs_off) => {
            if abs_off > (i64.MAX as u64) {
                return .Err(IoError.from_kind(.InvalidInput, op: .Seek));
            }
            (abs_off as i64, sys.wasi.WASI_WHENCE_SET)
        },
        .Current(rel_off) => (rel_off, sys.wasi.WASI_WHENCE_CUR),
        .End(end_off) => (end_off, sys.wasi.WASI_WHENCE_END),
    };
    var new_off = 0_u64;
    let rc: u16 = unsafe {
        sys.wasi.wasi_fd_seek(raw_fd, delta, whence, &raw mut new_off)
    };
    if rc != sys.wasi.WASI_ERRNO_SUCCESS {
        return .Err(wasi_err_to_io(rc, .Seek));
    }
    .Ok(new_off)
}

/| Truncates or extends a WASI descriptor via `wasi_fd_filestat_set_size`.
@cfg(target.os == "wasi") @std_cap_boundary(clears: [ffi, unsafe_op])
fn os_file_set_len(fd_bits: isize, size: u64, /) -> unit!FsError {
    let raw_fd = fd_bits as i32;
    let rc: u16 = unsafe {
        sys.wasi.wasi_fd_filestat_set_size(raw_fd, size)
    };
    if rc != sys.wasi.WASI_ERRNO_SUCCESS {
        return .Err(wasi_err_to_fs(rc, .Write, EMPTY_BYTES));
    }
    .Ok(())
}

/| No-op permission update on WASI Preview 1 (capability model lacks `fchmod`).
@cfg(target.os == "wasi")
fn os_file_set_permissions(fd_bits: isize, perms: FilePermissions, /) -> unit!FsError {
    let raw_fd = fd_bits as i32;
    _ = raw_fd;
    _ = perms;
    .Ok(())
}

/| Flushes a WASI descriptor via `wasi_fd_datasync` or `wasi_fd_sync`.
@cfg(target.os == "wasi") @std_cap_boundary(clears: [ffi, unsafe_op])
fn os_file_sync(fd_bits: isize, mode: DurabilityMode, /) -> unit!FsError {
    let raw_fd = fd_bits as i32;
    if mode == .FastLocal {
        return .Ok(());
    }
    let rc: u16 = unsafe {
        if mode == .CrashSafe => sys.wasi.wasi_fd_datasync(raw_fd)
            else sys.wasi.wasi_fd_sync(raw_fd)
    };
    if rc != sys.wasi.WASI_ERRNO_SUCCESS
        and rc != sys.wasi.WASI_ERRNO_NOSYS
        and rc != sys.wasi.WASI_ERRNO_INVAL {
        return .Err(wasi_err_to_fs(rc, .Flush, EMPTY_BYTES));
    }
    .Ok(())
}

/| Queries `Metadata` from an open WASI descriptor via `wasi_fd_filestat_get`.
@cfg(target.os == "wasi") @std_cap_boundary(clears: [ffi, unsafe_op])
fn os_file_metadata(fd_bits: isize, /) -> Metadata!FsError {
    let raw_fd = fd_bits as i32;
    var fst = @default_init[sys.wasi.WasiFilestat]();
    let rc: u16 = unsafe {
        sys.wasi.wasi_fd_filestat_get(raw_fd, &raw mut fst)
    };
    if rc != sys.wasi.WASI_ERRNO_SUCCESS {
        return .Err(wasi_err_to_fs(rc, .Stat, EMPTY_BYTES));
    }
    .Ok(metadata_from_wasi_stat(&fst))
}

/| Opens a fresh capability directory descriptor on WASI (never returning raw preopen `fd = 3` directly).
@cfg(target.os == "wasi") @std_cap_boundary(clears: [ffi, unsafe_op])
fn os_dir_open(path_bytes: &[u8], /) -> isize!FsError {
    let (pre_fd, rel_slice) = wasi_resolve_preopen(path_bytes, .Open)?;
    var opened_fd: i32 = -1;
    let rc: u16 = unsafe {
        sys.wasi.wasi_path_open(
            pre_fd,
            sys.wasi.WASI_LOOKUPFLAGS_SYMLINK_FOLLOW,
            rel_slice.as_ptr(),
            rel_slice.len(),
            sys.wasi.WASI_OFLAGS_DIRECTORY,
            sys.wasi.WASI_RIGHTS_ALL,
            sys.wasi.WASI_RIGHTS_ALL,
            0_u16,
            &raw mut opened_fd,
        )
    };
    if rc != sys.wasi.WASI_ERRNO_SUCCESS {
        return .Err(wasi_err_to_fs(rc, .Open, path_bytes));
    }
    .Ok(opened_fd as isize)
}

/| Opens a file strictly beneath `dir_fd` on WASI (`dirflags = 0` rejects symlinks; `NOTCAPABLE` -> `.FilesystemLoop`).
@cfg(target.os == "wasi") @std_cap_boundary(clears: [ffi, unsafe_op])
fn os_open_file_beneath(dir_bits: isize, rel_bytes: &[u8], opts: OpenOptions, /) -> isize!FsError {
    let dir_fd = dir_bits as i32;
    validate_beneath_lexical(rel_bytes, .Open)?;
    var oflags = 0_u16;
    if opts.flags.create_new {
        oflags |= sys.wasi.WASI_OFLAGS_CREAT | sys.wasi.WASI_OFLAGS_EXCL;
    } else if opts.flags.create {
        oflags |= sys.wasi.WASI_OFLAGS_CREAT;
    }
    if opts.flags.truncate {
        oflags |= sys.wasi.WASI_OFLAGS_TRUNC;
    }
    var fdflags = 0_u16;
    if opts.flags.append {
        fdflags |= sys.wasi.WASI_FDFLAGS_APPEND;
    }
    if opts.flags.sync_data {
        fdflags |= sys.wasi.WASI_FDFLAGS_DSYNC;
    }
    var rights: u64 = sys.wasi.WASI_RIGHTS_FD_SEEK
        | sys.wasi.WASI_RIGHTS_FD_TELL
        | sys.wasi.WASI_RIGHTS_FD_FILESTAT_GET
        | sys.wasi.WASI_RIGHTS_FD_SYNC
        | sys.wasi.WASI_RIGHTS_FD_DATASYNC;
    if opts.flags.read {
        rights |= sys.wasi.WASI_RIGHTS_FD_READ;
    }
    if opts.flags.write
        or opts.flags.append
        or opts.flags.truncate
        or opts.flags.create
        or opts.flags.create_new {
        rights |= sys.wasi.WASI_RIGHTS_FD_WRITE | sys.wasi.WASI_RIGHTS_FD_FILESTAT_SET_SIZE;
    }
    var opened_fd: i32 = -1;
    let rc: u16 = unsafe {
        sys.wasi.wasi_path_open(
            dir_fd,
            0_u32,
            rel_bytes.as_ptr(),
            rel_bytes.len(),
            oflags,
            rights,
            rights,
            fdflags,
            &raw mut opened_fd,
        )
    };
    if rc != sys.wasi.WASI_ERRNO_SUCCESS {
        return .Err(wasi_err_to_fs(rc, .Open, rel_bytes));
    }
    if opts.flags.lock_shared or opts.flags.lock_exclusive {
        unsafe {
            _ = sys.wasi.wasi_fd_close(opened_fd);
        }
        return .Err(attach_failed_path(FsError.from_kind(.Unsupported, op: .Lock), rel_bytes));
    }
    .Ok(opened_fd as isize)
}

/| Opens a subdirectory strictly beneath `dir_fd` on WASI (`dirflags = 0`).
@cfg(target.os == "wasi") @std_cap_boundary(clears: [ffi, unsafe_op])
fn os_open_dir_beneath(dir_bits: isize, rel_bytes: &[u8], /) -> isize!FsError {
    let dir_fd = dir_bits as i32;
    validate_beneath_lexical(rel_bytes, .Open)?;
    var opened_fd: i32 = -1;
    let rc: u16 = unsafe {
        sys.wasi.wasi_path_open(
            dir_fd,
            0_u32,
            rel_bytes.as_ptr(),
            rel_bytes.len(),
            sys.wasi.WASI_OFLAGS_DIRECTORY,
            sys.wasi.WASI_RIGHTS_ALL,
            sys.wasi.WASI_RIGHTS_ALL,
            0_u16,
            &raw mut opened_fd,
        )
    };
    if rc != sys.wasi.WASI_ERRNO_SUCCESS {
        return .Err(wasi_err_to_fs(rc, .Open, rel_bytes));
    }
    .Ok(opened_fd as isize)
}

/| Creates a directory strictly beneath `dir_fd` on WASI.
@cfg(target.os == "wasi") @std_cap_boundary(clears: [ffi, unsafe_op])
fn os_create_dir_beneath(dir_bits: isize, rel_bytes: &[u8], perms: FilePermissions, /) -> unit!FsError {
    let dir_fd = dir_bits as i32;
    _ = perms;
    validate_beneath_lexical(rel_bytes, .Mkdir)?;
    let rc: u16 = unsafe {
        sys.wasi.wasi_path_create_directory(dir_fd, rel_bytes.as_ptr(), rel_bytes.len())
    };
    if rc != sys.wasi.WASI_ERRNO_SUCCESS {
        return .Err(wasi_err_to_fs(rc, .Mkdir, rel_bytes));
    }
    .Ok(())
}

/| Unlinks a non-symlink file strictly beneath `dir_fd` on WASI.
@cfg(target.os == "wasi") @std_cap_boundary(clears: [ffi, unsafe_op])
fn os_unlink_file_beneath(dir_bits: isize, rel_bytes: &[u8], /) -> unit!FsError {
    let dir_fd = dir_bits as i32;
    validate_beneath_lexical(rel_bytes, .Unlink)?;
    var fst = @default_init[sys.wasi.WasiFilestat]();
    let st_rc: u16 = unsafe {
        sys.wasi.wasi_path_filestat_get(
            dir_fd,
            0_u32,
            rel_bytes.as_ptr(),
            rel_bytes.len(),
            &raw mut fst,
        )
    };
    if st_rc == sys.wasi.WASI_ERRNO_SUCCESS and fst.filetype == sys.wasi.WASI_FILETYPE_SYMBOLIC_LINK {
        return .Err(attach_failed_path(FsError.from_kind(.FilesystemLoop, op: .Unlink), rel_bytes));
    }
    let rc: u16 = unsafe {
        sys.wasi.wasi_path_unlink_file(dir_fd, rel_bytes.as_ptr(), rel_bytes.len())
    };
    if rc != sys.wasi.WASI_ERRNO_SUCCESS {
        return .Err(wasi_err_to_fs(rc, .Unlink, rel_bytes));
    }
    .Ok(())
}

/| Queries metadata strictly beneath `dir_fd` on WASI.
@cfg(target.os == "wasi") @std_cap_boundary(clears: [ffi, unsafe_op])
fn os_metadata_beneath(
    dir_bits: isize,
    rel_bytes: &[u8],
    follow_symlinks: bool,
    /,
) -> Metadata!FsError {
    let dir_fd = dir_bits as i32;
    validate_beneath_lexical(rel_bytes, .Stat)?;
    let flags: u32 = if follow_symlinks => sys.wasi.WASI_LOOKUPFLAGS_SYMLINK_FOLLOW else 0_u32;
    var fst = @default_init[sys.wasi.WasiFilestat]();
    let rc: u16 = unsafe {
        sys.wasi.wasi_path_filestat_get(
            dir_fd,
            flags,
            rel_bytes.as_ptr(),
            rel_bytes.len(),
            &raw mut fst,
        )
    };
    if rc != sys.wasi.WASI_ERRNO_SUCCESS {
        return .Err(wasi_err_to_fs(rc, .Stat, rel_bytes));
    }
    .Ok(metadata_from_wasi_stat(&fst))
}

/| Opens an independent `WasiDirIterState` (`path_open(dir_fd, ".")` + `fd_readdir`).
@cfg(target.os == "wasi") @std_cap_boundary(clears: [ffi, unsafe_op])
fn os_dir_entries(dir_bits: isize, /) -> (*mut opaque)!FsError {
    let dir_fd = dir_bits as i32;
    let dot_byte: [u8; 1] = [b'.'];
    var dup_fd: i32 = -1;
    let rc: u16 = unsafe {
        sys.wasi.wasi_path_open(
            dir_fd,
            0_u32,
            &raw dot_byte[0],
            1_usize,
            sys.wasi.WASI_OFLAGS_DIRECTORY,
            sys.wasi.WASI_RIGHTS_ALL,
            sys.wasi.WASI_RIGHTS_ALL,
            0_u16,
            &raw mut dup_fd,
        )
    };
    if rc != sys.wasi.WASI_ERRNO_SUCCESS {
        return .Err(wasi_err_to_fs(rc, .Readdir, EMPTY_BYTES));
    }
    let mem: *mut u8 = System
        .handle()
        .alloc(
            Layout { size: @size_of[WasiDirIterState](), alignment: @align_of[WasiDirIterState]() },
        ) catch {
        unsafe {
            _ = sys.wasi.wasi_fd_close(dup_fd);
        }
        return .Err(FsError.from_kind(.OutOfMemory, op: .Readdir));
    };
    let state_ptr = mem as *mut WasiDirIterState;
    if state_ptr.is_null() {
        unsafe {
            _ = sys.wasi.wasi_fd_close(dup_fd);
        }
        return .Err(FsError.from_kind(.OutOfMemory, op: .Readdir));
    }
    unsafe {
        state_ptr.*.dir_fd = dup_fd;
        state_ptr.*.next_cookie = 0_u64;
        state_ptr.*.buf_pos = 0_usize;
        state_ptr.*.buf_filled = 0_usize;
        state_ptr.*.is_eof = false;
        state_ptr.*.was_full_batch = false;
    }
    .Ok(state_ptr as *mut opaque)
}

/| Advances `WasiDirIterState` via `wasi_fd_readdir`, handling truncated boundary entries (`STD-02` §1.2).
@cfg(target.os == "wasi") @std_cap_boundary(clears: [ffi, unsafe_op, may_panic])
fn os_dir_iter_next(raw_state: *mut opaque, /) -> DirEntry?!FsError {
    let state_ptr = raw_state as *mut WasiDirIterState;
    if state_ptr.is_null() {
        return .Ok(.None);
    }
    let state: &mut WasiDirIterState = unsafe {
        &mut state_ptr.*
    };
    while not state.is_eof {
        let need_refill: bool = if state.buf_pos >= state.buf_filled {
            true
        } else if state.buf_pos +% 24_usize > state.buf_filled {
            if not state.was_full_batch {
                state.is_eof = true;
                return .Ok(.None);
            }
            true
        } else {
            var hdr_tmp = @default_init[sys.wasi.WasiDirentHdr]();
            unsafe {
                @memcpy(
                    (&raw mut hdr_tmp) as *mut opaque,
                    (&raw state.dirent_buf[0]).add(state.buf_pos) as *opaque,
                    24_usize,
                );
            }
            let namlen = hdr_tmp.d_namlen as usize;
            if state.buf_pos +% 24_usize +% namlen > state.buf_filled {
                if not state.was_full_batch {
                    state.is_eof = true;
                    return .Ok(.None);
                }
                true
            } else {
                false
            }
        };

        if need_refill {
            if state.buf_filled > 0_usize
                and not state.was_full_batch
                and state.buf_pos >= state.buf_filled {
                state.is_eof = true;
                return .Ok(.None);
            }
            var used = 0_usize;
            let rc: u16 = unsafe {
                sys.wasi.wasi_fd_readdir(
                    state.dir_fd,
                    &raw mut state.dirent_buf[0],
                    8_192_usize,
                    state.next_cookie,
                    &raw mut used,
                )
            };
            if rc != sys.wasi.WASI_ERRNO_SUCCESS {
                return .Err(wasi_err_to_fs(rc, .Readdir, EMPTY_BYTES));
            }
            if used == 0_usize {
                state.is_eof = true;
                return .Ok(.None);
            }
            state.buf_pos = 0_usize;
            state.buf_filled = used;
            state.was_full_batch = used == 8_192_usize;
            continue;
        }

        var hdr = @default_init[sys.wasi.WasiDirentHdr]();
        unsafe {
            @memcpy(
                (&raw mut hdr) as *mut opaque,
                (&raw state.dirent_buf[0]).add(state.buf_pos) as *opaque,
                24_usize,
            );
        }
        let namlen = hdr.d_namlen as usize;
        let name_ptr: *u8 = unsafe {
            (&raw state.dirent_buf[0]).add(state.buf_pos +% 24_usize)
        };
        state.buf_pos = state.buf_pos +% 24_usize +% namlen;
        state.next_cookie = hdr.d_next;

        let name_slice: &[u8] = unsafe {
            @slice_from_raw_parts(name_ptr, namlen)
        };
        if name_slice.is_empty() or is_dot_or_dotdot(name_slice) {
            continue;
        }
        return .Ok(
            .Some(
                DirEntry {
                    name: PathBuf.from(name_slice),
                    file_type: classify_wasi_filetype(hdr.d_type),
                    inode_or_file_id: hdr.d_ino,
                },
            ),
        );
    }
    .Ok(.None)
}

/| Closes `WasiDirIterState.dir_fd` and deallocates `WasiDirIterState`.
@cfg(target.os == "wasi") @std_cap_boundary(clears: [ffi, unsafe_op])
fn os_dir_iter_close(raw_state: *mut opaque, /) {
    let state_ptr = raw_state as *mut WasiDirIterState;
    if state_ptr.is_null() {
        return;
    }
    let dup_fd: i32 = unsafe {
        state_ptr.read().dir_fd
    };
    if dup_fd >= 0 {
        unsafe {
            _ = sys.wasi.wasi_fd_close(dup_fd);
        }
    }
    System
        .handle()
        .dealloc(
            raw_state as *mut u8,
            Layout { size: @size_of[WasiDirIterState](), alignment: @align_of[WasiDirIterState]() },
        );
}

/| Returns `.Err(.Unsupported)` for `Mmap` on WASI (`load_file_thresholded` falls back to `Arena` + `\0`).
@cfg(target.os == "wasi")
fn os_mmap_open_read_only(
    fd_bits: isize,
    len_bytes: usize,
    require_nul_sentinel: bool,
    /,
) -> Mmap!FsError {
    let raw_fd = fd_bits as i32;
    _ = raw_fd;
    _ = len_bytes;
    _ = require_nul_sentinel;
    .Err(FsError.from_kind(.Unsupported, op: .Mmap))
}

/| No-op `Mmap` close on WASI.
@cfg(target.os == "wasi")
fn os_mmap_close(ptr: *u8, map_cap: usize, /) {
    _ = ptr;
    _ = map_cap;
}

/| Resolves canonical path on WASI via `path_filestat_get` + `path_readlink` (`<= 40` hops) + `normalize_lexical`.
@cfg(target.os == "wasi") @std_cap_boundary(clears: [ffi, unsafe_op])
fn os_resolve_path(path_bytes: &[u8], /) -> PathBuf!FsError {
    var cur_pb: PathBuf = Path.from_bytes(path_bytes).normalize_lexical();
    var link_buf: [u8; 1_024] = [0_u8; 1_024];
    var hops = 0_usize;
    while hops < MAX_SYMLINK_HOPS {
        let (pre_fd, rel_slice) = wasi_resolve_preopen(cur_pb.as_bytes(), .Resolve)?;
        var fst = @default_init[sys.wasi.WasiFilestat]();
        let lstat_rc: u16 = unsafe {
            sys.wasi.wasi_path_filestat_get(
                pre_fd,
                0_u32,
                rel_slice.as_ptr(),
                rel_slice.len(),
                &raw mut fst,
            )
        };
        if lstat_rc != sys.wasi.WASI_ERRNO_SUCCESS {
            return .Err(wasi_err_to_fs(lstat_rc, .Resolve, path_bytes));
        }
        if fst.filetype != sys.wasi.WASI_FILETYPE_SYMBOLIC_LINK {
            return .Ok(cur_pb);
        }
        var used = 0_usize;
        let rl_rc: u16 = unsafe {
            sys.wasi.wasi_path_readlink(
                pre_fd,
                rel_slice.as_ptr(),
                rel_slice.len(),
                &raw mut link_buf[0],
                1_024_usize,
                &raw mut used,
            )
        };
        if rl_rc != sys.wasi.WASI_ERRNO_SUCCESS {
            return .Err(wasi_err_to_fs(rl_rc, .Resolve, path_bytes));
        }
        let target_slice: &[u8] = unsafe {
            @slice_from_raw_parts(&raw link_buf[0], used)
        };
        let target_view = Path.from_bytes(target_slice);
        if target_view.is_absolute() {
            cur_pb = target_view.normalize_lexical();
        } else if cur_pb.as_path().parent() is .Some(par) {
            cur_pb = par.join(target_view).as_path().normalize_lexical();
        } else {
            cur_pb = target_view.normalize_lexical();
        }
        hops = hops +% 1_usize;
    }
    .Err(attach_failed_path(FsError.from_kind(.FilesystemLoop, op: .Resolve), path_bytes))
}

/| Queries path `Metadata` on WASI via `wasi_path_filestat_get`.
@cfg(target.os == "wasi") @std_cap_boundary(clears: [ffi, unsafe_op])
fn os_path_metadata(path_bytes: &[u8], follow_symlinks: bool, /) -> Metadata!FsError {
    let (pre_fd, rel_slice) = wasi_resolve_preopen(path_bytes, .Stat)?;
    let flags: u32 = if follow_symlinks => sys.wasi.WASI_LOOKUPFLAGS_SYMLINK_FOLLOW else 0_u32;
    var fst = @default_init[sys.wasi.WasiFilestat]();
    let rc: u16 = unsafe {
        sys.wasi.wasi_path_filestat_get(
            pre_fd,
            flags,
            rel_slice.as_ptr(),
            rel_slice.len(),
            &raw mut fst,
        )
    };
    if rc != sys.wasi.WASI_ERRNO_SUCCESS {
        return .Err(wasi_err_to_fs(rc, .Stat, path_bytes));
    }
    .Ok(metadata_from_wasi_stat(&fst))
}

/| Creates a single directory on WASI via `wasi_path_create_directory`.
@cfg(target.os == "wasi") @std_cap_boundary(clears: [ffi, unsafe_op])
fn os_mkdir_single(path_bytes: &[u8], perms: FilePermissions, /) -> unit!FsError {
    _ = perms;
    let (pre_fd, rel_slice) = wasi_resolve_preopen(path_bytes, .Mkdir)?;
    let rc: u16 = unsafe {
        sys.wasi.wasi_path_create_directory(pre_fd, rel_slice.as_ptr(), rel_slice.len())
    };
    if rc != sys.wasi.WASI_ERRNO_SUCCESS {
        return .Err(wasi_err_to_fs(rc, .Mkdir, path_bytes));
    }
    .Ok(())
}

