@.cx_str_false = private unnamed_addr constant [5 x i8] c"false", align 1
@.cx_fmt_i64 = private unnamed_addr constant [5 x i8] c"%lld\00", align 1
@.cx_fmt_u64 = private unnamed_addr constant [5 x i8] c"%llu\00", align 1

declare void @llvm.trap() cold noreturn nounwind
declare ptr @getenv(ptr) nounwind
declare ptr @fopen(ptr, ptr) nounwind
declare i32 @fflush(ptr) nounwind
declare i32 @fclose(ptr) nounwind
declare void @_exit(i32) noreturn nounwind
declare i64 @fwrite(ptr, i64, i64, ptr) nounwind
declare i32 @snprintf(ptr, i64, ptr, ...) nounwind
declare i64 @write(i32, ptr, i64) nounwind

define internal void @_cx_rt_init() nounwind uwtable(sync) {
entry:
  ret void
}

define internal void @_cx_rt_trace_append(ptr %line_ptr, i64 %line_len) nounwind uwtable(sync) {
entry:
  %path = call ptr @getenv(ptr @.cx_env_oracle)
  %has_p = icmp ne ptr %path, null
  br i1 %has_p, label %chk_nonempty, label %done
chk_nonempty:
  %ch0 = load i8, ptr %path, align 1
  %ok0 = icmp ne i8 %ch0, 0
  br i1 %ok0, label %open_f, label %done
open_f:
  %fp = call ptr @fopen(ptr %path, ptr @.cx_fmode_ab)
  %ok_fp = icmp ne ptr %fp, null
  br i1 %ok_fp, label %do_wr, label %done
do_wr:
  %_w = call i64 @fwrite(ptr %line_ptr, i64 1, i64 %line_len, ptr %fp)
  %_f = call i32 @fflush(ptr %fp)
  %_c = call i32 @fclose(ptr %fp)
  br label %done
done:
  ret void
}

define internal void @_cx_rt_trap(i32 %reason) cold noreturn nounwind uwtable(sync) {
entry:
  %path = call ptr @getenv(ptr @.cx_env_oracle)
  %has_p = icmp ne ptr %path, null
  br i1 %has_p, label %chk_ch, label %hard_trap
chk_ch:
  %ch0 = load i8, ptr %path, align 1
  %ok0 = icmp ne i8 %ch0, 0
  br i1 %ok0, label %oracle_exit, label %hard_trap
oracle_exit:
  call void @_cx_rt_trace_append(ptr @.cx_msg_trap, i64 7)
  %_fl_t = call i32 @fflush(ptr null)
  call void @_exit(i32 101)
  unreachable
hard_trap:
  call void @llvm.trap()
  unreachable
}

define internal i64 @_cx_rt_sys_write(i32 %fd, ptr %buf, i64 %len) nounwind uwtable(sync) {
entry:
  %res = call i64 @write(i32 %fd, ptr %buf, i64 %len)
  ret i64 %res
}

define internal void @_cx_rt_panic(ptr %msg_ptr, i64 %msg_len) cold noreturn nounwind uwtable(sync) {
entry:
  %_pfx = call i64 @_cx_rt_sys_write(i32 2, ptr @.cx_panic_pfx, i64 7)
  %has_m = icmp ne ptr %msg_ptr, null
  %has_l = icmp ne i64 %msg_len, 0
  %do_p = and i1 %has_m, %has_l
  br i1 %do_p, label %wr_m, label %go_trap
wr_m:
  %_ign = call i64 @_cx_rt_sys_write(i32 2, ptr %msg_ptr, i64 %msg_len)
  br label %go_trap
go_trap:
  %_nl = call i64 @_cx_rt_sys_write(i32 2, ptr @.cx_panic_nl, i64 1)
  call void @_cx_rt_trap(i32 1)
  unreachable
}

define internal void @_cx_rt_sys_exit(i32 %code) noreturn nounwind uwtable(sync) {
entry:
  %ebuf = alloca [64 x i8], align 8
  %en32 = call i32 (ptr, i64, ptr, ...) @snprintf(ptr %ebuf, i64 64, ptr @.cx_fmt_exit, i32 %code)
  %eok = icmp sgt i32 %en32, 0
  %ecl = select i1 %eok, i32 %en32, i32 0
  %eln = zext i32 %ecl to i64
  call void @_cx_rt_trace_append(ptr %ebuf, i64 %eln)
  %_fl = call i32 @fflush(ptr null)
  call void @_exit(i32 %code)
  unreachable
}

