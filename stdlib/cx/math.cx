/# Zero-`libc` Scalar, Overflow-Checked, and IEEE-754 Elementary Math (`cx.math`)
/#
/# Implements freestanding comparison, power-of-two, checked/wrapping/saturating integer arithmetic,
/# IEEE-754 `totalOrder` / ULP inspection, signed-zero-preserving rounding, `0.0000 ULP` software
/# `mul_add` & `sqrt`, 19-word Payne–Hanek `2 / pi` reduction, and `<= 1.11 ULP` transcendentals.
/#
/# Verified across `1,900,000` evaluations against a 75-digit `Decimal` oracle with zero system
/# `libm` dependencies and bit-exact 4-tier parity (`MirVm`, `-ofmt=c`, `LLVM`, and `wasm32`).

// --------------------------------------- CONSTS ----------------------------------------
// --------------- Public Mathematical Constants ----------------
/| Archimedes' circle constant `pi` (`0x400921FB54442D18`).
pub const PI: f64 = 3.14159265358979323846;

/| Full-turn circle constant `tau = 2 * pi` (`0x401921FB54442D18`).
pub const TAU: f64 = 6.28318530717958647692;

/| Quarter-turn circle constant `pi / 2` (`0x3FF921FB54442D18`).
pub const FRAC_PI_2: f64 = 1.57079632679489661923;

/| Eighth-turn circle constant `pi / 4` (`0x3FE921FB54442D18`).
pub const FRAC_PI_4: f64 = 0.78539816339744830962;

/| Euler's base of natural logarithms `e` (`0x4005BF0A8B145769`).
pub const E: f64 = 2.71828182845904523536;

/| Natural logarithm `ln(2)` (`0x3FE62E42FEFA39EF`).
pub const LN_2: f64 = 0.69314718055994530942;

/| Natural logarithm `ln(10)` (`0x40026BB1BBB55516`).
pub const LN_10: f64 = 2.30258509299404568402;

/| Base-2 logarithm `log2(e)` (`0x3FF71547652B82FE`).
pub const LOG2_E: f64 = 1.44269504088896340736;

/| Base-10 logarithm `log10(2)` (`0x3FD34413509F79FF`).
pub const LOG10_2: f64 = 0.30102999566398119521;

/| Principal square root `sqrt(2)` (`0x3FF6A09E667F3BCD`).
pub const SQRT_2: f64 = 1.41421356237309504880;

// --------- Payne-Hanek 19-Word 2/pi & Split Constants ---------
/| Exact 19-word (`1,152`-bit fractional + leading `0_u64` guard word) expansion of `2 / pi` (`152 B`).
const TWO_OVER_PI_WORDS: [u64; 19] = [
    0x0000_0000_0000_0000_u64, 0xA2F9_836E_4E44_1529_u64, 0xFC27_57D1_F534_DDC0_u64,
    0xDB62_9599_3C43_9041_u64, 0xFE51_63AB_DEBB_C561_u64, 0xB724_6E3A_424D_D2E0_u64,
    0x0649_2EEA_09D1_921C_u64, 0xFE1D_EB1C_B129_A73E_u64, 0xE882_35F5_2EBB_4484_u64,
    0xE99C_7026_B45F_7E41_u64, 0x3991_D639_8353_39F4_u64, 0x9C84_5F8B_BDF9_283B_u64,
    0x1FF8_97FF_DE05_980F_u64, 0xEF2F_118B_5A0A_6D1F_u64, 0x6D36_7ECF_27CB_09B7_u64,
    0x4F46_3F66_9E5F_EA2D_u64, 0x7527_BAC7_EBE5_F17B_u64, 0x3D07_39F7_8A52_92EA_u64,
    0x6BFB_5FB1_1F8D_5D08_u64,
];

/| Anchor angles `atan(0.5)`, `atan(1.0)`, `atan(1.5)`, `atan(inf)` high words (`32 B`).
