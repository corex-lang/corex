/| Creates a fresh `CREAT | EXCL` `StagedAtomicFile` on WASI (`STD-02` §3.3).
@cfg(target.os == "wasi")
fn os_staged_atomic_create(
    dst_bytes: &[u8],
    perms: FilePermissions,
    /,
) -> StagedAtomicFile!FsError {
    let dst_view = Path.from_bytes(dst_bytes);
    let (parent_dir, leaf_bytes) = split_parent_and_leaf(dst_view, .Open)?;
    var attempt = 0_u32;
    while attempt < 64_u32 {
        let tmp_pb: PathBuf = build_staged_tmp_path(parent_dir, leaf_bytes, attempt);
        let open_res: isize!FsError = os_file_open(
            tmp_pb.as_bytes(),
            OpenOptions {
                flags: OpenFlags {
                    read: true,
                    write: true,
                    append: false,
                    create: true,
                    create_new: true,
                    truncate: false,
                    no_follow: true,
                    sync_data: false,
                    lock_shared: false,
                    lock_exclusive: false,
                    nonblocking_lock: false,
                    reserved: 0_u8,
                },
                permissions: perms,
            },
        );
        if open_res is .Ok(fd_bits) {
            return .Ok(
                StagedAtomicFile {
                    file: File { raw_fd: bits_to_raw_fd(fd_bits) },
                    parent_dir_fd: -1_isize,
                    tmp_path: tmp_pb,
                    dst_path: PathBuf.from(dst_bytes),
                    perms,
                },
            );
        }
        if open_res is .Err(open_err) and open_err.kind() != .AlreadyExists {
            return .Err(open_err);
        }
        attempt = attempt +% 1_u32;
    }
    .Err(attach_failed_path(FsError.from_kind(.AlreadyExists, op: .Open), dst_bytes))
}

/| Publishes `StagedAtomicFile` on WASI (`fd_datasync`/`fd_sync` -> `fd_close` -> `path_rename`).
@cfg(target.os == "wasi") @std_cap_boundary(clears: [ffi, unsafe_op])
fn os_staged_atomic_publish(
    staged: own StagedAtomicFile,
    durability: DurabilityMode,
    /,
) -> unit!FsError {
    let StagedAtomicFile { file, parent_dir_fd, tmp_path, dst_path, perms } = staged;
    _ = parent_dir_fd;
    _ = perms;
    let File { raw_fd: file_raw } = file;
    let raw_fd = raw_fd_to_bits(file_raw) as i32;
    if os_file_sync(raw_fd as isize, durability) is .Err(sync_err) {
        unsafe {
            _ = sys.wasi.wasi_fd_close(raw_fd);
        }
        os_remove_file(tmp_path.as_bytes()) catch {};
        return .Err(sync_err);
    }
    unsafe {
        _ = sys.wasi.wasi_fd_close(raw_fd);
    }
    let (old_pre, old_rel) = wasi_resolve_preopen(tmp_path.as_bytes(), .Rename) catch |re| {
        os_remove_file(tmp_path.as_bytes()) catch {};
        return .Err(re);
    };
    let (new_pre, new_rel) = wasi_resolve_preopen(dst_path.as_bytes(), .Rename) catch |re2| {
        os_remove_file(tmp_path.as_bytes()) catch {};
        return .Err(re2);
    };
    let rc: u16 = unsafe {
        sys.wasi.wasi_path_rename(
            old_pre,
            old_rel.as_ptr(),
            old_rel.len(),
            new_pre,
            new_rel.as_ptr(),
            new_rel.len(),
        )
    };
    if rc != sys.wasi.WASI_ERRNO_SUCCESS {
        os_remove_file(tmp_path.as_bytes()) catch {};
        return .Err(wasi_err_to_fs(rc, .Rename, dst_path.as_bytes()));
    }
    .Ok(())
}

/| Aborts and unlinks `StagedAtomicFile` on WASI.
@cfg(target.os == "wasi") @std_cap_boundary(clears: [ffi, unsafe_op])
fn os_staged_atomic_abort(staged: own StagedAtomicFile, /) {
    let StagedAtomicFile { file, parent_dir_fd, tmp_path, dst_path, perms } = staged;
    _ = parent_dir_fd;
    _ = dst_path;
    _ = perms;
    let File { raw_fd: file_raw } = file;
    let raw_fd = raw_fd_to_bits(file_raw) as i32;
    if raw_fd >= 0 {
        unsafe {
            _ = sys.wasi.wasi_fd_close(raw_fd);
        }
    }
    os_remove_file(tmp_path.as_bytes()) catch {};
}

/| Publishes an existing staged file onto `dst_bytes` on WASI.
@cfg(target.os == "wasi") @std_cap_boundary(clears: [ffi, unsafe_op])
fn os_publish_staged_path(
    staged_bytes: &[u8],
    dst_bytes: &[u8],
    durability: DurabilityMode,
    /,
) -> unit!FsError {
    if durability != .FastLocal {
        var f_staged: File = File.open(Path.from_bytes(staged_bytes))?;
        let sync_res: unit!FsError = f_staged.sync(durability);
        f_staged.close();
        sync_res?;
    }
    let (old_pre, old_rel) = wasi_resolve_preopen(staged_bytes, .Rename)?;
    let (new_pre, new_rel) = wasi_resolve_preopen(dst_bytes, .Rename)?;
    let rc: u16 = unsafe {
        sys.wasi.wasi_path_rename(
            old_pre,
            old_rel.as_ptr(),
            old_rel.len(),
            new_pre,
            new_rel.as_ptr(),
            new_rel.len(),
        )
    };
    if rc != sys.wasi.WASI_ERRNO_SUCCESS {
        return .Err(wasi_err_to_fs(rc, .Rename, dst_bytes));
    }
    .Ok(())
}

/| Executes `path_link -> 64 KiB Copy` materialization on WASI (`STD-02` §3.4A).
@cfg(target.os == "wasi") @std_cap_boundary(clears: [ffi, unsafe_op])
fn os_materialize_file(
    src_bytes: &[u8],
    dst_bytes: &[u8],
    src_meta: Metadata,
    policy: MaterializePolicy,
    /,
) -> MaterializeMethod!FsError {
    if policy == .ImmutableCas and src_meta.hardlink_count < MAX_SAFE_HARDLINKS {
        let dst_view = Path.from_bytes(dst_bytes);
        let (parent_dir, leaf_bytes) = split_parent_and_leaf(dst_view, .Clone)?;
        let tmp_link: PathBuf = build_staged_tmp_path(parent_dir, leaf_bytes, 95_u32);
        if wasi_resolve_preopen(src_bytes, .Clone) is .Ok((src_pre, src_rel))
            and wasi_resolve_preopen(
                tmp_link.as_bytes(),
                .Clone,
            ) is .Ok((tmp_pre, tmp_rel)) {
            let lrc: u16 = unsafe {
                sys.wasi.wasi_path_link(
                    src_pre,
                    sys.wasi.WASI_LOOKUPFLAGS_SYMLINK_FOLLOW,
                    src_rel.as_ptr(),
                    src_rel.len(),
                    tmp_pre,
                    tmp_rel.as_ptr(),
                    tmp_rel.len(),
                )
            };
            if lrc == sys.wasi.WASI_ERRNO_SUCCESS {
                if os_publish_staged_path(tmp_link.as_bytes(), dst_bytes, .FastLocal) is .Ok(_) {
                    return .Ok(.Hardlinked);
                }
                os_remove_file(tmp_link.as_bytes()) catch {};
            }
        }
    }
    var src_file: File = File.open(Path.from_bytes(src_bytes))?;
    var staged: StagedAtomicFile = os_staged_atomic_create(dst_bytes, src_meta.permissions) catch |se| {
        src_file.close();
        return .Err(se);
    };
    if copy_file_loop_64k(&mut src_file, &mut staged.file) is .Err(cp_err) {
        src_file.close();
        os_staged_atomic_abort(own staged);
        return .Err(cp_err);
    }
    src_file.close();
    os_staged_atomic_publish(own staged, .FastLocal)?;
    .Ok(.Copied)
}

/| Acquires an exclusive `CREAT | EXCL` sentinel lock on WASI (`.Shared` returns `.Unsupported`, `STD-02` §1.2).
@cfg(target.os == "wasi") @std_cap_boundary(clears: [ffi, unsafe_op])
fn os_file_lock_acquire(
    path_bytes: &[u8],
    mode: LockMode,
    nonblocking: bool,
    /,
) -> FileLock!FsError {
    if mode == .Shared {
        return .Err(attach_failed_path(FsError.from_kind(.Unsupported, op: .Lock), path_bytes));
    }
    var attempt = 0_u32;
    while true {
        let open_res: isize!FsError = os_file_open(
            path_bytes,
            OpenOptions {
                flags: OpenFlags {
                    read: true,
                    write: true,
                    append: false,
                    create: true,
                    create_new: true,
                    truncate: false,
                    no_follow: true,
                    sync_data: false,
                    lock_shared: false,
                    lock_exclusive: false,
                    nonblocking_lock: false,
                    reserved: 0_u8,
                },
                permissions: FilePermissions.DEFAULT_FILE,
            },
        );
        if open_res is .Ok(fd_bits) {
            let entry_mem: *mut u8 = System
                .handle()
                .alloc(
                    Layout { size: @size_of[WasiLockEntry](), alignment: @align_of[WasiLockEntry]() },
                ) catch {
                unsafe {
                    _ = sys.wasi.wasi_fd_close(fd_bits as i32);
                }
                os_remove_file(path_bytes) catch {};
                return .Err(FsError.from_kind(.OutOfMemory, op: .Lock));
            };
            let entry_ptr = entry_mem as *mut WasiLockEntry;
            unsafe {
                @ptr_write(
                    entry_ptr,
                    WasiLockEntry {
                        raw_fd: fd_bits as i32,
                        sentinel_path: PathBuf.from(path_bytes),
                    },
                );
            }
            return .Ok(FileLock { file: File { raw_fd: bits_to_raw_fd(entry_ptr as isize) } });
        }
        if open_res is .Err(err_val) {
            if err_val.kind() != .AlreadyExists {
                return .Err(err_val);
            }
            if nonblocking or attempt >= 200_u32 {
                return .Err(
                    attach_failed_path(FsError.from_kind(.FileLockConflict, op: .Lock), path_bytes),
                );
            }
            let sub = sys.wasi.WasiSubscription {
                userdata: 0_u64,
                event_tag: sys.wasi.WASI_EVENTTYPE_CLOCK,
                pad0: [0_u8; 7],
                clock_or_fd: sys.wasi.WasiSubscriptionClock {
                    clock_id: sys.wasi.WASI_CLOCKID_MONOTONIC,
                    pad0: 0_u32,
                    timeout: 5_000_000_u64,
                    precision: 1_000_000_u64,
                    flags: 0_u16,
                    pad1: [0_u16; 3],
                },
            };
            var ev = @default_init[sys.wasi.WasiEvent]();
            var nev = 0_usize;
            unsafe {
                _ = sys.wasi.wasi_poll_oneoff(&raw sub, &raw mut ev, 1_usize, &raw mut nev);
            }
            attempt = attempt +% 1_u32;
            continue;
        }
    }
    .Err(FsError.from_kind(.FileLockConflict, op: .Lock))
}

/| Closes and unlinks the WASI sentinel lockfile.
@cfg(target.os == "wasi") @std_cap_boundary(clears: [ffi, unsafe_op])
fn os_file_lock_release(lock: own FileLock, /) {
    let FileLock { file } = lock;
    let File { raw_fd } = file;
    let entry_ptr = raw_fd_to_bits(raw_fd) as *mut WasiLockEntry;
    if entry_ptr.is_null() {
        return;
    }
    let entry_ref: &WasiLockEntry = unsafe {
        &entry_ptr.*
    };
    if entry_ref.raw_fd >= 0 {
        unsafe {
            _ = sys.wasi.wasi_fd_close(entry_ref.raw_fd);
        }
    }
    os_remove_file(entry_ref.sentinel_path.as_bytes()) catch {};
    unsafe {
        @drop_in_place(entry_ptr);
    }
    System
        .handle()
        .dealloc(
            entry_ptr as *mut u8,
            Layout { size: @size_of[WasiLockEntry](), alignment: @align_of[WasiLockEntry]() },
        );
}

