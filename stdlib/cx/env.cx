/| Resolves `data_local_dir` on Windows (`%LOCALAPPDATA%` fallback `User Shell Folders\Local AppData`).
@cfg(target.os == "windows")
fn host_data_local_dir() -> OptPathBuf {
    if filter_absolute_dir(host_var_os("LOCALAPPDATA")) is .Some(local_pb) {
        return .Some(local_pb);
    }
    filter_absolute_dir(query_win32_user_shell_folder((&WIN32_REG_VAL_LOCAL_APPDATA_W).as_ptr()))
