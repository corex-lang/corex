/# UTF-8 Strings, Unicode 16.0 Segmentation, and Numeric Formatting (`cx.str`)
/#
/# Implements the 24-byte Little-Endian Small String Optimization (`String` with 23 inline UTF-8
/# bytes and `0x7F` `String?` niche), ergonomic zero-allocation `str` views and lazy iterators,
/# Keiser–Lemire SIMD/SWAR UTF-8 validation, tree-shakeable Unicode 16.0 `wcwidth` & UAX #29 tries,
/# and zero-`libc` `jeaiii` / `Schubfach` / `Eisel–Lemire` numeric conversions (`STD-01` §1.4, §2.4–§2.6).
/#
/# Every `.rodata` lookup table lives in an independent top-level `const` symbol, and `str.display_width`
/# consults only `WCWIDTH_*` plus scalar emoji state so `wasm-ld --gc-sections` strips `GCB_*` and
/# `GRAPHEME_DFA` completely unless `.graphemes()` or `grapheme_class` is called (`< 8.7 KiB` Profile C).

use cx.col.Vec;
use cx.math.{carrying_add_u64, widening_mul_u64};
use cx.mem.{AllocError, AllocatorHandle, Arena, Layout};

// ---------------------------------------- TYPES ----------------------------------------
// ---------------- 24-Byte SSO String & CowStr -----------------
/| Owned dynamic byte buffer alias used for `O(1)` `String.into_bytes` ownership transfer.
type ByteVec = Vec[u8];

/| 24-byte UTF-8 `String` with 23-byte Little-Endian SSO (`sizeof(String) == sizeof(String?) == 24 B`).
@repr(C, align: 8)
pub struct String {
    /| Inline `[0..23]` UTF-8 bytes + length in `raw_bytes[23]` (`0..=23`), or overlaid `HeapRepr` (`raw_bytes[23] >= 0x80`).
    raw_bytes: [u8; 24],
}

/| Non-inline 24-byte `String` overlay on 64-bit targets (`flagged_cap` places bit 31 at `raw_bytes[23]` on LE).
@cfg(target.ptr_width == 64) @repr(C, align: 8) @derive(Copy)
struct HeapRepr64 {
    /| Non-null UTF-8 byte buffer pointer (`Bytes 0..7`).
    ptr: *mut u8,
    /| Full 64-bit LSB-tagged `AllocatorHandle` (`Bytes 8..15`).
    alloc: AllocatorHandle,
    /| Initialized UTF-8 byte length (`Bytes 16..19`).
    len: u32,
    /| `cap | 0x8000_0000` (`Bytes 20..23`, ensuring `raw_bytes[23] >= 0x80`).
    flagged_cap: u32,
}

/| Non-inline 24-byte `String` overlay on 32-bit (`wasm32`) targets preserving identical byte offsets `16..23`.
@cfg(target.ptr_width == 32) @repr(C, align: 8) @derive(Copy)
struct HeapRepr32 {
    /| Non-null UTF-8 byte buffer pointer (`Bytes 0..3`).
    ptr: *mut u8,
    /| High-half pointer padding (`Bytes 4..7`).
    _pad0: u32,
    /| 32-bit LSB-tagged `AllocatorHandle` (`Bytes 8..11`).
    alloc: AllocatorHandle,
    /| High-half handle padding (`Bytes 12..15`).
    _pad1: u32,
    /| Initialized UTF-8 byte length (`Bytes 16..19`).
    len: u32,
    /| `cap | 0x8000_0000` (`Bytes 20..23`, ensuring `raw_bytes[23] >= 0x80`).
    flagged_cap: u32,
}

/| Active 24-byte `String` heap/arena/rodata overlay (`HeapRepr64` on 64-bit targets).
@cfg(target.ptr_width == 64)
type HeapRepr = HeapRepr64;

/| Active 24-byte `String` heap/arena/rodata overlay (`HeapRepr32` on `wasm32` targets).
@cfg(target.ptr_width == 32)
type HeapRepr = HeapRepr32;

/| Zero-sized 64-bit `HeapRepr` packer (`target.ptr_width == 64`).
@cfg(target.ptr_width == 64) @derive(Copy)
struct PtrWidthOps64 {}

/| Zero-sized 32-bit `HeapRepr` packer (`target.ptr_width == 32`).
@cfg(target.ptr_width == 32) @derive(Copy)
struct PtrWidthOps32 {}

/| Active pointer-width `HeapRepr` packer (`PtrWidthOps64` on 64-bit targets).
@cfg(target.ptr_width == 64)
type ActivePtrOps = PtrWidthOps64;

/| Active pointer-width `HeapRepr` packer (`PtrWidthOps32` on `wasm32` targets).
@cfg(target.ptr_width == 32)
type ActivePtrOps = PtrWidthOps32;

/| Clone-on-write UTF-8 string holding either a borrowed `str` view or an owned 24-byte `String`.
@expect(unused-pkg-visibility, reason: "reserved for cx.io and cx.serde in Phase 11.2–11.3")
@repr(C, align: 8)
pub(pkg) enum CowStr {
    /| Zero-allocation borrowed UTF-8 slice.
    Borrowed(str),
    /| Owned 24-byte SSO or heap-allocated `String`.
    Owned(String),
}

// --------------- Validation & Conversion Errors ---------------
/| Detailed UTF-8 validation failure reporting the valid prefix length and offending sequence width.
@derive(Copy, Equatable, Debug)
pub struct Utf8Error {
    /| Byte index up to which the input is valid UTF-8.
    pub valid_up_to: usize,
    /| `.None` if truncated at end of input, or `.Some(1..=3)` for the invalid byte sequence length.
    pub error_len: u8?,
}

/| Error returned by `cx.str.parse_int` and `str.parse_int` (`sizeof(ParseIntError?) == 1 B`).
@derive(Copy, Equatable, Debug)
pub enum ParseIntError: u8 {
    /| Input string was empty (`""`).
    Empty = 1,
    /| Input contained an invalid sign or a character outside `0..radix`.
    InvalidDigit = 2,
    /| Parsed integer exceeded `[T.MIN, T.MAX]`.
    Overflow = 3,
}

/| Error returned by `cx.str.parse_float` and `str.parse_float` (`sizeof(ParseFloatError?) == 1 B`).
@derive(Copy, Equatable, Debug)
pub enum ParseFloatError: u8 {
    /| Input string was empty (`""`).
    Empty = 1,
    /| Input did not match IEEE-754 decimal or `inf`/`nan` syntax.
    InvalidSyntax = 2,
}

// --------------- Zero-Allocation str Iterators ----------------
/| Lazy UTF-8 Unicode scalar (`char`) iterator over a `str` slice.
@repr(C)
pub struct CharsIter {
    /| Remaining valid UTF-8 bytes.
    rem: &[u8],
}

/| Lazy `(byte_offset, char)` iterator over a `str` slice.
@repr(C)
pub struct CharIndicesIter {
    /| Remaining valid UTF-8 bytes.
    rem: &[u8],
    /| Current byte offset from start of original `str`.
    offset: usize,
}

/| Lazy UAX #29 Extended Grapheme Cluster iterator over a `str` slice.
@repr(C)
pub struct GraphemeIter {
    /| Remaining valid UTF-8 bytes.
    rem: &[u8],
}

/| Lazy `(byte_offset, cluster_str)` iterator over UAX #29 Extended Grapheme Clusters.
@expect(unused-pkg-visibility, reason: "reserved for cx.io and cx.serde in Phase 11.2–11.3")
@repr(C)
pub(pkg) struct GraphemeIndicesIter {
    /| Remaining valid UTF-8 bytes.
    rem: &[u8],
    /| Current byte offset from start of original `str`.
    offset: usize,
}

/| Lazy substring iterator splitting `text` around `sep`.
@repr(C)
pub struct SplitIter {
    /| Unconsumed tail of the input slice.
    text: str,
    /| Delimiter pattern (`""` yields single Unicode scalar slices).
    sep: str,
    /| When `false`, skips empty `""` segments.
    keep_empty: bool,
    /| `true` once the final trailing segment has been yielded.
    done: bool,
}

/| Lazy Unicode whitespace-delimited word iterator skipping leading/trailing/repeated whitespace.
@repr(C)
pub struct SplitWhitespaceIter {
    /| Remaining unconsumed `str` tail.
    rem: str,
}

/| Lazy line iterator splitting on `\n` or `\r\n` without yielding a spurious trailing empty line.
@repr(C)
pub struct LinesIter {
    /| Remaining unconsumed `str` tail.
    rem: str,
}

// ---------------- Stack & String Format Sinks -----------------
/| Stack-resident byte-slice sink backing `@no_alloc` `cx.str.format_into`.
@repr(C)
struct SliceSink {
    /| Destination mutable byte buffer pointer.
    ptr: *mut u8,
    /| Destination buffer capacity in bytes.
    cap: usize,
    /| Number of UTF-8 bytes written so far.
    pos: usize,
}

/| Streaming `FmtWriter` adapter appending formatted chunks into a `String`.
@repr(C)
struct StringSink {
    /| Destination `String` pointer.
    target: *mut String,
}

/| Zero-sized 128-bit SIMD string/UTF-8 dispatch marker (`x86_64` and `aarch64`).
@cfg(target.arch == "x86_64" or target.arch == "aarch64") @derive(Copy)
struct SimdStrOps {}

/| Zero-sized portable SWAR/scalar string/UTF-8 dispatch marker (`wasm32` and freestanding targets).
@cfg(not (target.arch == "x86_64" or target.arch == "aarch64")) @derive(Copy)
struct SwarStrOps {}

/| Active target SIMD/SWAR string-kernel selector (`SimdStrOps` on `x86_64` and `aarch64`).
@cfg(target.arch == "x86_64" or target.arch == "aarch64")
type ActiveStrOps = SimdStrOps;

/| Active target SIMD/SWAR string-kernel selector (`SwarStrOps` on `wasm32` and portable targets).
@cfg(not (target.arch == "x86_64" or target.arch == "aarch64"))
type ActiveStrOps = SwarStrOps;

// --------------------------------------- CONSTS ----------------------------------------
// -------------------- SSO & SWAR Bit Masks --------------------
/| Bit 7 marker in `String.raw_bytes[23]` identifying non-inline `HeapRepr`.
const STRING_HEAP_FLAG_U8: u8 = 0x80_u8;

/| Bit 31 marker in `HeapRepr.flagged_cap` setting `raw_bytes[23] >= 0x80` on Little-Endian targets.
const STRING_HEAP_FLAG_U32: u32 = 0x8000_0000_u32;

/| 31-bit capacity mask on `HeapRepr.flagged_cap`.
const STRING_CAP_MASK_U32: u32 = 0x7FFF_FFFF_u32;

/| 8-byte SWAR high-bit mask testing ASCII-only 64-bit words (`(word & mask) == 0`).
const ASCII_HIGH_MASK_U64: u64 = 0x8080_8080_8080_8080_u64;

/| Maximum inline SSO byte capacity (`23` UTF-8 bytes).
const STRING_INLINE_CAP: usize = 23;

/| Default base-10 radix (`u8 is 2..=36`) for `parse_int` and `format_int`.
const DEFAULT_RADIX: u8 is 2..=36 = 10;

// --------------- Keiser-Lemire SIMD UTF-8 LUTs ----------------
/| Keiser–Lemire table 1A (`16 B`) indexing high nibble of `prev_byte_1`.
@cfg(target.arch == "x86_64" or target.arch == "aarch64")
const KL_BYTE_1_HIGH: [u8; 16] = [
    0x02, 0x02, 0x02, 0x02, 0x02, 0x02, 0x02, 0x02,
    0x80, 0x80, 0x80, 0x80, 0x21, 0x01, 0x15, 0x49,
];

/| Keiser–Lemire table 1B (`16 B`) indexing low nibble of `prev_byte_1`.
@cfg(target.arch == "x86_64" or target.arch == "aarch64")
const KL_BYTE_1_LOW: [u8; 16] = [
    0xE7, 0xA3, 0x83, 0x83, 0x8B, 0xCB, 0xCB, 0xCB,
    0xCB, 0xCB, 0xCB, 0xCB, 0xCB, 0xDB, 0xCB, 0xCB,
];

/| Keiser–Lemire table 2A (`16 B`) indexing high nibble of `curr_byte`.
@cfg(target.arch == "x86_64" or target.arch == "aarch64")
const KL_BYTE_2_HIGH: [u8; 16] = [
    0x01, 0x01, 0x01, 0x01, 0x01, 0x01, 0x01, 0x01,
    0xE6, 0xAE, 0xBA, 0xBA, 0x01, 0x01, 0x01, 0x01,
];

