    0x0053, 0x0079, 0x0073, 0x0074, 0x0065, 0x006D, 0x0052, 0x006F,
    0x006F, 0x0074, 0x0000,
];

/| UTF-16 `\System32\cmd.exe` suffix appended to `%SystemRoot%` (`17` code units).
@cfg(target.os == "windows")
const WIN32_SYS32_CMD_SUFFIX_UTF16: [u16; 17] = [
