/// Atomically stores `next_val` into `slot` with ordering `order_code`.
@inline
@no_alloc
pub fn atomic_u64_store(mut slot: inout AtomicU64, next_val: u64, order_code: u8) -> unit {
    @atomic_store(&mut slot.inner, next_val, order_code);
}

/// Atomically adds `delta` to `slot` and returns the previous `u64` value.
@inline
@no_alloc
pub fn atomic_u64_fetch_add(mut slot: inout AtomicU64, delta: u64, order_code: u8) -> u64 {
    return @atomic_rmw_add(&mut slot.inner, delta, order_code);
}

/// Atomically subtracts `delta` from `slot` and returns the previous `u64` value.
@inline
@no_alloc
pub fn atomic_u64_fetch_sub(mut slot: inout AtomicU64, delta: u64, order_code: u8) -> u64 {
    return @atomic_rmw_sub(&mut slot.inner, delta, order_code);
}

/// Constructs an `AtomicUsize` initialized to `initial_val`.
@inline
@no_alloc
@no_panic
pub fn atomic_usize_new(initial_val: usize) -> AtomicUsize {
    return AtomicUsize { inner: initial_val };
}

/// Atomically loads the `usize` value from `slot` with ordering `order_code`.
@inline
@no_alloc
pub fn atomic_usize_load(slot: &AtomicUsize, order_code: u8) -> usize {
    return @atomic_load(&slot.inner, order_code);
}

/// Atomically stores `next_val` into `slot` with ordering `order_code`.
@inline
@no_alloc
pub fn atomic_usize_store(mut slot: inout AtomicUsize, next_val: usize, order_code: u8) -> unit {
    @atomic_store(&mut slot.inner, next_val, order_code);
}

/// Atomically adds `delta` to `slot` and returns the previous `usize` value.
@inline
@no_alloc
pub fn atomic_usize_fetch_add(mut slot: inout AtomicUsize, delta: usize, order_code: u8) -> usize {
    return @atomic_rmw_add(&mut slot.inner, delta, order_code);
}
