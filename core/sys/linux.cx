/| Lazily resolves glibc 2.29+ / musl `posix_spawn_file_actions_addchdir_np` via `dlsym`, returning `ENOSYS` on glibc 2.28.
pub unsafe fn linux_spawn_file_actions_addchdir_np(
    actions_ptr: *mut PosixSpawnFileActions,
    dir_path_ptr: *u8,
) -> i32 {
    let sym_ptr = linux_dlsym(
        RTLD_DEFAULT,
        (&b"posix_spawn_file_actions_addchdir_np\0"[0]) as *u8,
    );
    if sym_ptr.is_null() {
        return ENOSYS;
    }
    (@ptr_read((&raw sym_ptr) as *PosixSpawnAddChdirFn))(
        actions_ptr,
        dir_path_ptr,
    )
}

