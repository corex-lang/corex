@cfg(target.os == "macos")
fn host_config_dir() -> OptPathBuf {
    if host_home_dir() is .Some(var home_pb) {
        home_pb.push("Library/Application Support");
        return .Some(home_pb);
    }
    .None
}

/| Resolves `config_dir` on Windows (`%APPDATA%` fallback `User Shell Folders\AppData`).
@cfg(target.os == "windows")
fn host_config_dir() -> OptPathBuf {
    if filter_absolute_dir(host_var_os("APPDATA")) is .Some(app_pb) {
        return .Some(app_pb);
    }
    filter_absolute_dir(query_win32_user_shell_folder((&WIN32_REG_VAL_APPDATA_W).as_ptr()))
}

/| Returns `.None` for `config_dir` on freestanding targets.
@cfg(target.os == "freestanding")
fn host_config_dir() -> OptPathBuf = .None;

/| Resolves `data_local_dir` on Linux and WASI (`$XDG_DATA_HOME` if absolute, else `$HOME/.local/share`).
@cfg(target.os == "linux" or target.os == "wasi")
fn host_data_local_dir() -> OptPathBuf = resolve_xdg_or_home("XDG_DATA_HOME", ".local/share");

