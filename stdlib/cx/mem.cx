//! Zero-`libc` Arenas, Pools, System Page Allocators, and Safe Wire Views (`cx.mem`)
//!
//! Implements CoreX's unified `AllocatorHandle` tag-bit dispatch (`0 = GeneralAllocator`,
//! `1 = BumpArenaNoFree`, `2 = StaticRoData`), `64 KiB` slab `Arena`, 2-slot `with_scratch`
//! ping-pong helpers, `@linear OwnPtr[T]`, `O(1)` `Pool[T]`, `FixedBuffer`, `System`, and `Span16`.
//!
//! All thread-local scratch and size-class allocator states (`16 B .. 32 KiB`) initialize from
//! zeroed `.tbss`/`.bss` memory (`@tls_scratch_ptr`, `@tls_alloc_state`) with zero pre-`main` code.

// ---------------------------------------- TYPES ----------------------------------------
// ---------------- Layouts & Allocator Handles -----------------
/// Validated byte size and power-of-two alignment descriptor (`16 B` on 64-bit, `8 B` on `wasm32`).
@repr(C)
@derive(Copy, Equatable, Clone, Debug)
pub struct Layout {
    /// Requested payload size in bytes (`<= isize.MAX as usize`).
    pub size: usize,
    /// Requested byte alignment (non-zero power of two).
    pub alignment: usize,
}

/// Fallible memory allocation failure code (`STD-01` §1.2).
@derive(Copy, Equatable, Clone, Debug)
pub enum AllocError: u8 {
    /// Backing slab, fixed buffer, or OS virtual memory exhausted (`1`).
    OutOfMemory = 1,
    /// Alignment is not a power of two or rounded size exceeds `isize.MAX` (`2`).
    InvalidLayout = 2,
}

/// 3-bit low-address allocator kind tag encoded in `AllocatorHandle.raw_tagged_ptr` (`STD-01` §1.2).
@derive(Copy, Equatable, Clone, Debug)
pub enum AllocTag: u8 {
    /// General heap or vtable-backed allocator invoking `dealloc` on drop (`0`).
    GeneralAllocator = 0,
    /// Slab bump arena (`Arena`) eliding individual `dealloc` calls (`1`).
    BumpArenaNoFree = 1,
    /// Static `.rodata` or `comptime`-promoted read-only buffer (`2`).
    StaticRoData = 2,
}

/// Low-level dynamic memory allocator contract (`STD-01` §1.2).
pub trait Allocator {
    /// Allocates at least `layout.size` bytes aligned to `layout.alignment`.
    fn alloc(&mut self, layout: Layout, /) -> *mut u8!AllocError;

    /// Attempts to grow or shrink `ptr` to `new_size` in place without moving bytes.
    @no_alloc @no_panic
    fn resize(&mut self, ptr: *mut u8, old_layout: Layout, new_size: usize, /) -> bool;

    /// Grows or shrinks `ptr` to `new_size`, relocating and copying bytes when required.
    fn realloc(
        &mut self,
        ptr: *mut u8,
        old_layout: Layout,
        new_size: usize,
        /,
    ) -> *mut u8!AllocError;

    /// Releases `ptr` previously allocated with `layout`.
    @no_alloc @no_panic
    fn dealloc(&mut self, ptr: *mut u8, layout: Layout, /);
}

/// Intrusive 4-callback vtable referenced at offset `0` of any custom `GeneralAllocator` (`align(8)`).
@repr(C)
@align(8)
@derive(Copy)
pub struct AllocatorHeader {
    /// Type-erased allocation callback receiving allocator state pointer at offset `0`.
    pub alloc_fn: fn(*mut opaque, Layout) -> *mut u8!AllocError,
    /// Type-erased `@no_alloc @no_panic` in-place resize callback.
    pub resize_fn: @no_alloc @no_panic fn(*mut opaque, *mut u8, Layout, usize) -> bool,
    /// Type-erased reallocation callback.
    pub realloc_fn: fn(*mut opaque, *mut u8, Layout, usize) -> *mut u8!AllocError,
    /// Type-erased `@no_alloc @no_panic` deallocation callback.
    pub dealloc_fn: @no_alloc @no_panic fn(*mut opaque, *mut u8, Layout),
}

/// 8-byte aligned LSB-tagged allocator pointer (`0 = System`, `1 = Arena`, `2 = StaticRoData`).
@repr(C)
@derive(Copy, Equatable, Clone, Debug)
pub struct AllocatorHandle {
    /// Tagged allocator address (`bits 0..2` store `AllocTag`).
    pub raw_tagged_ptr: usize,
}

// ----------------- Slab Arena & Scratch Ring ------------------
/// Doubly linked `64 KiB` page-slab header at offset `0` of each `Arena` slab (`32 B` on 64-bit).
@repr(C)
@align(16)
pub(pkg) struct SlabHeader {
    /// Next allocated slab retained for zero-syscall reuse across `restore`/`reset`.
    pub next: *mut SlabHeader,
    /// Previous slab on the active `Arena` spine.
    pub prev: *mut SlabHeader,
    /// Total mapped byte capacity of this slab (including `SlabHeader`).
    pub cap: u32,
    /// Reserved alignment padding (`0`).
    pub _pad: u32 = 0,
}

/// Singly linked header for `> 32 KiB` or over-aligned dedicated OS page mappings.
@repr(C)
@align(16)
pub(pkg) struct BypassHeader {
    /// Previous dedicated bypass mapping in LIFO allocation order.
    pub prev: *mut BypassHeader,
    /// Total page-rounded byte length passed to `System.alloc_pages`.
    pub map_bytes: usize,
}

/// `O(1)` `Arena` rewind snapshot (`24 B` on 64-bit, `12 B` on `wasm32`).
@repr(C)
@derive(Copy, Equatable, Clone, Debug)
pub struct ArenaCheckpoint {
    /// Active slab pointer at checkpoint creation (`0` if unallocated).
    pub(pkg) slab_ptr: *mut SlabHeader,
    /// Head of dedicated bypass mappings at checkpoint creation.
    pub(pkg) bypass_head: *mut BypassHeader,
    /// Bump byte offset within `slab_ptr` at checkpoint creation.
    pub(pkg) used_offset: u32,
}

/// Tier-3 `@linear` `64 KiB` page-slab bump arena (`32 B` on 64-bit; `align(8)` steals bit `0`).
@repr(C)
@align(8)
@linear
pub struct Arena {
    /// Currently active bump slab (`0` until first allocation).
    pub(pkg) current_slab: *mut SlabHeader,
    /// First slab on the arena spine retained across `reset` and `restore`.
    pub(pkg) first_slab: *mut SlabHeader,
    /// LIFO list of dedicated `> 32 KiB` or `> 4096`-aligned bypass mappings.
    pub(pkg) bypass_head: *mut BypassHeader,
    /// Current bump cursor within `current_slab`.
    pub(pkg) used_offset: u32,
    /// Default slab mapping size in bytes (`0` lazy-defaults to `DEFAULT_SLAB_BYTES`).
    pub(pkg) default_cap: u32,
}

/// Canonical alias for `Arena` (`cx.mem.BumpArena`).
pub type BumpArena = Arena;

/// Streaming `FmtWriter` sink state writing directly into an `Arena`'s active slab tip.
struct ArenaFmtSink {
    /// Target arena receiving formatted UTF-8 bytes.
    arena: *mut Arena,
    /// Start of the contiguous formatted byte buffer.
    ptr: *mut u8,
    /// Number of formatted bytes written so far.
    len: usize,
    /// Allocated capacity of `ptr` in bytes.
    cap: usize,
}

// -------------- Owned Pointers, Pools & Buffers ---------------
/// `@linear` non-null unique heap/pool pointer (`0x0` niche -> `sizeof(OwnPtr[T]?) == sizeof(*mut T)`).
@repr(C)
@linear
pub struct OwnPtr[T] {
    /// Non-null unique allocation pointer.
    @non_null
    ptr: *mut T,
}

/// Backing page-slab header linked into `Pool[T].slab_head` and thread-local `pool_slab_head`.
@repr(C)
@align(16)
pub(pkg) struct PoolSlabHeader {
    /// Previous slab in this `Pool[T]` instance's LIFO allocation order.
    pub prev: *mut PoolSlabHeader,
    /// Next active `Pool` slab registered on this thread (`0` at tail).
    pub tls_next: *mut PoolSlabHeader,
    /// Previous active `Pool` slab registered on this thread (`0` at head).
    pub tls_prev: *mut PoolSlabHeader,
    /// Total page-rounded byte length passed to `System.alloc_pages`.
    pub map_bytes: usize,
    /// Byte offset from slab base to slot `0` (`hdr_off`).
    pub data_off: usize,
    /// Exclusive byte offset past the final slot (`hdr_off + items_n * stride`).
    pub slots_end: usize,
}

/// Intrusive freelist link stored at offset `0` of vacant `Pool[T]` and `System` slots.
@repr(C)
pub(pkg) struct PoolFreeNode {
    /// Next vacant slot in the intrusive freelist (`0` when empty).
    pub next: *mut PoolFreeNode,
}

/// `@linear` typed slab pool (`24 B` on 64-bit, `16 B` on `wasm32`; `O(1)` alloc and free).
@repr(C)
@align(8)
@linear
pub struct Pool[T] {
    /// Linked list of backing `64 KiB`+ OS page slabs.
    slab_head: *mut PoolSlabHeader,
    /// Intrusive LIFO list of vacant `T` slots.
    free_head: *mut PoolFreeNode,
    /// Target number of `T` slots per newly mapped slab (`>= 1`).
    slab_items: u32,
    /// Count of currently live checked-out `OwnPtr[T]` handles.
    live_count: u32,
}

/// Stack or static slice bump allocator usable inside `@no_alloc` functions (`32 B` on 64-bit, `Copy`).
@repr(C)
@align(8)
@derive(Copy)
pub struct FixedBuffer {
    /// Non-null `FIXED_BUFFER_HDR_SENTINEL` (`0x1`) tag at offset `0` enabling `as_handle()`.
    header: *AllocatorHeader,
    /// Base pointer of caller-provided backing byte slice.
    buf: *mut u8,
    /// Total capacity of `buf` in bytes.
    cap: usize,
    /// Current bump cursor within `0..=cap`.
    used: usize,
}

/// Zero-`libc` OS / freestanding WebAssembly page & size-class heap (`mmap` / `VirtualAlloc` / `memory.grow`).
pub struct System {}

/// Prefix metadata stored immediately below over-aligned (`> 4 KiB`) `System` allocations.
@repr(C)
struct OverAlignedHeader {
    /// Original base address returned by `os_alloc_pages`.
    raw_base: *mut u8,
    /// Exact page-rounded byte length passed to `os_alloc_pages`.
    map_bytes: usize,
}

/// Zero-initialized thread-local size-class and active-pool state (`224 B` on 64-bit, `124 B` on `wasm32`).
@repr(C)
struct SystemTlsState {
    /// Intrusive LIFO heads for `16 B .. 32 KiB` (`12` power-of-two bins).
    free_heads: [*mut PoolFreeNode; 12],
    /// Active page bump cursors per size class.
    bump_cur: [*mut u8; 12],
    /// Remaining uncarved bytes (`<= 65,520`) in each class's active `64 KiB` slab.
    bump_rem: [u16; 12],
    /// Intrusive doubly linked list head of all live `PoolSlabHeader` slabs on this thread.
    pool_slab_head: *mut PoolSlabHeader,
}

// ----------------- Wire Views & Byte Cursors ------------------
/// Unboxed 4-byte `< 64 KiB` slice descriptor (`FromBytes` + `IntoBytes` via `@zero_pad`).
@repr(C)
@derive(Copy, Equatable, Comparable, Clone, Debug, Default)
@zero_pad
pub struct Span16 {
    /// Byte start offset within the parent buffer (`0..65535`).
    pub off: u16 = 0,
    /// Byte length of the slice view (`0..65535`).
    pub len: u16 = 0,
}

/// Bounds, alignment, or size validation error for zero-`unsafe` wire transmutation (`D-01`).
@derive(Copy, Equatable, Clone, Debug)
pub enum WireError: u8 {
    /// Input buffer ended before supplying the required byte count (`1`).
    UnexpectedEof = 1,
    /// Input buffer address does not satisfy `@align_of[T]()` (`2`).
    MisalignedPtr = 2,
    /// Requested element count overflows `usize` or violates exact buffer size (`3`).
    SizeMismatch = 3,
}

/// Bounds-checked sequential wire reader over an immutable byte slice (`STD-01` §1.2).
@derive(Copy, Clone, Debug)
pub struct ByteCursor {
    /// Underlying read-only byte buffer.
    pub buf: &[u8],
    /// Current byte read offset (`0..=buf.len()`).
    pub pos: usize = 0,
}

// --------------------------------------- CONSTS ----------------------------------------
/// Byte size of `SlabHeader` at the start of every `Arena` slab.
const SLAB_HDR_SIZE: usize = @size_of[SlabHeader]();

/// Byte size of `BypassHeader` at the start of every dedicated bypass mapping.
const BYPASS_HDR_SIZE: usize = @size_of[BypassHeader]();

/// Standard `64 KiB` virtual memory allocation granularity across Windows, Wasm, and `Arena` slabs.
const PAGE_GRANULARITY: usize = 65_536_usize;

/// Default `Arena` slab size (`64 KiB`) shared by internal constructors and `Arena.DEFAULT_SLAB_BYTES`.
const ARENA_DEFAULT_SLAB_BYTES: usize = 65_536_usize;

/// Canonical `System` `AllocatorHandle` sentinel (`0x0`).
const HANDLE_SYSTEM: AllocatorHandle = AllocatorHandle { raw_tagged_ptr: 0_usize };

/// Canonical static `.rodata` `AllocatorHandle` sentinel (`0x2`).
const HANDLE_STATIC_RODATA: AllocatorHandle = AllocatorHandle { raw_tagged_ptr: 2_usize };

/// Minimum `System` size-class bin (`16 B = 1 << 4`).
const SYS_MIN_BIN_LOG2: u32 = 4_u32;

/// Number of `System` thread-local small/medium bins (`16 B .. 32 KiB`).
const SYS_BIN_COUNT: usize = 12_usize;

/// Maximum allocation size (`32 KiB`) served from `System` thread-local bins.
const SYS_MAX_BIN_BYTES: usize = 32_768_usize;

/// Maximum alignment (`4 KiB`) guaranteed directly by OS `mmap` without over-aligned prefix padding.
const SYS_OS_MIN_PAGE_ALIGN: usize = 4_096_usize;

/// Non-null odd sentinel (`0x1`, unreachable by `@align(8) AllocatorHeader`) identifying `FixedBuffer`.
const FIXED_BUFFER_HDR_SENTINEL: usize = 1_usize;

// -------------------------------------- INTERNALS --------------------------------------
// --------------- System Size-Class & Page Heap ----------------
/// Computes `ceil(log2(val))` for `val >= 2`, or `0` when `val <= 1`.
@inline @no_alloc @no_panic
fn ceil_log2_usize(val: usize, /) -> u32 {
    if val <= 1_usize {
        return 0_u32;
    }
    return usize.BITS -% (val -% 1_usize).leading_zeros();
}

/// Computes the `0..11` `System` size-class index for `needed in 1..=32_768`.
@std_cap_boundary(clears: [may_panic])
@inline @no_alloc @no_panic
fn system_bin_index(needed: usize, /) -> usize {
    let clamped: usize = if needed <= 16_usize {
        16_usize
    } else {
        needed
    };
    return (ceil_log2_usize(clamped) -% SYS_MIN_BIN_LOG2) as usize;
}

/// Allocates zero-filled `64 KiB`-granularity OS virtual pages on native / WASI targets.
@cfg(not (target.arch == "wasm32"))
@std_cap_boundary(clears: [unsafe_op])
@no_panic
fn os_alloc_pages(byte_len: usize, /) -> *mut u8!AllocError {
    if byte_len == 0_usize or byte_len > (isize.MAX as usize) {
        return .Err(.InvalidLayout);
    }
    let map_len: usize = align_up(byte_len, PAGE_GRANULARITY) orelse return .Err(.OutOfMemory);
    let raw_ptr: *mut u8 = @sys_mmap(map_len);
    if raw_ptr.is_null() {
        return .Err(.OutOfMemory);
    }
    return .Ok(raw_ptr);
}

/// Releases `64 KiB`-granularity OS virtual pages on native / WASI targets.
@cfg(not (target.arch == "wasm32"))
@std_cap_boundary(clears: [unsafe_op])
@no_alloc @no_panic
fn os_free_pages(ptr: *mut u8, byte_len: usize, /) {
    if ptr.is_null() or byte_len == 0_usize {
        return;
    }
    if align_up(byte_len, PAGE_GRANULARITY) is .Some(map_len) {
        @sys_munmap(ptr, map_len);
    }
}

/// Allocates zero-filled `64 KiB` linear-memory bigpages on `wasm32` (`@wasm_memory_grow` + freelist).
@cfg(target.arch == "wasm32")
@std_cap_boundary(clears: [unsafe_op, may_panic])
@no_panic
fn os_alloc_pages(byte_len: usize, /) -> *mut u8!AllocError {
    if byte_len == 0_usize or byte_len > (isize.MAX as usize) {
        return .Err(.InvalidLayout);
    }
    let map_len: usize = align_up(byte_len, PAGE_GRANULARITY) orelse return .Err(.OutOfMemory);
    let big_cls: u32 = ceil_log2_usize(map_len >> 16_usize);
    if big_cls >= 16_u32 {
        return .Err(.OutOfMemory);
    }
    let pow2_pages: usize = 1_usize << (big_cls as usize);
    let slot_ptr: *mut *mut PoolFreeNode = unsafe {
        ((@tls_alloc_state() as *mut u8).add(@size_of[SystemTlsState]()) as *mut *mut PoolFreeNode).add(
            big_cls as usize,
        )
    };
    if not slot_ptr.is_null() {
        let head_node: *mut PoolFreeNode = unsafe {
            slot_ptr.*
        };
        if not head_node.is_null() {
            unsafe {
                slot_ptr.* = head_node.*.next;
            }
            let raw_bytes: *mut u8 = head_node as *mut u8;
            unsafe {
                @memset(raw_bytes as *mut opaque, 0_u8, pow2_pages * PAGE_GRANULARITY);
            }
            return .Ok(raw_bytes);
        }
    }
    let prev_pages: usize = @wasm_memory_grow(0_u32, pow2_pages);
    if prev_pages == usize.MAX {
        return .Err(.OutOfMemory);
    }
    return .Ok((prev_pages * PAGE_GRANULARITY) as *mut u8);
}

/// Pushes freed `64 KiB` bigpages onto `wasm32`'s power-of-two bigpage freelist (`offset 144..208` in TLS).
@cfg(target.arch == "wasm32")
@std_cap_boundary(clears: [unsafe_op, may_panic])
@no_alloc @no_panic
fn os_free_pages(ptr: *mut u8, byte_len: usize, /) {
    if ptr.is_null() or byte_len == 0_usize {
        return;
    }
    let map_len: usize = align_up(byte_len, PAGE_GRANULARITY) orelse return;
    let big_cls: u32 = ceil_log2_usize(map_len >> 16_usize);
    if big_cls >= 16_u32 {
        return;
    }
    let slot_ptr: *mut *mut PoolFreeNode = unsafe {
        ((@tls_alloc_state() as *mut u8).add(@size_of[SystemTlsState]()) as *mut *mut PoolFreeNode).add(
            big_cls as usize,
        )
    };
    if slot_ptr.is_null() {
        return;
    }
    let node_ptr: *mut PoolFreeNode = ptr as *mut PoolFreeNode;
    if node_ptr.is_null() {
        return;
    }
    unsafe {
        node_ptr.* = PoolFreeNode { next: slot_ptr.* };
        slot_ptr.* = node_ptr;
    }
}

/// Allocates `layout` from `System`'s 12 thread-local power-of-two bins (`16 B .. 32 KiB`) or OS pages.
@std_cap_boundary(clears: [unsafe_op, may_panic])
@no_panic
fn system_alloc(layout: Layout, /) -> *mut u8!AllocError {
    if layout.alignment > SYS_OS_MIN_PAGE_ALIGN {
        let hdr_sz: usize = @size_of[OverAlignedHeader]();
        let overhead: usize = hdr_sz +% (layout.alignment -% 1_usize);
        if layout.size > (isize.MAX as usize) -| overhead {
            return .Err(.OutOfMemory);
        }
        let map_bytes: usize = align_up(layout.size +% overhead, PAGE_GRANULARITY)
            orelse return .Err(.OutOfMemory);
        let raw_base: *mut u8 = os_alloc_pages(map_bytes)?;
        let aligned_addr: usize = align_up((raw_base as usize) +% hdr_sz, layout.alignment)
            orelse {
                os_free_pages(raw_base, map_bytes);
                return .Err(.OutOfMemory);
            };
        let hdr_ptr: *mut OverAlignedHeader = (aligned_addr -% hdr_sz) as *mut OverAlignedHeader;
        if hdr_ptr.is_null() {
            os_free_pages(raw_base, map_bytes);
            return .Err(.OutOfMemory);
        }
        unsafe {
            hdr_ptr.* = OverAlignedHeader {
                raw_base: raw_base,
                map_bytes: map_bytes,
            };
        }
        return .Ok(aligned_addr as *mut u8);
    }
    let needed: usize = if layout.size > layout.alignment {
        layout.size
    } else {
        layout.alignment
    };
    if needed <= SYS_MAX_BIN_BYTES {
        let cls: usize = system_bin_index(needed);
        let slot_sz: usize = 16_usize << (cls & 15_usize);
        let state_ptr: *mut SystemTlsState = @tls_alloc_state() as *mut SystemTlsState;
        if state_ptr.is_null() {
            return .Err(.OutOfMemory);
        }
        let state: &mut SystemTlsState = unsafe {
            &mut state_ptr.*
        };
        let free_node: *mut PoolFreeNode = state.free_heads[cls];
        if not free_node.is_null() {
            state.free_heads[cls] = unsafe {
                free_node.*.next
            };
            return .Ok(free_node as *mut u8);
        }
        if (state.bump_rem[cls] as usize) >= slot_sz {
            let out_ptr: *mut u8 = state.bump_cur[cls];
            state.bump_cur[cls] = unsafe {
                out_ptr.add(slot_sz)
            };
            state.bump_rem[cls] = state.bump_rem[cls] -% (slot_sz as u16);
            return .Ok(out_ptr);
        }
        let page_ptr: *mut u8 = os_alloc_pages(PAGE_GRANULARITY)?;
        state.bump_cur[cls] = unsafe {
            page_ptr.add(slot_sz)
        };
        state.bump_rem[cls] = (PAGE_GRANULARITY -% slot_sz) as u16;
        return .Ok(page_ptr);
    }
    return os_alloc_pages(layout.size);
}

/// Checks whether `ptr` in `System` can resize in place from `old_layout` to `new_size`.
@std_cap_boundary(clears: [unsafe_op, may_panic])
@inline @no_alloc @no_panic
fn system_resize(ptr: *mut u8, old_layout: Layout, new_size: usize, /) -> bool {
    if ptr.is_null() or new_size == 0_usize {
        return false;
    }
    if old_layout.alignment > SYS_OS_MIN_PAGE_ALIGN {
        let hdr_ptr: *OverAlignedHeader = ((ptr as usize) -% @size_of[OverAlignedHeader]()) as *OverAlignedHeader;
        if hdr_ptr.is_null() {
            return false;
        }
        let hdr: OverAlignedHeader = unsafe {
            hdr_ptr.*
        };
        let prefix_used: usize = (ptr as usize) -% (hdr.raw_base as usize);
        if new_size > hdr.map_bytes -| prefix_used {
            return false;
        }
        let needed_map: usize = align_up(prefix_used +% new_size, PAGE_GRANULARITY)
            orelse return false;
        return needed_map == hdr.map_bytes;
    }
    let old_needed: usize = if old_layout.size > old_layout.alignment {
        old_layout.size
    } else {
        old_layout.alignment
    };
    let new_needed: usize = if new_size > old_layout.alignment {
        new_size
    } else {
        old_layout.alignment
    };
    if old_needed <= SYS_MAX_BIN_BYTES {
        if new_needed > SYS_MAX_BIN_BYTES {
            return false;
        }
        return system_bin_index(new_needed) == system_bin_index(old_needed);
    }
    if new_needed <= SYS_MAX_BIN_BYTES {
        return false;
    }
    let old_pages: usize = align_up(old_layout.size, PAGE_GRANULARITY) orelse return false;
    let new_pages: usize = align_up(new_size, PAGE_GRANULARITY) orelse return false;
    return new_pages == old_pages;
}

/// Returns `ptr` to `System`'s `16 B .. 32 KiB` thread-local bin or unmaps OS pages.
@std_cap_boundary(clears: [unsafe_op, may_panic])
@no_alloc @no_panic
fn system_dealloc(ptr: *mut u8, layout: Layout, /) {
    if ptr.is_null() or layout.size == 0_usize {
        return;
    }
    if layout.alignment > SYS_OS_MIN_PAGE_ALIGN {
        let hdr_ptr: *OverAlignedHeader = ((ptr as usize) -% @size_of[OverAlignedHeader]()) as *OverAlignedHeader;
        if hdr_ptr.is_null() {
            return;
        }
        let hdr: OverAlignedHeader = unsafe {
            hdr_ptr.*
        };
        os_free_pages(hdr.raw_base, hdr.map_bytes);
        return;
    }
    let needed: usize = if layout.size > layout.alignment {
        layout.size
    } else {
        layout.alignment
    };
    if needed <= SYS_MAX_BIN_BYTES {
        let cls: usize = system_bin_index(needed);
        let state_ptr: *mut SystemTlsState = @tls_alloc_state() as *mut SystemTlsState;
        if state_ptr.is_null() {
            return;
        }
        let node_ptr: *mut PoolFreeNode = ptr as *mut PoolFreeNode;
        if node_ptr.is_null() {
            return;
        }
        let state: &mut SystemTlsState = unsafe {
            &mut state_ptr.*
        };
        unsafe {
            node_ptr.* = PoolFreeNode { next: state.free_heads[cls] };
        }
        state.free_heads[cls] = node_ptr;
        return;
    }
    os_free_pages(ptr, layout.size);
}

/// Links newly mapped `slab_hdr` at the head of this thread's active `PoolSlabHeader` list.
@std_cap_boundary(clears: [unsafe_op])
@inline @no_alloc @no_panic
fn tls_register_pool_slab(slab_hdr: *mut PoolSlabHeader, /) {
    let state_ptr: *mut SystemTlsState = @tls_alloc_state() as *mut SystemTlsState;
    if state_ptr.is_null() {
        return;
    }
    if slab_hdr.is_null() {
        return;
    }
    let state: &mut SystemTlsState = unsafe {
        &mut state_ptr.*
    };
    let old_head: *mut PoolSlabHeader = state.pool_slab_head;
    unsafe {
        slab_hdr.*.tls_prev = @default_init[*mut PoolSlabHeader]();
        slab_hdr.*.tls_next = old_head;
        if not old_head.is_null() {
            old_head.*.tls_prev = slab_hdr;
        }
    }
    state.pool_slab_head = slab_hdr;
}

/// Unlinks `slab_hdr` from this thread's active `PoolSlabHeader` list in `O(1)` before unmapping.
@std_cap_boundary(clears: [unsafe_op])
@inline @no_alloc @no_panic
fn tls_unregister_pool_slab(slab_hdr: *mut PoolSlabHeader, /) {
    let state_ptr: *mut SystemTlsState = @tls_alloc_state() as *mut SystemTlsState;
    if state_ptr.is_null() {
        return;
    }
    if slab_hdr.is_null() {
        return;
    }
    let state: &mut SystemTlsState = unsafe {
        &mut state_ptr.*
    };
    let prev_node: *mut PoolSlabHeader = unsafe {
        slab_hdr.*.tls_prev
    };
    let next_node: *mut PoolSlabHeader = unsafe {
        slab_hdr.*.tls_next
    };
    unsafe {
        if not prev_node.is_null() {
            prev_node.*.tls_next = next_node;
        } else if state.pool_slab_head == slab_hdr {
            state.pool_slab_head = next_node;
        }
        if not next_node.is_null() {
            next_node.*.tls_prev = prev_node;
        }
        slab_hdr.*.tls_prev = @default_init[*mut PoolSlabHeader]();
        slab_hdr.*.tls_next = @default_init[*mut PoolSlabHeader]();
    }
}

/// Returns `true` if `addr` lies inside any active `Pool` slab mapped on the current thread.
@std_cap_boundary(clears: [unsafe_op])
@no_alloc @no_panic
fn is_in_any_tls_pool_slab(addr: usize, /) -> bool {
    let state_ptr: *mut SystemTlsState = @tls_alloc_state() as *mut SystemTlsState;
    if state_ptr.is_null() {
        return false;
    }
    var cur: *mut PoolSlabHeader = unsafe {
        state_ptr.*.pool_slab_head
    };
    while not cur.is_null() {
        let base_addr: usize = cur as usize;
        let map_len: usize = unsafe {
            cur.*.map_bytes
        };
        if addr >= base_addr and addr -% base_addr < map_len {
            return true;
        }
        cur = unsafe {
            cur.*.tls_next
        };
    }
    return false;
}

/// Computes `(slot_align, slot_stride)` for non-ZST `Pool[T]` slots.
@inline @no_alloc @no_panic
fn pool_slot_geometry[T]() -> (usize, usize)? {
    let min_align: usize = @align_of[*mut PoolFreeNode]();
    let slot_align: usize = if @align_of[T]() > min_align {
        @align_of[T]()
    } else {
        min_align
    };
    let min_sz: usize = @size_of[*mut PoolFreeNode]();
    let raw_sz: usize = if @size_of[T]() > min_sz {
        @size_of[T]()
    } else {
        min_sz
    };
    if align_up(raw_sz, slot_align) is .Some(stride) {
        return .Some((slot_align, stride));
    }
    return .None;
}

// ----------------- Slab Arena & Fixed Helpers -----------------
/// Attempts to grow or shrink the active tip allocation of `arena` in `O(1)` without copying.
@std_cap_boundary(clears: [unsafe_op, may_panic])
@inline @no_alloc @no_panic
fn arena_resize_in_place(
    arena: &mut Arena,
    ptr: *mut u8,
    old_layout: Layout,
    new_size: usize,
    /,
) -> bool {
    if ptr.is_null() {
        return false;
    }
    let slab: *mut SlabHeader = arena.current_slab;
    if not slab.is_null() {
        let slab_base: usize = slab as usize;
        let ptr_addr: usize = ptr as usize;
        if ptr_addr >= slab_base and ptr_addr +% old_layout.size == slab_base +% (
            arena.used_offset as usize
        ) {
            let rel_off: usize = ptr_addr -% slab_base;
            let slab_cap: usize = unsafe {
                slab.*.cap
            } as usize;
            if new_size <= slab_cap -| rel_off and rel_off +% new_size <= slab_cap {
                arena.used_offset = (rel_off +% new_size) as u32;
                return true;
            }
            return false;
        }
    }
    return new_size <= old_layout.size;
}

/// Appends formatted `chunk` bytes into an `ArenaFmtSink`, growing in place at the slab tip when possible.
@std_cap_boundary(clears: [unsafe_op, may_panic])
fn arena_fmt_write_cb(ctx: *mut opaque, chunk: &[u8]) -> unit!FmtError {
    if chunk.is_empty() {
        return .Ok(());
    }
    let sink_ptr: *mut ArenaFmtSink = ctx as *mut ArenaFmtSink;
    if sink_ptr.is_null() {
        return .Err(.BufferFull);
    }
    let sink: &mut ArenaFmtSink = unsafe {
        &mut sink_ptr.*
    };
    let needed: usize = sink.len +| chunk.len();
    if needed > (isize.MAX as usize) {
        return .Err(.BufferFull);
    }
    if needed > sink.cap {
        let arena_ptr: *mut Arena = sink.arena;
        if arena_ptr.is_null() {
            return .Err(.BufferFull);
        }
        let arena_ref: &mut Arena = unsafe {
            &mut arena_ptr.*
        };
        let doubled: usize = if sink.cap == 0_usize {
            64_usize
        } else {
            sink.cap *| 2_usize
        };
        let new_cap: usize = if doubled >= needed {
            doubled
        } else {
            needed
        };
        if sink.cap == 0_usize {
            sink.ptr = arena_ref.alloc_raw(Layout { size: new_cap, alignment: 1_usize }) catch {
                return .Err(.BufferFull);
            };
            sink.cap = new_cap;
        } else if arena_resize_in_place(
            arena_ref,
            sink.ptr,
            Layout { size: sink.cap, alignment: 1_usize },
            new_cap,
        ) {
            sink.cap = new_cap;
        } else {
            let new_ptr: *mut u8 = arena_ref.alloc_raw(Layout { size: new_cap, alignment: 1_usize }) catch {
                return .Err(.BufferFull);
            };
            if sink.len > 0_usize {
                unsafe {
                    @memcpy(new_ptr as *mut opaque, sink.ptr as *opaque, sink.len);
                }
            }
            sink.ptr = new_ptr;
            sink.cap = new_cap;
        }
    }
    unsafe {
        @memcpy(sink.ptr.add(sink.len) as *mut opaque, chunk.as_ptr() as *opaque, chunk.len());
    }
    sink.len = needed;
    return .Ok(());
}

/// Validates `bytes` as well-formed UTF-8 without depending on `cx.str` (8-byte SWAR + scalar).
@std_cap_boundary(clears: [unsafe_op, may_panic])
@no_alloc @no_panic
fn is_valid_utf8_bytes(bytes: &[u8], /) -> bool {
    let n: usize = bytes.len();
    let ptr: *u8 = bytes.as_ptr();
    var i: usize = 0_usize;
    while i +% 8_usize <= n {
        var word_bytes: [u8; 8] = [0_u8; 8];
        unsafe {
            @memcpy(&raw mut word_bytes[0] as *mut opaque, ptr.add(i) as *opaque, 8_usize);
        }
        if (@from_le_bytes[u64](word_bytes) & 0x8080_8080_8080_8080_u64) == 0_u64 {
            i += 8_usize;
        } else {
            break;
        }
    }
    while i < n {
        let b0: u8 = bytes[i];
        if b0 < 0x80_u8 {
            i += 1_usize;
        } else if b0 < 0xC2_u8 {
            return false;
        } else if b0 < 0xE0_u8 {
            if i +% 1_usize >= n or (bytes[i +% 1_usize] & 0xC0_u8) != 0x80_u8 {
                return false;
            }
            i += 2_usize;
        } else if b0 < 0xF0_u8 {
            if i +% 2_usize >= n or (bytes[i +% 1_usize] & 0xC0_u8) != 0x80_u8 or (
                bytes[i +% 2_usize] & 0xC0_u8
            ) != 0x80_u8 {
                return false;
            }
            let b1: u8 = bytes[i +% 1_usize];
            if (b0 == 0xE0_u8 and b1 < 0xA0_u8) or (b0 == 0xED_u8 and b1 >= 0xA0_u8) {
                return false;
            }
            i += 3_usize;
        } else if b0 <= 0xF4_u8 {
            if i +% 3_usize >= n or (bytes[i +% 1_usize] & 0xC0_u8) != 0x80_u8 or (
                bytes[i +% 2_usize] & 0xC0_u8
            ) != 0x80_u8 or (bytes[i +% 3_usize] & 0xC0_u8) != 0x80_u8 {
                return false;
            }
            let b1: u8 = bytes[i +% 1_usize];
            if (b0 == 0xF0_u8 and b1 < 0x90_u8) or (b0 == 0xF4_u8 and b1 >= 0x90_u8) {
                return false;
            }
            i += 4_usize;
        } else {
            return false;
        }
    }
    return true;
}

/// Type-erased `AllocatorHeader.alloc_fn` shim for `FixedBuffer`.
@std_cap_boundary(clears: [unsafe_op])
@no_alloc @no_panic
fn fixed_buffer_alloc_cb(ctx: *mut opaque, layout: Layout) -> *mut u8!AllocError {
    let fb_ptr: *mut FixedBuffer = ctx as *mut FixedBuffer;
    if fb_ptr.is_null() {
        return .Err(.OutOfMemory);
    }
    let fb_ref: &mut FixedBuffer = unsafe {
        &mut fb_ptr.*
    };
    return fb_ref.alloc(layout);
}

/// Type-erased `AllocatorHeader.resize_fn` shim for `FixedBuffer`.
@std_cap_boundary(clears: [unsafe_op])
@no_alloc @no_panic
fn fixed_buffer_resize_cb(
    ctx: *mut opaque,
    ptr: *mut u8,
    old_layout: Layout,
    new_size: usize,
) -> bool {
    let fb_ptr: *mut FixedBuffer = ctx as *mut FixedBuffer;
    if fb_ptr.is_null() {
        return false;
    }
    let fb_ref: &mut FixedBuffer = unsafe {
        &mut fb_ptr.*
    };
    return fb_ref.resize(ptr, old_layout, new_size);
}

/// Type-erased `AllocatorHeader.realloc_fn` shim for `FixedBuffer`.
@std_cap_boundary(clears: [unsafe_op])
@no_alloc @no_panic
fn fixed_buffer_realloc_cb(
    ctx: *mut opaque,
    ptr: *mut u8,
    old_layout: Layout,
    new_size: usize,
) -> *mut u8!AllocError {
    let fb_ptr: *mut FixedBuffer = ctx as *mut FixedBuffer;
    if fb_ptr.is_null() {
        return .Err(.OutOfMemory);
    }
    let fb_ref: &mut FixedBuffer = unsafe {
        &mut fb_ptr.*
    };
    return fb_ref.realloc(ptr, old_layout, new_size);
}

/// Type-erased `AllocatorHeader.dealloc_fn` shim for `FixedBuffer`.
@std_cap_boundary(clears: [unsafe_op])
@no_alloc @no_panic
fn fixed_buffer_dealloc_cb(ctx: *mut opaque, ptr: *mut u8, layout: Layout) {
    let fb_ptr: *mut FixedBuffer = ctx as *mut FixedBuffer;
    if fb_ptr.is_null() {
        return;
    }
    let fb_ref: &mut FixedBuffer = unsafe {
        &mut fb_ptr.*
    };
    fb_ref.dealloc(ptr, layout);
}

// ------------------------------------- PUBLIC API --------------------------------------
// ---------------- Layouts & Allocator Handles -----------------
impl Layout {
    /// Validates `size <= isize.MAX` (including alignment rounding) and non-zero power-of-two `alignment`.
    @inline @no_alloc @no_panic
    pub fn new(size: usize, alignment: usize, /) -> Layout!AllocError {
        if alignment == 0_usize or (alignment & (alignment -% 1_usize)) != 0_usize {
            return .Err(.InvalidLayout);
        }
        let max_bytes: usize = isize.MAX as usize;
        if size > max_bytes -| (alignment -% 1_usize) {
            return .Err(.InvalidLayout);
        }
        return .Ok(Layout { size: size, alignment: alignment });
    }

    /// Returns the exact compile-time/runtime `Layout` of `T`.
    @inline @no_alloc @no_panic
    pub fn of[T]() -> Layout {
        return Layout {
            size: @size_of[T](),
            alignment: @align_of[T](),
        };
    }

    /// Computes the contiguous `Layout` for `[T; count]`, guarding `count * @size_of[T]()` overflow.
    @std_cap_boundary(clears: [may_panic])
    @inline @no_alloc @no_panic
    pub fn array[T](count: usize, /) -> Layout!AllocError {
        let elem_sz: usize = @size_of[T]();
        let align_val: usize = @align_of[T]();
        let max_bytes: usize = isize.MAX as usize;
        if elem_sz != 0_usize and count > (max_bytes -| (align_val -% 1_usize)) / elem_sz {
            return .Err(.InvalidLayout);
        }
        return .Ok(
            Layout {
                size: count *% elem_sz,
                alignment: align_val,
            },
        );
    }

    /// Rounds `self.size` upward to the nearest multiple of `self.alignment`.
    @inline @no_alloc @no_panic
    pub fn pad_to_align(self) -> Layout {
        let mask: usize = self.alignment -% 1_usize;
        return Layout {
            size: (self.size +% mask) & ~mask,
            alignment: self.alignment,
        };
    }
}

impl AllocatorHandle {
    /// Default process/thread-local `System` allocator sentinel (`0x0`).
    pub const SYSTEM: AllocatorHandle = AllocatorHandle { raw_tagged_ptr: 0_usize };

    /// Immutable `.rodata` / `comptime`-promoted buffer handle (`0x2`; never freed).
    pub const STATIC_RODATA: AllocatorHandle = AllocatorHandle { raw_tagged_ptr: 2_usize };

    /// Extracts the 3-bit `AllocTag` encoded in `self.raw_tagged_ptr`.
    @inline @no_alloc @no_panic
    pub fn tag(self) -> AllocTag {
        return match self.raw_tagged_ptr & 0x7_usize {
            1_usize => .BumpArenaNoFree,
            2_usize => .StaticRoData,
            _ => .GeneralAllocator,
        };
    }

    /// Returns `true` when individual `dealloc` calls are no-ops (`BumpArenaNoFree` or `StaticRoData`).
    @inline @no_alloc @no_panic
    pub fn is_arena_or_static(self) -> bool = (self.raw_tagged_ptr & 0x7_usize) != 0_usize;

    /// Allocates `layout` from the tagged `System`, `Arena`, or custom `AllocatorHeader` target.
    @std_cap_boundary(clears: [unsafe_op, may_panic, blocking_sync])
    pub fn alloc(self, layout: Layout, /) -> *mut u8!AllocError {
        let valid_layout: Layout = Layout.new(layout.size, layout.alignment)?;
        if valid_layout.size == 0_usize {
            return .Ok(valid_layout.alignment as *mut u8);
        }
        let kind: AllocTag = self.tag();
        if kind == .StaticRoData {
            return .Err(.OutOfMemory);
        } else if kind == .BumpArenaNoFree {
            let arena_ptr: *mut Arena = (self.raw_tagged_ptr & ~7_usize) as *mut Arena;
            if arena_ptr.is_null() {
                return .Err(.OutOfMemory);
            }
            let arena_ref: &mut Arena = unsafe {
                &mut arena_ptr.*
            };
            return arena_ref.alloc_raw(valid_layout);
        }
        if self.raw_tagged_ptr == 0_usize {
            return system_alloc(valid_layout);
        }
        let hdr_slot: **AllocatorHeader = self.raw_tagged_ptr as **AllocatorHeader;
        if hdr_slot.is_null() {
            return .Err(.OutOfMemory);
        }
        let header_ptr: *AllocatorHeader = unsafe {
            hdr_slot.*
        };
        if header_ptr.is_null() {
            return .Err(.OutOfMemory);
        }
        if (header_ptr as usize) == FIXED_BUFFER_HDR_SENTINEL {
            return fixed_buffer_alloc_cb(self.raw_tagged_ptr as *mut opaque, valid_layout);
        }
        let alloc_cb = unsafe {
            header_ptr.*.alloc_fn
        };
        return alloc_cb(self.raw_tagged_ptr as *mut opaque, valid_layout);
    }

    /// Attempts to grow or shrink `ptr` to `new_size` in place (`@no_alloc @no_panic`).
    @std_cap_boundary(clears: [unsafe_op, alloc, may_panic, blocking_sync])
    @no_alloc @no_panic
    pub fn resize_in_place(
        self,
        ptr: *mut u8,
        old_layout: Layout,
        new_size: usize,
        /,
    ) -> bool {
        if Layout.new(new_size, old_layout.alignment) is .Err(_) {
            return false;
        }
        if old_layout.size == 0_usize and new_size == 0_usize {
            return true;
        }
        return match self.tag() {
            .StaticRoData => new_size <= old_layout.size,
            .BumpArenaNoFree => {
                let arena_ptr: *mut Arena = (self.raw_tagged_ptr & ~7_usize) as *mut Arena;
                if arena_ptr.is_null() {
                    return false;
                }
                let arena_ref: &mut Arena = unsafe {
                    &mut arena_ptr.*
                };
                arena_resize_in_place(arena_ref, ptr, old_layout, new_size)
            },
            .GeneralAllocator => {
                if self.raw_tagged_ptr == 0_usize {
                    return system_resize(ptr, old_layout, new_size);
                }
                let hdr_slot: **AllocatorHeader = self.raw_tagged_ptr as **AllocatorHeader;
                if hdr_slot.is_null() {
                    return false;
                }
                let header_ptr: *AllocatorHeader = unsafe {
                    hdr_slot.*
                };
                if header_ptr.is_null() {
                    return false;
                }
                if (header_ptr as usize) == FIXED_BUFFER_HDR_SENTINEL {
                    return fixed_buffer_resize_cb(
                        self.raw_tagged_ptr as *mut opaque,
                        ptr,
                        old_layout,
                        new_size,
                    );
                }
                let resize_cb = unsafe {
                    header_ptr.*.resize_fn
                };
                resize_cb(
                    self.raw_tagged_ptr as *mut opaque,
                    ptr,
                    old_layout,
                    new_size,
                )
            },
        };
    }

    /// Reallocates `ptr` from `old_layout` to `new_size`, preserving `min(old_layout.size, new_size)` bytes.
    @std_cap_boundary(clears: [unsafe_op, may_panic, blocking_sync])
    pub fn realloc(
        self,
        ptr: *mut u8,
        old_layout: Layout,
        new_size: usize,
        /,
    ) -> *mut u8!AllocError {
        let new_layout: Layout = Layout.new(new_size, old_layout.alignment)?;
        if new_size == 0_usize {
            self.dealloc(ptr, old_layout);
            return .Ok(old_layout.alignment as *mut u8);
        }
        if old_layout.size == 0_usize or ptr.is_null() {
            return self.alloc(new_layout);
        }
        if self.resize_in_place(ptr, old_layout, new_size) {
            return .Ok(ptr);
        }
        if self.tag() == .GeneralAllocator and self.raw_tagged_ptr != 0_usize {
            let hdr_slot: **AllocatorHeader = self.raw_tagged_ptr as **AllocatorHeader;
            if hdr_slot.is_null() {
                return .Err(.OutOfMemory);
            }
            let header_ptr: *AllocatorHeader = unsafe {
                hdr_slot.*
            };
            if header_ptr.is_null() {
                return .Err(.OutOfMemory);
            }
            if (header_ptr as usize) == FIXED_BUFFER_HDR_SENTINEL {
                return fixed_buffer_realloc_cb(
                    self.raw_tagged_ptr as *mut opaque,
                    ptr,
                    old_layout,
                    new_size,
                );
            }
            let realloc_cb = unsafe {
                header_ptr.*.realloc_fn
            };
            return realloc_cb(
                self.raw_tagged_ptr as *mut opaque,
                ptr,
                old_layout,
                new_size,
            );
        }
        let next_ptr: *mut u8 = self.alloc(new_layout)?;
        let copy_len: usize = if old_layout.size < new_size {
            old_layout.size
        } else {
            new_size
        };
        if copy_len > 0_usize {
            unsafe {
                @memcpy(next_ptr as *mut opaque, ptr as *opaque, copy_len);
            }
        }
        self.dealloc(ptr, old_layout);
        return .Ok(next_ptr);
    }

    /// Releases `ptr` when backed by a `GeneralAllocator`; zero-cost no-op on arenas and `.rodata`.
    @std_cap_boundary(clears: [unsafe_op, alloc, may_panic, blocking_sync])
    @no_alloc @no_panic
    pub fn dealloc(self, ptr: *mut u8, layout: Layout, /) {
        if ptr.is_null() or layout.size == 0_usize {
            return;
        }
        if self.tag() != .GeneralAllocator {
            return;
        }
        if self.raw_tagged_ptr == 0_usize {
            system_dealloc(ptr, layout);
            return;
        }
        let hdr_slot: **AllocatorHeader = self.raw_tagged_ptr as **AllocatorHeader;
        if hdr_slot.is_null() {
            return;
        }
        let header_ptr: *AllocatorHeader = unsafe {
            hdr_slot.*
        };
        if header_ptr.is_null() {
            return;
        }
        if (header_ptr as usize) == FIXED_BUFFER_HDR_SENTINEL {
            fixed_buffer_dealloc_cb(self.raw_tagged_ptr as *mut opaque, ptr, layout);
            return;
        }
        let dealloc_cb = unsafe {
            header_ptr.*.dealloc_fn
        };
        dealloc_cb(self.raw_tagged_ptr as *mut opaque, ptr, layout);
    }
}

// ----------------- Slab Arena & Scratch Ring ------------------
impl Arena {
    /// Default `64 KiB` virtual page slab size (`65,536 B`).
    pub const DEFAULT_SLAB_BYTES: usize = 65_536_usize;

    /// Threshold (`32 KiB`) above which allocations receive dedicated `BypassHeader` page mappings.
    pub const BYPASS_THRESHOLD: usize = 32_768_usize;

    /// Constructs a lazy `@linear Arena` mapping `slab_bytes` slabs on first allocation (`0` syscalls upfront).
    @inline @no_alloc @no_panic
    pub fn new(*, slab_bytes: usize = 65_536_usize) -> Self {
        let aligned_cap: usize = match align_up(
            if slab_bytes < 4_096_usize {
                4_096_usize
            } else {
                slab_bytes
            },
            PAGE_GRANULARITY,
        ) {
            .Some(rounded) => if rounded > 0x4000_0000_usize {
                0x4000_0000_usize
            } else {
                rounded
            },
            .None => 65_536_usize,
        };
        return Self {
            current_slab: @default_init[*mut SlabHeader](),
            first_slab: @default_init[*mut SlabHeader](),
            bypass_head: @default_init[*mut BypassHeader](),
            used_offset: 0_u32,
            default_cap: aligned_cap as u32,
        };
    }

    /// Constructs an `Arena` with an eagerly mapped initial slab holding at least `min_bytes`.
    @std_cap_boundary(clears: [unsafe_op, may_panic])
    pub fn with_capacity(min_bytes: usize, /) -> Self!AllocError {
        if min_bytes > 0x3FFF_0000_usize {
            return .Err(.InvalidLayout);
        }
        let needed_slab: usize = align_up(
            if min_bytes + SLAB_HDR_SIZE > ARENA_DEFAULT_SLAB_BYTES {
                min_bytes + SLAB_HDR_SIZE
            } else {
                ARENA_DEFAULT_SLAB_BYTES
            },
            PAGE_GRANULARITY,
        ) orelse return .Err(.OutOfMemory);
        let raw_slab: *mut u8 = os_alloc_pages(needed_slab)?;
        let hdr: *mut SlabHeader = raw_slab as *mut SlabHeader;
        if hdr.is_null() {
            return .Err(.OutOfMemory);
        }
        unsafe {
            hdr.* = SlabHeader {
                next: @default_init[*mut SlabHeader](),
                prev: @default_init[*mut SlabHeader](),
                cap: needed_slab as u32,
                _pad: 0_u32,
            };
        }
        return .Ok(
            Self {
                current_slab: hdr,
                first_slab: hdr,
                bypass_head: @default_init[*mut BypassHeader](),
                used_offset: SLAB_HDR_SIZE as u32,
                default_cap: ARENA_DEFAULT_SLAB_BYTES as u32,
            },
        );
    }

    /// Returns a bit-0 tagged `AllocatorHandle` (`AllocTag.BumpArenaNoFree`).
    @inline @no_alloc @no_panic
    pub fn as_handle(&mut self) -> AllocatorHandle {
        return AllocatorHandle { raw_tagged_ptr: (self as usize) | 0x1_usize };
    }

    /// Fast-path 4-instruction bump allocation inside `current_slab` with cold slab/bypass fallback.
    @std_cap_boundary(clears: [unsafe_op, may_panic])
    @inline @no_panic
    pub fn alloc_raw(&mut self, layout: Layout, /) -> *mut u8!AllocError {
        let valid: Layout = Layout.new(layout.size, layout.alignment)?;
        if valid.size == 0_usize {
            return .Ok(valid.alignment as *mut u8);
        }
        let eff_cap: usize = if self.default_cap == 0_u32 {
            ARENA_DEFAULT_SLAB_BYTES
        } else {
            self.default_cap as usize
        };
        let slab: *mut SlabHeader = self.current_slab;
        if not slab.is_null() and valid.size <= eff_cap / 2_usize and valid.alignment <= 4_096_usize {
            let slab_addr: usize = slab as usize;
            if align_up(slab_addr +% (self.used_offset as usize), valid.alignment) is .Some(
                aligned_addr,
            ) {
                let rel_off: usize = aligned_addr -% slab_addr;
                if not slab.is_null() {
                    let slab_cap: usize = unsafe {
                        slab.*.cap
                    } as usize;
                    if valid.size <= slab_cap -| rel_off and rel_off +% valid.size <= slab_cap {
                        self.used_offset = (rel_off +% valid.size) as u32;
                        return .Ok(aligned_addr as *mut u8);
                    }
                }
            }
        }
        return self.alloc_slow(valid, eff_cap);
    }

    /// Cold-path slab growth, cached-slab reuse, or dedicated `BypassHeader` mapping.
    @std_cap_boundary(clears: [unsafe_op, may_panic])
    @cold @no_panic @noinline
    fn alloc_slow(&mut self, layout: Layout, eff_cap: usize, /) -> *mut u8!AllocError {
        if self.default_cap == 0_u32 {
            self.default_cap = eff_cap as u32;
        }
        if layout.size > eff_cap / 2_usize or layout.alignment > 4_096_usize {
            if layout.alignment > PAGE_GRANULARITY {
                return .Err(.InvalidLayout);
            }
            let hdr_aligned: usize = align_up(BYPASS_HDR_SIZE, layout.alignment)
                orelse return .Err(.InvalidLayout);
            if layout.size > usize.MAX - hdr_aligned {
                return .Err(.OutOfMemory);
            }
            let map_bytes: usize = align_up(hdr_aligned + layout.size, PAGE_GRANULARITY)
                orelse return .Err(.OutOfMemory);
            let raw_page: *mut u8 = os_alloc_pages(map_bytes)?;
            let bypass: *mut BypassHeader = raw_page as *mut BypassHeader;
            if bypass.is_null() {
                return .Err(.OutOfMemory);
            }
            unsafe {
                bypass.* = BypassHeader { prev: self.bypass_head, map_bytes: map_bytes };
            }
            self.bypass_head = bypass;
            return .Ok(
                unsafe {
                    raw_page.add(hdr_aligned)
                },
            );
        }

        if not self.current_slab.is_null() {
            let next_slab: *mut SlabHeader = unsafe {
                self.current_slab.*.next
            };
            if not next_slab.is_null() {
                let next_cap: usize = unsafe {
                    next_slab.*.cap
                } as usize;
                unsafe {
                    @memset(
                        (next_slab as *mut u8).add(SLAB_HDR_SIZE) as *mut opaque,
                        0_u8,
                        next_cap -| SLAB_HDR_SIZE,
                    );
                }
                self.current_slab = next_slab;
                self.used_offset = SLAB_HDR_SIZE as u32;
                return self.alloc_raw(layout);
            }
        } else {
            let head_slab: *mut SlabHeader = self.first_slab;
            if not head_slab.is_null() {
                let head_cap: usize = unsafe {
                    head_slab.*.cap
                } as usize;
                unsafe {
                    @memset(
                        (head_slab as *mut u8).add(SLAB_HDR_SIZE) as *mut opaque,
                        0_u8,
                        head_cap -| SLAB_HDR_SIZE,
                    );
                }
                self.current_slab = head_slab;
                self.used_offset = SLAB_HDR_SIZE as u32;
                return self.alloc_raw(layout);
            }
        }

        let raw_slab: *mut u8 = os_alloc_pages(eff_cap)?;
        let hdr: *mut SlabHeader = raw_slab as *mut SlabHeader;
        if hdr.is_null() {
            return .Err(.OutOfMemory);
        }
        unsafe {
            hdr.* = SlabHeader {
                next: @default_init[*mut SlabHeader](),
                prev: self.current_slab,
                cap: eff_cap as u32,
                _pad: 0_u32,
            };
            if not self.current_slab.is_null() {
                self.current_slab.*.next = hdr;
            } else {
                self.first_slab = hdr;
            }
        }
        self.current_slab = hdr;
        self.used_offset = SLAB_HDR_SIZE as u32;
        return self.alloc_raw(layout);
    }

    /// Captures an `O(1)` `ArenaCheckpoint` snapshot of the current bump and bypass state.
    @inline @no_alloc @no_panic
    pub fn checkpoint(&self) -> ArenaCheckpoint {
        return ArenaCheckpoint {
            slab_ptr: self.current_slab,
            bypass_head: self.bypass_head,
            used_offset: self.used_offset,
        };
    }

    /// Rewinds `self` back to `cp`, unmapping newer bypass blocks and zero-wiping dirtied slab tail bytes.
    @std_cap_boundary(clears: [unsafe_op, may_panic])
    @no_alloc @no_panic
    pub fn restore(&mut self, cp: ArenaCheckpoint, /) {
        while self.bypass_head != cp.bypass_head and not self.bypass_head.is_null() {
            let node: *mut BypassHeader = self.bypass_head;
            if node.is_null() {
                break;
            }
            let prev_bypass: *mut BypassHeader = unsafe {
                node.*.prev
            };
            let map_len: usize = unsafe {
                node.*.map_bytes
            };
            self.bypass_head = prev_bypass;
            os_free_pages(node as *mut u8, map_len);
        }
        if cp.slab_ptr.is_null() {
            let first: *mut SlabHeader = self.first_slab;
            if not first.is_null() {
                let cap_bytes: usize = unsafe {
                    first.*.cap
                } as usize;
                unsafe {
                    @memset(
                        (first as *mut u8).add(SLAB_HDR_SIZE) as *mut opaque,
                        0_u8,
                        cap_bytes -| SLAB_HDR_SIZE,
                    );
                }
                self.current_slab = first;
                self.used_offset = SLAB_HDR_SIZE as u32;
            } else {
                self.current_slab = @default_init[*mut SlabHeader]();
                self.used_offset = 0_u32;
            }
            return;
        }
        self.current_slab = cp.slab_ptr;
        self.used_offset = cp.used_offset;
        let wipe_start: usize = cp.used_offset as usize;
        let slab_cap: usize = unsafe {
            cp.slab_ptr.*.cap
        } as usize;
        if wipe_start < slab_cap {
            unsafe {
                @memset(
                    (cp.slab_ptr as *mut u8).add(wipe_start) as *mut opaque,
                    0_u8,
                    slab_cap - wipe_start,
                );
            }
        }
    }

    /// Rewinds `self` to its initial slab while retaining mapped slabs for zero-syscall reuse.
    @std_cap_boundary(clears: [unsafe_op, may_panic])
    @no_alloc @no_panic
    pub fn reset(&mut self) {
        self.restore(
            ArenaCheckpoint {
                slab_ptr: @default_init[*mut SlabHeader](),
                bypass_head: @default_init[*mut BypassHeader](),
                used_offset: 0_u32,
            },
        );
    }

    /// Consumes `self` and releases all mapped slabs and bypass blocks back to `System`.
    @std_cap_boundary(clears: [unsafe_op, may_panic])
    @no_panic
    pub fn release(var own self) {
        let Arena {
            current_slab,
            first_slab,
            bypass_head,
            used_offset,
            default_cap,
        } = self;
        _ = current_slab;
        _ = used_offset;
        _ = default_cap;

        var cur_bypass: *mut BypassHeader = bypass_head;
        while not cur_bypass.is_null() {
            let next_bypass: *mut BypassHeader = unsafe {
                cur_bypass.*.prev
            };
            os_free_pages(
                cur_bypass as *mut u8,
                unsafe {
                    cur_bypass.*.map_bytes
                },
            );
            cur_bypass = next_bypass;
        }
        var cur_slab: *mut SlabHeader = first_slab;
        while not cur_slab.is_null() {
            let next_slab: *mut SlabHeader = unsafe {
                cur_slab.*.next
            };
            os_free_pages(
                cur_slab as *mut u8,
                unsafe {
                    cur_slab.*.cap
                } as usize,
            );
            cur_slab = next_slab;
        }
    }

    /// Fallibly allocates a single `T` inside `self` and initializes it with `value`.
    @std_cap_boundary(clears: [unsafe_op])
    pub fn try_create[T](&mut self, value: own T, /) -> (&mut T)!AllocError {
        if @size_of[T]() == 0_usize {
            @forget(own value);
            let zst_ptr: *mut T = @align_of[T]() as *mut T;
            if zst_ptr.is_null() {
                return .Err(.InvalidLayout);
            }
            return .Ok(
                unsafe {
                    &mut zst_ptr.*
                },
            );
        }
        let raw_ptr: *mut T = (self.alloc_raw(Layout.of[T]())?) as *mut T;
        if raw_ptr.is_null() {
            return .Err(.OutOfMemory);
        }
        unsafe {
            @ptr_write(raw_ptr, own value);
            return .Ok(&mut raw_ptr.*);
        }
    }

    /// Allocates a single `T` inside `self`, aborting via `panic` on out-of-memory.
    pub fn create[T](&mut self, value: own T, /) -> &mut T {
        return self.try_create[T](own value) catch {
            return panic("Arena.create: out of memory");
        };
    }

    /// Fallibly allocates `&mut [T]` of length `count` inside `self` (`zeroed = true` by default).
    @std_cap_boundary(clears: [unsafe_op])
    pub fn try_alloc_slice[T: Copy](
        &mut self,
        count: usize,
        /,
        *,
        zeroed: bool = true,
    ) -> (&mut [T])!AllocError {
        let arr_layout: Layout = Layout.array[T](count)?;
        if arr_layout.size == 0_usize {
            return .Ok(
                unsafe {
                    @slice_from_raw_parts_mut(@align_of[T]() as *mut T, count)
                },
            );
        }
        let raw_ptr: *mut u8 = self.alloc_raw(arr_layout)?;
        if zeroed {
            unsafe {
                @memset(raw_ptr as *mut opaque, 0_u8, arr_layout.size);
            }
        }
        return .Ok(
            unsafe {
                @slice_from_raw_parts_mut(raw_ptr as *mut T, count)
            },
        );
    }

    /// Allocates `&mut [T]` of length `count` inside `self`, aborting via `panic` on out-of-memory.
    pub fn alloc_slice[T: Copy](&mut self, count: usize, /, *, zeroed: bool = true) -> &mut [T] {
        return self.try_alloc_slice[T](count, zeroed: zeroed) catch {
            return panic("Arena.alloc_slice: out of memory");
        };
    }

    /// Duplicates `src` into newly bumped `self` slab storage.
    @std_cap_boundary(clears: [unsafe_op])
    pub fn dupe[T: Copy](&mut self, src: &[T], /) -> &mut [T] {
        let count: usize = src.len();
        let byte_len: usize = count *% @size_of[T]();
        if byte_len == 0_usize {
            return self.alloc_slice[T](count, zeroed: false);
        }
        let raw_dst: *mut T = self.alloc_slice[T](count, zeroed: false).as_mut_ptr();
        unsafe {
            @memcpy(raw_dst as *mut opaque, src.as_ptr() as *opaque, byte_len);
            return @slice_from_raw_parts_mut(raw_dst, count);
        }
    }

    /// Duplicates UTF-8 `text` into `self` and returns the arena-backed `str` view.
    @std_cap_boundary(clears: [unsafe_op])
    pub fn dupe_str(&mut self, text: str, /) -> str {
        if text.is_empty() {
            return "";
        }
        return unsafe {
            @str_from_utf8_unchecked(self.dupe[u8](text.as_bytes()))
        };
    }

    /// Formats `args` directly at `self`'s active slab tip and returns the resulting `str`.
    @std_cap_boundary(clears: [unsafe_op])
    pub fn fmt(&mut self, args: FmtArgs, /) -> str {
        var sink = ArenaFmtSink {
            arena: &raw mut self.*,
            ptr: @default_init[*mut u8](),
            len: 0_usize,
            cap: 0_usize,
        };
        var writer = FmtWriter {
            ctx: (&mut sink) as *mut opaque,
            write_fn: arena_fmt_write_cb,
        };
        @fmt_write(&mut writer, args) catch {
            return panic("Arena.fmt: out of memory");
        };
        if sink.len == 0_usize {
            return "";
        }
        let written: &[u8] = unsafe {
            @slice_from_raw_parts(sink.ptr as *u8, sink.len)
        };
        if not is_valid_utf8_bytes(written) {
            _ = arena_resize_in_place(
                self,
                sink.ptr,
                Layout { size: sink.cap, alignment: 1_usize },
                0_usize,
            );
            return panic("invalid UTF-8 written to FmtWriter");
        }
        _ = arena_resize_in_place(
            self,
            sink.ptr,
            Layout { size: sink.cap, alignment: 1_usize },
            sink.len,
        );
        return unsafe {
            @str_from_utf8_unchecked(written)
        };
    }
}

/// Executes `body` on slot `0` of the thread-local ping-pong scratch ring (`DR-20` `D-04`, `E0328`).
@inline @overload
pub fn with_scratch[R](body: |&mut Arena| -> R, /) -> R {
    return with_scratch[R](HANDLE_STATIC_RODATA, body);
}

/// Executes `body` with a temporary ping-pong scratch `Arena` disjoint from `conflict` (`DR-20` `D-04`, `E0328`).
@std_cap_boundary(clears: [unsafe_op])
@overload
pub fn with_scratch[R](conflict: AllocatorHandle, body: |&mut Arena| -> R, /) -> R {
    let pair_ptr: *mut [Arena; 2] = @tls_scratch_ptr() as *mut [Arena; 2];
    if pair_ptr.is_null() {
        return panic("with_scratch: uninitialized TLS");
    }
    let pair: &mut [Arena; 2] = unsafe {
        &mut pair_ptr.*
    };
    let idx: usize = if conflict.raw_tagged_ptr == (((&mut pair[0]) as usize) | 0x1_usize) {
        1_usize
    } else {
        0_usize
    };
    let saved_cp: ArenaCheckpoint = pair[idx].checkpoint();
    defer pair[idx].restore(saved_cp);
    return body(&mut pair[idx]);
}

// -------------- Owned Pointers, Pools & Buffers ---------------
impl[T] OwnPtr[T] {
    /// Fallibly allocates `value` exclusively on the `System` heap and returns an `@linear OwnPtr[T]`.
    @std_cap_boundary(clears: [unsafe_op])
    pub fn try_new(value: own T, /) -> Self!AllocError {
        if @size_of[T]() == 0_usize {
            @forget(own value);
            return .Ok(Self { ptr: @align_of[T]() as *mut T });
        }
        let raw_ptr: *mut T = (System.handle().alloc(Layout.of[T]())?) as *mut T;
        unsafe {
            @ptr_write(raw_ptr, own value);
        }
        return .Ok(Self { ptr: raw_ptr });
    }

    /// Allocates `value` on the `System` heap, aborting via `panic` on out-of-memory.
    pub fn new(value: own T, /) -> Self {
        return Self.try_new(own value) catch {
            return panic("OwnPtr.new: out of memory");
        };
    }

    /// Borrows the owned `T` immutably in `O(1)`.
    @std_cap_boundary(clears: [unsafe_op])
    @inline @no_alloc @no_panic
    pub fn as_ref(&self) -> &T {
        return unsafe {
            &self.ptr.*
        };
    }

    /// Borrows the owned `T` mutably in `O(1)`.
    @std_cap_boundary(clears: [unsafe_op])
    @inline @no_alloc @no_panic
    pub fn as_mut(&mut self) -> &mut T {
        return unsafe {
            &mut self.ptr.*
        };
    }

    /// Returns the underlying non-null read-only `*T` pointer without consuming `self`.
    @inline @no_alloc @no_panic
    pub fn as_ptr(&self) -> *T = self.ptr as *T;

    /// Returns the underlying non-null mutable `*mut T` pointer without consuming `self`.
    @inline @no_alloc @no_panic
    pub fn as_mut_ptr(&mut self) -> *mut T = self.ptr;

    /// Moves the inner `T` out onto the caller stack and deallocates the backing `System` allocation.
    @std_cap_boundary(clears: [unsafe_op])
    pub fn into_inner(own self) -> T {
        let OwnPtr { ptr } = self;
        if @size_of[T]() != 0_usize and is_in_any_tls_pool_slab(ptr as usize) {
            return panic(
                "cx.mem.OwnPtr: Pool-allocated pointer must be freed via pool.free(item)",
            );
        }
        let inner_val: T = unsafe {
            @ptr_read(ptr as *T)
        };
        if @size_of[T]() != 0_usize {
            System.handle().dealloc(ptr as *mut u8, Layout.of[T]());
        }
        return own inner_val;
    }

    /// Consumes `self` and leaks ownership into a raw non-null `*mut T` pointer.
    @inline @no_alloc @no_panic
    pub fn into_raw(own self) -> *mut T {
        let OwnPtr { ptr } = self;
        return ptr;
    }

    /// Reconstructs an `OwnPtr[T]` from a caller-proven non-null, uniquely owned `raw_ptr`.
    @inline @no_alloc @no_panic
    pub unsafe fn from_raw(raw_ptr: *mut T, /) -> Self {
        return Self { ptr: raw_ptr };
    }

    /// Drops `*self` in place via `@drop_in_place` and deallocates backing memory via `System.handle()`.
    @std_cap_boundary(clears: [unsafe_op])
    pub fn free(own self) {
        let OwnPtr { ptr } = self;
        if @size_of[T]() != 0_usize and is_in_any_tls_pool_slab(ptr as usize) {
            panic("cx.mem.OwnPtr: Pool-allocated pointer must be freed via pool.free(item)");
        }
        unsafe {
            @drop_in_place(ptr);
        }
        if @size_of[T]() != 0_usize {
            System.handle().dealloc(ptr as *mut u8, Layout.of[T]());
        }
    }
}

impl[T] Pool[T] {
    /// Constructs an empty `@linear Pool[T]` (`0` OS page mappings until first `alloc`/`try_alloc`).
    @inline @no_alloc @no_panic
    pub fn new(*, items_per_slab: u32 = 1_024_u32) -> Self {
        return Self {
            slab_head: @default_init[*mut PoolSlabHeader](),
            free_head: @default_init[*mut PoolFreeNode](),
            slab_items: if items_per_slab == 0_u32 {
                1_u32
            } else {
                items_per_slab
            },
            live_count: 0_u32,
        };
    }

    /// Fallibly allocates an `O(1)` slot from `self` initialized with `value`.
    @std_cap_boundary(clears: [unsafe_op, may_panic])
    pub fn try_alloc(&mut self, value: own T, /) -> OwnPtr[T]!AllocError {
        if @size_of[T]() == 0_usize {
            @forget(own value);
            self.live_count = self.live_count +% 1_u32;
            return .Ok(OwnPtr[T] { ptr: @align_of[T]() as *mut T });
        }
        let slot_node: *mut PoolFreeNode = self.free_head;
        if not slot_node.is_null() {
            self.free_head = unsafe {
                slot_node.*.next
            };
            let typed_ptr: *mut T = (slot_node as usize) as *mut T;
            unsafe {
                @ptr_write(typed_ptr, own value);
            }
            self.live_count = self.live_count +% 1_u32;
            return .Ok(OwnPtr[T] { ptr: typed_ptr });
        }

        let (slot_align, stride) = pool_slot_geometry[T]() orelse return .Err(.InvalidLayout);
        if slot_align > PAGE_GRANULARITY {
            return .Err(.InvalidLayout);
        }
        let hdr_off: usize = align_up(@size_of[PoolSlabHeader](), slot_align)
            orelse return .Err(.InvalidLayout);
        let items_n: usize = if self.slab_items == 0_u32 {
            1_024_usize
        } else {
            self.slab_items as usize
        };
        if items_n > (usize.MAX - hdr_off) / stride {
            return .Err(.OutOfMemory);
        }
        let slots_end: usize = hdr_off + items_n * stride;
        let map_bytes: usize = align_up(slots_end, PAGE_GRANULARITY)
            orelse return .Err(.OutOfMemory);
        let raw_slab: *mut u8 = os_alloc_pages(map_bytes)?;
        let slab_hdr: *mut PoolSlabHeader = raw_slab as *mut PoolSlabHeader;
        if slab_hdr.is_null() {
            return .Err(.OutOfMemory);
        }
        unsafe {
            slab_hdr.* = PoolSlabHeader {
                prev: self.slab_head,
                tls_next: @default_init[*mut PoolSlabHeader](),
                tls_prev: @default_init[*mut PoolSlabHeader](),
                map_bytes: map_bytes,
                data_off: hdr_off,
                slots_end: slots_end,
            };
        }
        tls_register_pool_slab(slab_hdr);
        self.slab_head = slab_hdr;

        let first_slot: *mut u8 = unsafe {
            raw_slab.add(hdr_off)
        };
        var idx: usize = items_n;
        while idx > 1_usize {
            idx -= 1_usize;
            let node_ptr: *mut PoolFreeNode = unsafe {
                first_slot.add(idx * stride)
            } as *mut PoolFreeNode;
            if not node_ptr.is_null() {
                unsafe {
                    node_ptr.* = PoolFreeNode { next: self.free_head };
                }
                self.free_head = node_ptr;
            }
        }
        let out_ptr: *mut T = (first_slot as usize) as *mut T;
        unsafe {
            @ptr_write(out_ptr, own value);
        }
        self.live_count = self.live_count +% 1_u32;
        return .Ok(OwnPtr[T] { ptr: out_ptr });
    }

    /// Allocates an `O(1)` slot from `self`, aborting via `panic` on out-of-memory.
    pub fn alloc(&mut self, value: own T, /) -> OwnPtr[T] {
        return self.try_alloc(own value) catch {
            return panic("Pool.alloc: out of memory");
        };
    }

    /// Drops `item` in place and pushes its verified slot onto `self.free_head` (`@no_alloc @no_panic`).
    @std_cap_boundary(clears: [unsafe_op, alloc, may_panic])
    @no_alloc @no_panic
    pub fn free(&mut self, item: own OwnPtr[T], /) {
        let raw_ptr: *mut T = item.ptr;
        @forget(own item);
        if @size_of[T]() == 0_usize {
            unsafe {
                @drop_in_place(raw_ptr);
            }
            if self.live_count > 0_u32 {
                self.live_count = self.live_count -% 1_u32;
            }
            return;
        }
        var verified_slot: *mut PoolFreeNode = @default_init[*mut PoolFreeNode]();
        if pool_slot_geometry[T]() is .Some((_, stride)) {
            let ptr_addr: usize = raw_ptr as usize;
            var cur_slab: *mut PoolSlabHeader = self.slab_head;
            while not cur_slab.is_null() {
                let slab_addr: usize = cur_slab as usize;
                let data_off: usize = unsafe {
                    cur_slab.*.data_off
                };
                let slots_end: usize = unsafe {
                    cur_slab.*.slots_end
                };
                let start_addr: usize = slab_addr +% data_off;
                let end_addr: usize = slab_addr +% slots_end;
                if ptr_addr >= start_addr and ptr_addr < end_addr {
                    let rel_bytes: usize = ptr_addr -% start_addr;
                    if (rel_bytes % stride) == 0_usize {
                        verified_slot = unsafe {
                            (cur_slab as *mut u8).add(data_off +% rel_bytes)
                        } as *mut PoolFreeNode;
                    }
                    break;
                }
                cur_slab = unsafe {
                    cur_slab.*.prev
                };
            }
        }
        unsafe {
            @drop_in_place(raw_ptr);
        }
        if verified_slot.is_null() {
            debug_assert(false, "cx.mem.Pool.free: foreign OwnPtr does not belong to this Pool");
            return;
        }
        unsafe {
            verified_slot.* = PoolFreeNode { next: self.free_head };
        }
        self.free_head = verified_slot;
        self.live_count = self.live_count -% 1_u32;
    }

    /// Returns the number of currently live checked-out `OwnPtr[T]` items.
    @inline @no_alloc @no_panic
    pub fn live_len(&self) -> usize = self.live_count as usize;

    /// Consumes `self`, unlinks all slabs from TLS, and unmaps backing OS pages.
    @std_cap_boundary(clears: [unsafe_op])
    @no_panic
    pub fn release(var own self) {
        let Pool {
            slab_head,
            free_head,
            slab_items,
            live_count,
        } = self;
        _ = free_head;
        _ = slab_items;
        _ = live_count;

        var cur_slab: *mut PoolSlabHeader = slab_head;
        while not cur_slab.is_null() {
            let prev_slab: *mut PoolSlabHeader = unsafe {
                cur_slab.*.prev
            };
            let map_len: usize = unsafe {
                cur_slab.*.map_bytes
            };
            tls_unregister_pool_slab(cur_slab);
            os_free_pages(cur_slab as *mut u8, map_len);
            cur_slab = prev_slab;
        }
    }
}

impl FixedBuffer {
    /// Wraps `backing` in a stack/static bump allocator tagged with `FIXED_BUFFER_HDR_SENTINEL` (`0` TLS writes).
    @inline @no_alloc @no_panic
    pub fn init(backing: &mut [u8], /) -> Self {
        return Self {
            header: FIXED_BUFFER_HDR_SENTINEL as *AllocatorHeader,
            buf: backing.as_mut_ptr(),
            cap: backing.len(),
            used: 0_usize,
        };
    }

    /// Returns a `GeneralAllocator` `AllocatorHandle` pointing to `self`.
    @inline @no_alloc @no_panic
    pub fn as_handle(&mut self) -> AllocatorHandle {
        return AllocatorHandle { raw_tagged_ptr: self as usize };
    }

    /// Rewinds the bump cursor to `0` in `O(1)`.
    @inline @no_alloc @no_panic
    pub fn reset(&mut self) {
        self.used = 0_usize;
    }

    /// Returns the unallocated byte count remaining in `self`.
    @inline @no_alloc @no_panic
    pub fn remaining(&self) -> usize = self.cap -| self.used;
}

impl Allocator for FixedBuffer {
    /// Bumps `self.used` to satisfy `layout` inside `self.buf` (`@no_alloc @no_panic`).
    @std_cap_boundary(clears: [may_panic])
    @no_alloc @no_panic
    pub fn alloc(&mut self, layout: Layout, /) -> *mut u8!AllocError {
        let valid: Layout = Layout.new(layout.size, layout.alignment)?;
        if valid.size == 0_usize {
            return .Ok(valid.alignment as *mut u8);
        }
        let base_addr: usize = self.buf as usize;
        let aligned_addr: usize = align_up(base_addr +% self.used, valid.alignment)
            orelse return .Err(.OutOfMemory);
        let rel_off: usize = aligned_addr -% base_addr;
        if valid.size > self.cap -| rel_off or rel_off +% valid.size > self.cap {
            return .Err(.OutOfMemory);
        }
        self.used = rel_off +% valid.size;
        return .Ok(aligned_addr as *mut u8);
    }

    /// Resizes the most recent allocation in place in `O(1)` when `ptr` sits at `self.buf + self.used`.
    @std_cap_boundary(clears: [may_panic])
    @no_alloc @no_panic
    pub fn resize(&mut self, ptr: *mut u8, old_layout: Layout, new_size: usize, /) -> bool {
        if ptr.is_null() {
            return false;
        }
        let base_addr: usize = self.buf as usize;
        let ptr_addr: usize = ptr as usize;
        if ptr_addr < base_addr or ptr_addr +% old_layout.size != base_addr +% self.used {
            return false;
        }
        let rel_off: usize = ptr_addr -% base_addr;
        if new_size > self.cap -| rel_off {
            return false;
        }
        self.used = rel_off +% new_size;
        return true;
    }

    /// Resizes `ptr` in place at the tip or bumps a fresh slice inside `self.buf` (`@no_alloc @no_panic`).
    @std_cap_boundary(clears: [unsafe_op, may_panic])
    @no_alloc @no_panic
    pub fn realloc(
        &mut self,
        ptr: *mut u8,
        old_layout: Layout,
        new_size: usize,
        /,
    ) -> *mut u8!AllocError {
        let new_layout: Layout = Layout.new(new_size, old_layout.alignment)?;
        if new_size == 0_usize {
            self.dealloc(ptr, old_layout);
            return .Ok(old_layout.alignment as *mut u8);
        }
        if old_layout.size == 0_usize or ptr.is_null() {
            return self.alloc(new_layout);
        }
        if self.resize(ptr, old_layout, new_size) {
            return .Ok(ptr);
        }
        let next_ptr: *mut u8 = self.alloc(new_layout)?;
        let copy_len: usize = if old_layout.size < new_size {
            old_layout.size
        } else {
            new_size
        };
        if copy_len > 0_usize {
            unsafe {
                @memcpy(next_ptr as *mut opaque, ptr as *opaque, copy_len);
            }
        }
        return .Ok(next_ptr);
    }

    /// Reclaims `old_layout.size` in `O(1)` when `ptr` sits at the active bump tip.
    @no_alloc @no_panic
    pub fn dealloc(&mut self, ptr: *mut u8, layout: Layout, /) {
        if ptr.is_null() or layout.size == 0_usize {
            return;
        }
        let base_addr: usize = self.buf as usize;
        let ptr_addr: usize = ptr as usize;
        if ptr_addr >= base_addr and ptr_addr +% layout.size == base_addr +% self.used {
            self.used = ptr_addr -% base_addr;
        }
    }
}

impl System {
    /// Returns the canonical zero-overhead `AllocatorHandle` for `System` (`AllocatorHandle.SYSTEM`).
    @inline @no_alloc @no_panic
    pub fn handle() -> AllocatorHandle = HANDLE_SYSTEM;

    /// Maps zero-initialized `64 KiB`-granularity virtual memory pages directly from the OS / Wasm host.
    pub fn alloc_pages(byte_len: usize, /) -> *mut u8!AllocError {
        return os_alloc_pages(byte_len);
    }

    /// Releases `64 KiB`-granularity virtual memory pages back to the OS / Wasm bigpage freelist.
    @no_panic
    pub fn free_pages(ptr: *mut u8, byte_len: usize, /) {
        os_free_pages(ptr, byte_len);
    }
}

// ----------------- Wire Views & Byte Cursors ------------------
impl Span16 {
    /// Canonical empty 4-byte `Span16` (`off = 0, len = 0`).
    pub const EMPTY: Span16 = Span16 { .. };

    /// Projects `self` onto `buf`, returning `.None` if `off + len > buf.len()`.
    @std_cap_boundary(clears: [may_panic])
    @inline @no_alloc @no_panic
    pub fn slice(self, buf: &[u8], /) -> &[u8]? {
        if (end_idx := (self.off as usize) +% (self.len as usize)) <= buf.len() and (
            self.off as usize
        ) <= end_idx {
            return .Some(buf[(self.off as usize)..end_idx]);
        }
        return .None;
    }
}

/// Rounds `addr` upward to power-of-two `alignment`, returning `.None` on invalid alignment or `usize` overflow.
@inline @no_alloc @no_panic
pub fn align_up(addr: usize, alignment: usize, /) -> usize? {
    if alignment == 0_usize or (alignment & (alignment -% 1_usize)) != 0_usize {
        return .None;
    }
    let mask: usize = alignment -% 1_usize;
    if addr > usize.MAX -% mask {
        return .None;
    }
    return .Some((addr +% mask) & ~mask);
}

/// Exchanges `*lhs` and `*rhs` in place via safe MVS parallel assignment (`SE-15`).
@inline @no_alloc @no_panic
pub fn swap[T](lhs: &mut T, rhs: &mut T, /) {
    (lhs.*, rhs.*) = (rhs.*, lhs.*);
}

/// Replaces `*dest` with `src` and returns the previous `*dest` value without extra copies.
@inline @no_alloc @no_panic
pub fn replace[T](dest: &mut T, src: own T, /) -> T {
    var prev: T = own src;
    swap(dest, &mut prev);
    return own prev;
}

/// Reinterprets the prefix of `buf` as `&T` (`T: FromBytes`) after verifying size and alignment (`D-01`).
@std_cap_boundary(clears: [may_panic])
@inline @no_alloc @no_panic
pub fn view_bytes[T: FromBytes](buf: &[u8], /) -> (&T)!WireError {
    let elem_size: usize = @size_of[T]();
    if buf.len() < elem_size {
        return .Err(.UnexpectedEof);
    }
    if ((buf.as_ptr() as usize) & (@align_of[T]() -% 1_usize)) != 0_usize {
        return .Err(.MisalignedPtr);
    }
    if @view_bytes[T](buf[0..elem_size]) is .Some(typed_ref) {
        return .Ok(typed_ref);
    }
    return .Err(.MisalignedPtr);
}

/// Reinterprets `buf` prefix as `&[T]` of length `count` (`T: FromBytes`), guarding `count * sizeof(T)` overflow.
@std_cap_boundary(clears: [unsafe_op, may_panic])
@inline @no_alloc @no_panic
pub fn view_slice_bytes[T: FromBytes](buf: &[u8], count: usize, /) -> (&[T])!WireError {
    let elem_size: usize = @size_of[T]();
    if elem_size != 0_usize and count > usize.MAX / elem_size {
        return .Err(.SizeMismatch);
    }
    let needed: usize = count *% elem_size;
    if buf.len() < needed {
        return .Err(.UnexpectedEof);
    }
    if elem_size == 0_usize {
        return .Ok(
            unsafe {
                @slice_from_raw_parts(@align_of[T]() as *T, count)
            },
        );
    }
    if ((buf.as_ptr() as usize) & (@align_of[T]() -% 1_usize)) != 0_usize {
        return .Err(.MisalignedPtr);
    }
    return .Ok(
        unsafe {
            @slice_from_raw_parts(buf.as_ptr() as *T, count)
        },
    );
}

/// Projects `&value` (`T: IntoBytes`, padding-free or `@zero_pad`) as `&[u8]` in `O(1)` (`D-01`).
@inline @no_alloc @no_panic
pub fn as_bytes[T: IntoBytes](value: &T, /) -> &[u8] {
    return @as_bytes(value);
}

/// Projects `&mut value` (`T: FromBytes + IntoBytes`) as `&mut [u8]` in `O(1)` (`D-01`).
@std_cap_boundary(clears: [unsafe_op])
@inline @no_alloc @no_panic
pub fn as_bytes_mut[T: FromBytes + IntoBytes](value: &mut T, /) -> &mut [u8] {
    return unsafe {
        @slice_from_raw_parts_mut((value as *mut T) as *mut u8, @size_of[T]())
    };
}

/// Reads an unaligned Little-Endian scalar `T` from `buf` at `offset` (`default = 0`).
@std_cap_boundary(clears: [may_panic])
@inline @no_alloc @no_panic
pub fn read_le[T: Integer | Float](buf: &[u8], offset: usize = 0_usize, /) -> T!WireError {
    let elem_size: usize = @size_of[T]();
    if offset > buf.len() or buf.len() -% offset < elem_size {
        return .Err(.UnexpectedEof);
    }
    return .Ok(@from_le_bytes[T](buf[offset..(offset +% elem_size)]));
}

/// Reads an unaligned Big-Endian scalar `T` from `buf` at `offset` (`default = 0`).
@std_cap_boundary(clears: [may_panic])
@inline @no_alloc @no_panic
pub fn read_be[T: Integer | Float](buf: &[u8], offset: usize = 0_usize, /) -> T!WireError {
    let elem_size: usize = @size_of[T]();
    if offset > buf.len() or buf.len() -% offset < elem_size {
        return .Err(.UnexpectedEof);
    }
    return .Ok(@from_be_bytes[T](buf[offset..(offset +% elem_size)]));
}

/// Writes scalar `value` in Little-Endian byte order into `buf` at `offset`.
@std_cap_boundary(clears: [unsafe_op, may_panic])
@inline @no_alloc @no_panic
pub fn write_le[T: Integer | Float](
    buf: &mut [u8],
    offset: usize,
    value: T,
    /,
) -> unit!WireError {
    let elem_size: usize = @size_of[T]();
    if offset > buf.len() or buf.len() -% offset < elem_size {
        return .Err(.UnexpectedEof);
    }
    let encoded = @to_le_bytes[T](value);
    unsafe {
        @memcpy(buf.as_mut_ptr().add(offset) as *mut opaque, (&encoded) as *opaque, elem_size);
    }
    return .Ok(());
}

/// Writes scalar `value` in Big-Endian byte order into `buf` at `offset`.
@std_cap_boundary(clears: [unsafe_op, may_panic])
@inline @no_alloc @no_panic
pub fn write_be[T: Integer | Float](
    buf: &mut [u8],
    offset: usize,
    value: T,
    /,
) -> unit!WireError {
    let elem_size: usize = @size_of[T]();
    if offset > buf.len() or buf.len() -% offset < elem_size {
        return .Err(.UnexpectedEof);
    }
    let encoded = @to_be_bytes[T](value);
    unsafe {
        @memcpy(buf.as_mut_ptr().add(offset) as *mut opaque, (&encoded) as *opaque, elem_size);
    }
    return .Ok(());
}

impl ByteCursor {
    /// Constructs a `ByteCursor` positioned at byte `0` of `buf`.
    @inline @no_alloc @no_panic
    pub fn new(buf: &[u8], /) -> Self {
        return Self { buf: buf, pos: 0_usize };
    }

    /// Returns the unread byte count remaining in `self.buf`.
    @inline @no_alloc @no_panic
    pub fn remaining(&self) -> usize = self.buf.len() -| self.pos;

    /// Returns `true` when `self` has reached the end of `self.buf`.
    @inline @no_alloc @no_panic
    pub fn is_empty(&self) -> bool = self.pos >= self.buf.len();

    /// Advances `self.pos` by `n` bytes and returns the consumed sub-slice.
    @std_cap_boundary(clears: [may_panic])
    @inline @no_alloc @no_panic
    pub fn take(&mut self, n: usize, /) -> (&[u8])!WireError {
        if n > self.remaining() {
            return .Err(.UnexpectedEof);
        }
        let start_pos: usize = self.pos;
        self.pos = start_pos +% n;
        return .Ok(self.buf[start_pos..self.pos]);
    }

    /// Reads a Little-Endian `T` (`Integer | Float`) and advances `self.pos` on success.
    @std_cap_boundary(clears: [may_panic])
    @inline @no_alloc @no_panic
    pub fn read_le[T: Integer | Float](&mut self) -> T!WireError {
        let elem_size: usize = @size_of[T]();
        if elem_size > self.remaining() {
            return .Err(.UnexpectedEof);
        }
        let start_pos: usize = self.pos;
        self.pos = start_pos +% elem_size;
        return .Ok(@from_le_bytes[T](self.buf[start_pos..self.pos]));
    }

    /// Reads a Big-Endian `T` (`Integer | Float`) and advances `self.pos` on success.
    @std_cap_boundary(clears: [may_panic])
    @inline @no_alloc @no_panic
    pub fn read_be[T: Integer | Float](&mut self) -> T!WireError {
        let elem_size: usize = @size_of[T]();
        if elem_size > self.remaining() {
            return .Err(.UnexpectedEof);
        }
        let start_pos: usize = self.pos;
        self.pos = start_pos +% elem_size;
        return .Ok(@from_be_bytes[T](self.buf[start_pos..self.pos]));
    }

    /// Views an aligned `&T` (`T: FromBytes`) at `self.pos` and advances `self.pos` on success.
    @std_cap_boundary(clears: [may_panic])
    @inline @no_alloc @no_panic
    pub fn view[T: FromBytes](&mut self) -> (&T)!WireError {
        let elem_size: usize = @size_of[T]();
        if elem_size > self.remaining() {
            return .Err(.UnexpectedEof);
        }
        let sub_slice: &[u8] = self.buf[self.pos..(self.pos +% elem_size)];
        if ((sub_slice.as_ptr() as usize) & (@align_of[T]() -% 1_usize)) != 0_usize {
            return .Err(.MisalignedPtr);
        }
        if @view_bytes[T](sub_slice) is .Some(typed_ref) {
            self.pos = self.pos +% elem_size;
            return .Ok(typed_ref);
        }
        return .Err(.MisalignedPtr);
    }
}
