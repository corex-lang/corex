/# Linux POSIX Syscall Constants, Kernel Descriptors & C-ABI Prototypes (`core.sys.linux`)
/#
/# Declares `@repr(C)` Linux kernel and POSIX ABI records (`open_how`, `statx`, `stat`, `dirent64`,
/# `inotify_event`, `iovec`, `timespec`, `pollfd`, `posix_spawn_file_actions_t`), `x86_64`/`aarch64`
/# syscall and flag constants, and zero-bloat `libc` / `syscall` `extern "C"` prototypes.
/#
/# Variadic `openat`, `ioctl`, and `syscall` symbols declare exact C `...` prototypes paired with
/# typed `@inline` wrappers so `aarch64` and `x86_64` calling conventions remain 100% ABI-sound.

// ---------------------------------------- TYPES ----------------------------------------
/| POSIX scatter/gather I/O buffer vector (`struct iovec`, `16` bytes on 64-bit targets).
@repr(C)
pub struct PosixIovec {
    /| Base address of the contiguous read or write byte region.
    pub iov_base: *mut u8,
    /| Number of bytes in `iov_base`.
    pub iov_len: usize,
}

/| POSIX nanosecond timestamp and sleep interval (`struct timespec`, `16` bytes on LP64).
@repr(C, align: 8)
pub struct PosixTimespec {
    /| Whole seconds component.
    pub tv_sec: i64,
    /| Nanoseconds component (`0..999_999_999`).
    pub tv_nsec: i64,
}

/| POSIX readiness descriptor entry (`struct pollfd`, `8` bytes).
@repr(C)
pub struct PosixPollFd {
    /| File descriptor to monitor (`< 0` entries are ignored by `poll`).
    pub file_desc: i32,
    /| Requested readiness event mask (`POLLIN`, `POLLOUT`).
    pub events: i16,
    /| Returned readiness event mask populated by the kernel.
    pub revents: i16,
}

/| Linux 5.6+ `openat2(SYS_OPENAT2 = 437)` configuration structure (`struct open_how`, `24` bytes).
@repr(C, align: 8)
pub struct LinuxOpenHow {
    /| `O_*` open-status and creation flags (`u64`).
    pub flags: u64,
    /| Creation permission mode when `O_CREAT` or `O_TMPFILE_BASE` is set (`0` otherwise).
    pub mode: u64,
    /| `RESOLVE_*` path-traversal confinement flags (`RESOLVE_BENEATH`, `RESOLVE_NO_SYMLINKS`).
    pub resolve: u64,
}

/| Linux 4.11+ `statx` 16-byte nanosecond timestamp (`struct statx_timestamp`).
@repr(C, align: 8)
pub struct LinuxStatxTimestamp {
    /| Signed seconds relative to the `1970-01-01T00:00:00Z` Unix epoch.
    pub tv_sec: i64,
    /| Unsigned sub-second nanoseconds (`0..999_999_999`).
    pub tv_nsec: u32,
    /| Reserved kernel alignment field (`0`).
    pub reserved_pad: i32,
}

/| Linux 4.11+ `statx` extended metadata record (`struct statx`, exact `256` bytes).
@repr(C, align: 8)
pub struct LinuxStatx {
    /| Bitmask of populated fields (`STATX_*`).
    pub stx_mask: u32,
    /| Preferred filesystem I/O block size in bytes.
    pub stx_blksize: u32,
    /| Extra file attribute indicators (`STATX_ATTR_*`).
    pub stx_attributes: u64,
    /| Hardlink count.
    pub stx_nlink: u32,
    /| Owner user identifier (`uid_t`).
    pub stx_uid: u32,
    /| Owner group identifier (`gid_t`).
    pub stx_gid: u32,
    /| File type and POSIX mode bits (`S_IFMT | 0o7777`).
    pub stx_mode: u16,
    /| Reserved alignment halfword (`0`).
    pub pad0: u16,
    /| Inode number (`ino_t`).
    pub stx_ino: u64,
    /| Total logical file size in bytes.
    pub stx_size: u64,
    /| Number of allocated 512-byte blocks.
    pub stx_blocks: u64,
    /| Mask of supported `stx_attributes` bits on this filesystem.
    pub stx_attributes_mask: u64,
    /| Last access timestamp.
    pub stx_atime: LinuxStatxTimestamp,
    /| File creation / birth timestamp (`STATX_BTIME`).
    pub stx_btime: LinuxStatxTimestamp,
    /| Last metadata status-change timestamp.
    pub stx_ctime: LinuxStatxTimestamp,
    /| Last data modification timestamp.
    pub stx_mtime: LinuxStatxTimestamp,
    /| Device major ID if this file represents a character or block device.
    pub stx_rdev_major: u32,
    /| Device minor ID if this file represents a character or block device.
    pub stx_rdev_minor: u32,
    /| Filesystem device major ID containing this inode.
    pub stx_dev_major: u32,
    /| Filesystem device minor ID containing this inode.
    pub stx_dev_minor: u32,
    /| Mount ID (`STATX_MNT_ID`).
    pub stx_mnt_id: u64,
    /| Direct-I/O memory alignment requirement in bytes.
    pub stx_dio_mem_align: u32,
    /| Direct-I/O file-offset alignment requirement in bytes.
    pub stx_dio_offset_align: u32,
    /| Reserved trailing kernel words bringing `sizeof(LinuxStatx)` to `256` bytes.
    pub spare_words: [u64; 12],
}

/| Linux `x86_64` `newfstatat` metadata record (`struct stat`, `144` bytes).
@cfg(not (target.arch == "aarch64")) @repr(C, align: 8)
pub struct LinuxStat {
    /| Device identifier containing the file.
    pub st_dev: u64,
    /| File inode number.
    pub st_ino: u64,
    /| Hardlink count (`u64` on `x86_64` SysV).
    pub st_nlink: u64,
    /| File type and POSIX mode bits.
    pub st_mode: u32,
    /| Owner user identifier.
    pub st_uid: u32,
    /| Owner group identifier.
    pub st_gid: u32,
    /| Explicit ABI alignment word (`0`).
    pub pad0: u32,
    /| Special device identifier.
    pub st_rdev: u64,
    /| Logical file size in bytes.
    pub st_size: i64,
    /| Filesystem block size for I/O.
    pub st_blksize: i64,
    /| Number of 512-byte blocks allocated.
    pub st_blocks: i64,
    /| Last access time seconds.
    pub st_atime_sec: i64,
    /| Last access time nanoseconds.
    pub st_atime_nsec: i64,
    /| Last modification time seconds.
    pub st_mtime_sec: i64,
    /| Last modification time nanoseconds.
    pub st_mtime_nsec: i64,
    /| Last status-change time seconds.
    pub st_ctime_sec: i64,
    /| Last status-change time nanoseconds.
    pub st_ctime_nsec: i64,
    /| Reserved glibc/kernel tail words (`24` bytes).
    pub reserved_tail: [i64; 3],
}

/| Linux `aarch64` asm-generic `newfstatat` metadata record (`struct stat`, `128` bytes).
@cfg(target.arch == "aarch64") @repr(C, align: 8)
pub struct LinuxStat {
    /| Device identifier containing the file.
    pub st_dev: u64,
    /| File inode number.
    pub st_ino: u64,
    /| File type and POSIX mode bits (`offset 16` on `aarch64`).
    pub st_mode: u32,
    /| Hardlink count (`u32` at `offset 20` on `aarch64`).
    pub st_nlink: u32,
    /| Owner user identifier.
    pub st_uid: u32,
    /| Owner group identifier.
    pub st_gid: u32,
    /| Special device identifier.
    pub st_rdev: u64,
    /| Reserved kernel alignment doubleword.
    pub pad1: u64,
    /| Logical file size in bytes.
    pub st_size: i64,
    /| Filesystem block size for I/O.
    pub st_blksize: i32,
    /| Alignment padding word.
    pub pad2: i32,
    /| Number of 512-byte blocks allocated.
    pub st_blocks: i64,
    /| Last access time seconds.
    pub st_atime_sec: i64,
    /| Last access time nanoseconds.
    pub st_atime_nsec: i64,
    /| Last modification time seconds.
    pub st_mtime_sec: i64,
    /| Last modification time nanoseconds.
    pub st_mtime_nsec: i64,
    /| Last status-change time seconds.
    pub st_ctime_sec: i64,
    /| Last status-change time nanoseconds.
    pub st_ctime_nsec: i64,
    /| Reserved asm-generic tail words (`8` bytes).
    pub reserved_tail: [u32; 2],
}

/| Linux `getdents64` entry header (`struct linux_dirent64`, `d_name` starts at byte offset `19`).
@repr(C, align: 8)
pub struct LinuxDirent64Hdr {
    /| 64-bit inode number.
    pub d_ino: u64,
    /| Opaque filesystem offset to the next directory entry.
    pub d_off: i64,
    /| Total byte length of this variable-size record.
    pub d_reclen: u16,
    /| File type tag (`DT_REG`, `DT_DIR`, `DT_LNK`, `DT_UNKNOWN`).
    pub d_type: u8,
    /| First 5 bytes of the NUL-terminated entry name at byte offset `19`.
    pub d_name_first: [u8; 5],
}

/| Linux `inotify` event header (`struct inotify_event`, `16` bytes preceding optional `name`).
@repr(C)
pub struct LinuxInotifyEventHdr {
    /| Watch descriptor returned by `inotify_add_watch`.
    pub wd: i32,
    /| Bitmask of triggered `IN_*` filesystem events.
    pub mask: u32,
    /| Unique rename-correlation cookie pairing `IN_MOVED_FROM` and `IN_MOVED_TO`.
    pub cookie: u32,
    /| Padded byte length of the trailing NUL-terminated filename (`0` when unnamed).
    pub name_len: u32,
}

/| Opaque `posix_spawn_file_actions_t` storage sized for both `glibc` (`80B`) and `musl` (`24B`).
@repr(C, align: 8)
pub struct PosixSpawnFileActions {
    /| Opaque ABI storage words (`96` bytes).
    pub opaque_words: [u64; 12],
}

/| Opaque `posix_spawnattr_t` storage sized for both `glibc` (`336B`) and `musl` (`24B`).
@repr(C, align: 8)
pub struct PosixSpawnAttr {
    /| Opaque ABI storage words (`352` bytes).
    pub opaque_words: [u64; 44],
}

/| Dynamically resolved `posix_spawn_file_actions_addchdir_np` C-ABI function-pointer signature.
type PosixSpawnAddChdirFn = extern "C" fn(*mut PosixSpawnFileActions, *u8) -> i32;

// --------------------------------------- CONSTS ----------------------------------------
/| Standard input file descriptor (`0`).
pub const STDIN_FILENO: i32 = 0;

/| Standard output file descriptor (`1`).
pub const STDOUT_FILENO: i32 = 1;

/| Standard error file descriptor (`2`).
pub const STDERR_FILENO: i32 = 2;

